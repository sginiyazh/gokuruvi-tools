---
import Layout from "../../layouts/Layout.astro";

const linuxScenarios = [
  {
    id: 1,
    category: "Boot & Recovery",
    level: "Critical",
    question: "A RHEL server drops into emergency mode after a reboot. How do you recover it safely?",
    answer: "Start by reading the exact mount or dependency failure instead of rebooting repeatedly. Use the emergency shell to identify the failed unit, verify /etc/fstab entries and device UUIDs, and test mounts manually. If the root filesystem is read-only, remount it read-write only when required. Correct the underlying entry, run systemctl daemon-reload, test with mount -a, then continue the boot.",
    commands: ["systemctl --failed", "journalctl -xb", "lsblk -f", "cat /etc/fstab", "mount -a", "systemctl default"],
    verify: "Confirm there are no failed mount units and that a normal reboot reaches the expected target without manual intervention."
  },
  {
    id: 2,
    category: "Boot & Recovery",
    level: "Critical",
    question: "The server boots, but a recent kernel causes instability. What is your recovery plan?",
    answer: "Boot the previously known-good kernel from GRUB, confirm the issue disappears, and collect evidence before changing packages. Keep at least one known-good kernel installed. Set the working kernel as the default only after validation, then investigate whether the newer kernel should be updated, rolled back, or temporarily excluded according to change policy.",
    commands: ["uname -r", "grubby --default-kernel", "grubby --info=ALL", "rpm -q kernel-core --last"],
    verify: "Reboot once more and confirm the expected kernel is selected automatically and application checks pass."
  },
  {
    id: 3,
    category: "Boot & Recovery",
    level: "Critical",
    question: "You forgot the root password on a RHEL system. How would you reset it from the console?",
    answer: "Use the supported GRUB recovery workflow: interrupt boot, edit the kernel line, boot into the break environment, remount the real root filesystem read-write, chroot into it, change the password, and trigger SELinux relabeling when SELinux is enabled. Reboot and validate console login.",
    commands: ["mount -o remount,rw /sysroot", "chroot /sysroot", "passwd root", "touch /.autorelabel", "exit", "reboot"],
    verify: "Confirm the new password works and SELinux returns to the intended enforcing state after relabeling."
  },
  {
    id: 4,
    category: "CPU & Processes",
    level: "Critical",
    question: "CPU usage suddenly reaches 100%. How do you identify the real cause before restarting anything?",
    answer: "Check load average and CPU breakdown first, then identify the process and thread consuming CPU. Determine whether the pressure is user CPU, system CPU, I/O wait, steal time, or a runaway thread. Correlate the process with recent changes and logs. Capture evidence before terminating or restarting a production service.",
    commands: ["uptime", "top", "ps -eo pid,ppid,user,%cpu,%mem,stat,etime,cmd --sort=-%cpu | head", "pidstat -p ALL 1", "top -H -p <PID>", "journalctl --since '-15 min'"],
    verify: "After remediation, confirm load average trends down and the workload still meets application response expectations."
  },
  {
    id: 5,
    category: "CPU & Processes",
    level: "Important",
    question: "A process is shown as a zombie. Should you kill the zombie PID?",
    answer: "No. A zombie has already exited and only retains an entry so its parent can collect the exit status. Identify the parent process. If the parent is healthy, investigate why it is not reaping children. If it is defective, restart or terminate the parent through the service manager after assessing impact. Killing the zombie itself does not solve the cause.",
    commands: ["ps -eo pid,ppid,stat,cmd | awk '$3 ~ /^Z/'", "ps -fp <PPID>", "systemctl status <service>"],
    verify: "Verify the zombie entries disappear after the parent correctly reaps them or the parent is safely restarted."
  },
  {
    id: 6,
    category: "Memory & Performance",
    level: "Critical",
    question: "The system reports very little free memory. How do you decide whether this is actually a problem?",
    answer: "Linux intentionally uses unused RAM for cache, so focus on available memory, swap activity, reclaim pressure, and application symptoms rather than the free column alone. Check whether the kernel is actively swapping, whether major faults are increasing, and which processes are growing. If an OOM event occurred, use the kernel log to identify the victim and memory pressure history.",
    commands: ["free -h", "vmstat 1", "ps -eo pid,user,%mem,rss,vsz,cmd --sort=-rss | head", "sar -r 1 5", "journalctl -k | grep -i -E 'oom|out of memory'"],
    verify: "Confirm available memory and swap activity are stable under normal workload and no new OOM events occur."
  },
  {
    id: 7,
    category: "Memory & Performance",
    level: "Critical",
    question: "Swap usage is high even though RAM is now available. Is that automatically a fault?",
    answer: "Not necessarily. Pages moved to swap can remain there until they are needed. Determine whether swap-in and swap-out activity is currently high. Persistent active swapping with latency indicates pressure; static swap usage without swap I/O may be harmless. Investigate the process working set and memory trend before changing swappiness or clearing swap.",
    commands: ["free -h", "vmstat 1", "sar -W 1 5", "cat /proc/sys/vm/swappiness"],
    verify: "Use si/so from vmstat or pswpin/pswpout from sar to verify whether swapping is active, not just allocated."
  },
  {
    id: 8,
    category: "Storage & Filesystems",
    level: "Critical",
    question: "The root filesystem is 100% full. What do you do first?",
    answer: "Protect service stability first. Identify which filesystem is actually full, then locate the largest consumers without crossing into other mounts unless intended. Check for deleted-but-open files because removing a visible file may not release space while a process still holds it. Remove or rotate data only when ownership and retention requirements are clear; then fix the growth source.",
    commands: ["df -hT", "df -i", "du -xhd1 / | sort -h", "find / -xdev -type f -size +1G -ls", "lsof +L1"],
    verify: "Confirm both block usage and inode usage are healthy and that the growing log, cache, or application path is controlled."
  },
  {
    id: 9,
    category: "Storage & Filesystems",
    level: "Critical",
    question: "df shows a filesystem is full, but du cannot account for the used space. What is the likely cause?",
    answer: "A common cause is a deleted file that is still open by a running process. The directory entry is gone, so du cannot see it, while the filesystem blocks remain allocated until the file descriptor is closed. Use lsof to identify the process and choose a safe service restart or application-specific log reopen action.",
    commands: ["df -h", "du -xsh /* 2>/dev/null", "lsof +L1"],
    verify: "After the file descriptor is released, confirm df reports the reclaimed space."
  },
  {
    id: 10,
    category: "Storage & Filesystems",
    level: "Critical",
    question: "A filesystem has free GBs but applications receive 'No space left on device'. What do you check?",
    answer: "Check inode exhaustion as well as blocks. A workload creating huge numbers of small files can exhaust inodes while capacity remains. Identify the directory with the largest file count, remove data according to retention policy, and address the application behavior or filesystem sizing that caused the inode pressure.",
    commands: ["df -h", "df -i", "find /path -xdev -type f | wc -l", "du --inodes -x -d1 /path 2>/dev/null | sort -n"],
    verify: "Confirm inode availability is restored and the application can create files normally."
  },
  {
    id: 11,
    category: "LVM",
    level: "Critical",
    question: "A logical volume needs more space with minimal downtime. How do you extend it?",
    answer: "Confirm the filesystem type, current LV path, volume group free extents, and underlying storage state. Extend the LV first. Then grow the filesystem with the correct online tool: xfs_growfs for XFS or resize2fs for ext4. Do not use filesystem shrinking procedures on XFS because XFS does not support shrinking.",
    commands: ["lsblk -f", "pvs", "vgs", "lvs", "lvextend -L +20G /dev/<vg>/<lv>", "xfs_growfs <mountpoint>", "resize2fs /dev/<vg>/<lv>"],
    verify: "Validate the new size with lvs and df -hT and confirm the application still reads and writes normally."
  },
  {
    id: 12,
    category: "LVM",
    level: "Important",
    question: "A new disk has been attached to a VM. How do you add it to an existing volume group?",
    answer: "Rescan the appropriate storage bus if the device is not visible, identify the new disk unambiguously, create the physical volume, extend the intended volume group, and only then allocate new extents to the target logical volume. Verify device identity carefully to avoid initializing the wrong disk.",
    commands: ["lsblk", "lsscsi", "pvcreate /dev/sdX", "vgextend <vg> /dev/sdX", "pvs", "vgs"],
    verify: "Confirm the new physical volume belongs to the correct volume group and free extents increased as expected."
  },
  {
    id: 13,
    category: "Networking",
    level: "Critical",
    question: "A server can ping its gateway but cannot reach an external hostname. How do you isolate the issue?",
    answer: "Separate routing from name resolution. Test the external destination by IP first. If IP connectivity works but hostname lookup fails, inspect resolver configuration and query the configured resolver directly. If IP connectivity also fails, inspect routes, source address, firewall policy, upstream ACLs, and path hops.",
    commands: ["ip addr", "ip route", "ping -c 3 <gateway>", "ping -c 3 1.1.1.1", "resolvectl status", "dig example.com", "tracepath 1.1.1.1"],
    verify: "Confirm both IP reachability and DNS resolution work from the affected host using the expected interface and resolver."
  },
  {
    id: 14,
    category: "Networking",
    level: "Critical",
    question: "A service is running, but clients cannot connect to its TCP port. What do you check?",
    answer: "Verify the process is listening, the bind address is correct, and the expected protocol/port is used. Test locally first, then from a remote client. Check host firewall rules and any upstream network policy. Packet capture is useful to distinguish no arrival, rejected traffic, and application-level resets.",
    commands: ["ss -lntp", "curl -v http://127.0.0.1:<port>/", "nc -vz <server> <port>", "firewall-cmd --list-all", "tcpdump -ni any port <port>"],
    verify: "Confirm a remote TCP handshake reaches the intended process and the application responds at its protocol layer."
  },
  {
    id: 15,
    category: "Networking",
    level: "Important",
    question: "Two NICs are configured and replies leave through the wrong interface. How do you troubleshoot asymmetric routing?",
    answer: "Inspect addresses, route metrics, policy rules, and the route selected for the exact destination. On multihomed systems, source-based routing may be required. Also review reverse path filtering because strict rp_filter can drop legitimate asymmetric traffic. Change routing only after understanding the intended network design.",
    commands: ["ip -br addr", "ip route show table all", "ip rule", "ip route get <client-ip>", "sysctl net.ipv4.conf.all.rp_filter"],
    verify: "Use ip route get and packet capture to confirm request and reply paths match the intended design."
  },
  {
    id: 16,
    category: "systemd & Services",
    level: "Critical",
    question: "A systemd service fails immediately after start. What is your troubleshooting sequence?",
    answer: "Read the unit status and journal first, then inspect the exact ExecStart command, user, environment, working directory, permissions, dependencies, and exit code. Run the application command in a controlled way as the configured service user when appropriate. Fix the root cause, run daemon-reload only if the unit changed, then restart and verify.",
    commands: ["systemctl status <service> --no-pager -l", "journalctl -u <service> -b --no-pager", "systemctl cat <service>", "systemctl show <service> -p User -p Group -p ExecStart", "systemctl daemon-reload"],
    verify: "Confirm the unit remains active after several minutes and its application endpoint or function works."
  },
  {
    id: 17,
    category: "systemd & Services",
    level: "Important",
    question: "A service must start only after the network is truly usable. Is After=network.target enough?",
    answer: "Usually not. network.target mainly represents ordering around network management, not confirmed connectivity. Use network-online.target when the service genuinely requires configured networking and ensure the system's wait-online service is correctly enabled for the active network stack. Avoid unnecessary dependencies because they can slow boot.",
    commands: ["systemctl cat <service>", "systemctl status network-online.target", "systemctl list-dependencies network-online.target"],
    verify: "Test a reboot and confirm the service starts reliably only after its required network path is available."
  },
  {
    id: 18,
    category: "Logs & Troubleshooting",
    level: "Critical",
    question: "An incident occurred 30 minutes ago but the service looks healthy now. How do you reconstruct what happened?",
    answer: "Build a time-bounded timeline. Review the service journal, kernel messages, authentication events, resource statistics, and any application logs for the same window. Correlate timestamps with deployment or configuration changes. Preserve relevant evidence before log rotation removes it.",
    commands: ["journalctl --since '-45 min' --until '-15 min'", "journalctl -k --since '-45 min'", "journalctl -u <service> --since '-45 min'", "last -F | head", "sar -u -r -q"],
    verify: "Document a consistent timeline with evidence for the trigger, impact, remediation, and prevention step."
  },
  {
    id: 19,
    category: "Security",
    level: "Critical",
    question: "SSH password authentication was disabled, and a user is locked out after key rotation. How do you recover without weakening security globally?",
    answer: "Use an approved console, bastion, or alternate privileged session. Validate the user's home directory, .ssh directory, authorized_keys ownership, permissions, key content, account status, and sshd effective configuration. Restore the correct key and permissions rather than enabling password authentication for everyone.",
    commands: ["sshd -T | grep -E 'pubkeyauthentication|passwordauthentication|authorizedkeysfile'", "getent passwd <user>", "ls -ld ~<user> ~<user>/.ssh ~<user>/.ssh/authorized_keys", "restorecon -RFv ~<user>/.ssh", "journalctl -u sshd -b"],
    verify: "Test key-based login from the intended source and confirm password authentication remains in the required state."
  },
  {
    id: 20,
    category: "Security",
    level: "Critical",
    question: "A service works with SELinux permissive but fails when enforcing. What should you do?",
    answer: "Do not disable SELinux as the fix. Reproduce the denial, inspect AVC messages, confirm file labels and expected booleans, and determine whether the application is using supported paths and ports. Correct labeling or configuration first. Create a custom policy only when the access is legitimate and cannot be expressed with standard labels or booleans.",
    commands: ["getenforce", "ausearch -m AVC,USER_AVC -ts recent", "sealert -a /var/log/audit/audit.log", "ls -Z <path>", "restorecon -Rv <path>", "getsebool -a | grep <keyword>"],
    verify: "Return to enforcing mode and confirm the service works without new unexpected AVC denials."
  },
  {
    id: 21,
    category: "Security",
    level: "Important",
    question: "A user can run more sudo commands than intended. How do you investigate safely?",
    answer: "Inspect the effective sudo policy rather than only /etc/sudoers. Check included files, group memberships, aliases, and host/run-as restrictions. Use visudo for changes so syntax is validated. Prefer least-privilege command rules and avoid broad wildcards where arguments can be abused.",
    commands: ["sudo -l -U <user>", "id <user>", "visudo -c", "grep -R --line-number -E '^[^#].*<user>|%<group>' /etc/sudoers /etc/sudoers.d 2>/dev/null"],
    verify: "Re-test sudo -l for the user and confirm only approved commands are authorized."
  },
  {
    id: 22,
    category: "Packages & Updates",
    level: "Important",
    question: "A package update broke an application. How do you investigate and roll back responsibly?",
    answer: "Identify exactly what changed and whether the application failure is caused by the package, configuration migration, or dependency. Review package history and logs. If rollback is supported and risk-assessed, revert the relevant transaction or install the approved previous package version. Preserve security implications and avoid blindly downgrading critical components.",
    commands: ["dnf history", "dnf history info <ID>", "rpm -qa --last | head", "journalctl --since today", "dnf repoquery --show-duplicates <package>"],
    verify: "Confirm application function, service health, and package versions, then document the temporary hold or permanent remediation."
  },
  {
    id: 23,
    category: "Files & Permissions",
    level: "Critical",
    question: "An application gets Permission denied even though chmod 777 was tested. What should you check next?",
    answer: "Stop using world-writable permissions as a diagnostic shortcut. Walk the full path and check ownership, execute permission on parent directories, ACLs, SELinux context, mount options, service user identity, and whether the filesystem is read-only. The denial may not be traditional mode bits at all.",
    commands: ["namei -l /path/to/file", "getfacl /path/to/file", "ls -lZ /path/to/file", "findmnt -no TARGET,OPTIONS /path/to/file", "id <service-user>", "ausearch -m AVC -ts recent"],
    verify: "Restore least-privilege permissions and confirm the application can access only the intended path."
  },
  {
    id: 24,
    category: "Files & Permissions",
    level: "Important",
    question: "New files in a shared directory must inherit a common group. How do you configure it correctly?",
    answer: "Set the directory group to the shared group and enable the setgid bit so new files and directories inherit that group. Use a suitable umask or default ACL when group write access must be consistent regardless of the creator's shell umask.",
    commands: ["chgrp <group> /shared", "chmod 2775 /shared", "setfacl -m d:g:<group>:rwx /shared", "getfacl /shared"],
    verify: "Create test files as different authorized users and confirm the group and effective permissions are inherited correctly."
  },
  {
    id: 25,
    category: "I/O & Performance",
    level: "Critical",
    question: "Load average is very high but CPU utilization is low. What does that suggest?",
    answer: "High load can include tasks waiting in uninterruptible sleep, often due to storage or remote filesystem I/O. Check the process states, I/O wait, device latency, queue depth, and kernel messages. Do not assume high load always means CPU saturation.",
    commands: ["uptime", "vmstat 1", "ps -eo state,pid,ppid,wchan:32,cmd | awk '$1 ~ /^D/'", "iostat -xz 1", "pidstat -d 1", "journalctl -k -b"],
    verify: "Confirm blocked-task counts and device latency normalize after the storage or I/O issue is resolved."
  },
  {
    id: 26,
    category: "I/O & Performance",
    level: "Important",
    question: "A filesystem becomes read-only unexpectedly. What is the safe response?",
    answer: "Treat it as a possible filesystem or storage integrity event. Check kernel logs for I/O errors or filesystem protection actions. Avoid forcing it read-write repeatedly. Protect data, assess redundancy and backups, and schedule the filesystem-specific offline repair procedure where required. Resolve underlying disk, path, or virtual storage errors first.",
    commands: ["findmnt -no SOURCE,TARGET,FSTYPE,OPTIONS <mountpoint>", "journalctl -k -b | tail -200", "dmesg -T | tail -200", "lsblk -f"],
    verify: "After repair and storage validation, confirm clean mounts and no recurring kernel I/O or filesystem errors."
  },
  {
    id: 27,
    category: "Time & Scheduling",
    level: "Important",
    question: "A cron job works manually but fails from cron. What are the most common causes?",
    answer: "Cron has a minimal environment and may use a different shell, PATH, working directory, and permissions. Use absolute paths, capture stdout/stderr, verify the crontab belongs to the intended user, and check the scheduler logs. If the task depends on environment variables, define them explicitly or call a controlled wrapper script.",
    commands: ["crontab -l", "systemctl status crond", "journalctl -u crond -b", "env -i /bin/bash --noprofile --norc -c '<command>'"],
    verify: "Run the job under an equivalent minimal environment and confirm its next scheduled execution succeeds."
  },
  {
    id: 28,
    category: "Time & Scheduling",
    level: "Critical",
    question: "Several servers suddenly show authentication or TLS errors and their clocks differ. How do you troubleshoot time synchronization?",
    answer: "Verify current time, timezone, synchronization state, configured sources, reachability, and clock offset. Large offsets can affect authentication and certificate validation. Correct the synchronization service and upstream reachability rather than manually setting clocks on each server except under an approved recovery procedure.",
    commands: ["timedatectl", "chronyc tracking", "chronyc sources -v", "chronyc sourcestats -v", "journalctl -u chronyd -b"],
    verify: "Confirm chronyc reports a synchronized source and offsets converge within the environment's tolerance."
  },
  {
    id: 29,
    category: "Containers",
    level: "Important",
    question: "A container exits immediately after start. How do you investigate it from the Linux host?",
    answer: "Check the exit code, logs, configured entrypoint/command, mounts, environment, resource limits, and host permissions. A container needs a foreground process; if its main process exits, the container stops. Also verify host security policy and storage availability before changing the image.",
    commands: ["podman ps -a", "podman logs <container>", "podman inspect <container>", "podman top <container>", "journalctl -u podman -b 2>/dev/null || true"],
    verify: "Confirm the container remains running and the expected application check succeeds without host-level denials."
  },
  {
    id: 30,
    category: "Automation",
    level: "Critical",
    question: "You must run a change on 100 Linux servers. What makes your approach production-safe?",
    answer: "Make the change idempotent, scope it to an approved inventory, validate prerequisites, test on a representative canary group, capture before/after state, stop on defined failure thresholds, and keep a rollback path. Avoid one-off parallel SSH loops for high-impact changes when an automation platform with inventory, logging, and controlled concurrency is available.",
    commands: ["ansible all -m ping", "ansible-playbook change.yml --check --diff --limit canary", "ansible-playbook change.yml --limit canary", "ansible-playbook change.yml --serial 10"],
    verify: "Use an explicit post-check across the fleet and retain execution evidence tied to the approved change."
  },
  {
    id: 31,
    category: "Networking",
    level: "Critical",
    question: "SSH is slow before the password or key prompt appears. Where do you look?",
    answer: "Determine whether the delay is client-side name resolution, server reverse lookup, GSSAPI negotiation, PAM, or network packet loss. Use verbose SSH timing and the sshd journal. Verify DNS forward/reverse resolution where required. Change authentication options only when they are not required by the environment.",
    commands: ["ssh -vvv user@host", "journalctl -u sshd -b", "getent hosts <client-ip>", "sshd -T | grep -E 'usedns|gssapiauthentication'"],
    verify: "Measure connection time after the fix and confirm the intended authentication mechanisms still work."
  },
  {
    id: 32,
    category: "Kernel & Limits",
    level: "Important",
    question: "An application says 'Too many open files'. How do you find the correct limit to change?",
    answer: "Identify whether the process hit its per-process file descriptor limit or whether the host is under broader file table pressure. Check the running process limits, systemd unit limits, shell limits, and actual descriptor count. Raise only the justified scope and ensure the application does not have a descriptor leak.",
    commands: ["cat /proc/<PID>/limits | grep -i 'open files'", "ls /proc/<PID>/fd | wc -l", "systemctl show <service> -p LimitNOFILE", "sysctl fs.file-max", "cat /proc/sys/fs/file-nr"],
    verify: "After a controlled restart if required, confirm the process receives the intended limit and descriptor count remains stable."
  },
  {
    id: 33,
    category: "Kernel & Limits",
    level: "Important",
    question: "You change a sysctl value but it returns to the old value after reboot. Why?",
    answer: "A runtime sysctl command is not automatically persistent. Find which configuration file sets the value and whether multiple files override it. Put the approved setting in the appropriate sysctl.d file, reload it, and confirm there is no later conflicting definition.",
    commands: ["sysctl <key>", "grep -R --line-number '<key>' /etc/sysctl.conf /etc/sysctl.d /usr/lib/sysctl.d 2>/dev/null", "sysctl --system"],
    verify: "Reboot during a maintenance window and confirm the effective value matches the intended persistent configuration."
  },
  {
    id: 34,
    category: "Incident Response",
    level: "Critical",
    question: "A production server becomes unreachable. What is your first five-minute checklist?",
    answer: "Confirm scope before acting: one host, subnet, site, or service. Check external reachability, virtualization or hardware console state, recent alerts and changes, route/path behavior, and whether the host responds on any management channel. Avoid rebooting until you have enough evidence to justify it because a reboot can destroy transient diagnostic data.",
    commands: ["ping -c 3 <host>", "tracepath <host>", "nc -vz <host> 22", "ip route get <host>", "arping <host>  # same L2 only"],
    verify: "Record the failure domain and recovery evidence, then perform a service-level validation after connectivity returns."
  },
  {
    id: 35,
    category: "Incident Response",
    level: "Critical",
    question: "A server recovered after a reboot. Is 'reboot fixed it' an acceptable RCA?",
    answer: "No. A reboot is a recovery action, not a root cause. Use logs from the previous boot, resource history, service crash data, kernel events, change records, and infrastructure events to identify the most plausible trigger. If evidence is insufficient, state that clearly and add instrumentation or retention needed to capture the next occurrence.",
    commands: ["journalctl -b -1", "journalctl -k -b -1", "last -x | head -30", "coredumpctl list", "sar -A"],
    verify: "The final RCA should separate trigger, contributing factors, recovery action, and preventive measures, each tied to evidence."
  },
  {
    id: 36,
    category: "Architecture & Operations",
    level: "Important",
    question: "How do you explain the difference between load average and CPU utilization in an interview?",
    answer: "CPU utilization describes how busy CPU time is. Linux load average represents the average number of tasks runnable on CPU or waiting in uninterruptible sleep over 1, 5, and 15 minutes. Therefore high load with high CPU suggests CPU contention, while high load with low CPU can indicate blocked I/O. Always interpret load relative to CPU count and workload behavior.",
    commands: ["uptime", "nproc", "vmstat 1", "ps -eo state,pid,cmd | head"],
    verify: "Support the explanation with current host data instead of using a fixed load threshold for every server."
  },
  {
    id: 37,
    category: "Identity & Authentication",
    level: "Important",
    question: "A user account authenticates fine with a local password, but SSSD/LDAP-based login fails on one specific server. How do you troubleshoot it?",
    answer: "Confirm the account resolves through the correct source before touching authentication. Check whether nsswitch and SSSD see the identity at all, then whether the failure is lookup, binding, or PAM. Stale SSSD cache entries and expired cached credentials on one server are common causes when other servers work fine. Rule out network or certificate issues to the directory server before restarting services.",
    commands: ["getent passwd <user>", "id <user>", "sssctl user-checks <user>", "systemctl status sssd", "sss_cache -u <user>", "journalctl -u sssd -b", "sssctl domain-status <domain> -o"],
    verify: "Confirm getent and id resolve the user consistently on the affected server and an interactive login succeeds without cache or certificate errors."
  }
];

const extraScenarios = [
  {id:101,domain:"DevOps",category:"CI/CD",level:"Critical",question:"A deployment pipeline passed, but the new release is failing in production. What do you check first?",answer:"Separate deployment success from application health. Confirm the exact artifact and version deployed, compare production configuration with the tested environment, inspect startup and runtime logs, validate dependencies and secrets, and check health probes and traffic routing. If customer impact is significant, use the approved rollback while preserving evidence.",commands:["git rev-parse HEAD","docker image inspect <image>:<tag>","kubectl rollout status deployment/<name>","kubectl logs deployment/<name> --tail=200"],verify:"Confirm the expected version is serving healthy traffic and the rollback or fix is documented."},
  {id:102,domain:"DevOps",category:"CI/CD",level:"Critical",question:"A CI pipeline suddenly becomes very slow. How do you find the bottleneck?",answer:"Compare stage durations with a known-good run. Identify whether delay is in checkout, dependency download, build, tests, image push, approvals, or deployment. Check runner saturation, cache hit rates, external registry latency, and recent pipeline changes before increasing resources.",commands:["git diff <good>..<bad> -- .github .gitlab-ci.yml Jenkinsfile","docker system df","df -h","free -h"],verify:"Re-run the pipeline and confirm the slow stage has returned to the expected duration."},
  {id:103,domain:"DevOps",category:"Git",level:"Important",question:"A developer force-pushed and removed commits from a shared branch. How do you recover safely?",answer:"Stop additional writes, identify the last known-good commit from local reflogs, CI references, or another clone, create a recovery branch, validate the missing commits, and restore through the team's protected-branch process instead of performing another blind force push.",commands:["git reflog","git log --all --oneline --decorate --graph","git branch recovery/<name> <commit>"],verify:"Confirm the shared branch contains the intended history and branch protection prevents recurrence."},
  {id:104,domain:"DevOps",category:"Containers",level:"Critical",question:"A container works locally but exits immediately in CI or production. What do you inspect?",answer:"Check the container exit code, logs, entrypoint, command, architecture, environment variables, mounted files, filesystem permissions, and resource limits. Compare the exact image digest used locally and remotely so you are troubleshooting the same artifact.",commands:["docker ps -a","docker logs <container>","docker inspect <container>","docker image inspect <image>"],verify:"Start the same image with production-equivalent inputs and confirm it remains healthy."},
  {id:105,domain:"DevOps",category:"Release Engineering",level:"Critical",question:"How would you perform a production deployment with minimal risk?",answer:"Use an immutable versioned artifact, pre-deployment validation, backups where required, progressive rollout such as rolling, canary, or blue-green, automated health checks, clear rollback criteria, and post-deployment verification. Avoid making unrelated configuration changes in the same window.",commands:["kubectl rollout history deployment/<name>","kubectl rollout status deployment/<name>","kubectl rollout undo deployment/<name>"],verify:"Validate application, dependency, and business health checks after traffic reaches the new version."},
  {id:106,domain:"DevOps",category:"Secrets",level:"Critical",question:"A secret was accidentally committed to Git. Is deleting the file enough?",answer:"No. Treat the credential as compromised. Revoke or rotate it first, remove it from current code and history where appropriate, invalidate cached artifacts, review access logs, and add secret scanning or pre-commit controls. Coordinate history rewriting because it affects all clones.",commands:["git log --all -- <path>","git grep -n '<pattern>' $(git rev-list --all)"],verify:"Confirm the old secret no longer works and automated scanning no longer detects it."},
  {id:107,domain:"DevOps",category:"Observability",level:"Important",question:"Your service has no errors in logs, but users report high latency. What do you investigate?",answer:"Look beyond error logs. Measure request latency percentiles, dependency timing, saturation, queue depth, DNS and network latency, database or API response time, and resource throttling. Correlate traces and metrics with the affected request path.",commands:["curl -sS -o /dev/null -w '%{time_connect} %{time_starttransfer} %{time_total}\\n' https://<service>","ss -s","vmstat 1"],verify:"Confirm latency percentiles and user-visible response times return to baseline."},
  {id:108,domain:"DevOps",category:"Automation",level:"Important",question:"An automation script partially completed and failed. How should a production-safe script behave?",answer:"Design automation to be idempotent, validate prerequisites, fail clearly, log actions, avoid destructive defaults, and support safe retries. For multi-step changes, record state and use transactional or rollback-aware patterns where possible.",commands:["set -euo pipefail","shellcheck <script>.sh"],verify:"Run the automation twice in a test environment and confirm the second run does not cause unintended changes."},
  {id:109,domain:"DevOps",category:"Monitoring & Alerting",level:"Important",question:"An alert fired in your monitoring system, but no one was paged and the incident was found manually. How do you fix the alerting pipeline?",answer:"Check whether the alert actually breached its rule threshold with the labels the routing tree expects, then inspect notification routing, silences, mutes, and the health of the paging integration itself. A correct alert rule with a broken route, an active silence, or a failed webhook produces exactly this symptom. Fix the routing or integration, not just the rule.",commands:["amtool alert query","amtool config routes test","amtool silence query","curl -s http://alertmanager:9093/api/v2/status","Check PagerDuty/Slack integration delivery logs"],verify:"Trigger a synthetic test alert and confirm it reaches the correct on-call channel end-to-end within the expected time."},
  {id:110,domain:"DevOps",category:"CI/CD",level:"Critical",question:"A Jenkins pipeline fails immediately after every recent code push, even though the same code builds fine locally. What is your troubleshooting order?",answer:"Separate 'my code is broken' from 'the pipeline environment is broken'. Read the exact failing stage and error instead of just the red status. Compare the agent's tool versions, environment variables, and checked-out branch or commit against your local environment. Check for a changed shared library version, expired credentials, or a recently merged Jenkinsfile change before touching pipeline logic.",commands:["Open the failed stage console output, not just the summary","git log -3 --stat -- Jenkinsfile","Compare agent tool versions (java -version, node -v) against local","curl -I <credential-dependent endpoint> to check auth/expiry"],verify:"Confirm the identified stage passes on a clean agent workspace and the next few pipeline runs are consistently green."},
  {id:111,domain:"DevOps",category:"Git",level:"Important",question:"Two developers created large, long-lived feature branches, and merging either one now produces dozens of conflicts. How do you get the release back on track?",answer:"Avoid one giant conflict-resolution session with unclear ownership. Merge or rebase main into each feature branch incrementally and resolve conflicts with the original authors while context is fresh. Identify overlapping files early and coordinate ordering between the two branches. Use this as a signal to shorten branch lifetimes and move toward trunk-based practices, not just to fix this one release.",commands:["git fetch origin","git log --oneline main..feature-branch","git rebase origin/main","git diff --name-only origin/main...feature-branch"],verify:"Confirm the branch merges cleanly, the full test suite passes, and both authors reviewed the resolved conflicts."},
  {id:112,domain:"DevOps",category:"Containers",level:"Critical",question:"A Docker container starts, then keeps restarting in a loop after deployment even though the image ran fine in a manual test. What do you check?",answer:"A restart loop usually means the main process is exiting, not that the image is corrupt. Check the exit code and logs from the most recent attempt, then compare the exact command, environment variables, mounted volumes, and resource limits between the manual test and the deployed configuration. Confirm health checks are not killing a slow-starting process, and check for configuration or secrets that were present locally but missing in the deployment environment.",commands:["docker ps -a","docker logs --tail 100 <container>","docker inspect <container> --format '{{.State.ExitCode}} {{.State.Error}}'","docker inspect <container> --format '{{json .Config.Env}}'"],verify:"Confirm the container stays in a Running state past several health-check intervals and the application responds correctly."},
  {id:113,domain:"DevOps",category:"Release Engineering",level:"Critical",question:"A blue-green deployment cutover causes some users to lose their session or see inconsistent state right after the switch. What went wrong, and how do you fix it?",answer:"Blue-green switches traffic instantly, but application and session state are often not instantly consistent between environments. Check whether sessions are stored in-process on the old environment instead of a shared store, whether the database schema is compatible with both versions during the cutover window, and whether in-flight requests were drained before switching. Use a shared session store, keep schema changes backward and forward compatible, and drain connections before flipping traffic.",commands:["Check load balancer target-group draining/connection settings","Verify shared session store: redis-cli ping / check shared cache config","Confirm the DB migration is backward-compatible with both app versions","Review rollout/service status during a test cutover"],verify:"Perform a test cutover in staging and confirm no session loss or errors occur for in-flight requests during the switch."},
  {id:114,domain:"DevOps",category:"Infrastructure as Code",level:"Critical",question:"A Terraform apply times out midway through a run, and the state now shows some resources created and others not. How do you safely continue?",answer:"Do not immediately re-run apply blindly against a partially applied state, since duplicate resource creation or an unexpected destructive change can result. Run a plan first to see exactly what Terraform believes the current state to be versus real infrastructure, then reconcile any resource that exists in the cloud but is missing from state, or vice versa, before continuing. Investigate why the timeout occurred, such as a slow-provisioning resource or provider API throttling, and consider raising the relevant timeout or splitting the change into smaller applies.",commands:["terraform plan -out=tfplan","terraform state list","terraform state show <resource>","terraform import <address> <id>  # if a resource exists but isn't tracked"],verify:"Confirm terraform plan shows no unexpected changes and every resource in the configuration matches real infrastructure."},
  {id:115,domain:"DevOps",category:"Configuration Management",level:"Important",question:"An Ansible playbook runs successfully against most hosts in inventory, but fails or produces different results on a few. What is the likely cause?",answer:"Playbooks are rarely as host-agnostic as assumed. Check for host-specific facts that a task's logic depends on, such as OS version, package manager, or existing file state, and check whether the failing hosts are simply out of sync with the assumed baseline. Run in check mode with increased verbosity against a failing host, compare gathered facts against a working host, and confirm the failing hosts are not being managed by a conflicting process outside Ansible.",commands:["ansible-playbook site.yml --limit <failing-host> -vvv","ansible-playbook site.yml --check --diff --limit <failing-host>","ansible <failing-host> -m setup","ansible-playbook site.yml --start-at-task='<task name>'"],verify:"Confirm a subsequent run against the failing hosts reports no changes needed, matching the state of already-converged hosts."},
  {id:116,domain:"DevOps",category:"Artifact Management",level:"Important",question:"An application behaves differently in production than in staging even though the same version number was deployed to both. How do you find the discrepancy?",answer:"A matching version tag does not guarantee an identical artifact was actually deployed, since a tag can be overwritten or a build can be non-reproducible. Compare the exact image digest or build checksum running in each environment rather than trusting the tag alone. Check for environment-specific configuration, feature flags, or dependency versions pulled at build time that could differ, then move toward immutable, digest-pinned artifacts to prevent this class of issue.",commands:["docker inspect --format '{{.RepoDigests}}' <image>  # compare across environments","diff <(env) <(ssh other-env env)  # compare runtime environment variables","Compare build metadata: build number, commit SHA embedded in the artifact","Check feature-flag/config service values per environment"],verify:"Confirm both environments run the identical artifact digest and produce the same behavior for the same input."},
  {id:117,domain:"DevOps",category:"Testing & Quality",level:"Important",question:"A handful of automated tests fail intermittently in CI and block merges, but pass when re-run. How do you deal with flaky tests responsibly?",answer:"Do not just add automatic retries as the permanent fix, since that hides real bugs like race conditions or shared test state. Identify the specific flaky tests from CI history, reproduce the failure locally by running them repeatedly, and look for timing assumptions, shared fixtures, unmocked network calls, or test-order dependencies. Quarantine a confirmed-flaky test with visible tracking rather than silently ignoring it, and fix it as its own workstream.",commands:["Review CI history for the pass/fail pattern of the specific test","Run the test in a loop locally: for i in {1..50}; do pytest <test>; done","Check for shared global state or unmocked network/time calls in the test","Tag and track flaky tests separately in the test suite"],verify:"Confirm the identified test passes consistently across many repeated runs, not just occasionally, before removing it from quarantine."},
  {id:118,domain:"DevOps",category:"GitOps",level:"Important",question:"Your GitOps controller shows an application as OutOfSync, and someone keeps 'fixing' it by editing the cluster directly, only for it to drift again. How do you resolve this properly?",answer:"The recurring drift is a workflow problem, not a sync bug. Every manual cluster edit gets reverted or flagged again because Git is the source of truth by design. Find out why someone felt they had to make a manual change, whether it was an emergency fix or a missing capability in the Git-managed configuration, and get that change into the repository through the normal review process. Use a sync-pause only for coordinated maintenance, never as a routine workaround.",commands:["argocd app diff <app>","argocd app history <app>","kubectl diff -f <manifest>  # compare desired vs live","argocd app sync <app>"],verify:"Confirm the application shows Synced after the change is committed through Git, and drift does not reappear on the next reconciliation."},
  {id:119,domain:"DevOps",category:"Feature Flags",level:"Important",question:"A feature flag rollout to 10 percent of users causes errors for that group shortly after enabling. What is your immediate response and follow-up?",answer:"Turn the flag off or roll the percentage back to zero first; a flag-based rollback is faster and safer than a code deployment rollback. Confirm the error is actually correlated with the flagged cohort and not a coincidental unrelated issue. After mitigating impact, investigate the feature logic, any dependent service it calls, and whether the targeting rules were configured correctly, then add monitoring tied to the flag so future rollouts alert automatically on error-rate increases.",commands:["Disable or scope the flag to 0% via the flag service/API","Query error rates segmented by flag variant/cohort","Review application logs filtered to the affected user segment","Check flag targeting rules for misconfiguration"],verify:"Confirm error rates for the affected cohort return to baseline immediately after disabling the flag, then validate the fix with a small canary re-enable."},
  {id:120,domain:"DevOps",category:"Database Migrations",level:"Critical",question:"A schema migration step in your deployment pipeline locks a production table and causes request timeouts. How do you handle it in the moment and prevent recurrence?",answer:"If the migration is still running and safe to let finish, monitor rather than kill it, since aborting a long DDL operation can leave things worse. If it must be stopped, understand the specific lock type and rollback behavior for your database engine before terminating it. Going forward, require migrations to use online or non-blocking techniques such as adding columns without defaults, backfilling data separately from schema changes, and running heavy migrations during low-traffic windows.",commands:["SELECT * FROM pg_stat_activity WHERE wait_event_type = 'Lock';  -- or engine-specific equivalent","SHOW ENGINE INNODB STATUS;  -- MySQL","Review migration tool logs for current step and estimated duration","KILL <blocking-query-pid>;  -- only after confirming safe rollback"],verify:"Confirm application latency returns to normal after the migration completes or is safely rolled back, and future migrations are tested for lock duration against production-scale data."},
  {id:121,domain:"DevOps",category:"Zero-Downtime Deployments",level:"Critical",question:"A rolling deployment shows all health checks passing, yet users still experience dropped connections during the rollout. What is missing?",answer:"Passing health checks only confirms new pods are ready to receive traffic, not that old pods finished in-flight requests before terminating. Check whether the application handles SIGTERM gracefully, whether there is a preStop hook or delay before the load balancer deregisters the terminating instance, and whether the readiness probe and the load balancer's own health check are aligned with real traffic-drain time. Add graceful shutdown handling and align the termination grace period with actual drain time.",commands:["kubectl get pod <pod> -o yaml | grep -A5 lifecycle","kubectl describe deployment <name> | grep -i grace","Check application logs for connections still open at SIGTERM","Review load balancer deregistration delay setting"],verify:"Run a rollout under synthetic load and confirm zero failed requests are recorded during the full rollout window."},
  {id:122,domain:"DevOps",category:"Scaling & Capacity",level:"Important",question:"Autoscaling is configured, but during a sudden traffic spike the service still becomes overloaded before new capacity comes online. How do you fix this?",answer:"Reactive autoscaling always has a lag between the metric crossing a threshold and new capacity becoming ready, including image pull, startup, and warm-up time. Reduce the scale-up delay by tuning the metric evaluation window and cooldown, pre-provision a buffer of baseline capacity for known-spiky workloads, and reduce instance startup time itself. For predictable spikes, use scheduled or predictive scaling ahead of the event instead of relying purely on reactive metrics.",commands:["Review HPA/ASG scaling policy: evaluation period, cooldown, target metric","kubectl describe hpa <name>","Measure actual pod/instance startup-to-ready time","Check whether the scaling metric (CPU, custom, request rate) lags real load"],verify:"Replay a similar load pattern in a test and confirm capacity comes online before saturation this time."},
  {id:123,domain:"DevOps",category:"Cost Optimization",level:"Important",question:"Your monthly cloud bill spiked and the increase traces back to CI/CD infrastructure rather than production workloads. What likely happened, and how do you fix it?",answer:"Self-hosted CI runners or ephemeral build agents are an easy place for cost to leak, typically from runners not scaling down, orphaned instances from failed cleanup, or oversized default instance types. Break down cost by pipeline, runner pool, and job type, identify jobs with abnormally long runtimes or idle runner time, and confirm the runner fleet's autoscaling and idle-timeout settings are actually working as configured, not just documented.",commands:["Review cost explorer filtered to CI/CD tagged resources","List running CI runner instances and their uptime","Check runner autoscaler idle-timeout and min/max settings","Review pipeline history for abnormally long-running jobs"],verify:"Confirm runner fleet cost returns to the expected baseline and idle runners are terminated within the configured timeout."},
  {id:124,domain:"DevOps",category:"DevSecOps",level:"Important",question:"A security scanning gate in your pipeline keeps failing builds with what the team believes are false positives, and there is pressure to just disable it. How do you handle this?",answer:"Do not disable the gate outright, since that removes real protection along with the noise. Triage the specific findings to separate genuine false positives from real but low-priority issues, tune the scanner's rules or add scoped suppressions with a documented reason and expiry, and set severity-based thresholds so only high-confidence, high-severity findings block a build. Track suppressed findings so they don't silently accumulate risk over time.",commands:["Review scanner findings report, filtered by severity and confidence","Add scoped suppression with justification and expiry, not a blanket ignore","Adjust pipeline gate threshold: block only on high/critical confirmed findings","Schedule periodic review of all suppressed findings"],verify:"Confirm the pipeline blocks on genuine high-severity issues while previously reported false positives no longer fail the build."},
  {id:125,domain:"DevOps",category:"Incident Management",level:"Critical",question:"A production incident is resolved. How do you run the postmortem so it actually prevents recurrence instead of becoming a formality?",answer:"Keep it blameless and focused on systems, not individuals. Build a precise timeline from detection to resolution using logs and monitoring, distinguish the triggering event from contributing factors and the recovery action, and identify why existing safeguards did not catch or prevent it sooner. Write specific, owned, and time-bound action items instead of vague statements like 'improve monitoring,' and track them to completion like any other work item.",commands:["Assemble timeline from monitoring, logs, deploy history, and chat logs","Document trigger, contributing factors, detection time, resolution time","Identify the earliest point the issue could have been caught","Create tracked action items with owners and due dates"],verify:"Confirm each postmortem action item is completed and, where possible, validated with a test that would have caught the original issue."},
  {id:126,domain:"DevOps",category:"SRE Practices",level:"Important",question:"Your team defined an SLO with an error budget, and it is now exhausted for the quarter. What should change in day-to-day engineering work?",answer:"An exhausted error budget means reliability work now takes priority over new feature releases until the budget recovers, by policy agreed in advance rather than as a one-off argument during an incident. Slow down or pause risky releases, focus engineering time on the reliability issues that consumed the budget, and communicate the trade-off transparently to stakeholders. Review whether the SLO target itself was realistic if this keeps happening.",commands:["Review SLO dashboard: current burn rate and remaining budget","Identify top contributors to budget consumption from incident/error data","Confirm the release freeze or reduced release cadence policy is applied","Reassess the SLO target if budget exhaustion is a recurring pattern"],verify:"Confirm the error budget trend stabilizes or recovers after reliability work is prioritized, and the policy was followed consistently."},
  {id:127,domain:"DevOps",category:"Log Aggregation",level:"Important",question:"Your centralized logging pipeline starts dropping logs during periods of high traffic, making incidents harder to investigate. What do you check?",answer:"Identify which stage of the pipeline is the bottleneck: the log shipper on the host, the ingestion or queue layer, or the indexing and storage backend. Check for backpressure, buffer overflow, or rate-limiting at each stage, and whether the shipper is configured to drop logs silently on failure instead of buffering to disk. Right-size the ingestion layer for peak, not average, volume, and add sampling only for genuinely high-volume, low-value log types rather than dropping indiscriminately.",commands:["Check log shipper (Fluentd/Filebeat/Vector) buffer and drop metrics","Check message queue/broker lag if one is used (e.g., Kafka consumer lag)","Check the indexing backend for rejected/throttled write metrics","Review shipper config for on-disk buffering vs in-memory drop behavior"],verify:"Replay a peak-volume test and confirm log volume received matches log volume generated, with no unexplained gaps."},
  {id:128,domain:"DevOps",category:"Multi-Environment Management",level:"Important",question:"A bug only reproduces in production and not in staging, even though staging is supposed to mirror production. How do you find the drift?",answer:"Trust nothing labeled 'identical' by convention; verify it. Compare configuration, infrastructure sizing, data shape and volume, feature-flag state, and third-party service versions between the two environments systematically instead of guessing. Pay particular attention to data-dependent bugs, since staging data is often smaller or synthetic and can hide issues that only appear at production scale or with real data patterns.",commands:["diff staging and production configuration values side by side","Compare infrastructure-as-code plan output for both environments","Check feature flag state per environment","Compare data volume/shape: row counts, distribution of key fields"],verify:"Reproduce the bug in staging after aligning the identified difference, confirming that difference was the actual cause."},
  {id:129,domain:"DevOps",category:"Build Performance",level:"Important",question:"CI build times have been steadily increasing over several months with no single obvious cause. How do you diagnose and fix it?",answer:"Look at trend data rather than a single slow run. Break the pipeline into stages and compare stage duration over time to find where the growth is concentrated, such as dependency installation, test suite growth, or image build layers. Common causes include an ever-growing test suite run serially, cache invalidation from unrelated file changes, and a lock file no longer using a fast resolver or proper cache. Address the specific growing stage rather than broadly adding runner resources.",commands:["Compare stage-by-stage duration trend across recent builds","Check dependency/package manager cache hit rate","Check for full re-installs caused by unnecessarily invalidated Docker layer cache","Review test suite parallelization/sharding configuration"],verify:"Confirm the targeted stage's duration returns close to its historical baseline and overall pipeline time trends back down."},
  {id:130,domain:"DevOps",category:"Chaos Engineering",level:"Important",question:"Leadership wants more confidence that the system can survive real failures. How would you introduce chaos engineering safely?",answer:"Start small, in a controlled blast radius, with a clear hypothesis, not a surprise production-wide failure injection. Begin in staging or a limited production canary with monitoring and an immediate abort mechanism, test one failure mode at a time such as a single instance termination or added latency, and require a rollback plan before every experiment. Expand scope gradually as confidence and tooling maturity increase, and always feed findings back into concrete reliability fixes.",commands:["Define a hypothesis: 'system should survive X failure with Y impact'","Run the experiment in a limited blast radius with monitoring dashboards open","Use a chaos tool with a built-in abort/rollback, e.g., Chaos Mesh or Gremlin","Document findings and file follow-up reliability work"],verify:"Confirm the experiment's actual impact matched or stayed within the predicted blast radius, and any gap found is tracked as a fix."},

  {id:201,domain:"Cloud",category:"Compute",level:"Critical",question:"A cloud VM is running but unreachable over SSH. What is your troubleshooting order?",answer:"Check instance state and platform health, security-group or NSG rules, subnet route tables, public or private IP assignment, network ACLs, OS firewall, sshd listening state, and the return path. Use console or serial access if network access is unavailable.",commands:["ip addr","ip route","ss -lntp | grep :22","systemctl status sshd","journalctl -u sshd -b"],verify:"Confirm SSH works from the approved source and only the required network path is open."},
  {id:202,domain:"Cloud",category:"Networking",level:"Critical",question:"A private subnet can reach internal systems but not the internet. What could be missing?",answer:"Check whether the subnet has a default route to the correct NAT or egress service, whether the NAT has upstream internet connectivity and a public address, and whether security controls permit outbound traffic and return traffic. Also confirm DNS separately from IP connectivity.",commands:["ip route","curl -I https://example.com","dig example.com"],verify:"Test outbound connectivity by IP and DNS from the private workload without exposing it directly to inbound internet traffic."},
  {id:203,domain:"Cloud",category:"Storage",level:"Critical",question:"A cloud disk was expanded in the portal but Linux still shows the old filesystem size. What next?",answer:"Expansion has layers. Rescan if necessary, confirm the block device sees the new size, grow the partition or LVM PV when used, extend the LV, and finally grow the filesystem with the correct tool. Take a backup or snapshot according to change policy before storage changes.",commands:["lsblk","growpart /dev/<disk> <partition>","pvresize /dev/<partition>","lvextend -r -L +20G /dev/<vg>/<lv>","xfs_growfs <mountpoint>"],verify:"Confirm lsblk, LVM, and df all show the expected size and applications can write successfully."},
  {id:204,domain:"Cloud",category:"High Availability",level:"Critical",question:"One availability zone fails. How should a highly available application behave?",answer:"Healthy capacity in another zone should continue serving traffic through a zone-aware load balancer, with replicated or managed data services and sufficient spare capacity. Recovery plans must also account for quorum, session state, DNS, and dependencies that may still be single-zone.",commands:["curl -f https://<health-endpoint>","dig <service-domain>"],verify:"Run or review a controlled failover test and confirm both technical health and business transactions succeed."},
  {id:205,domain:"Cloud",category:"IAM",level:"Critical",question:"An application has broad cloud administrator credentials. How do you reduce risk?",answer:"Replace long-lived human-style credentials with a workload identity or instance role, grant only the actions and resources required, scope conditions where possible, rotate exposed credentials, and monitor privileged API activity. Test the least-privilege policy against real application operations.",commands:["env | grep -i -E 'key|secret|token'","grep -RniE 'access.*key|secret' ."],verify:"Confirm the application functions with the restricted identity and denied actions are visible in audit logs."},
  {id:206,domain:"Cloud",category:"Cost",level:"Important",question:"Cloud cost increased sharply this month. How do you investigate without guessing?",answer:"Break cost down by service, account or subscription, region, tag, and usage type. Compare with the previous period and recent deployments. Look for newly provisioned resources, data egress, autoscaling growth, snapshots, idle compute, oversized services, or changed pricing commitments.",commands:["Use the provider cost explorer and resource inventory","Review IaC and deployment history for the same period"],verify:"Tie each major cost increase to a specific resource or usage change and assign an owner or remediation."},
  {id:207,domain:"Cloud",category:"Disaster Recovery",level:"Critical",question:"A backup exists. Does that mean the cloud workload has a valid DR plan?",answer:"No. A backup is only one component. Define RPO and RTO, protect configuration and secrets, replicate or export required data, document network and DNS recovery, automate rebuild where possible, and regularly restore into an isolated environment to prove recoverability.",commands:["Document restore runbook","Test restore and application validation in an isolated environment"],verify:"Record measured restore time, recovered data point, and any gaps against the required RTO and RPO."},
  {id:208,domain:"Cloud",category:"Infrastructure as Code",level:"Important",question:"Someone changed a cloud resource manually and Terraform now shows drift. What do you do?",answer:"Review the plan to understand the difference and business intent. Decide whether the manual change should be reverted, imported or represented in code. Do not blindly apply a plan that may destroy valid production changes. Restore code as the source of truth after approval.",commands:["terraform plan","terraform state list","terraform import <address> <id>"],verify:"A final plan should show no unexpected changes and the repository should represent the approved state."},
  {id:209,domain:"Cloud",category:"Load Balancing",level:"Critical",question:"Users intermittently see 502 or 504 errors from your cloud load balancer even though every backend instance reports healthy. What do you investigate?",answer:"Separate load-balancer-side timeouts from backend-side failures. Compare the LB's idle and backend timeout values against actual application response time, check connection draining during deploys or scale-in events, and confirm the health-check path behaves the same as the real traffic path. Correlate error spikes with autoscaling or deployment timestamps before changing timeout values blindly.",commands:["Review LB access logs for backend status and latency","curl -w timing directly to a backend, bypassing the LB","Review backend application logs for the same window","Check autoscaling and deployment event timeline","Compare LB health-check path against the real request path"],verify:"Confirm the 502/504 rate returns to baseline and backend latency stays under the LB timeout with no correlated scaling events."},
  {id:210,domain:"Cloud",category:"Auto Scaling",level:"Important",question:"An Auto Scaling Group keeps launching and terminating instances repeatedly instead of settling at a stable size. What is happening?",answer:"Flapping usually means the scaling policy's cooldown or evaluation window is too short relative to how long a new instance takes to become healthy, so the metric doesn't drop before the next evaluation, or a scale-in policy is too aggressive relative to a bursty metric. Check the actual metric behavior against the policy thresholds, cooldown period, and target-tracking configuration, and confirm health checks aren't marking healthy instances unhealthy during a normal warm-up window.",commands:["Describe scaling policies and current alarm state","Review the scaling metric graph over the flapping window","Check ASG health-check grace period vs actual instance warm-up time","Review scaling activity history for a repeating launch/terminate pattern"],verify:"Confirm the group reaches and holds a stable desired capacity under steady load without repeated launch/terminate cycles."},
  {id:211,domain:"Cloud",category:"Serverless",level:"Important",question:"A serverless function works fine under light traffic but starts timing out and throttling during a traffic spike. What do you investigate?",answer:"Distinguish cold-start latency, concurrency limits, and downstream dependency saturation. Check whether the function is hitting its account or reserved concurrency limit and being throttled, whether cold starts increase under burst traffic, and whether a downstream dependency such as a database connection pool is the actual bottleneck causing the function to run longer. Fix the real bottleneck rather than just raising the function timeout.",commands:["Check function concurrency metrics and throttle count","Review function duration and cold-start metrics during the spike window","Check downstream dependency latency and connection limits during the same window","Review reserved/provisioned concurrency configuration"],verify:"Confirm throttles drop to zero and duration stays within budget under a repeat of the same traffic pattern."},
  {id:212,domain:"Cloud",category:"Managed Databases",level:"Critical",question:"A managed relational database shows high CPU and connection counts climbing until the application starts failing to connect. What is your approach?",answer:"Identify whether the load is legitimate traffic growth, a runaway or unindexed query, or a connection leak in the application not releasing connections back to the pool. Check active queries and their execution plans, connection pool configuration on the application side, and whether read traffic can be offloaded to a read replica. Avoid resizing the instance as a first response before understanding the actual query or connection pattern.",commands:["Query active sessions and long-running queries (pg_stat_activity / SHOW PROCESSLIST)","Review slow query log / Performance Insights for the top consuming queries","Check application-side connection pool size vs database max_connections","Review connection count trend in monitoring"],verify:"Confirm CPU and connection count return to a stable baseline and the offending query or leak is fixed, not just the symptom."},
  {id:213,domain:"Cloud",category:"Container Orchestration",level:"Critical",question:"A managed Kubernetes cluster shows nodes going NotReady intermittently, though the underlying VMs appear healthy. How do you troubleshoot the platform layer?",answer:"Separate node OS health from the managed control plane's view of the node. Check kubelet logs and status on the affected node, node-to-control-plane connectivity including any security group or firewall changes, and whether resource pressure (disk, memory) is triggering eviction-related NotReady states. Also check for cloud provider events like host maintenance or spot instance reclamation.",commands:["kubectl get nodes -o wide","kubectl describe node <node>","journalctl -u kubelet -n 200  # on the affected node","Check cloud provider console for host/instance events on that node"],verify:"Confirm the node remains Ready consistently across several monitoring intervals and workloads are not repeatedly evicted from it."},
  {id:214,domain:"Cloud",category:"Multi-Cloud & Hybrid",level:"Important",question:"Leadership asks you to design connectivity between an on-premises data center and a cloud VPC for a hybrid workload. What do you need to define before choosing a solution?",answer:"Clarify bandwidth and latency requirements, required availability, traffic volume and cost sensitivity, and security requirements before choosing between a site-to-site VPN and a dedicated private connection. Define the routing approach, whether BGP dynamic routing or static routes, check for address overlap between on-prem and cloud CIDR ranges, and define failover behavior if the primary path fails.",commands:["Document on-prem and cloud CIDR ranges and check for overlap","Define required bandwidth, latency, and availability SLA","Choose VPN vs dedicated private connection based on those requirements","Design BGP or static routing with a defined failover path"],verify:"Test failover by disabling the primary path and confirm traffic converges to the backup path within the required time."},
  {id:215,domain:"Cloud",category:"CDN & Edge",level:"Important",question:"Users report that after a content update, they are still seeing the old version of a static asset served through your CDN. What is happening and how do you fix it?",answer:"The CDN edge is serving a cached copy because the cache-control headers or CDN policy still consider it fresh. Confirm the origin is actually serving the new content, check cache-control/max-age headers and any override rules, and invalidate the specific cached path rather than assuming a full purge is needed for routine deploys. For frequently updated assets, use versioned filenames or cache-busting query strings instead of relying on manual invalidation.",commands:["curl -I <origin-url>  # confirm origin has the new version","curl -I <cdn-url>  # compare cache headers/age from the edge","Trigger a targeted cache invalidation for the specific path","Review cache-control/max-age configuration for that asset type"],verify:"Confirm the CDN edge serves the new version globally and future updates use versioned paths to avoid relying on manual invalidation."},
  {id:216,domain:"Cloud",category:"DNS & Traffic Management",level:"Critical",question:"You need to fail traffic over to a secondary region if the primary region becomes unhealthy, with minimal manual intervention. How do you design this at the DNS layer?",answer:"Use a managed DNS health-check-based failover routing policy pointing at both regions, with health checks against a meaningful application-level endpoint, not just a ping. Set a low but reasonable TTL so clients pick up the failover promptly, and test failover regularly rather than assuming it works. Account for client-side and resolver caching, since not all clients respect TTL precisely.",commands:["Configure a DNS health check against an application-level endpoint, not just ICMP","Set failover routing policy: primary and secondary records with health check association","Set an appropriate TTL for the failover record","Test failover by intentionally failing the primary health check in a controlled window"],verify:"Confirm client traffic shifts to the secondary region within the expected time after a controlled failure of the primary health check."},
  {id:217,domain:"Cloud",category:"Governance & Tagging",level:"Important",question:"Finance says untagged cloud resources make it impossible to know which team owns a growing cost. How do you fix this without slowing teams down?",answer:"Enforce tagging at resource creation time rather than auditing and fixing it after the fact. Use policy-as-code or tag policies to require key tags such as owner, environment, and cost-center, and integrate the check into the CI/CD or provisioning pipeline so non-compliant resources are rejected or flagged before creation. Run a one-time remediation pass for existing untagged resources with owner identification from access logs where tags are missing.",commands:["Define a required tag policy (Tag Policies / Azure Policy / Org Policy)","Add a pre-deployment check in CI/CD or IaC with tag validation rules","Query existing resources missing required tags","Identify likely owners for legacy untagged resources via activity logs"],verify:"Confirm new resources are rejected or flagged without required tags, and the percentage of untagged resources trends toward zero."},
  {id:218,domain:"Cloud",category:"Object Storage",level:"Important",question:"An object storage bucket is growing rapidly in both size and cost, but no one is sure which application or process is writing to it. How do you investigate?",answer:"Enable and review storage access logging or the provider's usage analytics to identify the writing principal, source, and object prefix pattern. Break down growth by prefix to isolate the source, and check whether an application is missing a lifecycle policy for temporary or intermediate data that should have been deleted. Apply lifecycle rules to transition or expire data once the source and retention need are confirmed.",commands:["Enable/review server access logs or storage analytics","Break down object count and size by prefix","Check application code/config for missing cleanup or lifecycle logic","Configure a lifecycle policy for expiration/tiering once retention is known"],verify:"Confirm growth rate drops to the expected baseline and a lifecycle policy prevents unbounded accumulation going forward."},
  {id:219,domain:"Cloud",category:"Encryption & Key Management",level:"Critical",question:"A team accidentally deleted a customer-managed encryption key that data was encrypted with. What is the actual impact and what should you do?",answer:"Treat this as a potential permanent data-loss event, since data encrypted under a deleted key is unrecoverable once the key is truly gone. Immediately check whether the key is in a pending-deletion window that can still be cancelled, since most providers enforce a waiting period specifically to prevent instant, irreversible loss. If the window has passed, identify exactly which data was encrypted with that key and assess restoration options from backup.",commands:["Check key status: pending deletion vs already deleted, and remaining cancellation window","Cancel the scheduled deletion if the window is still open","Identify which resources/data reference the deleted key ID","Assess backup/snapshot recovery options if the key is unrecoverable"],verify:"Confirm the key deletion is cancelled in time, or that a validated backup restoration plan exists for any data left unrecoverable."},
  {id:220,domain:"Cloud",category:"VPC & Networking",level:"Critical",question:"Two VPCs are peered, but resources in one VPC still cannot reach resources in the other, even though the peering connection shows as active. What do you check?",answer:"An active peering connection only enables the network path; it does not automatically add routes or open security groups. Check route tables on both sides for a route to the peer's CIDR, security group and network ACL rules on both sides, and whether the CIDR ranges overlap, which silently breaks peering routing. Also confirm the peering connection was accepted, not just requested, if it crosses accounts.",commands:["Review route tables on both VPCs for a route to the peer CIDR","Check security group rules on both sides for the specific traffic","Check network ACLs for both subnets involved","Confirm peering connection state is Active/Accepted, not Pending"],verify:"Confirm bidirectional connectivity test succeeds between resources in both VPCs on the required ports."},
  {id:221,domain:"Cloud",category:"Cloud Migration",level:"Important",question:"You're migrating a stateful application to the cloud and need near-zero downtime for the cutover. How do you approach it?",answer:"Avoid a big-bang cutover for stateful workloads. Use continuous data replication to keep the cloud copy in sync with the source until cutover, validate data integrity and application behavior against the replicated copy before switching, and plan a short, well-communicated maintenance window only for the final delta sync and traffic switch. Have a tested rollback plan back to the source in case the cutover reveals an issue.",commands:["Set up continuous replication from source to target","Validate data consistency between source and target before cutover","Freeze writes briefly for the final delta sync at cutover time","Switch traffic (DNS/load balancer) and monitor closely post-cutover"],verify:"Confirm the application functions correctly on the new environment with data consistency validated, and the rollback path was tested beforehand."},
  {id:222,domain:"Cloud",category:"Monitoring & Observability",level:"Important",question:"Your cloud monitoring dashboard shows all green, but customers are reporting errors. What does this gap tell you, and how do you close it?",answer:"Infrastructure-level metrics like CPU and memory don't capture application-level correctness or user-facing errors, so this gap means you're measuring the wrong thing for the actual failure mode. Add synthetic transactions or real user monitoring that exercises the actual customer journey, and alert on business-relevant signals such as error rate and latency percentiles from the application itself, not just infrastructure metrics.",commands:["Review current alerting rules: infrastructure-only or application-aware?","Add synthetic monitoring for key user journeys","Review application-level error rate and latency percentile dashboards","Correlate customer-reported errors with application logs for the same window"],verify:"Confirm new application-aware alerts would have fired during the reported incident window, closing the detection gap."},
  {id:223,domain:"Cloud",category:"Spot & Reserved Capacity",level:"Important",question:"A batch processing workload running on spot/preemptible instances keeps losing progress when instances are reclaimed. How do you make it resilient?",answer:"Spot capacity can be reclaimed at any time by design, so the workload must tolerate interruption rather than assume it won't happen. Use the interruption warning signal to checkpoint progress before termination, design jobs to be resumable from the last checkpoint, and split large jobs into smaller idempotent units so a reclaimed instance only loses a small amount of work.",commands:["Poll the interruption notice endpoint/metadata and checkpoint on warning","Persist job checkpoints to durable storage, not local disk","Design job units to be small and idempotent","Configure the job scheduler to automatically resume from the last checkpoint"],verify:"Simulate a spot interruption and confirm the job resumes from its last checkpoint with minimal lost work."},
  {id:224,domain:"Cloud",category:"Compliance & Audit",level:"Important",question:"An auditor asks you to prove who had access to a specific production resource during a defined time window. Can you answer this today?",answer:"This requires centralized, immutable, sufficiently retained activity logging, not just current IAM policy state, since current permissions don't prove historical access. Confirm cloud audit logging is enabled account-wide, sent to a separate, access-restricted log destination, and retained long enough to cover compliance requirements. If logging wasn't enabled for the relevant window, document that gap and remediate going forward.",commands:["Query the cloud audit trail for the resource and time window","Confirm logs are shipped to a separate account/project with restricted write access","Check log retention policy against the compliance requirement","Cross-reference role-assumption events with resource access events"],verify:"Confirm the audit trail produces a complete, exportable record of access for the requested window, or a documented gap with remediation if it does not."},
  {id:225,domain:"Cloud",category:"Secrets Management",level:"Critical",question:"An application needs database credentials, and currently they are stored as plaintext environment variables in the deployment configuration. How do you fix this properly?",answer:"Move credentials to a managed secrets service rather than plaintext configuration, and grant the application access via its workload identity rather than a shared static credential where possible. Rotate the currently exposed credential since it must be treated as compromised the moment it's found in plaintext, then update the application to fetch secrets at runtime rather than baking them into configuration or images.",commands:["Rotate the currently exposed database credential immediately","Create the secret in a managed secrets service","Grant the application's workload identity read access to that specific secret","Update application startup to fetch the secret at runtime instead of from plaintext config"],verify:"Confirm the plaintext credential no longer appears anywhere in configuration or version history, and the application authenticates successfully using the new managed secret."},
  {id:226,domain:"Cloud",category:"Service Limits & Quotas",level:"Important",question:"A deployment fails partway through with an error about exceeding a service quota, even though the account has been running fine for months. What do you do?",answer:"Identify the specific quota that was hit and whether it's a hard platform limit or a soft limit that can be raised. Check whether normal growth or a recent change pushed usage over the threshold, request a quota increase through the provider while working around the immediate blocker if a workaround exists, and add proactive quota monitoring so the team is alerted before hitting a hard failure next time.",commands:["Read the exact quota name and current usage from the error/console","Check the quota increase request process for that specific limit","Review recent resource growth trend to confirm reasonable growth vs a runaway process","Set up a monitoring alert at a percentage threshold of each critical quota"],verify:"Confirm the deployment completes successfully after the quota increase, and proactive alerting is in place before the next threshold."},
  {id:227,domain:"Cloud",category:"Landing Zone & Account Structure",level:"Important",question:"A company has been running everything in a single cloud account for years and it's now hard to manage security boundaries and billing. How would you propose restructuring it?",answer:"Recommend a multi-account or multi-subscription landing zone with clear separation by environment and/or business unit, each with its own billing visibility and blast-radius isolation, connected through centralized identity, logging, and networking. Plan the migration incrementally, starting with the highest-risk workload or the clearest boundary, rather than attempting a single big-bang reorganization.",commands:["Design account/subscription structure: prod, non-prod, shared-services, security-audit","Set up centralized identity federation (SSO) across accounts","Set up centralized, restricted-access audit logging aggregation","Plan phased workload migration starting with a low-risk pilot"],verify:"Confirm the pilot workload operates correctly in its new isolated account with centralized logging and identity intact before migrating the next workload."},
  {id:228,domain:"Cloud",category:"High Availability",level:"Critical",question:"A stateful service is deployed across two availability zones for high availability, but during a real zone outage it still went fully down. What likely went wrong?",answer:"Being deployed across two zones is not the same as being able to survive losing one, since a common gap is that the data layer or a leader/primary component was actually pinned to a single zone. Check whether the database or stateful component had a real standby that could be promoted, whether the surviving zone had enough spare capacity to absorb full load, and whether client connections and DNS actually redirected automatically instead of requiring a manual failover step that wasn't triggered in time.",commands:["Review architecture diagram for any single-zone dependency in the data or control path","Check whether database failover is automatic or requires manual promotion","Confirm surviving zone capacity was sized for 100% of load, not 50%","Review DNS/load balancer failover configuration and its actual trigger time"],verify:"Run a controlled zone-failure game day and confirm the service continues serving traffic within the defined RTO without manual intervention."},
  {id:229,domain:"Cloud",category:"Networking Security",level:"Critical",question:"A security review finds a database instance's security group allows inbound access from 0.0.0.0/0 on its database port. How do you remediate this safely in production?",answer:"Do not simply lock it down immediately without first identifying every legitimate source currently connecting, or you will cause an outage. Capture the current connection sources over a representative period, build a least-privilege rule set limited to the application's security group or specific known IP ranges, and roll it out with a validation window before removing the old open rule.",commands:["Capture current connections via VPC Flow Logs filtered to the DB port","Identify the legitimate application security group(s)/IP ranges from that data","Create a new restrictive rule referencing the application security group, not an IP range, where possible","Apply the change and monitor for connection failures before removing the old open rule"],verify:"Confirm only expected sources can connect after the change and no legitimate application traffic was broken."},
  {id:230,domain:"Cloud",category:"Cloud Networking Performance",level:"Important",question:"Two services in the same cloud region but different subnets are experiencing higher-than-expected latency between them. What do you check?",answer:"Same-region traffic between subnets should typically be low latency, so first confirm the path isn't unexpectedly routing through a NAT gateway, VPN, or security appliance that adds hops. Check for cross-AZ traffic when the workload was assumed to be same-AZ, since that adds real latency and cost, and verify there's no unexpected throughput throttling at the instance or NIC level.",commands:["ip route get <dest-ip>  # confirm the routing path is expected","Check whether the two instances are actually in the same AZ or different AZs","Review any NAT gateway/appliance in the path that shouldn't be there for internal traffic","Check instance network throughput limits/burst credit exhaustion"],verify:"Confirm latency drops to the expected same-region/same-AZ baseline once the unnecessary hop or AZ placement issue is corrected."},

  {id:301,domain:"Kubernetes",category:"Pods",level:"Critical",question:"A pod is in CrashLoopBackOff. How do you troubleshoot it?",answer:"Inspect pod events, current and previous container logs, exit code, probes, environment, configuration mounts, secrets, command and resource limits. CrashLoopBackOff is a retry state, not the root cause. Use the termination reason to decide the next check.",commands:["kubectl describe pod <pod>","kubectl logs <pod> -c <container>","kubectl logs <pod> -c <container> --previous","kubectl get pod <pod> -o yaml"],verify:"Confirm the pod stays Ready through multiple probe intervals and the application endpoint works."},
  {id:302,domain:"Kubernetes",category:"Scheduling",level:"Critical",question:"A pod remains Pending. What are the common causes?",answer:"Read scheduler events. Common causes include insufficient CPU or memory, unmatched node selectors or affinity, missing tolerations for taints, unbound PVCs, topology constraints, quota limits, and unavailable nodes. Fix the scheduling constraint rather than repeatedly recreating the pod.",commands:["kubectl describe pod <pod>","kubectl get nodes","kubectl describe node <node>","kubectl get pvc","kubectl get resourcequota -A"],verify:"Confirm the pod schedules onto an intended node and reaches Ready state."},
  {id:303,domain:"Kubernetes",category:"Networking",level:"Critical",question:"A Service exists but traffic does not reach the pods. What do you check?",answer:"Verify the Service selector matches pod labels, endpoints are populated, targetPort matches the container port, pods are Ready, and NetworkPolicies or ingress components allow the traffic. Test from inside the cluster to separate service discovery from external routing.",commands:["kubectl get svc <svc> -o yaml","kubectl get endpoints <svc>","kubectl get pods --show-labels","kubectl exec <pod> -- curl -v http://<svc>:<port>"],verify:"Confirm endpoints are healthy and traffic succeeds from both the required internal and external paths."},
  {id:304,domain:"Kubernetes",category:"Storage",level:"Critical",question:"A PVC is stuck in Pending. How do you troubleshoot it?",answer:"Check the PVC events, StorageClass, requested access mode and size, provisioner health, topology constraints, and available PVs if using static provisioning. Ensure the selected storage backend supports the requested mode and zone.",commands:["kubectl describe pvc <pvc>","kubectl get storageclass","kubectl get pv","kubectl get events --sort-by=.lastTimestamp"],verify:"Confirm the PVC becomes Bound and a test pod can mount and write to it."},
  {id:305,domain:"Kubernetes",category:"Rollouts",level:"Critical",question:"A Deployment rollout is stuck. What do you inspect?",answer:"Check rollout status and ReplicaSets, then inspect new pod scheduling, image pulls, readiness probes, startup failures, quotas, and maxUnavailable/maxSurge constraints. If impact is unacceptable, roll back to the last validated revision while investigating.",commands:["kubectl rollout status deployment/<name>","kubectl get rs","kubectl describe deployment <name>","kubectl rollout history deployment/<name>","kubectl rollout undo deployment/<name>"],verify:"Confirm the desired replicas are updated, available, Ready, and serving the intended version."},
  {id:306,domain:"Kubernetes",category:"Resources",level:"Critical",question:"A pod was killed with OOMKilled. What does that tell you?",answer:"The container exceeded its memory limit or was terminated under memory pressure. Inspect the termination reason, limits and requests, application memory behavior, and node pressure. Increase memory only after understanding whether the workload is correctly sized or leaking memory.",commands:["kubectl describe pod <pod>","kubectl top pod <pod> --containers","kubectl top node","kubectl get pod <pod> -o jsonpath='{.status.containerStatuses[*].lastState.terminated.reason}'"],verify:"Observe the workload under representative load and confirm memory stays within a justified limit."},
  {id:307,domain:"Kubernetes",category:"DNS",level:"Important",question:"Pods cannot resolve service names. How do you isolate Kubernetes DNS issues?",answer:"Test DNS from an affected pod, inspect /etc/resolv.conf, verify the DNS service and endpoints, check CoreDNS pods and logs, and review NetworkPolicies that may block UDP or TCP 53. Also determine whether only external names or cluster service names fail.",commands:["kubectl exec <pod> -- cat /etc/resolv.conf","kubectl exec <pod> -- nslookup kubernetes.default","kubectl -n kube-system get pods -l k8s-app=kube-dns","kubectl -n kube-system logs -l k8s-app=kube-dns --tail=100"],verify:"Confirm both cluster-local and required external names resolve from representative pods."},
  {id:308,domain:"Kubernetes",category:"Security",level:"Critical",question:"A pod is running privileged with hostPath mounts. Why is this risky?",answer:"Privileged containers and hostPath can bypass much of the container isolation boundary and expose the node filesystem or devices. Remove privileges unless technically required, use least-privilege securityContext settings, restrict hostPath, apply admission controls, and run as non-root where possible.",commands:["kubectl get pod <pod> -o yaml","kubectl auth can-i --list --as=system:serviceaccount:<ns>:<sa>"],verify:"Validate the workload functions with reduced privileges and policy prevents unapproved privileged pods."},
  {id:309,domain:"Kubernetes",category:"Configuration",level:"Important",question:"You updated a ConfigMap, but the running application is still using the old values. Why, and how do you fix it?",answer:"A ConfigMap update does not automatically propagate into a running pod. Environment variables sourced from a ConfigMap are set only at container start and never update live. Volume-mounted ConfigMaps eventually sync on the node, but the application must reload the file itself, which most apps do not do. Confirm how the ConfigMap is consumed, then trigger a controlled rollout to pick up the change, and consider a checksum annotation or the Reloader controller for future automatic restarts.",commands:["kubectl get configmap <name> -o yaml","kubectl describe pod <pod> | grep -A5 Mounts","kubectl exec <pod> -- cat /path/to/config","kubectl rollout restart deployment/<name>","kubectl rollout status deployment/<name>"],verify:"Exec into the new pod and confirm the mounted file or environment reflects the updated ConfigMap values."},
  {id:310,domain:"Kubernetes",category:"StatefulSets",level:"Critical",question:"A node hosting a StatefulSet pod goes into NotReady state. What happens to that pod, and how is it different from a Deployment pod in the same situation?",answer:"Kubernetes does not immediately reschedule a StatefulSet pod the way it would a Deployment pod, because doing so could risk two instances of the same identity writing to the same persistent volume simultaneously. The pod stays in an unknown/terminating state until the cluster is certain the old pod is truly gone, which for a genuinely unreachable node may require manual intervention to force-delete it after confirming it's safe. A Deployment pod, by contrast, is stateless and gets rescheduled promptly since there's no identity or storage uniqueness constraint to protect.",commands:["kubectl get pods -o wide  # check node and pod status","kubectl describe node <node>","kubectl get pod <pod> -o jsonpath='{.metadata.deletionTimestamp}'","kubectl delete pod <pod> --grace-period=0 --force  # only after confirming the node/workload is truly gone"],verify:"Confirm the replacement pod only starts after the old pod's storage is verifiably released, with no dual-write to the same volume."},
  {id:311,domain:"Kubernetes",category:"Autoscaling",level:"Important",question:"The Horizontal Pod Autoscaler shows a target CPU utilization but never scales the deployment up despite pods clearly running hot. What do you check?",answer:"Confirm the metrics pipeline the HPA depends on is actually working, since a common cause is metrics-server being unavailable or pods missing defined resource requests, which the CPU percentage calculation depends on. Check the HPA's current status and events for a specific reason, and confirm the deployment's max replica count and resource quota aren't silently capping the scale-up.",commands:["kubectl get hpa <name> -o wide","kubectl describe hpa <name>  # check conditions and events","kubectl top pods  # confirm metrics-server is returning data","kubectl get deployment <name> -o jsonpath='{.spec.template.spec.containers[*].resources}'"],verify:"Confirm the HPA reports a valid current metric value and scales the deployment when the target threshold is exceeded."},
  {id:312,domain:"Kubernetes",category:"Ingress",level:"Critical",question:"An Ingress resource is created and shows no errors, but requests to the hostname return a 404 from the ingress controller itself, not from your application. What does that indicate?",answer:"A 404 from the ingress controller, not the application, means the request never reached your service, so the routing rule itself is the problem. Check that the Ingress's host and path rules exactly match the request, that the referenced Service and port exist and have matching labels/selectors to Ready pods, and that the correct IngressClass is set if multiple ingress controllers are running in the cluster.",commands:["kubectl get ingress <name> -o yaml","kubectl get endpoints <service>","kubectl describe ingress <name>","curl -v -H 'Host: <hostname>' http://<ingress-controller-ip>/<path>"],verify:"Confirm the request reaches the intended pod and the application, not the ingress controller, returns the response code."},
  {id:313,domain:"Kubernetes",category:"Helm",level:"Important",question:"A Helm upgrade appears to succeed, but the running pods still show the old configuration. What is the likely cause?",answer:"Helm upgrading the release does not by itself force pods to restart if the underlying pod template hash didn't change, such as when only a referenced ConfigMap changed but the Deployment spec looks identical to Kubernetes. Confirm whether your chart uses a checksum annotation pattern to force a rollout on config changes, and check the actual applied values against what you intended to deploy in case a values file or --set flag didn't apply as expected.",commands:["helm get values <release> -a  # confirm the values actually applied","helm diff upgrade <release> <chart> -f values.yaml  # if the diff plugin is available","kubectl rollout restart deployment/<name>  # if config changed but pods didn't restart","helm history <release>"],verify:"Confirm the running pods reflect the new configuration after a rollout restart, and add a checksum annotation so future config-only changes trigger a rollout automatically."},
  {id:314,domain:"Kubernetes",category:"Multi-Tenancy",level:"Important",question:"Multiple teams share a cluster through separate namespaces, and one team's workload is consuming enough resources to affect other teams. How do you fix this at the platform level?",answer:"Namespace separation alone does not guarantee resource isolation. Apply ResourceQuotas per namespace to cap total resource consumption, and LimitRanges to enforce sane defaults and per-pod maximums so a single misconfigured workload can't consume the whole quota. For true isolation beyond soft limits, consider node pools or taints dedicated to specific teams for workloads with strict isolation requirements.",commands:["kubectl get resourcequota -n <namespace>","kubectl describe resourcequota -n <namespace>","kubectl apply -f limitrange.yaml -n <namespace>","kubectl top pods -n <namespace> --sort-by=cpu"],verify:"Confirm the offending namespace can no longer exceed its quota, and other teams' workloads are no longer starved of resources."},
  {id:315,domain:"Kubernetes",category:"RBAC",level:"Critical",question:"A service account has more permissions than it needs, discovered after a compromised pod was able to list secrets across the cluster. How do you fix this without breaking the application?",answer:"First determine exactly what API calls the application's service account actually needs by reviewing its code and audit logs, rather than guessing. Replace any broad ClusterRole binding with a narrowly scoped Role bound to just the required namespace and verbs/resources, and remove default service account auto-mounting for pods that don't need API access at all. Test the tightened permissions in a non-production namespace before rolling out broadly.",commands:["kubectl auth can-i --list --as=system:serviceaccount:<ns>:<sa>","Review audit logs for actual API calls made by that service account","kubectl create role <name> --verb=get,list --resource=pods -n <namespace>","kubectl patch serviceaccount <sa> -p '{\"automountServiceAccountToken\": false}'  # if API access isn't needed"],verify:"Confirm the application still functions correctly with the least-privilege role, and kubectl auth can-i confirms no unnecessary permissions remain."},
  {id:316,domain:"Kubernetes",category:"Admission Controllers",level:"Important",question:"After enabling a new admission webhook for policy enforcement, some previously working deployments suddenly fail to apply. How do you troubleshoot this safely?",answer:"Read the exact admission webhook rejection message, since it usually names the specific policy violated. Check whether the webhook fails open or closed if it's unreachable, since a closed failure mode can block all deployments cluster-wide if the webhook service itself has an issue. Roll out new policies in a dry-run or audit-only mode first before switching to enforce, and exempt system-critical namespaces explicitly if the policy wasn't designed with them in mind.",commands:["kubectl apply -f deployment.yaml --dry-run=server  # see webhook response directly","kubectl get validatingwebhookconfigurations","kubectl describe validatingwebhookconfiguration <name>  # check failurePolicy","kubectl logs -n <webhook-namespace> <webhook-pod>"],verify:"Confirm legitimate deployments succeed under the policy and only genuinely non-compliant resources are rejected, with a clear message explaining why."},
  {id:317,domain:"Kubernetes",category:"Operators & CRDs",level:"Important",question:"You installed an operator that manages a custom resource, and now a custom resource you created is stuck with no visible status update. How do you debug it?",answer:"Since the operator's reconciliation loop drives status updates, check the operator's own pod logs first, not just the custom resource's events, because the operator itself may be crashing or stuck on a dependency. Confirm the CRD schema matches what you submitted, check the operator's RBAC permissions against the resources it needs to manage, and look for events indicating an admission or validation rejection that occurred silently.",commands:["kubectl get <crd-kind> <name> -o yaml  # check status and events fields","kubectl logs -n <operator-namespace> <operator-pod>","kubectl describe <crd-kind> <name>","kubectl auth can-i --list --as=system:serviceaccount:<operator-ns>:<operator-sa>"],verify:"Confirm the custom resource's status field updates correctly and the operator's logs show successful reconciliation for that resource."},
  {id:318,domain:"Kubernetes",category:"Node Management",level:"Important",question:"You need to patch and reboot every node in a production cluster with minimal workload disruption. What is your process?",answer:"Cordon and drain nodes one at a time, or a small batch at a time, respecting PodDisruptionBudgets so you don't take down every replica of a service simultaneously. Confirm the cluster has enough spare capacity in remaining nodes to absorb evicted pods before draining the next one, and uncordon each node only after confirming it rejoined healthy, then move to the next.",commands:["kubectl cordon <node>","kubectl drain <node> --ignore-daemonsets --delete-emptydir-data","# patch and reboot the node via your OS/cloud tooling","kubectl uncordon <node>  # after it rejoins healthy"],verify:"Confirm each drained node's workloads rescheduled successfully with no PodDisruptionBudget violations and no user-facing downtime."},
  {id:319,domain:"Kubernetes",category:"etcd",level:"Critical",question:"The Kubernetes API server becomes slow to respond and kubectl commands start timing out cluster-wide. What is your first area of investigation?",answer:"Cluster-wide API slowness often traces back to etcd, since the API server depends on it for every read and write. Check etcd's own health, disk latency, and database size, since etcd is very sensitive to slow disk I/O and can degrade sharply if its database approaches its size limit. Also check for a sudden surge of API requests, such as a misbehaving controller in a watch-and-retry loop, overwhelming the control plane.",commands:["kubectl get componentstatuses  # or etcdctl endpoint health, depending on setup","etcdctl endpoint status --write-out=table","Check etcd disk I/O latency on the control plane nodes","kubectl get --raw /metrics | grep apiserver_request_duration"],verify:"Confirm etcd health checks pass, API server latency returns to baseline, and the cause of any request surge is identified and fixed."},
  {id:320,domain:"Kubernetes",category:"Service Mesh",level:"Important",question:"After enabling a service mesh sidecar injection, a batch job that used to complete now hangs indefinitely. Why, and how do you fix it?",answer:"A common cause is that the job's main container exits, but the sidecar proxy container keeps running, so the pod never reaches a Completed state and the job appears hung. Confirm whether the mesh has a documented pattern for handling Jobs, such as a sidecar that exits automatically when the main container finishes, or an exclusion for job pods, and apply that pattern rather than disabling the mesh for the whole namespace.",commands:["kubectl get pods -l job-name=<job> -o wide  # check container statuses within the pod","kubectl logs <pod> -c <sidecar-container>","Check mesh documentation/annotation for Job-compatible sidecar termination","kubectl describe pod <pod>  # confirm which container is still running"],verify:"Confirm the job's pod reaches Completed status promptly after the main container finishes, with the sidecar terminating automatically."},
  {id:321,domain:"Kubernetes",category:"Jobs & CronJobs",level:"Important",question:"A CronJob is supposed to run every hour, but you notice several scheduled runs were skipped entirely with no error. What could cause silently missed runs?",answer:"CronJobs have a startingDeadlineSeconds setting and a concurrencyPolicy that can silently cause missed runs, for example if the previous run was still active and the policy forbids concurrent runs, or if the controller was down past the starting deadline when a run was due. Check the CronJob's status for lastScheduleTime versus actual job history, and review controller-manager availability during the missed windows.",commands:["kubectl get cronjob <name> -o yaml  # check concurrencyPolicy and startingDeadlineSeconds","kubectl get jobs --selector=<cronjob-label>","kubectl describe cronjob <name>  # check lastScheduleTime vs expected","Check controller-manager logs/uptime during the missed window"],verify:"Confirm subsequent scheduled runs execute reliably and the concurrency/deadline settings match the actual expected run duration."},
  {id:322,domain:"Kubernetes",category:"Taints & Tolerations",level:"Important",question:"A pod that should run on a dedicated node pool keeps getting scheduled onto general-purpose nodes instead. What is misconfigured?",answer:"A toleration on the pod only permits it to be scheduled on tainted nodes; it does not force or prefer it to land there specifically, so without a matching nodeSelector or affinity rule the scheduler can still place it anywhere it fits. Add a nodeAffinity or nodeSelector targeting the dedicated pool's label in addition to the toleration for the taint, so the pod is both allowed onto the tainted nodes and steered toward them specifically.",commands:["kubectl get nodes --show-labels  # confirm dedicated pool label","kubectl get pod <pod> -o yaml | grep -A5 tolerations","kubectl get pod <pod> -o yaml | grep -A5 affinity","kubectl edit deployment <name>  # add nodeAffinity/nodeSelector matching the pool label"],verify:"Confirm new pods for this workload are consistently scheduled onto the dedicated node pool, not general-purpose nodes."},
  {id:323,domain:"Kubernetes",category:"Pod Disruption Budgets",level:"Important",question:"A cluster autoscaler or node drain operation is stuck and won't proceed, blocking a maintenance window. What is a likely cause?",answer:"An overly strict PodDisruptionBudget, such as minAvailable set to 100 percent of replicas, can prevent the eviction API from removing any pod voluntarily, blocking drains indefinitely even though the cluster has enough capacity elsewhere. Review the PDB's minAvailable/maxUnavailable against the actual replica count and real availability requirement, and confirm it isn't accidentally blocking all voluntary disruption for a workload that could tolerate at least one pod being evicted at a time.",commands:["kubectl get pdb -A","kubectl describe pdb <name>  # check current allowed disruptions","kubectl get deployment <name> -o jsonpath='{.spec.replicas}'","kubectl drain <node> --ignore-daemonsets  # observe the specific blocking reason"],verify:"Confirm the drain proceeds successfully after correcting the PDB, while still maintaining a safe minimum availability during the operation."},
  {id:324,domain:"Kubernetes",category:"Init Containers",level:"Important",question:"A pod stays stuck in Init state and never reaches Running, even though the main application container's image is confirmed healthy. What do you check?",answer:"The main container never starts until every init container completes successfully in order, so the problem is upstream. Check which specific init container is stuck or failing and its own logs and exit code, since it's a completely separate container with its own image, command, and potential misconfiguration. Common causes include an init container waiting on a dependency that never becomes ready, or a misconfigured command that never exits.",commands:["kubectl describe pod <pod>  # shows which init container is blocking","kubectl logs <pod> -c <init-container-name>","kubectl get pod <pod> -o jsonpath='{.status.initContainerStatuses}'"],verify:"Confirm all init containers complete successfully in sequence and the pod transitions to Running with the main container active."},
  {id:325,domain:"Kubernetes",category:"Cluster Upgrades",level:"Critical",question:"You need to upgrade a production Kubernetes cluster to a new minor version. What is your risk-reducing approach?",answer:"Read the specific version's deprecation and removal notes first, since APIs removed in the target version will break workloads still using them, and check every manifest and Helm chart for deprecated API usage before upgrading. Upgrade the control plane before worker nodes, upgrade one minor version at a time rather than skipping versions, and validate in a staging cluster that mirrors production workloads before touching production.",commands:["kubectl get --raw /metrics | grep apiserver_requested_deprecated_apis","Use a deprecated-API scanner (pluto/kubent) against your manifests and charts","Upgrade control plane first, verify health, then upgrade node pools","Validate critical workloads in a staging cluster on the target version first"],verify:"Confirm all workloads remain healthy post-upgrade with no deprecated API errors and the cluster version matches the target across control plane and nodes."},
  {id:326,domain:"Kubernetes",category:"Image Management",level:"Important",question:"A deployment rollout is stuck with pods showing ImagePullBackOff, even though the image tag looks correct. What do you check?",answer:"Confirm the image actually exists at that exact tag in the registry the cluster can reach, since a tag can be mistyped, not yet pushed, or pushed to the wrong registry/repository. Check the pod's imagePullSecrets against the registry's authentication requirement, and check whether the node has network access to the registry at all, particularly for private clusters or ones behind a proxy.",commands:["kubectl describe pod <pod>  # shows the exact pull error message","docker pull <image>:<tag>  # verify the image exists and is pullable manually","kubectl get pod <pod> -o jsonpath='{.spec.imagePullSecrets}'","kubectl get secret <pull-secret> -o yaml  # confirm it has valid registry credentials"],verify:"Confirm the pod successfully pulls the image and reaches Running state after the registry access or tag issue is fixed."},
  {id:327,domain:"Kubernetes",category:"Probes",level:"Critical",question:"A pod is marked Ready and receiving traffic, but the application is actually still warming up and returning errors for early requests. What is misconfigured?",answer:"The readiness probe is likely checking something too shallow, such as a basic TCP connect, rather than confirming the application has actually finished its warm-up work such as loading caches or establishing downstream connections. Build a readiness endpoint that reflects true application readiness, and use an appropriate initialDelaySeconds or a startup probe for applications with a genuinely long warm-up time so the readiness probe doesn't pass prematurely.",commands:["kubectl get pod <pod> -o yaml | grep -A10 readinessProbe","kubectl exec <pod> -- curl -s <readiness-endpoint>  # check what it actually validates","Review application startup logs for when it becomes truly ready to serve","Add/adjust a startupProbe for long warm-up workloads"],verify:"Confirm the pod is marked Ready only after real user-facing requests succeed, with no early-traffic errors during a fresh rollout."},
  {id:328,domain:"Kubernetes",category:"Resource Quotas",level:"Important",question:"A team cannot deploy a new pod in their namespace, with an error about exceeded quota, but their current running workloads are well below what they believe their quota limit is. What's the likely mismatch?",answer:"ResourceQuota typically counts requested resources, not actual usage, and it can also count objects like the number of pods, PVCs, or services, not just CPU and memory. Check every dimension the quota restricts, not just the one the team assumes, and compare it against the sum of resource requests, not observed usage, since over-provisioned requests can exhaust a quota well before real utilization does.",commands:["kubectl describe resourcequota -n <namespace>  # shows used vs hard limit per resource","Sum requested CPU/memory across all pods and compare to the quota","Check for non-compute quota dimensions like pod count or PVC count","kubectl get pods -n <namespace> -o jsonpath='{range .items[*]}{.metadata.name}{\"\\t\"}{.spec.containers[*].resources.requests}{\"\\n\"}{end}'"],verify:"Confirm the new pod deploys successfully after right-sizing requests or adjusting the quota, and the team understands which dimension was actually constraining them."},
  {id:329,domain:"Kubernetes",category:"Network Policies",level:"Critical",question:"After applying a NetworkPolicy intended to restrict traffic to one namespace, pods in a completely different, unrelated namespace suddenly can't communicate either. What went wrong?",answer:"NetworkPolicies are additive and default-deny once any policy selects a pod, so a broadly scoped or mistakenly matching selector can unintentionally affect pods outside the intended namespace, or a first policy in a namespace that previously had none can flip that namespace from fully open to default-deny for anything not explicitly allowed. Review the policy's podSelector and namespaceSelector scope carefully, and check whether the CNI plugin in use actually enforces NetworkPolicy at all, since silent non-enforcement is also a common surprise.",commands:["kubectl get networkpolicy -A","kubectl describe networkpolicy <name> -n <namespace>  # check selectors precisely","kubectl get pods -n <affected-namespace> --show-labels  # check for unintended label overlap","Confirm the CNI plugin (Calico/Cilium/etc.) enforces NetworkPolicy"],verify:"Confirm only the intended namespace's traffic is restricted and unrelated namespaces regain their expected connectivity."},
  {id:330,domain:"Kubernetes",category:"Control Plane",level:"Critical",question:"The kube-controller-manager or kube-scheduler pod is crash-looping on a self-managed cluster, and no new pods can be scheduled cluster-wide. How do you recover?",answer:"Identify the exact crash reason from its logs, such as a configuration error, certificate expiry, or resource exhaustion on the control plane node, before attempting a fix, since restarting it repeatedly without understanding the cause won't help. Check control plane node resource pressure and certificate validity first, since those are common root causes, and have a tested backup of etcd and control plane manifests ready in case recovery requires rebuilding a control plane node.",commands:["kubectl logs -n kube-system <controller-manager-pod> --previous","Check certificate expiry for control plane components: kubeadm certs check-expiration","Check control plane node resource pressure: df -h, free -h, top","Review static pod manifests in /etc/kubernetes/manifests for recent changes"],verify:"Confirm the component stays running stably and previously stuck pods begin scheduling normally across the cluster."},

  {id:401,domain:"Network",category:"Troubleshooting",level:"Critical",question:"Users can ping a server but cannot open its website. What do you check?",answer:"ICMP reachability only proves part of the path. Check DNS resolution, TCP connectivity to 80 or 443, server listening sockets, host and network firewalls, TLS handshake, reverse proxy or load balancer health, and application response. Test each layer separately.",commands:["dig <name>","nc -vz <host> 443","curl -vk https://<host>/","ss -lntp","tcpdump -ni any port 443"],verify:"Confirm DNS, TCP, TLS, and HTTP all succeed from an affected client path."},
  {id:402,domain:"Network",category:"DNS",level:"Critical",question:"A website works by IP but not by hostname. What is the likely troubleshooting path?",answer:"Focus on DNS and virtual-host behavior. Check the client resolver, record type and TTL, authoritative answer, split-DNS differences, and whether the web server or TLS certificate expects the hostname. Do not change routing when IP connectivity already works.",commands:["nslookup <name>","dig <name> A","dig +trace <name>","curl -vk --resolve <name>:443:<ip> https://<name>/"],verify:"Confirm the expected DNS record resolves from the affected network and hostname-based HTTPS works."},
  {id:403,domain:"Network",category:"Routing",level:"Critical",question:"A host can reach its local subnet but not a remote subnet. What do you inspect?",answer:"Check the host route table and default gateway, then trace the path. Verify intermediate routers have a forward route and, critically, a return route. Review ACLs, firewall rules, VPN selectors, and NAT policies that may affect the destination.",commands:["ip route","ip route get <remote-ip>","traceroute <remote-ip>","ping <gateway>"],verify:"Confirm forward and return traffic use the intended path without unintended NAT or filtering."},
  {id:404,domain:"Network",category:"Ports",level:"Critical",question:"A TCP port is open locally but closed from another subnet. How do you isolate where it is blocked?",answer:"Confirm the process is bound to the correct address, then capture packets on the server while testing remotely. If SYN packets never arrive, investigate upstream routing or firewall policy. If SYN arrives without response, inspect host firewall and listening state. If reset is returned, inspect application or proxy behavior.",commands:["ss -lntp","nc -vz <host> <port>","tcpdump -ni any tcp port <port>","nft list ruleset"],verify:"Observe a complete TCP handshake from the required source and confirm the application protocol succeeds."},
  {id:405,domain:"Network",category:"Performance",level:"Important",question:"Users report a slow network. How do you distinguish latency, loss, and bandwidth problems?",answer:"Measure round-trip latency and packet loss first, then test path variation and throughput. Check interface errors, drops, duplex or speed negotiation, queueing, and whether congestion is local or upstream. Avoid relying on a single internet speed-test result for internal network diagnosis.",commands:["ping -c 20 <target>","mtr <target>","ip -s link","ethtool <iface>","iperf3 -c <server>"],verify:"Compare measurements against a known-good baseline and confirm errors, loss, and latency are within acceptable limits."},
  {id:406,domain:"Network",category:"Subnetting",level:"Important",question:"Two hosts have IPs 192.168.10.10/24 and 192.168.11.10/24. Can they communicate directly without a router?",answer:"No, not with those /24 masks. They are in different Layer 3 subnets: 192.168.10.0/24 and 192.168.11.0/24. They need a router or Layer 3 switch with routes between the networks, unless the addressing or mask is changed as part of an intentional network design.",commands:["ipcalc 192.168.10.10/24","ipcalc 192.168.11.10/24"],verify:"Confirm each host's route table sends the other subnet to the intended gateway."},
  {id:407,domain:"Network",category:"VLAN",level:"Critical",question:"A device in a new VLAN cannot reach its default gateway. What do you check?",answer:"Verify access VLAN assignment or trunk allowance, switchport mode, tagging expectations, SVI or gateway status, subnet and mask, spanning-tree state, and any port security. A VLAN mismatch often produces local link-up with no Layer 3 reachability.",commands:["Check switch VLAN and trunk configuration","arp -a","ping <gateway>"],verify:"Confirm the device learns the gateway MAC in the correct VLAN and can reach routed networks."},
  {id:408,domain:"Network",category:"TLS",level:"Critical",question:"HTTPS suddenly shows a certificate warning even though the site is reachable. What do you verify?",answer:"Inspect the certificate presented by the actual endpoint, including subject alternative names, issuer, validity dates, chain, and SNI behavior. Check whether a load balancer or proxy is serving an old certificate and whether intermediate certificates are correctly installed.",commands:["openssl s_client -connect <host>:443 -servername <host> -showcerts","openssl x509 -noout -subject -issuer -dates -ext subjectAltName"],verify:"Validate from an external client that the complete chain is trusted and the hostname matches."},
  {id:409,domain:"Network",category:"NAT & Firewall",level:"Important",question:"Internal clients behind NAT can browse the internet normally, but a specific inbound service used by partners stops working after a firewall change. How do you isolate it?",answer:"Separate outbound NAT, which is working, from inbound port forwarding or DNAT rules, which are not. Firewalls typically apply the first matching rule, so a new broad rule can silently shadow the older specific one. Verify the DNAT mapping still points to the correct internal IP and port, check rule hit counters, and capture packets on both the external and internal interfaces to see exactly where the packet stops.",commands:["iptables -t nat -L -n -v --line-numbers","nft list ruleset","tcpdump -ni <ext-iface> port <port>","tcpdump -ni <int-iface> port <port>","conntrack -L | grep <port>"],verify:"Confirm inbound traffic reaches the internal service and hit counters increase only on the intended rule."},
  {id:410,domain:"Network",category:"BGP",level:"Critical",question:"A BGP neighbor relationship is stuck in the Active state and never reaches Established. What do you check?",answer:"A neighbor stuck in Active, rather than Idle, means the router is actively trying to open a TCP session but failing, which usually points to a Layer 3 reachability problem rather than a BGP configuration mismatch. Confirm basic IP reachability to the neighbor's address first, then check that TCP port 179 isn't blocked by an ACL or firewall, and confirm both sides have matching AS numbers and neighbor IP configuration, since a typo there also produces this exact symptom.",commands:["show ip bgp summary  # check state per neighbor","ping <neighbor-ip>  # confirm basic reachability","telnet <neighbor-ip> 179  # confirm TCP 179 isn't blocked","show ip bgp neighbors <neighbor-ip>  # check configured AS and any error messages"],verify:"Confirm the neighbor reaches Established state and expected routes are received and advertised correctly."},
  {id:411,domain:"Network",category:"OSPF",level:"Important",question:"Two OSPF routers are adjacent but stuck in the EXCHANGE state instead of reaching FULL. What is the likely cause?",answer:"A common cause of hanging in EXCHANGE is an MTU mismatch between the two interfaces, since database descriptor packets larger than the smaller MTU get silently dropped rather than fragmented during this exchange. Confirm both interfaces use the same MTU, and also check for a duplicate router ID on the segment, which can produce a similar adjacency problem.",commands:["show ip ospf neighbor  # confirm the stuck state","show interface <int> | include MTU  # compare MTU on both sides","show ip ospf interface <int>  # check router ID and area config","debug ip ospf adj  # observe the specific packet exchange failure"],verify:"Confirm the adjacency reaches FULL state after matching MTU or resolving the router ID conflict, and the routing table reflects expected OSPF routes."},
  {id:412,domain:"Network",category:"Spanning Tree",level:"Critical",question:"A newly connected switch causes intermittent, widespread connectivity loss across the whole broadcast domain. What do you suspect first?",answer:"This is a classic symptom of a spanning tree loop, often from a misconfigured or missing STP on the new switch, or a cable accidentally connecting two ports in a way that creates a loop without STP blocking it. Check for a broadcast storm on affected switches, verify STP is enabled and in the expected state on all ports, and look for a port flapping between forwarding and blocking, which indicates topology instability.",commands:["show spanning-tree  # check root bridge and port states across switches","show interfaces counters errors  # check for a storm on specific ports","show mac address-table  # look for a MAC address flapping between ports","Verify the new switch's STP is enabled and not defaulted to a conflicting priority"],verify:"Confirm the topology stabilizes with one consistent root bridge and no port flapping, and broadcast traffic returns to normal levels."},
  {id:413,domain:"Network",category:"DHCP",level:"Important",question:"Devices on a subnet intermittently fail to get an IP address from DHCP, even though the DHCP server is reachable and has available leases. What do you check?",answer:"Check for DHCP scope exhaustion first, since a subnet with a smaller-than-expected pool can silently run out of addresses under normal churn. If the pool has room, check for a rogue DHCP server on the segment responding faster than the legitimate one and handing out invalid configuration, and confirm DHCP relay/helper configuration is correct if clients are on a different subnet than the server.",commands:["show ip dhcp pool  # check remaining available addresses","show ip dhcp binding  # check current lease count vs pool size","tcpdump/wireshark filtered on DHCP (port 67/68) to catch multiple DHCP offers","show ip dhcp relay  # confirm relay/helper address is configured on the client-side VLAN"],verify:"Confirm devices consistently receive a valid lease from the intended DHCP server with no offers from an unexpected source."},
  {id:414,domain:"Network",category:"ARP",level:"Important",question:"A host can ping other devices on the same subnet by IP, but ARP requests for one specific IP never get a reply, and that host is unreachable. What do you investigate?",answer:"No ARP reply for a specific IP on the local subnet usually means either that device is down or disconnected, its ARP handling is broken, or there is a duplicate IP conflict causing inconsistent behavior. Check the target device's own network interface state directly if accessible, look for a duplicate IP address warning in its logs, and confirm there's no port security or ACL on the switch silently dropping ARP traffic to or from that port.",commands:["arp -a  # confirm no cached entry exists for that IP","tcpdump -i <iface> arp  # confirm ARP requests are actually being sent and see if any reply arrives","show mac address-table | include <target-mac>  # if known, confirm the switch sees the device at all","Check switch port security/ACL logs for drops involving that port"],verify:"Confirm ARP resolves successfully for the target IP and connectivity is restored, with no duplicate IP condition remaining."},
  {id:415,domain:"Network",category:"VPN",level:"Critical",question:"A site-to-site VPN tunnel shows as up, but traffic across it is intermittently dropped rather than fully failing. What do you check?",answer:"A tunnel reported as up only confirms the control plane, such as IKE Phase 1 and 2, negotiated successfully; it doesn't guarantee stable data-plane forwarding. Check for MTU-related fragmentation issues over the tunnel, since encapsulation overhead can push packets over path MTU and cause silent drops for larger packets while small pings succeed. Also check for a Phase 2 rekey happening too frequently and briefly interrupting traffic, and confirm interesting traffic/ACL definitions match exactly on both ends.",commands:["show crypto ipsec sa  # check for packet encaps/decaps errors and rekey frequency","ping -M do -s 1400 <remote-ip>  # test for MTU/fragmentation issues over the tunnel","show crypto isakmp sa  # confirm Phase 1 stability","Compare interesting traffic ACLs/selectors on both VPN endpoints"],verify:"Confirm sustained traffic of varying packet sizes crosses the tunnel without drops over an extended test period."},
  {id:416,domain:"Network",category:"Quality of Service",level:"Important",question:"Voice calls over the network become choppy specifically during periods of heavy file transfer traffic on the same link, even though total bandwidth utilization looks fine. What is the issue?",answer:"Average utilization looking fine can still hide short bursts that fill the queue and cause jitter and delay for latency-sensitive traffic like voice, especially without QoS to prioritize it. Confirm whether QoS classification and prioritization is actually configured on the relevant interfaces to protect voice traffic during contention, since without it, bulk transfer traffic can fill best-effort queues and starve voice packets during bursts.",commands:["show policy-map interface <int>  # check if QoS policy is applied and its queue drop counters","show interface <int>  # check for output drops during the reported time","show queueing interface <int>","Verify voice traffic is being marked/classified correctly (DSCP EF) end to end"],verify:"Confirm voice quality metrics (jitter, packet loss) stay within acceptable bounds during simulated heavy concurrent bulk traffic after QoS is applied."},
  {id:417,domain:"Network",category:"Wireless Networking",level:"Important",question:"Users in one area of an office report slow or dropped Wi-Fi, while users elsewhere are fine. How do you troubleshoot it?",answer:"Localized wireless issues usually point to a specific access point or RF environment problem rather than a wired network issue. Check that AP's client count and channel utilization for overload, look for channel overlap or interference from a nearby AP or non-Wi-Fi device on the same channel, and confirm the AP itself has a healthy uplink to the switch. Also check for a recent physical change nearby, such as new furniture or equipment, affecting RF propagation.",commands:["Check AP client count and channel utilization from the wireless controller/dashboard","Run a site survey or spectrum scan for interference in that area","show interface <ap-uplink>  # confirm uplink port health","Check for recent channel/power configuration changes on that AP"],verify:"Confirm client throughput and connection stability in that area return to normal after addressing the identified overload or interference source."},
  {id:418,domain:"Network",category:"NAT",level:"Important",question:"An application behind NAT works fine for outbound connections but a required inbound peer-to-peer connection keeps failing to establish. What is the likely cause?",answer:"Standard NAT only tracks and permits return traffic for connections it initiated outbound; unsolicited inbound connections have no matching translation to follow, so they're dropped by default. Confirm whether the application relies on a NAT traversal technique like STUN/TURN or requires explicit port forwarding, and check whether symmetric NAT is in use, which is especially difficult for peer-to-peer traversal techniques to work around.",commands:["show ip nat translations  # confirm whether an inbound-expected mapping exists","Determine NAT type: full-cone, restricted, port-restricted, or symmetric","Configure static port forwarding for the specific inbound port if required","Confirm the application's STUN/TURN server is reachable if it relies on NAT traversal"],verify:"Confirm the inbound peer-to-peer connection establishes successfully and remains stable under normal use."},
  {id:419,domain:"Network",category:"IPv6",level:"Important",question:"A dual-stack host can reach IPv4 destinations fine but fails intermittently or slowly on IPv6-capable destinations. What do you check?",answer:"This is often caused by broken or asymmetric IPv6 connectivity somewhere in the path causing the OS to fall back to IPv4 only after a timeout, which shows up as a delay rather than a hard failure. Confirm IPv6 address assignment and default route are correct, test IPv6 reachability directly rather than relying on dual-stack fallback behavior to mask it, and check for a firewall or security device that only has rules defined for IPv4.",commands:["ip -6 addr show","ip -6 route show","ping6 <ipv6-destination>  # test IPv6 path directly","Check firewall/ACL rules for IPv6-specific coverage, not just IPv4"],verify:"Confirm IPv6 connectivity succeeds directly and consistently, removing the silent fallback delay for dual-stack destinations."},
  {id:420,domain:"Network",category:"Multicast",level:"Important",question:"A multicast video stream works for clients on the same subnet as the source but not for clients on a different subnet through a router. What is likely missing?",answer:"Multicast forwarding across subnets requires an explicitly enabled multicast routing protocol like PIM on the router; regular unicast routing does not forward multicast traffic by default. Confirm PIM is enabled on the relevant interfaces, that IGMP is correctly reporting group membership from the remote subnet, and that the rendezvous point, if using PIM sparse mode, is reachable from both subnets.",commands:["show ip mroute  # check for multicast routing table entries for the group","show ip igmp groups  # confirm remote-subnet clients are joining the group","show ip pim interface  # confirm PIM is enabled on relevant interfaces","show ip pim rp mapping  # confirm rendezvous point reachability if sparse mode"],verify:"Confirm clients on the remote subnet receive the multicast stream reliably after enabling and verifying multicast routing."},
  {id:421,domain:"Network",category:"Redundancy Protocols",level:"Important",question:"A pair of routers configured with a first-hop redundancy protocol both simultaneously believe they are the active/master router. What are the consequences and what do you check?",answer:"A split-brain condition where both routers act as active/master typically causes duplicate IP or MAC conflicts on the segment and unpredictable connectivity for hosts using that gateway. This is usually caused by a broken control-link between the two routers, such as the interface or VLAN carrying hello packets being down, so each side stops hearing the other and independently becomes active. Restore that communication path first, then verify the protocol converges back to one clear active and one standby.",commands:["show standby brief  # or show vrrp brief, check state on both routers","Verify the interface/VLAN carrying HSRP/VRRP hellos is up on both routers","ping between the two router interfaces used for the redundancy protocol","show standby  # check timers and priority configuration match expectations"],verify:"Confirm exactly one router shows Active and the other Standby, with hello communication restored and stable."},
  {id:422,domain:"Network",category:"Packet Loss",level:"Critical",question:"A specific network path shows consistent, low-level packet loss around 1-2 percent that's enough to degrade application performance but not enough to be an obvious outage. How do you isolate where it's happening?",answer:"Low, consistent loss like this often points to a specific congested or failing link or interface along the path rather than an end-to-end issue. Use a hop-by-hop loss measurement tool to identify which specific segment introduces the loss, then check that hop's interface counters for errors, discards, or CRC errors indicating a physical or duplex issue, rather than just re-testing the full end-to-end path repeatedly.",commands:["mtr <destination>  # run long enough to see per-hop loss statistics","show interface <int>  # check for input/output errors, CRC, discards at the suspected hop","show interface <int> | include duplex  # check for a duplex mismatch","Repeat testing during different times to rule out time-of-day congestion"],verify:"Confirm the specific hop or interface causing loss is identified and loss drops to expected levels after remediation."},
  {id:423,domain:"Network",category:"Throughput & Bandwidth",level:"Important",question:"A file transfer between two sites over a WAN link achieves far less throughput than the link's advertised bandwidth, even though a ping shows low latency. What do you check?",answer:"Low latency alone doesn't guarantee high throughput, since TCP throughput is also limited by the bandwidth-delay product and the TCP window size in use; a small window can cap throughput well below the link's real capacity even on a fast, low-latency link. Check TCP window scaling and buffer settings on both endpoints, confirm there's no rate-limiting or shaping policy on the WAN link itself, and run a dedicated throughput test rather than relying on a single file transfer which can be limited by disk I/O instead of network.",commands:["iperf3 -c <remote-host>  # dedicated throughput test, isolating network from disk I/O","ping -c 20 <remote-host>  # confirm latency baseline","Check TCP window scaling is enabled: sysctl net.ipv4.tcp_window_scaling","Check WAN provider/router configuration for rate-limiting or shaping policies"],verify:"Confirm iperf3 throughput approaches the link's advertised bandwidth after tuning window size or removing an unexpected shaping policy."},
  {id:424,domain:"Network",category:"Network Segmentation",level:"Important",question:"After segmenting a flat network into VLANs for security, a legacy application that broadcasts to discover peers stops working across segments. How do you handle this without reverting the segmentation?",answer:"Broadcast-dependent discovery inherently doesn't cross VLAN/subnet boundaries by design, since that's part of the security benefit of segmentation. Rather than flattening the network back, identify what the application is actually discovering, such as a specific service or peer list, and replace the broadcast dependency with a supported alternative like static configuration, a directory/discovery service, or a routed multicast/relay solution if the vendor supports one.",commands:["tcpdump -i <iface> broadcast  # confirm which broadcast traffic the app relies on","Check vendor documentation for a routable discovery mechanism or static peer configuration option","Consider an IP helper/relay for the specific discovery protocol if supported","Test static configuration as a segmentation-compatible workaround"],verify:"Confirm the application successfully discovers and communicates with peers across segments using the routable alternative, with segmentation still enforced."},
  {id:425,domain:"Network",category:"Firewall Policy",level:"Critical",question:"A new firewall rule was added to allow a specific application's traffic, but the traffic is still being blocked. The rule looks correct. What do you check?",answer:"Firewalls typically apply rules in order and stop at the first match, so a broader deny rule earlier in the policy can be silently matching and blocking the traffic before it ever reaches your new, more specific allow rule. Check rule order and hit counters to see which rule is actually matching the traffic, not just whether your intended rule exists, and confirm the rule's direction, zones, and NAT interaction are correct for the actual traffic flow.",commands:["show access-list <name>  # check hit counters per rule to see which one is matching","Verify the new rule's position relative to existing broader deny rules","Confirm rule zones/interfaces match the actual traffic direction (e.g., inside-to-outside)","Test with a packet trace/policy trace tool if the platform supports it"],verify:"Confirm the hit counter increments on the intended allow rule for this traffic, and the application traffic passes successfully."},
  {id:426,domain:"Network",category:"Load Balancing",level:"Important",question:"A network-level load balancer is distributing traffic unevenly across backend servers, with one server receiving significantly more connections than others. What do you check?",answer:"Check the load balancing algorithm in use, since a source-IP-based hashing method will naturally send all traffic from a high-volume client or a NAT'd network of many users to the same backend, producing exactly this imbalance even though the algorithm is working as designed. Confirm whether that's actually the cause by checking source IP distribution, and consider a different algorithm such as least-connections if traffic sources are concentrated behind a small number of NAT gateways.",commands:["Check load balancer algorithm configuration: round-robin, least-connections, source-IP hash","Review connection logs for source IP distribution across backends","show backend server connection counts over time","Test with a different algorithm (least-connections) in a staging environment"],verify:"Confirm connection distribution across backends is roughly even relative to actual client diversity after adjusting the algorithm."},
  {id:427,domain:"Network",category:"SD-WAN",level:"Important",question:"An SD-WAN deployment intermittently routes latency-sensitive traffic over the higher-latency backup link even though the primary link appears up. What do you investigate?",answer:"SD-WAN path selection is usually based on measured link quality metrics like loss, latency, and jitter, not just link up/down state, so a primary link that's technically up but degraded can trigger a path switch even without a full outage. Check the SD-WAN controller's per-link quality measurements around the switch events, and confirm the application-aware routing policy's thresholds match the actual quality requirement for that traffic class, since an overly sensitive threshold can cause unnecessary switching.",commands:["Review SD-WAN controller dashboard for per-link loss/latency/jitter history","Check application-aware routing policy thresholds for the affected traffic class","Correlate path-switch events with the underlying link quality metrics at that time","Test primary link quality directly during a reported switch event"],verify:"Confirm latency-sensitive traffic stays on the intended primary path except during genuine quality degradation, matching the configured policy intent."},
  {id:428,domain:"Network",category:"Port Security",level:"Important",question:"A switch port with port security enabled suddenly shuts down (err-disabled) after a user plugs in an unmanaged switch or hub. Why did this happen, and how do you respond?",answer:"Port security likely detected more MAC addresses than the configured maximum on that port, since an unmanaged switch or hub allows multiple devices to appear behind a single access port, and the violation action shut the port down. Confirm the port security violation reason and MAC count, address the unauthorized device or educate the user, and only re-enable the port after confirming the cause, rather than just clearing the error state repeatedly.",commands:["show interface <int> status  # confirm err-disabled state and reason","show port-security interface <int>  # check violation count and learned MACs","show port-security address  # see the offending MAC addresses","shutdown / no shutdown <int>  # only after resolving the root cause, not as a first response"],verify:"Confirm the port stays stable after the unauthorized device is removed and no further violations are logged for that port."},
  {id:429,domain:"Network",category:"Time-Sensitive Applications",level:"Important",question:"A trading or real-time application requires microsecond-level time accuracy across servers, but standard NTP synchronization isn't tight enough. What alternative should you consider and why?",answer:"Standard NTP typically achieves millisecond-level accuracy over a normal network, which is not sufficient for applications requiring microsecond precision. Precision Time Protocol (PTP) is designed for sub-microsecond synchronization by using hardware timestamping at the network interface level rather than software timestamping, but it requires PTP-aware or PTP-transparent switches along the path to maintain that accuracy; a single non-PTP-aware hop can reintroduce enough jitter to defeat the purpose.",commands:["Assess current NTP accuracy: chronyc tracking / w32tm /query /status","Confirm switches in the path support PTP transparent clock or boundary clock functionality","Deploy PTP with hardware timestamping NICs where accuracy requirements demand it","Measure achieved offset/accuracy after PTP deployment against the requirement"],verify:"Confirm measured time offset between servers meets the application's required precision consistently under production load."},
  {id:430,domain:"Network",category:"Change Management",level:"Important",question:"A network outage was caused by a change that wasn't documented anywhere, and it took hours to identify what changed. How do you prevent this going forward?",answer:"Require every network change, even a 'quick fix', to go through a lightweight but mandatory change record tied to a ticket with the specific commands or configuration diff applied. Use configuration backup and diff tooling to automatically capture and compare device configurations over time, so even an undocumented change is detectable and attributable after the fact, not just prevented by process alone.",commands:["Implement automated configuration backup/versioning (e.g., RANCID, Oxidized, or vendor equivalent)","Diff current config against the last known-good backup after any incident","Require change tickets referencing the specific device and config diff for all changes","Review change history during incident RCA as a standard first step"],verify:"Confirm the next incident's RCA can identify any recent configuration change within minutes using the automated diff, not hours of manual investigation."},

  {id:501,domain:"Security",category:"Incident Response",level:"Critical",question:"You suspect a Linux server has been compromised. What are your first actions?",answer:"Follow the incident-response process: preserve evidence, limit further damage, avoid unnecessary reboots or cleanup, record current connections and processes, isolate the system using an approved method, and engage the security team. Collect volatile evidence before actions that destroy it.",commands:["date -Is","ss -plant","ps auxf","who","last -a | head","journalctl --since '-1 hour'"],verify:"Ensure evidence is preserved, containment is documented, and recovery uses a trusted source rather than simply cleaning the suspected host."},
  {id:502,domain:"Security",category:"SSH",level:"Critical",question:"SSH logs show thousands of failed login attempts from the internet. What should you do?",answer:"Confirm whether SSH needs internet exposure at all. Restrict source networks through perimeter controls, use key-based authentication, disable direct root login and password authentication where appropriate, apply rate limiting or an approved ban mechanism, and review logs for any successful authentication from suspicious sources.",commands:["journalctl -u sshd --since today","lastb | head","sshd -T | grep -E 'passwordauthentication|permitrootlogin|pubkeyauthentication'"],verify:"Confirm unauthorized sources can no longer reach or authenticate and no suspicious successful sessions remain unexplained."},
  {id:503,domain:"Security",category:"Patching",level:"Critical",question:"A critical vulnerability is announced for a package running in production. How do you respond?",answer:"Confirm actual exposure and affected versions, assess exploitability and business impact, obtain the vendor-supported fix or mitigation, test it, schedule an expedited change if warranted, deploy with rollback planning, and verify both package level and service health. Do not rely only on a scanner status.",commands:["rpm -q <package>","dnf updateinfo info --cves <CVE>","dnf check-update <package>"],verify:"Confirm the vulnerable version or configuration is no longer present and the service passes functional checks."},
  {id:504,domain:"Security",category:"Permissions",level:"Critical",question:"You find an application directory set to 777. How do you remediate it?",answer:"Determine which user and group actually need read, write, and execute access. Replace world-writable permissions with ownership, group permissions, ACLs, or service-specific paths. Check whether the broad permission was masking an SELinux or service-account problem before tightening it.",commands:["namei -l <path>","getfacl <path>","ls -ldZ <path>","find <path> -xdev -perm -0002 -ls"],verify:"Confirm the application works with least privilege and unauthorized users can no longer modify the path."},
  {id:505,domain:"Security",category:"Certificates",level:"Important",question:"A TLS certificate expires tomorrow. What is the correct production response?",answer:"Renew or replace the certificate using the approved CA process, verify hostname coverage and chain, deploy it to every terminating endpoint such as load balancers and proxies, reload services safely, and test from an external client. Also fix renewal automation or alerting if this was unexpected.",commands:["openssl s_client -connect <host>:443 -servername <host>","openssl x509 -noout -dates -subject -issuer"],verify:"Confirm all public and internal endpoints present the new certificate with the expected expiry date and trust chain."},
  {id:506,domain:"Security",category:"Accounts",level:"Critical",question:"An employee leaves the company. What should happen to their privileged access?",answer:"Disable or revoke the identity promptly through the authoritative identity system, remove privileged group memberships, revoke active sessions and tokens where supported, rotate shared credentials they knew, preserve required audit data, and verify access to critical systems is removed.",commands:["id <user>","last -a | head","passwd -S <user>"],verify:"Test or audit each relevant access path and confirm the offboarded identity cannot authenticate."},
  {id:507,domain:"Security",category:"Hardening",level:"Important",question:"A security benchmark recommends disabling a service that your application requires. What should you do?",answer:"Do not apply benchmark controls blindly. Document the business and technical requirement, assess the specific risk, apply compensating controls where appropriate, obtain an approved exception, and keep the service configured with least privilege and restricted exposure.",commands:["systemctl status <service>","ss -lntup","systemctl cat <service>"],verify:"Confirm the exception is documented, exposure is minimized, and the application remains functional."},
  {id:508,domain:"Security",category:"Audit",level:"Important",question:"How do you investigate who changed a protected configuration file?",answer:"Use audit logs if file watches or relevant syscall auditing were configured, then correlate timestamps with sudo, SSH, configuration-management, and deployment logs. Filesystem timestamps alone usually cannot prove who made the change.",commands:["ausearch -f <path>","aureport -f","journalctl _COMM=sudo --since today","stat <path>"],verify:"Build a timestamped evidence trail and add or correct auditing if attribution was not possible."},
  {id:509,domain:"Security",category:"Detection & Response",level:"Critical",question:"Your SIEM shows a spike of failed logins across many different accounts within a short window. How do you respond?",answer:"Treat it as a likely password-spraying attack rather than one locked-out user. Identify the source IPs, the spread of targeted accounts, and whether any attempt actually succeeded; a pattern of one password tried against many usernames is the classic signature. Block or rate-limit the source at the perimeter, force password resets and revoke sessions for any account with a successful login from a suspicious source, and check for MFA enforcement gaps.",commands:["journalctl -u sshd --since '-1 hour' | grep Failed","lastb | head -50","grep -c 'Failed password' /var/log/secure* 2>/dev/null","Review SIEM correlation for source IP and account spread","Check identity provider sign-in logs for successful anomalies"],verify:"Confirm the source is blocked, no unauthorized successful sessions remain active, and affected accounts have rotated credentials."},
  {id:510,domain:"Security",category:"Phishing",level:"Critical",question:"A user reports clicking a link in a phishing email and entering their credentials on a fake login page. What are your immediate steps?",answer:"Treat the credential as compromised immediately: force a password reset and revoke active sessions and tokens for that account before doing anything else, since the attacker may already be using it. Check sign-in logs for that account for any suspicious activity between the click and the reset, identify whether MFA prevented actual account takeover, and block the phishing URL/domain at the email gateway and web proxy to protect other users who may have received the same email.",commands:["Force password reset and revoke sessions/tokens for the affected account","Review sign-in/audit logs for the account since the phishing email arrived","Block the phishing URL/sender domain at email gateway and web proxy","Search mailboxes for other recipients of the same phishing email and notify them"],verify:"Confirm no unauthorized activity occurred on the account, the credential is fully rotated, and other recipients of the same email are identified and warned."},
  {id:511,domain:"Security",category:"Malware",level:"Critical",question:"Endpoint detection flags a workstation for suspicious activity consistent with malware. What is your containment and investigation approach?",answer:"Isolate the host from the network first to stop potential lateral movement or data exfiltration, while preserving it for investigation rather than immediately wiping or rebooting it, since that destroys volatile evidence. Identify the malware's entry point and behavior from EDR telemetry, check for lateral movement or additional compromised hosts using the same indicators, and only rebuild the host from a known-good image after the investigation confirms scope.",commands:["Isolate the host via EDR network containment (not just disconnecting the cable)","Preserve memory/process state before any reboot if forensics may be needed","Review EDR timeline for initial entry vector and process tree","Search environment-wide for the same file hash/IOC on other hosts"],verify:"Confirm the host is fully contained with no further malicious network activity, the entry vector is identified, and no other hosts show the same indicators."},
  {id:512,domain:"Security",category:"Brute Force",level:"Important",question:"You notice thousands of failed login attempts against a single user account from many different IP addresses within an hour. What is happening and how do you respond?",answer:"Many different source IPs targeting one account with many attempts is a credential brute-force or credential-stuffing attack, likely distributed to evade simple per-IP rate limiting. Check whether any attempt succeeded, since that changes this from an attempted attack to an active compromise, temporarily lock or add extra verification to the targeted account, and confirm rate-limiting and account lockout policies are actually functioning as intended if this volume got through unblocked.",commands:["Search authentication logs for the account: success/failure count and source IP diversity","Check whether any of the attempts resulted in a successful login","Enforce temporary lockout or step-up authentication for the targeted account","Review and tighten rate-limiting/lockout thresholds if this volume wasn't throttled"],verify:"Confirm no successful unauthorized login occurred, the account is secured, and rate-limiting now throttles a similar attempt pattern in testing."},
  {id:513,domain:"Security",category:"Ransomware",level:"Critical",question:"Multiple file servers show signs of mass file encryption with a ransom note appearing in shared folders. What is your immediate response?",answer:"Isolate affected systems from the network immediately to stop the encryption from spreading, without powering them off if forensic evidence needs preserving, and identify patient zero and the initial access vector as quickly as possible. Do not restore from backup onto the same compromised network until the entry point is closed, since restoring into a still-compromised environment risks re-encryption. Engage incident response and legal/compliance processes per the organization's ransomware playbook rather than making ad hoc decisions about payment or restoration.",commands:["Isolate affected systems from the network (network-level, not just powering off)","Identify the ransomware variant and check for known decryption tools if available","Identify initial access vector from EDR/logs before restoring anything","Restore from clean, verified backups only after the entry point is closed and confirmed remediated"],verify:"Confirm the entry vector is closed, systems are restored from a verified clean backup, and no re-encryption occurs after systems return online."},
  {id:514,domain:"Security",category:"SIEM & Detection Engineering",level:"Important",question:"Your SIEM generates hundreds of alerts per day, and analysts are missing real incidents in the noise. How do you improve this?",answer:"Tune detection rules based on actual false-positive rate and true-positive value, not just alert volume; a rule that fires constantly with no real findings should be refined or retired, while a rule with rare but high-value hits should stay even if it's noisy in aggregate. Prioritize alerts by risk score combining asset criticality and detection confidence, and invest in enrichment so analysts see context immediately instead of pivoting through several other tools per alert.",commands:["Review alert-to-true-positive ratio per detection rule over a defined period","Tune or retire consistently low-value, high-volume rules","Implement alert enrichment (asset criticality, user risk score) at ingestion","Set up risk-based alert prioritization/triage queues"],verify:"Confirm analyst time-to-triage improves and a controlled red-team or known-bad test event is still reliably detected and prioritized correctly."},
  {id:515,domain:"Security",category:"Threat Hunting",level:"Important",question:"Leadership asks your team to proactively hunt for threats instead of only responding to alerts. How do you structure a hunt with limited time?",answer:"Start from a specific, testable hypothesis based on known attacker techniques relevant to your environment, such as a particular lateral movement or persistence technique, rather than open-ended log browsing. Use a framework like MITRE ATT&CK to scope the hunt to specific techniques, query for the behavioral evidence that technique would leave rather than just known bad indicators, and document findings and coverage gaps whether or not you find an active threat.",commands:["Select a hypothesis and mapped MITRE ATT&CK technique to hunt for","Query logs/EDR for behavioral evidence of that technique, not just known-bad hashes","Document coverage: what was searched, what data sources, what time range","File detection engineering follow-ups for any gap found, regardless of outcome"],verify:"Confirm the hunt produces a documented outcome, either a finding requiring response or a validated coverage gap converted into a new detection rule."},
  {id:516,domain:"Security",category:"Vulnerability Management",level:"Important",question:"A vulnerability scanner reports thousands of findings across the environment. How do you prioritize remediation with limited engineering time?",answer:"Prioritize by actual exploitability and business impact, not just CVSS score alone, since a critical CVSS vulnerability on an isolated, non-internet-facing system with compensating controls is lower real risk than a moderate one on an internet-facing system with no mitigations. Factor in whether a public exploit exists, whether the asset is internet-facing or handles sensitive data, and whether compensating controls already reduce exploitability, then track remediation SLAs by that combined risk tier rather than a flat CVSS threshold.",commands:["Cross-reference findings with known exploited vulnerability lists (e.g., CISA KEV)","Filter by asset exposure: internet-facing vs internal-only","Check for existing compensating controls (WAF, segmentation) reducing real exploitability","Set remediation SLA tiers based on combined risk score, not CVSS alone"],verify:"Confirm the highest real-risk vulnerabilities are remediated first and the remediation SLA is consistently met for that top tier."},
  {id:517,domain:"Security",category:"Data Loss Prevention",level:"Important",question:"A DLP alert fires showing a large volume of sensitive customer data was uploaded to a personal cloud storage account by an employee. How do you investigate and respond?",answer:"Treat this seriously but verify before escalating to a full insider-threat response, since it could be an authorized business use case, a mistake, or genuine exfiltration. Check the employee's role and whether this data access and destination are consistent with their normal job function, review what specifically was uploaded, and involve HR/legal per policy if the activity appears unauthorized, rather than security acting unilaterally on personnel matters.",commands:["Review DLP alert details: exact data classification, volume, and destination","Check the employee's role/permissions against normal expected data access","Review recent access logs for that employee for a broader pattern","Escalate to HR/legal per policy if the activity appears intentional and unauthorized"],verify:"Confirm the nature of the activity (authorized, mistake, or malicious) is determined with evidence, and appropriate action is taken per policy."},
  {id:518,domain:"Security",category:"Insider Threat",level:"Important",question:"An employee who submitted their resignation still has two weeks left and full access to sensitive systems. What is the appropriate security posture during this period?",answer:"Apply a proportionate, policy-based response, not an assumption of guilt: typically increased monitoring of that account's activity and access to sensitive data during the notice period, without necessarily revoking access needed to do their job unless there's specific cause for concern. Coordinate with HR and the employee's manager on the offboarding timeline, and ensure access is fully and promptly revoked at the actual departure, which is a common gap that leaves accounts active longer than intended.",commands:["Enable heightened monitoring/alerting on the account for the notice period","Coordinate offboarding timeline and access-revocation date with HR/manager","Review data access and export activity for the account during the notice period","Confirm access is revoked promptly and completely on the actual last day"],verify:"Confirm no anomalous data access occurred during the notice period and all access is fully revoked immediately upon departure, verified against a checklist."},
  {id:519,domain:"Security",category:"Zero Trust",level:"Important",question:"Leadership wants to move toward a zero trust architecture. What does that actually mean in practice, beyond the buzzword, for a typical enterprise network?",answer:"It means moving away from implicit trust based on network location, such as 'inside the corporate network equals trusted,' toward continuous verification of identity and device posture for every access request regardless of where it originates. In practice this means strong identity with MFA everywhere, device health checks before granting access, micro-segmentation so lateral movement is limited even after a breach, and least-privilege access enforced per request rather than broad standing network access.",commands:["Inventory current implicit-trust assumptions (e.g., VPN-in equals full network access)","Implement identity-aware proxy/access broker requiring per-request verification","Deploy device posture checks as an access condition","Segment the network to limit lateral movement even for authenticated users"],verify:"Confirm a test user with valid credentials but an unhealthy/non-compliant device is denied access, proving the architecture verifies more than just identity."},
  {id:520,domain:"Security",category:"Multi-Factor Authentication",level:"Important",question:"A user reports receiving repeated MFA push notifications they didn't request, sometimes several in a row. What does this indicate and how do you respond?",answer:"This is a classic MFA fatigue/push-bombing attack pattern, where an attacker who already has the user's password is repeatedly triggering push prompts hoping the user will approve one out of frustration or confusion. Treat the account as having a compromised password even if no push was approved, force a credential reset, and review sign-in logs for the source of the push requests. Move toward number-matching or phishing-resistant MFA methods to prevent this attack pattern going forward.",commands:["Review authentication logs for the source IP/location of the repeated push requests","Force password reset for the account regardless of whether a push was approved","Check if any push was accidentally approved and review resulting session activity","Enable number-matching MFA or move toward phishing-resistant methods (FIDO2/WebAuthn)"],verify:"Confirm the account's password is rotated, no unauthorized session resulted, and the MFA method is hardened against push-bombing going forward."},
  {id:521,domain:"Security",category:"Endpoint Detection & Response",level:"Important",question:"An EDR agent shows as offline on several servers, and no one noticed until a routine audit. What is the risk and how do you address it?",answer:"An offline EDR agent means those hosts have been unmonitored for however long the gap has existed, which is itself a security exposure regardless of whether anything malicious happened. Investigate why the agents went offline, whether from a crash, a misconfiguration, or deliberate tampering, since the cause changes the response significantly. Treat any host with an unexplained EDR gap as needing closer scrutiny for that period, and add monitoring specifically for EDR agent health so this is caught immediately next time, not during an audit.",commands:["Review EDR console for exact time each agent went offline and the reported reason","Check host logs directly for agent crash or service-stop events around that time","Investigate for signs of tampering (agent process/service manipulation) if the cause is unclear","Configure alerting specifically for EDR agent health/heartbeat loss"],verify:"Confirm all agents report healthy status, the offline cause is understood, and a heartbeat-loss alert now fires immediately for any future gap."},
  {id:522,domain:"Security",category:"Cloud Security Posture",level:"Important",question:"A cloud security posture management tool flags dozens of misconfigurations across your cloud accounts. How do you decide what to fix first?",answer:"Prioritize by actual exposure and blast radius, not just the raw count of findings. A misconfiguration on a public-facing resource with sensitive data access is far more urgent than the same class of finding on an isolated internal resource. Group findings by root cause, since many individual findings often trace back to one systemic gap like a missing baseline policy, and fixing that policy prevents the whole category from recurring rather than closing findings one at a time.",commands:["Filter CSPM findings by public exposure and data sensitivity of the affected resource","Group findings by root cause/misconfiguration type to find systemic gaps","Fix the underlying policy/guardrail (e.g., Organization Policy, SCP) to prevent recurrence","Re-scan to confirm the systemic fix resolved the full category of findings"],verify:"Confirm the highest-exposure findings are remediated first, and a systemic guardrail prevents that finding category from reappearing."},
  {id:523,domain:"Security",category:"Supply Chain Security",level:"Critical",question:"A widely used open-source dependency your application relies on is announced to have a malicious package version published upstream. What do you do?",answer:"Confirm exactly which version was compromised and whether your build ever pulled that specific version, since not every consumer of the package is affected. Pin dependencies to known-good, verified versions immediately, audit build and deployment history for the affected time window to see if the malicious version was ever installed anywhere, and if it was, treat those systems as potentially compromised and investigate accordingly rather than assuming a simple version bump is sufficient.",commands:["Check dependency lock files/build logs for whether the malicious version was ever resolved","Pin the dependency to a verified known-good version immediately","Audit CI/CD build history for the affected time window","If the malicious version was installed anywhere, treat that system as potentially compromised and investigate"],verify:"Confirm no build or running system ever used the malicious version, or that any that did have been fully investigated and remediated."},
  {id:524,domain:"Security",category:"Living-off-the-Land",level:"Important",question:"EDR flags suspicious PowerShell activity on a server, including encoded commands and unusual parent-child process relationships. How do you investigate this class of activity?",answer:"This pattern is characteristic of living-off-the-land techniques, where attackers use legitimate built-in tools like PowerShell to blend in with normal administrative activity rather than dropping obvious malware. Decode the encoded command to see its actual content, examine the full process tree to understand what spawned PowerShell and what it spawned in turn, since an unusual parent process like a document viewer launching PowerShell is a strong compromise indicator, and correlate with any recent phishing or initial-access alerts on that host.",commands:["Decode base64/encoded PowerShell command content from the EDR alert","Review full process tree (parent and child processes) around the event","Check PowerShell script block logging / transcript logs for full command history","Correlate with other alerts on the same host in the surrounding time window"],verify:"Confirm the intent of the PowerShell activity is understood, and if malicious, the host is contained and the technique is added to detection coverage."},
  {id:525,domain:"Security",category:"DDoS",level:"Critical",question:"Your public-facing website becomes unreachable due to a sudden massive surge in traffic consistent with a DDoS attack. What is your immediate response?",answer:"Confirm it's actually an attack and not a legitimate traffic spike or a self-inflicted issue like a misconfigured retry loop, then engage upstream DDoS mitigation, such as your CDN or provider's scrubbing service, to absorb and filter the traffic before it reaches your origin. Identify the attack type, such as volumetric, protocol, or application-layer, since the effective mitigation differs for each, and communicate status to stakeholders while mitigation is in progress.",commands:["Review traffic volume and pattern to confirm attack characteristics vs legitimate spike","Engage CDN/DDoS scrubbing service if not already active","Identify attack layer: volumetric (L3/4) vs application-layer (L7) to guide the right mitigation","Review origin server logs to distinguish attack traffic from real users for post-incident analysis"],verify:"Confirm the site becomes reachable again for legitimate users while attack traffic is filtered upstream, and mitigation stays effective as the attack evolves."},
  {id:526,domain:"Security",category:"Log Analysis",level:"Important",question:"You need to determine whether an attacker who gained initial access to one server was able to move laterally to other systems. What log sources and approach do you use?",answer:"Build a timeline starting from the confirmed initial compromise, then look specifically for authentication events, new connections, and process execution originating from that host toward other systems in the surrounding time window. Correlate host-based logs, such as EDR and authentication logs, with network logs like flow data or firewall logs to confirm whether an attempted lateral movement actually succeeded versus was only attempted, since those require different response scope.",commands:["Establish confirmed compromise time as the timeline anchor","Search authentication logs for the compromised host's identity/credentials on other systems after that time","Review network flow/firewall logs for new outbound connections from the compromised host","Correlate EDR process execution logs on any suspected secondary host"],verify:"Confirm a definitive scope: either lateral movement is ruled out with evidence, or every additionally compromised system is identified and contained."},
  {id:527,domain:"Security",category:"Compliance & Regulatory",level:"Important",question:"A regulator requires proof that access to systems handling regulated data is reviewed periodically. How do you build this into normal operations rather than a scramble before an audit?",answer:"Automate periodic access reviews rather than relying on a manual pre-audit scramble, by generating a report of who has access to in-scope systems on a fixed schedule and routing it to the actual resource owner for attestation, not just to security. Track review completion and revoke or flag any access not attested to within the required window, and keep the attestation records themselves as the audit evidence, generated continuously rather than reconstructed after the fact.",commands:["Generate a scheduled access report for in-scope systems (e.g., quarterly)","Route the report to the resource owner for explicit attestation, not a passive FYI","Track attestation completion and escalate/revoke access for non-response","Retain attestation records as continuous audit evidence"],verify:"Confirm the most recent access review cycle completed on schedule with documented attestations, ready to produce immediately for an auditor."},
  {id:528,domain:"Security",category:"Social Engineering",level:"Important",question:"Someone calls the IT helpdesk claiming to be a senior executive, urgently requesting a password reset without going through normal identity verification. What should the helpdesk process require?",answer:"This is a classic social engineering / vishing pretext exploiting urgency and authority to bypass normal controls, and helpdesk staff need a policy that cannot be overridden by pressure or seniority claims over the phone. Require identity verification through a pre-established, independent channel, such as calling back a known number on file or verifying through a manager, regardless of who the caller claims to be or how urgent they say it is, and escalate any request that pushes back on this process as a potential incident itself.",commands:["Follow mandatory identity verification via a known, independent channel before any reset","Do not accept caller-provided contact information as verification","Log and escalate any attempt to bypass or pressure around the verification process","Review the incident with the security team even if no reset was ultimately performed"],verify:"Confirm the helpdesk process consistently requires independent verification regardless of urgency or claimed seniority, tested periodically with simulated social engineering attempts."},
  {id:529,domain:"Security",category:"API Security",level:"Important",question:"A security review finds that an internal API exposes far more data in its response than the frontend application actually displays. Why is this a risk, and how do you fix it?",answer:"Over-fetching data in an API response is a real risk even if the frontend doesn't render all of it, since anyone who can call the API directly, whether a legitimate but curious user or an attacker, can see the full response regardless of what the UI shows. Redesign the endpoint to return only the fields actually needed for that use case, enforce authorization checks at the API layer itself rather than relying on the frontend to hide sensitive fields, and audit other endpoints for the same pattern.",commands:["Capture actual API responses directly (not through the UI) to see full data exposure","Redesign endpoint responses to include only fields required for the use case","Add/verify field-level or object-level authorization checks at the API layer","Audit other endpoints in the same service for the same over-fetching pattern"],verify:"Confirm the API response now excludes unnecessary fields and enforces authorization directly, verified by calling the API outside the intended frontend."},
  {id:530,domain:"Security",category:"Security Awareness",level:"Important",question:"Despite regular security training, employees keep failing simulated phishing tests at a high rate. How do you improve the program's actual effectiveness rather than just repeating the same training?",answer:"Generic annual training alone has limited effect on behavior. Move toward targeted, frequent, and contextual training, such as immediate, specific feedback delivered right when someone clicks a simulated phish, focused on the actual technique used rather than generic advice. Track click and report rates by team over time to identify where reinforcement is needed most, and treat consistently high-risk individuals or teams with additional support rather than punitive measures, since punitive approaches tend to reduce honest reporting of real incidents.",commands:["Review phishing simulation click/report rates trended by team over time","Deliver immediate, specific just-in-time feedback at the point of a simulated click","Identify and provide targeted reinforcement for consistently high-risk groups","Track real-incident reporting rate as a success metric, not just simulation pass rate"],verify:"Confirm click rates trend downward and real-incident reporting rate trends upward over successive quarters, not just simulation pass/fail counts."},

  {id:601,domain:"Windows",category:"Services",level:"Critical",question:"A Windows service will not start. What is your troubleshooting sequence?",answer:"Check the Service Control Manager error and Event Viewer, inspect the service account, dependencies, executable path, permissions, recent changes, and port conflicts. Run the underlying application diagnostic only when safe. Avoid repeatedly restarting without capturing the failure reason.",commands:["Get-Service <name>","sc.exe qc <name>","Get-WinEvent -LogName System -MaxEvents 100 | Where-Object ProviderName -eq 'Service Control Manager'","Get-NetTCPConnection -State Listen"],verify:"Confirm the service remains Running and its actual application function succeeds."},
  {id:602,domain:"Windows",category:"Performance",level:"Critical",question:"A Windows Server is at 100% CPU. How do you identify the cause?",answer:"Confirm whether CPU is sustained, identify the top process and if necessary the hot thread, correlate with scheduled tasks, antivirus, updates, and application logs, and check whether virtualization CPU ready or host contention is involved. Capture evidence before terminating a production process.",commands:["Get-Process | Sort-Object CPU -Descending | Select-Object -First 10","Get-Counter '\\Processor(_Total)\\% Processor Time'","Get-ScheduledTask | Where-Object State -eq 'Running'"],verify:"After remediation, confirm CPU and application response return to normal under representative load."},
  {id:603,domain:"Windows",category:"Disk",level:"Critical",question:"The C: drive is almost full. What do you check before deleting files?",answer:"Identify the largest directories and growth source, including Windows Update cache, logs, temp files, dumps, application data, and user profiles. Check whether another component expects those files and use supported cleanup tools. Do not manually delete system component-store files.",commands:["Get-PSDrive C","Get-ChildItem C:\\ -Force -ErrorAction SilentlyContinue","cleanmgr.exe"],verify:"Confirm adequate free space remains and the source of growth is controlled."},
  {id:604,domain:"Windows",category:"Active Directory",level:"Critical",question:"A domain user can log in to one PC but not another. How do you troubleshoot it?",answer:"Check network and DNS connectivity to domain controllers, time synchronization, account status, computer trust, cached credentials, local policy, and the exact authentication event on the failing PC. Active Directory authentication depends heavily on correct DNS and time.",commands:["whoami /all","nltest /dsgetdc:<domain>","w32tm /query /status","Test-ComputerSecureChannel -Verbose","Get-WinEvent -LogName Security -MaxEvents 100"],verify:"Confirm domain authentication succeeds and the machine has a healthy secure channel to the domain."},
  {id:605,domain:"Windows",category:"DNS",level:"Critical",question:"A domain-joined Windows server is using a public DNS server. Why is that a problem?",answer:"Active Directory clients must resolve AD service records from the AD-integrated DNS namespace. Public DNS can prevent locating domain controllers, Kerberos, LDAP, and Group Policy services. Point the client to approved internal DNS servers and configure forwarders at the DNS-server layer as designed.",commands:["Get-DnsClientServerAddress","nslookup -type=SRV _ldap._tcp.dc._msdcs.<domain>","ipconfig /flushdns"],verify:"Confirm AD SRV records resolve and nltest can locate a domain controller."},
  {id:606,domain:"Windows",category:"Group Policy",level:"Important",question:"A new Group Policy setting is not applying to one server. What do you check?",answer:"Confirm the GPO is linked to the correct OU, enabled, and in scope for the computer or user. Review security and WMI filtering, inheritance and block-enforcement behavior, replication, and the Resultant Set of Policy. Then inspect Group Policy operational logs for processing errors.",commands:["gpresult /h C:\\Temp\\gp.html","gpupdate /force","Get-GPResultantSetOfPolicy -ReportType Html -Path C:\\Temp\\rsop.html"],verify:"Confirm the intended GPO appears in the applied list and the target registry or policy setting has changed."},
  {id:607,domain:"Windows",category:"Networking",level:"Critical",question:"A Windows server has an IP address but cannot reach its default gateway. What do you inspect?",answer:"Verify IP address, subnet mask, gateway, VLAN, NIC status, routes, ARP, and duplicate IP possibility. Check teaming or virtual-switch configuration when applicable. A valid-looking IP does not prove the Layer 2 path is correct.",commands:["Get-NetIPConfiguration","Get-NetRoute -AddressFamily IPv4","Get-NetNeighbor","Test-NetConnection <gateway>"],verify:"Confirm the server resolves the gateway MAC and can reach the next hop from the intended interface."},
  {id:608,domain:"Windows",category:"RDP",level:"Critical",question:"RDP is enabled but remote users cannot connect. What do you check?",answer:"Verify the Remote Desktop service, listener on TCP 3389 or the configured port, Windows Firewall rule, network path, NLA requirements, user rights, licensing where applicable, and authentication event logs. Test the port before changing RDP policy.",commands:["Get-Service TermService","Get-NetTCPConnection -LocalPort 3389 -State Listen","Test-NetConnection <server> -Port 3389","Get-NetFirewallRule -DisplayGroup 'Remote Desktop'"],verify:"Confirm an authorized user can establish an RDP session from the intended network while unauthorized access remains blocked."},
  {id:609,domain:"Windows",category:"Backup & Recovery",level:"Critical",question:"A scheduled Windows Server backup job reports success every night, but a restore test just failed. How do you investigate?",answer:"A 'successful' backup job status does not guarantee a valid, restorable backup. Check the backup application's own consistency-check logs, confirm VSS writer health since a failing writer can silently produce an incomplete application-consistent backup while the job still reports success, and verify the backup target actually contains complete, uncorrupted files. Fix the underlying VSS or agent issue, then re-run and validate the restore in an isolated environment.",commands:["vssadmin list writers","wbadmin get versions","wbadmin get status","Get-WinEvent -LogName 'Application' | Where-Object {$_.ProviderName -like '*VSS*'}","Test restore into an isolated environment"],verify:"Confirm a full restore succeeds in an isolated environment and all VSS writers report a stable state."},
  {id:610,domain:"Windows",category:"Active Directory Recovery",level:"Critical",question:"A domain controller has failed catastrophically, or Active Directory itself appears corrupted after a bad change. What is your recovery approach?",answer:"If it's a single domain controller failure in a multi-DC environment, the fastest safe path is often to cleanly remove (metadata cleanup) the failed DC and stand up a replacement, replicating fresh from a healthy DC, rather than attempting an in-place repair. If Active Directory itself is corrupted, such as from a bad object deletion, boot into Directory Services Restore Mode and restore from a validated system state backup, choosing an authoritative restore only for the specific objects that need to be reinstated, since a full authoritative restore can overwrite legitimate changes made elsewhere.",commands:["repadmin /showrepl  # confirm replication health of remaining DCs before acting","ntdsutil  # for metadata cleanup of a failed DC","Boot to DSRM and use wbadmin / Windows Server Backup to restore system state","ntdsutil authoritative restore  # only for specific objects that require it"],verify:"Confirm replication converges cleanly across all remaining domain controllers and the restored objects/DC function correctly with no orphaned metadata."},
  {id:611,domain:"Windows",category:"FSMO Roles",level:"Important",question:"The domain controller holding the PDC Emulator FSMO role goes offline unexpectedly. What breaks, and how do you respond?",answer:"The PDC Emulator handles time synchronization for the domain, password change urgency, and some Group Policy processing, so its outage can cause time drift and authentication issues across the domain, though not a full outage by itself. If the DC won't return soon, seize, not just transfer, the role onto a healthy DC, but only seize a role when the original holder is confirmed unrecoverable, since seizing while the original is still reachable can cause conflicts.",commands:["netdom query fsmo  # confirm current role holders","Confirm the failed DC is truly unrecoverable before seizing","ntdsutil roles  # seize the PDC Emulator role onto a healthy DC","w32tm /query /status  # confirm time sync recovers on the new PDC Emulator"],verify:"Confirm the new PDC Emulator is functioning, domain time synchronization stabilizes, and authentication issues resolve across the domain."},
  {id:612,domain:"Windows",category:"AD Replication",level:"Critical",question:"Changes made on one domain controller, such as a new user account, are not appearing on other domain controllers. How do you troubleshoot AD replication?",answer:"Confirm this is actually a replication problem and not just replication latency by checking the last successful replication time between the DCs. Check network connectivity and required ports between DCs, DNS resolution of DC names since AD replication depends heavily on correct DNS, and review specific replication error codes, which usually point directly to the cause such as a lingering object, a broken trust, or a connectivity issue.",commands:["repadmin /showrepl  # check replication status and last success time per partner","repadmin /replsummary  # get an overview of replication health across all DCs","dcdiag /test:dns  # confirm DNS health, since replication depends on it","repadmin /syncall /AdeP  # force a full sync after fixing the root cause"],verify:"Confirm repadmin shows successful replication with no errors and the change is visible on all domain controllers."},
  {id:613,domain:"Windows",category:"PowerShell Automation",level:"Important",question:"You need to disable 500 stale user accounts identified by an audit, safely and with an audit trail. How do you approach this with PowerShell instead of doing it manually?",answer:"Script it, but validate before executing anything destructive: import the list, run in a dry-run mode that only reports what would change, review that output for anything unexpected such as accounts that shouldn't be touched, and only then run the actual disable operation with logging to a transcript for the audit trail. Avoid a single unreviewed script run against a sensitive bulk operation.",commands:["Import-Csv stale-accounts.csv | ForEach-Object { Get-ADUser $_.SamAccountName }  # dry-run validation first","Start-Transcript -Path audit-log.txt","Import-Csv stale-accounts.csv | ForEach-Object { Disable-ADAccount -Identity $_.SamAccountName }","Stop-Transcript"],verify:"Confirm the exact intended 500 accounts are disabled, no unintended accounts were affected, and the transcript provides a complete audit trail."},
  {id:614,domain:"Windows",category:"Patch Management",level:"Important",question:"A monthly Windows patch cycle keeps causing unexpected application breakage in production, eroding trust in the patching process. How do you fix the process itself?",answer:"The core gap is usually insufficient pre-production validation against real application behavior, not just successful installation. Establish a representative test ring that mirrors production applications and receives patches first, with enough soak time and actual application testing before broader rollout, and use a staged deployment ring structure so a bad patch only affects a small pilot group before wider release. Maintain a fast rollback/uninstall procedure as a safety net even with good testing.",commands:["Configure WSUS/SCCM deployment rings: pilot, broad, critical infrastructure last","Define minimum soak time and required application validation before promoting a patch ring","Get-HotFix / Get-WindowsUpdateLog  # for troubleshooting a specific bad patch","wusa /uninstall /kb:<KB>  # documented fast-rollback procedure"],verify:"Confirm the next patch cycle catches application-breaking issues in the pilot ring before reaching production-critical systems."},
  {id:615,domain:"Windows",category:"Print Services",level:"Important",question:"The Print Spooler service crashes repeatedly across multiple servers, disrupting printing company-wide. How do you troubleshoot and stabilize it?",answer:"Repeated spooler crashes are often caused by a corrupted print job stuck in the queue or a problematic printer driver, so check the spooler's crash logs for the specific faulting module first rather than just restarting the service repeatedly. Clear the print queue and problematic spool files if a stuck job is the cause, and isolate the specific driver if a particular printer model correlates with the crashes, since driver issues are a very common root cause.",commands:["Get-WinEvent -LogName Application | Where-Object {$_.ProviderName -eq 'Print Spooler'}  # find the crash reason/faulting module","net stop spooler; del %systemroot%\\System32\\spool\\PRINTERS\\*.*; net start spooler  # clear a stuck queue","Get-PrinterDriver  # identify drivers correlated with the crashing servers","Update or replace the identified problematic printer driver"],verify:"Confirm the spooler service runs stably for an extended period across affected servers with no repeat crashes tied to the identified cause."},
  {id:616,domain:"Windows",category:"File Services",level:"Important",question:"Users on a DFS namespace intermittently get stale or inconsistent file versions depending on which server they connect to. What do you check?",answer:"This points to a DFS Replication lag or conflict between the namespace's target servers, rather than a client-side issue. Check replication backlog between the DFS replication group members, since a large backlog means changes on one server genuinely haven't propagated yet, and look for replication conflicts or a paused replication state that would explain persistent inconsistency rather than just temporary lag.",commands:["dfsrdiag replicationstate  # check current replication state","Get-DfsrBacklog -GroupName <group> -FolderName <folder> -SourceComputerName <src> -DestinationComputerName <dst>","dfsrdiag pollad  # force a configuration poll if settings were recently changed","Check DFSR event logs for conflict or error events"],verify:"Confirm replication backlog drops to a normal baseline and file versions are consistent across all namespace targets."},
  {id:617,domain:"Windows",category:"Auditing & Event Logs",level:"Important",question:"Compliance requires you to prove when a specific security group's membership changed and who made the change. Windows default logging doesn't seem to capture this. What do you enable?",answer:"Default audit policy often does not log detailed directory service changes. Enable the appropriate advanced audit policy subcategory for directory service changes and account management, which logs the specific attribute changed and the identity that made it, then ensure security event logs are retained long enough and forwarded to a central, access-restricted log store so they survive local log rotation and can't be locally tampered with.",commands:["auditpol /set /subcategory:'Security Group Management' /success:enable /failure:enable","auditpol /set /subcategory:'Directory Service Changes' /success:enable","Configure Windows Event Forwarding or a SIEM collector for centralized retention","Get-WinEvent -LogName Security -FilterXPath \"*[System[EventID=4735]]\"  # group membership change events"],verify:"Confirm a test group membership change generates the expected detailed event, forwarded successfully to the central log store."},
  {id:618,domain:"Windows",category:"BitLocker & Encryption",level:"Important",question:"A laptop with BitLocker enabled is stolen. The organization needs to confirm whether the data is actually protected. What do you verify, and what should already be in place?",answer:"Confirm the device's BitLocker status was actually On with the drive fully encrypted, not just enabled in policy, since a device can show as configured while encryption was still in progress or paused. Confirm the recovery key was properly escrowed to Active Directory or Azure AD before the loss, since a lost device with an unescrowed key is a much bigger problem, and immediately revoke the device's access to corporate resources and accounts it was authenticated to.",commands:["Get-BitLockerVolume  # if remote management data is available, confirm encryption status pre-loss","Check AD/Azure AD for escrowed BitLocker recovery key for that device","Revoke the device's Intune/MDM enrollment and conditional access trust","Disable/rotate credentials that were cached or auto-logged-in on that device"],verify:"Confirm encryption status was fully On at time of loss, the recovery key is properly escrowed and inaccessible to the thief, and the device's access to corporate systems is revoked."},
  {id:619,domain:"Windows",category:"Task Scheduler",level:"Important",question:"A scheduled task that runs a critical script stops executing, with no obvious error in the task history. What do you check?",answer:"Check the task's actual last run result code and the account it runs as, since a common cause is the service account's password expiring or the account losing the 'Log on as a batch job' right after a policy change, which can silently prevent execution without an obvious application-level error. Also confirm the task's trigger conditions, such as 'only run if on AC power' or 'only if network available,' still match the current environment.",commands:["Get-ScheduledTask -TaskName <name> | Get-ScheduledTaskInfo  # check LastRunTime and LastTaskResult","schtasks /query /tn <name> /v /fo list","whoami /priv  # for the service account, confirm required logon rights","Review the task's trigger and condition tabs for environment mismatches"],verify:"Confirm the task executes successfully on its next scheduled trigger and LastTaskResult shows a success code."},
  {id:620,domain:"Windows",category:"IIS",level:"Important",question:"An IIS-hosted application pool crashes repeatedly, taking the website down each time. How do you troubleshoot it?",answer:"Check the application pool's own event log entries and the Windows Application event log for the specific unhandled exception or worker process crash reason, since IIS itself is usually just hosting the failure, not causing it. Check for rapid-fail protection kicking in, which stops the app pool automatically after repeated crashes within a time window, and review recently deployed code or configuration changes correlated with when the crashes began.",commands:["Get-WinEvent -LogName Application | Where-Object {$_.ProviderName -like '*ASP.NET*' -or $_.ProviderName -like '*IIS*'}","%windir%\\System32\\LogFiles\\W3SVC*  # review IIS logs for the crash timeframe","appcmd list apppool /apppool.name:<name>  # check rapid-fail protection state","Review recent deployment/config change history correlated with crash onset"],verify:"Confirm the application pool remains stable under normal load with no further unplanned recycles tied to the original cause."},
  {id:621,domain:"Windows",category:"Hyper-V",level:"Important",question:"A Hyper-V virtual machine becomes unresponsive and won't respond to shutdown commands from the host. What is your recovery approach?",answer:"Avoid forcing a hard power-off as the first response if the guest OS state matters, since that risks data loss or corruption for a stateful workload. Check the VM's integration services status and host resource pressure first, since host-level CPU or memory exhaustion can make a guest appear hung when it's actually just starved of scheduling time. If a forced action is genuinely required, use a Hyper-V-level stop rather than pulling power at the hardware level, and investigate host capacity and integration services health afterward.",commands:["Get-VM <name> | Select-Object State, Status, IntegrationServicesState","Get-VMHost | Select-Object MemoryCapacity, LogicalProcessorCount  # check host resource pressure","Get-Counter '\\Hyper-V Hypervisor Logical Processor(_Total)\\% Total Run Time'  # host CPU pressure","Stop-VM <name> -TurnOff  # only after ruling out a recoverable state, as a last resort"],verify:"Confirm the VM returns to a stable Running state, host resource pressure is understood, and integration services report healthy going forward."},
  {id:622,domain:"Windows",category:"Failover Clustering",level:"Critical",question:"A Windows Failover Cluster shows a resource group repeatedly failing over between nodes without staying stable on any one node. What do you investigate?",answer:"Repeated failover, not a single one, indicates the resource is failing its health check on every node it lands on, not that one specific node is bad. Check the cluster resource's own event logs and health check failure reason first, since the underlying application or dependency, such as storage connectivity, is often the real cause rather than the cluster software itself. Confirm shared storage connectivity is healthy from every node, since a storage path issue often causes exactly this pattern.",commands:["Get-ClusterLog -Destination <path>  # detailed cluster diagnostic log","Get-ClusterResource <name> | Get-ClusterParameter","Test-Cluster  # validate cluster health including storage connectivity from all nodes","Get-WinEvent -LogName 'Microsoft-Windows-FailoverClustering/Operational'"],verify:"Confirm the resource group stays stable on a single node for an extended period with no further unplanned failovers."},
  {id:623,domain:"Windows",category:"Registry & Group Policy",level:"Important",question:"A setting configured through Group Policy keeps reverting on a specific server, even though gpupdate reports success and the GPO shows as applied. What is the likely cause?",answer:"Another mechanism is likely overwriting the setting after Group Policy applies it, such as a local script, a different conflicting GPO with different precedence applying afterward, or a management agent like SCCM/Intune configuring the same setting independently. Confirm exactly which GPO last wrote the setting using resultant set of policy reporting, and check for scheduled tasks or agents that touch the same registry key on a schedule.",commands:["gpresult /h report.html  # confirm which GPO is the winning policy for that setting","Get-ItemProperty <registry-path>  # check current value and compare timing to GPO refresh interval","Review Task Scheduler for jobs touching the same registry key","Check for SCCM/Intune configuration baselines targeting the same setting"],verify:"Confirm the setting remains stable after the conflicting mechanism is identified and either removed or aligned with the intended Group Policy value."},
  {id:624,domain:"Windows",category:"User Profiles",level:"Important",question:"A user's desktop profile has become corrupted, and they log in to a temporary profile instead of their normal one. How do you recover their actual profile and data?",answer:"Do not delete the corrupted profile immediately, since the user's actual data usually still exists on disk even if Windows won't load it as their active profile. Identify the corrupted profile folder, back up its contents first, then either repair the profile's registry association or rebuild a new profile and manually migrate the user's data folders into it, communicating clearly with the user about what will and won't be preserved automatically.",commands:["Get-WmiObject -Class Win32_UserProfile | Where-Object {$_.SID -eq '<user-sid>'}  # confirm profile state","Back up the existing profile folder (e.g., robocopy) before making any changes","Check registry ProfileList key for a .bak or orphaned SID entry causing the temp-profile issue","Rebuild the profile and migrate data manually if repair isn't reliable"],verify:"Confirm the user logs in to their normal profile with their data intact, and the backup is retained until the user confirms nothing is missing."},
  {id:625,domain:"Windows",category:"Kerberos Authentication",level:"Critical",question:"An application using Kerberos authentication suddenly starts failing with authentication errors, even though the user's password hasn't changed. What do you check?",answer:"Kerberos is highly sensitive to time skew and SPN configuration, so check clock synchronization between the client, server, and domain controller first, since Kerberos tickets are rejected outside an allowed time skew window. Also check for a duplicate or missing Service Principal Name, which can silently break Kerberos authentication for a specific service while leaving other authentication methods on the same server unaffected.",commands:["w32tm /query /status  # check time sync on client, server, and DC","setspn -L <service-account>  # check for correct SPN registration","setspn -X  # check for duplicate SPNs across the domain","klist  # check currently cached tickets on the client for errors"],verify:"Confirm authentication succeeds consistently after correcting time sync or SPN registration, with klist showing a valid ticket."},
  {id:626,domain:"Windows",category:"NTFS Permissions",level:"Important",question:"A user reports they can see a folder in a file share but cannot open any files inside it, even though their manager insists they were granted access. What do you check?",answer:"This is a common symptom of a mismatch between share-level and NTFS-level permissions, since both are enforced and the more restrictive one wins. Check NTFS permissions on the actual files/folder separately from the share permissions, since access can be granted at the share level but still blocked by inherited or explicit NTFS deny permissions, or vice versa. Also check whether the user's access came from a group membership that hasn't propagated yet due to a cached Kerberos ticket.",commands:["icacls <path>  # check effective NTFS permissions","net share  # check share-level permissions for comparison","klist purge  # clear cached Kerberos ticket to pick up new group membership","gpresult /r  # confirm the user's current group memberships as seen by the system"],verify:"Confirm the user can both see and open files after reconciling NTFS and share permissions, verified with a fresh logon to rule out a cached ticket."},
  {id:627,domain:"Windows",category:"Windows Update Management",level:"Important",question:"Several servers report as compliant in your patch management console, but a vulnerability scanner still flags a specific known CVE as unpatched on those same servers. What explains the discrepancy?",answer:"The patch console reporting compliance usually means the specific update was successfully installed, but the vulnerability can persist if a required reboot to complete the update was never performed, or if the vulnerable component is bundled differently than the patch console tracks it. Confirm pending reboot status first, since that's the most common cause, then confirm the CVE actually maps to the update you believe was installed.",commands:["Get-WindowsUpdateLog  # or Get-Hotfix to confirm the specific KB is installed","Check for pending reboot: HKLM:\\...\\Component Based Servicing\\RebootPending","Cross-reference the CVE with the vendor's specific KB/advisory mapping","Reboot and re-scan to confirm the vulnerability clears after the pending update completes"],verify:"Confirm the vulnerability scanner no longer flags the CVE after confirming the correct update is installed and any pending reboot is completed."},
  {id:628,domain:"Windows",category:"Server Core & Remote Management",level:"Important",question:"You manage a fleet of Server Core instances, and one becomes unresponsive to typical remote management tools. What is your recovery approach without physical/console access?",answer:"Layer your recovery attempts from least to most disruptive: first try alternate remote management channels, such as PowerShell remoting over a different network path, or the out-of-band management interface like iDRAC/iLO if it's physical hardware or a hypervisor console if virtual, before assuming the OS itself needs recovery. Confirm whether the issue is network-level, such as a firewall or NIC problem, versus the OS genuinely being hung, since the recovery path differs significantly.",commands:["Test-NetConnection <server> -Port 5985  # WinRM/PowerShell remoting port","Try an alternate management path: iDRAC/iLO console or hypervisor console access","Enter-PSSession -ComputerName <server>  # from a working management host","Check via hypervisor/out-of-band console whether the OS is genuinely hung vs a network-only issue"],verify:"Confirm remote management access is restored and the root cause (network vs OS hang) is identified so it can be prevented going forward."},
  {id:629,domain:"Windows",category:"Licensing & Activation",level:"Important",question:"Several Windows Servers begin showing activation warnings and reduced functionality notices, even though they were properly licensed at deployment. What is the likely cause and fix?",answer:"This is commonly caused by a KMS (Key Management Service) activation host issue, since KMS-activated systems must periodically re-activate against the KMS host and will show warnings if that renewal fails repeatedly, such as from the KMS host being unreachable or its own license count/threshold not being met. Confirm the KMS host is reachable and healthy, check the specific activation error code, which usually points to the precise cause, and manually trigger re-activation once the underlying KMS issue is fixed.",commands:["slmgr /dlv  # detailed license status and current KMS host on the affected server","Test-NetConnection <kms-host> -Port 1688  # confirm KMS host reachability","slmgr /ato  # manually trigger re-activation after fixing the root cause","Check KMS host's own activation count/threshold if using count-based activation"],verify:"Confirm affected servers show a fully licensed, activated status after KMS connectivity is restored and re-activation is triggered."},
  {id:630,domain:"Windows",category:"Disaster Recovery",level:"Critical",question:"Your organization has Windows Server backups configured, but has never actually tested a full bare-metal restore. What risk does this create, and how do you validate it properly?",answer:"An untested backup is an unproven assumption, not a guarantee, since bare-metal restore failures are commonly caused by driver incompatibility on replacement hardware, missing system state components, or a backup that completes technically but excludes something critical to a full recovery. Perform the restore in an isolated test environment representative of what a real recovery would use, and measure the actual time required against your defined recovery time objective, not just confirm the restore technically completes.",commands:["wbadmin start systemstaterecovery  # or full bare-metal recovery via boot media, in an isolated test environment","Measure total time from restore start to a fully functional, network-reachable system","Validate all critical services actually start and function post-restore, not just that Windows boots","Document the tested recovery time against the defined RTO and any gaps found"],verify:"Confirm a full bare-metal restore completes successfully in the isolated test, meets the defined RTO, and all critical services are validated functional afterward."},

  {id:701,domain:"VMware",category:"Snapshots",level:"Critical",question:"A VM has been running for months with an old snapshot no one remembers creating, and the datastore is now nearly full. What is the safest way to remove it?",answer:"Do not simply delete the snapshot file from the datastore browser — always remove it through vCenter's snapshot manager so the disk chain is consolidated correctly. Check available free space on the datastore first, since consolidation temporarily needs additional space equal to the changes tracked in the snapshot, and a very old, large snapshot can require a substantial amount. Schedule the removal for a maintenance window if the VM is I/O-sensitive, since consolidation causes a brief performance impact.",commands:["Get-Snapshot -VM <vm> | Select-Object Name,Created,SizeGB","Get-Datastore <ds> | Select-Object FreeSpaceGB","Get-Snapshot -VM <vm> | Remove-Snapshot -Confirm:$false","Get-VM <vm> | Get-View | Select -ExpandProperty Runtime | Select ConsolidationNeeded"],verify:"Confirm ConsolidationNeeded reports false and the VM's disk files in the datastore browser match the expected flat/base disk only."},
  {id:702,domain:"VMware",category:"Snapshots",level:"Important",question:"vCenter shows a VM needs disk consolidation, but running consolidate does nothing and the warning keeps returning. What do you check?",answer:"This is often caused by a snapshot delta file that a backup product's changed-block-tracking snapshot left behind and never released properly, or a hung process still holding a lock on one of the delta disks. Check the VM's actual files in the datastore versus what vCenter's snapshot manager reports, since a mismatch there points to an orphaned snapshot rather than a real active one. A short, planned power cycle of the VM is sometimes required to release a stuck lock before consolidation can complete.",commands:["Get-VM <vm> | Get-View | Select -ExpandProperty LayoutEx | Select -ExpandProperty File","vim-cmd vmsvc/getallvms","vim-cmd vmsvc/snapshot.get <vmid>","ls -la /vmfs/volumes/<datastore>/<vm-folder>/"],verify:"Confirm the VM's directory only shows the expected base VMDK and flat file, and vCenter no longer flags consolidation needed."},
  {id:703,domain:"VMware",category:"Snapshots",level:"Important",question:"A backup job that uses snapshots is leaving VMs with high latency for hours after the backup window ends. What's the likely cause?",answer:"The backup software is likely not removing its snapshot promptly after the backup completes, or the VM has a high rate of change causing the snapshot delta to grow very large before it's finally consolidated. Check how long the snapshot actually exists versus the backup job's reported duration, and check delta disk growth during that window. If the backup tool's own snapshot removal is slow, that points at the backup product's post-job cleanup step, not vSphere itself.",commands:["Get-Snapshot -VM <vm> | Select Created,SizeGB","esxtop  # check disk latency (DAVG/KAVG) during and after the backup window","Get-VIEvent -Entity <vm> -Start (Get-Date).AddHours(-6) | Where {$_.FullFormattedMessage -match 'snapshot'}"],verify:"Confirm snapshots are removed within the expected window after backup completion and VM latency returns to baseline immediately after."},
  {id:704,domain:"VMware",category:"vMotion",level:"Critical",question:"A vMotion migration fails with a compatibility error even though both hosts appear identical in the cluster. What do you check?",answer:"Compatibility errors usually come down to CPU feature differences the cluster's EVC (Enhanced vMotion Compatibility) mode should be masking, or a VM configured with a CPU feature requirement that pins it to specific hardware. Confirm both hosts are actually in the EVC-enabled cluster and running the same EVC baseline, and check whether the VM has CPU ID mask exposed or hardware-assisted virtualization pinned in its configuration, which can silently exclude EVC protection.",commands:["Get-Cluster <cluster> | Select EVCMode","Get-VMHost | Select Name,Parent","Get-VM <vm> | Get-View | Select -ExpandProperty Config | Select -ExpandProperty CpuFeatureMask","vMotion via vSphere Client and read the exact incompatibility message"],verify:"Confirm the VM migrates successfully between all hosts in the cluster after resolving the EVC or CPU mask mismatch."},
  {id:705,domain:"VMware",category:"vMotion",level:"Important",question:"vMotion is extremely slow and times out on 10GbE-connected hosts, even though the network looks healthy. What do you investigate?",answer:"Confirm the vMotion VMkernel port is actually using the intended 10GbE uplink and not falling back to a slower path, since a misconfigured vSwitch or portgroup failover order can silently route vMotion traffic over a management network instead. Check for MTU mismatches if jumbo frames are configured, since a mismatch anywhere along the path causes fragmentation or drops that dramatically reduce throughput without an outright failure.",commands:["Get-VMHostNetworkAdapter -VMKernel | Where {$_.VMotionEnabled}","esxcli network ip interface list  # check MTU per vmkernel interface","vmkping -I vmk<N> -d -s 8972 <destination-vmk-ip>  # test jumbo frame path","esxtop  # check network throughput (n) during migration"],verify:"Confirm vMotion completes within the expected time for VM memory size and the network path shows the intended full throughput."},
  {id:706,domain:"VMware",category:"DRS",level:"Important",question:"DRS is enabled and set to fully automated, but VMs are clearly imbalanced across hosts in the cluster. Why might that be happening?",answer:"Check DRS affinity and anti-affinity rules first, since a rule can force VMs to stay together or apart in a way that overrides balance recommendations. Also check whether individual VMs have DRS automation level overridden to manual or partially automated, which prevents DRS from moving them even when the cluster-level setting is fully automated. Resource pool shares and limits can also constrain where DRS is willing to place VMs.",commands:["Get-DrsRule -Cluster <cluster>","Get-VM | Select Name,DrsAutomationLevel","Get-Cluster <cluster> | Select DrsAutomationLevel","Get-DrsRecommendation -Cluster <cluster>"],verify:"Confirm CPU and memory utilization become more balanced across hosts after correcting the rule or override causing the imbalance."},
  {id:707,domain:"VMware",category:"HA",level:"Critical",question:"An ESXi host suddenly loses network connectivity, and vSphere HA declares it isolated. What happens to the VMs, and what should you check?",answer:"The isolation response configured on the cluster determines what happens next — VMs may be left powered on, shut down, or powered off depending on that setting, and the intent matters because leaving VMs running on an isolated host risks a split-brain scenario if HA restarts them elsewhere while they're still active on the isolated host. Confirm whether this was a true host isolation or a full host failure, since the recovery path differs, and check the actual root cause of the connectivity loss before assuming it's resolved.",commands:["Get-Cluster <cluster> | Get-VMHost | Select Name,ConnectionState","Get-VMHost <host> | Get-VMHostNetwork","esxcli network ip connection list  # from host if reachable via alternate path","Review vCenter events/tasks for the isolation and any HA restart actions"],verify:"Confirm the host rejoins the cluster cleanly, no VM is running in two places at once, and the network root cause is resolved."},
  {id:708,domain:"VMware",category:"HA",level:"Important",question:"vSphere HA reports 'insufficient failover resources' and admission control is blocking new VM power-on operations. How do you respond?",answer:"This means the cluster's reserved failover capacity, based on the configured admission control policy, believes it can no longer guarantee restarting all protected VMs if a host fails. Check actual cluster resource utilization against the admission control policy, such as percentage reserved or a defined number of host failures to tolerate, before simply disabling admission control, which removes the safety guarantee rather than fixing the underlying capacity shortfall.",commands:["Get-Cluster <cluster> | Select HAAdmissionControlEnabled","Get-VMHost | Select Name,CpuUsageMhz,MemoryUsageGB,CpuTotalMhz,MemoryTotalGB","Get-Cluster <cluster> | Get-View | Select -ExpandProperty Configuration | Select DasConfig"],verify:"Confirm VMs can power on again after adding capacity or right-sizing reservations, without disabling the underlying HA protection."},
  {id:709,domain:"VMware",category:"Storage",level:"Critical",question:"Multiple VMs on the same datastore suddenly go unresponsive, and the host logs show an All Paths Down (APD) condition. What is your response?",answer:"APD means the host has lost all paths to the storage device and doesn't yet know if it's permanent, which is dangerous because I/O can hang indefinitely by default. Check the storage fabric and array for the actual outage, whether it's a switch, HBA, or array-side issue, since fixing the array without addressing host-side path health won't resolve it. Distinguish APD from Permanent Device Loss (PDL): PDL means the array has explicitly said the device is gone, while APD means the host simply cannot tell.",commands:["esxcli storage core device list","esxcli storage san fc list  # or iscsi, depending on transport","vmkernel log: vmkwarning.log and vmkernel.log for APD/PDL events","esxcli storage core device detached list"],verify:"Confirm all paths report active and I/O to affected VMs resumes without needing to reboot the host, once the fabric or array issue is resolved."},
  {id:710,domain:"VMware",category:"Storage",level:"Important",question:"A VMFS datastore shows heartbeat timeout warnings, and VMs occasionally pause briefly. What does this usually indicate?",answer:"VMFS heartbeat issues typically point to intermittent storage latency or connectivity problems between the host and the array, not application-level issues inside the VM. Check storage latency metrics at the host level, and confirm whether multiple hosts sharing the same datastore are all affected or just one, which helps distinguish a host-specific HBA/path problem from a shared array or fabric-wide issue.",commands:["esxtop  # check DAVG/KAVG/GAVG latency columns","esxcli storage core device stats get -d <naa-id>","vmkernel.log for VMFS heartbeat or lock messages","Check array-side performance metrics for the same time window"],verify:"Confirm heartbeat warnings stop and device latency stays within the array vendor's recommended thresholds under normal load."},
  {id:711,domain:"VMware",category:"Storage",level:"Important",question:"A VM using a Raw Device Mapping (RDM) fails to migrate to another host even though regular VMs migrate fine. What's the likely issue?",answer:"RDMs require the target host to have visibility to the exact same LUN presented the same way, so check LUN masking and zoning on the target host, and confirm the RDM is configured in the compatibility mode (physical or virtual) the receiving host actually supports for that operation. A physical-mode RDM has additional migration restrictions compared to virtual-mode.",commands:["Get-HardDisk -VM <vm> | Where {$_.DiskType -like '*Raw*'}","esxcli storage core device list  # confirm LUN visible on target host","Check SAN zoning/masking includes the target host's HBA WWNs"],verify:"Confirm the target host sees the identical LUN and the migration completes successfully."},
  {id:712,domain:"VMware",category:"Networking",level:"Critical",question:"VMs on one portgroup can't reach the network after a vSwitch change, while other portgroups on the same host work fine. What do you check?",answer:"Isolate the problem to the specific portgroup's VLAN ID, active/standby uplink configuration, and security policy settings, since these are configured per portgroup and a change to one doesn't necessarily affect others sharing the same vSwitch. Confirm the VLAN tag matches what the physical switch port expects for that portgroup, and check whether the uplink failover order was changed in a way that isolates this portgroup from a working physical uplink.",commands:["Get-VirtualPortGroup -VMHost <host> | Select Name,VLanId","Get-VirtualSwitch -VMHost <host> | Get-NicTeamingPolicy","esxcli network vswitch standard portgroup list","Confirm physical switch port trunk/access configuration matches"],verify:"Confirm VMs on the affected portgroup regain connectivity and the VLAN tag matches the physical switch configuration exactly."},
  {id:713,domain:"VMware",category:"Networking",level:"Important",question:"After replacing a failed NIC, a host shows intermittent network drops for VMs using NIC teaming. What should you verify?",answer:"Confirm the replacement NIC's link speed and duplex match the rest of the team and the physical switch port configuration, since a mismatched or auto-negotiation failure on just one team member can cause intermittent drops as traffic load-balances across it. Also verify the new NIC's driver and firmware version, since driver mismatches between team members are a less obvious but real cause of instability.",commands:["esxcli network nic list","esxcli network nic get -n vmnicX","Get-VMHostNetworkAdapter | Select Name,BitRatePerSec,FullDuplex","Check physical switch port statistics for errors on that port"],verify:"Confirm the new NIC reports the expected link speed and duplex, and dropped-packet counters stop increasing under normal load."},
  {id:714,domain:"VMware",category:"Performance",level:"Critical",question:"A VM feels sluggish, but the guest OS shows low CPU utilization. What should you check at the hypervisor level?",answer:"Check CPU Ready time in esxtop, which measures how long a VM's vCPU was ready to run but had to wait for physical CPU scheduling — high ready time means the guest OS sees low utilization of the vCPU it has, while the real bottleneck is contention for physical CPU at the host or cluster level. This is a very common gap between what the guest reports and what's actually happening.",commands:["esxtop  # press c for CPU view, check %RDY column","Get-Stat -Entity <vm> -Stat cpu.ready.summation -Realtime","Get-VM <vm> | Select NumCpu","Check host and cluster overall CPU utilization for contention"],verify:"Confirm %RDY drops to a low value after addressing overcommitment or right-sizing vCPU count, and the guest-perceived performance improves."},
  {id:715,domain:"VMware",category:"Performance",level:"Important",question:"A host shows high memory usage and VMs are ballooning, but the guest OSes report plenty of free memory. What does this tell you?",answer:"Ballooning happens when the host is under real memory pressure and asks the guest, via VMware Tools, to reclaim memory it isn't actively using — the guest OS's own 'free memory' view doesn't account for this reclaimed memory being held back for the host. Distinguish ballooning, which is a normal reclamation mechanism, from active swapping to disk, which is a much more serious performance problem, by checking both metrics separately.",commands:["esxtop  # press m for memory view, check MCTL and SWAP columns","Get-Stat -Entity <vm> -Stat mem.vmmemctl.average","Get-Stat -Entity <vm> -Stat mem.swapped.average","Get-VMHost <host> | Select MemoryUsageGB,MemoryTotalGB"],verify:"Confirm swap activity is at or near zero, and ballooning decreases after reducing host memory overcommitment or adding capacity."},
  {id:716,domain:"VMware",category:"Patching & Lifecycle",level:"Important",question:"A host won't enter maintenance mode — it hangs at a percentage and never completes. What is the usual cause?",answer:"Maintenance mode waits for every VM to be evacuated, so a single VM that can't vMotion off, due to a local-only resource like a CD-ROM mounted from local storage, a DRS anti-affinity rule with no valid destination, or insufficient resources on remaining hosts, will block it indefinitely. Identify the specific VM still present on the host rather than waiting longer, since maintenance mode won't time out on its own.",commands:["Get-VMHost <host> | Get-VM","Check for VMs with a device connected to local host storage (CD-ROM, local datastore)","Get-DrsRule -Cluster <cluster>  # check for a rule this VM can't satisfy elsewhere","vMotion the specific blocking VM manually and read the exact error"],verify:"Confirm the host completes entering maintenance mode once the blocking VM is manually relocated or its local-resource dependency is removed."},
  {id:717,domain:"VMware",category:"Patching & Lifecycle",level:"Important",question:"A vSphere Lifecycle Manager (or Update Manager) remediation fails partway through a host update. What do you check before retrying?",answer:"Read the exact failure reason in the remediation task before retrying blindly, since retrying a failed firmware or driver update without understanding the cause can leave the host in a worse, inconsistent state. Common causes include the host failing to enter maintenance mode cleanly, insufficient staging space on the host, or a hardware compatibility check failure against the desired image. Confirm the host's current state and whether it's still stable before deciding whether to retry or roll back.",commands:["Review the remediation task details and failure message in vCenter","Get-VMHost <host> | Select ConnectionState,PowerState","df -h /  # or equivalent on the host to check local staging space","Check hardware compatibility against the desired vLCM image / VUM baseline"],verify:"Confirm the host reports a healthy, expected build/version and rejoins the cluster with all services running normally after a successful remediation."},
  {id:718,domain:"VMware",category:"vCenter",level:"Critical",question:"The vCenter Server Appliance becomes unresponsive, and the vSphere Client won't load. How do you troubleshoot without vCenter itself?",answer:"ESXi hosts continue running VMs independently of vCenter, so there's no immediate VM outage, but you lose centralized management, DRS, and HA orchestration changes until it's restored. Access the vCenter Server Appliance Management Interface (VAMI) or console directly to check appliance health, disk space, and service status, since a full root filesystem is a common cause of this exact symptom on the appliance.",commands:["Access https://<vcenter>:5480 (VAMI) directly","service-control --status --all  # on the VCSA via SSH/console","df -h  # check for a full disk on the appliance, especially /storage/log or /storage/db","Review vCenter's own logs via VAMI or SSH if a specific service is down"],verify:"Confirm all vCenter services report running and the vSphere Client becomes reachable, with no VM impact during the outage."},
  {id:719,domain:"VMware",category:"vCenter",level:"Important",question:"Users report they can't log in to vCenter with domain credentials, though local administrator@vsphere.local still works. What do you check?",answer:"This points at the Single Sign-On identity source configuration, not vCenter itself, since the built-in SSO domain authenticating fine while an external identity source fails is a clear signal. Check connectivity and credentials for the configured Active Directory identity source, and check certificate or time synchronization issues between vCenter and the domain controllers, since Kerberos-based authentication is very sensitive to clock drift.",commands:["Check SSO identity source configuration and test connection in vCenter","w32tm /query /status  # on domain controllers, and check vCenter's own time sync","Test basic LDAP connectivity from the vCenter appliance to the domain controller","Review SSO/STS logs on the vCenter appliance for the specific authentication failure"],verify:"Confirm domain users can authenticate successfully and the identity source reports a healthy connection status."},
  {id:720,domain:"VMware",category:"vSAN",level:"Critical",question:"A vSAN cluster shows a disk group as failed, and some objects report reduced availability. What is your immediate priority?",answer:"Confirm the actual data redundancy state before doing anything else — vSAN's storage policies determine how many failures an object can tolerate, so check whether affected objects are still fully protected against another failure or are already running with reduced redundancy, which changes the urgency significantly. Identify whether the failure is a single disk or the entire disk group's cache or capacity tier device, since a cache tier device failure takes the whole disk group offline.",commands:["Get-VsanClusterHealth  # or vCenter's vSAN Health UI","esxcli vsan storage list","esxcli vsan health cluster get","Check vSAN's resync/rebuild status for affected objects"],verify:"Confirm all objects return to their configured redundancy level after the failed device or disk group is replaced and resync completes."},
  {id:721,domain:"VMware",category:"vSAN",level:"Important",question:"vSAN performance degrades noticeably during a resync operation after adding a new host. Is this expected, and what can you do?",answer:"Some performance impact during a large resync is expected, since it consumes network and storage I/O to rebalance data, but it shouldn't be severe enough to significantly affect production workloads if configured correctly. Check whether resync throttling is enabled and whether the resync is scheduled or bounded to avoid business hours if the impact is unacceptable, rather than assuming nothing can be done about it.",commands:["Check vSAN resync throttling / bandwidth limit settings in cluster configuration","Monitor vSAN Performance Service for resync I/O and latency impact","Consider scheduling large rebalance operations outside peak hours if supported by the vSAN version"],verify:"Confirm resync completes, all data reaches full redundancy, and application latency during future resyncs stays within an agreed tolerance."},
  {id:722,domain:"VMware",category:"Security",level:"Important",question:"A security audit flags that ESXi hosts have SSH and lockdown mode both effectively disabled. What's the risk, and how do you remediate without breaking operations?",answer:"With SSH open and lockdown mode disabled, hosts can be managed and potentially compromised outside of vCenter's audited, role-based control path, undermining the ability to track who did what. Enable lockdown mode, which forces management operations through vCenter, and disable or tightly restrict SSH, but first confirm no automation or monitoring tooling depends on direct host-level SSH or API access that would break under lockdown, and add exception accounts deliberately if truly needed.",commands:["Get-VMHost | Select Name,@{N='LockdownMode';E={$_.Extensiondata.Config.LockdownMode}}","Get-VMHostService -VMHost <host> | Where {$_.Key -eq 'TSM-SSH'}","Set-VMHost -VMHost <host> -State Connected  # then enable lockdown via vCenter UI or API","Audit any scripts/tools that connect directly to hosts via SSH before enforcing"],verify:"Confirm hosts report lockdown mode enabled, SSH is stopped, and all management operations still function correctly through vCenter."},
  {id:723,domain:"VMware",category:"Security",level:"Important",question:"The vCenter machine SSL certificate is about to expire, and browsers are already showing warnings for the web client. What is the correct replacement process?",answer:"Do not simply generate a new self-signed certificate as a quick fix without understanding the current certificate mode, since vCenter's certificate management depends on whether it's using VMware's internal Certificate Authority (VMCA), a custom CA-signed certificate, or a hybrid mode, and using the wrong replacement method can break trust with ESXi hosts and other vCenter services. Use the built-in Certificate Manager tool for the appropriate mode rather than manually replacing files.",commands:["/usr/lib/vmware-vmca/bin/certificate-manager  # on the VCSA, run the appropriate certificate replacement option","Check current certificate mode: VMCA, custom, or hybrid","Back up existing certificates before replacement","Verify ESXi hosts still show as trusted/connected after replacement"],verify:"Confirm the new certificate is valid, trusted, and all hosts and services remain connected without a trust or connectivity error."},
  {id:724,domain:"VMware",category:"Licensing",level:"Important",question:"A feature like DRS or vSAN suddenly becomes greyed out in the vSphere Client. What is the most likely, most boring explanation to check first?",answer:"Check license status and edition before troubleshooting the feature itself, since an expired license or evaluation period, or licensing a host with an edition that doesn't include that feature, produces exactly this symptom and is far more common than an actual product defect. Confirm the license is assigned to the affected host or cluster specifically, not just present in vCenter's inventory.",commands:["Get-License  # or vCenter's Licensing administration view","Get-VMHost | Select Name,LicenseKey","Check license expiration date and edition/feature entitlements","Confirm the license is assigned to the specific host/cluster in question"],verify:"Confirm the feature becomes available again after assigning a valid, appropriately-licensed key to the affected hosts or cluster."},
  {id:725,domain:"VMware",category:"Backup & DR",level:"Critical",question:"A VM backup job reports success every night, but a test restore fails. What should you check in a VMware environment specifically?",answer:"A successful backup task in vCenter's task list doesn't guarantee an application-consistent, restorable backup — check whether the backup product's VMware Tools quiescing succeeded during the job, since a failed or skipped quiesce can produce a crash-consistent rather than application-consistent snapshot for database or transactional workloads. Also confirm the backup actually captured all disks attached to the VM, since a disk added after the backup job was configured is easy to miss.",commands:["Check backup job logs specifically for quiesce success/failure, not just overall job status","Get-VM <vm> | Get-HardDisk  # confirm all disks are included in the backup job scope","Test a restore into an isolated environment, not just verify the backup file exists","Check VMware Tools status and version on the source VM"],verify:"Confirm a full restore succeeds into an isolated environment and the application starts cleanly with consistent data."},
  {id:726,domain:"VMware",category:"VM Lifecycle",level:"Important",question:"A VM won't power on and the error references a locked file or another host holding a lock. What does this mean, and how do you resolve it safely?",answer:"This typically means the VM's files are still locked by another host, often because the VM was recently running elsewhere, is mid-migration, or a host that was managing it lost connectivity without releasing the lock cleanly. Identify which host actually holds the lock before forcing anything, since incorrectly powering the VM on from two hosts simultaneously can corrupt its disk.",commands:["vmkfstools -D <path-to-vmdk>  # shows lock owner information","Check vCenter for any other host reporting the VM as running or migrating","Get-VM <vm> | Select Name,PowerState,VMHost","If confirmed safe, use vim-cmd or vCenter to reset the VM's registration on the correct host"],verify:"Confirm the VM powers on cleanly from exactly one host and no duplicate registration exists elsewhere in the cluster."},
  {id:727,domain:"VMware",category:"VM Lifecycle",level:"Important",question:"Cloning a VM from a template fails partway through with a generic error. What is your troubleshooting approach?",answer:"Check datastore free space on the destination first, since clone operations fail ungracefully when space runs out mid-copy, then check the exact error in the recent tasks pane rather than relying on the generic failure message alone. Confirm the template itself isn't corrupted or has a snapshot attached, since templates with lingering snapshots can behave unexpectedly during cloning depending on the vSphere version.",commands:["Get-Datastore <destination-ds> | Select FreeSpaceGB","Get-Template <template> | Get-Snapshot  # confirm no unexpected snapshots","Review the detailed error in vCenter's Recent Tasks / Events for the clone operation","Retry the clone to a datastore with confirmed adequate free space"],verify:"Confirm the clone completes successfully and the resulting VM boots and matches the expected configuration."},
  {id:728,domain:"VMware",category:"Monitoring",level:"Important",question:"How do you explain the difference between esxtop and vCenter's performance charts when a colleague asks which one to trust during a live incident?",answer:"esxtop shows real-time, host-level data with very fine granularity and no aggregation delay, making it the right tool during an active incident on a specific host. vCenter's performance charts aggregate data over intervals and store historical trends, which is better for spotting patterns over hours, days, or weeks but can lag behind what's happening right now by the length of the collection interval. Use esxtop for 'what is happening on this host right now' and vCenter charts for 'how has this changed over time.'",commands:["esxtop  # real-time host-level view","vCenter Performance charts set to Real-time (host only) for the closest equivalent","Get-Stat -Realtime -Entity <object> -Stat <counter>  # scripted real-time equivalent"],verify:"Confirm the metric read from esxtop during the live incident matches the trend later reflected in vCenter's historical charts for the same window."},
  {id:729,domain:"VMware",category:"Automation",level:"Important",question:"You need to apply the same configuration change, such as a syslog target or NTP server, across 50 ESXi hosts. What is the production-safe approach?",answer:"Avoid manually repeating the change in the UI 50 times, which is slow and error-prone with no consistent record of what was done. Use PowerCLI or Host Profiles to apply the change consistently, test it against a small pilot group of hosts first, and use Host Profiles compliance checking afterward to confirm every host actually matches the intended configuration rather than assuming the script succeeded everywhere.",commands:["Get-VMHost | Set-VMHostSysLogServer -SysLogServer <target>  # example bulk PowerCLI change","Get-VMHost | Add-VMHostNtpServer -NtpServer <server>","Host Profiles: create from a reference host, attach to cluster, remediate","Test-VMHostProfileCompliance  # confirm all hosts match after applying"],verify:"Confirm all 50 hosts report the intended configuration via Host Profile compliance checking or a scripted verification pass, not just that the change command completed without error."},
  {id:730,domain:"VMware",category:"Incident Response",level:"Critical",question:"An entire vSphere cluster becomes unreachable at once — hosts, VMs, and vCenter all unresponsive from the management network. What is your first move?",answer:"Confirm the scope before assuming a vSphere-specific failure — a cluster-wide simultaneous outage often points to something upstream, such as core network switching, DNS, or power, rather than every host failing independently at the same moment. Check whether VMs are still actually running and serving traffic even though management access is down, since a management-plane outage is very different in urgency from a real compute outage, and avoid rebooting hosts reflexively before confirming which one it actually is.",commands:["Confirm from a different network path whether application traffic to VMs is still flowing","Check core network switch, DNS, and power infrastructure status independently of vSphere","ping/console access to a host directly, bypassing vCenter, to confirm host-level health","Review physical infrastructure and change logs for anything applied cluster-wide just before the outage"],verify:"Confirm management connectivity is restored, all hosts and VMs report healthy, and the root cause is identified as either a vSphere issue or upstream infrastructure issue with evidence, not assumption."}
];

const scenarios = [
  ...linuxScenarios.map((item) => ({ ...item, domain: "Linux" })),
  ...extraScenarios
];
const domains = ["Linux", "DevOps", "Cloud", "Kubernetes", "Network", "Security", "Windows", "VMware"];
const categories = [...new Set(scenarios.map((item) => item.category))];

// The raw ids (1-37 for Linux, 101-109 for DevOps, 201-209 for Cloud, ...) exist only so
// each domain's source list can be edited independently without renumbering everything.
// For display we always want a clean 1, 2, 3... order within the domain the visitor is
// viewing, so we compute that sequential position here instead of showing the raw id.
const domainTotals = domains.reduce<Record<string, number>>((totals, domain) => {
  totals[domain] = scenarios.filter((item) => item.domain === domain).length;
  return totals;
}, {});
const domainCounters: Record<string, number> = {};
const scenariosWithDisplay = scenarios.map((item) => {
  domainCounters[item.domain] = (domainCounters[item.domain] ?? 0) + 1;
  return { ...item, displayNumber: domainCounters[item.domain], domainTotal: domainTotals[item.domain] };
});

const pageDescription = "Production-focused scenario interview questions and answers for Linux, DevOps, Cloud, Kubernetes, Network, Security, Windows, and VMware engineers.";
---

<Layout title="IT Scenario Interview Questions & Answers | Linux, DevOps, Cloud, Kubernetes, Network, Security & Windows" description={pageDescription}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><span>Interview Q&A</span></nav>
        <span class="eyebrow">Production troubleshooting practice</span>
        <h1>IT Scenario Interview Questions & Answers</h1>
        <p class="lead">Practice real production scenarios across Linux, DevOps, Cloud, Kubernetes, Network, Security, Windows, and VMware. Every answer focuses on troubleshooting order, useful commands, risk awareness, and verification.</p>
        <div class="hero-actions">
          <a class="primary" href="#questions">Start Practicing</a>
          <a class="secondary" href="/linux/">Linux Tools</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="Interview guide summary">
        <strong>{scenarios.length}</strong>
        <span>Production scenarios</span>
        <div class="mini-grid">
          <div><b>{categories.length}</b><small>skill areas</small></div>
          <div><b>{domains.length}</b><small>technology domains</small></div>
          <div><b>Senior</b><small>troubleshooting</small></div>
          <div><b>Free</b><small>no signup</small></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="intro container" aria-labelledby="how-to-use">
    <div>
      <span class="section-label">Interview method</span>
      <h2 id="how-to-use">How to answer scenario questions well</h2>
      <p>Explain your sequence: protect the service, collect evidence, isolate the failure domain, make the smallest safe change, and verify the result. Strong answers show what you would check before restarting a service or changing a production configuration.</p>
    </div>
    <div class="method-grid">
      <article><b>1</b><h3>Confirm impact</h3><p>Define what is actually broken and who is affected.</p></article>
      <article><b>2</b><h3>Collect evidence</h3><p>Use logs, metrics, process state, network state, and recent changes.</p></article>
      <article><b>3</b><h3>Fix safely</h3><p>Choose the smallest change with a rollback path.</p></article>
      <article><b>4</b><h3>Verify</h3><p>Prove the service works and the failure does not immediately return.</p></article>
    </div>
  </section>

  <section class="qa-section" id="questions">
    <div class="container">
      <div class="section-heading">
        <div><span class="section-label">Scenario library</span><h2>Interview Questions by Technology</h2><p>Choose Linux, DevOps, Cloud, Kubernetes, Network, Security, Windows, or VMware, then search by symptom, command, or topic.</p></div>
      </div>

      <div class="domain-tabs" role="tablist" aria-label="Interview technology">
        {domains.map((domain, index) => <button type="button" class:list={{active:index===0}} data-domain={domain} aria-pressed={index===0 ? "true" : "false"}>{domain}<span>{scenarios.filter((item) => item.domain === domain).length}</span></button>)}
      </div>


      <div class="toolbar" role="search">
        <label class="search-box">
          <span aria-hidden="true">⌕</span>
          <input id="qa-search" type="search" placeholder="Search interview questions, symptoms, commands..." autocomplete="off" />
        </label>
        <select id="qa-category" aria-label="Filter by category">
          <option value="all">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>

      <div class="results-line"><span id="qa-count">{scenarios.length}</span> scenarios shown</div>

      <div class="qa-list" id="qa-list">
        {scenariosWithDisplay.map((item) => (
          <details class="qa-card" data-domain={item.domain} data-category={item.category} data-search={`${item.question} ${item.answer} ${item.commands.join(" ")} ${item.category}`.toLowerCase()}>
            <summary>
              <div class="q-number"><span class="q-index">{String(item.displayNumber).padStart(2, "0")}</span><span class="q-total">of {item.domainTotal}</span></div>
              <div class="q-copy"><div class="tags"><span class="domain-tag">{item.domain}</span><span>{item.category}</span><span class:list={{critical: item.level === "Critical"}}>{item.level}</span></div><h3>{item.question}</h3></div>
              <span class="chevron" aria-hidden="true">+</span>
            </summary>
            <div class="answer">
              <div class="answer-block"><h4>Recommended answer</h4><p>{item.answer}</p></div>
              <div class="command-block"><div class="command-title"><span>Useful commands</span><small>Adapt placeholders before use</small></div><pre><code>{item.commands.join("\n")}</code></pre></div>
              <div class="verify"><strong>Verification:</strong> {item.verify}</div>
            </div>
          </details>
        ))}
      </div>
      <p id="qa-empty" class="empty" hidden>No scenarios match your current search. Try a broader keyword or choose another category.</p>
    </div>
  </section>

  <section class="closing container">
    <div><span class="section-label">Interview tip</span><h2>Do not memorize only commands</h2><p>Interviewers usually care more about your troubleshooting order, risk awareness, and verification than a single command. Explain why each check matters and what result would make you take the next step.</p></div>
    <a class="primary" href="#questions">Practice Another Topic</a>
  </section>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("#qa-search");
  const categorySelect = document.querySelector<HTMLSelectElement>("#qa-category");
  const cards = [...document.querySelectorAll<HTMLElement>(".qa-card")];
  const domainButtons = [...document.querySelectorAll<HTMLButtonElement>(".domain-tabs button")];
  let activeDomain = "Linux";
  const count = document.querySelector<HTMLElement>("#qa-count");
  const empty = document.querySelector<HTMLElement>("#qa-empty");

  const applyFilters = () => {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    const category = categorySelect?.value ?? "all";
    let visible = 0;
    cards.forEach((card) => {
      const matchesText = !query || (card.dataset.search ?? "").includes(query);
      const matchesCategory = category === "all" || card.dataset.category === category;
      const matchesDomain = card.dataset.domain === activeDomain;
      const show = matchesText && matchesCategory && matchesDomain;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  };
  searchInput?.addEventListener("input", applyFilters);
  categorySelect?.addEventListener("change", applyFilters);
  domainButtons.forEach((button) => button.addEventListener("click", () => {
    activeDomain = button.dataset.domain ?? "Linux";
    domainButtons.forEach((item) => { const selected = item === button; item.classList.toggle("active", selected); item.setAttribute("aria-pressed", String(selected)); });
    if (categorySelect) categorySelect.value = "all";
    if (searchInput) searchInput.value = "";
    applyFilters();
  }));
  applyFilters();
</script>

<style>
  :global(:root){--qa-navy:#0f172a;--qa-blue:#2563eb;--qa-cyan:#38bdf8;--qa-border:#dbe4f0;--qa-muted:#5f6b7c;--qa-bg:#f6f9fd}
