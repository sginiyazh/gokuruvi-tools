er:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(8,15,29,.25)}.mini-grid b,.mini-grid small{display:block}.mini-grid small{margin-top:2px;color:#9fb2cc}.intro{padding:72px 0}.intro>div:first-child{max-width:800px}.intro h2,.section-heading h2,.closing h2{margin:8px 0 12px;color:#111827;font-size:clamp(1.8rem,3.2vw,2.65rem);line-height:1.12;letter-spacing:-.025em}.intro>div:first-child>p,.section-heading p,.closing p{color:var(--qa-muted);font-size:1.02rem;line-height:1.75}.method-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:34px}.method-grid article{padding:22px;border:1px solid var(--qa-border);border-radius:16px;background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.04)}.method-grid b{display:grid;width:34px;height:34px;place-items:center;border-radius:9px;background:#eaf2ff;color:var(--qa-blue)}.method-grid h3{margin:15px 0 6px;font-size:1rem}.method-grid p{margin:0;color:var(--qa-muted);font-size:.9rem;line-height:1.6}.qa-section{padding:70px 0 82px;background:var(--qa-bg);border-block:1px solid #e5edf6}.section-heading{max-width:800px}.domain-tabs{display:flex;gap:10px;overflow-x:auto;padding:4px 2px 12px;margin:28px 0 4px;scrollbar-width:thin}.domain-tabs button{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;min-height:44px;padding:0 14px;border:1px solid #cbd7e7;border-radius:11px;background:#fff;color:#334155;font-weight:800;cursor:pointer;transition:.18s ease}.domain-tabs button:hover{border-color:#8eb1ee;color:#1d4ed8}.domain-tabs button.active{border-color:#2563eb;background:#2563eb;color:#fff;box-shadow:0 8px 22px rgba(37,99,235,.18)}.domain-tabs button span{display:grid;place-items:center;min-width:23px;height:23px;padding:0 6px;border-radius:999px;background:#eef3f9;color:#526173;font-size:.72rem}.domain-tabs button.active span{background:rgba(255,255,255,.18);color:#fff}.domain-tag{background:#e8f1ff!important;color:#1d4ed8!important}.toolbar{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:12px;margin:30px 0 12px}.search-box{display:flex;align-items:center;gap:10px;min-height:52px;padding:0 16px;border:1px solid #cbd7e7;border-radius:12px;background:#fff}.search-box:focus-within{border-color:#7aa6f8;box-shadow:0 0 0 4px rgba(37,99,235,.09)}.search-box input{width:100%;border:0;outline:0;background:transparent;color:#172033}.toolbar select{min-height:52px;padding:0 14px;border:1px solid #cbd7e7;border-radius:12px;background:#fff;color:#172033}.results-line{margin:0 0 16px;color:#66758a;font-size:.9rem}.results-line span{font-weight:800;color:#172033}.qa-list{display:grid;gap:12px}.qa-card{border:1px solid #d9e3ef;border-radius:15px;background:#fff;box-shadow:0 6px 20px rgba(15,23,42,.035);overflow:hidden}.qa-card[hidden]{display:none}.qa-card summary{display:grid;grid-template-columns:56px 1fr 28px;gap:15px;align-items:center;padding:20px 22px;cursor:pointer;list-style:none}.qa-card summary::-webkit-details-marker{display:none}.q-number{display:flex;flex-direction:column;align-items:center;justify-content:center;width:56px;height:56px;border-radius:12px;background:#eff5ff}.q-index{color:var(--qa-blue);font-size:1.08rem;font-weight:900;line-height:1}.q-total{margin-top:2px;color:#7f93b3;font-size:.6rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:7px}.tags span{padding:3px 8px;border-radius:999px;background:#edf2f7;color:#536276;font-size:.68rem;font-weight:800;letter-spacing:.03em}.tags span.critical{background:#fff0ed;color:#b63a22}.q-copy h3{margin:0;color:#172033;font-size:1rem;line-height:1.48}.chevron{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#f2f6fb;color:#344256;font-size:1.2rem;transition:transform .2s}.qa-card[open] .chevron{transform:rotate(45deg)}.answer{padding:0 22px 22px 93px}.answer-block{padding-top:2px;border-top:1px solid #edf2f7}.answer h4{margin:18px 0 7px;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:#2563eb}.answer p{margin:0;color:#4c5b6f;line-height:1.75}.command-block{margin-top:18px;border-radius:12px;overflow:hidden;background:#0d1524;color:#dce8f7}.command-title{display:flex;justify-content:space-between;gap:15px;padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.08);color:#9fb3ca;font-size:.76rem}.command-title span{font-weight:800;color:#e7f2ff}.command-block pre{margin:0;padding:15px;overflow:auto;font:500 .84rem/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.verify{margin-top:15px;padding:13px 15px;border:1px solid #d9e8db;border-radius:10px;background:#f3fbf4;color:#3d5f43;font-size:.9rem;line-height:1.6}.empty{padding:28px;border:1px dashed #b8c7d8;border-radius:14px;text-align:center;color:#65758a;background:#fff}.closing{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:70px 0}.closing>div{max-width:800px}.closing .primary{flex-shrink:0}@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:35px}.hero-card{max-width:620px}.method-grid{grid-template-columns:1fr 1fr}.toolbar{grid-template-columns:1fr}.closing{align-items:flex-start;flex-direction:column}}@media(max-width:620px){.hero{padding:54px 0}.hero h1{font-size:2.45rem}.method-grid{grid-template-columns:1fr}.qa-card summary{grid-template-columns:46px 1fr 26px;padding:17px 14px;gap:10px}.q-number{width:46px;height:46px}.q-index{font-size:.92rem}.q-total{font-size:.52rem}.answer{padding:0 14px 18px}.answer-block{padding-top:4px}.command-title{flex-direction:column;gap:2px}.mini-grid{grid-template-columns:1fr 1fr}}
</style>
