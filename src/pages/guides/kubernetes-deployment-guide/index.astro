  .related-tools h2 { margin: 0 0 6px; }
  .related-tools p { margin: 0; }
  .related-tools ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
