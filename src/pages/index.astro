---
import Header from "../components/Header.astro";
import LogoReveal3D from "../components/LogoReveal3D.astro";
import Footer from "../components/Footer.astro";
import { tools, categoryMeta, toolCount } from "../data/tools";

// Rounded down to a multiple of 5, e.g. "100+".
const toolTotal = `${Math.floor(tools.length / 5) * 5}+`;
const guideTotal = 6;

const popularToolHrefs = [
  "/linux/chmod-calculator/",
  "/network/subnet-calculator/",
  "/linux/cron-generator/",
  "/devops/yaml-validator/",
  "/network/ssl-checker/",
  "/kubernetes/deployment-generator/",
  "/cloud/cloud-init-generator/",
  "/vmware/powercli-command-generator/",
];
const popularTools = popularToolHrefs
  .map((href) => tools.find((t) => t.href === href))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const quickToolbox = [
  { label: "chmod", href: "/linux/chmod-calculator/" },
  { label: "Cron", href: "/linux/cron-generator/" },
  { label: "Subnet", href: "/network/subnet-calculator/" },
  { label: "DNS", href: "/network/dns-checker/" },
  { label: "Port Check", href: "/network/port-checker/" },
  { label: "SSL", href: "/network/ssl-checker/" },
  { label: "Base64", href: "/devops/base64-encoder/" },
  { label: "JSON", href: "/devops/json-validator/" },
  { label: "YAML", href: "/devops/yaml-validator/" },
  { label: "JWT", href: "/devops/jwt-decoder/" },
  { label: "Hash", href: "/security/hash-generator/" },
  { label: "IP Lookup", href: "/network/what-is-my-ip/" },
];

const recentlyUpdatedTools = [
  {
    icon: "🖥️",
    title: "PowerCLI Command Generator",
    description: "Generate VMware PowerCLI commands for power operations, snapshots, vMotion and resource queries.",
    link: "/vmware/powercli-command-generator/",
    category: "VMware",
    status: "New",
    updatedDate: "August 21, 2026",
  },
  {
    icon: "📋",
    title: "AI Prompt Library",
    description: "40+ copy-paste prompts for the AI-assisted tasks developers and students do every day.",
    link: "/ai/prompt-library/",
    category: "AI",
    status: "New",
    updatedDate: "August 21, 2026",
  },
  {
    icon: "☁️",
    title: "Cloud-init Generator",
    description: "Generate cloud-init YAML configurations for Linux virtual machines, users, packages, SSH keys and startup commands.",
    link: "/cloud/cloud-init-generator/",
    category: "Cloud",
    status: "Updated",
    updatedDate: "July 31, 2026",
  },
  {
    icon: "🐳",
    title: "Docker Compose Validator",
    description: "Validate Docker Compose YAML and identify common syntax and configuration issues.",
    link: "/devops/docker-compose-validator/",
    category: "DevOps",
    status: "New",
    updatedDate: "July 30, 2026",
  },
];

const interviewDomains = [
  { name: "Linux", href: "/interview-qa/#questions" },
  { name: "Windows", href: "/interview-qa/#questions" },
  { name: "Network", href: "/interview-qa/#questions" },
  { name: "VMware", href: "/interview-qa/#questions" },
  { name: "Cloud", href: "/interview-qa/#questions" },
  { name: "DevOps", href: "/interview-qa/#questions" },
  { name: "Kubernetes", href: "/interview-qa/#questions" },
  { name: "Security", href: "/interview-qa/#questions" },
];

const guidePreviews = [
  {
    icon: "🐧",
    title: "The Linux Server Troubleshooting Guide",
    description: "A step-by-step method for diagnosing boot failures, high load, full disks, and unresponsive services.",
    link: "/guides/linux-server-troubleshooting/",
    readTime: "14 min read",
  },
  {
    icon: "☸️",
    title: "Kubernetes Deployment Guide: Zero to Production",
    description: "Take an application from a single Deployment manifest to a resilient, observable, autoscaling workload.",
    link: "/guides/kubernetes-deployment-guide/",
    readTime: "16 min read",
  },
  {
    icon: "🌐",
    title: "Networking & Subnetting Fundamentals",
    description: "Understand IP addressing, subnet masks, CIDR notation, and routing well enough to troubleshoot with confidence.",
    link: "/guides/networking-fundamentals/",
    readTime: "15 min read",
  },
  {
    icon: "🔒",
    title: "Linux Server Security Hardening Guide",
    description: "A practical hardening checklist covering SSH, users and sudo, the firewall, updates, and auditing.",
    link: "/guides/linux-security-hardening/",
    readTime: "14 min read",
  },
];

const benefits = [
  {
    icon: "⚡",
    title: "Fast & Simple",
    description: "No complicated workflow — open a tool and get your answer in seconds.",
  },
  {
    icon: "🔒",
    title: "Privacy Focused",
    description: "Your input is processed locally in your browser whenever a tool supports it.",
  },
  {
    icon: "💯",
    title: "Free to Use",
    description: "Every tool on this site is free, with no account required.",
  },
  {
    icon: "🧰",
    title: "Built for IT Professionals",
    description: "Practical utilities created for real administration, DevOps and engineering work.",
  },
];

const siteUrl = "https://www.gokuruvi.com/";
const pageTitle =
  "Free IT Tools for Engineers & Administrators | Gokuruvi";
const pageDescription =
  "Free Linux, Windows, Network, VMware, Cloud, DevOps, Kubernetes, Database, Security and AI tools plus scenario-based interview questions for IT professionals.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={pageDescription} />

    <meta
      name="keywords"
      content="IT tools, Linux tools, Windows tools, network tools, VMware tools, cloud tools, DevOps tools, Kubernetes tools, database tools, security tools, AI tools, interview questions"
    />

    <meta name="author" content="Gokuruvi Tools" />

    <meta name="robots" content="index, follow" />

    <meta name="theme-color" content="#0f172a" />

    <link rel="canonical" href={siteUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />

    <meta
      property="og:title"
      content="Free IT Tools for Engineers & Administrators"
    />

    <meta
      property="og:description"
      content={pageDescription}
    />

    <meta property="og:type" content="website" />

    <meta property="og:image:width" content="1200" />

    <meta property="og:image:height" content="630" />

    <meta property="og:url" content={siteUrl} />

    <meta
      property="og:image"
      content="https://www.gokuruvi.com/og-image.jpg"
    />

    <meta
      property="og:image:alt"
      content="Gokuruvi Tools — free IT tools for Linux, Windows, Network, VMware, Cloud, DevOps, Kubernetes, Database, Security and AI"
    />

    <meta
      property="og:site_name"
      content="Gokuruvi Tools"
    />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={pageTitle} />

    <meta
      name="twitter:description"
      content={pageDescription}
    />

    <meta
      name="twitter:image"
      content="https://www.gokuruvi.com/og-image.jpg"
    />

    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&display=swap"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: #eff6ff;
        --secondary: #38bdf8;
        --dark: #0f172a;
        --dark-light: #1e293b;
        --text: #172033;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success: #16a34a;
        --maximum-width: 1180px;

        font-family:
          Inter, Arial, Helvetica, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      body,
      button,
      input,
      textarea,
      select {
        font-family:
          Inter, Arial, Helvetica, sans-serif;
      }

      a {
        color: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      .container {
        width: min(100% - 40px, var(--maximum-width));
        margin-inline: auto;
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 9999;
        padding: 10px 16px;
        border-radius: 8px;
        background: #ffffff;
        color: var(--dark);
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.2);
        transform: translateY(-160%);
        transition: transform 0.2s ease;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.45);
        outline-offset: 4px;
        border-radius: 6px;
      }

      /* Hero */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 100px 0 60px;
        background:
          radial-gradient(
            circle at 20% 10%,
            rgba(56, 189, 248, 0.18),
            transparent 32%
          ),
          radial-gradient(
            circle at 90% 30%,
            rgba(37, 99, 235, 0.2),
            transparent 35%
          ),
          linear-gradient(
            145deg,
            #f8fafc 0%,
            #eff6ff 50%,
            #f8fafc 100%
          );
      }

      .hero::before {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background-image:
          linear-gradient(
            rgba(37, 99, 235, 0.04) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(37, 99, 235, 0.04) 1px,
            transparent 1px
          );
        background-size: 42px 42px;
        -webkit-mask-image: linear-gradient(
          to bottom,
          black,
          transparent
        );
        mask-image: linear-gradient(
          to bottom,
          black,
          transparent
        );
      }

      .hero-content {
        position: relative;
        max-width: 980px;
        margin: 0 auto;
        text-align: center;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
        padding: 8px 16px;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.82);
        color: var(--primary-dark);
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
      }

      .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.12);
      }

      .hero h1 {
        max-width: 980px;
        margin: 0 auto 24px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 64px);
        line-height: 1.1;
        letter-spacing: -2px;
      }

      .hero-description {
        max-width: 780px;
        margin: 0 auto;
        color: #475569;
        font-size: clamp(17px, 2.3vw, 20px);
        line-height: 1.75;
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 23px;
        border: 1px solid transparent;
        border-radius: 11px;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        background: var(--primary);
        color: #ffffff;
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.25);
      }

      .button-primary:hover {
        background: var(--primary-dark);
        box-shadow: 0 16px 35px rgba(37, 99, 235, 0.32);
      }

      .button-secondary {
        border-color: #cbd5e1;
        background: #ffffff;
        color: var(--dark);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
      }

      .button-secondary:hover {
        border-color: #94a3b8;
        background: #f8fafc;
      }

      .hero-features {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-top: 34px;
        color: #475569;
        font-size: 14px;
        font-weight: 600;
      }

      .hero-feature {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .check {
        color: var(--success);
        font-size: 17px;
      }

      /* Search */

      .search-section {
        padding: 44px 0 56px;
      }

      .search-wrap {
        position: relative;
        max-width: 720px;
        margin: 0 auto;
      }

      .search-box {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 62px;
        padding: 0 22px;
        border: 1px solid #cbd7e7;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .search-box:focus-within {
        border-color: #7aa6f8;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1), 0 14px 34px rgba(15, 23, 42, 0.07);
      }

      .search-icon {
        flex-shrink: 0;
        color: #94a3b8;
        font-size: 20px;
      }

      #tool-search-input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--dark);
        font-size: 17px;
      }

      #tool-search-input::placeholder {
        color: #94a3b8;
      }

      .search-clear {
        display: none;
        flex-shrink: 0;
        border: 0;
        background: #eef2f7;
        color: #64748b;
        border-radius: 8px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        font-size: 15px;
      }

      .search-clear.visible {
        display: block;
      }

      .search-results {
        position: absolute;
        z-index: 40;
        top: calc(100% + 10px);
        left: 0;
        right: 0;
        display: none;
        max-height: 420px;
        overflow-y: auto;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 24px 55px rgba(15, 23, 42, 0.16);
      }

      .search-results.open {
        display: block;
      }

      .search-result {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
      }

      .search-result:hover,
      .search-result:focus-visible {
        background: #f0f6ff;
      }

      .search-result-icon {
        display: grid;
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        place-items: center;
        border-radius: 10px;
        background: var(--primary-soft);
        font-size: 18px;
      }

      .search-result-title {
        display: block;
        color: var(--dark);
        font-weight: 750;
        font-size: 14.5px;
      }

      .search-result-category {
        display: block;
        margin-top: 2px;
        color: var(--primary);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }

      .search-empty {
        padding: 18px 14px;
        color: var(--muted);
        font-size: 14.5px;
        text-align: center;
      }

      .search-hint {
        margin-top: 14px;
        color: #94a3b8;
        font-size: 13.5px;
        text-align: center;
      }

      /* Sections */

      .section {
        padding: 80px 0;
      }

      .section-white {
        background: #ffffff;
      }

      .section-tint {
        background: #f8fafc;
      }

      .section-heading {
        max-width: 780px;
        margin: 0 auto 48px;
        text-align: center;
      }

      .section-label {
        display: inline-block;
        margin-bottom: 12px;
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.6px;
        text-transform: uppercase;
      }

      .section-heading h2 {
        margin: 0 0 16px;
        color: var(--dark);
        font-size: clamp(29px, 4vw, 40px);
        line-height: 1.2;
        letter-spacing: -1px;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 17.5px;
        line-height: 1.75;
      }

      .section-footer-link {
        display: flex;
        justify-content: center;
        margin-top: 40px;
      }

      .text-link {
        color: var(--primary);
        font-weight: 800;
        text-decoration: none;
        font-size: 15.5px;
      }

      .text-link:hover {
        text-decoration: underline;
      }

      /* Categories */

      .category-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px;
      }

      .category-card {
        position: relative;
        display: flex;
        min-height: 220px;
        flex-direction: column;
        overflow: hidden;
        padding: 26px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
        text-decoration: none;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .category-card::after {
        position: absolute;
        right: -40px;
        bottom: -55px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.07);
        content: "";
        transition: transform 0.3s ease;
      }

      .category-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 22px 45px rgba(37, 99, 235, 0.13);
        transform: translateY(-6px);
      }

      .category-card:hover::after {
        transform: scale(1.25);
      }

      .category-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .category-icon {
        display: grid;
        width: 50px;
        height: 50px;
        place-items: center;
        border-radius: 14px;
        background: var(--primary-soft);
        font-size: 25px;
      }

      .category-count {
        padding: 4px 10px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-size: 11.5px;
        font-weight: 800;
        white-space: nowrap;
      }

      .category-card h3 {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 19px;
      }

      .category-card p {
        flex: 1;
        margin: 0 0 18px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.65;
      }

      .category-link {
        position: relative;
        z-index: 1;
        color: var(--primary);
        font-size: 14px;
        font-weight: 800;
      }

      /* Featured tools */

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
      }

      .tool-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: var(--card);
        text-decoration: none;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.045);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .tool-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 18px 38px rgba(37, 99, 235, 0.11);
        transform: translateY(-5px);
      }

      .tool-icon {
        display: grid;
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        place-items: center;
        border-radius: 13px;
        background: linear-gradient(
          135deg,
          #eff6ff,
          #e0f2fe
        );
        font-size: 22px;
      }

      .tool-content {
        flex: 1;
        min-width: 0;
      }

      .tool-category {
        display: inline-flex;
        margin-bottom: 6px;
        color: var(--primary);
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
      }

      .tool-content h3 {
        margin: 0 0 7px;
        color: var(--dark);
        font-size: 16.5px;
        line-height: 1.35;
      }

      .tool-content p {
        margin: 0 0 13px;
        color: var(--muted);
        font-size: 13.5px;
        line-height: 1.6;
      }

      .open-tool {
        color: var(--primary);
        font-size: 14px;
        font-weight: 800;
      }

      /* Quick toolbox */

      .toolbox-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        max-width: 900px;
        margin: 0 auto;
      }

      .toolbox-chip {
        display: inline-flex;
        align-items: center;
        min-height: 46px;
        padding: 0 20px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: #ffffff;
        color: var(--dark);
        font-weight: 750;
        font-size: 14.5px;
        text-decoration: none;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
      }

      .toolbox-chip:hover {
        transform: translateY(-2px);
        border-color: var(--primary);
        background: var(--primary);
        color: #ffffff;
      }

      /* Recently updated tools */

      .updated-tools-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
      }

      .updated-tool-card {
        display: flex;
        min-height: 260px;
        padding: 24px;
        flex-direction: column;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .updated-tool-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 20px 42px rgba(37, 99, 235, 0.12);
        transform: translateY(-5px);
      }

      .updated-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 14px;
      }

      .update-badge {
        display: inline-flex;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 800;
      }

      .update-badge.new {
        border: 1px solid #86efac;
        background: #f0fdf4;
        color: #15803d;
      }

      .update-badge.updated {
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1d4ed8;
      }

      .updated-tool-card h3 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 18px;
        line-height: 1.3;
      }

      .updated-tool-card p {
        flex: 1;
        margin: 0;
        color: var(--muted);
        font-size: 13.5px;
        line-height: 1.65;
      }

      .updated-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 18px;
        padding-top: 15px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
      }

      .updated-card-footer strong {
        color: var(--primary);
        font-size: 13px;
      }

      /* Interview Q&A */

      .interview-box {
        position: relative;
        overflow: hidden;
        padding: 56px 40px;
        border-radius: 26px;
        background:
          radial-gradient(circle at 85% 15%, rgba(56, 189, 248, 0.2), transparent 30%),
          linear-gradient(135deg, #0b1220, #111d33 62%, #162a4f);
        color: #ffffff;
        text-align: center;
      }

      .interview-box h2 {
        max-width: 680px;
        margin: 0 auto 14px;
        font-size: clamp(28px, 4vw, 38px);
        line-height: 1.2;
      }

      .interview-box > p {
        max-width: 650px;
        margin: 0 auto 32px;
        color: #c8d5e7;
        font-size: 17px;
        line-height: 1.75;
      }

      .interview-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-bottom: 34px;
      }

      .interview-chip {
        padding: 9px 18px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
        color: #ffffff;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease;
      }

      .interview-chip:hover {
        border-color: #38bdf8;
        background: rgba(56, 189, 248, 0.16);
      }

      .interview-box .button-primary {
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.35);
      }

      /* Guides */

      .guides-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
      }

      .guide-card {
        display: flex;
        flex-direction: column;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: #ffffff;
        text-decoration: none;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.045);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .guide-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 18px 38px rgba(37, 99, 235, 0.11);
        transform: translateY(-5px);
      }

      .guide-icon {
        display: grid;
        width: 46px;
        height: 46px;
        place-items: center;
        margin-bottom: 16px;
        border-radius: 13px;
        background: var(--primary-soft);
        font-size: 22px;
      }

      .guide-card h3 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 16.5px;
        line-height: 1.35;
      }

      .guide-card p {
        flex: 1;
        margin: 0 0 14px;
        color: var(--muted);
        font-size: 13.5px;
        line-height: 1.6;
      }

      .guide-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
      }

      .guide-footer strong {
        color: var(--primary);
        font-size: 13px;
      }

      /* Benefits */

      .benefits-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
      }

      .benefit-card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .benefit-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
      }

      .benefit-icon {
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        margin-bottom: 18px;
        border-radius: 13px;
        background: var(--primary-soft);
        font-size: 23px;
      }

      .benefit-card h3 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 18px;
      }

      .benefit-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
        font-size: 14.5px;
      }

      /* CTA */

      .cta {
        padding: 0 0 90px;
      }

      .cta-box {
        position: relative;
        overflow: hidden;
        padding: 68px 35px;
        border-radius: 24px;
        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(56, 189, 248, 0.25),
            transparent 30%
          ),
          linear-gradient(
            135deg,
            #0f172a,
            #1e3a8a
          );
        color: #ffffff;
        text-align: center;
        box-shadow: 0 25px 60px rgba(15, 23, 42, 0.18);
      }

      .cta-box h2 {
        max-width: 720px;
        margin: 0 auto 15px;
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.2;
      }

      .cta-box p {
        max-width: 720px;
        margin: 0 auto 28px;
        color: #cbd5e1;
        font-size: 18px;
        line-height: 1.7;
      }

      .cta-button {
        background: #ffffff;
        color: var(--primary-dark);
      }

      .cta-button:hover {
        background: #eff6ff;
      }

      /* Responsive */

      @media (max-width: 1120px) {
        .category-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .tools-grid,
        .updated-tools-grid,
        .guides-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .benefits-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 820px) {
        .hero {
          padding: 70px 0 50px;
        }

        .hero h1 {
          letter-spacing: -1.2px;
        }

        .section {
          padding: 64px 0;
        }

        .category-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .interview-box {
          padding: 44px 24px;
        }
      }

      @media (max-width: 560px) {
        .container {
          width: min(100% - 28px, var(--maximum-width));
        }

        .hero h1 {
          font-size: 36px;
        }

        .hero-actions {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .hero-features {
          align-items: flex-start;
          flex-direction: column;
          gap: 12px;
        }

        .search-box {
          padding: 0 16px;
        }

        .category-grid,
        .tools-grid,
        .updated-tools-grid,
        .guides-grid,
        .benefits-grid {
          grid-template-columns: 1fr;
        }

        .category-card {
          min-height: auto;
          padding: 22px;
        }

        .tool-card {
          padding: 20px;
        }

        .cta-box {
          padding: 50px 23px;
        }

        .updated-card-footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      /* ===== New hero + bands (glass G design) ===== */
      .gx-hero {
        position: relative;
