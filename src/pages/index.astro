---
const tools = [
  {
    name: "Linux chmod Calculator",
    description: "Convert Linux read, write and execute permissions into numeric chmod values.",
    link: "/linux/chmod-calculator",
  },
  {
    name: "Cron Expression Generator",
    description: "Create Linux cron schedules with an easy visual generator.",
    link: "/linux/cron-generator",
  },
  {
    name: "systemd Service Generator",
    description: "Generate a basic systemd service unit for Linux applications.",
    link: "/linux/systemd-service-generator",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="Free Linux, DevOps, Cloud and Kubernetes tools for administrators and engineers."
    />
    <title>Gokuruvi Linux and DevOps Tools</title>

    <style>
      :root {
        font-family: Arial, Helvetica, sans-serif;
        color: #172033;
        background: #f6f8fc;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
      }

      header {
        background: #111827;
        color: white;
        padding: 18px 24px;
      }

      nav {
        max-width: 1100px;
        margin: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      nav a {
        color: white;
        text-decoration: none;
        margin-left: 18px;
      }

      main {
        max-width: 1100px;
        margin: auto;
        padding: 60px 24px;
      }

      .hero {
        text-align: center;
        padding: 50px 10px;
      }

      .hero h1 {
        font-size: 44px;
        margin-bottom: 15px;
      }

      .hero p {
        max-width: 720px;
        margin: auto;
        font-size: 19px;
        line-height: 1.6;
        color: #4b5563;
      }

      .tools {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 22px;
        margin-top: 40px;
      }

      .card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
      }

      .card h2 {
        margin-top: 0;
      }

      .card p {
        color: #4b5563;
        line-height: 1.6;
      }

      .card a {
        display: inline-block;
        margin-top: 10px;
        color: #1d4ed8;
        font-weight: bold;
        text-decoration: none;
      }

      footer {
        margin-top: 60px;
        padding: 30px;
        background: #111827;
        color: white;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <strong>Gokuruvi Tools</strong>

        <div>
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Linux and DevOps Tools</h1>

        <p>
          Free, fast and privacy-friendly utilities for Linux administrators,
          DevOps engineers, cloud professionals and Kubernetes users.
        </p>
      </section>

      <section class="tools">
        {
          tools.map((tool) => (
            <article class="card">
              <h2>{tool.name}</h2>
              <p>{tool.description}</p>
              <a href={tool.link}>Open tool →</a>
            </article>
          ))
        }
      </section>
    </main>

    <footer>
      © 2026 Gokuruvi Tools. All rights reserved.
    </footer>
  </body>
</html>