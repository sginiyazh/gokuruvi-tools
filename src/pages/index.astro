    <script>
      // Hero: pixel-mosaic glow at the edges (the 3D logo handles reduced motion itself).
      const gxHero = document.querySelector<HTMLElement>(".gx-hero");
      const gxCanvas = document.querySelector<HTMLCanvasElement>(".gx-pixels");

      function drawGxPixels() {
        if (!gxHero || !gxCanvas || getComputedStyle(gxCanvas).display === "none") return;
        const w = gxHero.clientWidth;
        const h = gxHero.clientHeight;
        const size = Math.max(28, Math.round(w / 34));
        gxCanvas.width = w;
        gxCanvas.height = h;
        const ctx = gxCanvas.getContext("2d");
        if (!ctx) return;
        let seed = 7;
        const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
        for (let px = 0; px < w; px += size) {
          for (let py = 0; py < h; py += size) {
            const edge = Math.max(1 - px / (w * 0.32), 1 - (w - px - size) / (w * 0.22), 0);
            const fall = Math.max(0, 1 - Math.abs(py / h - 0.45) * 1.6);
            const a = edge * fall * (0.25 + rnd() * 0.5);
            if (a < 0.03) continue;
            ctx.fillStyle = px < w / 2 ? `rgba(34,211,238,${a * 0.55})` : `rgba(59,130,246,${a * 0.6})`;
            ctx.fillRect(px, py, size - 1, size - 1);
          }
        }
      }

      drawGxPixels();
      let gxResize = 0;
      addEventListener("resize", () => {
        cancelAnimationFrame(gxResize);
        gxResize = requestAnimationFrame(drawGxPixels);
      });
    </script>


    <script>
      interface SearchTool {
        title: string;
        description: string;
        href: string;
        icon: string;
        category: string;
        keywords?: string[];
      }

      const searchInput = document.querySelector<HTMLInputElement>("#tool-search-input");
      const searchResults = document.querySelector<HTMLElement>("#tool-search-results");
      const searchClear = document.querySelector<HTMLButtonElement>("#tool-search-clear");
      const searchWrap = document.querySelector<HTMLElement>(".search-wrap");

      let allTools: SearchTool[] = [];

      async function loadToolIndex() {
        try {
          const response = await fetch("/tools-index.json");
          allTools = await response.json();
        } catch {
          allTools = [];
        }
      }

      function closeResults() {
        if (searchResults) {
          searchResults.classList.remove("open");
          searchResults.innerHTML = "";
        }
        searchInput?.setAttribute("aria-expanded", "false");
      }

      function renderResults(query: string) {
        if (!searchResults) return;
        const normalized = query.trim().toLowerCase();

        if (!normalized) {
          closeResults();
          return;
        }

        const matches = allTools
          .filter((tool) => {
            const haystack = [tool.title, tool.description, tool.category, ...(tool.keywords ?? [])]
              .join(" ")
              .toLowerCase();
            return haystack.includes(normalized);
          })
          .slice(0, 8);

        if (matches.length === 0) {
          searchResults.innerHTML = `<div class="search-empty">No tools found for "${query}". Try a different keyword.</div>`;
        } else {
          searchResults.innerHTML = matches
            .map(
              (tool) => `
                <a class="search-result" href="${tool.href}" role="option">
                  <span class="search-result-icon" aria-hidden="true">${tool.icon}</span>
                  <span>
                    <span class="search-result-title">${tool.title}</span>
                    <span class="search-result-category">${tool.category}</span>
                  </span>
                </a>`,
            )
            .join("");
        }

        searchResults.classList.add("open");
        searchInput?.setAttribute("aria-expanded", "true");
      }

      loadToolIndex().then(() => {
        searchInput?.addEventListener("input", () => {
          const value = searchInput.value;
          searchClear?.classList.toggle("visible", value.length > 0);
          renderResults(value);
        });

        searchInput?.addEventListener("focus", () => {
          if (searchInput.value.trim()) renderResults(searchInput.value);
        });
      });

      searchClear?.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }
        searchClear.classList.remove("visible");
        closeResults();
      });

      document.addEventListener("click", (event) => {
        if (searchWrap && !searchWrap.contains(event.target as Node)) {
          closeResults();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeResults();
        }
      });
    </script>
