    <Header />

    <main id="main-content">
      <section class="gx-hero" aria-labelledby="gx-title">
        <div class="gx-bg" aria-hidden="true">
          <canvas class="gx-pixels"></canvas>
          <div class="gx-logo3d"><LogoReveal3D variant="hero" /></div>
        </div>

        <div class="container gx-inner">
          <h1 id="gx-title" class="gx-eyebrow">
            Free IT tools for engineers &amp; administrators
          </h1>

          <p class="gx-headline" aria-hidden="true">
            <span class="gx-row">Fix it</span>
            <span class="gx-row">
              <span class="gx-chips">
                <span class="gx-chip gx-chip-a">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-5-6-5"></path><path d="M12 19h8"></path></svg>
                </span>
                <span class="gx-chip gx-chip-b">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"></path></svg>
                </span>
              </span>
              Faster.
            </span>
          </p>

          <p class="gx-lead">
            Practical tools for Linux, Windows, Network, VMware, Cloud, DevOps,
            Kubernetes, Database, Security and AI. Free, no sign-up, and
            everything runs in your browser.
          </p>

          <div class="search-wrap gx-search">
