---
const pageTitle = "Kubernetes Secret Generator | Gokuruvi Tools";
const description =
  "Generate Kubernetes Secret YAML for generic credentials, basic authentication, Docker registries, TLS certificates, and SSH private keys.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link
      rel="canonical"
      href="https://www.gokuruvi.com/kubernetes/secret-generator"
    />
    <title>{pageTitle}</title>

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --danger: #b91c1c;
        --success: #166534;
        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1200px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 56px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(34px, 6vw, 54px);
      }

      .hero p {
        max-width: 850px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 48px 20px 80px;
      }

      .tool-layout {
        display: grid;
        width: min(100%, 1200px);
        margin: 0 auto;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
      }

      .card-description {
        margin: 0 0 22px;
        color: var(--muted);
      }

      .section-title {
        margin: 28px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--dark);
        font-size: 18px;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .form-group {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin-bottom: 7px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      textarea {
        min-height: 130px;
        resize: vertical;
        font-family: Consolas, "Courier New", monospace;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      .checkbox-item {
        display: flex;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: 18px;
        height: 18px;
        margin: 0;
      }

      .checkbox-item label {
        margin: 0;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .conditional-section {
        display: none;
      }

      .conditional-section.active {
        display: block;
      }

      .preset-buttons,
      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .preset {
        padding: 8px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        margin-top: 24px;
      }

      .button {
        min-height: 44px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .danger-button {
        border: 1px solid #fecaca;
        background: #ffffff;
        color: var(--danger);
      }

      .message {
        display: none;
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: var(--danger);
      }

      .message.success {
        display: block;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: var(--success);
      }

      .yaml-box {
        margin-top: 18px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
      }

      .yaml-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .yaml-output {
        min-height: 560px;
        margin: 0;
        overflow: auto;
        color: #e2e8f0;
        white-space: pre;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.65;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        margin-top: 5px;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 800;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        width: min(100%, 1200px);
        margin: 30px auto 0;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 920px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .result-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 21px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a class="active" href="/kubernetes">Kubernetes</a>
          <a href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Kubernetes Secret Generator</h1>
        <p>
          Generate Kubernetes Secret YAML locally for generic credentials,
          Docker registries, TLS certificates, basic authentication, and SSH
          private keys.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Secret Configuration</h2>
            <p class="card-description">
              Secret values are processed locally in your browser.
            </p>

            <div class="preset-buttons">
              <button class="preset" type="button" data-preset="generic">
                Generic
              </button>
              <button class="preset" type="button" data-preset="basic">
                Basic Auth
              </button>
              <button class="preset" type="button" data-preset="docker">
                Docker Registry
              </button>
              <button class="preset" type="button" data-preset="tls">
                TLS
              </button>
              <button class="preset" type="button" data-preset="ssh">
                SSH Key
              </button>
            </div>

            <h3 class="section-title">Basic Settings</h3>

            <div class="input-row">
              <div class="form-group">
                <label for="secretNameInput">Secret name</label>
                <input
                  id="secretNameInput"
                  type="text"
                  value="app-secret"
                  maxlength="253"
                />
              </div>

              <div class="form-group">
                <label for="namespaceInput">Namespace</label>
                <input
                  id="namespaceInput"
                  type="text"
                  value="default"
                  maxlength="63"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="secretTypeSelect">Secret type</label>
              <select id="secretTypeSelect">
                <option value="Opaque" selected>Generic / Opaque</option>
                <option value="kubernetes.io/basic-auth">
                  Basic Authentication
                </option>
                <option value="kubernetes.io/dockerconfigjson">
                  Docker Registry
                </option>
                <option value="kubernetes.io/tls">TLS Certificate</option>
                <option value="kubernetes.io/ssh-auth">
                  SSH Authentication
                </option>
              </select>
            </div>

            <div class="checkbox-item">
              <input id="immutableInput" type="checkbox" />
              <label for="immutableInput">Make this Secret immutable</label>
            </div>

            <div id="genericSection" class="conditional-section active">
              <h3 class="section-title">Generic Secret Data</h3>

              <div class="form-group">
                <label for="genericDataInput">Secret values</label>
                <textarea id="genericDataInput">username=admin
password=ChangeMe123!
api-key=example-api-key</textarea>
                <p class="help-text">
                  Enter one key=value pair per line.
                </p>
              </div>
            </div>

            <div id="basicAuthSection" class="conditional-section">
              <h3 class="section-title">Basic Authentication</h3>

              <div class="input-row">
                <div class="form-group">
                  <label for="basicUsernameInput">Username</label>
                  <input id="basicUsernameInput" type="text" value="admin" />
                </div>

                <div class="form-group">
                  <label for="basicPasswordInput">Password</label>
                  <input
                    id="basicPasswordInput"
                    type="password"
                    value="ChangeMe123!"
                  />
                </div>
              </div>
            </div>

            <div id="dockerSection" class="conditional-section">
              <h3 class="section-title">Docker Registry Credentials</h3>

              <div class="form-group">
                <label for="dockerServerInput">Registry server</label>
                <input
                  id="dockerServerInput"
                  type="text"
                  value="https://index.docker.io/v1/"
                />
              </div>

              <div class="input-row">
                <div class="form-group">
                  <label for="dockerUsernameInput">Username</label>
                  <input
                    id="dockerUsernameInput"
                    type="text"
                    value="docker-user"
                  />
                </div>

                <div class="form-group">
                  <label for="dockerPasswordInput">Password or token</label>
                  <input
                    id="dockerPasswordInput"
                    type="password"
                    value="registry-token"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="dockerEmailInput">Email</label>
                <input
                  id="dockerEmailInput"
                  type="email"
                  value="admin@example.com"
                />
              </div>
            </div>

            <div id="tlsSection" class="conditional-section">
              <h3 class="section-title">TLS Certificate</h3>

              <div class="form-group">
                <label for="tlsCertificateInput">Certificate</label>
                <textarea
                  id="tlsCertificateInput"
                  placeholder="-----BEGIN CERTIFICATE-----"
                ></textarea>
              </div>

              <div class="form-group">
                <label for="tlsPrivateKeyInput">Private key</label>
                <textarea
                  id="tlsPrivateKeyInput"
                  placeholder="-----BEGIN PRIVATE KEY-----"
                ></textarea>
              </div>
            </div>

            <div id="sshSection" class="conditional-section">
              <h3 class="section-title">SSH Private Key</h3>

              <div class="form-group">
                <label for="sshPrivateKeyInput">Private key</label>
                <textarea
                  id="sshPrivateKeyInput"
                  placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
                ></textarea>
              </div>
            </div>

            <h3 class="section-title">Labels and Annotations</h3>

            <div class="form-group">
              <label for="labelsInput">Labels</label>
              <textarea
                id="labelsInput"
                placeholder="app=my-application&#10;environment=production"
              ></textarea>
            </div>

            <div class="form-group">
              <label for="annotationsInput">Annotations</label>
              <textarea
                id="annotationsInput"
                placeholder="owner=platform-team&#10;description=Application credentials"
              ></textarea>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Secret
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>

              <button
                id="clearValuesButton"
                class="button danger-button"
                type="button"
              >
                Clear Sensitive Values
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Generated secret.yaml</h2>
            <p class="card-description">
              Review the manifest carefully before applying it.
            </p>

            <div class="yaml-box">
              <span class="yaml-label">Kubernetes Secret YAML</span>
              <pre id="yamlOutput" class="yaml-output"></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy YAML
              </button>

              <button
                id="downloadButton"
                class="button secondary-button"
                type="button"
              >
                Download YAML
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Secret</span>
                <span id="resultName" class="result-value">app-secret</span>
              </div>

              <div class="result-item">
                <span class="result-label">Namespace</span>
                <span id="resultNamespace" class="result-value">default</span>
              </div>

              <div class="result-item full">
                <span class="result-label">Secret type</span>
                <span id="resultType" class="result-value">Opaque</span>
              </div>
            </div>

            <div class="warning">
              Base64 encoding is not encryption. Do not commit generated Secret
              YAML to a public or unprotected repository.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Apply and Verify</h2>

          <table class="reference-table">
            <tbody>
              <tr>
                <th>Validate YAML</th>
                <td>
                  <code>kubectl apply --dry-run=client -f app-secret.yaml</code>
                </td>
              </tr>
              <tr>
                <th>Apply Secret</th>
                <td><code>kubectl apply -f app-secret.yaml</code></td>
              </tr>
              <tr>
                <th>List Secrets</th>
                <td><code>kubectl get secret -n default</code></td>
              </tr>
              <tr>
                <th>Describe Secret</th>
                <td>
                  <code>kubectl describe secret app-secret -n default</code>
                </td>
              </tr>
              <tr>
                <th>Decode a value</th>
                <td>
                  <code>
                    kubectl get secret app-secret -n default -o
                    jsonpath="&#123;.data.password&#125;" | base64 -d
                  </code>
                </td>
              </tr>
            </tbody>
          </table>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var fields = {
          secretName: document.getElementById("secretNameInput"),
          namespace: document.getElementById("namespaceInput"),
          secretType: document.getElementById("secretTypeSelect"),
          immutable: document.getElementById("immutableInput"),
          genericData: document.getElementById("genericDataInput"),
          basicUsername: document.getElementById("basicUsernameInput"),
          basicPassword: document.getElementById("basicPasswordInput"),
          dockerServer: document.getElementById("dockerServerInput"),
          dockerUsername: document.getElementById("dockerUsernameInput"),
          dockerPassword: document.getElementById("dockerPasswordInput"),
          dockerEmail: document.getElementById("dockerEmailInput"),
          tlsCertificate: document.getElementById("tlsCertificateInput"),
          tlsPrivateKey: document.getElementById("tlsPrivateKeyInput"),
          sshPrivateKey: document.getElementById("sshPrivateKeyInput"),
          labels: document.getElementById("labelsInput"),
          annotations: document.getElementById("annotationsInput")
        };

        var sections = {
          generic: document.getElementById("genericSection"),
          basic: document.getElementById("basicAuthSection"),
          docker: document.getElementById("dockerSection"),
          tls: document.getElementById("tlsSection"),
          ssh: document.getElementById("sshSection")
        };

        var yamlOutput = document.getElementById("yamlOutput");
        var message = document.getElementById("message");
        var copyButton = document.getElementById("copyButton");
        var downloadButton = document.getElementById("downloadButton");
        var currentYaml = "";

        function showMessage(text, type) {
          message.textContent = text;
          message.className = "message " + type;
        }

        function clearMessage() {
          message.textContent = "";
          message.className = "message";
        }

        function isValidResourceName(value) {
          return (
            value.length >= 1 &&
            value.length <= 253 &&
            /^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$/.test(value)
          );
        }

        function isValidNamespace(value) {
          return (
            value.length >= 1 &&
            value.length <= 63 &&
            /^[a-z0-9]([-a-z0-9]*[a-z0-9])?$/.test(value)
          );
        }

        function isValidDataKey(value) {
          return /^[A-Za-z0-9._-]+$/.test(value);
        }

        function isValidMetadataKey(value) {
          return (
            value.length > 0 &&
            value.length <= 253 &&
            /^[A-Za-z0-9]([A-Za-z0-9._/-]*[A-Za-z0-9])?$/.test(value)
          );
        }

        function utf8ToBase64(value) {
          var bytes = new TextEncoder().encode(String(value));
          var binary = "";
          var index;

          for (index = 0; index < bytes.length; index += 1) {
            binary += String.fromCharCode(bytes[index]);
          }

          return window.btoa(binary);
        }

        function quoteYaml(value) {
          return (
            '"' +
            String(value)
              .replace(/\\/g, "\\\\")
              .replace(/"/g, '\\"')
              .replace(/\r/g, "\\r")
              .replace(/\n/g, "\\n")
              .replace(/\t/g, "\\t") +
            '"'
          );
        }

        function parseKeyValueLines(value, validator) {
          var values = {};
          var invalidLines = [];
          var lines = String(value).split(/\r?\n/);

          lines.forEach(function (originalLine) {
            var separatorIndex;
            var key;
            var itemValue;

            if (!originalLine.trim()) {
              return;
            }

            separatorIndex = originalLine.indexOf("=");

            if (separatorIndex <= 0) {
              invalidLines.push(originalLine);
              return;
            }

            key = originalLine.slice(0, separatorIndex).trim();
            itemValue = originalLine.slice(separatorIndex + 1);

            if (!validator(key)) {
              invalidLines.push(originalLine);
              return;
            }

            values[key] = itemValue;
          });

          return {
            values: values,
            invalidLines: invalidLines
          };
        }

        function parseSecretData() {
          return parseKeyValueLines(fields.genericData.value, isValidDataKey);
        }

        function parseMetadata(value) {
          return parseKeyValueLines(value, isValidMetadataKey);
        }

        function getSecretData() {
          var type = fields.secretType.value;
          var result = {};
          var server;
          var username;
          var password;
          var email;
          var credentials;
          var auths;

          if (type === "Opaque") {
            return parseSecretData().values;
          }

          if (type === "kubernetes.io/basic-auth") {
            result.username = fields.basicUsername.value;
            result.password = fields.basicPassword.value;
            return result;
          }

          if (type === "kubernetes.io/dockerconfigjson") {
            server = fields.dockerServer.value.trim();
            username = fields.dockerUsername.value;
            password = fields.dockerPassword.value;
            email = fields.dockerEmail.value.trim();

            credentials = {
              username: username,
              password: password,
              auth: utf8ToBase64(username + ":" + password)
            };

            if (email) {
              credentials.email = email;
            }

            auths = {};
            auths[server] = credentials;

            result[".dockerconfigjson"] = JSON.stringify({
              auths: auths
            });

            return result;
          }

          if (type === "kubernetes.io/tls") {
            result["tls.crt"] = fields.tlsCertificate.value.trim();
            result["tls.key"] = fields.tlsPrivateKey.value.trim();
            return result;
          }

          if (type === "kubernetes.io/ssh-auth") {
            result["ssh-privatekey"] = fields.sshPrivateKey.value.trim();
            return result;
          }

          return result;
        }

        function validateForm() {
          var secretName = fields.secretName.value.trim();
          var namespace = fields.namespace.value.trim();
          var type = fields.secretType.value;
          var labels = parseMetadata(fields.labels.value);
          var annotations = parseMetadata(fields.annotations.value);
          var parsed;
          var certificate;
          var privateKey;

          if (!isValidResourceName(secretName)) {
            return "Secret name must contain lowercase letters, numbers, dots, or hyphens.";
          }

          if (!isValidNamespace(namespace)) {
            return "Namespace must contain lowercase letters, numbers, or hyphens.";
          }

          if (labels.invalidLines.length > 0) {
            return "Invalid label: " + labels.invalidLines[0] + ". Use key=value format.";
          }

          if (annotations.invalidLines.length > 0) {
            return "Invalid annotation: " + annotations.invalidLines[0] + ". Use key=value format.";
          }

          if (type === "Opaque") {
            parsed = parseSecretData();

            if (parsed.invalidLines.length > 0) {
              return "Invalid Secret entry: " + parsed.invalidLines[0] + ". Use key=value format.";
            }

            if (Object.keys(parsed.values).length === 0) {
              return "Enter at least one Secret value.";
            }
          }

          if (type === "kubernetes.io/basic-auth") {
            if (!fields.basicUsername.value.trim()) {
              return "Username is required.";
            }

            if (!fields.basicPassword.value) {
              return "Password is required.";
            }
          }

          if (type === "kubernetes.io/dockerconfigjson") {
            if (!fields.dockerServer.value.trim()) {
              return "Registry server is required.";
            }

            if (!fields.dockerUsername.value.trim()) {
              return "Registry username is required.";
            }

            if (!fields.dockerPassword.value) {
              return "Registry password or token is required.";
            }
          }

          if (type === "kubernetes.io/tls") {
            certificate = fields.tlsCertificate.value.trim();
            privateKey = fields.tlsPrivateKey.value.trim();

            if (
              certificate.indexOf("-----BEGIN CERTIFICATE-----") === -1 ||
              certificate.indexOf("-----END CERTIFICATE-----") === -1
            ) {
              return "Enter a valid PEM certificate.";
            }

            if (
              privateKey.indexOf("PRIVATE KEY-----") === -1 ||
              privateKey.indexOf("-----END") === -1
            ) {
              return "Enter a valid PEM private key.";
            }
          }

          if (type === "kubernetes.io/ssh-auth") {
            privateKey = fields.sshPrivateKey.value.trim();

            if (privateKey.indexOf("PRIVATE KEY-----") === -1) {
              return "Enter a valid SSH private key.";
            }
          }

          return "";
        }

        function addMetadataSection(lines, sectionName, values) {
          var entries = Object.entries(values);

          if (entries.length === 0) {
            return;
          }

          lines.push("  " + sectionName + ":");

          entries.forEach(function (entry) {
            lines.push("    " + entry[0] + ": " + quoteYaml(entry[1]));
          });
        }

        function generateYaml(showError) {
          var validationError = validateForm();
          var secretName;
          var namespace;
          var type;
          var labels;
          var annotations;
          var secretData;
          var lines;

          clearMessage();

          if (validationError) {
            currentYaml = "";
            yamlOutput.textContent = validationError;

            if (showError) {
              showMessage(validationError, "error");
            }

            return;
          }

          secretName = fields.secretName.value.trim();
          namespace = fields.namespace.value.trim();
          type = fields.secretType.value;
          labels = parseMetadata(fields.labels.value).values;
          annotations = parseMetadata(fields.annotations.value).values;
          secretData = getSecretData();

          lines = [
            "apiVersion: v1",
            "kind: Secret",
            "metadata:",
            "  name: " + secretName,
            "  namespace: " + namespace
          ];

          addMetadataSection(lines, "labels", labels);
          addMetadataSection(lines, "annotations", annotations);

          lines.push("type: " + type);

          if (fields.immutable.checked) {
            lines.push("immutable: true");
          }

          lines.push("data:");

          Object.keys(secretData).forEach(function (key) {
            lines.push("  " + key + ": " + utf8ToBase64(secretData[key]));
          });

          currentYaml = lines.join("\n") + "\n";
          yamlOutput.textContent = currentYaml;

          document.getElementById("resultName").textContent = secretName;
          document.getElementById("resultNamespace").textContent = namespace;
          document.getElementById("resultType").textContent = type;
        }

        function updateSections() {
          var type = fields.secretType.value;

          Object.keys(sections).forEach(function (key) {
            sections[key].classList.remove("active");
          });

          if (type === "Opaque") {
            sections.generic.classList.add("active");
          } else if (type === "kubernetes.io/basic-auth") {
            sections.basic.classList.add("active");
          } else if (type === "kubernetes.io/dockerconfigjson") {
            sections.docker.classList.add("active");
          } else if (type === "kubernetes.io/tls") {
            sections.tls.classList.add("active");
          } else if (type === "kubernetes.io/ssh-auth") {
            sections.ssh.classList.add("active");
          }

          generateYaml(false);
        }

        function applyPreset(preset) {
          if (preset === "generic") {
            fields.secretType.value = "Opaque";
            fields.secretName.value = "app-secret";
            fields.genericData.value =
              "username=admin\npassword=ChangeMe123!\napi-key=example-api-key";
          } else if (preset === "basic") {
            fields.secretType.value = "kubernetes.io/basic-auth";
            fields.secretName.value = "basic-auth-secret";
            fields.basicUsername.value = "admin";
            fields.basicPassword.value = "ChangeMe123!";
          } else if (preset === "docker") {
            fields.secretType.value = "kubernetes.io/dockerconfigjson";
            fields.secretName.value = "registry-secret";
            fields.dockerServer.value = "https://index.docker.io/v1/";
            fields.dockerUsername.value = "docker-user";
            fields.dockerPassword.value = "registry-token";
            fields.dockerEmail.value = "admin@example.com";
          } else if (preset === "tls") {
            fields.secretType.value = "kubernetes.io/tls";
            fields.secretName.value = "application-tls";
            fields.tlsCertificate.value = "";
            fields.tlsPrivateKey.value = "";
          } else if (preset === "ssh") {
            fields.secretType.value = "kubernetes.io/ssh-auth";
            fields.secretName.value = "ssh-private-key";
            fields.sshPrivateKey.value = "";
          }

          updateSections();
        }

        function resetGenerator() {
          fields.secretName.value = "app-secret";
          fields.namespace.value = "default";
          fields.secretType.value = "Opaque";
          fields.immutable.checked = false;
          fields.genericData.value =
            "username=admin\npassword=ChangeMe123!\napi-key=example-api-key";
          fields.basicUsername.value = "admin";
          fields.basicPassword.value = "ChangeMe123!";
          fields.dockerServer.value = "https://index.docker.io/v1/";
          fields.dockerUsername.value = "docker-user";
          fields.dockerPassword.value = "registry-token";
          fields.dockerEmail.value = "admin@example.com";
          fields.tlsCertificate.value = "";
          fields.tlsPrivateKey.value = "";
          fields.sshPrivateKey.value = "";
          fields.labels.value = "";
          fields.annotations.value = "";

          updateSections();
          fields.secretName.focus();
        }

        function clearSensitiveValues() {
          fields.genericData.value = "";
          fields.basicPassword.value = "";
          fields.dockerPassword.value = "";
          fields.tlsCertificate.value = "";
          fields.tlsPrivateKey.value = "";
          fields.sshPrivateKey.value = "";

          currentYaml = "";
          yamlOutput.textContent =
            "Sensitive values and generated YAML were cleared.";

          showMessage(
            "Sensitive values and generated YAML were cleared.",
            "success"
          );
        }

        function copyYaml() {
          if (!currentYaml) {
            showMessage("Generate valid Secret YAML before copying.", "error");
            return;
          }

          navigator.clipboard
            .writeText(currentYaml)
            .then(function () {
              var originalText = copyButton.textContent;
              copyButton.textContent = "Copied!";
              showMessage("Secret YAML copied successfully.", "success");

              window.setTimeout(function () {
                copyButton.textContent = originalText;
              }, 1500);
            })
            .catch(function () {
              showMessage(
                "Clipboard access failed. Copy the YAML manually.",
                "error"
              );
            });
        }

        function downloadYaml() {
          var secretName;
          var blob;
          var url;
          var anchor;

          if (!currentYaml) {
            showMessage(
              "Generate valid Secret YAML before downloading.",
              "error"
            );
            return;
          }

          secretName = fields.secretName.value.trim() || "secret";
          blob = new Blob([currentYaml], {
            type: "application/yaml;charset=utf-8"
          });
          url = URL.createObjectURL(blob);
          anchor = document.createElement("a");

          anchor.href = url;
          anchor.download = secretName + ".yaml";

          document.body.appendChild(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);

          showMessage("Secret YAML downloaded successfully.", "success");
        }

        document
          .getElementById("generateButton")
          .addEventListener("click", function () {
            generateYaml(true);
          });

        document
          .getElementById("resetButton")
          .addEventListener("click", resetGenerator);

        document
          .getElementById("clearValuesButton")
          .addEventListener("click", clearSensitiveValues);

        copyButton.addEventListener("click", copyYaml);
        downloadButton.addEventListener("click", downloadYaml);
        fields.secretType.addEventListener("change", updateSections);

        Object.keys(fields).forEach(function (key) {
          var field = fields[key];

          if (key === "secretType") {
            return;
          }

          field.addEventListener("input", function () {
            generateYaml(false);
          });

          field.addEventListener("change", function () {
            generateYaml(false);
          });
        });

        document.querySelectorAll(".preset").forEach(function (button) {
          button.addEventListener("click", function () {
            applyPreset(button.getAttribute("data-preset") || "");
          });
        });

        updateSections();
      });
    </script>
  </body>
</html>
