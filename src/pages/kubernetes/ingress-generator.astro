---
const pageTitle =
  "Kubernetes Ingress Generator | Gokuruvi Tools";

const description =
  "Generate Kubernetes Ingress YAML with host rules, paths, services, TLS, ingress classes, annotations and SSL redirect options.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/kubernetes/ingress-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1200px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(
          135deg,
          #eff6ff,
          #f8fafc
        );
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(36px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 860px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 50px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1200px;
        margin: 0 auto;
        grid-template-columns:
          minmax(0, 0.95fr)
          minmax(0, 1.05fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow:
          0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .section-title {
        margin: 28px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--dark);
        font-size: 18px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .input-row {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .input-row.three {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      textarea {
        min-height: 100px;
        resize: vertical;
        font-family:
          Consolas, "Courier New", monospace;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow:
          0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled,
      textarea:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .conditional-section {
        display: none;
        margin-top: 14px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .conditional-section.active {
        display: block;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
      }

      .preset {
        padding: 8px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .path-card {
        margin-bottom: 14px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .path-header {
        display: flex;
        margin-bottom: 14px;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .path-title {
        color: var(--dark);
        font-weight: 800;
      }

      .remove-path-button {
        padding: 6px 10px;
        border: 1px solid #fecaca;
        border-radius: 7px;
        background: #ffffff;
        color: #b91c1c;
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
      }

      .remove-path-button:hover {
        background: #fef2f2;
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .yaml-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
      }

      .yaml-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .yaml-output {
        min-height: 620px;
        margin: 0;
        overflow: auto;
        color: #e2e8f0;
        white-space: pre;
        font-family:
          Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.65;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family:
          Consolas, "Courier New", monospace;
        font-weight: 800;
      }

      .summary-box {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--info-border);
        border-radius: 11px;
        background: var(--info-bg);
      }

      .summary-box h3 {
        margin: 0 0 10px;
        color: var(--info-text);
        font-size: 17px;
      }

      .summary-list {
        margin: 0;
        padding-left: 20px;
        color: var(--info-text);
      }

      .summary-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1200px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family:
          Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 920px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .input-row.three,
        .checkbox-grid,
        .result-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">
          Gokuruvi Tools
        </a>

        <nav
          class="navigation"
          aria-label="Main navigation"
        >
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>

          <a
            class="active"
            href="/kubernetes"
          >
            Kubernetes
          </a>

          <a href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Kubernetes Ingress Generator</h1>

        <p>
          Generate Kubernetes Ingress YAML with
          host-based routing, multiple paths, TLS,
          ingress classes, SSL redirects, annotations,
          rewrite rules and backend services.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Ingress Configuration</h2>

            <p class="card-description">
              Configure your hostname, backend services,
              paths, TLS certificate and ingress controller
              settings.
            </p>

            <div class="preset-buttons">
              <button
                type="button"
                class="preset"
                data-preset="nginx"
              >
                NGINX Ingress
              </button>

              <button
                type="button"
                class="preset"
                data-preset="traefik"
              >
                Traefik
              </button>

              <button
                type="button"
                class="preset"
                data-preset="https"
              >
                HTTPS Ingress
              </button>

              <button
                type="button"
                class="preset"
                data-preset="api"
              >
                API Routing
              </button>
            </div>

            <h3 class="section-title">
              Basic Settings
            </h3>

            <div class="input-row">
              <div class="form-group">
                <label for="ingressNameInput">
                  Ingress name
                </label>

                <input
                  id="ingressNameInput"
                  type="text"
                  value="nginx-ingress"
                  maxlength="63"
                  placeholder="Example: nginx-ingress"
                />
              </div>

              <div class="form-group">
                <label for="namespaceInput">
                  Namespace
                </label>

                <input
                  id="namespaceInput"
                  type="text"
                  value="default"
                  maxlength="63"
                  placeholder="Example: default"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="ingressClassInput">
                  Ingress class name
                </label>

                <input
                  id="ingressClassInput"
                  type="text"
                  value="nginx"
                  placeholder="Example: nginx"
                />
              </div>

              <div class="form-group">
                <label for="hostInput">
                  Hostname
                </label>

                <input
                  id="hostInput"
                  type="text"
                  value="app.example.com"
                  placeholder="Example: app.example.com"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>
            </div>

            <h3 class="section-title">
              Routing Paths
            </h3>

            <div id="pathsContainer"></div>

            <button
              id="addPathButton"
              type="button"
              class="button secondary-button"
            >
              Add Another Path
            </button>

            <h3 class="section-title">
              TLS and HTTPS
            </h3>

            <div class="checkbox-grid">
              <div class="checkbox-item">
                <input
                  id="tlsEnabledInput"
                  type="checkbox"
                  checked
                />

                <label for="tlsEnabledInput">
                  Enable TLS
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="sslRedirectInput"
                  type="checkbox"
                  checked
                />

                <label for="sslRedirectInput">
                  Redirect HTTP to HTTPS
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="forceSslRedirectInput"
                  type="checkbox"
                />

                <label for="forceSslRedirectInput">
                  Force SSL redirect
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="certManagerInput"
                  type="checkbox"
                />

                <label for="certManagerInput">
                  Add cert-manager issuer
                </label>
              </div>
            </div>

            <div
              id="tlsSection"
              class="conditional-section active"
            >
              <div class="form-group">
                <label for="tlsSecretInput">
                  TLS secret name
                </label>

                <input
                  id="tlsSecretInput"
                  type="text"
                  value="app-tls-secret"
                  placeholder="Example: app-tls-secret"
                />
              </div>
            </div>

            <div
              id="certManagerSection"
              class="conditional-section"
            >
              <div class="input-row">
                <div class="form-group">
                  <label for="issuerTypeSelect">
                    Issuer type
                  </label>

                  <select id="issuerTypeSelect">
                    <option
                      value="cluster"
                      selected
                    >
                      ClusterIssuer
                    </option>

                    <option value="namespace">
                      Issuer
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="issuerNameInput">
                    Issuer name
                  </label>

                  <input
                    id="issuerNameInput"
                    type="text"
                    value="letsencrypt-prod"
                    placeholder="Example: letsencrypt-prod"
                  />
                </div>
              </div>
            </div>

            <h3 class="section-title">
              NGINX Controller Options
            </h3>

            <div class="checkbox-grid">
              <div class="checkbox-item">
                <input
                  id="rewriteEnabledInput"
                  type="checkbox"
                />

                <label for="rewriteEnabledInput">
                  Enable rewrite target
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="regexEnabledInput"
                  type="checkbox"
                />

                <label for="regexEnabledInput">
                  Enable regular expression paths
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="websocketEnabledInput"
                  type="checkbox"
                />

                <label for="websocketEnabledInput">
                  Enable WebSocket service
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="corsEnabledInput"
                  type="checkbox"
                />

                <label for="corsEnabledInput">
                  Enable CORS
                </label>
              </div>
            </div>

            <div
              id="rewriteSection"
              class="conditional-section"
            >
              <div class="form-group">
                <label for="rewriteTargetInput">
                  Rewrite target
                </label>

                <input
                  id="rewriteTargetInput"
                  type="text"
                  value="/"
                  placeholder="Example: / or /$2"
                />
              </div>
            </div>

            <div
              id="websocketSection"
              class="conditional-section"
            >
              <div class="form-group">
                <label for="websocketServiceInput">
                  WebSocket service name
                </label>

                <input
                  id="websocketServiceInput"
                  type="text"
                  placeholder="Example: websocket-service"
                />
              </div>
            </div>

            <div
              id="corsSection"
              class="conditional-section"
            >
              <div class="input-row">
                <div class="form-group">
                  <label for="corsOriginsInput">
                    Allowed origins
                  </label>

                  <input
                    id="corsOriginsInput"
                    type="text"
                    value="*"
                    placeholder="Example: https://example.com"
                  />
                </div>

                <div class="form-group">
                  <label for="corsMethodsInput">
                    Allowed methods
                  </label>

                  <input
                    id="corsMethodsInput"
                    type="text"
                    value="GET, POST, PUT, DELETE, OPTIONS"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="corsHeadersInput">
                  Allowed headers
                </label>

                <input
                  id="corsHeadersInput"
                  type="text"
                  value="Authorization, Content-Type"
                />
              </div>
            </div>

            <h3 class="section-title">
              Proxy Settings
            </h3>

            <div class="input-row">
              <div class="form-group">
                <label for="proxyBodySizeInput">
                  Proxy body size
                </label>

                <input
                  id="proxyBodySizeInput"
                  type="text"
                  value="10m"
                  placeholder="Example: 10m"
                />
              </div>

              <div class="form-group">
                <label for="proxyReadTimeoutInput">
                  Proxy read timeout
                </label>

                <input
                  id="proxyReadTimeoutInput"
                  type="number"
                  value="60"
                  min="1"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="proxySendTimeoutInput">
                  Proxy send timeout
                </label>

                <input
                  id="proxySendTimeoutInput"
                  type="number"
                  value="60"
                  min="1"
                />
              </div>

              <div class="form-group">
                <label for="backendProtocolSelect">
                  Backend protocol
                </label>

                <select id="backendProtocolSelect">
                  <option
                    value="HTTP"
                    selected
                  >
                    HTTP
                  </option>

                  <option value="HTTPS">
                    HTTPS
                  </option>

                  <option value="GRPC">
                    GRPC
                  </option>

                  <option value="GRPCS">
                    GRPCS
                  </option>
                </select>
              </div>
            </div>

            <h3 class="section-title">
              Labels and Custom Annotations
            </h3>

            <div class="form-group">
              <label for="labelsInput">
                Additional labels
              </label>

              <textarea
                id="labelsInput"
                placeholder="team=platform&#10;environment=production"
              ></textarea>

              <p class="help-text">
                Enter one key=value label per line.
              </p>
            </div>

            <div class="form-group">
              <label for="annotationsInput">
                Custom annotations
              </label>

              <textarea
                id="annotationsInput"
                placeholder="nginx.ingress.kubernetes.io/custom-http-errors=404,500"
              ></textarea>

              <p class="help-text">
                Enter one key=value annotation per line.
              </p>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Ingress
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
