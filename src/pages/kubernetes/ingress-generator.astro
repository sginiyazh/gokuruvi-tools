    <script is:inline>
      const fields = {
        ingressName:
          document.getElementById(
            "ingressNameInput",
          ),

        namespace:
          document.getElementById(
            "namespaceInput",
          ),

        ingressClass:
          document.getElementById(
            "ingressClassInput",
          ),

        host:
          document.getElementById(
            "hostInput",
          ),

        tlsEnabled:
          document.getElementById(
            "tlsEnabledInput",
          ),

        tlsSecret:
          document.getElementById(
            "tlsSecretInput",
          ),

        sslRedirect:
          document.getElementById(
            "sslRedirectInput",
          ),

        forceSslRedirect:
          document.getElementById(
            "forceSslRedirectInput",
          ),

        certManager:
          document.getElementById(
            "certManagerInput",
          ),

        issuerType:
          document.getElementById(
            "issuerTypeSelect",
          ),

        issuerName:
          document.getElementById(
            "issuerNameInput",
          ),

        rewriteEnabled:
          document.getElementById(
            "rewriteEnabledInput",
          ),

        rewriteTarget:
          document.getElementById(
            "rewriteTargetInput",
          ),

        regexEnabled:
          document.getElementById(
            "regexEnabledInput",
          ),

        websocketEnabled:
          document.getElementById(
            "websocketEnabledInput",
          ),

        websocketService:
          document.getElementById(
            "websocketServiceInput",
          ),

        corsEnabled:
          document.getElementById(
            "corsEnabledInput",
          ),

        corsOrigins:
          document.getElementById(
            "corsOriginsInput",
          ),

        corsMethods:
          document.getElementById(
            "corsMethodsInput",
          ),

        corsHeaders:
          document.getElementById(
            "corsHeadersInput",
          ),

        proxyBodySize:
          document.getElementById(
            "proxyBodySizeInput",
          ),

        proxyReadTimeout:
          document.getElementById(
            "proxyReadTimeoutInput",
          ),

        proxySendTimeout:
          document.getElementById(
            "proxySendTimeoutInput",
          ),

        backendProtocol:
          document.getElementById(
            "backendProtocolSelect",
          ),

        labels:
          document.getElementById(
            "labelsInput",
          ),

        annotations:
          document.getElementById(
            "annotationsInput",
          ),
      };

      const pathsContainer =
        document.getElementById(
          "pathsContainer",
        );

      const yamlOutput =
        document.getElementById(
          "yamlOutput",
        );

      const message =
        document.getElementById(
          "message",
        );

      const summaryList =
        document.getElementById(
          "summaryList",
        );

      const copyButton =
        document.getElementById(
          "copyButton",
        );

      let currentYaml = "";

      let paths = [
        {
          path: "/",
          pathType: "Prefix",
          serviceName: "nginx-service",
          servicePort: "80",
        },
      ];

      function escapeYamlString(value) {
        const text = String(value);

        if (
          text === "" ||
          /[:#{}[\],&*?|>'"%@`]/.test(text) ||
          /^\s|\s$/.test(text) ||
          [
            "true",
            "false",
            "null",
            "yes",
            "no",
            "on",
            "off",
          ].includes(text.toLowerCase())
        ) {
          return `"${text
            .replace(/\\/g, "\\\\")
            .replace(/"/g, '\\"')}"`;
        }

        return text;
      }

      function parseKeyValueLines(value) {
        const result = {};

        value
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .forEach((line) => {
            const index = line.indexOf("=");

            if (index <= 0) {
              return;
            }

            const key = line
              .slice(0, index)
              .trim();

            const itemValue = line
              .slice(index + 1)
              .trim();

            if (key) {
              result[key] = itemValue;
            }
          });

        return result;
      }

      function isValidKubernetesName(value) {
        return (
          value.length >= 1 &&
          value.length <= 63 &&
          /^[a-z0-9]([-a-z0-9]*[a-z0-9])?$/.test(
            value,
          )
        );
      }

      function isValidHostname(value) {
        if (
          !value ||
          value.length > 253 ||
          value.includes("/") ||
          value.includes(":") ||
          /\s/.test(value)
        ) {
          return false;
        }

        return value
          .split(".")
          .every((label) => {
            return (
              label.length >= 1 &&
              label.length <= 63 &&
              /^[a-z0-9-]+$/i.test(label) &&
              !label.startsWith("-") &&
              !label.endsWith("-")
            );
          });
      }

      function isValidServicePort(value) {
        if (/^\d+$/.test(value)) {
          const port = Number(value);

          return (
            Number.isInteger(port) &&
            port >= 1 &&
            port <= 65535
          );
        }

        return isValidKubernetesName(value);
      }

      function showMessage(text, type) {
        message.textContent = text;
        message.className =
          `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addObjectLines(
        lines,
        object,
        indent,
      ) {
        const spacing = " ".repeat(indent);

        Object.entries(object).forEach(
          ([key, value]) => {
            lines.push(
              `${spacing}${key}: ${escapeYamlString(
                value,
              )}`,
            );
          },
        );
      }

      function createPathCard(
        pathItem,
        index,
      ) {
        const wrapper =
          document.createElement("div");

        wrapper.className = "path-card";

        wrapper.innerHTML = `
          <div class="path-header">
            <span class="path-title">
              Path ${index + 1}
            </span>

            <button
              type="button"
              class="remove-path-button"
              data-index="${index}"
              ${paths.length === 1 ? "disabled" : ""}
            >
              Remove
            </button>
          </div>

          <div class="input-row">
            <div class="form-group">
              <label for="path-${index}">
                URL path
              </label>

              <input
                id="path-${index}"
                class="path-value"
                data-index="${index}"
                type="text"
                value="${pathItem.path}"
                placeholder="Example: /"
              />
            </div>

            <div class="form-group">
              <label for="path-type-${index}">
                Path type
              </label>

              <select
                id="path-type-${index}"
                class="path-type-value"
                data-index="${index}"
              >
                <option
                  value="Prefix"
                  ${
                    pathItem.pathType ===
                    "Prefix"
                      ? "selected"
                      : ""
                  }
                >
                  Prefix
                </option>

                <option
                  value="Exact"
                  ${
                    pathItem.pathType ===
                    "Exact"
                      ? "selected"
                      : ""
                  }
                >
                  Exact
                </option>

                <option
                  value="ImplementationSpecific"
                  ${
                    pathItem.pathType ===
                    "ImplementationSpecific"
                      ? "selected"
                      : ""
                  }
                >
                  ImplementationSpecific
                </option>
              </select>
            </div>
          </div>

          <div class="input-row">
            <div class="form-group">
              <label for="service-name-${index}">
                Backend service
              </label>

              <input
                id="service-name-${index}"
                class="service-name-value"
                data-index="${index}"
                type="text"
                value="${pathItem.serviceName}"
                placeholder="Example: nginx-service"
              />
            </div>

            <div class="form-group">
              <label for="service-port-${index}">
                Service port
              </label>

              <input
                id="service-port-${index}"
                class="service-port-value"
                data-index="${index}"
                type="text"
                value="${pathItem.servicePort}"
                placeholder="Example: 80 or http"
              />
            </div>
          </div>
        `;

        return wrapper;
      }

      function renderPaths() {
        pathsContainer.innerHTML = "";

        paths.forEach((pathItem, index) => {
          pathsContainer.appendChild(
            createPathCard(
              pathItem,
              index,
            ),
          );
        });

        document
          .querySelectorAll(".path-value")
          .forEach((input) => {
            input.addEventListener(
              "input",
              (event) => {
                const index = Number(
                  event.target.dataset.index,
                );

                paths[index].path =
                  event.target.value;

                generateYaml();
              },
            );
          });

        document
          .querySelectorAll(
            ".path-type-value",
          )
          .forEach((select) => {
            select.addEventListener(
              "change",
              (event) => {
                const index = Number(
                  event.target.dataset.index,
                );

                paths[index].pathType =
                  event.target.value;

                generateYaml();
              },
            );
          });

        document
          .querySelectorAll(
            ".service-name-value",
          )
          .forEach((input) => {
            input.addEventListener(
              "input",
              (event) => {
                const index = Number(
                  event.target.dataset.index,
                );

                paths[index].serviceName =
                  event.target.value;

                generateYaml();
              },
            );
          });

        document
          .querySelectorAll(
            ".service-port-value",
          )
          .forEach((input) => {
            input.addEventListener(
              "input",
              (event) => {
                const index = Number(
                  event.target.dataset.index,
                );

                paths[index].servicePort =
                  event.target.value;

                generateYaml();
              },
            );
          });

        document
          .querySelectorAll(
            ".remove-path-button",
          )
          .forEach((button) => {
            button.addEventListener(
              "click",
              () => {
                const index = Number(
                  button.dataset.index,
                );

                if (paths.length > 1) {
                  paths.splice(index, 1);
                  renderPaths();
                  generateYaml();
                }
              },
            );
          });
      }

      function validateForm() {
        const ingressName =
          fields.ingressName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        const ingressClass =
          fields.ingressClass.value.trim();

        const host =
          fields.host.value.trim();

        if (
          !isValidKubernetesName(
            ingressName,
          )
        ) {
          return "Ingress name must use lowercase letters, numbers and hyphens only.";
        }

        if (
          !isValidKubernetesName(
            namespace,
          )
        ) {
          return "Namespace must use lowercase letters, numbers and hyphens only.";
        }

        if (
          ingressClass &&
          !isValidKubernetesName(
            ingressClass,
          )
        ) {
          return "Ingress class name must be a valid Kubernetes name.";
        }

        if (!isValidHostname(host)) {
          return "Enter a valid hostname such as app.example.com.";
        }

        if (
          fields.tlsEnabled.checked &&
          !isValidKubernetesName(
            fields.tlsSecret.value.trim(),
          )
        ) {
          return "Enter a valid TLS secret name.";
        }

        if (
          fields.certManager.checked &&
          !fields.issuerName.value.trim()
        ) {
          return "Enter the cert-manager issuer name.";
        }

        for (
          let index = 0;
          index < paths.length;
          index += 1
        ) {
          const pathItem = paths[index];

          if (
            !pathItem.path.trim().startsWith(
              "/",
            )
          ) {
            return `Path ${index + 1} must start with /.`;
          }

          if (
            !isValidKubernetesName(
              pathItem.serviceName.trim(),
            )
          ) {
            return `Path ${index + 1} has an invalid backend service name.`;
          }

          if (
            !isValidServicePort(
              pathItem.servicePort.trim(),
            )
          ) {
            return `Path ${index + 1} has an invalid service port.`;
          }
        }

        return "";
      }

      function generateYaml() {
        clearMessage();

        const validationError =
          validateForm();

        if (validationError) {
          currentYaml = "";
          yamlOutput.textContent =
            validationError;

          summaryList.innerHTML = "";

          showMessage(
            validationError,
            "error",
          );

          return;
        }

        const ingressName =
          fields.ingressName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        const ingressClass =
          fields.ingressClass.value.trim();

        const host =
          fields.host.value.trim();

        const labels = {
          app: ingressName,
          ...parseKeyValueLines(
            fields.labels.value,
          ),
        };

        const customAnnotations =
          parseKeyValueLines(
            fields.annotations.value,
          );

        const annotations = {
          ...customAnnotations,
        };

        if (fields.sslRedirect.checked) {
          annotations[
            "nginx.ingress.kubernetes.io/ssl-redirect"
          ] = "true";
        }

        if (
          fields.forceSslRedirect.checked
        ) {
          annotations[
            "nginx.ingress.kubernetes.io/force-ssl-redirect"
          ] = "true";
        }

        if (
          fields.rewriteEnabled.checked
        ) {
          annotations[
            "nginx.ingress.kubernetes.io/rewrite-target"
          ] =
            fields.rewriteTarget.value.trim() ||
            "/";
        }

        if (fields.regexEnabled.checked) {
          annotations[
            "nginx.ingress.kubernetes.io/use-regex"
          ] = "true";
        }

        if (
          fields.websocketEnabled.checked &&
          fields.websocketService.value.trim()
        ) {
          annotations[
            "nginx.org/websocket-services"
          ] =
            fields.websocketService.value.trim();
        }

        if (fields.corsEnabled.checked) {
          annotations[
            "nginx.ingress.kubernetes.io/enable-cors"
          ] = "true";

          annotations[
            "nginx.ingress.kubernetes.io/cors-allow-origin"
          ] =
            fields.corsOrigins.value.trim() ||
            "*";

          annotations[
            "nginx.ingress.kubernetes.io/cors-allow-methods"
          ] =
            fields.corsMethods.value.trim();

          annotations[
            "nginx.ingress.kubernetes.io/cors-allow-headers"
          ] =
            fields.corsHeaders.value.trim();
        }

        if (
          fields.proxyBodySize.value.trim()
        ) {
          annotations[
            "nginx.ingress.kubernetes.io/proxy-body-size"
          ] =
            fields.proxyBodySize.value.trim();
        }

        annotations[
          "nginx.ingress.kubernetes.io/proxy-read-timeout"
        ] = String(
          Number(
            fields.proxyReadTimeout.value,
          ),
        );

        annotations[
          "nginx.ingress.kubernetes.io/proxy-send-timeout"
        ] = String(
          Number(
            fields.proxySendTimeout.value,
          ),
        );

        annotations[
          "nginx.ingress.kubernetes.io/backend-protocol"
        ] = fields.backendProtocol.value;

        if (fields.certManager.checked) {
          const annotationKey =
            fields.issuerType.value ===
            "cluster"
              ? "cert-manager.io/cluster-issuer"
              : "cert-manager.io/issuer";

          annotations[annotationKey] =
            fields.issuerName.value.trim();
        }

        const lines = [];

        lines.push(
          "apiVersion: networking.k8s.io/v1",
        );

        lines.push("kind: Ingress");
        lines.push("metadata:");
        lines.push(`  name: ${ingressName}`);
        lines.push(`  namespace: ${namespace}`);
        lines.push("  labels:");

        addObjectLines(lines, labels, 4);

        if (
          Object.keys(annotations).length >
          0
        ) {
          lines.push("  annotations:");

          addObjectLines(
            lines,
            annotations,
            4,
          );
        }

        lines.push("spec:");

        if (ingressClass) {
          lines.push(
            `  ingressClassName: ${ingressClass}`,
          );
        }

        if (fields.tlsEnabled.checked) {
          lines.push("  tls:");
          lines.push("    - hosts:");
          lines.push(
            `        - ${host}`,
          );

          lines.push(
            `      secretName: ${fields.tlsSecret.value.trim()}`,
          );
        }

        lines.push("  rules:");
        lines.push(`    - host: ${host}`);
        lines.push("      http:");
        lines.push("        paths:");

        paths.forEach((pathItem) => {
          lines.push(
            `          - path: ${escapeYamlString(
              pathItem.path.trim(),
            )}`,
          );

          lines.push(
            `            pathType: ${pathItem.pathType}`,
          );

          lines.push(
            "            backend:",
          );

          lines.push(
            "              service:",
          );

          lines.push(
            `                name: ${pathItem.serviceName.trim()}`,
          );

          lines.push(
            "                port:",
          );

          const servicePort =
            pathItem.servicePort.trim();

          if (/^\d+$/.test(servicePort)) {
            lines.push(
              `                  number: ${Number(
                servicePort,
              )}`,
            );
          } else {
            lines.push(
              `                  name: ${servicePort}`,
            );
          }
        });

        currentYaml = lines.join("\n");

        yamlOutput.textContent =
          currentYaml;

        document.getElementById(
          "resultName",
        ).textContent = ingressName;

        document.getElementById(
          "resultNamespace",
        ).textContent = namespace;

        document.getElementById(
          "resultClass",
        ).textContent =
          ingressClass || "Default";

        document.getElementById(
          "resultTls",
        ).textContent =
          fields.tlsEnabled.checked
            ? "Enabled"
            : "Disabled";

        document.getElementById(
          "resultHost",
        ).textContent = host;

        summaryList.innerHTML = "";

        const summary = [
          `Creates Ingress ${ingressName} in namespace ${namespace}.`,
          `Routes traffic for hostname ${host}.`,
          `Uses ${ingressClass || "the default"} Ingress class.`,
          `Includes ${paths.length} routing path${paths.length === 1 ? "" : "s"}.`,
        ];

        if (fields.tlsEnabled.checked) {
          summary.push(
            `TLS uses secret ${fields.tlsSecret.value.trim()}.`,
          );
        }

        if (fields.sslRedirect.checked) {
          summary.push(
            "HTTP requests are redirected to HTTPS.",
          );
        }

        if (fields.certManager.checked) {
          summary.push(
            `Uses cert-manager issuer ${fields.issuerName.value.trim()}.`,
          );
        }

        summary.forEach((text) => {
          const item =
            document.createElement("li");

          item.textContent = text;
          summaryList.appendChild(item);
        });
      }

      function updateConditionalSections() {
        document
          .getElementById("tlsSection")
          .classList.toggle(
            "active",
            fields.tlsEnabled.checked,
          );

        document
          .getElementById(
            "certManagerSection",
          )
          .classList.toggle(
            "active",
            fields.certManager.checked,
          );

        document
          .getElementById(
            "rewriteSection",
          )
          .classList.toggle(
            "active",
            fields.rewriteEnabled.checked,
          );

        document
          .getElementById(
            "websocketSection",
          )
          .classList.toggle(
            "active",
            fields.websocketEnabled.checked,
          );

        document
          .getElementById("corsSection")
          .classList.toggle(
            "active",
            fields.corsEnabled.checked,
          );

        fields.tlsSecret.disabled =
          !fields.tlsEnabled.checked;

        fields.rewriteTarget.disabled =
          !fields.rewriteEnabled.checked;

        fields.websocketService.disabled =
          !fields.websocketEnabled.checked;

        generateYaml();
      }

      function addPath() {
        paths.push({
          path: "/api",
          pathType: "Prefix",
          serviceName: "api-service",
          servicePort: "8080",
        });

        renderPaths();
        generateYaml();
      }

      function applyPreset(preset) {
        if (preset === "nginx") {
          fields.ingressName.value =
            "nginx-ingress";

          fields.ingressClass.value =
            "nginx";

          fields.host.value =
            "app.example.com";

          fields.tlsEnabled.checked =
            false;

          fields.sslRedirect.checked =
            false;

          fields.certManager.checked =
            false;

          fields.rewriteEnabled.checked =
            false;

          fields.backendProtocol.value =
            "HTTP";

          paths = [
            {
              path: "/",
              pathType: "Prefix",
              serviceName:
                "nginx-service",
              servicePort: "80",
            },
          ];
        }

        if (preset === "traefik") {
          fields.ingressName.value =
            "traefik-ingress";

          fields.ingressClass.value =
            "traefik";

          fields.host.value =
            "app.example.com";

          fields.tlsEnabled.checked =
            false;

          fields.sslRedirect.checked =
            false;

          fields.certManager.checked =
            false;

          fields.rewriteEnabled.checked =
            false;

          fields.backendProtocol.value =
            "HTTP";

          fields.annotations.value = "";

          paths = [
            {
              path: "/",
              pathType: "Prefix",
              serviceName:
                "application-service",
              servicePort: "80",
            },
          ];
        }

        if (preset === "https") {
          fields.ingressName.value =
            "secure-app-ingress";

          fields.ingressClass.value =
            "nginx";

          fields.host.value =
            "secure.example.com";

          fields.tlsEnabled.checked =
            true;

          fields.tlsSecret.value =
            "secure-app-tls";

          fields.sslRedirect.checked =
            true;

          fields.forceSslRedirect.checked =
            true;

          fields.certManager.checked =
            true;

          fields.issuerName.value =
            "letsencrypt-prod";

          fields.backendProtocol.value =
            "HTTP";

          paths = [
            {
              path: "/",
              pathType: "Prefix",
              serviceName:
                "secure-app-service",
              servicePort: "80",
            },
          ];
        }

        if (preset === "api") {
          fields.ingressName.value =
            "api-ingress";

          fields.ingressClass.value =
            "nginx";

          fields.host.value =
            "api.example.com";

          fields.tlsEnabled.checked =
            true;

          fields.tlsSecret.value =
            "api-tls-secret";

          fields.sslRedirect.checked =
            true;

          fields.rewriteEnabled.checked =
            false;

          fields.backendProtocol.value =
            "HTTP";

          paths = [
            {
              path: "/api",
              pathType: "Prefix",
              serviceName:
                "api-service",
              servicePort: "8080",
            },
            {
              path: "/health",
              pathType: "Exact",
              serviceName:
                "api-service",
              servicePort: "8080",
            },
          ];
        }

        renderPaths();
        updateConditionalSections();
      }

      function resetGenerator() {
        fields.ingressName.value =
          "nginx-ingress";

        fields.namespace.value =
          "default";

        fields.ingressClass.value =
          "nginx";

        fields.host.value =
          "app.example.com";

        fields.tlsEnabled.checked =
          true;

        fields.tlsSecret.value =
          "app-tls-secret";

        fields.sslRedirect.checked =
          true;

        fields.forceSslRedirect.checked =
          false;

        fields.certManager.checked =
          false;

        fields.issuerType.value =
          "cluster";

        fields.issuerName.value =
          "letsencrypt-prod";

        fields.rewriteEnabled.checked =
          false;

        fields.rewriteTarget.value =
          "/";

        fields.regexEnabled.checked =
          false;

        fields.websocketEnabled.checked =
          false;

        fields.websocketService.value =
          "";

        fields.corsEnabled.checked =
          false;

        fields.corsOrigins.value =
          "*";

        fields.corsMethods.value =
          "GET, POST, PUT, DELETE, OPTIONS";

        fields.corsHeaders.value =
          "Authorization, Content-Type";

        fields.proxyBodySize.value =
          "10m";

        fields.proxyReadTimeout.value =
          "60";

        fields.proxySendTimeout.value =
          "60";

        fields.backendProtocol.value =
          "HTTP";

        fields.labels.value = "";
        fields.annotations.value = "";

        paths = [
          {
            path: "/",
            pathType: "Prefix",
            serviceName:
              "nginx-service",
            servicePort: "80",
          },
        ];

        clearMessage();
        renderPaths();
        updateConditionalSections();

        fields.ingressName.focus();
      }

      async function copyYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate valid Ingress YAML before copying.",
            "error",
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentYaml,
          );

          const originalText =
            copyButton.textContent;

          copyButton.textContent =
            "Copied!";

          showMessage(
            "Ingress YAML copied successfully.",
            "success",
          );

          setTimeout(() => {
            copyButton.textContent =
              originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Copy the YAML manually.",
            "error",
          );
        }
      }

      function downloadYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate valid Ingress YAML before downloading.",
            "error",
          );

          return;
        }

        const blob = new Blob(
          [currentYaml],
          {
            type: "application/yaml;charset=utf-8",
          },
        );

        const url =
          URL.createObjectURL(blob);

        const anchor =
          document.createElement("a");

        anchor.href = url;

        anchor.download =
          `${fields.ingressName.value.trim() || "ingress"}.yaml`;

        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();

        URL.revokeObjectURL(url);

        showMessage(
          "Ingress YAML downloaded successfully.",
          "success",
        );
      }

      document
        .getElementById(
          "addPathButton",
        )
        .addEventListener(
          "click",
          addPath,
        );

      document
        .getElementById(
          "generateButton",
        )
        .addEventListener(
          "click",
          generateYaml,
        );

      document
        .getElementById("resetButton")
        .addEventListener(
          "click",
          resetGenerator,
        );

      copyButton.addEventListener(
        "click",
        copyYaml,
      );

      document
        .getElementById(
          "downloadButton",
        )
        .addEventListener(
          "click",
          downloadYaml,
        );

      Object.values(fields).forEach(
        (field) => {
          field.addEventListener(
            "input",
            generateYaml,
          );

          field.addEventListener(
            "change",
            updateConditionalSections,
          );
        },
      );

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              applyPreset(
                button.dataset.preset ||
                  "",
              );
            },
          );
        });

      renderPaths();
      updateConditionalSections();
    </script>
  </body>
</html>