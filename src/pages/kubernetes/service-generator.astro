---
const pageTitle =
  "Kubernetes Service Generator | Gokuruvi Tools";

const description =
  "Generate Kubernetes Service YAML for ClusterIP, NodePort, LoadBalancer, Headless and ExternalName services.";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/kubernetes/service-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;
        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;
        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1200px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(36px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 850px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 50px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1200px;
        margin: 0 auto;
        grid-template-columns:
          minmax(0, 0.95fr)
          minmax(0, 1.05fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .section-title {
        margin: 28px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--dark);
        font-size: 18px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .input-row.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      textarea {
        min-height: 100px;
        resize: vertical;
        font-family: Consolas, "Courier New", monospace;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-item {
        display: flex;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .conditional-section {
        display: none;
        margin-top: 14px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .conditional-section.active {
        display: block;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
      }

      .preset {
        padding: 8px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .yaml-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
      }

      .yaml-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .yaml-output {
        min-height: 550px;
        margin: 0;
        overflow: auto;
        color: #e2e8f0;
        white-space: pre;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.65;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 800;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1200px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 920px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .input-row.three,
        .result-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <h1>Kubernetes Service Generator</h1>

        <p>
          Generate Kubernetes Service YAML for ClusterIP,
          NodePort, LoadBalancer, Headless and ExternalName
          services.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Service Configuration</h2>

            <p class="card-description">
              Configure the service type, selectors, ports,
              session affinity and traffic policy.
            </p>

            <div class="preset-buttons">
              <button
                type="button"
                class="preset"
                data-preset="clusterip"
              >
                ClusterIP
              </button>

              <button
                type="button"
                class="preset"
                data-preset="nodeport"
              >
                NodePort
              </button>

              <button
                type="button"
                class="preset"
                data-preset="loadbalancer"
              >
                LoadBalancer
              </button>

              <button
                type="button"
                class="preset"
                data-preset="headless"
              >
                Headless
              </button>
            </div>

            <h3 class="section-title">
              Basic Settings
            </h3>

            <div class="input-row">
              <div class="form-group">
                <label for="serviceNameInput">
                  Service name
                </label>

                <input
                  id="serviceNameInput"
                  type="text"
                  value="nginx-service"
                  maxlength="63"
                  placeholder="Example: nginx-service"
                />
              </div>

              <div class="form-group">
                <label for="namespaceInput">
                  Namespace
                </label>

                <input
                  id="namespaceInput"
                  type="text"
                  value="default"
                  maxlength="63"
                  placeholder="Example: default"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="serviceTypeSelect">
                Service type
              </label>

              <select id="serviceTypeSelect">
                <option value="ClusterIP" selected>
                  ClusterIP
                </option>

                <option value="NodePort">
                  NodePort
                </option>

                <option value="LoadBalancer">
                  LoadBalancer
                </option>

                <option value="ExternalName">
                  ExternalName
                </option>

                <option value="Headless">
                  Headless Service
                </option>
              </select>
            </div>

            <div
              id="externalNameSection"
              class="conditional-section"
            >
              <div class="form-group">
                <label for="externalNameInput">
                  External DNS name
                </label>

                <input
                  id="externalNameInput"
                  type="text"
                  value="internal.example.com"
                  placeholder="Example: internal.example.com"
                />

                <p class="help-text">
                  ExternalName creates a DNS CNAME record and
                  does not use selectors or ports.
                </p>
              </div>
            </div>

            <div id="standardServiceSection">
              <h3 class="section-title">
                Pod Selector
              </h3>

              <div class="form-group">
                <label for="selectorInput">
                  Selector labels
                </label>

                <textarea
                  id="selectorInput"
                  placeholder="app=nginx&#10;environment=production"
                >app=nginx</textarea>

                <p class="help-text">
                  Enter one key=value selector per line. The
                  selector must match the labels on your pods.
                </p>
              </div>

              <h3 class="section-title">
                Port Configuration
              </h3>

              <div class="input-row">
                <div class="form-group">
                  <label for="portNameInput">
                    Port name
                  </label>

                  <input
                    id="portNameInput"
                    type="text"
                    value="http"
                    placeholder="Example: http"
                  />
                </div>

                <div class="form-group">
                  <label for="protocolSelect">
                    Protocol
                  </label>

                  <select id="protocolSelect">
                    <option value="TCP" selected>
                      TCP
                    </option>

                    <option value="UDP">
                      UDP
                    </option>

                    <option value="SCTP">
                      SCTP
                    </option>
                  </select>
                </div>
              </div>

              <div class="input-row three">
                <div class="form-group">
                  <label for="servicePortInput">
                    Service port
                  </label>

                  <input
                    id="servicePortInput"
                    type="number"
                    value="80"
                    min="1"
                    max="65535"
                  />
                </div>

                <div class="form-group">
                  <label for="targetPortInput">
                    Target port
                  </label>

                  <input
                    id="targetPortInput"
                    type="text"
                    value="80"
                    placeholder="Example: 80 or http"
                  />
                </div>

                <div class="form-group">
                  <label for="nodePortInput">
                    NodePort
                  </label>

                  <input
                    id="nodePortInput"
                    type="number"
                    value="30080"
                    min="30000"
                    max="32767"
                    disabled
                  />
                </div>
              </div>

              <h3 class="section-title">
                Networking Options
              </h3>

              <div class="input-row">
                <div class="form-group">
                  <label for="sessionAffinitySelect">
                    Session affinity
                  </label>

                  <select id="sessionAffinitySelect">
                    <option value="None" selected>
                      None
                    </option>

                    <option value="ClientIP">
                      ClientIP
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="trafficPolicySelect">
                    External traffic policy
                  </label>

                  <select id="trafficPolicySelect">
                    <option value="Cluster" selected>
                      Cluster
                    </option>

                    <option value="Local">
                      Local
                    </option>
                  </select>
                </div>
              </div>

              <div
                id="sessionAffinitySection"
                class="conditional-section"
              >
                <div class="form-group">
                  <label for="sessionTimeoutInput">
                    Session timeout seconds
                  </label>

                  <input
                    id="sessionTimeoutInput"
                    type="number"
                    value="10800"
                    min="1"
                    max="86400"
                  />
                </div>
              </div>

              <div class="input-row">
                <div class="form-group">
                  <label for="ipFamilyPolicySelect">
                    IP family policy
                  </label>

                  <select id="ipFamilyPolicySelect">
                    <option value="">
                      Default
                    </option>

                    <option value="SingleStack">
                      SingleStack
                    </option>

                    <option value="PreferDualStack">
                      PreferDualStack
                    </option>

                    <option value="RequireDualStack">
                      RequireDualStack
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="loadBalancerIPInput">
                    Load balancer IP
                  </label>

                  <input
                    id="loadBalancerIPInput"
                    type="text"
                    placeholder="Optional: 203.0.113.10"
                    disabled
                  />
                </div>
              </div>

              <div class="checkbox-item">
                <input
                  id="publishNotReadyInput"
                  type="checkbox"
                />

                <label for="publishNotReadyInput">
                  Publish pod addresses before pods are ready
                </label>
              </div>

              <div
                class="checkbox-item"
                style="margin-top: 12px;"
              >
                <input
                  id="allocateNodePortsInput"
                  type="checkbox"
                  checked
                  disabled
                />

                <label for="allocateNodePortsInput">
                  Allocate NodePorts for LoadBalancer
                </label>
              </div>

              <h3 class="section-title">
                Additional Labels and Annotations
              </h3>

              <div class="form-group">
                <label for="labelsInput">
                  Additional labels
                </label>

                <textarea
                  id="labelsInput"
                  placeholder="team=platform&#10;environment=production"
                ></textarea>

                <p class="help-text">
                  Enter one key=value label per line.
                </p>
              </div>

              <div class="form-group">
                <label for="annotationsInput">
                  Annotations
                </label>

                <textarea
                  id="annotationsInput"
                  placeholder="service.beta.kubernetes.io/example=value"
                ></textarea>

                <p class="help-text">
                  Enter one key=value annotation per line.
                </p>
              </div>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Service
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Generated service.yaml</h2>

            <p class="card-description">
              Review the manifest before applying it to your
              Kubernetes cluster.
            </p>

            <div class="yaml-box">
              <span class="yaml-label">
                Kubernetes Service YAML
              </span>

              <pre
                id="yamlOutput"
                class="yaml-output"
              ></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy YAML
              </button>

              <button
                id="downloadButton"
                class="button secondary-button"
                type="button"
              >
                Download YAML
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">
                  Service name
                </span>

                <span
                  id="resultName"
                  class="result-value"
                >
                  nginx-service
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">
                  Namespace
                </span>

                <span
                  id="resultNamespace"
                  class="result-value"
                >
                  default
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">
                  Type
                </span>

                <span
                  id="resultType"
                  class="result-value"
                >
                  ClusterIP
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">
                  Port
                </span>

                <span
                  id="resultPort"
                  class="result-value"
                >
                  80 → 80
                </span>
              </div>
            </div>

            <div class="warning">
              Confirm that the Service selectors match your
              Deployment pod labels. A Service with incorrect
              selectors will not create usable endpoints.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Service Type Reference</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>Service type</th>
                <th>Purpose</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td><code>ClusterIP</code></td>
                <td>
                  Exposes the application internally within
                  the Kubernetes cluster.
                </td>
              </tr>

              <tr>
                <td><code>NodePort</code></td>
                <td>
                  Exposes the application through a port on
                  every cluster node.
                </td>
              </tr>

              <tr>
                <td><code>LoadBalancer</code></td>
                <td>
                  Requests an external load balancer from the
                  cloud or infrastructure provider.
                </td>
              </tr>

              <tr>
                <td><code>Headless</code></td>
                <td>
                  Sets <code>clusterIP: None</code> and returns
                  individual pod addresses through DNS.
                </td>
              </tr>

              <tr>
                <td><code>ExternalName</code></td>
                <td>
                  Maps the Kubernetes Service name to an
                  external DNS hostname.
                </td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="reference-section">
          <h2>Apply and Verify</h2>

          <table class="reference-table">
            <tbody>
              <tr>
                <th>Validate YAML</th>
                <td>
                  <code>
                    kubectl apply --dry-run=client -f service.yaml
                  </code>
                </td>
              </tr>

              <tr>
                <th>Apply Service</th>
                <td>
                  <code>
                    kubectl apply -f service.yaml
                  </code>
                </td>
              </tr>

              <tr>
                <th>List Services</th>
                <td>
                  <code>
                    kubectl get svc -n default
                  </code>
                </td>
              </tr>

              <tr>
                <th>Describe Service</th>
                <td>
                  <code>
                    kubectl describe svc nginx-service -n default
                  </code>
                </td>
              </tr>

              <tr>
                <th>Check Endpoints</th>
                <td>
                  <code>
                    kubectl get endpoints nginx-service -n default
                  </code>
                </td>
              </tr>
            </tbody>
          </table>
        </section>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const fields = {
        serviceName:
          document.getElementById("serviceNameInput"),

        namespace:
          document.getElementById("namespaceInput"),

        serviceType:
          document.getElementById("serviceTypeSelect"),

        externalName:
          document.getElementById("externalNameInput"),

        selector:
          document.getElementById("selectorInput"),

        portName:
          document.getElementById("portNameInput"),

        protocol:
          document.getElementById("protocolSelect"),

        servicePort:
          document.getElementById("servicePortInput"),

        targetPort:
          document.getElementById("targetPortInput"),

        nodePort:
          document.getElementById("nodePortInput"),

        sessionAffinity:
          document.getElementById("sessionAffinitySelect"),

        sessionTimeout:
          document.getElementById("sessionTimeoutInput"),

        trafficPolicy:
          document.getElementById("trafficPolicySelect"),

        ipFamilyPolicy:
          document.getElementById("ipFamilyPolicySelect"),

        loadBalancerIP:
          document.getElementById("loadBalancerIPInput"),

        publishNotReady:
          document.getElementById("publishNotReadyInput"),

        allocateNodePorts:
          document.getElementById("allocateNodePortsInput"),

        labels:
          document.getElementById("labelsInput"),

        annotations:
          document.getElementById("annotationsInput"),
      };

      const yamlOutput =
        document.getElementById("yamlOutput");

      const message =
        document.getElementById("message");

      const copyButton =
        document.getElementById("copyButton");

      let currentYaml = "";

      function parseKeyValueLines(value) {
        const result = {};

        value
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .forEach((line) => {
            const separatorIndex =
              line.indexOf("=");

            if (separatorIndex <= 0) {
              return;
            }

            const key = line
              .slice(0, separatorIndex)
              .trim();

            const itemValue = line
              .slice(separatorIndex + 1)
              .trim();

            if (key) {
              result[key] = itemValue;
            }
          });

        return result;
      }

      function escapeYamlString(value) {
        const text = String(value);

        if (
          text === "" ||
          /[:#{}[\],&*?|>'"%@`]/.test(text) ||
          /^\s|\s$/.test(text) ||
          [
            "true",
            "false",
            "null",
            "yes",
            "no",
            "on",
            "off",
          ].includes(text.toLowerCase())
        ) {
          return `"${text
            .replace(/\\/g, "\\\\")
            .replace(/"/g, '\\"')}"`;
        }

        return text;
      }

      function isValidKubernetesName(value) {
        return (
          value.length >= 1 &&
          value.length <= 63 &&
          /^[a-z0-9]([-a-z0-9]*[a-z0-9])?$/.test(value)
        );
      }

      function isValidPort(value) {
        return (
          Number.isInteger(value) &&
          value >= 1 &&
          value <= 65535
        );
      }

      function isValidNodePort(value) {
        return (
          Number.isInteger(value) &&
          value >= 30000 &&
          value <= 32767
        );
      }

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addObjectLines(lines, object, indent) {
        const spacing = " ".repeat(indent);

        Object.entries(object).forEach(
          ([key, value]) => {
            lines.push(
              `${spacing}${key}: ${escapeYamlString(value)}`,
            );
          },
        );
      }

      function validateForm() {
        const serviceName =
          fields.serviceName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        if (!isValidKubernetesName(serviceName)) {
          return "Service name must contain lowercase letters, numbers and hyphens only.";
        }

        if (!isValidKubernetesName(namespace)) {
          return "Namespace must contain lowercase letters, numbers and hyphens only.";
        }

        if (fields.serviceType.value === "ExternalName") {
          const externalName =
            fields.externalName.value.trim();

          if (
            !externalName ||
            !/^[a-z0-9.-]+\.[a-z]{2,}$/i.test(externalName)
          ) {
            return "Enter a valid external DNS hostname.";
          }

          return "";
        }

        const servicePort =
          Number(fields.servicePort.value);

        if (!isValidPort(servicePort)) {
          return "Service port must be between 1 and 65535.";
        }

        const targetPort =
          fields.targetPort.value.trim();

        if (!targetPort) {
          return "Target port is required.";
        }

        const numericTargetPort =
          Number(targetPort);

        if (
          /^\d+$/.test(targetPort) &&
          !isValidPort(numericTargetPort)
        ) {
          return "Target port must be between 1 and 65535.";
        }

        if (
          fields.serviceType.value === "NodePort" &&
          !isValidNodePort(Number(fields.nodePort.value))
        ) {
          return "NodePort must be between 30000 and 32767.";
        }

        const selectors =
          parseKeyValueLines(fields.selector.value);

        if (Object.keys(selectors).length === 0) {
          return "Enter at least one pod selector.";
        }

        return "";
      }

      function generateYaml() {
        clearMessage();

        const validationError =
          validateForm();

        if (validationError) {
          currentYaml = "";
          yamlOutput.textContent = validationError;
          showMessage(validationError, "error");
          return;
        }

        const serviceName =
          fields.serviceName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        const serviceType =
          fields.serviceType.value;

        const labels = {
          app: serviceName,
          ...parseKeyValueLines(fields.labels.value),
        };

        const annotations =
          parseKeyValueLines(fields.annotations.value);

        const lines = [];

        lines.push("apiVersion: v1");
        lines.push("kind: Service");
        lines.push("metadata:");
        lines.push(`  name: ${serviceName}`);
        lines.push(`  namespace: ${namespace}`);
        lines.push("  labels:");

        addObjectLines(lines, labels, 4);

        if (Object.keys(annotations).length > 0) {
          lines.push("  annotations:");
          addObjectLines(lines, annotations, 4);
        }

        lines.push("spec:");

        if (serviceType === "ExternalName") {
          lines.push("  type: ExternalName");
          lines.push(
            `  externalName: ${fields.externalName.value.trim()}`,
          );
        } else {
          if (serviceType === "Headless") {
            lines.push("  clusterIP: None");
            lines.push("  type: ClusterIP");
          } else {
            lines.push(`  type: ${serviceType}`);
          }

          const selectors =
            parseKeyValueLines(fields.selector.value);

          lines.push("  selector:");
          addObjectLines(lines, selectors, 4);

          lines.push("  ports:");
          lines.push(
            `    - name: ${fields.portName.value.trim() || "http"}`,
          );

          lines.push(
            `      protocol: ${fields.protocol.value}`,
          );

          lines.push(
            `      port: ${Number(fields.servicePort.value)}`,
          );

          const targetPort =
            fields.targetPort.value.trim();

          lines.push(
            `      targetPort: ${
              /^\d+$/.test(targetPort)
                ? Number(targetPort)
                : targetPort
            }`,
          );

          if (serviceType === "NodePort") {
            lines.push(
              `      nodePort: ${Number(fields.nodePort.value)}`,
            );
          }

          lines.push(
            `  sessionAffinity: ${fields.sessionAffinity.value}`,
          );

          if (
            fields.sessionAffinity.value === "ClientIP"
          ) {
            lines.push("  sessionAffinityConfig:");
            lines.push("    clientIP:");
            lines.push(
              `      timeoutSeconds: ${Number(fields.sessionTimeout.value)}`,
            );
          }

          if (
            serviceType === "NodePort" ||
            serviceType === "LoadBalancer"
          ) {
            lines.push(
              `  externalTrafficPolicy: ${fields.trafficPolicy.value}`,
            );
          }

          if (fields.ipFamilyPolicy.value) {
            lines.push(
              `  ipFamilyPolicy: ${fields.ipFamilyPolicy.value}`,
            );
          }

          if (
            serviceType === "LoadBalancer" &&
            fields.loadBalancerIP.value.trim()
          ) {
            lines.push(
              `  loadBalancerIP: ${fields.loadBalancerIP.value.trim()}`,
            );
          }

          if (serviceType === "LoadBalancer") {
            lines.push(
              `  allocateLoadBalancerNodePorts: ${fields.allocateNodePorts.checked}`,
            );
          }

          if (fields.publishNotReady.checked) {
            lines.push(
              "  publishNotReadyAddresses: true",
            );
          }
        }

        currentYaml = lines.join("\n");
        yamlOutput.textContent = currentYaml;

        document.getElementById(
          "resultName",
        ).textContent = serviceName;

        document.getElementById(
          "resultNamespace",
        ).textContent = namespace;

        document.getElementById(
          "resultType",
        ).textContent = serviceType;

        document.getElementById(
          "resultPort",
        ).textContent =
          serviceType === "ExternalName"
            ? fields.externalName.value.trim()
            : `${fields.servicePort.value} → ${fields.targetPort.value}`;
      }

      function updateConditionalSections() {
        const serviceType =
          fields.serviceType.value;

        const isExternalName =
          serviceType === "ExternalName";

        document
          .getElementById("externalNameSection")
          .classList.toggle("active", isExternalName);

        document.getElementById(
          "standardServiceSection",
        ).style.display = isExternalName
          ? "none"
          : "block";

        fields.nodePort.disabled =
          serviceType !== "NodePort";

        fields.loadBalancerIP.disabled =
          serviceType !== "LoadBalancer";

        fields.allocateNodePorts.disabled =
          serviceType !== "LoadBalancer";

        fields.trafficPolicy.disabled =
          ![
            "NodePort",
            "LoadBalancer",
          ].includes(serviceType);

        document
          .getElementById("sessionAffinitySection")
          .classList.toggle(
            "active",
            fields.sessionAffinity.value === "ClientIP",
          );

        generateYaml();
      }

      function applyPreset(preset) {
        if (preset === "clusterip") {
          fields.serviceType.value = "ClusterIP";
          fields.serviceName.value = "nginx-service";
          fields.selector.value = "app=nginx";
          fields.servicePort.value = "80";
          fields.targetPort.value = "80";
          fields.portName.value = "http";
        }

        if (preset === "nodeport") {
          fields.serviceType.value = "NodePort";
          fields.serviceName.value = "nginx-nodeport";
          fields.selector.value = "app=nginx";
          fields.servicePort.value = "80";
          fields.targetPort.value = "80";
          fields.nodePort.value = "30080";
          fields.portName.value = "http";
        }

        if (preset === "loadbalancer") {
          fields.serviceType.value = "LoadBalancer";
          fields.serviceName.value = "nginx-loadbalancer";
          fields.selector.value = "app=nginx";
          fields.servicePort.value = "80";
          fields.targetPort.value = "80";
          fields.portName.value = "http";
        }

        if (preset === "headless") {
          fields.serviceType.value = "Headless";
          fields.serviceName.value = "worker-headless";
          fields.selector.value = "app=worker";
          fields.servicePort.value = "5432";
          fields.targetPort.value = "5432";
          fields.portName.value = "http";
        }

        updateConditionalSections();
      }

      function resetGenerator() {
        fields.serviceName.value = "nginx-service";
        fields.namespace.value = "default";
        fields.serviceType.value = "ClusterIP";
        fields.externalName.value =
          "internal.example.com";
        fields.selector.value = "app=nginx";
        fields.portName.value = "http";
        fields.protocol.value = "TCP";
        fields.servicePort.value = "80";
        fields.targetPort.value = "80";
        fields.nodePort.value = "30080";
        fields.sessionAffinity.value = "None";
        fields.sessionTimeout.value = "10800";
        fields.trafficPolicy.value = "Cluster";
        fields.ipFamilyPolicy.value = "";
        fields.loadBalancerIP.value = "";
        fields.publishNotReady.checked = false;
        fields.allocateNodePorts.checked = true;
        fields.labels.value = "";
        fields.annotations.value = "";

        clearMessage();
        updateConditionalSections();
      }

      async function copyYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate valid Service YAML before copying.",
            "error",
          );
          return;
        }

        try {
          await navigator.clipboard.writeText(currentYaml);

          const originalText =
            copyButton.textContent;

          copyButton.textContent = "Copied!";

          showMessage(
            "Service YAML copied successfully.",
            "success",
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Copy the YAML manually.",
            "error",
          );
        }
      }

      function downloadYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate valid Service YAML before downloading.",
            "error",
          );
          return;
        }

        const blob = new Blob([currentYaml], {
          type: "application/yaml;charset=utf-8",
        });

        const url =
          URL.createObjectURL(blob);

        const anchor =
          document.createElement("a");

        anchor.href = url;
        anchor.download =
          `${fields.serviceName.value.trim() || "service"}.yaml`;

        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();

        URL.revokeObjectURL(url);

        showMessage(
          "Service YAML downloaded successfully.",
          "success",
        );
      }

      document
        .getElementById("generateButton")
        .addEventListener("click", generateYaml);

      document
        .getElementById("resetButton")
        .addEventListener("click", resetGenerator);

      copyButton.addEventListener("click", copyYaml);

      document
        .getElementById("downloadButton")
        .addEventListener("click", downloadYaml);

      Object.values(fields).forEach((field) => {
        field.addEventListener("input", generateYaml);
        field.addEventListener(
          "change",
          updateConditionalSections,
        );
      });

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            applyPreset(button.dataset.preset || "");
          });
        });

      updateConditionalSections();
    </script>
  </body>
</html>