---
const pageTitle =
  "Kubernetes Deployment Generator | Gokuruvi Tools";

const description =
  "Generate Kubernetes Deployment YAML manifests with container images, replicas, ports, environment variables, resources, probes, security context, volumes, node selectors, tolerations, and image pull secrets.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/kubernetes/deployment-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1200px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(
          135deg,
          #eff6ff,
          #f8fafc
        );
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 860px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1200px;
        margin: 0 auto;
        grid-template-columns:
          minmax(0, 0.95fr)
          minmax(0, 1.05fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow:
          0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .section-title {
        margin: 28px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--dark);
        font-size: 18px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .input-row {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .input-row.three {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      textarea {
        min-height: 95px;
        resize: vertical;
        font-family:
          Consolas, "Courier New", monospace;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow:
          0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled,
      textarea:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .conditional-section {
        display: none;
        margin-top: 14px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .conditional-section.active {
        display: block;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .yaml-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
      }

      .yaml-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .yaml-output {
        min-height: 640px;
        margin: 0;
        overflow: auto;
        color: #e2e8f0;
        white-space: pre;
        font-family:
          Consolas, "Courier New", monospace;
        font-size: 14px;
        line-height: 1.65;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family:
          Consolas, "Courier New", monospace;
        font-size: 14px;
        font-weight: 800;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--info-border);
        border-radius: 11px;
        background: var(--info-bg);
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: var(--info-text);
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: var(--info-text);
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1200px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family:
          Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 920px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }

        .yaml-output {
          min-height: 500px;
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .input-row.three,
        .checkbox-grid,
        .result-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">
          Gokuruvi Tools
        </a>

        <nav
          class="navigation"
          aria-label="Main navigation"
        >
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a
            class="active"
            href="/kubernetes"
          >
            Kubernetes
          </a>
          <a href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Kubernetes Deployment Generator</h1>

        <p>
          Generate production-ready Kubernetes
          Deployment YAML with replicas, images,
          ports, resources, environment variables,
          probes, security settings, scheduling
          options, volumes, and image pull secrets.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Deployment Configuration</h2>

            <p class="card-description">
              Enter your application settings. The YAML
              preview updates automatically.
            </p>

            <div class="preset-title">
              Application templates
            </div>

            <div class="preset-buttons">
              <button
                class="preset"
                type="button"
                data-preset="nginx"
              >
                NGINX
              </button>

              <button
                class="preset"
                type="button"
                data-preset="apache"
              >
                Apache
              </button>

              <button
                class="preset"
                type="button"
                data-preset="node"
              >
                Node.js
              </button>

              <button
                class="preset"
                type="button"
                data-preset="python"
              >
                Python
              </button>

              <button
                class="preset"
                type="button"
                data-preset="spring"
              >
                Spring Boot
              </button>

              <button
                class="preset"
                type="button"
                data-preset="redis"
              >
                Redis
              </button>
            </div>

            <h3 class="section-title">
              Basic Settings
            </h3>

            <div class="input-row">
              <div class="form-group">
                <label for="deploymentNameInput">
                  Deployment name
                </label>

                <input
                  id="deploymentNameInput"
                  type="text"
                  value="nginx-app"
                  placeholder="Example: nginx-app"
                  maxlength="63"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>

              <div class="form-group">
                <label for="namespaceInput">
                  Namespace
                </label>

                <input
                  id="namespaceInput"
                  type="text"
                  value="default"
                  placeholder="Example: default"
                  maxlength="63"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="replicasInput">
                  Replicas
                </label>

                <input
                  id="replicasInput"
                  type="number"
                  value="2"
                  min="0"
                  max="1000"
                />
              </div>

              <div class="form-group">
                <label for="strategySelect">
                  Update strategy
                </label>

                <select id="strategySelect">
                  <option
                    value="RollingUpdate"
                    selected
                  >
                    RollingUpdate
                  </option>

                  <option value="Recreate">
                    Recreate
                  </option>
                </select>
              </div>
            </div>

            <div
              id="rollingUpdateSection"
              class="conditional-section active"
            >
              <div class="input-row">
                <div class="form-group">
                  <label for="maxUnavailableInput">
                    Max unavailable
                  </label>

                  <input
                    id="maxUnavailableInput"
                    type="text"
                    value="25%"
                    placeholder="Example: 25% or 1"
                  />
                </div>

                <div class="form-group">
                  <label for="maxSurgeInput">
                    Max surge
                  </label>

                  <input
                    id="maxSurgeInput"
                    type="text"
                    value="25%"
                    placeholder="Example: 25% or 1"
                  />
                </div>
              </div>
            </div>

            <h3 class="section-title">
              Container
            </h3>

            <div class="form-group">
              <label for="imageInput">
                Container image
              </label>

              <input
                id="imageInput"
                type="text"
                value="nginx:latest"
                placeholder="Example: nginx:1.27"
                autocomplete="off"
                spellcheck="false"
              />
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="containerNameInput">
                  Container name
                </label>

                <input
                  id="containerNameInput"
                  type="text"
                  value="nginx-app"
                  placeholder="Example: nginx-app"
                  maxlength="63"
                />
              </div>

              <div class="form-group">
                <label for="pullPolicySelect">
                  Image pull policy
                </label>

                <select id="pullPolicySelect">
                  <option value="Always">
                    Always
                  </option>

                  <option
                    value="IfNotPresent"
                    selected
                  >
                    IfNotPresent
                  </option>

                  <option value="Never">
                    Never
                  </option>
                </select>
              </div>
            </div>

            <div class="input-row three">
              <div class="form-group">
                <label for="containerPortInput">
                  Container port
                </label>

                <input
                  id="containerPortInput"
                  type="number"
                  value="80"
                  min="1"
                  max="65535"
                />
              </div>

              <div class="form-group">
                <label for="portNameInput">
                  Port name
                </label>

                <input
                  id="portNameInput"
                  type="text"
                  value="http"
                  placeholder="Example: http"
                />
              </div>

              <div class="form-group">
                <label for="protocolSelect">
                  Protocol
                </label>

                <select id="protocolSelect">
                  <option value="TCP" selected>
                    TCP
                  </option>

                  <option value="UDP">
                    UDP
                  </option>

                  <option value="SCTP">
                    SCTP
                  </option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="commandInput">
                Command
              </label>

              <input
                id="commandInput"
                type="text"
                placeholder='Optional: nginx,-g'
              />

              <p class="help-text">
                Enter comma-separated command values.
              </p>
            </div>

            <div class="form-group">
              <label for="argsInput">
                Arguments
              </label>

              <input
                id="argsInput"
                type="text"
                placeholder='Optional: daemon off;'
              />

              <p class="help-text">
                Enter comma-separated argument values.
              </p>
            </div>

            <h3 class="section-title">
              Labels and Environment
            </h3>

            <div class="form-group">
              <label for="additionalLabelsInput">
                Additional labels
              </label>

              <textarea
                id="additionalLabelsInput"
                placeholder="team=platform&#10;environment=production"
              ></textarea>

              <p class="help-text">
                Enter one key=value label per line.
              </p>
            </div>

            <div class="form-group">
              <label for="environmentInput">
                Environment variables
              </label>

              <textarea
                id="environmentInput"
                placeholder="APP_ENV=production&#10;LOG_LEVEL=info"
              ></textarea>

              <p class="help-text">
                Enter one NAME=value variable per line.
              </p>
            </div>

            <h3 class="section-title">
              Resource Requests and Limits
            </h3>

            <div class="input-row">
              <div class="form-group">
                <label for="cpuRequestInput">
                  CPU request
                </label>

                <input
                  id="cpuRequestInput"
                  type="text"
                  value="100m"
                  placeholder="Example: 100m"
                />
              </div>

              <div class="form-group">
                <label for="memoryRequestInput">
                  Memory request
                </label>

                <input
                  id="memoryRequestInput"
                  type="text"
                  value="128Mi"
                  placeholder="Example: 128Mi"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="cpuLimitInput">
                  CPU limit
                </label>

                <input
                  id="cpuLimitInput"
                  type="text"
                  value="500m"
                  placeholder="Example: 500m"
                />
              </div>

              <div class="form-group">
                <label for="memoryLimitInput">
                  Memory limit
                </label>

                <input
                  id="memoryLimitInput"
                  type="text"
                  value="512Mi"
                  placeholder="Example: 512Mi"
                />
              </div>
            </div>

            <h3 class="section-title">
              Health Probes
            </h3>

            <div class="checkbox-grid">
              <div class="checkbox-item">
                <input
                  id="readinessEnabledInput"
                  type="checkbox"
                  checked
                />

                <label for="readinessEnabledInput">
                  Readiness probe
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="livenessEnabledInput"
                  type="checkbox"
                  checked
                />

                <label for="livenessEnabledInput">
                  Liveness probe
                </label>
              </div>

              <div class="checkbox-item">
                <input
                  id="startupEnabledInput"
                  type="checkbox"
                />

                <label for="startupEnabledInput">
                  Startup probe
                </label>
              </div>
            </div>

            <div
              id="probeSettingsSection"
              class="conditional-section active"
            >
              <div class="input-row">
                <div class="form-group">
                  <label for="probeTypeSelect">
                    Probe type
                  </label>

                  <select id="probeTypeSelect">
                    <option
                      value="http"
                      selected
                    >
                      HTTP GET
                    </option>

                    <option value="tcp">
                      TCP socket
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="probePathInput">
                    HTTP path
                  </label>

                  <input
                    id="probePathInput"
                    type="text"
                    value="/"
                    placeholder="Example: /health"
                  />
                </div>
              </div>

              <div class="input-row three">
                <div class="form-group">
                  <label for="initialDelayInput">
                    Initial delay
                  </label>

                  <input
                    id="initialDelayInput"
                    type="number"
                    value="10"
                    min="0"
                  />
                </div>

                <div class="form-group">
                  <label for="periodSecondsInput">
                    Period
                  </label>

                  <input
                    id="periodSecondsInput"
                    type="number"
                    value="10"
                    min="1"
                  />
                </div>

                <div class="form-group">
                  <label for="timeoutSecondsInput">
                    Timeout
