          ),

        volumeEnabled:
          document.getElementById(
            "volumeEnabledInput",
          ),

        volumeName:
          document.getElementById(
            "volumeNameInput",
          ),

        mountPath:
          document.getElementById(
            "mountPathInput",
          ),

        volumeType:
          document.getElementById(
            "volumeTypeSelect",
          ),

        volumeSource:
          document.getElementById(
            "volumeSourceInput",
          ),

        volumeReadOnly:
          document.getElementById(
            "volumeReadOnlyInput",
          ),

        revisionHistory:
          document.getElementById(
            "revisionHistoryInput",
          ),

        progressDeadline:
          document.getElementById(
            "progressDeadlineInput",
          ),
      };

      const yamlOutput =
        document.getElementById("yamlOutput");

      const message =
        document.getElementById("message");

      const explanationList =
        document.getElementById(
          "explanationList",
        );

      const copyButton =
        document.getElementById("copyButton");

      const downloadButton =
        document.getElementById(
          "downloadButton",
        );

      let currentYaml = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function escapeYamlString(value) {
        const text = String(value);

        if (
          text === "" ||
          /[:#{}[\],&*?|>'"%@`]/.test(text) ||
          /^\s|\s$/.test(text) ||
          [
            "true",
            "false",
            "null",
            "yes",
            "no",
            "on",
            "off",
          ].includes(text.toLowerCase())
        ) {
          return `"${text
            .replace(/\\/g, "\\\\")
            .replace(/"/g, '\\"')}"`;
        }

        return text;
      }

      function parseKeyValueLines(value) {
        const result = {};

        value
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .forEach((line) => {
            const separatorIndex =
              line.indexOf("=");

            if (separatorIndex <= 0) {
              return;
            }

            const key = line
              .slice(0, separatorIndex)
              .trim();

            const itemValue = line
              .slice(separatorIndex + 1)
              .trim();

            if (key) {
              result[key] = itemValue;
            }
          });

        return result;
      }

      function parseCsv(value) {
        return value
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean);
      }

      function parseTolerations(value) {
        return value
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const toleration = {};

            line
              .split(",")
              .map((part) => part.trim())
              .filter(Boolean)
              .forEach((part) => {
                const index = part.indexOf("=");

                if (index > 0) {
                  const key = part
                    .slice(0, index)
                    .trim();

                  const itemValue = part
                    .slice(index + 1)
                    .trim();

                  toleration[key] = itemValue;
                }
              });

            return toleration;
          })
          .filter(
            (item) =>
              Object.keys(item).length > 0,
          );
      }

      function isValidKubernetesName(value) {
        return (
          value.length >= 1 &&
          value.length <= 63 &&
          /^[a-z0-9]([-a-z0-9]*[a-z0-9])?$/.test(
            value,
          )
        );
      }

      function isValidPort(value) {
        return (
          Number.isInteger(value) &&
          value >= 1 &&
          value <= 65535
        );
      }

      function addObjectLines(
        lines,
        object,
        indent,
      ) {
        const spacing = " ".repeat(indent);

        Object.entries(object).forEach(
          ([key, value]) => {
            lines.push(
              `${spacing}${key}: ${escapeYamlString(
                value,
              )}`,
            );
          },
        );
      }

      function buildProbeLines(
        lines,
        probeName,
        indent,
      ) {
        const spacing = " ".repeat(indent);
        const childSpacing =
          " ".repeat(indent + 2);

        lines.push(`${spacing}${probeName}:`);

        if (fields.probeType.value === "http") {
          lines.push(`${childSpacing}httpGet:`);
          lines.push(
            `${childSpacing}  path: ${escapeYamlString(
              fields.probePath.value.trim() ||
                "/",
            )}`,
          );

          lines.push(
            `${childSpacing}  port: ${Number(
              fields.containerPort.value,
            )}`,
          );

          lines.push(
            `${childSpacing}  scheme: HTTP`,
          );
        } else {
          lines.push(`${childSpacing}tcpSocket:`);
          lines.push(
            `${childSpacing}  port: ${Number(
              fields.containerPort.value,
            )}`,
          );
        }

        lines.push(
          `${childSpacing}initialDelaySeconds: ${Number(
            fields.initialDelay.value,
          )}`,
        );

        lines.push(
          `${childSpacing}periodSeconds: ${Number(
            fields.period.value,
          )}`,
        );

        lines.push(
          `${childSpacing}timeoutSeconds: ${Number(
            fields.timeout.value,
          )}`,
        );

        lines.push(
          `${childSpacing}failureThreshold: ${Number(
            fields.failureThreshold.value,
          )}`,
        );

        lines.push(
          `${childSpacing}successThreshold: ${Number(
            fields.successThreshold.value,
          )}`,
        );
      }

      function validateForm() {
        const deploymentName =
          fields.deploymentName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        const containerName =
          fields.containerName.value.trim();

        const replicas = Number(
          fields.replicas.value,
        );

        const port = Number(
          fields.containerPort.value,
        );

        if (
          !isValidKubernetesName(deploymentName)
        ) {
          return "Deployment name must use lowercase letters, numbers and hyphens, and must be 63 characters or fewer.";
        }

        if (!isValidKubernetesName(namespace)) {
          return "Namespace must use lowercase letters, numbers and hyphens.";
        }

        if (
          !isValidKubernetesName(containerName)
        ) {
          return "Container name must use lowercase letters, numbers and hyphens.";
        }

        if (!fields.image.value.trim()) {
          return "Container image is required.";
        }

        if (
          !Number.isInteger(replicas) ||
          replicas < 0 ||
          replicas > 1000
        ) {
          return "Replicas must be a whole number between 0 and 1000.";
        }

        if (!isValidPort(port)) {
          return "Container port must be between 1 and 65535.";
        }

        if (
          fields.volumeEnabled.checked &&
          !isValidKubernetesName(
            fields.volumeName.value.trim(),
          )
        ) {
          return "Volume name must be a valid Kubernetes name.";
        }

        if (
          fields.volumeEnabled.checked &&
          !fields.mountPath.value
            .trim()
            .startsWith("/")
        ) {
          return "Volume mount path must start with /.";
        }

        if (
          fields.volumeEnabled.checked &&
          fields.volumeType.value !==
            "emptyDir" &&
          !fields.volumeSource.value.trim()
        ) {
          return "A source name is required for the selected volume type.";
        }

        return "";
      }

      function generateYaml() {
        clearMessage();

        const validationError =
          validateForm();

        if (validationError) {
          currentYaml = "";
          yamlOutput.textContent =
            validationError;

          explanationList.innerHTML = "";

          showMessage(
            validationError,
            "error",
          );

          return;
        }

        const deploymentName =
          fields.deploymentName.value.trim();

        const namespace =
          fields.namespace.value.trim();

        const containerName =
          fields.containerName.value.trim();

        const replicas = Number(
          fields.replicas.value,
        );

        const containerPort = Number(
          fields.containerPort.value,
        );

        const labels = {
          app: deploymentName,
          ...parseKeyValueLines(
            fields.labels.value,
          ),
        };

        const environment =
          parseKeyValueLines(
            fields.environment.value,
          );

        const nodeSelector =
          parseKeyValueLines(
            fields.nodeSelector.value,
          );

        const tolerations =
          parseTolerations(
            fields.tolerations.value,
          );

        const command = parseCsv(
          fields.command.value,
        );

        const args = parseCsv(
          fields.args.value,
        );

        const lines = [];

        lines.push("apiVersion: apps/v1");
        lines.push("kind: Deployment");
        lines.push("metadata:");
        lines.push(`  name: ${deploymentName}`);
        lines.push(`  namespace: ${namespace}`);
        lines.push("  labels:");

        addObjectLines(lines, labels, 4);

        lines.push("spec:");
        lines.push(`  replicas: ${replicas}`);

        lines.push(
          `  revisionHistoryLimit: ${Number(
            fields.revisionHistory.value,
          )}`,
        );

        lines.push(
          `  progressDeadlineSeconds: ${Number(
            fields.progressDeadline.value,
          )}`,
        );

        lines.push("  selector:");
        lines.push("    matchLabels:");
        lines.push(
          `      app: ${deploymentName}`,
        );

        lines.push("  strategy:");
        lines.push(
          `    type: ${fields.strategy.value}`,
        );

        if (
          fields.strategy.value ===
          "RollingUpdate"
        ) {
          lines.push("    rollingUpdate:");
          lines.push(
            `      maxUnavailable: ${escapeYamlString(
              fields.maxUnavailable.value.trim() ||
                "25%",
            )}`,
          );

          lines.push(
            `      maxSurge: ${escapeYamlString(
              fields.maxSurge.value.trim() ||
                "25%",
            )}`,
          );
        }

        lines.push("  template:");
        lines.push("    metadata:");
        lines.push("      labels:");

        addObjectLines(lines, labels, 8);

        lines.push("    spec:");

        lines.push(
          `      automountServiceAccountToken: ${fields.automountToken.checked}`,
        );

        if (
          fields.serviceAccount.value.trim()
        ) {
          lines.push(
            `      serviceAccountName: ${fields.serviceAccount.value.trim()}`,
          );
        }

        if (
          fields.imagePullSecret.value.trim()
        ) {
          lines.push("      imagePullSecrets:");
          lines.push(
            `        - name: ${fields.imagePullSecret.value.trim()}`,
          );
        }

        if (
          Object.keys(nodeSelector).length > 0
        ) {
          lines.push("      nodeSelector:");
          addObjectLines(
            lines,
            nodeSelector,
            8,
          );
        }

        if (tolerations.length > 0) {
          lines.push("      tolerations:");

          tolerations.forEach(
            (toleration) => {
              lines.push("        -");

              Object.entries(
                toleration,
              ).forEach(([key, value]) => {
                lines.push(
                  `          ${key}: ${escapeYamlString(
                    value,
                  )}`,
                );
              });
            },
          );
        }

        lines.push("      securityContext:");
        lines.push(
          `        runAsNonRoot: ${fields.runAsNonRoot.checked}`,
        );

        if (fields.runAsNonRoot.checked) {
          lines.push(
            `        runAsUser: ${Number(
              fields.runAsUser.value,
            )}`,
          );

          lines.push(
            `        runAsGroup: ${Number(
              fields.runAsGroup.value,
            )}`,
          );

          lines.push(
            `        fsGroup: ${Number(
              fields.runAsGroup.value,
            )}`,
          );
        }

        lines.push("      containers:");
        lines.push(`        - name: ${containerName}`);
        lines.push(
          `          image: ${escapeYamlString(
            fields.image.value.trim(),
          )}`,
        );

        lines.push(
          `          imagePullPolicy: ${fields.pullPolicy.value}`,
        );

        if (command.length > 0) {
          lines.push("          command:");

          command.forEach((item) => {
            lines.push(
              `            - ${escapeYamlString(
                item,
              )}`,
            );
          });
        }

        if (args.length > 0) {
          lines.push("          args:");

          args.forEach((item) => {
            lines.push(
              `            - ${escapeYamlString(
                item,
              )}`,
            );
          });
        }

        lines.push("          ports:");
        lines.push(
          `            - name: ${fields.portName.value.trim() || "http"}`,
        );
        lines.push(
          `              containerPort: ${containerPort}`,
        );
        lines.push(
          `              protocol: ${fields.protocol.value}`,
        );

        if (
          Object.keys(environment).length > 0
        ) {
          lines.push("          env:");

          Object.entries(environment).forEach(
            ([name, value]) => {
              lines.push(
                `            - name: ${name}`,
              );

              lines.push(
                `              value: ${escapeYamlString(
                  value,
                )}`,
              );
            },
          );
        }

        lines.push("          resources:");
        lines.push("            requests:");
        lines.push(
          `              cpu: ${escapeYamlString(
            fields.cpuRequest.value.trim(),
          )}`,
        );
        lines.push(
          `              memory: ${escapeYamlString(
            fields.memoryRequest.value.trim(),
          )}`,
        );
        lines.push("            limits:");
        lines.push(
          `              cpu: ${escapeYamlString(
            fields.cpuLimit.value.trim(),
          )}`,
        );
        lines.push(
          `              memory: ${escapeYamlString(
            fields.memoryLimit.value.trim(),
          )}`,
        );

        lines.push(
          "          securityContext:",
        );

        lines.push(
          `            allowPrivilegeEscalation: false`,
        );

        lines.push(
          `            readOnlyRootFilesystem: ${fields.readOnlyRoot.checked}`,
        );

        if (
          fields.dropCapabilities.checked
        ) {
          lines.push(
            "            capabilities:",
          );
          lines.push("              drop:");
          lines.push(
            '                - "ALL"',
          );
        }

        if (fields.readiness.checked) {
          buildProbeLines(
            lines,
            "readinessProbe",
            10,
          );
        }

        if (fields.liveness.checked) {
          buildProbeLines(
            lines,
            "livenessProbe",
            10,
          );
        }

        if (fields.startup.checked) {
          buildProbeLines(
            lines,
            "startupProbe",
            10,
          );
        }

        if (fields.volumeEnabled.checked) {
          lines.push(
            "          volumeMounts:",
          );
          lines.push(
            `            - name: ${fields.volumeName.value.trim()}`,
          );
          lines.push(
            `              mountPath: ${escapeYamlString(
              fields.mountPath.value.trim(),
            )}`,
          );

          if (
            fields.volumeReadOnly.checked
          ) {
            lines.push(
              "              readOnly: true",
            );
          }

          lines.push("      volumes:");
          lines.push(
            `        - name: ${fields.volumeName.value.trim()}`,
          );

          const sourceName =
            fields.volumeSource.value.trim();

          if (
            fields.volumeType.value ===
            "emptyDir"
          ) {
            lines.push(
              "          emptyDir: {}",
            );
          }

          if (
            fields.volumeType.value ===
            "configMap"
          ) {
            lines.push(
              "          configMap:",
            );
            lines.push(
              `            name: ${sourceName}`,
            );
          }

          if (
            fields.volumeType.value ===
            "secret"
          ) {
            lines.push("          secret:");
            lines.push(
              `            secretName: ${sourceName}`,
            );
          }

          if (
            fields.volumeType.value ===
            "pvc"
          ) {
            lines.push(
              "          persistentVolumeClaim:",
            );
            lines.push(
              `            claimName: ${sourceName}`,
            );
          }
        }

        currentYaml = lines.join("\n");

        yamlOutput.textContent = currentYaml;

        document.getElementById(
          "resultDeployment",
        ).textContent = deploymentName;

        document.getElementById(
          "resultNamespace",
        ).textContent = namespace;

        document.getElementById(
          "resultReplicas",
        ).textContent = String(replicas);

        document.getElementById(
          "resultStrategy",
        ).textContent =
          fields.strategy.value;

        document.getElementById(
          "resultImage",
        ).textContent =
          fields.image.value.trim();

        explanationList.innerHTML = "";

        const explanations = [
          `Creates Deployment ${deploymentName} in namespace ${namespace}.`,
          `Runs ${replicas} replica${replicas === 1 ? "" : "s"} using image ${fields.image.value.trim()}.`,
          `Exposes container port ${containerPort}/${fields.protocol.value}.`,
          `Uses ${fields.strategy.value} as the deployment update strategy.`,
          "Includes CPU and memory requests and limits.",
        ];

        if (
          fields.readiness.checked ||
          fields.liveness.checked ||
          fields.startup.checked
        ) {
          explanations.push(
            "Health probes are enabled for container monitoring.",
          );
        }

        if (fields.runAsNonRoot.checked) {
          explanations.push(
            `The pod runs as non-root user ${fields.runAsUser.value}.`,
          );
        }

        if (fields.volumeEnabled.checked) {
          explanations.push(
            `Mounts ${fields.volumeName.value.trim()} at ${fields.mountPath.value.trim()}.`,
          );
        }

        explanations.forEach((text) => {
          const item =
            document.createElement("li");

          item.textContent = text;
          explanationList.appendChild(item);
        });
      }

      function updateConditionalSections() {
        document
          .getElementById(
            "rollingUpdateSection",
          )
          .classList.toggle(
            "active",
            fields.strategy.value ===
              "RollingUpdate",
          );

        const probesEnabled =
          fields.readiness.checked ||
          fields.liveness.checked ||
          fields.startup.checked;

        document
          .getElementById(
            "probeSettingsSection",
          )
          .classList.toggle(
            "active",
            probesEnabled,
          );

        document
          .getElementById("volumeSection")
          .classList.toggle(
            "active",
            fields.volumeEnabled.checked,
          );

        fields.volumeSource.disabled =
          !fields.volumeEnabled.checked ||
          fields.volumeType.value ===
            "emptyDir";

        fields.probePath.disabled =
          fields.probeType.value !== "http";

        generateYaml();
      }

      function applyPreset(preset) {
        const presets = {
          nginx: {
            name: "nginx-app",
            image: "nginx:1.27",
            port: 80,
            portName: "http",
            cpuRequest: "100m",
            memoryRequest: "128Mi",
            cpuLimit: "500m",
            memoryLimit: "512Mi",
            path: "/",
          },

          apache: {
            name: "apache-app",
            image: "httpd:2.4",
            port: 80,
            portName: "http",
            cpuRequest: "100m",
            memoryRequest: "128Mi",
            cpuLimit: "500m",
            memoryLimit: "512Mi",
            path: "/",
          },

          node: {
            name: "node-app",
            image: "node:22-alpine",
            port: 3000,
            portName: "http",
            cpuRequest: "100m",
            memoryRequest: "128Mi",
            cpuLimit: "500m",
            memoryLimit: "512Mi",
            path: "/health",
          },

          python: {
            name: "python-app",
            image: "python:3.13-slim",
            port: 8000,
            portName: "http",
            cpuRequest: "100m",
            memoryRequest: "128Mi",
            cpuLimit: "500m",
            memoryLimit: "512Mi",
            path: "/health",
          },

          spring: {
            name: "spring-app",
            image: "eclipse-temurin:21-jre",
            port: 8080,
            portName: "http",
            cpuRequest: "250m",
            memoryRequest: "512Mi",
            cpuLimit: "1000m",
            memoryLimit: "1Gi",
            path: "/actuator/health",
          },

          redis: {
            name: "redis",
            image: "redis:7-alpine",
            port: 6379,
            portName: "redis",
            cpuRequest: "100m",
            memoryRequest: "128Mi",
            cpuLimit: "500m",
            memoryLimit: "512Mi",
            path: "/",
          },
        };

        const selected = presets[preset];

        if (!selected) {
          return;
        }

        fields.deploymentName.value =
          selected.name;

        fields.containerName.value =
          selected.name;

        fields.image.value =
          selected.image;

        fields.containerPort.value =
          String(selected.port);

        fields.portName.value =
          selected.portName;

        fields.cpuRequest.value =
          selected.cpuRequest;

        fields.memoryRequest.value =
          selected.memoryRequest;

        fields.cpuLimit.value =
          selected.cpuLimit;

        fields.memoryLimit.value =
          selected.memoryLimit;

        fields.probePath.value =
          selected.path;

        if (preset === "redis") {
          fields.probeType.value = "tcp";
        } else {
          fields.probeType.value = "http";
        }

        updateConditionalSections();
      }

      function resetGenerator() {
        fields.deploymentName.value =
          "nginx-app";

        fields.namespace.value =
          "default";

        fields.replicas.value = "2";
        fields.strategy.value =
          "RollingUpdate";

        fields.maxUnavailable.value =
          "25%";

        fields.maxSurge.value = "25%";
        fields.image.value =
          "nginx:latest";

        fields.containerName.value =
          "nginx-app";

        fields.pullPolicy.value =
          "IfNotPresent";

        fields.containerPort.value =
          "80";

        fields.portName.value = "http";
        fields.protocol.value = "TCP";
        fields.command.value = "";
        fields.args.value = "";
        fields.labels.value = "";
        fields.environment.value = "";

        fields.cpuRequest.value = "100m";
        fields.memoryRequest.value =
          "128Mi";

        fields.cpuLimit.value = "500m";
        fields.memoryLimit.value =
          "512Mi";

        fields.readiness.checked = true;
        fields.liveness.checked = true;
        fields.startup.checked = false;

        fields.probeType.value = "http";
        fields.probePath.value = "/";
        fields.initialDelay.value = "10";
        fields.period.value = "10";
        fields.timeout.value = "2";
        fields.failureThreshold.value =
          "3";

        fields.successThreshold.value =
          "1";

        fields.serviceAccount.value = "";
        fields.imagePullSecret.value = "";

        fields.runAsNonRoot.checked =
          true;

        fields.readOnlyRoot.checked =
          false;

        fields.dropCapabilities.checked =
          true;

        fields.automountToken.checked =
          true;

        fields.runAsUser.value = "1000";
        fields.runAsGroup.value = "1000";

        fields.nodeSelector.value = "";
        fields.tolerations.value = "";

        fields.volumeEnabled.checked =
          false;

        fields.volumeName.value =
          "app-data";

        fields.mountPath.value =
          "/app/data";

        fields.volumeType.value =
          "emptyDir";

        fields.volumeSource.value = "";

        fields.volumeReadOnly.checked =
          false;

        fields.revisionHistory.value =
          "10";

        fields.progressDeadline.value =
          "600";

        clearMessage();
        updateConditionalSections();

        fields.deploymentName.focus();
      }

      async function copyYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate a valid Deployment YAML before copying.",
            "error",
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentYaml,
          );

          const originalText =
            copyButton.textContent;

          copyButton.textContent =
            "Copied!";

          showMessage(
            "Deployment YAML copied successfully.",
            "success",
          );

          setTimeout(() => {
            copyButton.textContent =
              originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the YAML manually.",
            "error",
          );
        }
      }

      function downloadYaml() {
        if (!currentYaml) {
          showMessage(
            "Generate a valid Deployment YAML before downloading.",
            "error",
          );

          return;
        }

        const blob = new Blob(
          [currentYaml],
          {
            type: "application/yaml;charset=utf-8",
          },
        );

        const url =
          URL.createObjectURL(blob);

        const anchor =
          document.createElement("a");

        anchor.href = url;
        anchor.download =
          `${fields.deploymentName.value.trim() || "deployment"}.yaml`;

        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();

        URL.revokeObjectURL(url);

        showMessage(
          "Deployment YAML downloaded successfully.",
          "success",
        );
      }

      document
        .getElementById("generateButton")
        .addEventListener(
          "click",
          generateYaml,
        );

      document
        .getElementById("resetButton")
        .addEventListener(
          "click",
          resetGenerator,
        );

      copyButton.addEventListener(
        "click",
        copyYaml,
      );

      downloadButton.addEventListener(
        "click",
        downloadYaml,
      );

      Object.values(fields).forEach(
        (field) => {
          field.addEventListener(
            "input",
            generateYaml,
          );

          field.addEventListener(
            "change",
            updateConditionalSections,
          );
        },
      );

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              applyPreset(
                button.dataset.preset || "",
              );
            },
          );
        });

      updateConditionalSections();
    </script>
  </body>
</html>