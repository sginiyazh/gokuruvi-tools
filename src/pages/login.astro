---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm.astro";

if (await Astro.session?.get("user")) return Astro.redirect("/bot/");
Astro.response.headers.set("cache-control", "private, no-store");
---
<Layout title="Log in to GokuruviBot AI" description="Log in to GokuruviBot AI, the free IT help assistant on Gokuruvi Tools." noindex>
  <AuthForm mode="login" />
</Layout>
