---
const pageTitle = "IPv4 to Binary Converter | Gokuruvi Tools";
const description =
  "Free IPv4 to binary converter to convert any valid IPv4 address into 32-bit binary, hexadecimal, decimal, and octet formats.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/ipv4-to-binary"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;
        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1120px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 760px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1080px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input {
        width: 100%;
        min-height: 50px;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      .help-text {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .result-placeholder {
        padding: 45px 20px;
        color: var(--muted);
        text-align: center;
      }

      .result-placeholder span {
        display: block;
        margin-bottom: 12px;
        font-size: 48px;
      }

      .results {
        display: none;
      }

      .results.active {
        display: block;
      }

      .result-summary {
        margin-bottom: 18px;
        padding: 16px;
        border: 1px solid #bfdbfe;
        border-radius: 11px;
        background: #eff6ff;
        color: #1e3a8a;
      }

      .result-summary strong {
        display: block;
        margin-bottom: 4px;
      }

      .binary-output {
        padding: 20px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
        overflow-x: auto;
      }

      .binary-output-label {
        display: block;
        margin-bottom: 8px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .binary-output-value {
        display: block;
        white-space: nowrap;
        font-family: Consolas, "Courier New", monospace;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 1px;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 16px;
        font-weight: 800;
      }

      .octet-section {
        margin-top: 20px;
      }

      .octet-section h3 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: 18px;
      }

      .octet-table {
        width: 100%;
        border-collapse: collapse;
      }

      .octet-table th,
      .octet-table td {
        padding: 11px;
        border: 1px solid var(--border);
        text-align: left;
      }

      .octet-table th {
        background: #f1f5f9;
        color: var(--dark);
        font-size: 13px;
      }

      .octet-table td {
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
      }

      .copy-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
      }

      .info-section {
        max-width: 1080px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .info-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .example-box {
        margin-top: 20px;
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .example-box code {
        color: #1d4ed8;
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 850px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .result-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .info-section {
          padding: 22px;
        }

        .button-row,
        .copy-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .octet-table {
          display: block;
          overflow-x: auto;
        }

        .binary-output-value {
          font-size: 16px;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>IPv4 to Binary Converter</h1>

        <p>
          Convert a valid IPv4 address into 32-bit binary format and view the
          decimal, hexadecimal, and per-octet values.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Enter IPv4 Address</h2>

            <p class="card-description">
              Enter an IPv4 address such as 192.168.1.10.
            </p>

            <div class="form-group">
              <label for="ipAddress">IPv4 Address</label>

              <input
                id="ipAddress"
                type="text"
                value="192.168.1.10"
                placeholder="Example: 192.168.1.10"
                autocomplete="off"
                spellcheck="false"
              />

              <p class="help-text">
                Each IPv4 octet must contain a number between 0 and 255.
              </p>
            </div>

            <div>
              <p class="preset-title">Quick examples</p>

              <div class="preset-buttons">
                <button
                  class="preset"
                  type="button"
                  data-ip="192.168.1.10"
                >
                  192.168.1.10
                </button>

                <button
                  class="preset"
                  type="button"
                  data-ip="10.0.0.1"
                >
                  10.0.0.1
                </button>

                <button
                  class="preset"
                  type="button"
                  data-ip="172.16.0.1"
                >
                  172.16.0.1
                </button>

                <button
                  class="preset"
                  type="button"
                  data-ip="8.8.8.8"
                >
                  8.8.8.8
                </button>

                <button
                  class="preset"
                  type="button"
                  data-ip="255.255.255.255"
                >
                  255.255.255.255
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="convertButton"
                class="button primary-button"
                type="button"
              >
                Convert to Binary
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Conversion Result</h2>

            <div id="resultPlaceholder" class="result-placeholder">
              <span aria-hidden="true">🔢</span>

              Enter an IPv4 address and click
              <strong>Convert to Binary</strong>.
            </div>

            <div id="results" class="results">
              <div id="resultSummary" class="result-summary"></div>

              <div class="binary-output">
                <span class="binary-output-label">
                  Binary with octet separators
                </span>

                <span
                  id="resultBinary"
                  class="binary-output-value"
                >
                  -
                </span>
              </div>

              <div class="result-grid">
                <div class="result-item full">
                  <span class="result-label">32-bit Binary</span>

                  <span
                    id="resultBinaryFull"
                    class="result-value"
                  >
                    -
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">IPv4 Address</span>

                  <span id="resultIp" class="result-value">
                    -
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">Unsigned Decimal</span>

                  <span id="resultDecimal" class="result-value">
                    -
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">Hexadecimal</span>

                  <span id="resultHex" class="result-value">
                    -
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">Total Bits</span>

                  <span id="resultBits" class="result-value">
                    32
                  </span>
                </div>
              </div>

              <div class="octet-section">
                <h3>Octet Conversion</h3>

                <table class="octet-table">
                  <thead>
                    <tr>
                      <th>Octet</th>
                      <th>Decimal</th>
                      <th>Binary</th>
                      <th>Hex</th>
                    </tr>
                  </thead>

                  <tbody id="octetTableBody"></tbody>
                </table>
              </div>

              <div class="copy-row">
                <button
                  id="copyBinaryButton"
                  class="button primary-button"
                  type="button"
                >
                  Copy Binary
                </button>

                <button
                  id="copyResultButton"
                  class="button secondary-button"
                  type="button"
                >
                  Copy Full Result
                </button>
              </div>
            </div>
          </section>
        </div>

        <section class="info-section">
          <h2>How IPv4 to Binary Conversion Works</h2>

          <p>
            An IPv4 address contains four decimal octets. Each octet is
            converted into an 8-bit binary number, creating a total of 32 bits.
          </p>

          <div class="example-box">
            <p>
              Example:
              <code>192.168.1.10</code>
            </p>

            <p>
              Binary:
              <code>
                11000000.10101000.00000001.00001010
              </code>
            </p>
          </div>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All Rights Reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const ipAddressInput = document.getElementById("ipAddress");
      const convertButton = document.getElementById("convertButton");
      const resetButton = document.getElementById("resetButton");
      const copyBinaryButton =
        document.getElementById("copyBinaryButton");
      const copyResultButton =
        document.getElementById("copyResultButton");

      const message = document.getElementById("message");
      const results = document.getElementById("results");
      const resultPlaceholder =
        document.getElementById("resultPlaceholder");

      let currentBinary = "";
      let currentResult = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function isValidIPv4(ip) {
        const parts = ip.split(".");

        if (parts.length !== 4) {
          return false;
        }

        return parts.every((part) => {
          if (!/^\d+$/.test(part)) {
            return false;
          }

          if (part.length > 1 && part.startsWith("0")) {
            return false;
          }

          const value = Number(part);

          return value >= 0 && value <= 255;
        });
      }

      function convertIPv4() {
        clearMessage();

        const ip = ipAddressInput.value.trim();

        if (!isValidIPv4(ip)) {
          results.classList.remove("active");
          resultPlaceholder.style.display = "block";

          showMessage(
            "Enter a valid IPv4 address such as 192.168.1.10.",
            "error"
          );

          return;
        }

        const octets = ip.split(".").map(Number);

        const binaryOctets = octets.map((octet) =>
          octet.toString(2).padStart(8, "0")
        );

        const hexOctets = octets.map((octet) =>
          octet.toString(16).padStart(2, "0").toUpperCase()
        );

        const binaryWithDots = binaryOctets.join(".");
        const binaryFull = binaryOctets.join("");

        const unsignedDecimal =
          octets[0] * 16777216 +
          octets[1] * 65536 +
          octets[2] * 256 +
          octets[3];

        const hexadecimal = `0x${hexOctets.join("")}`;

        document.getElementById("resultIp").textContent = ip;

        document.getElementById("resultBinary").textContent =
          binaryWithDots;

        document.getElementById("resultBinaryFull").textContent =
          binaryFull;

        document.getElementById("resultDecimal").textContent =
          unsignedDecimal.toLocaleString("en-US");

        document.getElementById("resultHex").textContent =
          hexadecimal;

        document.getElementById("resultSummary").innerHTML = `
          <strong>${ip}</strong>
          The IPv4 address has been converted into a 32-bit binary value.
        `;

        const tableBody = document.getElementById("octetTableBody");
        tableBody.innerHTML = "";

        octets.forEach((octet, index) => {
          const row = document.createElement("tr");

          row.innerHTML = `
            <td>${index + 1}</td>
            <td>${octet}</td>
            <td>${binaryOctets[index]}</td>
            <td>${hexOctets[index]}</td>
          `;

          tableBody.appendChild(row);
        });

        currentBinary = binaryWithDots;

        currentResult = [
          "IPv4 to Binary Conversion",
          "-------------------------",
          `IPv4 Address: ${ip}`,
          `Binary: ${binaryWithDots}`,
          `32-bit Binary: ${binaryFull}`,
          `Unsigned Decimal: ${unsignedDecimal}`,
          `Hexadecimal: ${hexadecimal}`,
        ].join("\n");

        resultPlaceholder.style.display = "none";
        results.classList.add("active");

        showMessage(
          "IPv4 address converted successfully.",
          "success"
        );
      }

      function resetConverter() {
        ipAddressInput.value = "192.168.1.10";

        currentBinary = "";
        currentResult = "";

        clearMessage();

        results.classList.remove("active");
        resultPlaceholder.style.display = "block";

        ipAddressInput.focus();
      }

      async function copyText(text, button) {
        if (!text) {
          showMessage(
            "Convert an IPv4 address before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(text);

          const originalText = button.textContent;
          button.textContent = "Copied!";

          setTimeout(() => {
            button.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the result manually.",
            "error"
          );
        }
      }

      convertButton.addEventListener("click", convertIPv4);
      resetButton.addEventListener("click", resetConverter);

      copyBinaryButton.addEventListener("click", () => {
        copyText(currentBinary, copyBinaryButton);
      });

      copyResultButton.addEventListener("click", () => {
        copyText(currentResult, copyResultButton);
      });

      ipAddressInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          convertIPv4();
        }
      });

      document.querySelectorAll(".preset").forEach((button) => {
        button.addEventListener("click", () => {
          ipAddressInput.value = button.dataset.ip;
          convertIPv4();
        });
      });

      convertIPv4();
    </script>
  </body>
</html>