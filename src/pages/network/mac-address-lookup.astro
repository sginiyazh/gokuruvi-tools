---
const pageTitle = "MAC Address Lookup | Gokuruvi Tools";
const description =
  "Look up a MAC address or OUI prefix to identify its registered hardware vendor, assignment type, country, address range, and MAC address properties.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/mac-address-lookup"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 820px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1120px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input {
        width: 100%;
        min-height: 51px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .format-preview {
        margin-top: 12px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
      }

      .format-preview span {
        display: block;
      }

      .preview-label {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .preview-value {
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 800;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .button:disabled {
        cursor: not-allowed;
        opacity: 0.65;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover:not(:disabled) {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover:not(:disabled) {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .message.info {
        display: block;
        border: 1px solid var(--info-border);
        background: var(--info-bg);
        color: var(--info-text);
      }

      .result-placeholder {
        padding: 45px 20px;
        border: 2px dashed var(--border);
        border-radius: 12px;
        color: var(--muted);
        text-align: center;
      }

      .result-placeholder strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
        font-size: 17px;
      }

      .result-content {
        display: none;
      }

      .vendor-banner {
        padding: 20px;
        border: 1px solid var(--success-border);
        border-radius: 12px;
        background: var(--success-bg);
      }

      .vendor-banner span {
        display: block;
        margin-bottom: 5px;
        color: var(--success-text);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
      }

      .vendor-banner h3 {
        margin: 0;
        color: var(--success-text);
        font-size: 26px;
        overflow-wrap: anywhere;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .property-section {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid var(--info-border);
        border-radius: 12px;
        background: var(--info-bg);
      }

      .property-section h3 {
        margin: 0 0 14px;
        color: var(--info-text);
        font-size: 17px;
      }

      .property-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .property {
        padding: 11px 13px;
        border: 1px solid #bfdbfe;
        border-radius: 9px;
        background: #ffffff;
      }

      .property span {
        display: block;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
      }

      .property strong {
        color: var(--info-text);
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1120px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .attribution {
        margin-top: 20px;
        color: var(--muted);
        font-size: 13px;
        text-align: center;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 880px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .result-grid,
        .property-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>MAC Address Lookup</h1>

        <p>
          Identify the registered hardware vendor for a MAC address or OUI
          prefix and inspect address type, assignment range, country, and
          administration properties.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Enter MAC Address</h2>

            <p class="card-description">
              Enter a complete MAC address or the first six hexadecimal
              characters of an OUI prefix.
            </p>

            <form id="lookupForm" novalidate>
              <div class="form-group">
                <label for="macAddressInput">
                  MAC address or OUI
                </label>

                <input
                  id="macAddressInput"
                  name="macAddress"
                  type="text"
                  value="08:74:02:00:00:00"
                  placeholder="Example: 08:74:02:00:00:00"
                  maxlength="20"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                />

                <p class="help-text">
                  Supported examples: 08:74:02:00:00:00,
                  08-74-02-00-00-00, 0874.0200.0000, 087402000000,
                  or OUI prefix 08:74:02.
                </p>

                <div class="format-preview">
                  <span class="preview-label">
                    Normalized format
                  </span>

                  <span
                    id="formatPreview"
                    class="preview-value"
                  >
                    08:74:02:00:00:00
                  </span>
                </div>
              </div>

              <div>
                <p class="preset-title">Example addresses</p>

                <div class="preset-buttons">
                  <button
                    class="preset"
                    type="button"
                    data-mac="08:74:02:00:00:00"
                  >
                    Example 1
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-mac="44:38:39:FF:EF:57"
                  >
                    Example 2
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-mac="00:1A:2B:3C:4D:5E"
                  >
                    Example 3
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-mac="08:74:02"
                  >
                    OUI Prefix
                  </button>
                </div>
              </div>

              <div class="button-row">
                <button
                  id="lookupButton"
                  class="button primary-button"
                  type="submit"
                >
                  Look Up Vendor
                </button>

                <button
                  id="resetButton"
                  class="button secondary-button"
                  type="button"
                >
                  Reset
                </button>
              </div>

              <div
                id="message"
                class="message"
                role="alert"
                aria-live="polite"
              ></div>
            </form>
          </section>

          <section class="card">
            <h2>Vendor Lookup Result</h2>

            <p class="card-description">
              Vendor details are retrieved from the registered MAC address
              assignment information.
            </p>

            <div id="resultPlaceholder" class="result-placeholder">
              <strong>No lookup performed</strong>
              Enter a MAC address and select “Look Up Vendor.”
            </div>

            <div id="resultContent" class="result-content">
              <div class="vendor-banner">
                <span>Registered vendor</span>
                <h3 id="resultCompany">Unknown</h3>
              </div>

              <div class="button-row">
                <button
                  id="copyButton"
                  class="button primary-button"
                  type="button"
                >
                  Copy Result
                </button>
              </div>

              <div class="result-grid">
                <div class="result-item">
                  <span class="result-label">
                    Normalized Address
                  </span>

                  <span
                    id="resultMacAddress"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">Input Type</span>

                  <span
                    id="resultInputType"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">OUI Prefix</span>

                  <span
                    id="resultPrefix"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">
                    Assignment Type
                  </span>

                  <span
                    id="resultAssignmentType"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">Country</span>

                  <span
                    id="resultCountry"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item">
                  <span class="result-label">
                    Address Range
                  </span>

                  <span
                    id="resultAddressRange"
                    class="result-value"
                  >
                    —
                  </span>
                </div>

                <div class="result-item full">
                  <span class="result-label">
                    Registered Address
                  </span>

                  <span
                    id="resultRegisteredAddress"
                    class="result-value"
                  >
                    —
                  </span>
                </div>
              </div>

              <div class="property-section">
                <h3>MAC Address Properties</h3>

                <div class="property-grid">
                  <div class="property">
                    <span>Administration</span>
                    <strong id="resultAdministration">
                      —
                    </strong>
                  </div>

                  <div class="property">
                    <span>Transmission Type</span>
                    <strong id="resultTransmission">
                      —
                    </strong>
                  </div>
                </div>
              </div>
            </div>

            <div class="warning">
              A vendor lookup identifies the organization that registered the
              address prefix. It does not identify the device owner, exact
              device model, physical location, or current network user.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Accepted MAC Address Formats</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>Format</th>
                <th>Example</th>
                <th>Description</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Colon-separated</td>
                <td><code>08:74:02:00:00:00</code></td>
                <td>
                  Common format on Linux, macOS, and network devices.
                </td>
              </tr>

              <tr>
                <td>Hyphen-separated</td>
                <td><code>08-74-02-00-00-00</code></td>
                <td>
                  Commonly displayed by Windows commands.
                </td>
              </tr>

              <tr>
                <td>Cisco dotted format</td>
                <td><code>0874.0200.0000</code></td>
                <td>
                  Common format in Cisco IOS command output.
                </td>
              </tr>

              <tr>
                <td>Plain hexadecimal</td>
                <td><code>087402000000</code></td>
                <td>
                  Twelve hexadecimal characters without separators.
                </td>
              </tr>

              <tr>
                <td>OUI prefix</td>
                <td><code>08:74:02</code></td>
                <td>
                  The first 24 bits used for a vendor-prefix lookup.
                </td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="reference-section">
          <h2>Understanding MAC Addresses</h2>

          <div class="info-grid">
            <article class="info-card">
              <strong>OUI Prefix</strong>
              <p>
                The first portion of a globally assigned MAC address normally
                identifies the registered organization.
              </p>
            </article>

            <article class="info-card">
              <strong>Locally Administered</strong>
              <p>
                A locally administered address can be generated or changed by
                software and may not map reliably to a manufacturer.
              </p>
            </article>

            <article class="info-card">
              <strong>Universally Administered</strong>
              <p>
                A universally administered address uses an organization
                assignment issued through the registration system.
              </p>
            </article>

            <article class="info-card">
              <strong>Unicast</strong>
              <p>
                A unicast MAC address identifies a single network interface
                destination.
              </p>
            </article>

            <article class="info-card">
              <strong>Multicast</strong>
              <p>
                A multicast MAC address represents a group of network
                interfaces rather than one interface.
              </p>
            </article>

            <article class="info-card">
              <strong>Private MAC Address</strong>
              <p>
                Modern operating systems may randomize MAC addresses to reduce
                tracking on wireless networks.
              </p>
            </article>
          </div>

          <p class="attribution">
            Vendor lookup data provided by
            <a
              href="https://macvendors.co/"
              target="_blank"
              rel="noopener noreferrer"
            >
              MacVendors.co
            </a>.
          </p>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All Rights Reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const lookupForm =
        document.getElementById("lookupForm");

      const macAddressInput =
        document.getElementById("macAddressInput");

      const formatPreview =
        document.getElementById("formatPreview");

      const lookupButton =
        document.getElementById("lookupButton");

      const resetButton =
        document.getElementById("resetButton");

      const copyButton =
        document.getElementById("copyButton");

      const message =
        document.getElementById("message");

      const resultPlaceholder =
        document.getElementById("resultPlaceholder");

      const resultContent =
        document.getElementById("resultContent");

      let currentCopyText = "";

      function normalizeMacAddress(value) {
        return value
          .trim()
          .toUpperCase()
          .replace(/[^0-9A-F]/g, "");
      }

      function formatMacAddress(value) {
        return value.match(/.{1,2}/g)?.join(":") || value;
      }

      function isValidMacOrOui(value) {
        return (
          /^[0-9A-F]{6}$/.test(value) ||
          /^[0-9A-F]{12}$/.test(value)
        );
      }

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function updatePreview() {
        const normalized =
          normalizeMacAddress(macAddressInput.value);

        if (!normalized) {
          formatPreview.textContent = "—";
          return;
        }

        formatPreview.textContent =
          formatMacAddress(normalized);
      }

      function showPlaceholder(title, description) {
        resultContent.style.display = "none";
        resultPlaceholder.style.display = "block";

        resultPlaceholder.innerHTML = "";

        const strong = document.createElement("strong");
        strong.textContent = title;

        const text = document.createTextNode(description);

        resultPlaceholder.appendChild(strong);
        resultPlaceholder.appendChild(text);
      }

      function setText(id, value) {
        const element = document.getElementById(id);

        if (element) {
          element.textContent =
            value === null ||
            value === undefined ||
            value === ""
              ? "Not available"
              : String(value);
        }
      }

      function displayResult(data) {
        const vendor = data.vendor;
        const analysis = data.analysis;

        setText("resultCompany", vendor.company);
        setText(
          "resultMacAddress",
          data.normalizedMac,
        );
        setText("resultInputType", data.inputType);
        setText("resultPrefix", vendor.macPrefix);
        setText(
          "resultAssignmentType",
          vendor.assignmentType,
        );
        setText("resultCountry", vendor.country);
        setText(
          "resultAddressRange",
          `${vendor.startHex} – ${vendor.endHex}`,
        );
        setText(
          "resultRegisteredAddress",
          vendor.address,
        );

        setText(
          "resultAdministration",
          analysis.locallyAdministered
            ? "Locally administered"
            : "Universally administered",
        );

        setText(
          "resultTransmission",
          analysis.multicast
            ? "Multicast"
            : "Unicast",
        );

        resultPlaceholder.style.display = "none";
        resultContent.style.display = "block";

        currentCopyText =
          `MAC Address Lookup Result
MAC address: ${data.normalizedMac}
Input type: ${data.inputType}
Vendor: ${vendor.company}
OUI prefix: ${vendor.macPrefix}
Assignment type: ${vendor.assignmentType}
Country: ${vendor.country}
Registered address: ${vendor.address}
Address range: ${vendor.startHex} - ${vendor.endHex}
Administration: ${
  analysis.locallyAdministered
    ? "Locally administered"
    : "Universally administered"
}
Transmission type: ${
  analysis.multicast ? "Multicast" : "Unicast"
}`;
      }

      async function performLookup(event) {
        event.preventDefault();
        clearMessage();

        const normalized =
          normalizeMacAddress(macAddressInput.value);

        if (!isValidMacOrOui(normalized)) {
          showMessage(
            "Enter a complete 12-digit MAC address or a 6-digit OUI prefix.",
            "error",
          );

          showPlaceholder(
            "Invalid MAC address",
            "Correct the address format and try again.",
          );

          macAddressInput.focus();
          return;
        }

        lookupButton.disabled = true;
        resetButton.disabled = true;
        lookupButton.textContent = "Looking Up...";

        showMessage(
          "Contacting the vendor lookup service...",
          "info",
        );

        showPlaceholder(
          "Lookup in progress",
          "Please wait while the vendor record is retrieved.",
        );

        try {
          const response = await fetch(
            "/api/mac-address-lookup",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                macAddress: macAddressInput.value,
              }),
            },
          );

          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(
              data.error ||
                "No vendor information was found.",
            );
          }

          displayResult(data);

          showMessage(
            "Vendor information retrieved successfully.",
            "success",
          );
        } catch (error) {
          currentCopyText = "";

          const errorMessage =
            error instanceof Error
              ? error.message
              : "The lookup could not be completed.";

          showMessage(errorMessage, "error");

          showPlaceholder(
            "Vendor not found",
            "The address may be private, randomized, unregistered, or unavailable from the lookup service.",
          );
        } finally {
          lookupButton.disabled = false;
          resetButton.disabled = false;
          lookupButton.textContent = "Look Up Vendor";
        }
      }

      function resetLookup() {
        macAddressInput.value =
          "08:74:02:00:00:00";

        currentCopyText = "";

        clearMessage();
        updatePreview();

        showPlaceholder(
          "No lookup performed",
          "Enter a MAC address and select “Look Up Vendor.”",
        );

        macAddressInput.focus();
      }

      async function copyResult() {
        if (!currentCopyText) {
          showMessage(
            "Perform a successful lookup before copying.",
            "error",
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCopyText,
          );

          const originalText =
            copyButton.textContent;

          copyButton.textContent = "Copied!";

          showMessage(
            "MAC address result copied successfully.",
            "success",
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the result manually.",
            "error",
          );
        }
      }

      lookupForm.addEventListener(
        "submit",
        performLookup,
      );

      resetButton.addEventListener(
        "click",
        resetLookup,
      );

      copyButton.addEventListener(
        "click",
        copyResult,
      );

      macAddressInput.addEventListener(
        "input",
        updatePreview,
      );

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            macAddressInput.value =
              button.dataset.mac || "";

            updatePreview();
            clearMessage();
          });
        });

      updatePreview();
    </script>
  </body>
</html>