---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Password Generator" description="Generate strong random passwords locally in your browser.">
  <section class="tool-hero"><span class="eyebrow">Network · Security</span><h1>Password Generator</h1><p>Create cryptographically random passwords in your browser. Generated passwords are not sent to the server.</p></section>
  <div class="tool-wrap"><a class="back" href="/network/">← Back to Network Tools</a><section class="tool-card"><h2>Generate a password</h2><div class="field"><label for="length">Length</label><input id="length" type="number" min="8" max="128" value="20" /></div><div class="grid"><label class="field"><input id="upper" type="checkbox" checked /> Uppercase</label><label class="field"><input id="lower" type="checkbox" checked /> Lowercase</label><label class="field"><input id="numbers" type="checkbox" checked /> Numbers</label><label class="field"><input id="symbols" type="checkbox" checked /> Symbols</label></div><div class="actions"><button id="generate">Generate Password</button><button class="secondary" id="copy" type="button">Copy</button></div><div class="result"><strong class="big" id="password">—</strong></div></section></div>
  <script>
    const sets: Record<'upper' | 'lower' | 'numbers' | 'symbols', string> = {
      upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      lower: 'abcdefghijklmnopqrstuvwxyz',
      numbers: '0123456789',
      symbols: '!@#$%^&*()-_=+[]{};:,.?',
    };
    function randomIndex(max: number): number {
      const a = new Uint32Array(1);
      crypto.getRandomValues(a);
      return a[0] % max;
    }
    function generate(): void {
      const lengthInput = document.querySelector<HTMLInputElement>('#length');
      const out = document.querySelector<HTMLElement>('#password');
      if (!out) return;
      const len = Math.min(128, Math.max(8, Number(lengthInput?.value) || 20));
      let chars = '';
      for (const key of Object.keys(sets) as Array<keyof typeof sets>) {
        if (document.querySelector<HTMLInputElement>('#' + key)?.checked) chars += sets[key];
      }
      if (!chars) {
        out.textContent = 'Select at least one character set.';
        return;
      }
      let value = '';
      for (let i = 0; i < len; i++) value += chars[randomIndex(chars.length)];
      out.textContent = value;
    }
    document.querySelector('#generate')?.addEventListener('click', generate);
    document.querySelector<HTMLButtonElement>('#copy')?.addEventListener('click', async (event) => {
      const value = document.querySelector('#password')?.textContent || '';
      if (!value || value === '—') return;
      const button = event.currentTarget as HTMLButtonElement;
      const originalText = button.textContent;
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = 'Copied!';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => { button.textContent = originalText; }, 1500);
    });
    generate();
  </script>
<style>  .tool-hero { padding: 62px 20px 42px; background: linear-gradient(135deg,#eff6ff,#f8fafc); text-align:center; }
  .tool-hero .eyebrow { display:inline-flex; padding:6px 11px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:800; }
  .tool-hero h1 { margin:14px 0 10px; color:#0f172a; font-size:clamp(34px,5vw,52px); line-height:1.1; }
  .tool-hero p { max-width:760px; margin:0 auto; color:#64748b; font-size:17px; }
  .tool-wrap { width:min(calc(100% - 32px),960px); margin:38px auto 72px; }
  .tool-card { padding:28px; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tool-card h2 { margin:0 0 8px; color:#0f172a; }
  .muted { color:#64748b; }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-top:18px; }
  .field { margin-top:18px; }
  label { display:block; margin-bottom:7px; color:#0f172a; font-weight:750; }
  input:not([type="checkbox"]):not([type="radio"]), select { width:100%; min-height:48px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:10px; background:#fff; color:#0f172a; }
  input:focus, select:focus { outline:3px solid rgba(37,99,235,.14); border-color:#2563eb; }
  .grid .field { display:flex; align-items:center; gap:10px; margin-top:0; }
  .grid .field input[type="checkbox"] { width:19px; height:19px; min-height:0; flex-shrink:0; accent-color:#2563eb; cursor:pointer; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
  button { min-height:46px; padding:10px 17px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:800; cursor:pointer; }
  button.secondary { background:#e2e8f0; color:#0f172a; }
  .result { margin-top:22px; padding:18px; border:1px solid #dbeafe; border-radius:12px; background:#f8fbff; overflow-wrap:anywhere; }
  .result strong.big { display:block; color:#0f172a; font-size:30px; }
  .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .metric { padding:16px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; text-align:center; }
  .metric strong { display:block; color:#0f172a; font-size:24px; }
  pre { overflow:auto; padding:16px; border-radius:12px; background:#0f172a; color:#e2e8f0; white-space:pre-wrap; }
  .back { display:inline-block; margin-bottom:18px; color:#2563eb; font-weight:750; text-decoration:none; }
  @media (max-width:700px){ .grid,.metrics{grid-template-columns:1fr;} .tool-card{padding:20px;} }
</style>
</Layout>
