---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Internet Speed Test" description="Run a lightweight browser-based internet speed test for latency, download and upload performance.">
  <section class="tool-hero"><span class="eyebrow">Network · Performance</span><h1>Internet Speed Test</h1><p>Measure approximate latency, download and upload throughput between your browser and the Gokuruvi Tools server.</p></section>
  <div class="tool-wrap"><a class="back" href="/network/">← Back to Network Tools</a><section class="tool-card"><h2>Run speed test</h2><p class="muted">For best results, stop large downloads and VPN traffic before testing.</p><div class="actions"><button id="run">Start Test</button></div><div class="metrics"><div class="metric"><strong id="ping">—</strong>Ping (ms)</div><div class="metric"><strong id="download">—</strong>Download (Mbps)</div><div class="metric"><strong id="upload">—</strong>Upload (Mbps)</div></div><div class="result" id="status">Ready.</div><p class="muted">Results are indicative rather than laboratory measurements and depend on server location, browser load and network conditions.</p></section></div>
  <script>
    const ping=document.querySelector('#ping'),down=document.querySelector('#download'),up=document.querySelector('#upload'),status=document.querySelector('#status'),run=document.querySelector('#run');
    const mbps=(bytes,ms)=>(bytes*8/ms/1000).toFixed(2);
    run?.addEventListener('click',async()=>{run.disabled=true;try{status.textContent='Testing latency…';let total=0;for(let i=0;i<4;i++){const t=performance.now();await fetch(`/api/speedtest/ping?t=${Date.now()}-${i}`,{cache:'no-store'});total+=performance.now()-t;}ping.textContent=(total/4).toFixed(0);status.textContent='Testing download…';const ds=performance.now();const r=await fetch(`/api/speedtest/download?bytes=4000000&t=${Date.now()}`,{cache:'no-store'});const b=await r.arrayBuffer();const dms=performance.now()-ds;down.textContent=mbps(b.byteLength,dms);status.textContent='Testing upload…';const payload=new Uint8Array(2000000);crypto.getRandomValues(payload.subarray(0,65536));for(let i=65536;i<payload.length;i+=65536)payload.set(payload.subarray(0,Math.min(65536,payload.length-i)),i);const us=performance.now();await fetch('/api/speedtest/upload',{method:'POST',body:payload});const ums=performance.now()-us;up.textContent=mbps(payload.byteLength,ums);status.textContent='Test completed.';}catch(e){status.textContent=e instanceof Error?e.message:'Speed test failed.';}finally{run.disabled=false;}});
  </script>
<style>  .tool-hero { padding: 62px 20px 42px; background: linear-gradient(135deg,#eff6ff,#f8fafc); text-align:center; }
  .tool-hero .eyebrow { display:inline-flex; padding:6px 11px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:800; }
  .tool-hero h1 { margin:14px 0 10px; color:#0f172a; font-size:clamp(34px,5vw,52px); line-height:1.1; }
  .tool-hero p { max-width:760px; margin:0 auto; color:#64748b; font-size:17px; }
  .tool-wrap { width:min(calc(100% - 32px),960px); margin:38px auto 72px; }
  .tool-card { padding:28px; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tool-card h2 { margin:0 0 8px; color:#0f172a; }
  .muted { color:#64748b; }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .field { margin-top:18px; }
  label { display:block; margin-bottom:7px; color:#0f172a; font-weight:750; }
  input, select { width:100%; min-height:48px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:10px; background:#fff; color:#0f172a; }
  input:focus, select:focus { outline:3px solid rgba(37,99,235,.14); border-color:#2563eb; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
  button { min-height:46px; padding:10px 17px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:800; cursor:pointer; }
  button.secondary { background:#e2e8f0; color:#0f172a; }
  .result { margin-top:22px; padding:18px; border:1px solid #dbeafe; border-radius:12px; background:#f8fbff; overflow-wrap:anywhere; }
  .result strong.big { display:block; color:#0f172a; font-size:30px; }
  .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .metric { padding:16px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; text-align:center; }
  .metric strong { display:block; color:#0f172a; font-size:24px; }
  pre { overflow:auto; padding:16px; border-radius:12px; background:#0f172a; color:#e2e8f0; white-space:pre-wrap; }
  .back { display:inline-block; margin-bottom:18px; color:#2563eb; font-weight:750; text-decoration:none; }
  @media (max-width:700px){ .grid,.metrics{grid-template-columns:1fr;} .tool-card{padding:20px;} }
</style>
</Layout>
