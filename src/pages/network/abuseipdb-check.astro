---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="AbuseIPDB Check" description="Check an IP address against AbuseIPDB using your own API key.">
  <section class="tool-hero"><span class="eyebrow">Network · Security</span><h1>AbuseIPDB Check</h1><p>Check the reputation of a public IP address using your AbuseIPDB API key. The key is forwarded only for the lookup request.</p></section>
  <div class="tool-wrap"><a class="back" href="/network/">← Back to Network Tools</a><section class="tool-card"><h2>IP reputation lookup</h2><div class="field"><label for="ip">IP address</label><input id="ip" placeholder="8.8.8.8" /></div><div class="field"><label for="key">AbuseIPDB API key</label><input id="key" type="password" autocomplete="off" placeholder="Paste your API key" /></div><div class="actions"><button id="check">Check IP</button></div><div class="result" id="result" aria-live="polite">Enter an IP address and API key.</div><p class="muted">Your API key is not stored by this page. Avoid using this tool on shared or untrusted devices.</p></section></div>
  <script>
    const result=document.querySelector('#result');const esc=(value)=>String(value??'—').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));document.querySelector('#check')?.addEventListener('click',async()=>{const ip=document.querySelector('#ip')?.value.trim();const key=document.querySelector('#key')?.value.trim();if(!ip||!key){result.textContent='Enter both the IP address and API key.';return;}result.textContent='Checking…';try{const r=await fetch('/api/abuseipdb-check',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({ip,key})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Lookup failed');const x=d.data||{};result.innerHTML=`<div class="metrics"><div class="metric"><strong>${esc(x.abuseConfidenceScore ?? 0)}%</strong>Abuse score</div><div class="metric"><strong>${esc(x.totalReports ?? 0)}</strong>Reports</div><div class="metric"><strong>${esc(x.countryCode)}</strong>Country</div></div><p><strong>ISP:</strong> ${esc(x.isp)}<br><strong>Domain:</strong> ${esc(x.domain)}<br><strong>Last reported:</strong> ${esc(x.lastReportedAt ?? 'Not reported')}</p>`;}catch(e){result.textContent=e instanceof Error?e.message:'Lookup failed.';}});
  </script>
<style>  .tool-hero { padding: 62px 20px 42px; background: linear-gradient(135deg,#eff6ff,#f8fafc); text-align:center; }
  .tool-hero .eyebrow { display:inline-flex; padding:6px 11px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:800; }
  .tool-hero h1 { margin:14px 0 10px; color:#0f172a; font-size:clamp(34px,5vw,52px); line-height:1.1; }
  .tool-hero p { max-width:760px; margin:0 auto; color:#64748b; font-size:17px; }
  .tool-wrap { width:min(calc(100% - 32px),960px); margin:38px auto 72px; }
  .tool-card { padding:28px; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tool-card h2 { margin:0 0 8px; color:#0f172a; }
  .muted { color:#64748b; }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .field { margin-top:18px; }
  label { display:block; margin-bottom:7px; color:#0f172a; font-weight:750; }
  input, select { width:100%; min-height:48px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:10px; background:#fff; color:#0f172a; }
  input:focus, select:focus { outline:3px solid rgba(37,99,235,.14); border-color:#2563eb; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
  button { min-height:46px; padding:10px 17px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:800; cursor:pointer; }
  button.secondary { background:#e2e8f0; color:#0f172a; }
  .result { margin-top:22px; padding:18px; border:1px solid #dbeafe; border-radius:12px; background:#f8fbff; overflow-wrap:anywhere; }
  .result strong.big { display:block; color:#0f172a; font-size:30px; }
  .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .metric { padding:16px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; text-align:center; }
  .metric strong { display:block; color:#0f172a; font-size:24px; }
  pre { overflow:auto; padding:16px; border-radius:12px; background:#0f172a; color:#e2e8f0; white-space:pre-wrap; }
  .back { display:inline-block; margin-bottom:18px; color:#2563eb; font-weight:750; text-decoration:none; }
  @media (max-width:700px){ .grid,.metrics{grid-template-columns:1fr;} .tool-card{padding:20px;} }
</style>
</Layout>
