      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const osSelect =
        document.getElementById("osSelect");

      const viewSelect =
        document.getElementById("viewSelect");

      const protocolSelect =
        document.getElementById("protocolSelect");

      const addressFamilySelect =
        document.getElementById("addressFamilySelect");

      const numericInput =
        document.getElementById("numericInput");

      const processInput =
        document.getElementById("processInput");

      const allSocketsInput =
        document.getElementById("allSocketsInput");

      const extendedInput =
        document.getElementById("extendedInput");

      const timersInput =
        document.getElementById("timersInput");

      const continuousInput =
        document.getElementById("continuousInput");

      const intervalInput =
        document.getElementById("intervalInput");

      const portFilterInput =
        document.getElementById("portFilterInput");

      const stateFilterSelect =
        document.getElementById("stateFilterSelect");

      const intervalUnit =
        document.getElementById("intervalUnit");

      const generateButton =
        document.getElementById("generateButton");

      const resetButton =
        document.getElementById("resetButton");

      const copyButton =
        document.getElementById("copyButton");

      const commandOutput =
        document.getElementById("commandOutput");

      const explanationList =
        document.getElementById("explanationList");

      const message =
        document.getElementById("message");

      let currentCommand = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function generateLinuxCommand() {
        const flags = [];
        const explanations = [];
        const view = viewSelect.value;
        const protocol = protocolSelect.value;
        const family = addressFamilySelect.value;

        if (view === "routing") {
          flags.push("-r");
          explanations.push("Display the kernel routing table.");
        } else if (view === "interfaces") {
          flags.push("-i");
          explanations.push(
            "Display network interface statistics."
          );
        } else if (view === "statistics") {
          flags.push("-s");
          explanations.push(
            "Display summary statistics for network protocols."
          );
        } else if (view === "masquerade") {
          flags.push("-M");
          explanations.push(
            "Display masqueraded or NAT network connections."
          );
        } else {
          if (
            view === "listening" ||
            allSocketsInput.checked
          ) {
            flags.push("-a");

            explanations.push(
              "Display both listening and non-listening sockets."
            );
          }

          if (view === "listening") {
            flags.push("-l");

            explanations.push(
              "Display listening server sockets."
            );
          }

          if (protocol === "tcp") {
            flags.push("-t");
            explanations.push("Display TCP sockets.");
          } else if (protocol === "udp") {
            flags.push("-u");
            explanations.push("Display UDP sockets.");
          } else if (protocol === "raw") {
            flags.push("-w");
            explanations.push("Display RAW sockets.");
          } else if (protocol === "unix") {
            flags.push("-x");
            explanations.push(
              "Display Unix domain sockets."
            );
          } else {
            flags.push("-t", "-u");

            explanations.push(
              "Display both TCP and UDP sockets."
            );
          }
        }

        if (family === "ipv4") {
          flags.push("-4");
          explanations.push("Display IPv4 sockets only.");
        } else if (family === "ipv6") {
          flags.push("-6");
          explanations.push("Display IPv6 sockets only.");
        }

        if (numericInput.checked) {
          flags.push("-n");

          explanations.push(
            "Display numeric IP addresses and port numbers."
          );
        }

        if (
          processInput.checked &&
          !["routing", "interfaces", "statistics"].includes(view)
        ) {
          flags.push("-p");

          explanations.push(
            "Display the process ID and program using each socket."
          );
        }

        if (extendedInput.checked) {
          flags.push("-e");

          explanations.push(
            "Display extended network information."
          );
        }

        if (timersInput.checked) {
          flags.push("-o");

          explanations.push(
            "Display networking timer information."
          );
        }

        const uniqueFlags = [...new Set(flags)];
        let baseCommand = "netstat";

        if (uniqueFlags.length > 0) {
          baseCommand += ` ${uniqueFlags.join("")}`;
        }

        if (
          processInput.checked &&
          !["routing", "interfaces", "statistics"].includes(view)
        ) {
          baseCommand = `sudo ${baseCommand}`;
        }

        const port = portFilterInput.value.trim();
        const state = stateFilterSelect.value;

        if (port) {
          baseCommand += ` | grep -E '[:.]${port}([[:space:]]|$)'`;

          explanations.push(
            `Filter the output for network port ${port}.`
          );
        }

        if (state !== "all") {
          baseCommand += ` | grep '${state}'`;

          explanations.push(
            `Display connections in the ${state} state.`
          );
        }

        if (continuousInput.checked) {
          const interval = Number(intervalInput.value);

          baseCommand = `watch -n ${interval} "${baseCommand.replaceAll('"', '\\"')}"`;

          explanations.push(
            `Refresh the command output every ${interval} seconds.`
          );
        }

        return {
          command: baseCommand,
          explanations,
        };
      }

      function generateMacCommand() {
        const flags = [];
        const explanations = [];
        const view = viewSelect.value;
        const protocol = protocolSelect.value;
        const family = addressFamilySelect.value;

        if (view === "routing") {
          flags.push("-r");

          explanations.push(
            "Display the macOS routing table."
          );
        } else if (view === "interfaces") {
          flags.push("-i");

          explanations.push(
            "Display network interface information."
          );
        } else if (view === "statistics") {
          flags.push("-s");

          explanations.push(
            "Display protocol statistics."
          );
        } else {
          if (
            view === "listening" ||
            allSocketsInput.checked
          ) {
            flags.push("-a");

            explanations.push(
              "Display all available network sockets."
            );
          }

          if (protocol === "tcp") {
            flags.push("-p", "tcp");
            explanations.push("Display TCP sockets.");
          } else if (protocol === "udp") {
            flags.push("-p", "udp");
            explanations.push("Display UDP sockets.");
          }
        }

        if (family === "ipv4") {
          flags.push("-f", "inet");
          explanations.push("Display IPv4 information only.");
        } else if (family === "ipv6") {
          flags.push("-f", "inet6");
          explanations.push("Display IPv6 information only.");
        }

        if (numericInput.checked) {
          flags.push("-n");

          explanations.push(
            "Display numeric addresses and ports."
          );
        }

        if (extendedInput.checked) {
          flags.push("-b");

          explanations.push(
            "Display additional interface-related information where supported."
          );
        }

        let baseCommand = `netstat ${flags.join(" ")}`.trim();

        const port = portFilterInput.value.trim();
        const state = stateFilterSelect.value;

        if (port) {
          baseCommand += ` | grep -E '[:.]${port}([[:space:]]|$)'`;

          explanations.push(
            `Filter the output for port ${port}.`
          );
        }

        if (state !== "all") {
          baseCommand += ` | grep '${state}'`;

          explanations.push(
            `Filter connections by the ${state} state.`
          );
        }

        if (continuousInput.checked) {
          const interval = Number(intervalInput.value);

          baseCommand =
            `while true; do clear; ${baseCommand}; sleep ${interval}; done`;

          explanations.push(
            `Refresh the output every ${interval} seconds.`
          );
        }

        if (processInput.checked) {
          explanations.push(
            "macOS netstat does not provide the same PID/program option as Linux netstat."
          );
        }

        if (timersInput.checked) {
          explanations.push(
            "The Linux networking timer option is not added on macOS."
          );
        }

        return {
          command: baseCommand,
          explanations,
        };
      }

      function generateWindowsCommand() {
        const parts = ["netstat"];
        const explanations = [];
        const view = viewSelect.value;
        const protocol = protocolSelect.value;

        if (view === "routing") {
          parts.push("-r");
          explanations.push("Display the IP routing table.");
        } else if (view === "interfaces") {
          parts.push("-e");

          explanations.push(
            "Display Ethernet interface statistics."
          );
        } else if (view === "statistics") {
          parts.push("-s");

          explanations.push(
            "Display protocol-specific statistics."
          );
        } else {
          if (
            view === "listening" ||
            allSocketsInput.checked
          ) {
            parts.push("-a");

            explanations.push(
              "Display all active connections and listening ports."
            );
          } else {
            parts.push("-a");

            explanations.push(
              "Display active connections and listening ports."
            );
          }

          if (numericInput.checked) {
            parts.push("-n");

            explanations.push(
              "Display addresses and ports numerically."
            );
          }

          if (processInput.checked) {
            parts.push("-o");

            explanations.push(
              "Display the process ID associated with each connection."
            );
          }

          if (extendedInput.checked) {
            parts.push("-b");

            explanations.push(
              "Display the executable involved in each connection. Administrator privileges may be required."
            );
          }

          if (protocol === "tcp") {
            parts.push("-p", "tcp");
            explanations.push("Display TCP connections.");
          } else if (protocol === "udp") {
            parts.push("-p", "udp");
            explanations.push("Display UDP connections.");
          }
        }

        const interval = Number(intervalInput.value);

        if (continuousInput.checked) {
          parts.push(String(interval));

          explanations.push(
            `Redisplay the selected statistics every ${interval} seconds.`
          );
        }

        let baseCommand = parts.join(" ");

        const port = portFilterInput.value.trim();
        const state = stateFilterSelect.value;

        if (port) {
          baseCommand += ` | findstr ":${port}"`;

          explanations.push(
            `Filter the output for port ${port}.`
          );
        }

        if (state !== "all") {
          baseCommand += ` | findstr "${state}"`;

          explanations.push(
            `Filter connections by the ${state} state.`
          );
        }

        if (addressFamilySelect.value !== "all") {
          explanations.push(
            "Windows netstat does not provide a direct IPv4-only or IPv6-only filter in this command."
          );
        }

        if (
          protocol === "raw" ||
          protocol === "unix"
        ) {
          explanations.push(
            "The selected protocol filter is not supported by Windows netstat, so it was not added."
          );
        }

        if (timersInput.checked) {
          explanations.push(
            "The Linux networking timer option is not supported by Windows netstat."
          );
        }

        return {
          command: baseCommand,
          explanations,
        };
      }

      function updateOptionState() {
        const os = osSelect.value;
        const view = viewSelect.value;
        const isWindows = os === "windows";
        const isMac = os === "macos";

        intervalInput.disabled =
          !continuousInput.checked;

        intervalUnit.textContent = "(seconds)";

        if (isWindows) {
          addressFamilySelect.disabled = false;
          timersInput.disabled = true;
        } else {
          timersInput.disabled = false;
        }

        if (isMac) {
          processInput.disabled = true;
        } else {
          processInput.disabled = false;
        }

        if (
          view === "routing" ||
          view === "interfaces" ||
          view === "statistics"
        ) {
          protocolSelect.disabled = true;
          allSocketsInput.disabled = true;
          stateFilterSelect.disabled = true;
        } else {
          protocolSelect.disabled = false;
          allSocketsInput.disabled = false;
          stateFilterSelect.disabled = false;
        }

        if (view === "masquerade" && os !== "linux") {
          viewSelect.value = "connections";
        }

        generateCommand();
      }

      function generateCommand() {
        clearMessage();

        const portValue = portFilterInput.value.trim();
        const interval = Number(intervalInput.value);

        if (
          portValue &&
          (
            !Number.isInteger(Number(portValue)) ||
            Number(portValue) < 1 ||
            Number(portValue) > 65535
          )
        ) {
          currentCommand = "";
          commandOutput.textContent =
            "Enter a valid port number between 1 and 65535.";

          explanationList.innerHTML = "";

          showMessage(
            "Port filter must be between 1 and 65535.",
            "error"
          );

          return;
        }

        if (
          continuousInput.checked &&
          (
            !Number.isInteger(interval) ||
            interval < 1 ||
            interval > 3600
          )
        ) {
          currentCommand = "";
          commandOutput.textContent =
            "Enter a valid refresh interval.";

          explanationList.innerHTML = "";

          showMessage(
            "Refresh interval must be between 1 and 3600 seconds.",
            "error"
          );

          return;
        }

        const os = osSelect.value;

        const generated =
          os === "windows"
            ? generateWindowsCommand()
            : os === "macos"
              ? generateMacCommand()
              : generateLinuxCommand();

        currentCommand = generated.command;
        commandOutput.textContent = currentCommand;

        explanationList.innerHTML = "";

        generated.explanations.forEach((item) => {
          addExplanation(item);
        });

        const osNames = {
          linux: "Linux",
          macos: "macOS",
          windows: "Windows",
        };

        const viewNames = {
          connections: "Active connections",
          listening: "Listening ports",
          routing: "Routing table",
          interfaces: "Interface statistics",
          statistics: "Protocol statistics",
          masquerade: "NAT masquerade connections",
        };

        const protocolNames = {
          all: "All protocols",
          tcp: "TCP only",
          udp: "UDP only",
          raw: "RAW sockets",
          unix: "Unix sockets",
        };

        const familyNames = {
          all: "IPv4 and IPv6",
          ipv4: "IPv4 only",
          ipv6: "IPv6 only",
        };

        document.getElementById(
          "resultOs"
        ).textContent = osNames[os];

        document.getElementById(
          "resultView"
        ).textContent = viewNames[viewSelect.value];

        document.getElementById(
          "resultProtocol"
        ).textContent =
          protocolNames[protocolSelect.value];

        document.getElementById(
          "resultFamily"
        ).textContent =
          familyNames[addressFamilySelect.value];

        document.getElementById(
          "resultPort"
        ).textContent = portValue || "None";

        document.getElementById(
          "resultState"
        ).textContent =
          stateFilterSelect.value === "all"
            ? "All states"
            : stateFilterSelect.value;

        document.getElementById(
          "resultShell"
        ).textContent =
          os === "windows"
            ? "Command Prompt / PowerShell"
            : "Bash / compatible shell";
      }

      function applyPreset(name) {
        if (name === "listening") {
          viewSelect.value = "listening";
          protocolSelect.value = "all";
          numericInput.checked = true;
          processInput.checked = true;
          allSocketsInput.checked = true;
          portFilterInput.value = "";
          stateFilterSelect.value = "all";
        }

        if (name === "connections") {
          viewSelect.value = "connections";
          protocolSelect.value = "tcp";
          numericInput.checked = true;
          processInput.checked = false;
          allSocketsInput.checked = false;
          portFilterInput.value = "";
          stateFilterSelect.value = "all";
        }

        if (name === "routing") {
          viewSelect.value = "routing";
          numericInput.checked = true;
          portFilterInput.value = "";
          stateFilterSelect.value = "all";
        }

        if (name === "statistics") {
          viewSelect.value = "statistics";
          portFilterInput.value = "";
          stateFilterSelect.value = "all";
        }

        if (name === "port443") {
          viewSelect.value = "listening";
          protocolSelect.value = "tcp";
          numericInput.checked = true;
          processInput.checked = true;
          portFilterInput.value = "443";
          stateFilterSelect.value = "all";
        }

        if (name === "established") {
          viewSelect.value = "connections";
          protocolSelect.value = "tcp";
          numericInput.checked = true;
          portFilterInput.value = "";
          stateFilterSelect.value = "ESTABLISHED";
        }

        updateOptionState();
      }

      function resetGenerator() {
        osSelect.value = "linux";
        viewSelect.value = "connections";
        protocolSelect.value = "all";
        addressFamilySelect.value = "all";

        numericInput.checked = true;
        processInput.checked = true;
        allSocketsInput.checked = false;
        extendedInput.checked = false;
        timersInput.checked = false;
        continuousInput.checked = false;

        intervalInput.value = "2";
        portFilterInput.value = "";
        stateFilterSelect.value = "all";

        clearMessage();
        updateOptionState();
        osSelect.focus();
      }

      async function copyCommand() {
        if (!currentCommand) {
          showMessage(
            "Generate a command before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCommand
          );

          const originalText = copyButton.textContent;
          copyButton.textContent = "Copied!";

          showMessage(
            "Netstat command copied successfully.",
            "success"
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the command manually.",
            "error"
          );
        }
      }

      generateButton.addEventListener(
        "click",
        generateCommand
      );

      resetButton.addEventListener(
        "click",
        resetGenerator
      );

      copyButton.addEventListener(
        "click",
        copyCommand
      );

      [
        osSelect,
        viewSelect,
        protocolSelect,
        continuousInput,
      ].forEach((element) => {
        element.addEventListener(
          "change",
          updateOptionState
        );
      });

      [
        addressFamilySelect,
        numericInput,
        processInput,
        allSocketsInput,
        extendedInput,
        timersInput,
        intervalInput,
        portFilterInput,
        stateFilterSelect,
      ].forEach((element) => {
        element.addEventListener(
          "input",
          generateCommand
        );

        element.addEventListener(
          "change",
          generateCommand
        );
      });

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            applyPreset(button.dataset.preset || "");
          });
        });

      updateOptionState();
    </script>
  </body>
</html>