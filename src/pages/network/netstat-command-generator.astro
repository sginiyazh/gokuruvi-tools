---
const pageTitle = "Netstat Command Generator | Gokuruvi Tools";
const description =
  "Generate netstat commands for Linux, macOS, and Windows to inspect listening ports, active connections, routing tables, network statistics, interfaces, and process information.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/netstat-command-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 820px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1120px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus,
      select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .preset-group {
        margin-top: 20px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .command-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #e2e8f0;
      }

      .command-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .command-output {
        min-height: 72px;
        margin: 0;
        overflow-x: auto;
        color: #ffffff;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-family: Consolas, "Courier New", monospace;
        font-size: 16px;
        line-height: 1.7;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--info-border);
        border-radius: 11px;
        background: var(--info-bg);
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: var(--info-text);
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: var(--info-text);
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1120px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 880px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .checkbox-grid,
        .result-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Netstat Command Generator</h1>

        <p>
          Generate netstat commands for Linux, macOS, and Windows to inspect
          listening ports, active connections, routing tables, interface
          statistics, protocols, and process IDs.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Configure Netstat Command</h2>

            <p class="card-description">
              Select your operating system and choose the network information
              you want to display.
            </p>

            <div class="input-row">
              <div class="form-group">
                <label for="osSelect">Operating system</label>

                <select id="osSelect">
                  <option value="linux" selected>Linux</option>
                  <option value="macos">macOS</option>
                  <option value="windows">Windows</option>
                </select>
              </div>

              <div class="form-group">
                <label for="viewSelect">View type</label>

                <select id="viewSelect">
                  <option value="connections" selected>
                    Active connections
                  </option>
                  <option value="listening">
                    Listening ports
                  </option>
                  <option value="routing">
                    Routing table
                  </option>
                  <option value="interfaces">
                    Interface statistics
                  </option>
                  <option value="statistics">
                    Protocol statistics
                  </option>
                  <option value="masquerade">
                    NAT masquerade connections
                  </option>
                </select>
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="protocolSelect">Protocol filter</label>

                <select id="protocolSelect">
                  <option value="all" selected>All protocols</option>
                  <option value="tcp">TCP only</option>
                  <option value="udp">UDP only</option>
                  <option value="raw">RAW sockets</option>
                  <option value="unix">Unix domain sockets</option>
                </select>
              </div>

              <div class="form-group">
                <label for="addressFamilySelect">Address family</label>

                <select id="addressFamilySelect">
                  <option value="all" selected>IPv4 and IPv6</option>
                  <option value="ipv4">IPv4 only</option>
                  <option value="ipv6">IPv6 only</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Display options</label>

              <div class="checkbox-grid">
                <div class="checkbox-item">
                  <input
                    id="numericInput"
                    type="checkbox"
                    checked
                  />

                  <label for="numericInput">
                    Numeric addresses and ports
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="processInput"
                    type="checkbox"
                    checked
                  />

                  <label for="processInput">
                    Show process ID and program
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="allSocketsInput"
                    type="checkbox"
                  />

                  <label for="allSocketsInput">
                    Show all sockets
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="extendedInput"
                    type="checkbox"
                  />

                  <label for="extendedInput">
                    Extended information
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="timersInput"
                    type="checkbox"
                  />

                  <label for="timersInput">
                    Show networking timers
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="continuousInput"
                    type="checkbox"
                  />

                  <label for="continuousInput">
                    Refresh continuously
                  </label>
                </div>
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="intervalInput">
                  Refresh interval
                  <span id="intervalUnit">(seconds)</span>
                </label>

                <input
                  id="intervalInput"
                  type="number"
                  value="2"
                  min="1"
                  max="3600"
                  disabled
                />

                <p class="help-text">
                  Used when continuous refresh is enabled.
                </p>
              </div>

              <div class="form-group">
                <label for="portFilterInput">Filter by port</label>

                <input
                  id="portFilterInput"
                  type="number"
                  placeholder="Optional: 22 or 443"
                  min="1"
                  max="65535"
                />

                <p class="help-text">
                  Adds an operating-system-specific output filter.
                </p>
              </div>
            </div>

            <div class="form-group">
              <label for="stateFilterSelect">TCP state filter</label>

              <select id="stateFilterSelect">
                <option value="all" selected>All states</option>
                <option value="LISTEN">LISTEN</option>
                <option value="ESTABLISHED">ESTABLISHED</option>
                <option value="TIME_WAIT">TIME_WAIT</option>
                <option value="CLOSE_WAIT">CLOSE_WAIT</option>
                <option value="SYN_SENT">SYN_SENT</option>
                <option value="SYN_RECV">SYN_RECV</option>
              </select>

              <p class="help-text">
                The state filter is applied using grep or findstr.
              </p>
            </div>

            <div class="preset-group">
              <p class="preset-title">Quick commands</p>

              <div class="preset-buttons">
                <button
                  class="preset"
                  type="button"
                  data-preset="listening"
                >
                  Listening Ports
                </button>

                <button
                  class="preset"
                  type="button"
                  data-preset="connections"
                >
                  Active Connections
                </button>

                <button
                  class="preset"
                  type="button"
                  data-preset="routing"
                >
                  Routing Table
                </button>

                <button
                  class="preset"
                  type="button"
                  data-preset="statistics"
                >
                  Protocol Statistics
                </button>

                <button
                  class="preset"
                  type="button"
                  data-preset="port443"
                >
                  Port 443
                </button>

                <button
                  class="preset"
                  type="button"
                  data-preset="established"
                >
                  Established
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Command
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Generated Netstat Command</h2>

            <p class="card-description">
              Review the generated command before running it in your terminal,
              PowerShell, or Command Prompt.
            </p>

            <div class="command-box">
              <span class="command-label">Command</span>

              <pre id="commandOutput" class="command-output"></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy Command
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Operating System</span>
                <span id="resultOs" class="result-value">
                  Linux
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">View Type</span>
                <span id="resultView" class="result-value">
                  Active connections
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Protocol</span>
                <span id="resultProtocol" class="result-value">
                  All protocols
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Address Family</span>
                <span id="resultFamily" class="result-value">
                  IPv4 and IPv6
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Port Filter</span>
                <span id="resultPort" class="result-value">
                  None
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">State Filter</span>
                <span id="resultState" class="result-value">
                  All states
                </span>
              </div>

              <div class="result-item full">
                <span class="result-label">Command Shell</span>
                <span id="resultShell" class="result-value">
                  Bash / compatible shell
                </span>
              </div>
            </div>

            <div class="explanation">
              <h3>Command explanation</h3>

              <ul
                id="explanationList"
                class="explanation-list"
              ></ul>
            </div>

            <div class="warning">
              On newer Linux systems, the <strong>ss</strong> command is often
              recommended instead of netstat. Process information may require
              root or administrator privileges.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Common Netstat Commands</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>Purpose</th>
                <th>Linux</th>
                <th>Windows</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Show all listening TCP and UDP ports</td>
                <td><code>sudo netstat -tulnp</code></td>
                <td><code>netstat -ano</code></td>
              </tr>

              <tr>
                <td>Show active TCP connections</td>
                <td><code>netstat -tn</code></td>
                <td><code>netstat -an -p tcp</code></td>
              </tr>

              <tr>
                <td>Show routing table</td>
                <td><code>netstat -rn</code></td>
                <td><code>netstat -r</code></td>
              </tr>

              <tr>
                <td>Show network interface statistics</td>
                <td><code>netstat -i</code></td>
                <td><code>netstat -e</code></td>
              </tr>

              <tr>
                <td>Show protocol statistics</td>
                <td><code>netstat -s</code></td>
                <td><code>netstat -s</code></td>
              </tr>

              <tr>
                <td>Find port 443</td>
                <td><code>netstat -tulnp | grep ':443'</code></td>
                <td><code>netstat -ano | findstr ":443"</code></td>
              </tr>

              <tr>
                <td>Show established connections</td>
                <td>
                  <code>netstat -tn | grep ESTABLISHED</code>
                </td>
                <td>
                  <code>netstat -ano | findstr ESTABLISHED</code>
                </td>
              </tr>

              <tr>
                <td>Refresh every two seconds</td>
                <td><code>watch -n 2 netstat -tulnp</code></td>
                <td><code>netstat -ano 2</code></td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="reference-section">
          <h2>Netstat Output Information</h2>

          <div class="info-grid">
            <article class="info-card">
              <strong>Local Address</strong>
              <p>
                The local IP address and port used by the socket.
              </p>
            </article>

            <article class="info-card">
              <strong>Foreign Address</strong>
              <p>
                The remote IP address and port connected to the system.
              </p>
            </article>

            <article class="info-card">
              <strong>State</strong>
              <p>
                The TCP connection state, such as LISTEN or ESTABLISHED.
              </p>
            </article>

            <article class="info-card">
              <strong>PID / Program</strong>
              <p>
                The process ID and application using the network socket.
              </p>
            </article>

            <article class="info-card">
              <strong>Recv-Q</strong>
              <p>
                Data received by the network stack but not yet read.
              </p>
            </article>

            <article class="info-card">
              <strong>Send-Q</strong>
              <p>
                Data waiting to be acknowledged or transmitted.
              </p>
            </article>
          </div>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All Rights Reserved.
