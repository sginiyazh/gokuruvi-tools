      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const targetInput = document.getElementById("targetInput");
      const osSelect = document.getElementById("osSelect");
      const recordTypeSelect =
        document.getElementById("recordTypeSelect");
      const dnsServerInput =
        document.getElementById("dnsServerInput");
      const timeoutInput =
        document.getElementById("timeoutInput");
      const retryInput =
        document.getElementById("retryInput");

      const debugInput = document.getElementById("debugInput");
      const recursiveInput =
        document.getElementById("recursiveInput");
      const tcpInput = document.getElementById("tcpInput");
      const shortInput = document.getElementById("shortInput");

      const generateButton =
        document.getElementById("generateButton");
      const resetButton =
        document.getElementById("resetButton");
      const copyButton =
        document.getElementById("copyButton");

      const commandOutput =
        document.getElementById("commandOutput");
      const explanationList =
        document.getElementById("explanationList");
      const message = document.getElementById("message");

      let currentCommand = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function isValidIPv4(value) {
        const pattern =
          /^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$/;

        return pattern.test(value);
      }

      function isValidIPv6(value) {
        return (
          value.includes(":") &&
          /^[0-9a-f:]+$/i.test(value) &&
          value.length <= 45
        );
      }

      function isValidHostname(value) {
        const pattern =
          /^(?=.{1,253}$)(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i;

        return pattern.test(value);
      }

      function isValidTarget(value) {
        if (
          !value ||
          value.length > 253 ||
          value.includes("://") ||
          value.includes("/") ||
          value.includes("?") ||
          value.includes("#") ||
          value.includes("@") ||
          /\s/.test(value)
        ) {
          return false;
        }

        return (
          isValidIPv4(value) ||
          isValidIPv6(value) ||
          isValidHostname(value)
        );
      }

      function isValidDnsServer(value) {
        if (!value) {
          return true;
        }

        return (
          isValidIPv4(value) ||
          isValidIPv6(value) ||
          isValidHostname(value)
        );
      }

      function quoteValue(value) {
        if (/^[a-z0-9.:_-]+$/i.test(value)) {
          return value;
        }

        return `"${value.replace(/"/g, '\\"')}"`;
      }

      function generateCommand() {
        clearMessage();

        const target = targetInput.value.trim();
        const os = osSelect.value;
        const recordType = recordTypeSelect.value;
        const dnsServer = dnsServerInput.value.trim();
        const timeout = Number(timeoutInput.value);
        const retries = Number(retryInput.value);

        if (!isValidTarget(target)) {
          currentCommand = "";
          commandOutput.textContent =
            "Enter a valid domain name, IPv4 address, or IPv6 address.";

          explanationList.innerHTML = "";

          showMessage(
            "Enter a valid domain name or IP address without http://, https://, a path, or spaces.",
            "error"
          );

          return;
        }

        if (!isValidDnsServer(dnsServer)) {
          showMessage(
            "Enter a valid DNS server hostname or IP address.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(timeout) ||
          timeout < 1 ||
          timeout > 60
        ) {
          showMessage(
            "Timeout must be between 1 and 60 seconds.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(retries) ||
          retries < 1 ||
          retries > 10
        ) {
          showMessage(
            "Retry attempts must be between 1 and 10.",
            "error"
          );

          return;
        }

        const parts = ["nslookup"];
        const explanations = [];

        if (!shortInput.checked) {
          parts.push(`-type=${recordType}`);

          explanations.push(
            `Request the ${recordType} DNS record type.`
          );

          parts.push(`-timeout=${timeout}`);

          explanations.push(
            `Wait up to ${timeout} second${timeout === 1 ? "" : "s"} for a DNS response.`
          );

          parts.push(`-retry=${retries}`);

          explanations.push(
            `Retry the query up to ${retries} time${retries === 1 ? "" : "s"}.`
          );

          if (debugInput.checked) {
            parts.push("-debug");

            explanations.push(
              "Display detailed DNS request and response information."
            );
          }

          if (tcpInput.checked) {
            parts.push("-vc");

            explanations.push(
              "Use a virtual circuit, which makes nslookup use TCP."
            );
          }

          if (!recursiveInput.checked) {
            parts.push("-norecurse");

            explanations.push(
              "Disable recursive DNS resolution."
            );
          } else {
            explanations.push(
              "Request recursive DNS resolution."
            );
          }
        } else {
          if (recordType !== "A") {
            parts.push(`-type=${recordType}`);

            explanations.push(
              `Request the ${recordType} DNS record type.`
            );
          }

          explanations.push(
            "Generate a simplified command with only essential options."
          );
        }

        parts.push(quoteValue(target));

        explanations.push(
          `Query DNS information for ${target}.`
        );

        if (dnsServer) {
          parts.push(quoteValue(dnsServer));

          explanations.push(
            `Send the query directly to DNS server ${dnsServer}.`
          );
        } else {
          explanations.push(
            "Use the DNS server configured on the local system."
          );
        }

        currentCommand = parts.join(" ");
        commandOutput.textContent = currentCommand;

        explanationList.innerHTML = "";

        explanations.forEach((item) => {
          addExplanation(item);
        });

        const osNames = {
          linux: "Linux",
          macos: "macOS",
          windows: "Windows",
        };

        document.getElementById("resultOs").textContent =
          osNames[os];

        document.getElementById(
          "resultRecordType"
        ).textContent = recordType;

        document.getElementById(
          "resultTarget"
        ).textContent = target;

        document.getElementById(
          "resultDnsServer"
        ).textContent = dnsServer || "System default";

        document.getElementById(
          "resultTransport"
        ).textContent = tcpInput.checked ? "TCP" : "UDP";

        document.getElementById(
          "resultQueryMode"
        ).textContent = recursiveInput.checked
          ? "Recursive"
          : "Non-recursive";

        document.getElementById(
          "resultShell"
        ).textContent =
          os === "windows"
            ? "Command Prompt / PowerShell"
            : "Bash / compatible shell";
      }

      function updateRecordType() {
        const target = targetInput.value.trim();

        if (
          isValidIPv4(target) ||
          isValidIPv6(target)
        ) {
          recordTypeSelect.value = "PTR";
        }

        generateCommand();
      }

      function resetGenerator() {
        targetInput.value = "example.com";
        osSelect.value = "linux";
        recordTypeSelect.value = "A";
        dnsServerInput.value = "";
        timeoutInput.value = "5";
        retryInput.value = "2";

        debugInput.checked = false;
        recursiveInput.checked = true;
        tcpInput.checked = false;
        shortInput.checked = false;

        clearMessage();
        generateCommand();
        targetInput.focus();
      }

      async function copyCommand() {
        if (!currentCommand) {
          showMessage(
            "Generate a command before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCommand
          );

          const originalText = copyButton.textContent;
          copyButton.textContent = "Copied!";

          showMessage(
            "NSLookup command copied successfully.",
            "success"
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the command manually.",
            "error"
          );
        }
      }

      generateButton.addEventListener(
        "click",
        generateCommand
      );

      resetButton.addEventListener(
        "click",
        resetGenerator
      );

      copyButton.addEventListener(
        "click",
        copyCommand
      );

      targetInput.addEventListener(
        "change",
        updateRecordType
      );

      [
        targetInput,
        osSelect,
        recordTypeSelect,
        dnsServerInput,
        timeoutInput,
        retryInput,
        debugInput,
        recursiveInput,
        tcpInput,
        shortInput,
      ].forEach((element) => {
        element.addEventListener(
          "input",
          generateCommand
        );

        element.addEventListener(
          "change",
          generateCommand
        );
      });

      targetInput.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Enter") {
            generateCommand();
          }
        }
      );

      document
        .querySelectorAll(".dns-preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            dnsServerInput.value =
              button.dataset.server || "";

            generateCommand();
          });
        });

      document
        .querySelectorAll(".query-preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            targetInput.value =
              button.dataset.target || "";

            recordTypeSelect.value =
              button.dataset.type || "A";

            generateCommand();
          });
        });

      generateCommand();
    </script>
  </body>
</html>