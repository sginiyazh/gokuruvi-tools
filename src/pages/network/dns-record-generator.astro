                <button
                  class="preset"
                  type="button"
                  data-record="AAAA"
                >
                  Website AAAA
                </button>

                <button
                  class="preset"
                  type="button"
                  data-record="CNAME"
                >
                  WWW Alias
                </button>

                <button
                  class="preset"
                  type="button"
                  data-record="MX"
                >
                  Mail MX
                </button>

                <button
                  class="preset"
                  type="button"
                  data-record="TXT"
                >
                  SPF TXT
                </button>

                <button
                  class="preset"
                  type="button"
                  data-record="SRV"
                >
                  Service SRV
                </button>

                <button
                  class="preset"
                  type="button"
                  data-record="CAA"
                >
                  Let's Encrypt CAA
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate DNS Record
