            <div class="form-group" style="margin-top:20px;">
              <div class="checkbox-item">
                <input
                  id="absoluteNamesInput"
                  type="checkbox"
                  checked
                />

                <label for="absoluteNamesInput">
                  Add trailing dots to complete hostnames
