                  <div class="form-group">
                    <label for="soaExpireInput">Expire</label>

                    <input
                      id="soaExpireInput"
                      type="number"
                      value="1209600"
                      min="1"
                    />
                  </div>

                  <div class="form-group">
                    <label for="soaMinimumInput">
                      Minimum
