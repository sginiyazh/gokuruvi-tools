    <script is:inline>
      const recordTypeSelect =
        document.getElementById("recordTypeSelect");

      const ttlSelect =
        document.getElementById("ttlSelect");

      const customTtlGroup =
        document.getElementById("customTtlGroup");

      const customTtlInput =
        document.getElementById("customTtlInput");

      const domainInput =
        document.getElementById("domainInput");

      const hostInput =
        document.getElementById("hostInput");

      const absoluteNamesInput =
        document.getElementById("absoluteNamesInput");

      const generateButton =
        document.getElementById("generateButton");

      const resetButton =
        document.getElementById("resetButton");

      const copyButton =
        document.getElementById("copyButton");

      const recordOutput =
        document.getElementById("recordOutput");

      const recordLabel =
        document.getElementById("recordLabel");

      const explanationList =
        document.getElementById("explanationList");

      const message =
        document.getElementById("message");

      const recordFieldsTitle =
        document.getElementById("recordFieldsTitle");

      let selectedFormat = "zone";
      let generatedData = null;
      let currentCopyText = "";

      const typeNames = {
        A: "A Record Details",
        AAAA: "AAAA Record Details",
        CNAME: "CNAME Record Details",
        MX: "MX Record Details",
        TXT: "TXT Record Details",
        NS: "NS Record Details",
        PTR: "PTR Record Details",
        SRV: "SRV Record Details",
        CAA: "CAA Record Details",
        SOA: "SOA Record Details",
      };

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function getValue(id) {
        return document.getElementById(id).value.trim();
      }

      function getNumber(id) {
        return Number(document.getElementById(id).value);
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function normalizeDomain(value) {
        return value
          .trim()
          .toLowerCase()
          .replace(/^\.+|\.+$/g, "");
      }

      function normalizeHost(value) {
        const host = value.trim();

        if (!host || host === "@") {
          return "@";
        }

        return host.toLowerCase().replace(/\.+$/g, "");
      }

      function isValidHostname(value) {
        const hostname = value.replace(/\.$/, "");

        if (
          !hostname ||
          hostname.length > 253 ||
          hostname.includes("://") ||
          hostname.includes("/") ||
          /\s/.test(hostname)
        ) {
          return false;
        }

        return hostname
          .split(".")
          .every(
            (label) =>
              label.length >= 1 &&
              label.length <= 63 &&
              /^[a-z0-9_-]+$/i.test(label) &&
              !label.startsWith("-") &&
              !label.endsWith("-"),
          );
      }

      function isValidIPv4(value) {
        const parts = value.split(".");

        return (
          parts.length === 4 &&
          parts.every(
            (part) =>
              /^\d{1,3}$/.test(part) &&
              Number(part) >= 0 &&
              Number(part) <= 255,
          )
        );
      }

      function isValidIPv6(value) {
        return (
          value.includes(":") &&
          value.length <= 45 &&
          /^[0-9a-f:.]+$/i.test(value)
        );
      }

      function ensureDot(value) {
        const cleaned = value.replace(/\.$/, "");

        return absoluteNamesInput.checked
          ? `${cleaned}.`
          : cleaned;
      }

      function buildFqdn(host, domain) {
        if (host === "@") {
          return ensureDot(domain);
        }

        if (host.endsWith(`.${domain}`)) {
          return ensureDot(host);
        }

        return ensureDot(`${host}.${domain}`);
      }

      function escapeTxt(value) {
        return value
          .replace(/\\/g, "\\\\")
          .replace(/"/g, '\\"')
          .replace(/\r?\n/g, " ");
      }

      function getTtl() {
        if (ttlSelect.value === "custom") {
          return Number(customTtlInput.value);
        }

        return Number(ttlSelect.value);
      }

      function validateCommonFields() {
        const domain = normalizeDomain(domainInput.value);
        const host = normalizeHost(hostInput.value);
        const ttl = getTtl();

        if (!isValidHostname(domain)) {
          showMessage(
            "Enter a valid DNS zone or domain name.",
            "error",
          );

          return null;
        }

        if (
          host !== "@" &&
          !isValidHostname(host)
        ) {
          showMessage(
            "Enter a valid host name or use @ for the zone root.",
            "error",
          );

          return null;
        }

        if (
          !Number.isInteger(ttl) ||
          ttl < 1 ||
          ttl > 2147483647
        ) {
          showMessage(
            "TTL must be a whole number between 1 and 2147483647 seconds.",
            "error",
          );

          return null;
        }

        return {
          domain,
          host,
          ttl,
          fqdn: buildFqdn(host, domain),
        };
      }

      function generateRecordData() {
        clearMessage();

        const common = validateCommonFields();

        if (!common) {
          return null;
        }

        const type = recordTypeSelect.value;
        let value = "";
        let zoneRdata = "";
        let providerValue = "";
        const details = {};
        const explanations = [];

        if (type === "A") {
          value = getValue("ipv4Input");

          if (!isValidIPv4(value)) {
            showMessage(
              "Enter a valid IPv4 address.",
              "error",
            );

            return null;
          }

          zoneRdata = value;
          providerValue = value;

          explanations.push(
            `The A record maps ${common.fqdn} to IPv4 address ${value}.`,
          );
        }

        if (type === "AAAA") {
          value = getValue("ipv6Input");

          if (!isValidIPv6(value)) {
            showMessage(
              "Enter a valid IPv6 address.",
              "error",
            );

            return null;
          }

          zoneRdata = value;
          providerValue = value;

          explanations.push(
            `The AAAA record maps ${common.fqdn} to IPv6 address ${value}.`,
          );
        }

        if (type === "CNAME") {
          value = normalizeDomain(
            getValue("cnameTargetInput"),
          );

          if (!isValidHostname(value)) {
            showMessage(
              "Enter a valid canonical target hostname.",
              "error",
            );

            return null;
          }

          const target = ensureDot(value);

          zoneRdata = target;
          providerValue = target;
          details.target = target;

          explanations.push(
            `The CNAME record makes ${common.fqdn} an alias of ${target}.`,
          );
        }

        if (type === "MX") {
          const priority = getNumber("mxPriorityInput");
          value = normalizeDomain(getValue("mxTargetInput"));

          if (
            !Number.isInteger(priority) ||
            priority < 0 ||
            priority > 65535
          ) {
            showMessage(
              "MX priority must be between 0 and 65535.",
              "error",
            );

            return null;
          }

          if (!isValidHostname(value)) {
            showMessage(
              "Enter a valid mail-server hostname.",
              "error",
            );

            return null;
          }

          const target = ensureDot(value);

          zoneRdata = `${priority} ${target}`;
          providerValue = target;
          details.priority = priority;
          details.target = target;

          explanations.push(
            `The MX record directs mail to ${target} with priority ${priority}.`,
          );

          explanations.push(
            "Lower MX priority numbers are preferred before higher values.",
          );
        }

        if (type === "TXT") {
          value = getValue("txtValueInput");

          if (!value) {
            showMessage(
              "Enter a TXT record value.",
              "error",
            );

            return null;
          }

          const escapedValue = escapeTxt(value);

          zoneRdata = `"${escapedValue}"`;
          providerValue = value;
          details.text = value;

          explanations.push(
            "The TXT record stores text used for policies, authentication or domain verification.",
          );
        }

        if (type === "NS") {
          value = normalizeDomain(getValue("nsTargetInput"));

          if (!isValidHostname(value)) {
            showMessage(
              "Enter a valid authoritative name-server hostname.",
              "error",
            );

            return null;
          }

          const target = ensureDot(value);

          zoneRdata = target;
          providerValue = target;
          details.target = target;

          explanations.push(
            `The NS record delegates DNS authority to ${target}.`,
          );
        }

        if (type === "PTR") {
          value = normalizeDomain(getValue("ptrTargetInput"));

          if (!isValidHostname(value)) {
            showMessage(
              "Enter a valid PTR target hostname.",
              "error",
            );

            return null;
          }

          const target = ensureDot(value);

          zoneRdata = target;
          providerValue = target;
          details.target = target;

          explanations.push(
            `The PTR record maps the reverse DNS owner name to ${target}.`,
          );
        }

        if (type === "SRV") {
          const priority = getNumber("srvPriorityInput");
          const weight = getNumber("srvWeightInput");
          const port = getNumber("srvPortInput");
          value = normalizeDomain(getValue("srvTargetInput"));

          if (
            !Number.isInteger(priority) ||
            priority < 0 ||
            priority > 65535
          ) {
            showMessage(
              "SRV priority must be between 0 and 65535.",
              "error",
            );

            return null;
          }

          if (
            !Number.isInteger(weight) ||
            weight < 0 ||
            weight > 65535
          ) {
            showMessage(
              "SRV weight must be between 0 and 65535.",
              "error",
            );

            return null;
          }

          if (
            !Number.isInteger(port) ||
            port < 1 ||
            port > 65535
          ) {
            showMessage(
              "SRV port must be between 1 and 65535.",
              "error",
            );

            return null;
          }

          if (!isValidHostname(value)) {
            showMessage(
              "Enter a valid SRV target hostname.",
              "error",
            );

            return null;
          }

          const target = ensureDot(value);

          zoneRdata =
            `${priority} ${weight} ${port} ${target}`;

          providerValue = target;

          details.priority = priority;
          details.weight = weight;
          details.port = port;
          details.target = target;

          explanations.push(
            `The SRV record directs clients to ${target} on port ${port}.`,
          );

          explanations.push(
            `Priority is ${priority} and weight is ${weight}.`,
          );
        }

        if (type === "CAA") {
          const flag = getNumber("caaFlagSelect");
          const tag = getValue("caaTagSelect");
          value = getValue("caaValueInput");

          if (!value) {
            showMessage(
              "Enter a CAA value.",
              "error",
            );

            return null;
          }

          const escapedValue = escapeTxt(value);

          zoneRdata =
            `${flag} ${tag} "${escapedValue}"`;

          providerValue = value;

          details.flag = flag;
          details.tag = tag;
          details.value = value;

          explanations.push(
            `The CAA record uses the ${tag} property with flag ${flag}.`,
          );

          explanations.push(
            `The authorized value is ${value}.`,
          );
        }

        if (type === "SOA") {
          const primaryNs = normalizeDomain(
            getValue("soaPrimaryNsInput"),
          );

          const email = getValue("soaEmailInput");
          const serial = getNumber("soaSerialInput");
          const refresh = getNumber("soaRefreshInput");
          const retry = getNumber("soaRetryInput");
          const expire = getNumber("soaExpireInput");
          const minimum = getNumber("soaMinimumInput");

          if (!isValidHostname(primaryNs)) {
            showMessage(
              "Enter a valid SOA primary name server.",
              "error",
            );

            return null;
          }

          if (
            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
          ) {
            showMessage(
              "Enter a valid SOA administrator email address.",
              "error",
            );

            return null;
          }

          const numbers = [
            serial,
            refresh,
            retry,
            expire,
            minimum,
          ];

          if (
            numbers.some(
              (number) =>
                !Number.isInteger(number) ||
                number < 1,
            )
          ) {
            showMessage(
              "All SOA timing and serial values must be positive whole numbers.",
              "error",
            );

            return null;
          }

          const primaryTarget = ensureDot(primaryNs);
          const emailParts = email.toLowerCase().split("@");

          const responsibleMailbox = ensureDot(
            `${emailParts[0].replace(/\./g, "\\.")}.${emailParts[1]}`,
          );

          zoneRdata =
            `${primaryTarget} ${responsibleMailbox} (\n` +
            `  ${serial} ; serial\n` +
            `  ${refresh} ; refresh\n` +
            `  ${retry} ; retry\n` +
            `  ${expire} ; expire\n` +
            `  ${minimum} ; minimum TTL\n` +
            `)`;

          providerValue = primaryTarget;

          details.primaryNameServer = primaryTarget;
          details.responsibleMailbox = responsibleMailbox;
          details.serial = serial;
          details.refresh = refresh;
          details.retry = retry;
          details.expire = expire;
          details.minimum = minimum;

          explanations.push(
            `The SOA record defines ${primaryTarget} as the primary authoritative server.`,
          );

          explanations.push(
            `The zone serial number is ${serial}.`,
          );

          explanations.push(
            `Refresh, retry, expire and minimum values are expressed in seconds.`,
          );
        }

        explanations.push(
          `The TTL is ${common.ttl} seconds.`,
        );

        return {
          type,
          ttl: common.ttl,
          domain: common.domain,
          host: common.host,
          fqdn: common.fqdn,
          zoneRdata,
          providerValue,
          details,
          explanations,
        };
      }

      function renderOutput() {
        if (!generatedData) {
          return;
        }

        const data = generatedData;

        if (selectedFormat === "zone") {
          const owner =
            data.host === "@"
              ? "@"
              : data.host;

          currentCopyText =
            `${owner}\t${data.ttl}\tIN\t${data.type}\t${data.zoneRdata}`;

          recordLabel.textContent =
            "BIND zone-file record";

          recordOutput.textContent =
            currentCopyText;
        }

        if (selectedFormat === "provider") {
          const providerFields = {
            Type: data.type,
            Name: data.host,
            TTL: String(data.ttl),
            Value: data.providerValue,
            ...data.details,
          };

          currentCopyText = Object.entries(
            providerFields,
          )
            .map(([key, value]) => `${key}: ${value}`)
            .join("\n");

          recordLabel.textContent =
            "DNS provider form fields";

          recordOutput.textContent =
            currentCopyText;
        }

        if (selectedFormat === "json") {
          currentCopyText = JSON.stringify(
            {
              type: data.type,
              name: data.host,
              fqdn: data.fqdn,
              ttl: data.ttl,
              class: "IN",
              value: data.providerValue,
              details: data.details,
            },
            null,
            2,
          );

          recordLabel.textContent = "JSON record data";
          recordOutput.textContent = currentCopyText;
        }
      }

      function generateRecord() {
        generatedData = generateRecordData();

        if (!generatedData) {
          currentCopyText = "";
          recordOutput.textContent =
            "Correct the highlighted DNS record information.";
          explanationList.innerHTML = "";
          return;
        }

        renderOutput();

        explanationList.innerHTML = "";

        generatedData.explanations.forEach(
          addExplanation,
        );

        document.getElementById(
          "resultType",
        ).textContent = generatedData.type;

        document.getElementById(
          "resultTtl",
        ).textContent =
          `${generatedData.ttl} seconds`;

        document.getElementById(
          "resultName",
        ).textContent = generatedData.fqdn;

        document.getElementById(
          "resultValue",
        ).textContent =
          generatedData.zoneRdata.replace(/\n/g, " ");

        clearMessage();
      }

      function updateRecordFields() {
        const type = recordTypeSelect.value;

        document
          .querySelectorAll(".field-section")
          .forEach((section) => {
            section.classList.remove("active");
          });

        document
          .getElementById(`section${type}`)
          .classList.add("active");

        recordFieldsTitle.textContent =
          typeNames[type];

        if (type === "MX" || type === "NS" || type === "SOA") {
          if (hostInput.value.trim() === "www") {
            hostInput.value = "@";
          }
        }

        if (type === "SRV") {
          if (
            hostInput.value.trim() === "www" ||
            hostInput.value.trim() === "@"
          ) {
            hostInput.value = "_https._tcp";
          }
        }

        generateRecord();
      }

      function updateTtlState() {
        customTtlGroup.style.display =
          ttlSelect.value === "custom"
            ? "block"
            : "none";

        generateRecord();
      }

      function applyPreset(type) {
        recordTypeSelect.value = type;

        if (type === "A") {
          hostInput.value = "www";
          document.getElementById(
            "ipv4Input",
          ).value = "192.0.2.10";
        }

        if (type === "AAAA") {
          hostInput.value = "www";
          document.getElementById(
            "ipv6Input",
          ).value = "2001:db8::10";
        }

        if (type === "CNAME") {
          hostInput.value = "www";
          document.getElementById(
            "cnameTargetInput",
          ).value = domainInput.value;
        }

        if (type === "MX") {
          hostInput.value = "@";
          document.getElementById(
            "mxPriorityInput",
          ).value = "10";

          document.getElementById(
            "mxTargetInput",
          ).value = `mail.${normalizeDomain(
            domainInput.value,
          )}`;
        }

        if (type === "TXT") {
          hostInput.value = "@";
          document.getElementById(
            "txtValueInput",
          ).value =
            "v=spf1 include:_spf.example.com -all";
        }

        if (type === "SRV") {
          hostInput.value = "_https._tcp";

          document.getElementById(
            "srvPriorityInput",
          ).value = "10";

          document.getElementById(
            "srvWeightInput",
          ).value = "5";

          document.getElementById(
            "srvPortInput",
          ).value = "443";

          document.getElementById(
            "srvTargetInput",
          ).value = `service.${normalizeDomain(
            domainInput.value,
          )}`;
        }

        if (type === "CAA") {
          hostInput.value = "@";

          document.getElementById(
            "caaFlagSelect",
          ).value = "0";

          document.getElementById(
            "caaTagSelect",
          ).value = "issue";

          document.getElementById(
            "caaValueInput",
          ).value = "letsencrypt.org";
        }

        updateRecordFields();
      }

      function resetGenerator() {
        recordTypeSelect.value = "A";
        ttlSelect.value = "300";
        customTtlInput.value = "300";
        domainInput.value = "example.com";
        hostInput.value = "www";
        absoluteNamesInput.checked = true;

        document.getElementById(
          "ipv4Input",
        ).value = "192.0.2.10";

        document.getElementById(
          "ipv6Input",
        ).value = "2001:db8::10";

        document.getElementById(
          "cnameTargetInput",
        ).value = "example.com";

        document.getElementById(
          "mxPriorityInput",
        ).value = "10";

        document.getElementById(
          "mxTargetInput",
        ).value = "mail.example.com";

        document.getElementById(
          "txtValueInput",
        ).value =
          "v=spf1 include:_spf.example.com -all";

        document.getElementById(
          "nsTargetInput",
        ).value = "ns1.example.com";

        document.getElementById(
          "ptrTargetInput",
        ).value = "server.example.com";

        document.getElementById(
          "srvPriorityInput",
        ).value = "10";

        document.getElementById(
          "srvWeightInput",
        ).value = "5";

        document.getElementById(
          "srvPortInput",
        ).value = "443";

        document.getElementById(
          "srvTargetInput",
        ).value = "service.example.com";

        document.getElementById(
          "caaFlagSelect",
        ).value = "0";

        document.getElementById(
          "caaTagSelect",
        ).value = "issue";

        document.getElementById(
          "caaValueInput",
        ).value = "letsencrypt.org";

        selectedFormat = "zone";

        document
          .querySelectorAll(".output-tab")
          .forEach((tab) => {
            tab.classList.toggle(
              "active",
              tab.dataset.format === "zone",
            );
          });

        clearMessage();
        updateTtlState();
        updateRecordFields();
        domainInput.focus();
      }

      async function copyRecord() {
        if (!currentCopyText) {
          showMessage(
            "Generate a valid DNS record before copying.",
            "error",
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCopyText,
          );

          const originalText =
            copyButton.textContent;

          copyButton.textContent = "Copied!";

          showMessage(
            "DNS record copied successfully.",
            "success",
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the record manually.",
            "error",
          );
        }
      }

      recordTypeSelect.addEventListener(
        "change",
        updateRecordFields,
      );

      ttlSelect.addEventListener(
        "change",
        updateTtlState,
      );

      generateButton.addEventListener(
        "click",
        generateRecord,
      );

      resetButton.addEventListener(
        "click",
        resetGenerator,
      );

      copyButton.addEventListener(
        "click",
        copyRecord,
      );

      document
        .querySelectorAll(
          "input, select, textarea",
        )
        .forEach((element) => {
          if (
            element !== recordTypeSelect &&
            element !== ttlSelect
          ) {
            element.addEventListener(
              "input",
              generateRecord,
            );

            element.addEventListener(
              "change",
              generateRecord,
            );
          }
        });

      document
        .querySelectorAll(".output-tab")
        .forEach((tab) => {
          tab.addEventListener("click", () => {
            selectedFormat =
              tab.dataset.format || "zone";

            document
              .querySelectorAll(".output-tab")
              .forEach((button) => {
                button.classList.remove("active");
              });

            tab.classList.add("active");
            renderOutput();
          });
        });

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            applyPreset(
              button.dataset.record || "A",
            );
          });
        });

      updateTtlState();
      updateRecordFields();
    </script>
  </body>
</html>