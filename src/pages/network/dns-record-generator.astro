---
const pageTitle = "DNS Record Generator | Gokuruvi Tools";
const description =
  "Generate valid DNS records for A, AAAA, CNAME, MX, TXT, NS, PTR, SRV, CAA, and SOA record types with BIND zone-file and provider-friendly output.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/dns-record-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 820px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1140px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .input-row.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      textarea {
        min-height: 100px;
        resize: vertical;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled,
      textarea:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .dynamic-fields {
        margin-top: 4px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .dynamic-fields h3 {
        margin: 0 0 16px;
        color: var(--dark);
        font-size: 17px;
      }

      .field-section {
        display: none;
      }

      .field-section.active {
        display: block;
      }

      .checkbox-item {
        display: flex;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .preset-group {
        margin-top: 20px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .output-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
      }

      .output-tab {
        padding: 8px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      .output-tab.active {
        border-color: var(--primary);
        background: var(--primary);
        color: #ffffff;
      }

      .record-box {
        margin-top: 14px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
      }

      .record-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .record-output {
        min-height: 90px;
        margin: 0;
        overflow-x: auto;
        color: #ffffff;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        line-height: 1.7;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--info-border);
        border-radius: 11px;
        background: var(--info-bg);
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: var(--info-text);
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: var(--info-text);
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1140px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 900px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .input-row.three,
        .result-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>DNS Record Generator</h1>

        <p>
          Generate valid DNS records for websites, mail servers, domain
          verification, reverse DNS, service discovery, certificate authority
          restrictions, and authoritative DNS zones.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Configure DNS Record</h2>

            <p class="card-description">
              Select a record type and enter the required DNS values.
            </p>

            <div class="input-row">
              <div class="form-group">
                <label for="recordTypeSelect">Record type</label>

                <select id="recordTypeSelect">
                  <option value="A" selected>A — IPv4 address</option>
                  <option value="AAAA">AAAA — IPv6 address</option>
                  <option value="CNAME">CNAME — Alias</option>
                  <option value="MX">MX — Mail server</option>
                  <option value="TXT">TXT — Text value</option>
                  <option value="NS">NS — Name server</option>
                  <option value="PTR">PTR — Reverse lookup</option>
                  <option value="SRV">SRV — Service location</option>
                  <option value="CAA">
                    CAA — Certificate authority
                  </option>
                  <option value="SOA">
                    SOA — Start of authority
                  </option>
                </select>
              </div>

              <div class="form-group">
                <label for="ttlSelect">TTL</label>

                <select id="ttlSelect">
                  <option value="60">60 seconds</option>
                  <option value="300" selected>300 seconds</option>
                  <option value="600">600 seconds</option>
                  <option value="1800">1,800 seconds</option>
                  <option value="3600">3,600 seconds</option>
                  <option value="14400">14,400 seconds</option>
                  <option value="86400">86,400 seconds</option>
                  <option value="custom">Custom TTL</option>
                </select>
              </div>
            </div>

            <div
              id="customTtlGroup"
              class="form-group"
              style="display:none;"
            >
              <label for="customTtlInput">
                Custom TTL in seconds
              </label>

              <input
                id="customTtlInput"
                type="number"
                value="300"
                min="1"
                max="2147483647"
              />
            </div>

            <div class="form-group">
              <label for="domainInput">DNS zone or domain</label>

              <input
                id="domainInput"
                type="text"
                value="example.com"
                placeholder="Example: example.com"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />

              <p class="help-text">
                Used to build the complete fully qualified domain name.
              </p>
            </div>

            <div class="form-group">
              <label for="hostInput">Host or record name</label>

              <input
                id="hostInput"
                type="text"
                value="www"
                placeholder="Example: www, mail, @ or _sip._tcp"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />

              <p class="help-text">
                Use <strong>@</strong> for the zone root.
              </p>
            </div>

            <div class="dynamic-fields">
              <h3 id="recordFieldsTitle">A Record Details</h3>

              <div id="sectionA" class="field-section active">
                <div class="form-group">
                  <label for="ipv4Input">IPv4 address</label>

                  <input
                    id="ipv4Input"
                    type="text"
                    value="192.0.2.10"
                    placeholder="Example: 192.0.2.10"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionAAAA" class="field-section">
                <div class="form-group">
                  <label for="ipv6Input">IPv6 address</label>

                  <input
                    id="ipv6Input"
                    type="text"
                    value="2001:db8::10"
                    placeholder="Example: 2001:db8::10"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionCNAME" class="field-section">
                <div class="form-group">
                  <label for="cnameTargetInput">
                    Canonical target hostname
                  </label>

                  <input
                    id="cnameTargetInput"
                    type="text"
                    value="example.com"
                    placeholder="Example: example.com"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                  />

                  <p class="help-text">
                    Enter a hostname, not an IP address.
                  </p>
                </div>
              </div>

              <div id="sectionMX" class="field-section">
                <div class="input-row">
                  <div class="form-group">
                    <label for="mxPriorityInput">
                      Priority
                    </label>

                    <input
                      id="mxPriorityInput"
                      type="number"
                      value="10"
                      min="0"
                      max="65535"
                    />
                  </div>

                  <div class="form-group">
                    <label for="mxTargetInput">
                      Mail server
                    </label>

                    <input
                      id="mxTargetInput"
                      type="text"
                      value="mail.example.com"
                      placeholder="Example: mail.example.com"
                      autocomplete="off"
                      autocapitalize="none"
                      spellcheck="false"
                    />
                  </div>
                </div>
              </div>

              <div id="sectionTXT" class="field-section">
                <div class="form-group">
                  <label for="txtValueInput">TXT value</label>

                  <textarea
                    id="txtValueInput"
                    placeholder="Enter SPF, DKIM, DMARC or verification text"
                  >v=spf1 include:_spf.example.com -all</textarea>

                  <p class="help-text">
                    Double quotes and backslashes will be escaped automatically.
                  </p>
                </div>
              </div>

              <div id="sectionNS" class="field-section">
                <div class="form-group">
                  <label for="nsTargetInput">
                    Authoritative name server
                  </label>

                  <input
                    id="nsTargetInput"
                    type="text"
                    value="ns1.example.com"
                    placeholder="Example: ns1.example.com"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionPTR" class="field-section">
                <div class="form-group">
                  <label for="ptrTargetInput">
                    Target hostname
                  </label>

                  <input
                    id="ptrTargetInput"
                    type="text"
                    value="server.example.com"
                    placeholder="Example: server.example.com"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionSRV" class="field-section">
                <div class="input-row three">
                  <div class="form-group">
                    <label for="srvPriorityInput">
                      Priority
                    </label>

                    <input
                      id="srvPriorityInput"
                      type="number"
                      value="10"
                      min="0"
                      max="65535"
                    />
                  </div>

                  <div class="form-group">
                    <label for="srvWeightInput">Weight</label>

                    <input
                      id="srvWeightInput"
                      type="number"
                      value="5"
                      min="0"
                      max="65535"
                    />
                  </div>

                  <div class="form-group">
                    <label for="srvPortInput">Port</label>

                    <input
                      id="srvPortInput"
                      type="number"
                      value="443"
                      min="1"
                      max="65535"
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label for="srvTargetInput">
                    Service target
                  </label>

                  <input
                    id="srvTargetInput"
                    type="text"
                    value="service.example.com"
                    placeholder="Example: service.example.com"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionCAA" class="field-section">
                <div class="input-row">
                  <div class="form-group">
                    <label for="caaFlagSelect">Flag</label>

                    <select id="caaFlagSelect">
                      <option value="0" selected>
                        0 — Standard
                      </option>
                      <option value="128">
                        128 — Critical
                      </option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="caaTagSelect">Tag</label>

                    <select id="caaTagSelect">
                      <option value="issue" selected>
                        issue
                      </option>
                      <option value="issuewild">
                        issuewild
                      </option>
                      <option value="iodef">
                        iodef
                      </option>
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label for="caaValueInput">CAA value</label>

                  <input
                    id="caaValueInput"
                    type="text"
                    value="letsencrypt.org"
                    placeholder="Example: letsencrypt.org"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
              </div>

              <div id="sectionSOA" class="field-section">
                <div class="form-group">
                  <label for="soaPrimaryNsInput">
                    Primary name server
                  </label>

                  <input
                    id="soaPrimaryNsInput"
                    type="text"
                    value="ns1.example.com"
                    placeholder="Example: ns1.example.com"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>

                <div class="form-group">
                  <label for="soaEmailInput">
                    Administrator email
                  </label>

                  <input
                    id="soaEmailInput"
                    type="email"
                    value="hostmaster@example.com"
                    placeholder="Example: hostmaster@example.com"
                    autocomplete="off"
                    spellcheck="false"
                  />

                  <p class="help-text">
                    It will be converted to DNS SOA format automatically.
                  </p>
                </div>

                <div class="input-row">
                  <div class="form-group">
                    <label for="soaSerialInput">Serial</label>

                    <input
                      id="soaSerialInput"
                      type="number"
                      value="2026073001"
                      min="1"
                    />
                  </div>

                  <div class="form-group">
                    <label for="soaRefreshInput">
                      Refresh
                    </label>

                    <input
                      id="soaRefreshInput"
                      type="number"
                      value="3600"
                      min="1"
                    />
                  </div>
                </div>

                <div class="input-row three">
                  <div class="form-group">
                    <label for="soaRetryInput">Retry</label>

                    <input
                      id="soaRetryInput"
                      type="number"
