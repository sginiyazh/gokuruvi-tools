---
import Layout from "../../layouts/Layout.astro";
const forwarded = Astro.request.headers.get("cf-connecting-ip") ?? Astro.request.headers.get("x-forwarded-for")?.split(",")[0]?.trim();
const ip = forwarded || "Unavailable in local development";
const isIpv6 = ip.includes(":");
---
<Layout title="What Is My IP" description="Find the public IPv4 and IPv6 address detected for your current connection.">
  <section class="tool-hero"><span class="eyebrow">Network · IP Lookup</span><h1>What Is My IP?</h1><p>View the public IP address passed to Gokuruvi Tools by the edge or proxy serving this request, plus your IPv4 and IPv6 addresses individually.</p></section>
  <div class="tool-wrap">
    <a class="back" href="/network/">← Back to Network Tools</a>
    <section class="tool-card">
      <h2>Your public IP</h2>
      <p class="muted">This is the address your device actually used to reach this site{isIpv6 ? " — your connection used IPv6" : ""}.</p>
      <div class="result"><strong class="big">{ip}</strong></div>
      <p class="muted">VPNs, proxies, corporate gateways and carrier NAT can change the address shown here.</p>

      <h2 class="metrics-title">IPv4 &amp; IPv6 lookup</h2>
      <p class="muted">Most networks support both. If your ISP or device prefers IPv6 for its own connections, the address above may look different from the IPv4 address below — both can be correct at the same time.</p>
      <div class="metrics">
        <div class="metric">
          <span class="metric-label">IPv4 address</span>
          <strong id="ipv4Value">Checking…</strong>
        </div>
        <div class="metric">
          <span class="metric-label">IPv6 address</span>
          <strong id="ipv6Value">Checking…</strong>
        </div>
      </div>
    </section>
  </div>

  <script>
    async function lookup(url: string): Promise<string | null> {
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 6000);
        const response = await fetch(url, { signal: controller.signal });
        clearTimeout(timeout);
        if (!response.ok) return null;
        const data = (await response.json()) as { ip?: string };
        return data.ip ?? null;
      } catch {
        return null;
      }
    }

    async function populate(elementId: string, url: string, unavailableText: string) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const result = await lookup(url);
      el.textContent = result ?? unavailableText;
    }

    populate("ipv4Value", "https://api4.ipify.org?format=json", "Not available on this network");
    populate("ipv6Value", "https://api6.ipify.org?format=json", "Not available on this network");
  </script>
<style>  .tool-hero { padding: 62px 20px 42px; background: linear-gradient(135deg,#eff6ff,#f8fafc); text-align:center; }
  .tool-hero .eyebrow { display:inline-flex; padding:6px 11px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:800; }
  .tool-hero h1 { margin:14px 0 10px; color:#0f172a; font-size:clamp(34px,5vw,52px); line-height:1.1; }
  .tool-hero p { max-width:760px; margin:0 auto; color:#64748b; font-size:17px; }
  .tool-wrap { width:min(calc(100% - 32px),960px); margin:38px auto 72px; }
  .tool-card { padding:28px; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tool-card h2 { margin:0 0 8px; color:#0f172a; }
  .metrics-title { margin-top:30px; padding-top:26px; border-top:1px solid #e2e8f0; }
  .muted { color:#64748b; }
  .result { margin-top:22px; padding:18px; border:1px solid #dbeafe; border-radius:12px; background:#f8fbff; overflow-wrap:anywhere; }
  .result strong.big { display:block; color:#0f172a; font-size:30px; overflow-wrap:anywhere; }
  .metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .metric { padding:16px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; text-align:center; }
  .metric-label { display:block; margin-bottom:6px; color:#64748b; font-size:13px; font-weight:700; }
  .metric strong { display:block; color:#0f172a; font-size:20px; overflow-wrap:anywhere; }
  .back { display:inline-block; margin-bottom:18px; color:#2563eb; font-weight:750; text-decoration:none; }
  @media (max-width:700px){ .metrics{grid-template-columns:1fr;} .tool-card{padding:20px;} }
</style>
</Layout>
