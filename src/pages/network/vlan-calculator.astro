    <script is:inline>
      const vlanIdInput =
        document.getElementById("vlanIdInput");

      const pcpSelect =
        document.getElementById("pcpSelect");

      const deiSelect =
        document.getElementById("deiSelect");

      const tpidSelect =
        document.getElementById("tpidSelect");

      const nativeVlanInput =
        document.getElementById("nativeVlanInput");

      const vlanNameInput =
        document.getElementById("vlanNameInput");

      const rangeStartInput =
        document.getElementById("rangeStartInput");

      const rangeEndInput =
        document.getElementById("rangeEndInput");

      const includeSwitchConfigInput =
        document.getElementById("includeSwitchConfigInput");

      const calculateButton =
        document.getElementById("calculateButton");

      const resetButton =
        document.getElementById("resetButton");

      const copyButton =
        document.getElementById("copyButton");

      const tagOutput =
        document.getElementById("tagOutput");

      const configurationSection =
        document.getElementById("configurationSection");

      const configurationOutput =
        document.getElementById("configurationOutput");

      const explanationList =
        document.getElementById("explanationList");

      const message =
        document.getElementById("message");

      let currentCopyText = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function toPaddedBinary(value, length) {
        return value
          .toString(2)
          .padStart(length, "0");
      }

      function toPaddedHex(value, length) {
        return value
          .toString(16)
          .toUpperCase()
          .padStart(length, "0");
      }

      function getVlanStatus(vlanId) {
        if (vlanId === 0) {
          return {
            name: "Reserved: priority tag",
            explanation:
              "VLAN ID 0 indicates priority tagging without assigning the frame to a VLAN.",
          };
        }

        if (vlanId === 1) {
          return {
            name: "Default VLAN",
            explanation:
              "VLAN 1 is commonly used as the default VLAN on network switches.",
          };
        }

        if (vlanId >= 2 && vlanId <= 1001) {
          return {
            name: "Normal configurable range",
            explanation:
              "This VLAN ID is within the commonly supported normal VLAN range.",
          };
        }

        if (vlanId >= 1002 && vlanId <= 1005) {
          return {
            name: "Legacy reserved range",
            explanation:
              "This VLAN ID is historically reserved on some Cisco platforms for legacy technologies.",
          };
        }

        if (vlanId >= 1006 && vlanId <= 4094) {
          return {
            name: "Extended configurable range",
            explanation:
              "This VLAN ID is within the extended VLAN range.",
          };
        }

        return {
          name: "Reserved",
          explanation:
            "VLAN ID 4095 is reserved and cannot be assigned as a normal VLAN.",
        };
      }

      function sanitizeVlanName(value) {
        const cleaned = value
          .trim()
          .toUpperCase()
          .replace(/[^A-Z0-9_-]/g, "-")
          .replace(/-+/g, "-")
          .replace(/^[-_]+|[-_]+$/g, "");

        return cleaned || "VLAN";
      }

      function generateConfigurations(
        vlanId,
        vlanName,
        nativeVlan
      ) {
        return `Cisco IOS
configure terminal
vlan ${vlanId}
 name ${vlanName}
exit
interface GigabitEthernet1/0/1
 switchport mode access
 switchport access vlan ${vlanId}
exit

Cisco trunk example
interface GigabitEthernet1/0/24
 switchport mode trunk
 switchport trunk native vlan ${nativeVlan}
 switchport trunk allowed vlan add ${vlanId}
exit

Linux VLAN interface
sudo ip link add link eth0 name eth0.${vlanId} type vlan id ${vlanId}
sudo ip link set eth0.${vlanId} up

Linux NetworkManager
sudo nmcli connection add type vlan \\
  con-name vlan-${vlanId} \\
  ifname eth0.${vlanId} \\
  dev eth0 \\
  id ${vlanId}`;
      }

      function calculateVlan() {
        clearMessage();

        const vlanId = Number(vlanIdInput.value);
        const pcp = Number(pcpSelect.value);
        const dei = Number(deiSelect.value);
        const nativeVlan = Number(nativeVlanInput.value);
        const rangeStart = Number(rangeStartInput.value);
        const rangeEnd = Number(rangeEndInput.value);

        if (
          !Number.isInteger(vlanId) ||
          vlanId < 0 ||
          vlanId > 4095
        ) {
          showMessage(
            "VLAN ID must be a whole number between 0 and 4095.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(nativeVlan) ||
          nativeVlan < 1 ||
          nativeVlan > 4094
        ) {
          showMessage(
            "Native VLAN must be between 1 and 4094.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(rangeStart) ||
          !Number.isInteger(rangeEnd) ||
          rangeStart < 1 ||
          rangeStart > 4094 ||
          rangeEnd < 1 ||
          rangeEnd > 4094
        ) {
          showMessage(
            "VLAN range values must be between 1 and 4094.",
            "error"
          );

          return;
        }

        if (rangeStart > rangeEnd) {
          showMessage(
            "VLAN range start cannot be greater than the range end.",
            "error"
          );

          return;
        }

        const tpidHex = tpidSelect.value;
        const tpidValue = Number.parseInt(tpidHex, 16);

        const tciValue =
          (pcp << 13) |
          (dei << 12) |
          vlanId;

        const vlanBinary =
          toPaddedBinary(vlanId, 12);

        const pcpBinary =
          toPaddedBinary(pcp, 3);

        const deiBinary =
          String(dei);

        const tciBinary =
          `${pcpBinary}${deiBinary}${vlanBinary}`;

        const vlanHex =
          toPaddedHex(vlanId, 3);

        const tciHex =
          toPaddedHex(tciValue, 4);

        const fullTagHex =
          `${toPaddedHex(tpidValue, 4)}${tciHex}`;

        const tagBytes =
          fullTagHex.match(/.{1,2}/g).join(" ");

        const vlanStatus =
          getVlanStatus(vlanId);

        const rangeCount =
          rangeEnd - rangeStart + 1;

        const vlanName =
          sanitizeVlanName(vlanNameInput.value);

        tagOutput.textContent =
          `0x${fullTagHex}  ·  ${tagBytes}`;

        document.getElementById(
          "resultVlanId"
        ).textContent = String(vlanId);

        document.getElementById(
          "resultStatus"
        ).textContent = vlanStatus.name;

        document.getElementById(
          "resultVlanHex"
        ).textContent = `0x${vlanHex}`;

        document.getElementById(
          "resultVlanBinary"
        ).textContent = vlanBinary;

        document.getElementById(
          "resultPcp"
        ).textContent = String(pcp);

        document.getElementById(
          "resultDei"
        ).textContent = String(dei);

        document.getElementById(
          "resultTpid"
        ).textContent = `0x${tpidHex}`;

        document.getElementById(
          "resultTci"
        ).textContent = `0x${tciHex}`;

        document.getElementById(
          "resultRangeCount"
        ).textContent =
          `${rangeCount} VLAN${rangeCount === 1 ? "" : "s"}`;

        document.getElementById(
          "resultNativeVlan"
        ).textContent = String(nativeVlan);

        document.getElementById(
          "resultTagBytes"
        ).textContent = tagBytes;

        document.getElementById(
          "pcpBits"
        ).textContent = pcpBinary;

        document.getElementById(
          "deiBits"
        ).textContent = deiBinary;

        document.getElementById(
          "vlanBits"
        ).textContent = vlanBinary;

        explanationList.innerHTML = "";

        addExplanation(
          `VLAN ID ${vlanId} uses the 12-bit binary value ${vlanBinary}.`
        );

        addExplanation(vlanStatus.explanation);

        addExplanation(
          `PCP ${pcp} uses binary ${pcpBinary} and defines the Ethernet traffic priority.`
        );

        addExplanation(
          `DEI ${dei} marks the frame as ${
            dei === 1
              ? "drop eligible during congestion"
              : "not explicitly drop eligible"
          }.`
        );

        addExplanation(
          `The TCI value is calculated as (PCP << 13) | (DEI << 12) | VLAN ID.`
        );

        addExplanation(
          `TCI binary: ${tciBinary}; hexadecimal: 0x${tciHex}.`
        );

        addExplanation(
          `The complete tag combines TPID 0x${tpidHex} with TCI 0x${tciHex}.`
        );

        addExplanation(
          `The VLAN range ${rangeStart}–${rangeEnd} contains ${rangeCount} VLAN IDs.`
        );

        const configuration =
          generateConfigurations(
            vlanId,
            vlanName,
            nativeVlan
          );

        configurationSection.style.display =
          includeSwitchConfigInput.checked
            ? "block"
            : "none";

        configurationOutput.textContent =
          configuration;

        currentCopyText =
          `VLAN Calculator Result
VLAN ID: ${vlanId}
VLAN name: ${vlanName}
Status: ${vlanStatus.name}
VLAN hexadecimal: 0x${vlanHex}
VLAN binary: ${vlanBinary}
PCP: ${pcp} (${pcpBinary})
DEI: ${dei}
TPID: 0x${tpidHex}
TCI: 0x${tciHex}
Complete tag: 0x${fullTagHex}
Tag bytes: ${tagBytes}
Native VLAN: ${nativeVlan}
VLAN range: ${rangeStart}-${rangeEnd}
Range count: ${rangeCount}

${includeSwitchConfigInput.checked ? configuration : ""}`;
      }

      function resetCalculator() {
        vlanIdInput.value = "100";
        pcpSelect.value = "0";
        deiSelect.value = "0";
        tpidSelect.value = "8100";
        nativeVlanInput.value = "1";
        vlanNameInput.value = "USERS";
        rangeStartInput.value = "100";
        rangeEndInput.value = "110";
        includeSwitchConfigInput.checked = true;

        clearMessage();
        calculateVlan();
        vlanIdInput.focus();
      }

      async function copyResults() {
        if (!currentCopyText) {
          showMessage(
            "Calculate the VLAN information before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCopyText
          );

          const originalText =
            copyButton.textContent;

          copyButton.textContent = "Copied!";

          showMessage(
            "VLAN calculation copied successfully.",
            "success"
          );

          setTimeout(() => {
            copyButton.textContent =
              originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the results manually.",
            "error"
          );
        }
      }

      calculateButton.addEventListener(
        "click",
        calculateVlan
      );

      resetButton.addEventListener(
        "click",
        resetCalculator
      );

      copyButton.addEventListener(
        "click",
        copyResults
      );

      [
        vlanIdInput,
        pcpSelect,
        deiSelect,
        tpidSelect,
        nativeVlanInput,
        vlanNameInput,
        rangeStartInput,
        rangeEndInput,
        includeSwitchConfigInput,
      ].forEach((element) => {
        element.addEventListener(
          "input",
          calculateVlan
        );

        element.addEventListener(
          "change",
          calculateVlan
        );
      });

      document
        .querySelectorAll(".preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const vlan =
              button.dataset.vlan || "100";

            vlanIdInput.value = vlan;
            rangeStartInput.value = vlan;
            rangeEndInput.value = vlan;

            vlanNameInput.value =
              button.dataset.name || "VLAN";

            pcpSelect.value =
              button.dataset.pcp || "0";

            calculateVlan();
          });
        });

      calculateVlan();
    </script>
  </body>
</html>