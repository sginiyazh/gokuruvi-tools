---
const pageTitle = "VLAN Calculator | Gokuruvi Tools";
const description =
  "Calculate VLAN IDs, IEEE 802.1Q tag values, TCI fields, PCP priority, DEI, hexadecimal values, VLAN ranges, and subnet allocation details.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/vlan-calculator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;

        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e3a8a;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 820px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1120px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-item {
        display: flex;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .preset-group {
        margin-top: 20px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .tag-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #ffffff;
      }

      .tag-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .tag-output {
        min-height: 45px;
        margin: 0;
        overflow-x: auto;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-family: Consolas, "Courier New", monospace;
        font-size: 18px;
        line-height: 1.7;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .bit-layout {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid var(--info-border);
        border-radius: 12px;
        background: var(--info-bg);
      }

      .bit-layout h3 {
        margin: 0 0 14px;
        color: var(--info-text);
        font-size: 17px;
      }

      .bit-row {
        display: grid;
        grid-template-columns: 3fr 1fr 12fr;
        border: 1px solid #93c5fd;
        border-radius: 9px;
        overflow: hidden;
      }

      .bit-part {
        padding: 12px 8px;
        border-right: 1px solid #93c5fd;
        background: #ffffff;
        color: var(--info-text);
        text-align: center;
        font-family: Consolas, "Courier New", monospace;
        font-size: 13px;
        font-weight: 800;
      }

      .bit-part:last-child {
        border-right: 0;
      }

      .bit-value {
        display: block;
        margin-top: 5px;
        color: var(--dark);
        font-size: 14px;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--info-border);
        border-radius: 11px;
        background: var(--info-bg);
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: var(--info-text);
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: var(--info-text);
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1120px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .info-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .info-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .info-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 880px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .info-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .result-grid,
        .info-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }

        .bit-row {
          grid-template-columns: 1fr;
        }

        .bit-part {
          border-right: 0;
          border-bottom: 1px solid #93c5fd;
        }

        .bit-part:last-child {
          border-bottom: 0;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>VLAN Calculator</h1>

        <p>
          Calculate VLAN identifiers, IEEE 802.1Q tag values, priority fields,
          hexadecimal values, VLAN ranges, and switch configuration examples.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>VLAN Configuration</h2>

            <p class="card-description">
              Enter a VLAN ID and optional IEEE 802.1Q priority settings.
            </p>

            <div class="form-group">
              <label for="vlanIdInput">VLAN ID</label>

              <input
                id="vlanIdInput"
                type="number"
                value="100"
                min="0"
                max="4095"
                inputmode="numeric"
              />

              <p class="help-text">
                Normal configurable VLAN IDs are 1–4094. VLAN 0 and VLAN 4095
                are reserved.
              </p>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="pcpSelect">
                  PCP priority
                </label>

                <select id="pcpSelect">
                  <option value="0" selected>
                    0 - Best effort
                  </option>

                  <option value="1">
                    1 - Background
                  </option>

                  <option value="2">
                    2 - Spare
                  </option>

                  <option value="3">
                    3 - Excellent effort
                  </option>

                  <option value="4">
                    4 - Controlled load
                  </option>

                  <option value="5">
                    5 - Video
                  </option>

                  <option value="6">
                    6 - Voice
                  </option>

                  <option value="7">
                    7 - Network control
                  </option>
                </select>

                <p class="help-text">
                  Priority Code Point uses three bits.
                </p>
              </div>

              <div class="form-group">
                <label for="deiSelect">
                  DEI value
                </label>

                <select id="deiSelect">
                  <option value="0" selected>
                    0 - Normal
                  </option>

                  <option value="1">
                    1 - Drop eligible
                  </option>
                </select>

                <p class="help-text">
                  Drop Eligible Indicator uses one bit.
                </p>
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="tpidSelect">
                  Tag protocol identifier
                </label>

                <select id="tpidSelect">
                  <option value="8100" selected>
                    0x8100 - IEEE 802.1Q
                  </option>

                  <option value="88A8">
                    0x88A8 - Provider bridging
                  </option>

                  <option value="9100">
                    0x9100 - QinQ alternative
                  </option>
                </select>
              </div>

              <div class="form-group">
                <label for="nativeVlanInput">
                  Native VLAN
                </label>

                <input
                  id="nativeVlanInput"
                  type="number"
                  value="1"
                  min="1"
                  max="4094"
                  inputmode="numeric"
                />

                <p class="help-text">
                  Used for switch configuration examples.
                </p>
              </div>
            </div>

            <div class="form-group">
              <label for="vlanNameInput">VLAN name</label>

              <input
                id="vlanNameInput"
                type="text"
                value="USERS"
                maxlength="32"
                placeholder="Example: USERS"
                autocomplete="off"
                spellcheck="false"
              />
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="rangeStartInput">
                  VLAN range start
                </label>

                <input
                  id="rangeStartInput"
                  type="number"
                  value="100"
                  min="1"
                  max="4094"
                />
              </div>

              <div class="form-group">
                <label for="rangeEndInput">
                  VLAN range end
                </label>

                <input
                  id="rangeEndInput"
                  type="number"
                  value="110"
                  min="1"
                  max="4094"
                />
              </div>
            </div>

            <div class="form-group">
              <div class="checkbox-item">
                <input
                  id="includeSwitchConfigInput"
                  type="checkbox"
                  checked
                />

                <label for="includeSwitchConfigInput">
                  Generate switch configuration examples
                </label>
              </div>
            </div>

            <div class="preset-group">
              <p class="preset-title">Common VLAN examples</p>

              <div class="preset-buttons">
                <button
                  class="preset"
                  type="button"
                  data-vlan="10"
                  data-name="MANAGEMENT"
                >
                  VLAN 10
                </button>

                <button
                  class="preset"
                  type="button"
                  data-vlan="20"
                  data-name="SERVERS"
                >
                  VLAN 20
                </button>

                <button
                  class="preset"
                  type="button"
                  data-vlan="30"
                  data-name="VOICE"
                  data-pcp="6"
                >
                  Voice VLAN
                </button>

                <button
                  class="preset"
                  type="button"
                  data-vlan="100"
                  data-name="USERS"
                >
                  VLAN 100
                </button>

                <button
                  class="preset"
                  type="button"
                  data-vlan="999"
                  data-name="NATIVE-BLACKHOLE"
                >
                  VLAN 999
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="calculateButton"
                class="button primary-button"
                type="button"
              >
                Calculate VLAN
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>VLAN Calculation Result</h2>

            <p class="card-description">
              Review the VLAN identifier and IEEE 802.1Q tag details.
            </p>

            <div class="tag-box">
              <span class="tag-label">
                Complete 802.1Q tag value
              </span>

              <pre
                id="tagOutput"
                class="tag-output"
              ></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy Results
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">VLAN ID</span>
                <span id="resultVlanId" class="result-value">
                  100
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">VLAN Status</span>
                <span id="resultStatus" class="result-value">
                  Configurable
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">VLAN ID Hex</span>
                <span id="resultVlanHex" class="result-value">
                  0x064
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">VLAN ID Binary</span>
                <span id="resultVlanBinary" class="result-value">
                  000001100100
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">PCP</span>
                <span id="resultPcp" class="result-value">
                  0
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">DEI</span>
                <span id="resultDei" class="result-value">
                  0
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">TPID</span>
                <span id="resultTpid" class="result-value">
                  0x8100
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">TCI</span>
                <span id="resultTci" class="result-value">
                  0x0064
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Range Count</span>
                <span id="resultRangeCount" class="result-value">
                  11 VLANs
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Native VLAN</span>
                <span id="resultNativeVlan" class="result-value">
                  1
                </span>
              </div>

              <div class="result-item full">
                <span class="result-label">
                  Full Tag Bytes
                </span>

                <span id="resultTagBytes" class="result-value">
                  81 00 00 64
                </span>
              </div>
            </div>

            <div class="bit-layout">
              <h3>Tag Control Information Bit Layout</h3>

              <div class="bit-row">
                <div class="bit-part">
                  PCP · 3 bits
                  <span id="pcpBits" class="bit-value">
                    000
                  </span>
                </div>

                <div class="bit-part">
                  DEI · 1 bit
                  <span id="deiBits" class="bit-value">
                    0
                  </span>
                </div>

                <div class="bit-part">
                  VLAN ID · 12 bits
                  <span id="vlanBits" class="bit-value">
                    000001100100
                  </span>
                </div>
              </div>
            </div>

            <div
              id="configurationSection"
              class="explanation"
            >
              <h3>Switch configuration examples</h3>

              <pre
                id="configurationOutput"
                class="tag-output"
                style="color:#1e3a8a; font-size:14px;"
              ></pre>
            </div>

            <div class="explanation">
              <h3>Calculation explanation</h3>

              <ul
                id="explanationList"
                class="explanation-list"
              ></ul>
            </div>

            <div class="warning">
              VLAN 0 is reserved for priority tagging, and VLAN 4095 is
              reserved. Normal VLAN configuration should use IDs from 1
              through 4094.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>VLAN ID Reference</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>VLAN ID</th>
                <th>Classification</th>
                <th>Description</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td><code>0</code></td>
                <td>Reserved</td>
                <td>
                  Used for priority-tagged frames without VLAN membership.
                </td>
              </tr>

              <tr>
                <td><code>1</code></td>
                <td>Default VLAN</td>
                <td>
                  Common default VLAN on many switches. Avoid using it for
                  production user traffic where possible.
                </td>
              </tr>

              <tr>
                <td><code>2–1001</code></td>
                <td>Normal range</td>
                <td>
                  Commonly supported across traditional Ethernet switches.
                </td>
              </tr>

              <tr>
                <td><code>1002–1005</code></td>
                <td>Legacy reserved</td>
                <td>
                  Historically reserved by some Cisco platforms for FDDI and
                  Token Ring.
                </td>
              </tr>

              <tr>
                <td><code>1006–4094</code></td>
                <td>Extended range</td>
                <td>
                  Extended VLAN identifiers supported by modern switching
                  platforms.
                </td>
              </tr>

              <tr>
                <td><code>4095</code></td>
                <td>Reserved</td>
                <td>
                  Reserved by IEEE 802.1Q and not available for normal VLAN
                  assignment.
                </td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="reference-section">
          <h2>IEEE 802.1Q Tag Fields</h2>

          <div class="info-grid">
            <article class="info-card">
              <strong>TPID</strong>
              <p>
                A 16-bit Tag Protocol Identifier. The standard customer VLAN
                value is 0x8100.
              </p>
            </article>

            <article class="info-card">
              <strong>PCP</strong>
              <p>
                A three-bit Priority Code Point used to classify Ethernet
                traffic from priority 0 to 7.
              </p>
            </article>

            <article class="info-card">
              <strong>DEI</strong>
              <p>
                A one-bit Drop Eligible Indicator used to mark frames that can
                be dropped during congestion.
              </p>
            </article>

            <article class="info-card">
              <strong>VLAN ID</strong>
              <p>
                A 12-bit identifier that supports values from 0 through 4095.
              </p>
            </article>

            <article class="info-card">
              <strong>TCI</strong>
              <p>
                The 16-bit Tag Control Information field containing PCP, DEI,
                and the VLAN ID.
              </p>
            </article>

            <article class="info-card">
              <strong>QinQ</strong>
              <p>
                VLAN stacking that places an additional provider VLAN tag
                around a customer VLAN tag.
              </p>
            </article>
          </div>
        </section>
      </section>
    </main>

