---
const pageTitle = "Ping Command Generator | Gokuruvi Tools";
const description =
  "Generate ping commands for Linux, macOS, and Windows with options for packet count, timeout, interval, packet size, IPv4, IPv6, and continuous ping.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/ping-command-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 780px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1120px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus,
      select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 8px;
      }

      .checkbox-item {
        display: flex;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .command-box {
        position: relative;
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #e2e8f0;
      }

      .command-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .command-output {
        min-height: 58px;
        margin: 0;
        overflow-x: auto;
        color: #ffffff;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-family: Consolas, "Courier New", monospace;
        font-size: 16px;
        line-height: 1.7;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid #bfdbfe;
        border-radius: 11px;
        background: #eff6ff;
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: #1e3a8a;
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: #1e3a8a;
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1120px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 880px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .checkbox-grid,
        .result-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Ping Command Generator</h1>

        <p>
          Generate ready-to-use ping commands for Linux, macOS, and Windows
          with packet count, timeout, packet size, interval, IPv4, and IPv6
          options.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Configure Ping Command</h2>

            <p class="card-description">
              Select your operating system and configure the required ping
              options.
            </p>

            <div class="form-group">
              <label for="targetInput">Hostname or IP address</label>

              <input
                id="targetInput"
                type="text"
                value="8.8.8.8"
                placeholder="Example: 8.8.8.8 or example.com"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />

              <p class="help-text">
                Enter a hostname, IPv4 address, or IPv6 address without a URL
                scheme.
              </p>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="osSelect">Operating system</label>

                <select id="osSelect">
                  <option value="linux" selected>Linux</option>
                  <option value="macos">macOS</option>
                  <option value="windows">Windows</option>
                </select>
              </div>

              <div class="form-group">
                <label for="ipVersionSelect">IP version</label>

                <select id="ipVersionSelect">
                  <option value="auto" selected>Automatic</option>
                  <option value="ipv4">IPv4 only</option>
                  <option value="ipv6">IPv6 only</option>
                </select>
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="countInput">Packet count</label>

                <input
                  id="countInput"
                  type="number"
                  value="4"
                  min="1"
                  max="1000"
                />
              </div>

              <div class="form-group">
                <label for="timeoutInput">
                  Timeout
                  <span id="timeoutUnitLabel">(seconds)</span>
                </label>

                <input
                  id="timeoutInput"
                  type="number"
                  value="5"
                  min="1"
                  max="60000"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="sizeInput">Packet size in bytes</label>

                <input
                  id="sizeInput"
                  type="number"
                  value="56"
                  min="0"
                  max="65500"
                />
              </div>

              <div class="form-group">
                <label for="intervalInput">
                  Interval
                  <span id="intervalUnitLabel">(seconds)</span>
                </label>

                <input
                  id="intervalInput"
                  type="number"
                  value="1"
                  min="0.2"
                  max="60"
                  step="0.1"
                />
              </div>
            </div>

            <div class="form-group">
              <label>Additional options</label>

              <div class="checkbox-grid">
                <div class="checkbox-item">
                  <input
                    id="continuousInput"
                    type="checkbox"
                  />

                  <label for="continuousInput">
                    Continuous ping
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="numericInput"
                    type="checkbox"
                  />

                  <label for="numericInput">
                    Numeric output only
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="quietInput"
                    type="checkbox"
                  />

                  <label for="quietInput">
                    Summary-only output
                  </label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="dontFragmentInput"
                    type="checkbox"
                  />

                  <label for="dontFragmentInput">
                    Do not fragment
                  </label>
                </div>
              </div>
            </div>

            <div>
              <p class="preset-title">Quick targets</p>

              <div class="preset-buttons">
                <button
                  class="preset"
                  type="button"
                  data-target="8.8.8.8"
                >
                  Google DNS
                </button>

                <button
                  class="preset"
                  type="button"
                  data-target="1.1.1.1"
                >
                  Cloudflare DNS
                </button>

                <button
                  class="preset"
                  type="button"
                  data-target="localhost"
                >
                  Localhost
                </button>

                <button
                  class="preset"
                  type="button"
                  data-target="example.com"
                >
                  Example.com
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Command
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Generated Ping Command</h2>

            <p class="card-description">
              Review the command before running it in your terminal or command
              prompt.
            </p>

            <div class="command-box">
              <span class="command-label">Command</span>

              <pre id="commandOutput" class="command-output"></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy Command
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Operating System</span>
                <span id="resultOs" class="result-value">Linux</span>
              </div>

              <div class="result-item">
                <span class="result-label">Target</span>
                <span id="resultTarget" class="result-value">8.8.8.8</span>
              </div>

              <div class="result-item">
                <span class="result-label">Packet Count</span>
                <span id="resultCount" class="result-value">4</span>
              </div>

              <div class="result-item">
                <span class="result-label">IP Version</span>
                <span id="resultIpVersion" class="result-value">
                  Automatic
                </span>
              </div>

              <div class="result-item full">
                <span class="result-label">Command Shell</span>
                <span id="resultShell" class="result-value">
                  Bash / compatible shell
                </span>
              </div>
            </div>

            <div class="explanation">
              <h3>Command explanation</h3>

              <ul
                id="explanationList"
                class="explanation-list"
              ></ul>
            </div>

            <div class="warning">
              Ping may be blocked by firewalls, security groups, routers, or
              the destination server. A failed ping does not always mean the
              system is offline.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Common Ping Command Examples</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>Purpose</th>
                <th>Linux/macOS</th>
                <th>Windows</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Send four packets</td>
                <td><code>ping -c 4 example.com</code></td>
                <td><code>ping -n 4 example.com</code></td>
              </tr>

              <tr>
                <td>Continuous ping</td>
                <td><code>ping example.com</code></td>
                <td><code>ping -t example.com</code></td>
              </tr>

              <tr>
                <td>IPv4 only</td>
                <td><code>ping -4 example.com</code></td>
                <td><code>ping -4 example.com</code></td>
              </tr>

              <tr>
                <td>IPv6 only</td>
                <td><code>ping -6 example.com</code></td>
                <td><code>ping -6 example.com</code></td>
              </tr>

              <tr>
                <td>Custom packet size</td>
                <td><code>ping -s 1200 example.com</code></td>
                <td><code>ping -l 1200 example.com</code></td>
              </tr>

              <tr>
                <td>Numeric output</td>
                <td><code>ping -n example.com</code></td>
                <td>Not required</td>
              </tr>
            </tbody>
          </table>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All Rights Reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const targetInput = document.getElementById("targetInput");
      const osSelect = document.getElementById("osSelect");
      const ipVersionSelect =
        document.getElementById("ipVersionSelect");

      const countInput = document.getElementById("countInput");
      const timeoutInput = document.getElementById("timeoutInput");
      const sizeInput = document.getElementById("sizeInput");
      const intervalInput = document.getElementById("intervalInput");

      const continuousInput =
        document.getElementById("continuousInput");
      const numericInput = document.getElementById("numericInput");
      const quietInput = document.getElementById("quietInput");
      const dontFragmentInput =
        document.getElementById("dontFragmentInput");

      const timeoutUnitLabel =
        document.getElementById("timeoutUnitLabel");
      const intervalUnitLabel =
        document.getElementById("intervalUnitLabel");

      const generateButton =
        document.getElementById("generateButton");
      const resetButton = document.getElementById("resetButton");
      const copyButton = document.getElementById("copyButton");

      const commandOutput =
        document.getElementById("commandOutput");
      const explanationList =
        document.getElementById("explanationList");
      const message = document.getElementById("message");

      let currentCommand = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function isValidTarget(target) {
        if (!target || target.length > 253) {
          return false;
        }

        if (
          target.includes("://") ||
          target.includes("/") ||
          target.includes("?") ||
          target.includes("#") ||
          target.includes("@") ||
          /\s/.test(target)
        ) {
          return false;
        }

        const hostnamePattern =
          /^(localhost|(?=.{1,253}$)(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)$/i;

        const ipv4Pattern =
          /^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$/;

        const ipv6Pattern =
          /^[0-9a-f:]+$/i;

        return (
          hostnamePattern.test(target) ||
          ipv4Pattern.test(target) ||
          ipv6Pattern.test(target)
        );
      }

      function quoteTarget(target) {
        if (/^[a-z0-9.:_-]+$/i.test(target)) {
          return target;
        }

        return `"${target.replace(/"/g, '\\"')}"`;
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function updateOsFields() {
        const os = osSelect.value;
        const isWindows = os === "windows";

        timeoutUnitLabel.textContent = isWindows
          ? "(milliseconds)"
          : "(seconds)";

        intervalUnitLabel.textContent = isWindows
          ? "(not supported)"
          : "(seconds)";

        intervalInput.disabled = isWindows;
        quietInput.disabled = isWindows;

        if (isWindows) {
          if (Number(timeoutInput.value) < 100) {
            timeoutInput.value = "5000";
          }

          sizeInput.value =
            Number(sizeInput.value) === 56
              ? "32"
              : sizeInput.value;
        } else {
          if (Number(timeoutInput.value) > 600) {
            timeoutInput.value = "5";
          }

          sizeInput.value =
            Number(sizeInput.value) === 32
              ? "56"
              : sizeInput.value;
        }

        generateCommand();
      }

      function generateLinuxCommand(target, os) {
        const parts = ["ping"];
        const explanations = [];

        const ipVersion = ipVersionSelect.value;
        const continuous = continuousInput.checked;

        if (ipVersion === "ipv4") {
          parts.push("-4");
          explanations.push("Force the command to use IPv4.");
        }

        if (ipVersion === "ipv6") {
          parts.push("-6");
          explanations.push("Force the command to use IPv6.");
        }

        if (!continuous) {
          const count = Number(countInput.value);
          parts.push("-c", String(count));

          explanations.push(
            `Send ${count} echo request packet${count === 1 ? "" : "s"}.`
          );
        } else {
          explanations.push(
            "Continue sending packets until the command is stopped with Ctrl+C."
          );
        }

        const timeout = Number(timeoutInput.value);

        if (os === "linux") {
          parts.push("-W", String(timeout));

          explanations.push(
            `Wait up to ${timeout} second${timeout === 1 ? "" : "s"} for each response.`
          );
        } else {
          parts.push("-W", String(timeout * 1000));

          explanations.push(
            `Wait up to ${timeout} second${timeout === 1 ? "" : "s"} for each response.`
          );
        }

        const size = Number(sizeInput.value);

        if (size > 0) {
          parts.push("-s", String(size));

          explanations.push(
            `Send ${size} bytes of ICMP payload data.`
          );
        }

        const interval = Number(intervalInput.value);

        if (interval > 0) {
          parts.push("-i", String(interval));

          explanations.push(
            `Wait ${interval} second${interval === 1 ? "" : "s"} between packets.`
          );
        }

        if (numericInput.checked) {
          parts.push("-n");

          explanations.push(
            "Display numeric addresses without reverse DNS lookup."
          );
        }

        if (quietInput.checked) {
          parts.push("-q");

          explanations.push(
            "Show only the summary instead of every response."
          );
        }

        if (dontFragmentInput.checked) {
          if (os === "linux") {
            parts.push("-M", "do");

            explanations.push(
              "Set the IPv4 Don't Fragment policy."
            );
          } else {
            explanations.push(
              "macOS ping does not use the Linux -M do option; the setting was not added."
            );
          }
        }

        parts.push(quoteTarget(target));

        return {
          command: parts.join(" "),
          explanations,
        };
      }

      function generateWindowsCommand(target) {
        const parts = ["ping"];
        const explanations = [];

        const ipVersion = ipVersionSelect.value;
        const continuous = continuousInput.checked;

        if (ipVersion === "ipv4") {
          parts.push("-4");
          explanations.push("Force the command to use IPv4.");
        }

        if (ipVersion === "ipv6") {
          parts.push("-6");
          explanations.push("Force the command to use IPv6.");
        }

        if (continuous) {
          parts.push("-t");

          explanations.push(
            "Continue sending packets until the command is stopped with Ctrl+C."
          );
        } else {
          const count = Number(countInput.value);
          parts.push("-n", String(count));

          explanations.push(
            `Send ${count} echo request packet${count === 1 ? "" : "s"}.`
          );
        }

        const timeout = Number(timeoutInput.value);

        parts.push("-w", String(timeout));

        explanations.push(
          `Wait up to ${timeout} milliseconds for each response.`
        );

        const size = Number(sizeInput.value);

        if (size > 0) {
          parts.push("-l", String(size));

          explanations.push(
            `Send ${size} bytes of ICMP payload data.`
          );
        }

        if (dontFragmentInput.checked) {
          parts.push("-f");

          explanations.push(
            "Set the Don't Fragment flag for IPv4 packets."
          );
        }

        if (numericInput.checked) {
          explanations.push(
            "Windows ping already displays the destination IP in its output."
          );
        }

        parts.push(quoteTarget(target));

        return {
          command: parts.join(" "),
          explanations,
        };
      }

      function generateCommand() {
        clearMessage();

        const target = targetInput.value.trim();
        const os = osSelect.value;

        if (!isValidTarget(target)) {
          currentCommand = "";
          commandOutput.textContent =
            "Enter a valid hostname or IP address.";

          explanationList.innerHTML = "";

          showMessage(
            "Enter a valid hostname, IPv4 address, or IPv6 address.",
            "error"
          );

          return;
        }

        const count = Number(countInput.value);
        const timeout = Number(timeoutInput.value);
        const size = Number(sizeInput.value);
        const interval = Number(intervalInput.value);

        if (
          !Number.isInteger(count) ||
          count < 1 ||
          count > 1000
        ) {
          showMessage(
            "Packet count must be between 1 and 1000.",
            "error"
          );

          return;
        }

        if (
          !Number.isFinite(timeout) ||
          timeout <= 0
        ) {
          showMessage(
            "Enter a valid timeout value.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(size) ||
          size < 0 ||
          size > 65500
        ) {
          showMessage(
            "Packet size must be between 0 and 65500 bytes.",
            "error"
          );

          return;
        }

        if (
          os !== "windows" &&
          (!Number.isFinite(interval) ||
            interval < 0.2 ||
            interval > 60)
        ) {
          showMessage(
            "Interval must be between 0.2 and 60 seconds.",
            "error"
          );

          return;
        }

        const generated =
          os === "windows"
            ? generateWindowsCommand(target)
            : generateLinuxCommand(target, os);

        currentCommand = generated.command;
        commandOutput.textContent = currentCommand;

        explanationList.innerHTML = "";

        generated.explanations.forEach((item) => {
          addExplanation(item);
        });

        addExplanation(
          `Send ICMP echo requests to ${target}.`
        );

        const osNames = {
          linux: "Linux",
          macos: "macOS",
          windows: "Windows",
        };

        const ipVersionNames = {
          auto: "Automatic",
          ipv4: "IPv4 only",
          ipv6: "IPv6 only",
        };

        document.getElementById("resultOs").textContent =
          osNames[os];

        document.getElementById("resultTarget").textContent =
          target;

        document.getElementById("resultCount").textContent =
          continuousInput.checked
            ? "Continuous"
            : String(count);

        document.getElementById(
          "resultIpVersion"
        ).textContent = ipVersionNames[ipVersionSelect.value];

        document.getElementById("resultShell").textContent =
          os === "windows"
            ? "Command Prompt / PowerShell"
            : "Bash / compatible shell";
      }

      function resetGenerator() {
        targetInput.value = "8.8.8.8";
        osSelect.value = "linux";
        ipVersionSelect.value = "auto";
        countInput.value = "4";
        timeoutInput.value = "5";
        sizeInput.value = "56";
        intervalInput.value = "1";

        continuousInput.checked = false;
        numericInput.checked = false;
        quietInput.checked = false;
        dontFragmentInput.checked = false;

        clearMessage();
        updateOsFields();
        targetInput.focus();
      }

      async function copyCommand() {
        if (!currentCommand) {
          showMessage(
            "Generate a command before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(currentCommand);

          const originalText = copyButton.textContent;
          copyButton.textContent = "Copied!";

          showMessage(
            "Ping command copied successfully.",
            "success"
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the command manually.",
            "error"
          );
        }
      }

      generateButton.addEventListener(
        "click",
        generateCommand
      );

      resetButton.addEventListener(
        "click",
        resetGenerator
      );

      copyButton.addEventListener(
        "click",
        copyCommand
      );

      osSelect.addEventListener(
        "change",
        updateOsFields
      );

      [
        targetInput,
        ipVersionSelect,
        countInput,
        timeoutInput,
        sizeInput,
        intervalInput,
        continuousInput,
        numericInput,
        quietInput,
        dontFragmentInput,
      ].forEach((element) => {
        element.addEventListener(
          "input",
          generateCommand
        );

        element.addEventListener(
          "change",
          generateCommand
        );
      });

      targetInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          generateCommand();
        }
      });

      document.querySelectorAll(".preset").forEach((button) => {
        button.addEventListener("click", () => {
          targetInput.value = button.dataset.target;
          generateCommand();
        });
      });

      updateOsFields();
    </script>
  </body>
</html>