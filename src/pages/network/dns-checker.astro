---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="DNS Checker" description="Check common DNS records for a domain name.">
  <section class="tool-hero"><span class="eyebrow">Network · DNS</span><h1>DNS Checker</h1><p>Query common DNS record types and review the answers returned by a DNS-over-HTTPS resolver.</p></section>
  <div class="tool-wrap"><a class="back" href="/network/">← Back to Network Tools</a><section class="tool-card"><h2>DNS lookup</h2><div class="grid"><div class="field"><label for="name">Domain</label><input id="name" placeholder="example.com" /></div><div class="field"><label for="type">Record type</label><select id="type"><option>A</option><option>AAAA</option><option>MX</option><option>NS</option><option>TXT</option><option>CNAME</option><option>SOA</option></select></div></div><div class="actions"><button id="check">Check DNS</button></div><div class="result" id="result" aria-live="polite">Enter a domain to start.</div></section></div>
  <script>
    const result = document.querySelector<HTMLElement>("#result");
    const checkButton = document.querySelector<HTMLButtonElement>("#check");
    const nameInput = document.querySelector<HTMLInputElement>("#name");
    const typeSelect = document.querySelector<HTMLSelectElement>("#type");

    const escapeHtml = (value: string) =>
      value.replace(/[&<>]/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
      })[character] ?? character);

    checkButton?.addEventListener("click", async () => {
      const name = nameInput?.value.trim() ?? "";
      const type = typeSelect?.value ?? "A";

      if (!name) {
        if (result) result.textContent = "Enter a domain name.";
        return;
      }

      if (result) result.textContent = "Checking…";

      try {
        const response = await fetch(
          `/api/dns-checker?name=${encodeURIComponent(name)}&type=${encodeURIComponent(type)}`,
        );
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "DNS lookup failed.");

        const answers = (data.Answer ?? [])
          .map((answer: { name?: string; TTL?: number; data?: string }) =>
            `${answer.name ?? ""}  ${answer.TTL ?? ""}  ${answer.data ?? ""}`,
          )
          .join("\n");

        if (result) {
          result.innerHTML = answers
            ? `<pre>${escapeHtml(answers)}</pre>`
            : "No answer records returned.";
        }
      } catch (error) {
        if (result) {
          result.textContent =
            error instanceof Error ? error.message : "DNS lookup failed.";
        }
      }
    });
  </script>
<style>  .tool-hero { padding: 62px 20px 42px; background: linear-gradient(135deg,#eff6ff,#f8fafc); text-align:center; }
  .tool-hero .eyebrow { display:inline-flex; padding:6px 11px; border-radius:999px; background:#dbeafe; color:#1d4ed8; font-size:13px; font-weight:800; }
  .tool-hero h1 { margin:14px 0 10px; color:#0f172a; font-size:clamp(34px,5vw,52px); line-height:1.1; }
  .tool-hero p { max-width:760px; margin:0 auto; color:#64748b; font-size:17px; }
  .tool-wrap { width:min(calc(100% - 32px),960px); margin:38px auto 72px; }
  .tool-card { padding:28px; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 14px 34px rgba(15,23,42,.07); }
  .tool-card h2 { margin:0 0 8px; color:#0f172a; }
  .muted { color:#64748b; }
  .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .field { margin-top:18px; }
  label { display:block; margin-bottom:7px; color:#0f172a; font-weight:750; }
  input, select { width:100%; min-height:48px; padding:10px 12px; border:1px solid #cbd5e1; border-radius:10px; background:#fff; color:#0f172a; }
  input:focus, select:focus { outline:3px solid rgba(37,99,235,.14); border-color:#2563eb; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
  button { min-height:46px; padding:10px 17px; border:0; border-radius:10px; background:#2563eb; color:#fff; font-weight:800; cursor:pointer; }
  button.secondary { background:#e2e8f0; color:#0f172a; }
  .result { margin-top:22px; padding:18px; border:1px solid #dbeafe; border-radius:12px; background:#f8fbff; overflow-wrap:anywhere; }
  .result strong.big { display:block; color:#0f172a; font-size:30px; }
  .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .metric { padding:16px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; text-align:center; }
  .metric strong { display:block; color:#0f172a; font-size:24px; }
  pre { overflow:auto; padding:16px; border-radius:12px; background:#0f172a; color:#e2e8f0; white-space:pre-wrap; }
  .back { display:inline-block; margin-bottom:18px; color:#2563eb; font-weight:750; text-decoration:none; }
  @media (max-width:700px){ .grid,.metrics{grid-template-columns:1fr;} .tool-card{padding:20px;} }
</style>
</Layout>
