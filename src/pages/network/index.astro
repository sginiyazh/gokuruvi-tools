---
const pageTitle = "Network Tools";

const description =
  "Free networking calculators, command generators and utilities for IP addressing, DNS, ports, VLANs, SSL certificates and troubleshooting.";

const tools = [
  {
    icon: "🧮",
    name: "Subnet Calculator",
    description:
      "Calculate network address, broadcast address, subnet mask, usable hosts and IP ranges.",
    link: "/network/subnet-calculator",
  },
  {
    icon: "🌐",
    name: "IP Calculator",
    description:
      "Calculate IPv4 network details, host ranges, subnet masks and address information.",
    link: "/network/ip-calculator",
  },
  {
    icon: "🔢",
    name: "CIDR Calculator",
    description:
      "Convert CIDR notation into subnet masks, network ranges and usable host counts.",
    link: "/network/cidr-calculator",
  },
  {
    icon: "0️⃣",
    name: "IPv4 to Binary",
    description:
      "Convert an IPv4 address into its binary representation quickly and accurately.",
    link: "/network/ipv4-to-binary",
  },
  {
    icon: "1️⃣",
    name: "Binary to IPv4",
    description:
      "Convert a 32-bit binary network address into a standard IPv4 address.",
    link: "/network/binary-to-ipv4",
  },
  {
    icon: "🔌",
    name: "Port Checker",
    description:
      "Check common TCP and UDP port information and identify their associated services.",
    link: "/network/port-checker",
  },
  {
    icon: "📡",
    name: "Ping Command Generator",
    description:
      "Generate ping commands for Linux, Windows and macOS with custom options.",
    link: "/network/ping-command-generator",
  },
  {
    icon: "🛣️",
    name: "Traceroute Generator",
    description:
      "Build traceroute or tracert commands to troubleshoot network paths and connectivity.",
    link: "/network/traceroute-command-generator",
  },
  {
    icon: "🔍",
    name: "NSLookup Generator",
    description:
      "Generate nslookup commands to query DNS records and troubleshoot name resolution.",
    link: "/network/nslookup-generator",
  },
  {
    icon: "🧭",
    name: "DIG Command Generator",
    description:
      "Create dig commands for A, AAAA, MX, NS, TXT, CNAME and reverse DNS lookups.",
    link: "/network/dig-command-generator",
  },
  {
    icon: "📊",
    name: "Netstat Command Generator",
    description:
      "Generate netstat commands to view connections, ports, routes and network statistics.",
    link: "/network/netstat-command-generator",
  },
  {
    icon: "🏷️",
    name: "VLAN Calculator",
    description:
      "Validate VLAN IDs and calculate VLAN ranges for network configuration planning.",
    link: "/network/vlan-calculator",
  },
  {
    icon: "💻",
    name: "MAC Address Formatter",
    description:
      "Format and validate MAC addresses for Linux, Windows, Cisco and other platforms.",
    link: "/network/mac-address-lookup",
  },
  {
    icon: "🗃️",
    name: "DNS Record Generator",
    description:
      "Generate common DNS records including A, AAAA, CNAME, MX, TXT and PTR.",
    link: "/network/dns-record-generator",
  },
  {
    icon: "🔐",
    name: "SSL Certificate Checker",
    description:
      "Check SSL certificate installation, validity, trust status and website TLS security configuration.",
    link: "/network/ssl-checker",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="network tools, subnet calculator, IP calculator, CIDR calculator, SSL checker, SSL certificate checker, DNS tools, port checker, ping generator, traceroute generator, VLAN calculator, network troubleshooting"
    />

    <meta name="author" content="Gokuruvi Tools" />

    <meta
      property="og:title"
      content="Network Tools | Gokuruvi Tools"
    />

    <meta property="og:description" content={description} />

    <meta property="og:type" content="website" />

    <meta
      property="og:url"
      content="https://www.gokuruvi.com/network"
    />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network"
    />

    <title>{pageTitle} | Gokuruvi Tools</title>

    <style>
      :root {
        --primary: #0f766e;
        --primary-dark: #115e59;
        --secondary: #22d3ee;
        --dark: #0f172a;
        --text: #172033;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --max-width: 1180px;

        font-family:
          Inter, Arial, Helvetica, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
      }

      .container {
        width: min(100% - 40px, var(--max-width));
        margin-inline: auto;
      }

      /* Header */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--dark);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .navbar {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 21px;
        font-weight: 800;
        text-decoration: none;
      }

      .logo-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );
        font-size: 22px;
      }

      .nav-links {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: #cbd5e1;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
      }

      .nav-links a:hover,
      .nav-links a[aria-current="page"] {
        color: #ffffff;
      }

      /* Hero */

      .hero {
        padding: 82px 0 68px;
        background:
          radial-gradient(
            circle at 10% 20%,
            rgba(34, 211, 238, 0.16),
            transparent 30%
          ),
          radial-gradient(
            circle at 90% 30%,
            rgba(15, 118, 110, 0.16),
            transparent 32%
          ),
          linear-gradient(
            145deg,
            #f8fafc,
            #ecfeff,
            #f8fafc
          );
      }

      .hero-content {
        max-width: 820px;
        margin: auto;
        text-align: center;
      }

      .badge {
        display: inline-block;
        margin-bottom: 18px;
        padding: 7px 14px;
        border: 1px solid #99f6e4;
        border-radius: 999px;
        background: #ffffff;
        color: var(--primary-dark);
        font-size: 14px;
        font-weight: 800;
      }

      .hero h1 {
        margin: 0 0 16px;
        color: var(--dark);
        font-size: clamp(40px, 6vw, 60px);
        line-height: 1.1;
      }

      .hero p {
        max-width: 760px;
        margin: 0 auto;
        color: #475569;
        font-size: 18px;
      }

      /* Tools */

      .tools-section {
        padding: 65px 0 85px;
      }

      .section-heading {
        max-width: 720px;
        margin: 0 auto 45px;
        text-align: center;
      }

      .section-heading h2 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: 34px;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 17px;
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
      }

      .tool-card {
        display: flex;
        min-height: 260px;
        flex-direction: column;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .tool-card:hover {
        transform: translateY(-6px);
        border-color: #5eead4;
        box-shadow: 0 20px 40px rgba(15, 118, 110, 0.14);
      }

      .tool-card:focus-visible {
        outline: 3px solid rgba(34, 211, 238, 0.55);
        outline-offset: 4px;
      }

      .tool-icon {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        margin-bottom: 20px;
        border-radius: 14px;
        background: #ecfeff;
        font-size: 27px;
      }

      .tool-card h3 {
        margin: 0 0 11px;
        color: var(--dark);
        font-size: 22px;
      }

      .tool-card p {
        flex: 1;
        margin: 0 0 20px;
        color: var(--muted);
        line-height: 1.7;
      }

      .open-tool {
        color: var(--primary);
        font-weight: 800;
      }

      /* Information */

      .information {
        padding-bottom: 85px;
      }

      .information-box {
        padding: 36px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: #ffffff;
      }

      .information-box h2 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: 27px;
      }

      .information-box p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
      }

      /* Footer */

      footer {
        background: var(--dark);
        color: #cbd5e1;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 28px 0;
      }

      .footer-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      /* Responsive */

      @media (max-width: 1000px) {
        .tools-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 900px) {
        .nav-links {
          gap: 16px;
        }
      }

      @media (max-width: 800px) {
        .navbar {
          align-items: flex-start;
          flex-direction: column;
          padding: 16px 0;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 28px, var(--max-width));
        }

        .hero {
          padding: 60px 0 50px;
        }

        .hero h1 {
          font-size: 38px;
        }

        .tools-grid {
          grid-template-columns: 1fr;
        }

        .tool-card {
          min-height: auto;
        }

        .section-heading h2 {
          font-size: 29px;
        }

        .information-box {
          padding: 27px;
        }

        .footer-inner {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <nav class="navbar" aria-label="Main navigation">
          <a class="logo" href="/">
            <span class="logo-icon" aria-hidden="true">🌐</span>
            <span>Gokuruvi Tools</span>
          </a>

          <div class="nav-links">
            <a href="/">Home</a>
            <a href="/linux">Linux</a>
            <a href="/devops">DevOps</a>
            <a href="/kubernetes">Kubernetes</a>
            <a href="/cloud">Cloud</a>
            <a href="/network" aria-current="page">Network</a>
            <a href="/about">About</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-content">
          <span class="badge">
            Free networking utilities
          </span>

          <h1>Network Tools</h1>

          <p>{description}</p>
        </div>
      </section>

      <section class="tools-section">
        <div class="container">
          <div class="section-heading">
            <h2>Networking calculators and generators</h2>

            <p>
              Select a networking tool to calculate IP information, check SSL
              certificates, generate commands, create DNS records or
              troubleshoot connectivity.
            </p>
          </div>

          <div class="tools-grid">
            {
              tools.map((tool) => (
                <a class="tool-card" href={tool.link}>
                  <div class="tool-icon" aria-hidden="true">
                    {tool.icon}
                  </div>

                  <h3>{tool.name}</h3>

                  <p>{tool.description}</p>

                  <span class="open-tool">
                    Open tool →
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="information">
        <div class="container">
          <div class="information-box">
            <h2>Browser-based network tools</h2>

            <p>
              Use these free browser-based networking utilities to calculate
              subnets, convert IP addresses, check SSL certificates, generate
              troubleshooting commands, create DNS records and review common
              network configuration information. Always validate generated
              commands before running them in a production environment.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>
          © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
        </span>

        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
      </div>
    </footer>
  </body>
</html>