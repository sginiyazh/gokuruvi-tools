---
import Header from "../../components/Header.astro";

const pageTitle = "Network Tools";

const description =
  "Free networking calculators, command generators and utilities for IP addressing, DNS, ports, VLANs, SSL certificates and troubleshooting.";

const tools = [
  {
    icon: "🧮",
    name: "Subnet Calculator",
    category: "IP Addressing",
    description:
      "Calculate network address, broadcast address, subnet mask, usable hosts and IP ranges.",
    link: "/network/subnet-calculator",
  },
  {
    icon: "🌐",
    name: "IP Calculator",
    category: "IP Addressing",
    description:
      "Calculate IPv4 network details, host ranges, subnet masks and address information.",
    link: "/network/ip-calculator",
  },
  {
    icon: "🔢",
    name: "CIDR Calculator",
    category: "IP Addressing",
    description:
      "Convert CIDR notation into subnet masks, network ranges and usable host counts.",
    link: "/network/cidr-calculator",
  },
  {
    icon: "0️⃣",
    name: "IPv4 to Binary",
    category: "Conversion",
    description:
      "Convert an IPv4 address into its binary representation quickly and accurately.",
    link: "/network/ipv4-to-binary",
  },
  {
    icon: "1️⃣",
    name: "Binary to IPv4",
    category: "Conversion",
    description:
      "Convert a 32-bit binary network address into a standard IPv4 address.",
    link: "/network/binary-to-ipv4",
  },
  {
    icon: "🔌",
    name: "Port Checker",
    category: "Ports",
    description:
      "Check common TCP and UDP port information and identify their associated services.",
    link: "/network/port-checker",
  },
  {
    icon: "📡",
    name: "Ping Command Generator",
    category: "Troubleshooting",
    description:
      "Generate ping commands for Linux, Windows and macOS with custom options.",
    link: "/network/ping-command-generator",
  },
  {
    icon: "🛣️",
    name: "Traceroute Generator",
    category: "Troubleshooting",
    description:
      "Build traceroute or tracert commands to troubleshoot network paths and connectivity.",
    link: "/network/traceroute-command-generator",
  },
  {
    icon: "🔍",
    name: "NSLookup Generator",
    category: "DNS",
    description:
      "Generate nslookup commands to query DNS records and troubleshoot name resolution.",
    link: "/network/nslookup-generator",
  },
  {
    icon: "🧭",
    name: "DIG Command Generator",
    category: "DNS",
    description:
      "Create dig commands for A, AAAA, MX, NS, TXT, CNAME and reverse DNS lookups.",
    link: "/network/dig-command-generator",
  },
  {
    icon: "📊",
    name: "Netstat Command Generator",
    category: "Diagnostics",
    description:
      "Generate netstat commands to view connections, ports, routes and network statistics.",
    link: "/network/netstat-command-generator",
  },
  {
    icon: "🏷️",
    name: "VLAN Calculator",
    category: "Switching",
    description:
      "Validate VLAN IDs and calculate VLAN ranges for network configuration planning.",
    link: "/network/vlan-calculator",
  },
  {
    icon: "💻",
    name: "MAC Address Formatter",
    category: "Layer 2",
    description:
      "Format and validate MAC addresses for Linux, Windows, Cisco and other platforms.",
    link: "/network/mac-address-lookup",
  },
  {
    icon: "🗃️",
    name: "DNS Record Generator",
    category: "DNS",
    description:
      "Generate common DNS records including A, AAAA, CNAME, MX, TXT and PTR.",
    link: "/network/dns-record-generator",
  },
  {
    icon: "🔐",
    name: "SSL Certificate Checker",
    category: "Security",
    description:
      "Check SSL certificate installation, validity, trust status and website TLS security configuration.",
    link: "/network/ssl-checker",
  },
];

const benefits = [
  {
    icon: "⚡",
    title: "Fast calculations",
    description:
      "Calculate addresses, ranges, ports and DNS values instantly in your browser.",
  },
  {
    icon: "🧭",
    title: "Troubleshooting support",
    description:
      "Generate reliable commands for ping, traceroute, DNS and connection analysis.",
  },
  {
    icon: "🔒",
    title: "Privacy friendly",
    description:
      "Most network values are processed locally without requiring registration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="network tools, subnet calculator, IP calculator, CIDR calculator, SSL checker, DNS tools, port checker, ping generator, traceroute generator, VLAN calculator, network troubleshooting"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:title" content="Network Tools | Gokuruvi Tools" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <meta
      property="og:url"
      content="https://www.gokuruvi.com/network/"
    />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle} | Gokuruvi Tools</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-badge">
              <span class="badge-dot" aria-hidden="true"></span>
              Free tools for network professionals
            </div>

            <h1>
              Practical <span>Network Tools</span>
            </h1>

            <p class="hero-description">
              Calculate subnets and CIDR ranges, generate DNS and troubleshooting
              commands, validate MAC addresses, inspect ports and review SSL
              certificate information using simple browser-based tools.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#network-tools">
                Explore Network Tools
                <span aria-hidden="true">→</span>
              </a>

              <a class="button button-secondary" href="/#tool-categories">
                Browse All Categories
              </a>
            </div>

            <div class="hero-statistics">
              <div class="hero-stat">
                <strong>{tools.length}</strong>
                <span>Free utilities</span>
              </div>

              <div class="hero-stat">
                <strong>IPv4</strong>
                <span>Addressing support</span>
              </div>

              <div class="hero-stat">
                <strong>DNS</strong>
                <span>Lookup and record tools</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="network-tools">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Available Utilities</span>

            <h2>Network tools for addressing and troubleshooting</h2>

            <p>
              Select a utility to calculate IP information, generate network
              commands, create DNS records, validate VLANs or check SSL details.
            </p>
          </div>

          <div class="tools-grid">
            {
              tools.map((tool) => (
                <a
                  class="tool-card"
                  href={tool.link}
                  aria-label={`Open ${tool.name}`}
                >
                  <div class="tool-header">
                    <div class="tool-icon" aria-hidden="true">{tool.icon}</div>
                    <span class="tool-category">{tool.category}</span>
                  </div>

                  <h3>{tool.name}</h3>
                  <p>{tool.description}</p>

                  <span class="open-tool">
                    Open tool
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Why Gokuruvi</span>

            <h2>Built for network administrators and engineers</h2>

            <p>
              Use practical utilities for planning, troubleshooting and
              validating common network configurations.
            </p>
          </div>

          <div class="benefits-grid">
            {
              benefits.map((benefit) => (
                <article class="benefit-card">
                  <div class="benefit-icon" aria-hidden="true">
                    {benefit.icon}
                  </div>

                  <h3>{benefit.title}</h3>
                  <p>{benefit.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container">
          <div class="cta-box">
            <h2>Start simplifying your network tasks</h2>

            <p>
              Calculate subnet details, generate DNS commands and troubleshoot
              connectivity using free online networking tools.
            </p>

            <a
              class="button cta-button"
              href="/network/subnet-calculator"
            >
              Open Subnet Calculator
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="footer-logo" href="/">
              <span class="footer-logo-icon" aria-hidden="true">G</span>
              <span>Gokuruvi Tools</span>
            </a>

            <p>
              Free Linux, DevOps, Kubernetes, network, cloud and security
              utilities for administrators, engineers and IT professionals.
            </p>
          </div>

          <div>
            <h3 class="footer-title">Network Tools</h3>

            <div class="footer-links">
              <a href="/network/subnet-calculator">Subnet Calculator</a>
              <a href="/network/ip-calculator">IP Calculator</a>
              <a href="/network/cidr-calculator">CIDR Calculator</a>
              <a href="/network/port-checker">Port Checker</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Diagnostics</h3>

            <div class="footer-links">
              <a href="/network/ping-command-generator">Ping Generator</a>
              <a href="/network/traceroute-command-generator">Traceroute Generator</a>
              <a href="/network/nslookup-generator">NSLookup Generator</a>
              <a href="/network/dig-command-generator">DIG Generator</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Categories</h3>

            <div class="footer-links">
              <a href="/linux/">Linux Tools</a>
              <a href="/devops/">DevOps Tools</a>
              <a href="/kubernetes/">Kubernetes Tools</a>
              <a href="/network/">Network Tools</a>
              <a href="/cloud/">Cloud Tools</a>
              <a href="/about/">About</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
          </span>

          <div class="footer-bottom-links">
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/disclaimer/">Disclaimer</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #172033;
    font-family:
      Inter, Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 105px 0 92px;
    background:
      radial-gradient(circle at 15% 15%, rgba(56, 189, 248, 0.2), transparent 32%),
      radial-gradient(circle at 88% 25%, rgba(37, 99, 235, 0.2), transparent 34%),
      linear-gradient(145deg, #f8fafc 0%, #eff6ff 52%, #f8fafc 100%);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 24px;
    padding: 8px 16px;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.12);
  }

  .hero h1 {
    margin: 0 auto 22px;
    color: #0f172a;
    font-size: clamp(43px, 7vw, 72px);
    line-height: 1.06;
    letter-spacing: -2.5px;
  }

  .hero h1 span {
    background: linear-gradient(90deg, #2563eb, #0284c7);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 790px;
    margin: 0 auto;
    color: #475569;
    font-size: clamp(18px, 2.5vw, 21px);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.26);
  }

  .button-primary:hover {
    background: #1d4ed8;
    box-shadow: 0 16px 38px rgba(37, 99, 235, 0.32);
  }

  .button-secondary {
    border-color: #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
  }

  .hero-statistics {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    margin-top: 42px;
  }

  .hero-stat {
    min-width: 135px;
  }

  .hero-stat strong {
    display: block;
    color: #0f172a;
    font-size: 25px;
  }

  .hero-stat span {
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
  }

  .section {
    padding: 92px 0;
  }

  .section-white {
    background: #ffffff;
  }

  .section-heading {
    max-width: 770px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(31px, 4vw, 44px);
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 18px;
    line-height: 1.75;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .tool-card {
    position: relative;
    display: flex;
    min-height: 310px;
    flex-direction: column;
    overflow: hidden;
    padding: 29px;
    border: 1px solid #e2e8f0;
    border-radius: 19px;
    background: #ffffff;
    text-decoration: none;
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .tool-card::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, #2563eb, #38bdf8);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .tool-card::after {
    position: absolute;
    right: -55px;
    bottom: -65px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.065);
    content: "";
    transition: transform 0.3s ease;
  }

  .tool-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 24px 50px rgba(37, 99, 235, 0.14);
    transform: translateY(-8px);
  }

  .tool-card:hover::before {
    transform: scaleX(1);
  }

  .tool-card:hover::after {
    transform: scale(1.25);
  }

  .tool-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }

  .tool-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 15px;
    background: linear-gradient(135deg, #eff6ff, #e0f2fe);
    font-size: 29px;
  }

  .tool-category {
    padding: 5px 10px;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 12px;
    font-weight: 800;
  }

  .tool-card h3 {
    margin: 0 0 11px;
    color: #0f172a;
    font-size: 22px;
    line-height: 1.3;
  }

  .tool-card p {
    flex: 1;
    margin: 0 0 22px;
    color: #64748b;
    line-height: 1.72;
  }

  .open-tool {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #2563eb;
    font-size: 15px;
    font-weight: 850;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .benefit-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #ffffff;
  }

  .benefit-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 14px;
    background: #eff6ff;
    font-size: 25px;
  }

  .benefit-card h3 {
    margin: 0 0 9px;
    color: #0f172a;
    font-size: 20px;
  }

  .benefit-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .cta {
    padding: 0 0 92px;
  }

  .cta-box {
    padding: 70px 35px;
    border-radius: 25px;
    background:
      radial-gradient(circle at 10% 20%, rgba(56, 189, 248, 0.28), transparent 31%),
      linear-gradient(135deg, #0f172a, #1e3a8a);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 25px 65px rgba(15, 23, 42, 0.2);
  }

  .cta-box h2 {
    max-width: 720px;
    margin: 0 auto 15px;
    font-size: clamp(30px, 4vw, 45px);
    line-height: 1.2;
  }

  .cta-box p {
    max-width: 670px;
    margin: 0 auto 29px;
    color: #cbd5e1;
    font-size: 18px;
    line-height: 1.75;
  }

  .cta-button {
    background: #ffffff;
    color: #1d4ed8;
  }

  footer {
    background: #0f172a;
    color: #cbd5e1;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 55px;
    padding: 65px 0 45px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #ffffff;
    font-size: 21px;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-logo-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 11px;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
  }

  .footer-brand p {
    max-width: 380px;
    margin: 17px 0 0;
    color: #94a3b8;
    line-height: 1.75;
  }

  .footer-title {
    margin: 0 0 18px;
    color: #ffffff;
    font-size: 16px;
  }

  .footer-links {
    display: grid;
    gap: 12px;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 24px 0;
    border-top: 1px solid #334155;
    color: #94a3b8;
    font-size: 14px;
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .footer-bottom-links a {
    color: #94a3b8;
    text-decoration: none;
  }

  @media (max-width: 1000px) {
    .tools-grid,
    .benefits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding: 78px 0 70px;
    }

    .section {
      padding: 72px 0;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, 1180px);
    }

    .hero h1 {
      font-size: 41px;
      letter-spacing: -1.4px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .tools-grid,
    .benefits-grid,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .tool-card {
      min-height: auto;
      padding: 25px;
    }

    .cta-box {
      padding: 52px 23px;
    }
  }
</style>
