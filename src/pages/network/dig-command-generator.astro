---
const pageTitle = "Dig Command Generator | Gokuruvi Tools";
const description =
  "Generate dig DNS lookup commands for A, AAAA, MX, NS, TXT, CNAME, PTR, SOA, SRV, CAA, DNSSEC, reverse lookup, trace, TCP, and custom DNS servers.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="theme-color" content="#0f172a" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/network/dig-command-generator"
    />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;

        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;

        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;

        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Inter, Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select {
        font: inherit;
      }

      a {
        color: var(--primary);
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1140px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 58px 20px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(38px, 6vw, 54px);
        line-height: 1.15;
      }

      .hero p {
        max-width: 820px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 55px 20px 80px;
      }

      .tool-layout {
        display: grid;
        max-width: 1120px;
        margin: 0 auto;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 24px;
      }

      .card-description {
        margin: 0 0 24px;
        color: var(--muted);
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus,
      select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.13);
      }

      input:disabled,
      select:disabled {
        cursor: not-allowed;
        background: #f1f5f9;
        color: #94a3b8;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .help-text {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #f8fafc;
        align-items: center;
        gap: 10px;
      }

      .checkbox-item input {
        width: 18px;
        min-height: auto;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
      }

      .checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 14px;
      }

      .preset-group {
        margin-top: 20px;
      }

      .preset-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 700;
      }

      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .preset {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #eff6ff;
        color: var(--primary-dark);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
      }

      .button {
        min-height: 45px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .message {
        display: none;
        margin-top: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .command-box {
        margin-top: 20px;
        padding: 22px;
        border-radius: 12px;
        background: var(--dark);
        color: #e2e8f0;
      }

      .command-label {
        display: block;
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 700;
      }

      .command-output {
        min-height: 72px;
        margin: 0;
        overflow-x: auto;
        color: #ffffff;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-family: Consolas, "Courier New", monospace;
        font-size: 16px;
        line-height: 1.7;
      }

      .result-grid {
        display: grid;
        margin-top: 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
      }

      .result-item {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-item.full {
        grid-column: 1 / -1;
      }

      .result-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .result-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
      }

      .explanation {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid #bfdbfe;
        border-radius: 11px;
        background: #eff6ff;
      }

      .explanation h3 {
        margin: 0 0 10px;
        color: #1e3a8a;
        font-size: 17px;
      }

      .explanation-list {
        margin: 0;
        padding-left: 20px;
        color: #1e3a8a;
      }

      .explanation-list li {
        margin: 6px 0;
      }

      .warning {
        margin-top: 18px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        max-width: 1120px;
        margin: 30px auto 0;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
      }

      .reference-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .reference-table code {
        color: var(--primary-dark);
        font-family: Consolas, "Courier New", monospace;
        font-weight: 700;
      }

      .record-grid {
        display: grid;
        margin-top: 20px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .record-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #f8fafc;
      }

      .record-card strong {
        display: block;
        margin-bottom: 5px;
        color: var(--dark);
      }

      .record-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
        font-size: 14px;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 880px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }

        .record-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .checkbox-grid,
        .result-grid,
        .record-grid {
          grid-template-columns: 1fr;
        }

        .result-item.full {
          grid-column: auto;
        }

        .card,
        .reference-section {
          padding: 22px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a class="active" href="/network">Network</a>
          <a href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Dig Command Generator</h1>

        <p>
          Generate ready-to-use dig commands for DNS lookups, reverse DNS,
          DNSSEC validation, authoritative tracing, custom DNS servers, TCP
          queries, and detailed troubleshooting.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Configure Dig Command</h2>

            <p class="card-description">
              Enter a domain or IP address and select the required DNS query
              options.
            </p>

            <div class="form-group">
              <label for="targetInput">Domain name or IP address</label>

              <input
                id="targetInput"
                type="text"
                value="example.com"
                placeholder="Example: example.com or 8.8.8.8"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />

              <p class="help-text">
                Enter a domain for a forward lookup or an IP address for a
                reverse DNS lookup.
              </p>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="recordTypeSelect">DNS record type</label>

                <select id="recordTypeSelect">
                  <option value="A" selected>A - IPv4 address</option>
                  <option value="AAAA">AAAA - IPv6 address</option>
                  <option value="MX">MX - Mail server</option>
                  <option value="NS">NS - Name server</option>
                  <option value="TXT">TXT - Text record</option>
                  <option value="CNAME">CNAME - Canonical name</option>
                  <option value="PTR">PTR - Reverse DNS</option>
                  <option value="SOA">SOA - Start of authority</option>
                  <option value="SRV">SRV - Service record</option>
                  <option value="CAA">CAA - Certificate authority</option>
                  <option value="NAPTR">NAPTR - Naming authority</option>
                  <option value="DNSKEY">DNSKEY - DNSSEC key</option>
                  <option value="DS">DS - Delegation signer</option>
                  <option value="ANY">ANY - Available records</option>
                </select>
              </div>

              <div class="form-group">
                <label for="queryClassSelect">DNS query class</label>

                <select id="queryClassSelect">
                  <option value="IN" selected>IN - Internet</option>
                  <option value="CH">CH - Chaos</option>
                  <option value="HS">HS - Hesiod</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="dnsServerInput">Custom DNS server</label>

              <input
                id="dnsServerInput"
                type="text"
                placeholder="Optional: 8.8.8.8 or dns.google"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />

              <p class="help-text">
                Leave empty to use the DNS resolver configured on your system.
              </p>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="portInput">DNS server port</label>

                <input
                  id="portInput"
                  type="number"
                  value="53"
                  min="1"
                  max="65535"
                />
              </div>

              <div class="form-group">
                <label for="timeoutInput">Timeout in seconds</label>

                <input
                  id="timeoutInput"
                  type="number"
                  value="5"
                  min="1"
                  max="60"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="triesInput">Query attempts</label>

                <input
                  id="triesInput"
                  type="number"
                  value="2"
                  min="1"
                  max="10"
                />
              </div>

              <div class="form-group">
                <label for="ednsInput">EDNS version</label>

                <select id="ednsInput">
                  <option value="default" selected>System default</option>
                  <option value="0">EDNS version 0</option>
                  <option value="disable">Disable EDNS</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Output options</label>

              <div class="checkbox-grid">
                <div class="checkbox-item">
                  <input
                    id="shortInput"
                    type="checkbox"
                  />

                  <label for="shortInput">Short answer only</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="answerOnlyInput"
                    type="checkbox"
                  />

                  <label for="answerOnlyInput">Answer section only</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="commentsInput"
                    type="checkbox"
                    checked
                  />

                  <label for="commentsInput">Show comments</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="statsInput"
                    type="checkbox"
                    checked
                  />

                  <label for="statsInput">Show query statistics</label>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label>Advanced options</label>

              <div class="checkbox-grid">
                <div class="checkbox-item">
                  <input
                    id="tcpInput"
                    type="checkbox"
                  />

                  <label for="tcpInput">Use TCP</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="dnssecInput"
                    type="checkbox"
                  />

                  <label for="dnssecInput">Request DNSSEC records</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="traceInput"
                    type="checkbox"
                  />

                  <label for="traceInput">Trace delegation path</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="reverseInput"
                    type="checkbox"
                  />

                  <label for="reverseInput">Reverse DNS lookup</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="recursiveInput"
                    type="checkbox"
                    checked
                  />

                  <label for="recursiveInput">Recursive query</label>
                </div>

                <div class="checkbox-item">
                  <input
                    id="ignoreTruncationInput"
                    type="checkbox"
                  />

                  <label for="ignoreTruncationInput">
                    Ignore truncation
                  </label>
                </div>
              </div>
            </div>

            <div class="preset-group">
              <p class="preset-title">Quick DNS servers</p>

              <div class="preset-buttons">
                <button
                  class="preset dns-preset"
                  type="button"
                  data-server="8.8.8.8"
                >
                  Google DNS
                </button>

                <button
                  class="preset dns-preset"
                  type="button"
                  data-server="1.1.1.1"
                >
                  Cloudflare DNS
                </button>

                <button
                  class="preset dns-preset"
                  type="button"
                  data-server="9.9.9.9"
                >
                  Quad9 DNS
                </button>

                <button
                  class="preset dns-preset"
                  type="button"
                  data-server="208.67.222.222"
                >
                  OpenDNS
                </button>

                <button
                  class="preset dns-preset"
                  type="button"
                  data-server=""
                >
                  System DNS
                </button>
              </div>
            </div>

            <div class="preset-group">
              <p class="preset-title">Quick queries</p>

              <div class="preset-buttons">
                <button
                  class="preset query-preset"
                  type="button"
                  data-target="example.com"
                  data-type="A"
                >
                  A Record
                </button>

                <button
                  class="preset query-preset"
                  type="button"
                  data-target="example.com"
                  data-type="MX"
                >
                  MX Record
                </button>

                <button
                  class="preset query-preset"
                  type="button"
                  data-target="example.com"
                  data-type="TXT"
                >
                  TXT Record
                </button>

                <button
                  class="preset query-preset"
                  type="button"
                  data-target="8.8.8.8"
                  data-type="PTR"
                  data-reverse="true"
                >
                  Reverse DNS
                </button>

                <button
                  class="preset trace-preset"
                  type="button"
                >
                  DNS Trace
                </button>
              </div>
            </div>

            <div class="button-row">
              <button
                id="generateButton"
                class="button primary-button"
                type="button"
              >
                Generate Command
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Generated Dig Command</h2>

            <p class="card-description">
              Review the command before running it in your terminal.
            </p>

            <div class="command-box">
              <span class="command-label">Command</span>

              <pre id="commandOutput" class="command-output"></pre>
            </div>

            <div class="button-row">
              <button
                id="copyButton"
                class="button primary-button"
                type="button"
              >
                Copy Command
              </button>
            </div>

            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Target</span>
                <span id="resultTarget" class="result-value">
                  example.com
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Record Type</span>
                <span id="resultRecordType" class="result-value">
                  A
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">DNS Server</span>
                <span id="resultDnsServer" class="result-value">
                  System default
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Server Port</span>
                <span id="resultPort" class="result-value">
                  53
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Transport</span>
                <span id="resultTransport" class="result-value">
                  UDP
                </span>
              </div>

              <div class="result-item">
                <span class="result-label">Query Mode</span>
                <span id="resultMode" class="result-value">
                  Recursive
                </span>
              </div>

              <div class="result-item full">
                <span class="result-label">Recommended Environment</span>
                <span id="resultEnvironment" class="result-value">
                  Linux, macOS, Unix, WSL or BIND utilities
                </span>
              </div>
            </div>

            <div class="explanation">
              <h3>Command explanation</h3>

              <ul
                id="explanationList"
                class="explanation-list"
              ></ul>
            </div>

            <div class="warning">
              DNS results can differ based on resolver cache, DNS propagation,
              geographic routing, record TTL, split DNS, and the selected DNS
              server.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Common Dig Command Examples</h2>

          <table class="reference-table">
            <thead>
              <tr>
                <th>Purpose</th>
                <th>Command</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Basic A-record lookup</td>
                <td><code>dig example.com A</code></td>
              </tr>

              <tr>
                <td>Short result only</td>
                <td><code>dig example.com A +short</code></td>
              </tr>

              <tr>
                <td>Query MX records</td>
                <td><code>dig example.com MX</code></td>
              </tr>

              <tr>
                <td>Query TXT records</td>
                <td><code>dig example.com TXT</code></td>
              </tr>

              <tr>
                <td>Use Google DNS</td>
                <td><code>dig @8.8.8.8 example.com A</code></td>
              </tr>

              <tr>
                <td>Reverse DNS lookup</td>
                <td><code>dig -x 8.8.8.8</code></td>
              </tr>

              <tr>
                <td>Trace DNS delegation</td>
                <td><code>dig example.com +trace</code></td>
              </tr>

              <tr>
                <td>Request DNSSEC records</td>
                <td><code>dig example.com A +dnssec</code></td>
              </tr>

              <tr>
                <td>Use TCP transport</td>
                <td><code>dig example.com A +tcp</code></td>
              </tr>

              <tr>
                <td>Answer section only</td>
                <td>
                  <code>
                    dig example.com A +noall +answer
                  </code>
                </td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="reference-section">
          <h2>Common DNS Record Types</h2>

          <div class="record-grid">
            <article class="record-card">
              <strong>A</strong>
              <p>Maps a hostname to an IPv4 address.</p>
            </article>

            <article class="record-card">
              <strong>AAAA</strong>
              <p>Maps a hostname to an IPv6 address.</p>
            </article>

            <article class="record-card">
              <strong>MX</strong>
              <p>Lists mail servers responsible for a domain.</p>
            </article>

            <article class="record-card">
              <strong>NS</strong>
              <p>Lists authoritative name servers for a zone.</p>
            </article>

            <article class="record-card">
              <strong>TXT</strong>
              <p>Stores text such as SPF and verification values.</p>
            </article>

            <article class="record-card">
              <strong>CNAME</strong>
              <p>Maps an alias hostname to a canonical hostname.</p>
            </article>

            <article class="record-card">
              <strong>PTR</strong>
              <p>Maps an IP address back to a hostname.</p>
            </article>

            <article class="record-card">
              <strong>SOA</strong>
              <p>Contains DNS zone authority and timing details.</p>
            </article>

            <article class="record-card">
              <strong>SRV</strong>
              <p>Identifies the hostname and port of a service.</p>
            </article>

            <article class="record-card">
              <strong>CAA</strong>
              <p>Controls which certificate authorities may issue certificates.</p>
            </article>

            <article class="record-card">
              <strong>DNSKEY</strong>
              <p>Publishes public keys used for DNSSEC validation.</p>
            </article>

            <article class="record-card">
              <strong>DS</strong>
              <p>Links a child DNSSEC zone to its parent zone.</p>
            </article>
          </div>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All Rights Reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      const targetInput =
        document.getElementById("targetInput");

      const recordTypeSelect =
        document.getElementById("recordTypeSelect");

      const queryClassSelect =
        document.getElementById("queryClassSelect");

      const dnsServerInput =
        document.getElementById("dnsServerInput");

      const portInput =
        document.getElementById("portInput");

      const timeoutInput =
        document.getElementById("timeoutInput");

      const triesInput =
        document.getElementById("triesInput");

      const ednsInput =
        document.getElementById("ednsInput");

      const shortInput =
        document.getElementById("shortInput");

      const answerOnlyInput =
        document.getElementById("answerOnlyInput");

      const commentsInput =
        document.getElementById("commentsInput");

      const statsInput =
        document.getElementById("statsInput");

      const tcpInput =
        document.getElementById("tcpInput");

      const dnssecInput =
        document.getElementById("dnssecInput");

      const traceInput =
        document.getElementById("traceInput");

      const reverseInput =
        document.getElementById("reverseInput");

      const recursiveInput =
        document.getElementById("recursiveInput");

      const ignoreTruncationInput =
        document.getElementById("ignoreTruncationInput");

      const generateButton =
        document.getElementById("generateButton");

      const resetButton =
        document.getElementById("resetButton");

      const copyButton =
        document.getElementById("copyButton");

      const commandOutput =
        document.getElementById("commandOutput");

      const explanationList =
        document.getElementById("explanationList");

      const message =
        document.getElementById("message");

      let currentCommand = "";

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      function clearMessage() {
        message.textContent = "";
        message.className = "message";
      }

      function addExplanation(text) {
        const item = document.createElement("li");
        item.textContent = text;
        explanationList.appendChild(item);
      }

      function isValidIPv4(value) {
        const pattern =
          /^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$/;

        return pattern.test(value);
      }

      function isValidIPv6(value) {
        return (
          value.includes(":") &&
          /^[0-9a-f:]+$/i.test(value) &&
          value.length <= 45
        );
      }

      function isValidHostname(value) {
        const pattern =
          /^(?=.{1,253}$)(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i;

        return pattern.test(value);
      }

      function isValidTarget(value) {
        if (
          !value ||
          value.length > 253 ||
          value.includes("://") ||
          value.includes("/") ||
          value.includes("?") ||
          value.includes("#") ||
          value.includes("@") ||
          /\s/.test(value)
        ) {
          return false;
        }

        return (
          isValidIPv4(value) ||
          isValidIPv6(value) ||
          isValidHostname(value)
        );
      }

      function isValidDnsServer(value) {
        if (!value) {
          return true;
        }

        return (
          isValidIPv4(value) ||
          isValidIPv6(value) ||
          isValidHostname(value)
        );
      }

      function quoteValue(value) {
        if (/^[a-z0-9.:_-]+$/i.test(value)) {
          return value;
        }

        return `"${value.replace(/"/g, '\\"')}"`;
      }

      function generateCommand() {
        clearMessage();

        const target = targetInput.value.trim();
        const recordType = recordTypeSelect.value;
        const queryClass = queryClassSelect.value;
        const dnsServer = dnsServerInput.value.trim();
        const port = Number(portInput.value);
        const timeout = Number(timeoutInput.value);
        const tries = Number(triesInput.value);

        if (!isValidTarget(target)) {
          currentCommand = "";

          commandOutput.textContent =
            "Enter a valid domain name, IPv4 address, or IPv6 address.";

          explanationList.innerHTML = "";

          showMessage(
            "Enter a valid domain name or IP address without a URL scheme, path, or spaces.",
            "error"
          );

          return;
        }

        if (!isValidDnsServer(dnsServer)) {
          showMessage(
            "Enter a valid custom DNS server hostname or IP address.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(port) ||
          port < 1 ||
          port > 65535
        ) {
          showMessage(
            "DNS server port must be between 1 and 65535.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(timeout) ||
          timeout < 1 ||
          timeout > 60
        ) {
          showMessage(
            "Timeout must be between 1 and 60 seconds.",
            "error"
          );

          return;
        }

        if (
          !Number.isInteger(tries) ||
          tries < 1 ||
          tries > 10
        ) {
          showMessage(
            "Query attempts must be between 1 and 10.",
            "error"
          );

          return;
        }

        const parts = ["dig"];
        const explanations = [];

        if (dnsServer) {
          parts.push(`@${quoteValue(dnsServer)}`);

          explanations.push(
            `Send the query to DNS server ${dnsServer}.`
          );
        } else {
          explanations.push(
            "Use the DNS resolver configured on the local system."
          );
        }

        if (port !== 53) {
          parts.push("-p", String(port));

          explanations.push(
            `Connect to DNS server port ${port}.`
          );
        }

        if (reverseInput.checked) {
          if (
            !isValidIPv4(target) &&
            !isValidIPv6(target)
          ) {
            showMessage(
              "Reverse DNS mode requires a valid IPv4 or IPv6 address.",
              "error"
            );

            return;
          }

          parts.push("-x", quoteValue(target));

          explanations.push(
            `Perform a reverse DNS lookup for ${target}.`
          );
        } else {
          parts.push(
            quoteValue(target),
            queryClass,
            recordType
          );

          explanations.push(
            `Query the ${recordType} record for ${target}.`
          );

          explanations.push(
            `Use the ${queryClass} DNS query class.`
          );
        }

        parts.push(`+time=${timeout}`);

        explanations.push(
          `Wait up to ${timeout} second${timeout === 1 ? "" : "s"} for a response.`
        );

        parts.push(`+tries=${tries}`);

        explanations.push(
          `Attempt the DNS query up to ${tries} time${tries === 1 ? "" : "s"}.`
        );

        if (tcpInput.checked) {
          parts.push("+tcp");

          explanations.push(
            "Use TCP instead of the default UDP transport."
          );
        }

        if (dnssecInput.checked) {
          parts.push("+dnssec");

          explanations.push(
            "Request DNSSEC-related records in the response."
          );
        }

        if (traceInput.checked) {
          parts.push("+trace");

          explanations.push(
            "Trace DNS delegation from the root servers to the authoritative server."
          );
        }

        if (!recursiveInput.checked) {
          parts.push("+norecurse");

          explanations.push(
            "Disable recursive resolution."
          );
        } else {
          explanations.push(
            "Request recursive DNS resolution."
          );
        }

        if (ignoreTruncationInput.checked) {
          parts.push("+ignore");

          explanations.push(
            "Ignore truncation and avoid automatically retrying with TCP."
          );
        }

        if (ednsInput.value === "0") {
          parts.push("+edns=0");

          explanations.push(
            "Use EDNS version 0."
          );
        }

        if (ednsInput.value === "disable") {
          parts.push("+noedns");

          explanations.push(
            "Disable EDNS for this query."
          );
        }

        if (shortInput.checked) {
          parts.push("+short");

          explanations.push(
            "Display only a shortened answer."
          );
        } else if (answerOnlyInput.checked) {
          parts.push("+noall", "+answer");

          explanations.push(
            "Hide other sections and display only the answer section."
          );
        } else {
          if (!commentsInput.checked) {
            parts.push("+nocomments");

            explanations.push(
              "Hide descriptive comments in the output."
            );
          }

          if (!statsInput.checked) {
            parts.push("+nostats");

            explanations.push(
              "Hide query timing and server statistics."
            );
          }
        }

        currentCommand = parts.join(" ");
        commandOutput.textContent = currentCommand;

        explanationList.innerHTML = "";

        explanations.forEach((item) => {
          addExplanation(item);
        });

        document.getElementById(
          "resultTarget"
        ).textContent = target;

        document.getElementById(
          "resultRecordType"
        ).textContent = reverseInput.checked
          ? "PTR / Reverse DNS"
          : recordType;

        document.getElementById(
          "resultDnsServer"
        ).textContent = dnsServer || "System default";

        document.getElementById(
          "resultPort"
        ).textContent = String(port);

        document.getElementById(
          "resultTransport"
        ).textContent = tcpInput.checked
          ? "TCP"
          : "UDP";

        document.getElementById(
          "resultMode"
        ).textContent = traceInput.checked
          ? "Delegation trace"
          : recursiveInput.checked
            ? "Recursive"
            : "Non-recursive";
      }

      function updateOptionState() {
        if (shortInput.checked) {
          answerOnlyInput.checked = false;
          answerOnlyInput.disabled = true;
          commentsInput.disabled = true;
          statsInput.disabled = true;
        } else {
          answerOnlyInput.disabled = false;

          commentsInput.disabled =
            answerOnlyInput.checked;

          statsInput.disabled =
            answerOnlyInput.checked;
        }

        if (traceInput.checked) {
          dnsServerInput.disabled = true;
          recursiveInput.disabled = true;
        } else {
          dnsServerInput.disabled = false;
          recursiveInput.disabled = false;
        }

        if (reverseInput.checked) {
          recordTypeSelect.value = "PTR";
          recordTypeSelect.disabled = true;
          queryClassSelect.disabled = true;
        } else {
          recordTypeSelect.disabled = false;
          queryClassSelect.disabled = false;
        }

        generateCommand();
      }

      function resetGenerator() {
        targetInput.value = "example.com";
        recordTypeSelect.value = "A";
        queryClassSelect.value = "IN";
        dnsServerInput.value = "";
        portInput.value = "53";
        timeoutInput.value = "5";
        triesInput.value = "2";
        ednsInput.value = "default";

        shortInput.checked = false;
        answerOnlyInput.checked = false;
        commentsInput.checked = true;
        statsInput.checked = true;

        tcpInput.checked = false;
        dnssecInput.checked = false;
        traceInput.checked = false;
        reverseInput.checked = false;
        recursiveInput.checked = true;
        ignoreTruncationInput.checked = false;

        shortInput.disabled = false;
        answerOnlyInput.disabled = false;
        commentsInput.disabled = false;
        statsInput.disabled = false;
        dnsServerInput.disabled = false;
        recursiveInput.disabled = false;
        recordTypeSelect.disabled = false;
        queryClassSelect.disabled = false;

        clearMessage();
        generateCommand();
        targetInput.focus();
      }

      async function copyCommand() {
        if (!currentCommand) {
          showMessage(
            "Generate a command before copying.",
            "error"
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(
            currentCommand
          );

          const originalText = copyButton.textContent;
          copyButton.textContent = "Copied!";

          showMessage(
            "Dig command copied successfully.",
            "success"
          );

          setTimeout(() => {
            copyButton.textContent = originalText;
          }, 1500);
        } catch {
          showMessage(
            "Unable to copy automatically. Please copy the command manually.",
            "error"
          );
        }
      }

      generateButton.addEventListener(
        "click",
        generateCommand
      );

      resetButton.addEventListener(
        "click",
        resetGenerator
      );

      copyButton.addEventListener(
        "click",
        copyCommand
      );

      [
        shortInput,
        answerOnlyInput,
        traceInput,
        reverseInput,
      ].forEach((element) => {
        element.addEventListener(
          "change",
          updateOptionState
        );
      });

      [
        targetInput,
        recordTypeSelect,
        queryClassSelect,
        dnsServerInput,
        portInput,
        timeoutInput,
        triesInput,
        ednsInput,
        commentsInput,
        statsInput,
        tcpInput,
        dnssecInput,
        recursiveInput,
        ignoreTruncationInput,
      ].forEach((element) => {
        element.addEventListener(
          "input",
          generateCommand
        );

        element.addEventListener(
          "change",
          generateCommand
        );
      });

      targetInput.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Enter") {
            generateCommand();
          }
        }
      );

      document
        .querySelectorAll(".dns-preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            dnsServerInput.value =
              button.dataset.server || "";

            generateCommand();
          });
        });

      document
        .querySelectorAll(".query-preset")
        .forEach((button) => {
          button.addEventListener("click", () => {
            targetInput.value =
              button.dataset.target || "";

            recordTypeSelect.value =
              button.dataset.type || "A";

            reverseInput.checked =
              button.dataset.reverse === "true";

            updateOptionState();
          });
        });

      document
        .querySelector(".trace-preset")
        .addEventListener("click", () => {
          targetInput.value = "example.com";
          reverseInput.checked = false;
          traceInput.checked = true;
          recordTypeSelect.value = "NS";

          updateOptionState();
        });

      generateCommand();
    </script>
  </body>
</html>