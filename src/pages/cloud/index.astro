---
const cloudTools = [
  {
    title: "CIDR Calculator",
    description:
      "Calculate network address, broadcast address, subnet mask, usable IP range, and total hosts from a CIDR block.",
    href: "/cloud/cidr-calculator",
    icon: "🌐",
    badge: "Networking",
  },
  {
    title: "Subnet Calculator",
    description:
      "Calculate subnet details, host ranges, broadcast addresses, and available IP addresses.",
    href: "/cloud/subnet-calculator",
    icon: "🧮",
    badge: "Networking",
  },
  {
    title: "IP Address Converter",
    description:
      "Convert IPv4 addresses between decimal, binary, hexadecimal, and integer formats.",
    href: "/cloud/ip-converter",
    icon: "🔄",
    badge: "IP Tools",
  },
  {
    title: "AWS ARN Parser",
    description:
      "Parse an AWS ARN and identify its partition, service, region, account ID, resource type, and resource name.",
    href: "/cloud/aws-arn-parser",
    icon: "☁️",
    badge: "AWS",
  },
  {
    title: "Azure Resource ID Parser",
    description:
      "Break down an Azure resource ID into subscription, resource group, provider, resource type, and resource name.",
    href: "/cloud/azure-resource-id-parser",
    icon: "🔷",
    badge: "Azure",
  },
  {
    title: "GCP Project ID Validator",
    description:
      "Validate Google Cloud project IDs and check whether they follow GCP naming requirements.",
    href: "/cloud/gcp-project-id-validator",
    icon: "🔍",
    badge: "Google Cloud",
  },
];

const featuredTools = cloudTools.slice(0, 3);

const pageTitle = "Free Cloud Tools and Calculators | Gokuruvi Tools";
const pageDescription =
  "Free cloud tools for AWS, Azure, Google Cloud, CIDR calculation, subnetting, IP conversion, ARN parsing, and cloud resource validation.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="cloud tools, CIDR calculator, subnet calculator, IP converter, AWS ARN parser, Azure resource ID parser, GCP project ID validator"
    />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://www.gokuruvi.com/cloud" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://www.gokuruvi.com/cloud" />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Gokuruvi Tools home">
          <span class="logo-icon">G</span>

          <span class="logo-text">
            <strong>Gokuruvi</strong>
            <small>Tools</small>
          </span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a href="/cloud" class="active">Cloud</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-pattern"></div>

        <div class="container hero-content">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span>Cloud Tools</span>
          </nav>

          <div class="hero-grid">
            <div class="hero-copy">
              <span class="eyebrow">Free online cloud utilities</span>

              <h1>Cloud Tools and Calculators</h1>

              <p>
                Practical tools for cloud engineers, system administrators,
                DevOps teams, and network professionals working with AWS,
                Microsoft Azure, Google Cloud, subnets, and IP addresses.
              </p>

              <div class="hero-actions">
                <a href="#all-tools" class="primary-button">
                  Explore Cloud Tools
                </a>

                <a href="/" class="secondary-button">
                  View All Categories
                </a>
              </div>

              <div class="hero-stats">
                <div>
                  <strong>{cloudTools.length}</strong>
                  <span>Cloud tools</span>
                </div>

                <div>
                  <strong>100%</strong>
                  <span>Free to use</span>
                </div>

                <div>
                  <strong>Private</strong>
                  <span>Runs in browser</span>
                </div>
              </div>
            </div>

            <div class="hero-visual" aria-hidden="true">
              <div class="cloud-scene">
                <div class="main-cloud">☁️</div>
                <div class="provider provider-aws">AWS</div>
                <div class="provider provider-azure">Azure</div>
                <div class="provider provider-gcp">GCP</div>

                <div class="connection connection-one"></div>
                <div class="connection connection-two"></div>
                <div class="connection connection-three"></div>

                <div class="server-card server-one">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="server-card server-two">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="features-section">
        <div class="container">
          <div class="feature-strip">
            <div class="feature">
              <span class="feature-icon">⚡</span>
              <div>
                <strong>Fast Results</strong>
                <p>Calculate and validate information instantly.</p>
              </div>
            </div>

            <div class="feature">
              <span class="feature-icon">🔒</span>
              <div>
                <strong>Privacy Friendly</strong>
                <p>Your entered information is not stored.</p>
              </div>
            </div>

            <div class="feature">
              <span class="feature-icon">📱</span>
              <div>
                <strong>Responsive</strong>
                <p>Works on desktop, tablet, and mobile.</p>
              </div>
            </div>

            <div class="feature">
              <span class="feature-icon">💯</span>
              <div>
                <strong>Completely Free</strong>
                <p>No registration or subscription required.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="featured-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="section-label">Popular utilities</span>
              <h2>Featured Cloud Tools</h2>
            </div>

            <a href="#all-tools" class="section-link">
              View all tools <span>→</span>
            </a>
          </div>

          <div class="featured-grid">
            {
              featuredTools.map((tool, index) => (
                <a href={tool.href} class="featured-card">
                  <div class="card-top">
                    <div class="tool-icon">{tool.icon}</div>
                    <span class="tool-number">
                      0{index + 1}
                    </span>
                  </div>

                  <span class="tool-badge">{tool.badge}</span>
                  <h3>{tool.title}</h3>
                  <p>{tool.description}</p>

                  <span class="open-tool">
                    Open Tool <span>→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="tools-section" id="all-tools">
        <div class="container">
          <div class="section-heading centered">
            <div>
              <span class="section-label">Cloud utilities</span>
              <h2>All Cloud Tools</h2>
              <p>
                Select a tool below to calculate, convert, parse, or validate
                your cloud and networking information.
              </p>
            </div>
          </div>

          <div class="tools-grid">
            {
              cloudTools.map((tool) => (
                <article class="tool-card">
                  <div class="tool-card-icon">{tool.icon}</div>

                  <div class="tool-card-content">
                    <div class="tool-card-heading">
                      <span class="tool-badge">{tool.badge}</span>
                      <h3>{tool.title}</h3>
                    </div>

                    <p>{tool.description}</p>

                    <a href={tool.href} class="tool-button">
                      Use {tool.title}
                      <span>→</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="information-section">
        <div class="container information-grid">
          <div class="information-content">
            <span class="section-label">Built for professionals</span>

            <h2>Make cloud administration easier</h2>

            <p>
              Cloud platforms use many different identifier formats, network
              structures, and naming rules. Gokuruvi Cloud Tools helps you
              understand and validate this information without installing
              additional software.
            </p>

            <ul>
              <li>
                <span>✓</span>
                Calculate CIDR and subnet information.
              </li>

              <li>
                <span>✓</span>
                Convert IP addresses into multiple formats.
              </li>

              <li>
                <span>✓</span>
                Parse AWS and Azure resource identifiers.
              </li>

              <li>
                <span>✓</span>
                Validate Google Cloud project names.
              </li>
            </ul>
          </div>

          <aside class="category-card">
            <span class="category-label">Explore more</span>
            <h3>Other tool categories</h3>

            <a href="/linux">
              <span class="category-icon">🐧</span>
              <span>
                <strong>Linux Tools</strong>
                <small>Commands, permissions, and administration</small>
              </span>
              <span class="category-arrow">→</span>
            </a>

            <a href="/devops">
              <span class="category-icon">⚙️</span>
              <span>
                <strong>DevOps Tools</strong>
                <small>YAML, JSON, Docker, and automation</small>
              </span>
              <span class="category-arrow">→</span>
            </a>

            <a href="/kubernetes">
              <span class="category-icon">☸️</span>
              <span>
                <strong>Kubernetes Tools</strong>
                <small>Generate and validate Kubernetes resources</small>
              </span>
              <span class="category-arrow">→</span>
            </a>
          </aside>
        </div>
      </section>

      <section class="cta-section">
        <div class="container">
          <div class="cta-box">
            <div>
              <span class="cta-label">Gokuruvi Tools</span>
              <h2>Simple tools for everyday technical work</h2>
              <p>
                Browse practical Linux, DevOps, Kubernetes, networking, and
                cloud utilities.
              </p>
            </div>

            <a href="/" class="cta-button">Explore All Tools</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo footer-logo">
            <span class="logo-icon">G</span>

            <span class="logo-text">
              <strong>Gokuruvi</strong>
              <small>Tools</small>
            </span>
          </a>

          <p>
            Free, fast, and privacy-friendly utilities for Linux, DevOps,
            Kubernetes, networking, and cloud professionals.
          </p>
        </div>

        <div class="footer-column">
          <h3>Categories</h3>
          <a href="/linux">Linux Tools</a>
          <a href="/devops">DevOps Tools</a>
          <a href="/kubernetes">Kubernetes Tools</a>
          <a href="/cloud">Cloud Tools</a>
        </div>

        <div class="footer-column">
          <h3>Company</h3>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms</a>
        </div>

        <div class="footer-column">
          <h3>Popular Tools</h3>
          <a href="/cloud/cidr-calculator">CIDR Calculator</a>
          <a href="/cloud/subnet-calculator">Subnet Calculator</a>
          <a href="/cloud/aws-arn-parser">AWS ARN Parser</a>
          <a href="/cloud/ip-converter">IP Converter</a>
        </div>
      </div>

      <div class="container footer-bottom">
        <p>
          © {new Date().getFullYear()} Sathish Ramalingam. All rights reserved.
        </p>

        <p>Built for system administrators and cloud engineers.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f6f8fc;
    color: #172033;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .logo-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    font-size: 21px;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.24);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-text strong {
    color: #111827;
    font-size: 18px;
  }

  .logo-text small {
    margin-top: 4px;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .main-nav a {
    padding: 9px 13px;
    border-radius: 9px;
    color: #475569;
    font-size: 14px;
    font-weight: 600;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .main-nav a:hover,
  .main-nav a.active {
    background: #eef2ff;
    color: #4f46e5;
  }

  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(59, 130, 246, 0.28),
        transparent 28%
      ),
      radial-gradient(
        circle at 20% 80%,
        rgba(124, 58, 237, 0.2),
        transparent 35%
      ),
      linear-gradient(135deg, #07152e 0%, #102b57 48%, #1e3a8a 100%);
    color: white;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 30px;
    padding-bottom: 85px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 42px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
  }

  .breadcrumb a:hover {
    color: white;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    align-items: center;
    gap: 70px;
  }

  .eyebrow,
  .section-label,
  .cta-label,
  .category-label {
    display: inline-block;
    color: #60a5fa;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 720px;
    margin: 14px 0 20px;
    font-size: clamp(42px, 6vw, 70px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 18px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .primary-button,
  .secondary-button,
  .cta-button {
    min-height: 49px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 21px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 750;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .primary-button {
    background: white;
    color: #1d4ed8;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }

  .primary-button:hover,
  .secondary-button:hover,
  .cta-button:hover {
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 40px;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
  }

  .hero-stats strong {
    color: white;
    font-size: 19px;
  }

  .hero-stats span {
    color: rgba(255, 255, 255, 0.58);
    font-size: 13px;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .cloud-scene {
    position: relative;
    width: 410px;
    height: 360px;
  }

  .main-cloud {
    position: absolute;
    top: 95px;
    left: 50%;
    z-index: 3;
    width: 145px;
    height: 105px;
    display: grid;
    place-items: center;
    transform: translateX(-50%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 35px;
    background: rgba(255, 255, 255, 0.13);
    font-size: 70px;
    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(15px);
  }

  .provider {
    position: absolute;
    z-index: 4;
    padding: 10px 15px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(10px);
  }

  .provider-aws {
    top: 28px;
    left: 18px;
  }

  .provider-azure {
    top: 25px;
    right: 0;
  }

  .provider-gcp {
    right: 28px;
    bottom: 58px;
  }

  .connection {
    position: absolute;
    z-index: 1;
    height: 1px;
    background: rgba(147, 197, 253, 0.55);
    transform-origin: left center;
  }

  .connection::after {
    content: "";
    position: absolute;
    top: -3px;
    right: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 15px #60a5fa;
  }

  .connection-one {
    top: 80px;
    left: 93px;
    width: 130px;
    transform: rotate(28deg);
  }

  .connection-two {
    top: 82px;
    left: 290px;
    width: 95px;
    transform: rotate(142deg);
  }

  .connection-three {
    top: 192px;
    left: 255px;
    width: 120px;
    transform: rotate(42deg);
  }

  .server-card {
    position: absolute;
    bottom: 35px;
    width: 92px;
    padding: 11px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    background: rgba(4, 17, 40, 0.45);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
  }

  .server-one {
    left: 8px;
  }

  .server-two {
    left: 125px;
    bottom: 5px;
  }

  .server-card span {
    display: block;
    height: 7px;
    margin: 6px 0;
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      rgba(96, 165, 250, 0.9),
      rgba(255, 255, 255, 0.18)
    );
  }

  .features-section {
    position: relative;
    z-index: 5;
    margin-top: -35px;
  }

  .feature-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    border: 1px solid #e5eaf2;
    border-radius: 18px;
    background: white;
    box-shadow: 0 18px 55px rgba(20, 35, 70, 0.11);
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 24px 20px;
    border-right: 1px solid #edf0f5;
  }

  .feature:last-child {
    border-right: 0;
  }

  .feature-icon {
    width: 39px;
    height: 39px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #eef4ff;
    font-size: 19px;
  }

  .feature strong {
    display: block;
    margin-bottom: 3px;
    color: #162036;
    font-size: 14px;
  }

  .feature p {
    margin: 0;
    color: #728096;
    font-size: 12px;
    line-height: 1.5;
  }

  .featured-section,
  .tools-section,
  .information-section,
  .cta-section {
    padding: 90px 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 32px;
  }

  .section-heading.centered {
    justify-content: center;
    text-align: center;
  }

  .section-heading h2,
  .information-content h2,
  .cta-box h2 {
    margin: 8px 0 0;
    color: #111827;
    font-size: clamp(30px, 4vw, 43px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .section-heading p {
    max-width: 720px;
    margin: 14px auto 0;
    color: #64748b;
    font-size: 16px;
  }

  .section-link {
    color: #2563eb;
    font-size: 14px;
    font-weight: 750;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .featured-card {
    position: relative;
    overflow: hidden;
    min-height: 350px;
    padding: 27px;
    border: 1px solid #e3e8f1;
    border-radius: 19px;
    background: white;
    box-shadow: 0 12px 35px rgba(24, 39, 75, 0.06);
