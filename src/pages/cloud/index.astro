---
import Header from "../../components/Header.astro";
import BrandHero from "../../components/BrandHero.astro";
import StatBand from "../../components/StatBand.astro";
import GuideBand from "../../components/GuideBand.astro";

const cloudTools = [
  {
    icon: "☁️",
    title: "Cloud-init Generator",
    description:
      "Generate cloud-init YAML configurations for Ubuntu, RHEL, Debian and other Linux cloud virtual machines.",
    link: "/cloud/cloud-init-generator/",
    badge: "Cloud VM",
  },
  {
    icon: "🏗️",
    title: "Terraform Provider Generator",
    description:
      "Generate Terraform provider blocks for AWS, Azure, Google Cloud, OCI and Huawei Cloud.",
    link: "/cloud/terraform-provider-generator/",
    badge: "Terraform",
  },
  {
    icon: "📦",
    title: "Terraform Backend Generator",
    description:
      "Create remote backend configurations for Amazon S3, Azure Storage, Google Cloud Storage and Terraform Cloud.",
    link: "/cloud/terraform-backend-generator/",
    badge: "Terraform",
  },
  {
    icon: "📝",
    title: "Terraform Variables Generator",
    description:
      "Generate variables.tf and terraform.tfvars content for Terraform infrastructure projects.",
    link: "/cloud/terraform-variables-generator/",
    badge: "Terraform",
  },
  {
    icon: "🔐",
    title: "AWS IAM Policy Generator",
    description:
      "Create AWS IAM policy documents for users, groups, roles and supported AWS services.",
    link: "/cloud/aws-iam-policy-generator/",
    badge: "AWS",
  },
  {
    icon: "🛡️",
    title: "AWS Security Group Generator",
    description:
      "Generate inbound and outbound AWS Security Group rules for EC2 and cloud workloads.",
    link: "/cloud/aws-security-group-generator/",
    badge: "AWS",
  },
  {
    icon: "🌐",
    title: "Azure NSG Generator",
    description:
      "Create Azure Network Security Group rules with ports, protocols, priorities and source or destination settings.",
    link: "/cloud/azure-nsg-generator/",
    badge: "Azure",
  },
  {
    icon: "🔎",
    title: "AWS ARN Parser",
    description:
      "Parse and validate AWS Amazon Resource Names into partition, service, region, account and resource values.",
    link: "/cloud/aws-arn-parser/",
    badge: "AWS",
  },
  {
    icon: "📋",
    title: "Azure Resource ID Parser",
    description:
      "Parse Azure Resource IDs into subscription, resource group, provider, resource type and resource name.",
    link: "/cloud/azure-resource-id-parser/",
    badge: "Azure",
  },
];

const pageTitle = "Free Cloud Tools for AWS, Azure and Terraform | Gokuruvi";
const pageDescription =
  "Free cloud engineering tools for AWS, Microsoft Azure, Terraform and Linux cloud administrators. Generate cloud-init, IAM policies, security rules and Terraform configuration.";
const siteUrl = "https://www.gokuruvi.com/cloud/";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />
    <meta property="og:image" content="https://www.gokuruvi.com/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3566244632209805" crossorigin="anonymous"></script>
  </head>

  <body>
    <Header />

    <main>
      <BrandHero
        title="Free Cloud Tools for AWS, Azure and Terraform"
        line1="Master the"
        line2="Cloud."
        lead="Generate cloud-init configurations, Terraform providers, backends and variables, AWS IAM policies and security rules, and parse AWS ARNs and Azure resource IDs, all in your browser."
        breadcrumb={[{ label: "Home", href: "/" }, { label: "Cloud Tools" }]}
        actions={[
          { label: "Explore cloud tools", href: "#cloud-tools", primary: true },
          { label: "Cloud migration guide", href: "/guides/cloud-migration-guide/" },
        ]}
      />

      <StatBand
        title="Everything you need to build and secure cloud infrastructure"
        stats={[
          { value: cloudTools.length, label: "cloud tools for AWS, Azure, Terraform and cloud-init" },
          { value: 9, label: "step-by-step tool guides with real examples" },
          { value: 7, label: "part cloud migration guide" },
          { value: 0, label: "sign-ups or accounts needed" },
        ]}
      />

      <GuideBand
        label="Featured guide · 7 sections · 13 min read"
        title="Cloud Migration Guide"
        text="How to plan a move to AWS, Azure or Google Cloud: account structure, network design, choosing a strategy per workload, moving data and cutting over with a real rollback path."
        href="/guides/cloud-migration-guide/"
        secondary={{ label: "Open the Terraform provider generator", href: "/cloud/terraform-provider-generator/" }}
        items={[
          { label: "Start with account structure, not workloads", href: "/guides/cloud-migration-guide/#landing-zone" },
          { label: "Design the network before you migrate anything", href: "/guides/cloud-migration-guide/#network" },
          { label: "Choosing a migration strategy per workload", href: "/guides/cloud-migration-guide/#strategy" },
          { label: "Plan the cutover with a real rollback path", href: "/guides/cloud-migration-guide/#cutover" },
          { label: "Common pitfalls that turn into incidents", href: "/guides/cloud-migration-guide/#pitfalls" },
        ]}
      />

      <section class="section" id="cloud-tools">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">All Cloud Tools</span>
            <h2>Cloud generators, parsers and calculators</h2>
            <p>
              Select a utility for AWS, Azure, Terraform or Linux cloud
              administration.
            </p>
          </div>

          <div class="tools-grid">
            {
              cloudTools.map((tool) => (
                <a class="tool-card" href={tool.link}>
                  <div class="tool-header">
                    <div class="tool-icon" aria-hidden="true">{tool.icon}</div>
                    <span class="tool-badge">{tool.badge}</span>
                  </div>

                  <h3>{tool.title}</h3>
                  <p>{tool.description}</p>
                  <span class="open-tool">Open tool <span>→</span></span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Why Gokuruvi</span>
            <h2>Built for practical cloud engineering tasks</h2>
            <p>
              Create reusable cloud configurations faster and reduce repetitive
              manual work.
            </p>
          </div>

          <div class="benefits-grid">
            <article class="benefit-card">
              <div class="benefit-icon">⚡</div>
              <h3>Generate Faster</h3>
              <p>Create cloud and Terraform configurations without writing every line manually.</p>
            </article>

            <article class="benefit-card">
              <div class="benefit-icon">🧰</div>
              <h3>Practical Outputs</h3>
              <p>Copy generated YAML, JSON and Terraform blocks into your projects.</p>
            </article>

            <article class="benefit-card">
              <div class="benefit-icon">🔒</div>
              <h3>Privacy Friendly</h3>
              <p>Use browser-based tools without registration for common cloud tasks.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container">
          <div class="cta-box">
            <h2>Start building cloud configurations faster</h2>
            <p>
              Use free generators and parsers for AWS, Azure, Terraform and
              Linux cloud virtual machines.
            </p>

            <a class="button cta-button" href="/cloud/cloud-init-generator/">
              Open Cloud-init Generator <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #172033;
    font-family: Inter, Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }
  :global(a) { color: inherit; }

  .container {
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition: .2s ease;
  }

  .button:hover { transform: translateY(-2px); }
  .section { padding: 92px 0; }
  .section-white { background: white; }

  .section-heading {
    max-width: 770px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(31px, 4vw, 44px);
    line-height: 1.2;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 18px;
    line-height: 1.75;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 24px;
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 19px;
    background: white;
    text-decoration: none;
    box-shadow: 0 12px 35px rgba(15,23,42,.06);
    transition: .25s ease;
  }

  .tool-card { min-height: 310px; }

  .tool-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 24px 50px rgba(37,99,235,.14);
    transform: translateY(-8px);
  }

  .tool-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 15px;
    background: linear-gradient(135deg, #eff6ff, #e0f2fe);
    font-size: 29px;
  }

  .tool-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }

  .tool-badge {
    padding: 5px 10px;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .tool-card h3 {
    margin: 16px 0 11px;
    color: #0f172a;
    font-size: 21px;
    line-height: 1.3;
  }

  .tool-card p {
    flex: 1;
    margin: 0 0 22px;
    color: #64748b;
    line-height: 1.72;
  }

  .open-tool {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #2563eb;
    font-size: 15px;
    font-weight: 850;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 24px;
  }

  .benefit-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: white;
  }

  .benefit-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 14px;
    background: #eff6ff;
    font-size: 25px;
  }

  .benefit-card h3 {
    margin: 0 0 9px;
    color: #0f172a;
    font-size: 20px;
  }

  .benefit-card p {
    margin: 0;
    color: #64748b;
  }

  .cta { padding: 0 0 92px; }
  .cta-box {
    padding: 70px 35px;
    border-radius: 25px;
    background:
      radial-gradient(circle at 10% 20%, rgba(56,189,248,.28), transparent 31%),
      linear-gradient(135deg, #0f172a, #1e3a8a);
    color: white;
    text-align: center;
    box-shadow: 0 25px 65px rgba(15,23,42,.2);
  }

  .cta-box h2 {
    max-width: 720px;
    margin: 0 auto 15px;
    font-size: clamp(30px, 4vw, 45px);
  }

  .cta-box p {
    max-width: 670px;
    margin: 0 auto 29px;
    color: #cbd5e1;
    font-size: 18px;
  }

  .cta-button {
    background: white;
    color: #1d4ed8;
  }

  footer {
    background: #0f172a;
    color: #cbd5e1;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3,1fr);
    gap: 55px;
    padding: 65px 0 45px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: white;
    font-size: 21px;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-logo-icon {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 11px;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
  }

  .footer-brand p {
    max-width: 380px;
    margin: 17px 0 0;
    color: #94a3b8;
  }

  .footer-title {
    margin: 0 0 18px;
    color: white;
    font-size: 16px;
  }

  .footer-links {
    display: grid;
    gap: 12px;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 24px 0;
    border-top: 1px solid #334155;
    color: #94a3b8;
    font-size: 14px;
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .footer-bottom-links a {
    color: #94a3b8;
    text-decoration: none;
  }

  @media (max-width: 1050px) {
    .tools-grid,
    .benefits-grid {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }
  }

  @media (max-width: 760px) {
    .section { padding: 72px 0; }
    .footer-bottom { flex-direction: column; }
  }

  @media (max-width: 560px) {
    .container { width: min(100% - 28px, 1180px); }
    .button { width: 100%; }

    .tools-grid,
    .benefits-grid,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .tool-card {
      min-height: auto;
      padding: 25px;
    }

    .cta-box { padding: 52px 23px; }
  }
</style>
