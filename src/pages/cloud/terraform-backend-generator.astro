      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var fields = {
          backendType: document.getElementById("backendTypeSelect"),
          terraformVersion: document.getElementById(
            "terraformVersionInput"
          ),
          includeVersion: document.getElementById("includeVersionInput"),
          includeComments: document.getElementById("includeCommentsInput"),

          s3Bucket: document.getElementById("s3BucketInput"),
          s3Key: document.getElementById("s3KeyInput"),
          s3Region: document.getElementById("s3RegionInput"),
          s3Profile: document.getElementById("s3ProfileInput"),
          s3Dynamo: document.getElementById("s3DynamoInput"),
          s3Kms: document.getElementById("s3KmsInput"),
          s3Encrypt: document.getElementById("s3EncryptInput"),
          s3UseLockfile: document.getElementById("s3UseLockfileInput"),

          azureResourceGroup: document.getElementById(
            "azureResourceGroupInput"
          ),
          azureStorageAccount: document.getElementById(
            "azureStorageAccountInput"
          ),
          azureContainer: document.getElementById("azureContainerInput"),
          azureKey: document.getElementById("azureKeyInput"),
          azureSubscription: document.getElementById(
            "azureSubscriptionInput"
          ),
          azureTenant: document.getElementById("azureTenantInput"),
          azureUseOidc: document.getElementById("azureUseOidcInput"),

          gcsBucket: document.getElementById("gcsBucketInput"),
          gcsPrefix: document.getElementById("gcsPrefixInput"),
          gcsProject: document.getElementById("gcsProjectInput"),
          gcsImpersonate: document.getElementById("gcsImpersonateInput"),

          consulAddress: document.getElementById("consulAddressInput"),
          consulPath: document.getElementById("consulPathInput"),
          consulScheme: document.getElementById("consulSchemeSelect"),
          consulDatacenter: document.getElementById(
            "consulDatacenterInput"
          ),
          consulLock: document.getElementById("consulLockInput"),

          kubernetesNamespace: document.getElementById(
            "kubernetesNamespaceInput"
          ),
          kubernetesSecretSuffix: document.getElementById(
            "kubernetesSecretSuffixInput"
          ),
          kubernetesConfigPath: document.getElementById(
            "kubernetesConfigPathInput"
          ),
          kubernetesContext: document.getElementById(
            "kubernetesContextInput"
          ),
          kubernetesInCluster: document.getElementById(
            "kubernetesInClusterInput"
          ),

          httpAddress: document.getElementById("httpAddressInput"),
          httpLockAddress: document.getElementById("httpLockAddressInput"),
          httpUnlockAddress: document.getElementById(
            "httpUnlockAddressInput"
          ),
          httpUsername: document.getElementById("httpUsernameInput"),
          httpMethod: document.getElementById("httpMethodSelect"),

          remoteHostname: document.getElementById("remoteHostnameInput"),
          remoteOrganization: document.getElementById(
            "remoteOrganizationInput"
          ),
          remoteWorkspace: document.getElementById("remoteWorkspaceInput"),
          remoteWorkspacePrefix: document.getElementById(
            "remoteWorkspacePrefixInput"
          ),

          localPath: document.getElementById("localPathInput"),
          localWorkspaceDir: document.getElementById(
            "localWorkspaceDirInput"
          ),

          customArguments: document.getElementById(
            "customArgumentsInput"
          )
        };

        var sections = {
          s3: document.getElementById("s3Section"),
          azurerm: document.getElementById("azurermSection"),
          gcs: document.getElementById("gcsSection"),
          consul: document.getElementById("consulSection"),
          kubernetes: document.getElementById("kubernetesSection"),
          http: document.getElementById("httpSection"),
          remote: document.getElementById("remoteSection"),
          local: document.getElementById("localSection")
        };

        var codeOutput = document.getElementById("codeOutput");
        var message = document.getElementById("message");
        var copyButton = document.getElementById("copyButton");
        var currentCode = "";

        function showMessage(text, type) {
          message.textContent = text;
          message.className = "message " + type;
        }

        function clearMessage() {
          message.textContent = "";
          message.className = "message";
        }

        function quoteHcl(value) {
          return (
            '"' +
            String(value)
              .replace(/\\/g, "\\\\")
              .replace(/"/g, '\\"')
              .replace(/\r/g, "\\r")
              .replace(/\n/g, "\\n") +
            '"'
          );
        }

        function addArgument(lines, name, value) {
          if (String(value).trim()) {
            lines.push(
              "    " + name.padEnd(22, " ") + " = " + quoteHcl(value)
            );
          }
        }

        function validateForm() {
          var type = fields.backendType.value;

          if (fields.includeVersion.checked && !fields.terraformVersion.value.trim()) {
            return "Required Terraform version cannot be empty.";
          }

          if (type === "s3") {
            if (!fields.s3Bucket.value.trim()) {
              return "S3 bucket name is required.";
            }

            if (!fields.s3Key.value.trim()) {
              return "S3 state key is required.";
            }

            if (!fields.s3Region.value.trim()) {
              return "S3 region is required.";
            }
          }

          if (type === "azurerm") {
            if (!fields.azureResourceGroup.value.trim()) {
              return "Azure resource group is required.";
            }

            if (!fields.azureStorageAccount.value.trim()) {
              return "Azure storage account is required.";
            }

            if (!fields.azureContainer.value.trim()) {
              return "Azure container name is required.";
            }

            if (!fields.azureKey.value.trim()) {
              return "Azure state key is required.";
            }
          }

          if (type === "gcs" && !fields.gcsBucket.value.trim()) {
            return "GCS bucket name is required.";
          }

          if (type === "consul") {
            if (!fields.consulAddress.value.trim()) {
              return "Consul address is required.";
            }

            if (!fields.consulPath.value.trim()) {
              return "Consul state path is required.";
            }
          }

          if (type === "kubernetes") {
            if (!fields.kubernetesNamespace.value.trim()) {
              return "Kubernetes namespace is required.";
            }

            if (!fields.kubernetesSecretSuffix.value.trim()) {
              return "Kubernetes secret suffix is required.";
            }
          }

          if (
            type === "http" &&
            !/^https?:\/\//i.test(fields.httpAddress.value.trim())
          ) {
            return "HTTP backend address must start with http:// or https://.";
          }

          if (type === "remote") {
            if (!fields.remoteOrganization.value.trim()) {
              return "Terraform Cloud organization is required.";
            }

            if (
              !fields.remoteWorkspace.value.trim() &&
              !fields.remoteWorkspacePrefix.value.trim()
            ) {
              return "Enter a workspace name or workspace prefix.";
            }

            if (
              fields.remoteWorkspace.value.trim() &&
              fields.remoteWorkspacePrefix.value.trim()
            ) {
              return "Use either workspace name or workspace prefix, not both.";
            }
          }

          if (type === "local" && !fields.localPath.value.trim()) {
            return "Local state path is required.";
          }

          return "";
        }

        function addCustomArguments(lines) {
          if (!fields.customArguments.value.trim()) {
            return;
          }

          fields.customArguments.value
            .split(/\r?\n/)
            .forEach(function (line) {
              lines.push("    " + line);
            });
        }

        function buildBackendArguments(lines, type) {
          if (type === "s3") {
            addArgument(lines, "bucket", fields.s3Bucket.value.trim());
            addArgument(lines, "key", fields.s3Key.value.trim());
            addArgument(lines, "region", fields.s3Region.value.trim());
            addArgument(lines, "profile", fields.s3Profile.value.trim());

            if (fields.s3Dynamo.value.trim()) {
              addArgument(
                lines,
                "dynamodb_table",
                fields.s3Dynamo.value.trim()
              );
            }

            lines.push(
              "    " +
                "encrypt".padEnd(22, " ") +
                " = " +
                (fields.s3Encrypt.checked ? "true" : "false")
            );

            if (fields.s3UseLockfile.checked) {
              lines.push(
                "    " + "use_lockfile".padEnd(22, " ") + " = true"
              );
            }

            addArgument(lines, "kms_key_id", fields.s3Kms.value.trim());
          } else if (type === "azurerm") {
            addArgument(
              lines,
              "resource_group_name",
              fields.azureResourceGroup.value.trim()
            );
            addArgument(
              lines,
              "storage_account_name",
              fields.azureStorageAccount.value.trim()
            );
            addArgument(
              lines,
              "container_name",
              fields.azureContainer.value.trim()
            );
            addArgument(lines, "key", fields.azureKey.value.trim());
            addArgument(
              lines,
              "subscription_id",
              fields.azureSubscription.value.trim()
            );
            addArgument(
              lines,
              "tenant_id",
              fields.azureTenant.value.trim()
            );

            if (fields.azureUseOidc.checked) {
              lines.push(
                "    " + "use_oidc".padEnd(22, " ") + " = true"
              );
              lines.push(
                "    " + "use_azuread_auth".padEnd(22, " ") + " = true"
              );
            }
          } else if (type === "gcs") {
            addArgument(lines, "bucket", fields.gcsBucket.value.trim());
            addArgument(lines, "prefix", fields.gcsPrefix.value.trim());
            addArgument(lines, "project", fields.gcsProject.value.trim());
            addArgument(
              lines,
              "impersonate_service_account",
              fields.gcsImpersonate.value.trim()
            );
          } else if (type === "consul") {
            addArgument(
              lines,
              "address",
              fields.consulAddress.value.trim()
            );
            addArgument(lines, "path", fields.consulPath.value.trim());
            addArgument(
              lines,
              "scheme",
              fields.consulScheme.value.trim()
            );
            addArgument(
              lines,
              "datacenter",
              fields.consulDatacenter.value.trim()
            );
            lines.push(
              "    " +
                "lock".padEnd(22, " ") +
                " = " +
                (fields.consulLock.checked ? "true" : "false")
            );
          } else if (type === "kubernetes") {
            addArgument(
              lines,
              "namespace",
              fields.kubernetesNamespace.value.trim()
            );
            addArgument(
              lines,
              "secret_suffix",
              fields.kubernetesSecretSuffix.value.trim()
            );

            if (fields.kubernetesInCluster.checked) {
              lines.push(
                "    " +
                  "in_cluster_config".padEnd(22, " ") +
                  " = true"
              );
            } else {
              addArgument(
                lines,
                "config_path",
                fields.kubernetesConfigPath.value.trim()
              );
              addArgument(
                lines,
                "config_context",
                fields.kubernetesContext.value.trim()
              );
            }
          } else if (type === "http") {
            addArgument(
              lines,
              "address",
              fields.httpAddress.value.trim()
            );
            addArgument(
              lines,
              "lock_address",
              fields.httpLockAddress.value.trim()
            );
            addArgument(
              lines,
              "unlock_address",
              fields.httpUnlockAddress.value.trim()
            );
            addArgument(
              lines,
              "username",
              fields.httpUsername.value.trim()
            );
            addArgument(
              lines,
              "update_method",
              fields.httpMethod.value.trim()
            );

            if (fields.httpLockAddress.value.trim()) {
              addArgument(lines, "lock_method", "LOCK");
            }

            if (fields.httpUnlockAddress.value.trim()) {
              addArgument(lines, "unlock_method", "UNLOCK");
            }
          } else if (type === "remote") {
            addArgument(
              lines,
              "hostname",
              fields.remoteHostname.value.trim()
            );
            addArgument(
              lines,
              "organization",
              fields.remoteOrganization.value.trim()
            );
            lines.push("    workspaces {");

            if (fields.remoteWorkspace.value.trim()) {
              lines.push(
                "      name = " +
                  quoteHcl(fields.remoteWorkspace.value.trim())
              );
            } else {
              lines.push(
                "      prefix = " +
                  quoteHcl(fields.remoteWorkspacePrefix.value.trim())
              );
            }

            lines.push("    }");
          } else if (type === "local") {
            addArgument(lines, "path", fields.localPath.value.trim());
            addArgument(
              lines,
              "workspace_dir",
              fields.localWorkspaceDir.value.trim()
            );
          }

          addCustomArguments(lines);
        }

        function getStatus(type) {
          var remote = type === "local" ? "Disabled" : "Enabled";
          var locking = "Depends on backend";
          var encryption = "Depends on backend";

          if (type === "s3") {
            locking =
              fields.s3Dynamo.value.trim() ||
              fields.s3UseLockfile.checked
                ? "Enabled"
                : "Disabled";
            encryption = fields.s3Encrypt.checked ? "Enabled" : "Disabled";
          } else if (type === "azurerm") {
            locking = "Enabled";
            encryption = "Enabled";
          } else if (type === "gcs") {
            locking = "Enabled";
            encryption = "Enabled";
          } else if (type === "consul") {
            locking = fields.consulLock.checked ? "Enabled" : "Disabled";
            encryption =
              fields.consulScheme.value === "https"
                ? "TLS transport"
                : "Not configured";
          } else if (type === "kubernetes") {
            locking = "Enabled";
            encryption = "Cluster dependent";
          } else if (type === "http") {
            locking = fields.httpLockAddress.value.trim()
              ? "Configured"
              : "Not configured";
            encryption = /^https:\/\//i.test(
              fields.httpAddress.value.trim()
            )
              ? "TLS transport"
              : "Not configured";
          } else if (type === "remote") {
            locking = "Enabled";
            encryption = "Enabled";
          } else if (type === "local") {
            locking = "Local process";
            encryption = "Disabled";
          }

          return {
            remote: remote,
            locking: locking,
            encryption: encryption
          };
        }

        function generateCode(showError) {
          var error = validateForm();
          var type = fields.backendType.value;
          var lines = [];
          var status;

          clearMessage();

          if (error) {
            currentCode = "";
            codeOutput.textContent = error;

            if (showError) {
              showMessage(error, "error");
            }

            return;
          }

          if (fields.includeComments.checked) {
            lines.push("# Terraform backend configuration");
            lines.push(
              "# Run terraform init -reconfigure after changing this block."
            );
          }

          lines.push("terraform {");

          if (fields.includeVersion.checked) {
            lines.push(
              "  required_version = " +
                quoteHcl(fields.terraformVersion.value.trim())
            );
            lines.push("");
          }

          lines.push('  backend "' + type + '" {');
          buildBackendArguments(lines, type);
          lines.push("  }");
          lines.push("}");

          currentCode = lines.join("\n") + "\n";
          codeOutput.textContent = currentCode;

          status = getStatus(type);

          document.getElementById("resultBackend").textContent = type;
          document.getElementById("resultRemote").textContent =
            status.remote;
          document.getElementById("resultLocking").textContent =
            status.locking;
          document.getElementById("resultEncryption").textContent =
            status.encryption;
        }

        function updateSections() {
          var selected = fields.backendType.value;

          Object.keys(sections).forEach(function (key) {
            sections[key].classList.toggle("active", key === selected);
          });

          generateCode(false);
        }

        function applyPreset(type) {
          fields.backendType.value = type;

          if (type === "s3") {
            fields.s3Bucket.value = "my-terraform-state";
            fields.s3Key.value = "production/terraform.tfstate";
            fields.s3Region.value = "me-central-1";
            fields.s3Dynamo.value = "terraform-locks";
            fields.s3Encrypt.checked = true;
          } else if (type === "azurerm") {
            fields.azureResourceGroup.value = "rg-terraform-state";
            fields.azureStorageAccount.value = "tfstateaccount";
            fields.azureContainer.value = "tfstate";
            fields.azureKey.value = "production.terraform.tfstate";
          } else if (type === "gcs") {
            fields.gcsBucket.value = "my-terraform-state";
            fields.gcsPrefix.value = "production";
          } else if (type === "kubernetes") {
            fields.kubernetesNamespace.value = "terraform-state";
            fields.kubernetesSecretSuffix.value = "production";
          } else if (type === "remote") {
            fields.remoteHostname.value = "app.terraform.io";
            fields.remoteOrganization.value = "my-organization";
            fields.remoteWorkspace.value = "production";
            fields.remoteWorkspacePrefix.value = "";
          } else if (type === "local") {
            fields.localPath.value = "terraform.tfstate";
            fields.localWorkspaceDir.value = "terraform.tfstate.d";
          }

          updateSections();
        }

        function resetGenerator() {
          fields.backendType.value = "s3";
          fields.terraformVersion.value = ">= 1.6.0";
          fields.includeVersion.checked = true;
          fields.includeComments.checked = true;

          fields.s3Bucket.value = "my-terraform-state";
          fields.s3Key.value = "production/terraform.tfstate";
          fields.s3Region.value = "me-central-1";
          fields.s3Profile.value = "";
          fields.s3Dynamo.value = "terraform-locks";
          fields.s3Kms.value = "";
          fields.s3Encrypt.checked = true;
          fields.s3UseLockfile.checked = false;

          fields.azureResourceGroup.value = "rg-terraform-state";
          fields.azureStorageAccount.value = "tfstateaccount";
          fields.azureContainer.value = "tfstate";
          fields.azureKey.value = "production.terraform.tfstate";
          fields.azureSubscription.value = "";
          fields.azureTenant.value = "";
          fields.azureUseOidc.checked = false;

          fields.gcsBucket.value = "my-terraform-state";
          fields.gcsPrefix.value = "production";
          fields.gcsProject.value = "";
          fields.gcsImpersonate.value = "";

          fields.consulAddress.value = "consul.example.com:8500";
          fields.consulPath.value = "terraform/production";
          fields.consulScheme.value = "https";
          fields.consulDatacenter.value = "";
          fields.consulLock.checked = true;

          fields.kubernetesNamespace.value = "terraform-state";
          fields.kubernetesSecretSuffix.value = "production";
          fields.kubernetesConfigPath.value = "~/.kube/config";
          fields.kubernetesContext.value = "";
          fields.kubernetesInCluster.checked = false;

          fields.httpAddress.value =
            "https://state.example.com/terraform";
          fields.httpLockAddress.value = "";
          fields.httpUnlockAddress.value = "";
          fields.httpUsername.value = "";
          fields.httpMethod.value = "POST";

          fields.remoteHostname.value = "app.terraform.io";
          fields.remoteOrganization.value = "my-organization";
          fields.remoteWorkspace.value = "production";
          fields.remoteWorkspacePrefix.value = "";

          fields.localPath.value = "terraform.tfstate";
          fields.localWorkspaceDir.value = "terraform.tfstate.d";

          fields.customArguments.value = "";

          updateSections();
          fields.backendType.focus();
        }

        function copyCode() {
          if (!currentCode) {
            showMessage("Generate valid Terraform code first.", "error");
            return;
          }

          navigator.clipboard
            .writeText(currentCode)
            .then(function () {
              var originalText = copyButton.textContent;
              copyButton.textContent = "Copied!";
              showMessage("Terraform backend copied successfully.", "success");

              window.setTimeout(function () {
                copyButton.textContent = originalText;
              }, 1500);
            })
            .catch(function () {
              showMessage(
                "Clipboard access failed. Copy the code manually.",
                "error"
              );
            });
        }

        function downloadCode() {
          var blob;
          var url;
          var anchor;

          if (!currentCode) {
            showMessage("Generate valid Terraform code first.", "error");
            return;
          }

          blob = new Blob([currentCode], {
            type: "text/plain;charset=utf-8"
          });

          url = URL.createObjectURL(blob);
          anchor = document.createElement("a");
          anchor.href = url;
          anchor.download = "backend.tf";

          document.body.appendChild(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);

          showMessage("backend.tf downloaded successfully.", "success");
        }

        document
          .getElementById("generateButton")
          .addEventListener("click", function () {
            generateCode(true);
          });

        document
          .getElementById("resetButton")
          .addEventListener("click", resetGenerator);

        copyButton.addEventListener("click", copyCode);

        document
          .getElementById("downloadButton")
          .addEventListener("click", downloadCode);

        fields.backendType.addEventListener("change", updateSections);

        Object.keys(fields).forEach(function (key) {
          var field = fields[key];

          field.addEventListener("input", function () {
            generateCode(false);
          });

          if (key !== "backendType") {
            field.addEventListener("change", function () {
              generateCode(false);
            });
          }
        });

        document.querySelectorAll(".preset").forEach(function (button) {
          button.addEventListener("click", function () {
            applyPreset(button.getAttribute("data-backend") || "s3");
          });
        });

        updateSections();
      });
    </script>
  </body>
</html>
