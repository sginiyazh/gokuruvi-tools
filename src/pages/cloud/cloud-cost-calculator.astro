---
const pageTitle = "Cloud Cost Calculator | Gokuruvi Tools";
const description =
  "Estimate monthly cloud infrastructure costs for compute, storage, databases, data transfer, load balancers, public IPs, backups, and support using editable rates.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/cloud/cloud-cost-calculator"
    />

    <title>{pageTitle}</title>

    <style>
      :root {
        --primary: #0891b2;
        --primary-dark: #0e7490;
        --dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #166534;
        --error-bg: #fef2f2;
        --error-border: #fecaca;
        --error-text: #b91c1c;
        --warning-bg: #fffbeb;
        --warning-border: #fde68a;
        --warning-text: #92400e;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }

      button,
      input,
      select {
        font: inherit;
      }

      .site-header {
        background: var(--dark);
      }

      .header-inner {
        display: flex;
        width: min(100% - 40px, 1240px);
        min-height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        color: #ffffff;
        font-size: 22px;
        font-weight: 800;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .navigation a {
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .navigation a:hover,
      .navigation a.active {
        color: #ffffff;
      }

      .hero {
        padding: 56px 20px;
        background: linear-gradient(135deg, #ecfeff, #f8fafc);
        text-align: center;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(34px, 6vw, 54px);
      }

      .hero p {
        max-width: 920px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 18px;
      }

      .page-section {
        padding: 48px 20px 80px;
      }

      .tool-layout {
        display: grid;
        width: min(100%, 1240px);
        margin: 0 auto;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 28px;
        align-items: start;
      }

      .card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.07);
      }

      .card h2 {
        margin: 0 0 8px;
        color: var(--dark);
      }

      .card-description {
        margin: 0 0 22px;
        color: var(--muted);
      }

      .section-title {
        margin: 28px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--dark);
        font-size: 18px;
      }

      .input-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .input-row.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .form-group {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin-bottom: 7px;
        color: var(--dark);
        font-weight: 700;
      }

      input,
      select {
        width: 100%;
        min-height: 48px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        outline: none;
      }

      input:focus,
      select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.13);
      }

      .helper {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .preset-buttons,
      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .preset {
        padding: 8px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        background: #ffffff;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
      }

      .preset:hover {
        border-color: var(--primary);
        background: #ecfeff;
        color: var(--primary-dark);
      }

      .button-row {
        margin-top: 24px;
      }

      .button {
        min-height: 44px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 800;
      }

      .primary-button {
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .message {
        display: none;
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 9px;
        font-weight: 700;
      }

      .message.error {
        display: block;
        border: 1px solid var(--error-border);
        background: var(--error-bg);
        color: var(--error-text);
      }

      .message.success {
        display: block;
        border: 1px solid var(--success-border);
        background: var(--success-bg);
        color: var(--success-text);
      }

      .summary-total {
        padding: 26px;
        border-radius: 14px;
        background: linear-gradient(135deg, #0f172a, #164e63);
        color: #ffffff;
      }

      .summary-total span {
        display: block;
      }

      .summary-label {
        color: #a5f3fc;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .summary-amount {
        margin-top: 8px;
        font-size: clamp(36px, 6vw, 54px);
        font-weight: 900;
      }

      .summary-subtext {
        margin-top: 8px;
        color: #cbd5e1;
      }

      .cost-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      .cost-table th,
      .cost-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: right;
      }

      .cost-table th:first-child,
      .cost-table td:first-child {
        text-align: left;
      }

      .cost-table th {
        background: #f1f5f9;
        color: var(--dark);
      }

      .cost-table tfoot td {
        background: #ecfeff;
        color: var(--dark);
        font-weight: 900;
      }

      .chart {
        display: grid;
        gap: 12px;
        margin-top: 24px;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr) 95px;
        gap: 10px;
        align-items: center;
      }

      .bar-label,
      .bar-value {
        font-size: 13px;
        font-weight: 800;
      }

      .bar-value {
        text-align: right;
      }

      .bar-track {
        height: 14px;
        overflow: hidden;
        border-radius: 999px;
        background: #e2e8f0;
      }

      .bar-fill {
        height: 100%;
        width: 0;
        border-radius: 999px;
        background: var(--primary);
        transition: width 0.25s ease;
      }

      .warning {
        margin-top: 20px;
        padding: 14px 16px;
        border: 1px solid var(--warning-border);
        border-radius: 10px;
        background: var(--warning-bg);
        color: var(--warning-text);
        font-size: 14px;
      }

      .reference-section {
        width: min(100%, 1240px);
        margin: 30px auto 0;
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
      }

      .reference-section h2 {
        margin-top: 0;
        color: var(--dark);
      }

      .reference-table {
        width: 100%;
        border-collapse: collapse;
      }

      .reference-table th,
      .reference-table td {
        padding: 12px;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      .reference-table th {
        background: #f1f5f9;
      }

      footer {
        padding: 26px 20px;
        background: var(--dark);
        color: #94a3b8;
        text-align: center;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: none;
      }

      @media (max-width: 980px) {
        .tool-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 700px) {
        .header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .input-row,
        .input-row.three {
          grid-template-columns: 1fr;
        }

        .bar-row {
          grid-template-columns: 100px minmax(0, 1fr) 80px;
        }

        .card,
        .reference-section {
          padding: 21px;
        }

        .button-row {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .cost-table,
        .reference-table {
          display: block;
          overflow-x: auto;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">Gokuruvi Tools</a>

        <nav class="navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a href="/network">Network</a>
          <a class="active" href="/cloud">Cloud</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>Cloud Cost Calculator</h1>
        <p>
          Estimate monthly cloud infrastructure costs for compute, storage,
          databases, network traffic, load balancers, public IPs, backups, and
          support using rates you can edit.
        </p>
      </section>

      <section class="page-section">
        <div class="tool-layout">
          <section class="card">
            <h2>Cost Inputs</h2>
            <p class="card-description">
              Enter your expected usage and provider rates. The calculator does
              not contact any cloud pricing API.
            </p>

            <div class="preset-buttons">
              <button class="preset" type="button" data-preset="small">
                Small Website
              </button>
              <button class="preset" type="button" data-preset="medium">
                Business App
              </button>
              <button class="preset" type="button" data-preset="ha">
                HA Production
              </button>
              <button class="preset" type="button" data-preset="dev">
                Dev/Test
              </button>
            </div>

            <h3 class="section-title">General</h3>

            <div class="input-row">
              <div class="form-group">
                <label for="providerSelect">Cloud provider</label>
                <select id="providerSelect">
                  <option value="AWS">AWS</option>
                  <option value="Azure">Microsoft Azure</option>
                  <option value="GCP">Google Cloud</option>
                  <option value="Huawei Cloud">Huawei Cloud</option>
                  <option value="Oracle Cloud">Oracle Cloud</option>
                  <option value="Custom" selected>Custom rates</option>
                </select>
              </div>

              <div class="form-group">
                <label for="currencySelect">Currency</label>
                <select id="currencySelect">
                  <option value="USD" selected>USD</option>
                  <option value="AED">AED</option>
                  <option value="EUR">EUR</option>
                  <option value="GBP">GBP</option>
                  <option value="INR">INR</option>
                </select>
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="hoursInput">Hours per month</label>
                <input
                  id="hoursInput"
                  type="number"
                  min="0"
                  step="1"
                  value="730"
                />
                <p class="helper">730 hours is a common monthly estimate.</p>
              </div>

              <div class="form-group">
                <label for="discountInput">Discount percentage</label>
                <input
                  id="discountInput"
                  type="number"
                  min="0"
                  max="100"
                  step="0.01"
                  value="0"
                />
              </div>
            </div>

            <h3 class="section-title">Compute</h3>

            <div class="input-row three">
              <div class="form-group">
                <label for="instanceCountInput">Instances</label>
                <input id="instanceCountInput" type="number" min="0" value="2" />
              </div>

              <div class="form-group">
                <label for="instanceRateInput">Rate per instance/hour</label>
                <input
                  id="instanceRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.08"
                />
              </div>

              <div class="form-group">
                <label for="utilizationInput">Usage percentage</label>
                <input
                  id="utilizationInput"
                  type="number"
                  min="0"
                  max="100"
                  step="0.01"
                  value="100"
                />
              </div>
            </div>

            <h3 class="section-title">Block and Object Storage</h3>

            <div class="input-row">
              <div class="form-group">
                <label for="blockStorageInput">Block storage GB</label>
                <input
                  id="blockStorageInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="200"
                />
              </div>

              <div class="form-group">
                <label for="blockRateInput">Block storage rate/GB-month</label>
                <input
                  id="blockRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.08"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="objectStorageInput">Object storage GB</label>
                <input
                  id="objectStorageInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="100"
                />
              </div>

              <div class="form-group">
                <label for="objectRateInput">Object storage rate/GB-month</label>
                <input
                  id="objectRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.023"
                />
              </div>
            </div>

            <h3 class="section-title">Managed Database</h3>

            <div class="input-row three">
              <div class="form-group">
                <label for="databaseCountInput">Database instances</label>
                <input
                  id="databaseCountInput"
                  type="number"
                  min="0"
                  value="1"
                />
              </div>

              <div class="form-group">
                <label for="databaseRateInput">Rate per DB/hour</label>
                <input
                  id="databaseRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.12"
                />
              </div>

              <div class="form-group">
                <label for="databaseStorageInput">Database storage GB</label>
                <input
                  id="databaseStorageInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="100"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="databaseStorageRateInput">
                Database storage rate/GB-month
              </label>
              <input
                id="databaseStorageRateInput"
                type="number"
                min="0"
                step="0.0001"
                value="0.12"
              />
            </div>

            <h3 class="section-title">Networking</h3>

            <div class="input-row">
              <div class="form-group">
                <label for="transferInput">Outbound data transfer GB</label>
                <input
                  id="transferInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="250"
                />
              </div>

              <div class="form-group">
                <label for="transferRateInput">Transfer rate/GB</label>
                <input
                  id="transferRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.09"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="loadBalancerCountInput">Load balancers</label>
                <input
                  id="loadBalancerCountInput"
                  type="number"
                  min="0"
                  value="1"
                />
              </div>

              <div class="form-group">
                <label for="loadBalancerRateInput">Rate per LB/hour</label>
                <input
                  id="loadBalancerRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.025"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="publicIpCountInput">Public IP addresses</label>
                <input
                  id="publicIpCountInput"
                  type="number"
                  min="0"
                  value="1"
                />
              </div>

              <div class="form-group">
                <label for="publicIpRateInput">Rate per IP/hour</label>
                <input
                  id="publicIpRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.005"
                />
              </div>
            </div>

            <h3 class="section-title">Backup, Monitoring, and Support</h3>

            <div class="input-row">
              <div class="form-group">
                <label for="backupStorageInput">Backup storage GB</label>
                <input
                  id="backupStorageInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="300"
                />
              </div>

              <div class="form-group">
                <label for="backupRateInput">Backup rate/GB-month</label>
                <input
                  id="backupRateInput"
                  type="number"
                  min="0"
                  step="0.0001"
                  value="0.05"
                />
              </div>
            </div>

            <div class="input-row">
              <div class="form-group">
                <label for="monitoringInput">Monitoring/logging monthly cost</label>
                <input
                  id="monitoringInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="20"
                />
              </div>

              <div class="form-group">
                <label for="supportInput">Support monthly cost</label>
                <input
                  id="supportInput"
                  type="number"
                  min="0"
                  step="0.01"
                  value="0"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="otherInput">Other monthly services</label>
              <input
                id="otherInput"
                type="number"
                min="0"
                step="0.01"
                value="0"
              />
            </div>

            <div class="button-row">
              <button
                id="calculateButton"
                class="button primary-button"
                type="button"
              >
                Calculate Cost
              </button>

              <button
                id="resetButton"
                class="button secondary-button"
                type="button"
              >
                Reset
              </button>

              <button
                id="downloadButton"
                class="button secondary-button"
                type="button"
              >
                Download CSV
              </button>
            </div>

            <div
              id="message"
              class="message"
              role="alert"
              aria-live="polite"
            ></div>
          </section>

          <section class="card">
            <h2>Monthly Estimate</h2>
            <p class="card-description">
              Cost summary based on your entered quantities and rates.
            </p>

            <div class="summary-total">
              <span class="summary-label">Estimated monthly total</span>
              <span id="monthlyTotal" class="summary-amount">$0.00</span>
              <span id="annualTotal" class="summary-subtext">
                Estimated annual total: $0.00
              </span>
            </div>

            <table class="cost-table">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Monthly cost</th>
                  <th>Share</th>
                </tr>
              </thead>
              <tbody id="costTableBody"></tbody>
              <tfoot>
                <tr>
                  <td>Total before discount</td>
                  <td id="subtotalCell">$0.00</td>
                  <td>100%</td>
                </tr>
                <tr>
                  <td>Discount</td>
                  <td id="discountCell">-$0.00</td>
                  <td id="discountPercentCell">0%</td>
                </tr>
                <tr>
                  <td>Final monthly total</td>
                  <td id="finalCell">$0.00</td>
                  <td>—</td>
                </tr>
              </tfoot>
            </table>

            <div id="costChart" class="chart"></div>

            <div class="warning">
              This is an estimate only. Actual cloud bills can include taxes,
              request charges, IOPS, snapshots, NAT gateways, licenses,
              reserved-capacity terms, regional pricing, minimum charges, and
              provider-specific billing rules.
            </div>
          </section>
        </div>

        <section class="reference-section">
          <h2>Calculation Formula</h2>

          <table class="reference-table">
            <tbody>
              <tr>
                <th>Compute</th>
                <td>
                  Instances × hourly rate × monthly hours × utilization %
                </td>
              </tr>
              <tr>
                <th>Storage</th>
                <td>Allocated GB × rate per GB-month</td>
              </tr>
              <tr>
                <th>Database</th>
                <td>
                  DB instances × hourly rate × hours + DB storage × storage rate
                </td>
              </tr>
              <tr>
                <th>Data transfer</th>
                <td>Outbound GB × transfer rate per GB</td>
              </tr>
              <tr>
                <th>Load balancer and public IP</th>
                <td>Quantity × hourly rate × monthly hours</td>
              </tr>
              <tr>
                <th>Annual estimate</th>
                <td>Final monthly estimate × 12</td>
              </tr>
            </tbody>
          </table>
        </section>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
      · <a href="/privacy-policy">Privacy</a>
      · <a href="/terms">Terms</a>
      · <a href="/contact">Contact</a>
    </footer>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var fields = {
          provider: document.getElementById("providerSelect"),
          currency: document.getElementById("currencySelect"),
          hours: document.getElementById("hoursInput"),
          discount: document.getElementById("discountInput"),
          instanceCount: document.getElementById("instanceCountInput"),
          instanceRate: document.getElementById("instanceRateInput"),
          utilization: document.getElementById("utilizationInput"),
          blockStorage: document.getElementById("blockStorageInput"),
          blockRate: document.getElementById("blockRateInput"),
          objectStorage: document.getElementById("objectStorageInput"),
          objectRate: document.getElementById("objectRateInput"),
          databaseCount: document.getElementById("databaseCountInput"),
          databaseRate: document.getElementById("databaseRateInput"),
          databaseStorage: document.getElementById("databaseStorageInput"),
          databaseStorageRate: document.getElementById(
            "databaseStorageRateInput"
          ),
          transfer: document.getElementById("transferInput"),
          transferRate: document.getElementById("transferRateInput"),
          loadBalancerCount: document.getElementById(
            "loadBalancerCountInput"
          ),
          loadBalancerRate: document.getElementById(
            "loadBalancerRateInput"
          ),
          publicIpCount: document.getElementById("publicIpCountInput"),
          publicIpRate: document.getElementById("publicIpRateInput"),
          backupStorage: document.getElementById("backupStorageInput"),
          backupRate: document.getElementById("backupRateInput"),
          monitoring: document.getElementById("monitoringInput"),
          support: document.getElementById("supportInput"),
          other: document.getElementById("otherInput")
        };

        var message = document.getElementById("message");
        var latestResult = null;

        var currencySymbols = {
          USD: "$",
          AED: "AED ",
          EUR: "€",
          GBP: "£",
          INR: "₹"
        };

        function numberValue(field) {
          return Number(field.value);
        }

        function showMessage(text, type) {
          message.textContent = text;
          message.className = "message " + type;
        }

        function clearMessage() {
          message.textContent = "";
          message.className = "message";
        }

        function formatMoney(value) {
          var currency = fields.currency.value;
          var symbol = currencySymbols[currency] || currency + " ";

          return (
            symbol +
            Number(value).toLocaleString(undefined, {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            })
          );
        }

        function validateInputs() {
          var invalid = Object.keys(fields).find(function (key) {
            var field = fields[key];

            if (field.tagName === "SELECT") {
              return false;
            }

            return (
              field.value.trim() === "" ||
              !Number.isFinite(Number(field.value)) ||
              Number(field.value) < 0
            );
          });

          if (invalid) {
            return "All numeric fields must contain zero or a positive number.";
          }

          if (numberValue(fields.discount) > 100) {
            return "Discount percentage cannot exceed 100.";
          }

          if (numberValue(fields.utilization) > 100) {
            return "Compute utilization cannot exceed 100%.";
          }

          return "";
        }

        function calculateCosts(showSuccess) {
          var error = validateInputs();
          var hours;
          var utilization;
          var items;
          var subtotal;
          var discountAmount;
          var finalTotal;

          clearMessage();

          if (error) {
            showMessage(error, "error");
            return;
          }

          hours = numberValue(fields.hours);
          utilization = numberValue(fields.utilization) / 100;

          items = [
            {
              name: "Compute",
              cost:
                numberValue(fields.instanceCount) *
                numberValue(fields.instanceRate) *
                hours *
                utilization
            },
            {
              name: "Block storage",
              cost:
                numberValue(fields.blockStorage) *
                numberValue(fields.blockRate)
            },
            {
              name: "Object storage",
              cost:
                numberValue(fields.objectStorage) *
                numberValue(fields.objectRate)
            },
            {
              name: "Managed database",
              cost:
                numberValue(fields.databaseCount) *
                  numberValue(fields.databaseRate) *
                  hours +
                numberValue(fields.databaseStorage) *
                  numberValue(fields.databaseStorageRate)
            },
            {
              name: "Data transfer",
              cost:
                numberValue(fields.transfer) *
                numberValue(fields.transferRate)
            },
            {
              name: "Load balancers",
              cost:
                numberValue(fields.loadBalancerCount) *
                numberValue(fields.loadBalancerRate) *
                hours
            },
            {
              name: "Public IPs",
              cost:
                numberValue(fields.publicIpCount) *
                numberValue(fields.publicIpRate) *
                hours
            },
            {
              name: "Backup storage",
              cost:
                numberValue(fields.backupStorage) *
                numberValue(fields.backupRate)
            },
            {
              name: "Monitoring and logging",
              cost: numberValue(fields.monitoring)
            },
            {
              name: "Support",
              cost: numberValue(fields.support)
            },
            {
              name: "Other services",
              cost: numberValue(fields.other)
            }
          ];

          subtotal = items.reduce(function (sum, item) {
            return sum + item.cost;
          }, 0);

          discountAmount =
            subtotal * (numberValue(fields.discount) / 100);
          finalTotal = subtotal - discountAmount;

          latestResult = {
            provider: fields.provider.value,
            currency: fields.currency.value,
            items: items,
            subtotal: subtotal,
            discountPercentage: numberValue(fields.discount),
            discountAmount: discountAmount,
            monthlyTotal: finalTotal,
            annualTotal: finalTotal * 12
          };

          renderResult();

          if (showSuccess) {
            showMessage("Cloud cost estimate calculated.", "success");
          }
        }

        function renderResult() {
          var tableBody = document.getElementById("costTableBody");
          var chart = document.getElementById("costChart");
          var maxCost;

          if (!latestResult) {
            return;
          }

          document.getElementById("monthlyTotal").textContent =
            formatMoney(latestResult.monthlyTotal);

          document.getElementById("annualTotal").textContent =
            "Estimated annual total: " +
            formatMoney(latestResult.annualTotal);

          document.getElementById("subtotalCell").textContent =
            formatMoney(latestResult.subtotal);

          document.getElementById("discountCell").textContent =
            "-" + formatMoney(latestResult.discountAmount);

          document.getElementById("discountPercentCell").textContent =
            latestResult.discountPercentage.toFixed(2) + "%";

          document.getElementById("finalCell").textContent =
            formatMoney(latestResult.monthlyTotal);

          tableBody.innerHTML = "";

          latestResult.items.forEach(function (item) {
            var row = document.createElement("tr");
            var share =
              latestResult.subtotal > 0
                ? (item.cost / latestResult.subtotal) * 100
                : 0;

            row.innerHTML =
              "<td>" +
              item.name +
              "</td><td>" +
              formatMoney(item.cost) +
              "</td><td>" +
              share.toFixed(1) +
              "%</td>";

            tableBody.appendChild(row);
          });

          chart.innerHTML = "";

          maxCost = Math.max.apply(
            null,
            latestResult.items.map(function (item) {
              return item.cost;
            }).concat([1])
          );

          latestResult.items
            .filter(function (item) {
              return item.cost > 0;
            })
            .forEach(function (item) {
              var row = document.createElement("div");
              var width = (item.cost / maxCost) * 100;

              row.className = "bar-row";
              row.innerHTML =
                '<span class="bar-label">' +
                item.name +
                '</span><div class="bar-track"><div class="bar-fill" style="width:' +
                width.toFixed(2) +
                '%"></div></div><span class="bar-value">' +
                formatMoney(item.cost) +
                "</span>";

              chart.appendChild(row);
            });
        }

        function applyPreset(preset) {
          fields.provider.value = "Custom";
          fields.currency.value = "USD";
          fields.hours.value = "730";
          fields.discount.value = "0";

          if (preset === "small") {
            fields.instanceCount.value = "1";
            fields.instanceRate.value = "0.04";
            fields.utilization.value = "100";
            fields.blockStorage.value = "50";
            fields.blockRate.value = "0.08";
            fields.objectStorage.value = "25";
            fields.objectRate.value = "0.023";
            fields.databaseCount.value = "0";
            fields.databaseRate.value = "0";
            fields.databaseStorage.value = "0";
            fields.databaseStorageRate.value = "0";
            fields.transfer.value = "100";
            fields.transferRate.value = "0.09";
            fields.loadBalancerCount.value = "0";
            fields.loadBalancerRate.value = "0";
            fields.publicIpCount.value = "1";
            fields.publicIpRate.value = "0.005";
            fields.backupStorage.value = "50";
            fields.backupRate.value = "0.05";
            fields.monitoring.value = "5";
            fields.support.value = "0";
            fields.other.value = "0";
          } else if (preset === "medium") {
            fields.instanceCount.value = "3";
            fields.instanceRate.value = "0.10";
            fields.utilization.value = "100";
            fields.blockStorage.value = "500";
            fields.blockRate.value = "0.08";
            fields.objectStorage.value = "500";
            fields.objectRate.value = "0.023";
            fields.databaseCount.value = "1";
            fields.databaseRate.value = "0.20";
            fields.databaseStorage.value = "250";
            fields.databaseStorageRate.value = "0.12";
            fields.transfer.value = "1000";
            fields.transferRate.value = "0.09";
            fields.loadBalancerCount.value = "1";
            fields.loadBalancerRate.value = "0.025";
            fields.publicIpCount.value = "2";
            fields.publicIpRate.value = "0.005";
            fields.backupStorage.value = "750";
            fields.backupRate.value = "0.05";
            fields.monitoring.value = "75";
            fields.support.value = "100";
            fields.other.value = "25";
          } else if (preset === "ha") {
            fields.instanceCount.value = "6";
            fields.instanceRate.value = "0.18";
            fields.utilization.value = "100";
            fields.blockStorage.value = "1500";
            fields.blockRate.value = "0.10";
            fields.objectStorage.value = "2000";
            fields.objectRate.value = "0.023";
            fields.databaseCount.value = "2";
            fields.databaseRate.value = "0.45";
            fields.databaseStorage.value = "1000";
            fields.databaseStorageRate.value = "0.15";
            fields.transfer.value = "5000";
            fields.transferRate.value = "0.08";
            fields.loadBalancerCount.value = "2";
            fields.loadBalancerRate.value = "0.03";
            fields.publicIpCount.value = "4";
            fields.publicIpRate.value = "0.005";
            fields.backupStorage.value = "3000";
            fields.backupRate.value = "0.05";
            fields.monitoring.value = "250";
            fields.support.value = "500";
            fields.other.value = "150";
          } else if (preset === "dev") {
            fields.instanceCount.value = "2";
            fields.instanceRate.value = "0.06";
            fields.utilization.value = "35";
            fields.blockStorage.value = "200";
            fields.blockRate.value = "0.08";
            fields.objectStorage.value = "50";
            fields.objectRate.value = "0.023";
            fields.databaseCount.value = "1";
            fields.databaseRate.value = "0.10";
            fields.databaseStorage.value = "50";
            fields.databaseStorageRate.value = "0.12";
            fields.transfer.value = "50";
            fields.transferRate.value = "0.09";
            fields.loadBalancerCount.value = "0";
            fields.loadBalancerRate.value = "0";
            fields.publicIpCount.value = "1";
            fields.publicIpRate.value = "0.005";
            fields.backupStorage.value = "100";
            fields.backupRate.value = "0.05";
            fields.monitoring.value = "10";
            fields.support.value = "0";
            fields.other.value = "0";
          }

          calculateCosts(false);
        }

        function resetCalculator() {
          fields.provider.value = "Custom";
          fields.currency.value = "USD";
          fields.hours.value = "730";
          fields.discount.value = "0";
          fields.instanceCount.value = "2";
          fields.instanceRate.value = "0.08";
          fields.utilization.value = "100";
          fields.blockStorage.value = "200";
          fields.blockRate.value = "0.08";
          fields.objectStorage.value = "100";
          fields.objectRate.value = "0.023";
          fields.databaseCount.value = "1";
          fields.databaseRate.value = "0.12";
          fields.databaseStorage.value = "100";
          fields.databaseStorageRate.value = "0.12";
          fields.transfer.value = "250";
          fields.transferRate.value = "0.09";
          fields.loadBalancerCount.value = "1";
          fields.loadBalancerRate.value = "0.025";
          fields.publicIpCount.value = "1";
          fields.publicIpRate.value = "0.005";
          fields.backupStorage.value = "300";
          fields.backupRate.value = "0.05";
          fields.monitoring.value = "20";
          fields.support.value = "0";
          fields.other.value = "0";

          calculateCosts(false);
          fields.provider.focus();
        }

        function downloadCsv() {
          var rows;
          var csv;
          var blob;
          var url;
          var anchor;

          if (!latestResult) {
            showMessage("Calculate the estimate before downloading.", "error");
            return;
          }

          rows = [
            ["Cloud Cost Estimate"],
            ["Provider", latestResult.provider],
            ["Currency", latestResult.currency],
            [],
            ["Service", "Monthly Cost"]
          ];

          latestResult.items.forEach(function (item) {
            rows.push([item.name, item.cost.toFixed(2)]);
          });

          rows.push([]);
          rows.push(["Subtotal", latestResult.subtotal.toFixed(2)]);
          rows.push([
            "Discount Percentage",
            latestResult.discountPercentage.toFixed(2)
          ]);
          rows.push([
            "Discount Amount",
            latestResult.discountAmount.toFixed(2)
          ]);
          rows.push([
            "Final Monthly Total",
            latestResult.monthlyTotal.toFixed(2)
          ]);
          rows.push([
            "Estimated Annual Total",
            latestResult.annualTotal.toFixed(2)
          ]);

          csv = rows
            .map(function (row) {
              return row
                .map(function (value) {
                  var text = String(value ?? "");
                  return '"' + text.replace(/"/g, '""') + '"';
                })
                .join(",");
            })
            .join("\n");

          blob = new Blob([csv], {
            type: "text/csv;charset=utf-8"
          });

          url = URL.createObjectURL(blob);
          anchor = document.createElement("a");
          anchor.href = url;
          anchor.download = "cloud-cost-estimate.csv";

          document.body.appendChild(anchor);
          anchor.click();
          anchor.remove();
          URL.revokeObjectURL(url);

          showMessage("Cloud cost estimate downloaded.", "success");
        }

        document
          .getElementById("calculateButton")
          .addEventListener("click", function () {
            calculateCosts(true);
          });

        document
          .getElementById("resetButton")
          .addEventListener("click", resetCalculator);

        document
          .getElementById("downloadButton")
          .addEventListener("click", downloadCsv);

        Object.keys(fields).forEach(function (key) {
          var field = fields[key];

          field.addEventListener("input", function () {
            calculateCosts(false);
          });

          field.addEventListener("change", function () {
            calculateCosts(false);
          });
        });

        document.querySelectorAll(".preset").forEach(function (button) {
          button.addEventListener("click", function () {
            applyPreset(button.getAttribute("data-preset") || "small");
          });
        });

        calculateCosts(false);
      });
    </script>
  </body>
</html>
