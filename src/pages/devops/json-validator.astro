---
const pageTitle = "JSON Validator and Formatter | Gokuruvi Tools";

const pageDescription =
  "Validate, format, minify and inspect JSON documents directly in your browser using the free Gokuruvi JSON Validator.";

const canonicalUrl =
  "https://www.gokuruvi.com/devops/json-validator";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={pageDescription}
    />

    <meta
      name="keywords"
      content="JSON validator, JSON formatter, JSON syntax checker, JSON beautifier, JSON minifier, validate JSON online, DevOps tools"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={pageDescription}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "JSON Validator and Formatter",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Any",
        url: canonicalUrl,
        description: pageDescription,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "AED",
        },
      })}
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero-section">
        <div class="hero-container">
          <div class="tool-badge">
            <span class="badge-dot"></span>
            Configuration Validator
          </div>

          <h1>JSON Validator</h1>

          <p>
            Validate, format and minify JSON documents directly in
            your browser.
          </p>

          <div class="hero-features">
            <span>✓ Instant validation</span>
            <span>✓ JSON formatting</span>
            <span>✓ JSON minification</span>
            <span>✓ Privacy friendly</span>
          </div>
        </div>
      </section>

      <section class="validator-section">
        <div class="page-container">
          <div class="validator-grid">
            <!-- Input card -->
            <article class="validator-card">
              <div class="card-heading">
                <div>
                  <span class="section-label">Input</span>
                  <h2>JSON input</h2>
                </div>

                <div class="editor-stats">
                  <span id="lineCount">1 line</span>
                  <span id="characterCount">0 characters</span>
                </div>
              </div>

              <div class="action-buttons">
                <button
                  id="validateButton"
                  type="button"
                  class="button button-primary"
                >
                  ✓ Validate
                </button>

                <button
                  id="formatButton"
                  type="button"
                  class="button button-secondary"
                >
                  Format
                </button>

                <button
                  id="minifyButton"
                  type="button"
                  class="button button-secondary"
                >
                  Minify
                </button>

                <button
                  id="sampleButton"
                  type="button"
                  class="button button-secondary"
                >
                  Load sample
                </button>

                <button
                  id="clearButton"
                  type="button"
                  class="button button-danger"
                >
                  Clear
                </button>
              </div>

              <div class="editor-shell">
                <div class="editor-topbar">
                  <span>JSON</span>

                  <button
                    id="copyInputButton"
                    class="small-button"
                    type="button"
                  >
                    Copy input
                  </button>
                </div>

                <div class="editor-body">
                  <div
                    id="lineNumbers"
                    class="line-numbers"
                    aria-hidden="true"
                  >
                    1
                  </div>

                  <textarea
                    id="jsonInput"
                    aria-label="JSON input"
                    spellcheck="false"
                    autocomplete="off"
                    autocapitalize="off"
                    placeholder={`Enter or paste JSON here...

Example:

{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  }
}`}
                  ></textarea>
                </div>
              </div>

              <div
                id="statusBox"
                class="status-box status-neutral"
                role="status"
                aria-live="polite"
              >
                <span id="statusIcon" class="status-icon">i</span>

                <div>
                  <strong id="statusTitle">
                    Ready to validate
                  </strong>

                  <p id="statusMessage">
                    Enter JSON content and click Validate.
                  </p>
                </div>
              </div>
            </article>

            <!-- Output card -->
            <article class="validator-card">
              <div class="card-heading output-heading">
                <div>
                  <span class="section-label">Result</span>
                  <h2>Output</h2>
                </div>

                <button
                  id="copyOutputButton"
                  class="button button-primary"
                  type="button"
                >
                  Copy output
                </button>
              </div>

              <div class="output-shell">
                <div class="output-topbar">
                  <div class="window-buttons">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <span id="outputType">Output</span>
                </div>

                <pre
                  id="outputArea"
                  aria-label="Processed JSON output"
                ><code id="outputCode">Your validated, formatted or minified output will appear here.</code></pre>
              </div>

              <div class="output-footer">
                <button
                  id="downloadButton"
                  type="button"
                  class="download-button"
                  disabled
                >
                  ↓ Download output
                </button>

                <span id="outputStats">
                  No output generated
                </span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="features-section">
        <div class="page-container">
          <div class="section-heading">
            <span class="section-badge">Features</span>

            <h2>Everything needed to work with JSON</h2>

            <p>
              Validate JSON syntax, format large documents and
              generate compact JSON for applications.
            </p>
          </div>

          <div class="features-grid">
            <article class="feature-card">
              <div class="feature-icon">✓</div>
              <h3>Validate JSON</h3>

              <p>
                Detect missing commas, invalid quotes, unexpected
                characters and malformed JSON structures.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">&lt;/&gt;</div>
              <h3>Format JSON</h3>

              <p>
                Beautify JSON using readable two-space indentation.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">−</div>
              <h3>Minify JSON</h3>

              <p>
                Remove unnecessary spaces and line breaks to create
                compact JSON.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">🔒</div>
              <h3>Private processing</h3>

              <p>
                Your JSON is processed locally inside your browser.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section">
        <div class="page-container">
          <div class="guide-grid">
            <article class="guide-card">
              <span class="section-label">Instructions</span>
              <h2>How to use the JSON validator</h2>

              <ol>
                <li>
                  Paste your JSON document into the input editor.
                </li>

                <li>
                  Click <strong>Validate</strong> to check the JSON
                  syntax.
                </li>

                <li>
                  Review the error position when invalid JSON is
                  detected.
                </li>

                <li>
                  Click <strong>Format</strong> to beautify the JSON.
                </li>

                <li>
                  Click <strong>Minify</strong> to generate compact
                  JSON.
                </li>
              </ol>
            </article>

            <article class="guide-card">
              <span class="section-label">Common problems</span>
              <h2>Common JSON errors</h2>

              <ul class="error-list">
                <li>
                  <span>!</span>
                  Missing commas between properties
                </li>

                <li>
                  <span>!</span>
                  Single quotation marks instead of double quotes
                </li>

                <li>
                  <span>!</span>
                  Property names without quotation marks
                </li>

                <li>
                  <span>!</span>
                  Trailing commas after the last item
                </li>

                <li>
                  <span>!</span>
                  Missing closing braces or brackets
                </li>

                <li>
                  <span>!</span>
                  Invalid values such as undefined or NaN
                </li>
              </ul>
            </article>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const jsonInput =
        document.querySelector<HTMLTextAreaElement>("#jsonInput");

      const validateButton =
        document.querySelector<HTMLButtonElement>(
          "#validateButton"
        );

      const formatButton =
        document.querySelector<HTMLButtonElement>(
          "#formatButton"
        );

      const minifyButton =
        document.querySelector<HTMLButtonElement>(
          "#minifyButton"
        );

      const sampleButton =
        document.querySelector<HTMLButtonElement>(
          "#sampleButton"
        );

      const clearButton =
        document.querySelector<HTMLButtonElement>(
          "#clearButton"
        );

      const copyInputButton =
        document.querySelector<HTMLButtonElement>(
          "#copyInputButton"
        );

      const copyOutputButton =
        document.querySelector<HTMLButtonElement>(
          "#copyOutputButton"
        );

      const downloadButton =
        document.querySelector<HTMLButtonElement>(
          "#downloadButton"
        );

      const statusBox =
        document.querySelector<HTMLDivElement>("#statusBox");

      const statusIcon =
        document.querySelector<HTMLSpanElement>("#statusIcon");

      const statusTitle =
        document.querySelector<HTMLElement>("#statusTitle");

      const statusMessage =
        document.querySelector<HTMLParagraphElement>(
          "#statusMessage"
        );

      const outputCode =
        document.querySelector<HTMLElement>("#outputCode");

      const outputType =
        document.querySelector<HTMLSpanElement>("#outputType");

      const outputStats =
        document.querySelector<HTMLSpanElement>("#outputStats");

      const lineNumbers =
        document.querySelector<HTMLDivElement>("#lineNumbers");

      const lineCount =
        document.querySelector<HTMLSpanElement>("#lineCount");

      const characterCount =
        document.querySelector<HTMLSpanElement>(
          "#characterCount"
        );

      const menuButton =
        document.querySelector<HTMLButtonElement>("#menuButton");

      const mainNavigation =
        document.querySelector<HTMLElement>(
          "#mainNavigation"
        );

      let generatedOutput = "";

      const sampleJson = `{
  "application": {
    "name": "gokuruvi-tools",
    "version": "1.0.0",
    "environment": "production"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ssl": true
  },
  "features": {
    "logging": true,
    "auditLogging": true,
    "backup": false
  },
  "services": [
    {
      "name": "web",
      "port": 8080,
      "replicas": 3
    },
    {
      "name": "worker",
      "port": 5432,
      "replicas": 1
    }
  ],
  "monitoringTools": [
  ]
}`;

      function getInputValue() {
        return jsonInput?.value.trim() ?? "";
      }

      function setStatus(
        type: "neutral" | "success" | "error" | "warning",
        title: string,
        message: string
      ) {
        if (
          !statusBox ||
          !statusIcon ||
          !statusTitle ||
          !statusMessage
        ) {
          return;
        }

        const icons = {
          neutral: "i",
          success: "✓",
          error: "×",
          warning: "!",
        };

        statusBox.className = `status-box status-${type}`;
        statusIcon.textContent = icons[type];
        statusTitle.textContent = title;
        statusMessage.textContent = message;
      }

      function parseJsonInput() {
        const input = getInputValue();

        if (!input) {
          throw new Error(
            "Please enter JSON content before using this tool."
          );
        }

        return JSON.parse(input);
      }

      function setOutput(
        content: string,
        type: string
      ) {
        if (
          !outputCode ||
          !outputType ||
          !outputStats ||
          !downloadButton
        ) {
          return;
        }

        generatedOutput = content;

        outputCode.textContent = content;
        outputType.textContent = type;

        const totalLines = content.split("\n").length;
        const totalCharacters = content.length;

        outputStats.textContent =
          `${totalLines} lines · ${totalCharacters} characters`;

        downloadButton.disabled = false;
      }

      function resetOutput() {
        if (
          !outputCode ||
          !outputType ||
          !outputStats ||
          !downloadButton
        ) {
          return;
        }

        generatedOutput = "";

        outputCode.textContent =
          "Your validated, formatted or minified output will appear here.";

        outputType.textContent = "Output";
        outputStats.textContent = "No output generated";
        downloadButton.disabled = true;
      }

      function updateEditorDetails() {
        if (
          !jsonInput ||
          !lineNumbers ||
          !lineCount ||
          !characterCount
        ) {
          return;
        }

        const value = jsonInput.value;

        const totalLines = value
          ? value.split("\n").length
          : 1;

        const totalCharacters = value.length;

        lineNumbers.textContent = Array.from(
          { length: totalLines },
          (_, index) => String(index + 1)
        ).join("\n");

        lineCount.textContent =
          totalLines === 1
            ? "1 line"
            : `${totalLines} lines`;

        characterCount.textContent =
          totalCharacters === 1
            ? "1 character"
            : `${totalCharacters} characters`;
      }

      function getJsonErrorDetails(
        error: unknown,
        jsonText: string
      ) {
        if (!(error instanceof SyntaxError)) {
          return error instanceof Error
            ? error.message
            : "An unknown JSON error occurred.";
        }

        const message = error.message;

        const positionMatch =
          message.match(/position\s+(\d+)/i);

        if (!positionMatch) {
          return message;
        }

        const position = Number(positionMatch[1]);

        if (Number.isNaN(position)) {
          return message;
        }

        const contentBeforeError =
          jsonText.substring(0, position);

        const line =
          contentBeforeError.split("\n").length;

        const lastLineBreak =
          contentBeforeError.lastIndexOf("\n");

        const column =
          position - lastLineBreak;

        return `Line ${line}, column ${column}: ${message}`;
      }

      function validateJson() {
        try {
          const parsedJson = parseJsonInput();

          const formattedJson =
            JSON.stringify(parsedJson, null, 2);

          setOutput(
            formattedJson,
            "Validated JSON"
          );

          setStatus(
            "success",
            "Valid JSON",
            "The JSON document is correctly structured and contains no syntax errors."
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Invalid JSON",
            getJsonErrorDetails(
              error,
              getInputValue()
            )
          );
        }
      }

      function formatJson() {
        try {
          const parsedJson = parseJsonInput();

          const formattedJson =
            JSON.stringify(parsedJson, null, 2);

          if (jsonInput) {
            jsonInput.value = formattedJson;
          }

          updateEditorDetails();

          setOutput(
            formattedJson,
            "Formatted JSON"
          );

          setStatus(
            "success",
            "JSON formatted",
            "The JSON document has been formatted using two-space indentation."
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Unable to format JSON",
            getJsonErrorDetails(
              error,
              getInputValue()
            )
          );
        }
      }

      function minifyJson() {
        try {
          const parsedJson = parseJsonInput();

          const minifiedJson =
            JSON.stringify(parsedJson);

          setOutput(
            minifiedJson,
            "Minified JSON"
          );

          setStatus(
            "success",
            "JSON minified",
            "Unnecessary spaces and line breaks have been removed."
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Unable to minify JSON",
            getJsonErrorDetails(
              error,
              getInputValue()
            )
          );
        }
      }

      async function copyText(
        text: string,
        successMessage: string
      ) {
        if (!text.trim()) {
          setStatus(
            "warning",
            "Nothing to copy",
            "Enter or generate JSON before copying."
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(text);

          setStatus(
            "success",
            "Copied",
            successMessage
          );
        } catch {
          const temporaryTextarea =
            document.createElement("textarea");

          temporaryTextarea.value = text;
          temporaryTextarea.style.position = "fixed";
          temporaryTextarea.style.opacity = "0";
          temporaryTextarea.style.pointerEvents = "none";

          document.body.appendChild(
            temporaryTextarea
          );

          temporaryTextarea.select();
          document.execCommand("copy");
          temporaryTextarea.remove();

          setStatus(
            "success",
            "Copied",
            successMessage
          );
        }
      }

      function downloadOutput() {
        if (!generatedOutput) {
          setStatus(
            "warning",
            "No output available",
            "Validate, format or minify JSON before downloading."
          );

          return;
        }

        const blob = new Blob(
          [generatedOutput],
          {
            type: "application/json;charset=utf-8",
          }
        );

        const objectUrl =
          URL.createObjectURL(blob);

        const downloadLink =
          document.createElement("a");

        downloadLink.href = objectUrl;
        downloadLink.download =
          "json-output.json";

        document.body.appendChild(
          downloadLink
        );

        downloadLink.click();
        downloadLink.remove();

        URL.revokeObjectURL(objectUrl);

        setStatus(
          "success",
          "Download started",
          "The JSON output file is being downloaded."
        );
      }

      function handleTabKey(
        event: KeyboardEvent
      ) {
        if (
          event.key !== "Tab" ||
          !jsonInput
        ) {
          return;
        }

        event.preventDefault();

        const start = jsonInput.selectionStart;
        const end = jsonInput.selectionEnd;
        const value = jsonInput.value;

        jsonInput.value =
          value.substring(0, start) +
          "  " +
          value.substring(end);

        jsonInput.selectionStart = start + 2;
        jsonInput.selectionEnd = start + 2;

        updateEditorDetails();
      }

      validateButton?.addEventListener(
        "click",
        validateJson
      );

      formatButton?.addEventListener(
        "click",
        formatJson
      );

      minifyButton?.addEventListener(
        "click",
        minifyJson
      );

      sampleButton?.addEventListener(
        "click",
        () => {
          if (!jsonInput) {
            return;
          }

          jsonInput.value = sampleJson;

          resetOutput();
          updateEditorDetails();

          setStatus(
            "neutral",
            "Sample JSON loaded",
            "You can now validate, format or minify the sample."
          );

          jsonInput.focus();
        }
      );

      clearButton?.addEventListener(
        "click",
        () => {
          if (!jsonInput) {
            return;
          }

          jsonInput.value = "";

          resetOutput();
          updateEditorDetails();

          setStatus(
            "neutral",
            "Editor cleared",
            "Enter JSON content and click Validate."
          );

          jsonInput.focus();
        }
      );

      copyInputButton?.addEventListener(
        "click",
        () => {
          copyText(
            jsonInput?.value ?? "",
            "The JSON input has been copied."
          );
        }
      );

      copyOutputButton?.addEventListener(
        "click",
        () => {
          copyText(
            generatedOutput,
            "The generated JSON output has been copied."
          );
        }
      );

      downloadButton?.addEventListener(
        "click",
        downloadOutput
      );

      jsonInput?.addEventListener(
        "input",
        updateEditorDetails
      );

      jsonInput?.addEventListener(
        "keydown",
        handleTabKey
      );

      jsonInput?.addEventListener(
        "scroll",
        () => {
          if (lineNumbers && jsonInput) {
            lineNumbers.scrollTop =
              jsonInput.scrollTop;
          }
        }
      );

      menuButton?.addEventListener(
        "click",
        () => {
          if (
            !mainNavigation ||
            !menuButton
          ) {
            return;
          }

          const isOpen =
            mainNavigation.classList.toggle(
              "open"
            );

          menuButton.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

          menuButton.textContent =
            isOpen ? "✕" : "☰";
        }
      );

      updateEditorDetails();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f9fc;
    color: #162033;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  :global(button),
  :global(textarea) {
    font: inherit;
  }

  :global(button) {
    cursor: pointer;
  }

  .page-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #e4e9f2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
  }

  .header-container {
    width: min(1240px, calc(100% - 40px));
    min-height: 72px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #111c32;
    font-size: 1.15rem;
    font-weight: 850;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      #175ee8,
      #397ff7
    );
    color: white;
    font-size: 0.82rem;
    box-shadow:
      0 8px 20px rgba(37, 99, 235, 0.25);
  }

  .main-navigation {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .main-navigation a {
    padding: 9px 13px;
    border-radius: 9px;
    color: #4d5b72;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .main-navigation a:hover,
  .main-navigation a.active {
    background: #edf4ff;
    color: #165ddd;
  }

  .menu-button {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid #dce4ef;
    border-radius: 10px;
    background: white;
    color: #172033;
    font-size: 1.25rem;
  }

  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 74px 20px 66px;
    background:
      radial-gradient(
        circle at 8% 20%,
        rgba(14, 165, 233, 0.09),
        transparent 32%
      ),
      radial-gradient(
        circle at 90% 0%,
        rgba(37, 99, 235, 0.12),
        transparent 36%
      ),
      linear-gradient(
        120deg,
        #f3fbff,
        #f0f5ff
      );
    text-align: center;
  }

  .hero-container {
    width: min(880px, 100%);
    margin-inline: auto;
  }

  .tool-badge,
  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 15px;
    border: 1px solid #bdd6ff;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: #185ce0;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2563eb;
    box-shadow:
