---
const pageTitle = "YAML Validator and Formatter | Gokuruvi Tools";
const pageDescription =
  "Validate, format and convert YAML documents to JSON directly in your browser using the free Gokuruvi YAML Validator.";

const canonicalUrl =
  "https://www.gokuruvi.com/devops/yaml-validator";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={pageDescription}
    />

    <meta
      name="keywords"
      content="YAML validator, YAML formatter, YAML syntax checker, YAML to JSON converter, validate YAML online, DevOps tools"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={pageDescription}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "YAML Validator",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Any",
        url: canonicalUrl,
        description: pageDescription,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "AED",
        },
      })}
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero-section">
        <div class="hero-container">
          <div class="tool-badge">
            <span class="badge-dot"></span>
            Configuration Validator
          </div>

          <h1>YAML Validator</h1>

          <p>
            Validate, format and convert YAML documents to JSON
            directly in your browser.
          </p>

          <div class="hero-features">
            <span>✓ Instant validation</span>
            <span>✓ YAML formatting</span>
            <span>✓ YAML to JSON</span>
            <span>✓ Privacy friendly</span>
          </div>
        </div>
      </section>

      <section class="validator-section">
        <div class="page-container">
          <div class="validator-grid">
            <article class="validator-card input-card">
              <div class="card-heading">
                <div>
                  <span class="section-label">Input</span>
                  <h2>YAML input</h2>
                </div>

                <div class="editor-stats">
                  <span id="lineCount">1 line</span>
                  <span id="characterCount">0 characters</span>
                </div>
              </div>

              <div class="action-buttons">
                <button
                  id="validateButton"
                  type="button"
                  class="button button-primary"
                >
                  <span>✓</span>
                  Validate
                </button>

                <button
                  id="formatButton"
                  type="button"
                  class="button button-secondary"
                >
                  Format
                </button>

                <button
                  id="jsonButton"
                  type="button"
                  class="button button-secondary"
                >
                  Convert to JSON
                </button>

                <button
                  id="sampleButton"
                  type="button"
                  class="button button-secondary"
                >
                  Load sample
                </button>

                <button
                  id="clearButton"
                  type="button"
                  class="button button-danger"
                >
                  Clear
                </button>
              </div>

              <div class="editor-shell">
                <div class="editor-topbar">
                  <span class="editor-language">YAML</span>

                  <button
                    id="copyInputButton"
                    class="small-copy-button"
                    type="button"
                  >
                    Copy input
                  </button>
                </div>

                <div class="editor-body">
                  <div
                    id="lineNumbers"
                    class="line-numbers"
                    aria-hidden="true"
                  >
                    1
                  </div>

                  <textarea
                    id="yamlInput"
                    aria-label="YAML input"
                    spellcheck="false"
                    autocomplete="off"
                    autocapitalize="off"
                    placeholder={`Enter or paste YAML here...

Example:

server:
  host: 0.0.0.0
  port: 8080`}
                  ></textarea>
                </div>
              </div>

              <div
                id="statusBox"
                class="status-box status-neutral"
                role="status"
                aria-live="polite"
              >
                <span id="statusIcon" class="status-icon">i</span>

                <div>
                  <strong id="statusTitle">
                    Ready to validate
                  </strong>

                  <p id="statusMessage">
                    Enter YAML content and click Validate.
                  </p>
                </div>
              </div>
            </article>

            <article class="validator-card output-card">
              <div class="card-heading output-heading">
                <div>
                  <span class="section-label">Result</span>
                  <h2>Output</h2>
                </div>

                <button
                  id="copyOutputButton"
                  class="button button-primary"
                  type="button"
                >
                  Copy output
                </button>
              </div>

              <div class="output-shell">
                <div class="output-topbar">
                  <div class="window-buttons">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <span id="outputType">Output</span>
                </div>

                <pre
                  id="outputArea"
                  aria-label="Processed YAML output"
                ><code id="outputCode">Your validated, formatted or converted output will appear here.</code></pre>
              </div>

              <div class="output-footer">
                <button
                  id="downloadButton"
                  type="button"
                  class="download-button"
                  disabled
                >
                  ↓ Download output
                </button>

                <span id="outputStats">
                  No output generated
                </span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="features-section">
        <div class="page-container">
          <div class="section-heading-centered">
            <span class="section-badge">Features</span>
            <h2>Everything needed to work with YAML</h2>

            <p>
              Quickly identify YAML problems and generate clean,
              reusable configuration files.
            </p>
          </div>

          <div class="features-grid">
            <article class="feature-card">
              <div class="feature-icon">✓</div>
              <h3>Validate YAML</h3>

              <p>
                Detect YAML syntax, indentation, mapping and
                duplicate-key errors instantly.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">&lt;/&gt;</div>
              <h3>Format YAML</h3>

              <p>
                Clean and format YAML using consistent two-space
                indentation.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">{ }</div>
              <h3>Convert to JSON</h3>

              <p>
                Convert valid YAML configurations into readable,
                formatted JSON.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">🔒</div>
              <h3>Private processing</h3>

              <p>
                Your configuration is processed locally inside
                the browser.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="guide-section">
        <div class="page-container">
          <div class="guide-grid">
            <article class="guide-card">
              <span class="section-label">Instructions</span>
              <h2>How to use the YAML validator</h2>

              <ol>
                <li>
                  Paste your YAML configuration into the input
                  editor.
                </li>

                <li>
                  Click <strong>Validate</strong> to check the
                  syntax.
                </li>

                <li>
                  Review the displayed line and column when an
                  error is detected.
                </li>

                <li>
                  Click <strong>Format</strong> to clean the YAML
                  structure.
                </li>

                <li>
                  Click <strong>Convert to JSON</strong> to
                  generate JSON output.
                </li>
              </ol>
            </article>

            <article class="guide-card">
              <span class="section-label">Common problems</span>
              <h2>Common YAML errors</h2>

              <ul class="error-list">
                <li>
                  <span>!</span>
                  Incorrect indentation
                </li>

                <li>
                  <span>!</span>
                  Tab characters used instead of spaces
                </li>

                <li>
                  <span>!</span>
                  Duplicate mapping keys
                </li>

                <li>
                  <span>!</span>
                  Missing spaces after a colon
                </li>

                <li>
                  <span>!</span>
                  Unclosed quotation marks
                </li>

                <li>
                  <span>!</span>
                  Invalid array or object structure
                </li>
              </ul>
            </article>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      import YAML from "yaml";

      const yamlInput =
        document.querySelector<HTMLTextAreaElement>("#yamlInput");

      const validateButton =
        document.querySelector<HTMLButtonElement>(
          "#validateButton"
        );

      const formatButton =
        document.querySelector<HTMLButtonElement>(
          "#formatButton"
        );

      const jsonButton =
        document.querySelector<HTMLButtonElement>("#jsonButton");

      const sampleButton =
        document.querySelector<HTMLButtonElement>(
          "#sampleButton"
        );

      const clearButton =
        document.querySelector<HTMLButtonElement>(
          "#clearButton"
        );

      const copyInputButton =
        document.querySelector<HTMLButtonElement>(
          "#copyInputButton"
        );

      const copyOutputButton =
        document.querySelector<HTMLButtonElement>(
          "#copyOutputButton"
        );

      const downloadButton =
        document.querySelector<HTMLButtonElement>(
          "#downloadButton"
        );

      const statusBox =
        document.querySelector<HTMLDivElement>("#statusBox");

      const statusIcon =
        document.querySelector<HTMLSpanElement>("#statusIcon");

      const statusTitle =
        document.querySelector<HTMLElement>("#statusTitle");

      const statusMessage =
        document.querySelector<HTMLParagraphElement>(
          "#statusMessage"
        );

      const outputCode =
        document.querySelector<HTMLElement>("#outputCode");

      const outputType =
        document.querySelector<HTMLSpanElement>("#outputType");

      const outputStats =
        document.querySelector<HTMLSpanElement>("#outputStats");

      const lineNumbers =
        document.querySelector<HTMLDivElement>("#lineNumbers");

      const lineCount =
        document.querySelector<HTMLSpanElement>("#lineCount");

      const characterCount =
        document.querySelector<HTMLSpanElement>(
          "#characterCount"
        );

      const menuButton =
        document.querySelector<HTMLButtonElement>("#menuButton");

      const mainNavigation =
        document.querySelector<HTMLElement>(
          "#mainNavigation"
        );

      let generatedOutput = "";
      let generatedFileExtension = "yaml";

      const sampleYaml = `application:
  name: gokuruvi-tools
  version: 1.0.0
  environment: production

server:
  host: 0.0.0.0
  port: 8080
  ssl:
    enabled: true
    certificate: /etc/ssl/cert.pem

features:
  logging: true
  auditLogging: true
  backup: false

services:
  - name: web
    port: 8080
    replicas: 3
  - name: worker
    port: 5432
    replicas: 1

healthChecks:
  tools:
`;

      function ensureElements() {
        return (
          yamlInput &&
          statusBox &&
          statusIcon &&
          statusTitle &&
          statusMessage &&
          outputCode &&
          outputType &&
          outputStats &&
          lineNumbers &&
          lineCount &&
          characterCount &&
          downloadButton
        );
      }

      function getInputValue() {
        return yamlInput?.value.trim() ?? "";
      }

      function setStatus(
        type: "neutral" | "success" | "error" | "warning",
        title: string,
        message: string
      ) {
        if (!ensureElements()) {
          return;
        }

        const icons = {
          neutral: "i",
          success: "✓",
          error: "×",
          warning: "!",
        };

        statusBox.className = `status-box status-${type}`;
        statusIcon.textContent = icons[type];
        statusTitle.textContent = title;
        statusMessage.textContent = message;
      }

      function setOutput(
        content: string,
        type: string,
        extension: "yaml" | "json"
      ) {
        if (!ensureElements()) {
          return;
        }

        generatedOutput = content;
        generatedFileExtension = extension;

        outputCode.textContent = content;
        outputType.textContent = type;

        const totalLines = content.split("\n").length;
        const totalCharacters = content.length;

        outputStats.textContent =
          `${totalLines} lines · ${totalCharacters} characters`;

        downloadButton.disabled = false;
      }

      function resetOutput() {
        if (!ensureElements()) {
          return;
        }

        generatedOutput = "";
        generatedFileExtension = "yaml";

        outputCode.textContent =
          "Your validated, formatted or converted output will appear here.";

        outputType.textContent = "Output";
        outputStats.textContent = "No output generated";
        downloadButton.disabled = true;
      }

      function updateEditorDetails() {
        if (
          !yamlInput ||
          !lineNumbers ||
          !lineCount ||
          !characterCount
        ) {
          return;
        }

        const value = yamlInput.value;
        const totalLines = value
          ? value.split("\n").length
          : 1;

        const totalCharacters = value.length;

        lineNumbers.textContent = Array.from(
          { length: totalLines },
          (_, index) => String(index + 1)
        ).join("\n");

        lineCount.textContent =
          totalLines === 1
            ? "1 line"
            : `${totalLines} lines`;

        characterCount.textContent =
          totalCharacters === 1
            ? "1 character"
            : `${totalCharacters} characters`;
      }

      function getErrorLocation(error: unknown) {
        if (
          typeof error === "object" &&
          error !== null &&
          "linePos" in error
        ) {
          const yamlError = error as {
            linePos?: Array<{
              line?: number;
              col?: number;
            }>;
          };

          const position = yamlError.linePos?.[0];

          if (position?.line) {
            return `Line ${position.line}, column ${
              position.col ?? 1
            }`;
          }
        }

        return "";
      }

      function getErrorMessage(error: unknown) {
        const location = getErrorLocation(error);

        let message = "An unknown YAML error occurred.";

        if (error instanceof Error) {
          message = error.message;
        }

        return location
          ? `${location}: ${message}`
          : message;
      }

      function parseYamlInput() {
        const input = getInputValue();

        if (!input) {
          throw new Error(
            "Please enter YAML content before using this tool."
          );
        }

        if (input.includes("\t")) {
          throw new Error(
            "Tab characters were detected. YAML indentation should use spaces."
          );
        }

        const document = YAML.parseDocument(input, {
          prettyErrors: true,
          strict: true,
          uniqueKeys: true,
        });

        if (document.errors.length > 0) {
          throw document.errors[0];
        }

        return {
          document,
          data: document.toJS(),
        };
      }

      function validateYaml() {
        try {
          const { document } = parseYamlInput();

          if (document.warnings.length > 0) {
            const warning = document.warnings[0];

            setStatus(
              "warning",
              "Valid YAML with warning",
              getErrorMessage(warning)
            );
          } else {
            setStatus(
              "success",
              "Valid YAML",
              "The YAML document is correctly structured and contains no syntax errors."
            );
          }

          setOutput(
            yamlInput?.value.trim() ?? "",
            "Validated YAML",
            "yaml"
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Invalid YAML",
            getErrorMessage(error)
          );
        }
      }

      function formatYaml() {
        try {
          const { data } = parseYamlInput();

          const formattedYaml = YAML.stringify(data, {
            indent: 2,
            lineWidth: 0,
            minContentWidth: 0,
          }).trimEnd();

          if (yamlInput) {
            yamlInput.value = formattedYaml;
          }

          updateEditorDetails();

          setOutput(
            formattedYaml,
            "Formatted YAML",
            "yaml"
          );

          setStatus(
            "success",
            "YAML formatted",
            "The YAML document has been formatted using consistent two-space indentation."
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Unable to format YAML",
            getErrorMessage(error)
          );
        }
      }

      function convertToJson() {
        try {
          const { data } = parseYamlInput();

          const jsonOutput = JSON.stringify(data, null, 2);

          setOutput(
            jsonOutput,
            "JSON output",
            "json"
          );

          setStatus(
            "success",
            "Converted to JSON",
            "The YAML document was successfully converted into formatted JSON."
          );
        } catch (error) {
          resetOutput();

          setStatus(
            "error",
            "Unable to convert YAML",
            getErrorMessage(error)
          );
        }
      }

      async function copyText(
        text: string,
        successMessage: string
      ) {
        if (!text.trim()) {
          setStatus(
            "warning",
            "Nothing to copy",
            "Enter or generate content before copying."
          );

          return;
        }

        try {
          await navigator.clipboard.writeText(text);

          setStatus(
            "success",
            "Copied",
            successMessage
          );
        } catch {
          const temporaryTextarea =
            document.createElement("textarea");

          temporaryTextarea.value = text;
          temporaryTextarea.style.position = "fixed";
          temporaryTextarea.style.opacity = "0";
          temporaryTextarea.style.pointerEvents = "none";

          document.body.appendChild(temporaryTextarea);
          temporaryTextarea.select();

          document.execCommand("copy");
          temporaryTextarea.remove();

          setStatus(
            "success",
            "Copied",
            successMessage
          );
        }
      }

      function downloadOutput() {
        if (!generatedOutput) {
          setStatus(
            "warning",
            "No output available",
            "Validate, format or convert YAML before downloading."
          );

          return;
        }

        const mimeType =
          generatedFileExtension === "json"
            ? "application/json"
            : "application/yaml";

        const blob = new Blob([generatedOutput], {
          type: `${mimeType};charset=utf-8`,
        });

        const objectUrl = URL.createObjectURL(blob);
        const downloadLink =
          document.createElement("a");

        downloadLink.href = objectUrl;

        downloadLink.download =
          generatedFileExtension === "json"
            ? "converted-output.json"
            : "validated-output.yaml";

        document.body.appendChild(downloadLink);
        downloadLink.click();
        downloadLink.remove();

        URL.revokeObjectURL(objectUrl);

        setStatus(
          "success",
          "Download started",
          `The ${generatedFileExtension.toUpperCase()} file is being downloaded.`
        );
      }

      function handleTabKey(event: KeyboardEvent) {
        if (
          event.key !== "Tab" ||
          !yamlInput
        ) {
          return;
        }

        event.preventDefault();

        const start = yamlInput.selectionStart;
        const end = yamlInput.selectionEnd;
        const value = yamlInput.value;

        yamlInput.value =
          value.substring(0, start) +
          "  " +
          value.substring(end);

        yamlInput.selectionStart = start + 2;
        yamlInput.selectionEnd = start + 2;

        updateEditorDetails();
      }

      validateButton?.addEventListener(
        "click",
        validateYaml
      );

      formatButton?.addEventListener(
        "click",
        formatYaml
      );

      jsonButton?.addEventListener(
        "click",
        convertToJson
      );

      sampleButton?.addEventListener("click", () => {
        if (!yamlInput) {
          return;
        }

        yamlInput.value = sampleYaml;

        resetOutput();
        updateEditorDetails();

        setStatus(
          "neutral",
          "Sample YAML loaded",
          "You can now validate, format or convert the sample configuration."
        );

        yamlInput.focus();
      });

      clearButton?.addEventListener("click", () => {
        if (!yamlInput) {
          return;
        }

        yamlInput.value = "";

        resetOutput();
        updateEditorDetails();

        setStatus(
          "neutral",
          "Editor cleared",
          "Enter YAML content and click Validate."
        );

        yamlInput.focus();
      });

      copyInputButton?.addEventListener(
        "click",
        () => {
          copyText(
            yamlInput?.value ?? "",
            "The YAML input has been copied to your clipboard."
          );
        }
      );

      copyOutputButton?.addEventListener(
        "click",
        () => {
          copyText(
            generatedOutput,
            "The generated output has been copied to your clipboard."
          );
        }
      );

      downloadButton?.addEventListener(
        "click",
        downloadOutput
      );

      yamlInput?.addEventListener(
        "input",
        updateEditorDetails
      );

      yamlInput?.addEventListener(
        "keydown",
        handleTabKey
      );

      yamlInput?.addEventListener("scroll", () => {
        if (lineNumbers && yamlInput) {
          lineNumbers.scrollTop =
            yamlInput.scrollTop;
        }
      });

      menuButton?.addEventListener("click", () => {
        if (!mainNavigation || !menuButton) {
          return;
        }

        const isOpen =
          mainNavigation.classList.toggle("open");

        menuButton.setAttribute(
          "aria-expanded",
          String(isOpen)
        );

        menuButton.textContent =
          isOpen ? "✕" : "☰";
      });

      updateEditorDetails();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f9fc;
    color: #162033;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  :global(button),
  :global(textarea) {
    font: inherit;
  }

  :global(button) {
    cursor: pointer;
  }

  .page-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #e4e9f2;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
  }

  .header-container {
    width: min(1240px, calc(100% - 40px));
    min-height: 72px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #111c32;
    font-size: 1.15rem;
    font-weight: 850;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(135deg, #175ee8, #397ff7);
    color: white;
    font-size: 0.82rem;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
  }

  .main-navigation {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .main-navigation a {
    padding: 9px 13px;
    border-radius: 9px;
    color: #4d5b72;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .main-navigation a:hover,
  .main-navigation a.active {
    background: #edf4ff;
    color: #165ddd;
  }

  .menu-button {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid #dce4ef;
    border-radius: 10px;
    background: white;
    color: #172033;
    font-size: 1.25rem;
  }

  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 74px 20px 66px;
    background:
      radial-gradient(
        circle at 8% 20%,
        rgba(14, 165, 233, 0.09),
        transparent 32%
      ),
      radial-gradient(
        circle at 90% 0%,
        rgba(37, 99, 235, 0.12),
        transparent 36%
      ),
      linear-gradient(120deg, #f3fbff, #f0f5ff);
    text-align: center;
  }

  .hero-section::before,
  .hero-section::after {
    position: absolute;
