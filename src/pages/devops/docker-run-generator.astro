                  class="dynamic-rows"
                ></div>
              </div>

              <div class="dynamic-section">
                <div class="dynamic-heading">
                  <div>
                    <h3>Resource limits</h3>
                    <p>Optionally limit CPU and memory usage.</p>
                  </div>
                </div>

                <div class="form-grid">
                  <div class="form-group">
                    <label for="cpuLimit">
                      CPU limit
                    </label>

                    <input
                      id="cpuLimit"
                      type="number"
                      min="0"
                      step="0.1"
                      placeholder="Example: 1.5"
                    />
                  </div>

                  <div class="form-group">
                    <label for="memoryLimit">
                      Memory limit
                    </label>

                    <input
                      id="memoryLimit"
                      type="text"
                      placeholder="Example: 512m or 2g"
                    />
                  </div>

                  <div class="form-group">
                    <label for="memoryReservation">
                      Memory reservation
                    </label>

                    <input
                      id="memoryReservation"
                      type="text"
                      placeholder="Example: 256m"
                    />
                  </div>

                  <div class="form-group">
                    <label for="sharedMemory">
                      Shared memory
                    </label>

                    <input
                      id="sharedMemory"
                      type="text"
                      placeholder="Example: 128m"
                    />
                  </div>
                </div>
              </div>

              <div class="dynamic-section">
                <div class="dynamic-heading">
                  <div>
                    <h3>Advanced options</h3>
                    <p>
                      Add DNS, entrypoint, labels and additional arguments.
                    </p>
                  </div>
                </div>

                <div class="form-grid">
                  <div class="form-group">
                    <label for="dnsServer">
                      DNS server
                    </label>

                    <input
                      id="dnsServer"
                      type="text"
                      placeholder="Example: 8.8.8.8"
                    />
                  </div>

                  <div class="form-group">
                    <label for="entrypoint">
                      Entrypoint
                    </label>

                    <input
                      id="entrypoint"
                      type="text"
                      placeholder="Example: /docker-entrypoint.sh"
                    />
                  </div>

                  <div class="form-group">
                    <label for="containerLabel">
                      Container label
                    </label>

                    <input
                      id="containerLabel"
                      type="text"
                      placeholder="Example: environment=production"
                    />
                  </div>

                  <div class="form-group">
                    <label for="platform">
                      Platform
                    </label>

                    <select id="platform">
                      <option value="">Default platform</option>
                      <option value="linux/amd64">
                        linux/amd64
                      </option>
                      <option value="linux/arm64">
                        linux/arm64
                      </option>
                      <option value="linux/arm/v7">
                        linux/arm/v7
                      </option>
                      <option value="windows/amd64">
                        windows/amd64
                      </option>
                    </select>
                  </div>

                  <div class="form-group full-width">
                    <label for="additionalOptions">
                      Additional Docker options
                    </label>

                    <input
                      id="additionalOptions"
                      type="text"
                      placeholder="Example: --cap-add NET_ADMIN --log-driver json-file"
                    />

                    <small>
                      Enter trusted Docker options exactly as they
                      should appear.
                    </small>
                  </div>

                  <div class="form-group full-width">
                    <label for="containerCommand">
                      Container command
                    </label>

                    <input
                      id="containerCommand"
                      type="text"
                      placeholder="Example: nginx -g 'daemon off;'"
                    />

                    <small>
                      This command will be added after the image name.
                    </small>
                  </div>
                </div>
              </div>

              <div class="form-actions">
                <button
                  id="generateButton"
                  class="button button-primary large-button"
                  type="button"
                >
                  Generate Docker command
                </button>

                <button
                  id="resetButton"
                  class="button button-danger-outline"
                  type="button"
                >
                  Reset
                </button>
              </div>
            </section>

            <aside class="output-card">
              <div class="output-heading">
                <div>
                  <span class="section-label">Generated result</span>
                  <h2>Docker command</h2>
                </div>

                <button
                  id="copyButton"
                  class="button button-primary"
                  type="button"
                >
                  Copy command
                </button>
              </div>

              <div
                id="statusBox"
                class="status-box status-neutral"
                role="status"
                aria-live="polite"
              >
                <span id="statusIcon" class="status-icon">i</span>

                <div>
                  <strong id="statusTitle">
                    Ready to generate
                  </strong>

                  <p id="statusMessage">
                    Enter a Docker image and configure the required
                    options.
                  </p>
                </div>
              </div>

              <div class="terminal">
                <div class="terminal-topbar">
                  <div class="terminal-buttons">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <span>docker-run.sh</span>
                </div>

                <pre><code id="commandOutput">docker run nginx:latest</code></pre>
              </div>

              <div class="output-actions">
                <button
                  id="downloadButton"
                  class="output-action-button"
                  type="button"
                >
                  ↓ Download script
                </button>

                <button
                  id="singleLineButton"
                  class="output-action-button"
                  type="button"
                >
                  Single-line view
                </button>
              </div>

              <div class="command-summary">
                <h3>Selected options</h3>

                <div id="summaryList" class="summary-list">
                  <div>
                    <span>Image</span>
                    <strong>nginx:latest</strong>
                  </div>

                  <div>
                    <span>Mode</span>
                    <strong>Detached</strong>
                  </div>
                </div>
              </div>

              <div class="security-note">
                <strong>Security notice</strong>

                <p>
                  Use privileged mode only when it is necessary.
                  Avoid placing passwords directly in commands that
                  may be stored in your shell history.
                </p>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="information-section">
        <div class="page-container">
          <div class="section-heading-centered">
            <span class="tool-badge">Docker options</span>

            <h2>Build Docker commands without syntax mistakes</h2>

            <p>
              Configure common Docker run options using a simple
              form and copy the generated command.
            </p>
          </div>

          <div class="feature-grid">
            <article class="feature-card">
              <div class="feature-icon">↔</div>
              <h3>Port mappings</h3>

              <p>
                Publish one or more container ports on the Docker
                host.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">▣</div>
              <h3>Volume mounts</h3>

              <p>
                Configure persistent storage and read-only volume
                mappings.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">ENV</div>
              <h3>Environment variables</h3>

              <p>
                Add multiple key-value configuration variables.
              </p>
            </article>

            <article class="feature-card">
              <div class="feature-icon">CPU</div>
              <h3>Resource limits</h3>

              <p>
                Define CPU, memory and shared-memory limits.
              </p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-about">
          <a href="/" class="footer-brand">
            Gokuruvi Tools
          </a>

          <p>
            Free tools for Linux administrators, DevOps engineers,
            Kubernetes users and cloud professionals.
          </p>
        </div>

        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
      </div>

      <div class="footer-bottom">
        © 2026 Sathish Ramalingam. All rights reserved.
      </div>
    </footer>

    <script>
      const imageName =
        document.querySelector<HTMLInputElement>("#imageName");

      const containerName =
        document.querySelector<HTMLInputElement>("#containerName");

      const hostname =
        document.querySelector<HTMLInputElement>("#hostname");

      const restartPolicy =
        document.querySelector<HTMLSelectElement>("#restartPolicy");

      const networkName =
        document.querySelector<HTMLInputElement>("#networkName");

      const workingDirectory =
        document.querySelector<HTMLInputElement>(
          "#workingDirectory"
        );

      const userName =
        document.querySelector<HTMLInputElement>("#userName");

      const detachedMode =
        document.querySelector<HTMLInputElement>("#detachedMode");

      const removeContainer =
        document.querySelector<HTMLInputElement>(
          "#removeContainer"
        );

      const interactiveMode =
        document.querySelector<HTMLInputElement>(
          "#interactiveMode"
        );

      const allocateTty =
        document.querySelector<HTMLInputElement>("#allocateTty");

      const privilegedMode =
        document.querySelector<HTMLInputElement>(
          "#privilegedMode"
        );

      const readOnlyMode =
        document.querySelector<HTMLInputElement>("#readOnlyMode");

      const cpuLimit =
        document.querySelector<HTMLInputElement>("#cpuLimit");

      const memoryLimit =
        document.querySelector<HTMLInputElement>("#memoryLimit");

      const memoryReservation =
        document.querySelector<HTMLInputElement>(
          "#memoryReservation"
        );

      const sharedMemory =
        document.querySelector<HTMLInputElement>("#sharedMemory");

      const dnsServer =
        document.querySelector<HTMLInputElement>("#dnsServer");

      const entrypoint =
        document.querySelector<HTMLInputElement>("#entrypoint");

      const containerLabel =
        document.querySelector<HTMLInputElement>(
          "#containerLabel"
        );

      const platform =
        document.querySelector<HTMLSelectElement>("#platform");

      const additionalOptions =
        document.querySelector<HTMLInputElement>(
          "#additionalOptions"
        );

      const containerCommand =
        document.querySelector<HTMLInputElement>(
          "#containerCommand"
        );

      const portRows =
        document.querySelector<HTMLDivElement>("#portRows");

      const volumeRows =
        document.querySelector<HTMLDivElement>("#volumeRows");

      const environmentRows =
        document.querySelector<HTMLDivElement>(
          "#environmentRows"
        );

      const commandOutput =
        document.querySelector<HTMLElement>("#commandOutput");

      const summaryList =
        document.querySelector<HTMLDivElement>("#summaryList");

      const statusBox =
        document.querySelector<HTMLDivElement>("#statusBox");

      const statusIcon =
        document.querySelector<HTMLSpanElement>("#statusIcon");

      const statusTitle =
        document.querySelector<HTMLElement>("#statusTitle");

      const statusMessage =
        document.querySelector<HTMLParagraphElement>(
          "#statusMessage"
        );

      const generateButton =
        document.querySelector<HTMLButtonElement>(
          "#generateButton"
        );

      const copyButton =
        document.querySelector<HTMLButtonElement>("#copyButton");

      const resetButton =
        document.querySelector<HTMLButtonElement>("#resetButton");

      const loadSampleButton =
        document.querySelector<HTMLButtonElement>(
          "#loadSampleButton"
        );

      const addPortButton =
        document.querySelector<HTMLButtonElement>("#addPortButton");

      const addVolumeButton =
        document.querySelector<HTMLButtonElement>(
          "#addVolumeButton"
        );

      const addEnvironmentButton =
        document.querySelector<HTMLButtonElement>(
          "#addEnvironmentButton"
        );

      const downloadButton =
        document.querySelector<HTMLButtonElement>(
          "#downloadButton"
        );

      const singleLineButton =
        document.querySelector<HTMLButtonElement>(
          "#singleLineButton"
        );

      const menuButton =
        document.querySelector<HTMLButtonElement>("#menuButton");

      const mainNavigation =
        document.querySelector<HTMLElement>("#mainNavigation");

      let generatedCommand = "docker run nginx:latest";
      let multilineMode = true;

      function shellQuote(value: string) {
        const trimmedValue = value.trim();

        if (!trimmedValue) {
          return "";
        }

        if (/^[a-zA-Z0-9_./:@%+=,-]+$/.test(trimmedValue)) {
          return trimmedValue;
        }

        return `'${trimmedValue.replace(/'/g, `'\\''`)}'`;
      }

      function setStatus(
        type: "neutral" | "success" | "error" | "warning",
        title: string,
        message: string
      ) {
        if (
          !statusBox ||
          !statusIcon ||
          !statusTitle ||
          !statusMessage
        ) {
          return;
        }

        const icons = {
          neutral: "i",
          success: "✓",
          error: "×",
          warning: "!",
        };

        statusBox.className = `status-box status-${type}`;
        statusIcon.textContent = icons[type];
        statusTitle.textContent = title;
        statusMessage.textContent = message;
      }

      function createPortRow(
        hostPort = "",
        containerPort = "",
        protocol = "tcp"
      ) {
        if (!portRows) {
          return;
        }

        const row = document.createElement("div");
        row.className = "dynamic-row port-row";

        row.innerHTML = `
          <input
            class="host-port"
            type="number"
            min="1"
            max="65535"
            placeholder="Host port"
            value="${hostPort}"
          />

          <span class="mapping-arrow">→</span>

          <input
            class="container-port"
            type="number"
            min="1"
            max="65535"
            placeholder="Container port"
            value="${containerPort}"
          />

          <select class="port-protocol">
            <option value="tcp" ${
              protocol === "tcp" ? "selected" : ""
            }>TCP</option>

            <option value="udp" ${
              protocol === "udp" ? "selected" : ""
            }>UDP</option>
          </select>

          <button
            class="remove-row-button"
            type="button"
            aria-label="Remove port mapping"
          >
            ×
          </button>
        `;

        row
          .querySelector(".remove-row-button")
          ?.addEventListener("click", () => {
            row.remove();
            generateCommand(false);
          });

        row
          .querySelectorAll("input, select")
          .forEach((element) => {
            element.addEventListener("input", () => {
              generateCommand(false);
            });
          });

        portRows.appendChild(row);
      }

      function createVolumeRow(
        source = "",
        destination = "",
        readOnly = false
      ) {
        if (!volumeRows) {
          return;
        }

        const row = document.createElement("div");
        row.className = "dynamic-row volume-row";

        row.innerHTML = `
          <input
            class="volume-source"
            type="text"
            placeholder="Host path or volume"
            value="${source}"
          />

          <span class="mapping-arrow">→</span>

          <input
            class="volume-destination"
            type="text"
            placeholder="Container path"
            value="${destination}"
          />

          <label class="small-checkbox">
            <input
              class="volume-readonly"
              type="checkbox"
              ${readOnly ? "checked" : ""}
            />

            Read only
          </label>

          <button
            class="remove-row-button"
            type="button"
            aria-label="Remove volume mapping"
          >
            ×
          </button>
        `;

        row
          .querySelector(".remove-row-button")
          ?.addEventListener("click", () => {
            row.remove();
            generateCommand(false);
          });

        row
          .querySelectorAll("input")
          .forEach((element) => {
            element.addEventListener("input", () => {
              generateCommand(false);
            });
          });

        volumeRows.appendChild(row);
      }

      function createEnvironmentRow(
        key = "",
        value = ""
      ) {
        if (!environmentRows) {
          return;
        }

        const row = document.createElement("div");
        row.className = "dynamic-row environment-row";

        row.innerHTML = `
          <input
            class="environment-key"
            type="text"
            placeholder="Variable name"
            value="${key}"
          />

          <span class="mapping-arrow">=</span>

          <input
            class="environment-value"
            type="text"
            placeholder="Variable value"
            value="${value}"
          />

          <button
            class="remove-row-button"
            type="button"
            aria-label="Remove environment variable"
          >
            ×
          </button>
        `;

        row
          .querySelector(".remove-row-button")
          ?.addEventListener("click", () => {
            row.remove();
            generateCommand(false);
          });

        row
          .querySelectorAll("input")
          .forEach((element) => {
            element.addEventListener("input", () => {
              generateCommand(false);
            });
          });

        environmentRows.appendChild(row);
      }

      function collectPortOptions() {
        const options: string[] = [];

        portRows
          ?.querySelectorAll<HTMLElement>(".port-row")
          .forEach((row) => {
            const hostPort =
              row.querySelector<HTMLInputElement>(".host-port")
                ?.value.trim() ?? "";

            const containerPort =
              row.querySelector<HTMLInputElement>(
                ".container-port"
              )?.value.trim() ?? "";

            const protocol =
              row.querySelector<HTMLSelectElement>(
                ".port-protocol"
              )?.value ?? "tcp";

            if (hostPort && containerPort) {
              const protocolSuffix =
                protocol === "udp" ? "/udp" : "";

              options.push(
                `--publish ${hostPort}:${containerPort}${protocolSuffix}`
              );
            }
          });

        return options;
      }

      function collectVolumeOptions() {
        const options: string[] = [];

        volumeRows
          ?.querySelectorAll<HTMLElement>(".volume-row")
          .forEach((row) => {
            const source =
              row.querySelector<HTMLInputElement>(".volume-source")
                ?.value.trim() ?? "";

            const destination =
              row.querySelector<HTMLInputElement>(
                ".volume-destination"
              )?.value.trim() ?? "";

            const readOnly =
              row.querySelector<HTMLInputElement>(
                ".volume-readonly"
              )?.checked ?? false;

            if (source && destination) {
              const value =
                `${source}:${destination}` +
                (readOnly ? ":ro" : "");

              options.push(`--volume ${shellQuote(value)}`);
            }
          });

        return options;
      }

      function collectEnvironmentOptions() {
        const options: string[] = [];

        environmentRows
          ?.querySelectorAll<HTMLElement>(".environment-row")
          .forEach((row) => {
            const key =
              row.querySelector<HTMLInputElement>(
                ".environment-key"
              )?.value.trim() ?? "";

            const value =
              row.querySelector<HTMLInputElement>(
                ".environment-value"
              )?.value ?? "";

            if (key) {
              options.push(
                `--env ${shellQuote(`${key}=${value}`)}`
              );
            }
          });

        return options;
      }

      function buildSummary(
        image: string,
        optionCount: number
      ) {
        if (!summaryList) {
          return;
        }

        const summary: Array<[string, string]> = [
          ["Image", image],
          [
            "Mode",
            detachedMode?.checked
              ? "Detached"
              : "Foreground",
          ],
          ["Options", String(optionCount)],
          [
            "Ports",
            String(
              collectPortOptions().length
            ),
          ],
          [
            "Volumes",
            String(
              collectVolumeOptions().length
            ),
          ],
          [
            "Environment variables",
            String(
              collectEnvironmentOptions().length
            ),
          ],
        ];

        summaryList.innerHTML = summary
          .map(
            ([label, value]) => `
              <div>
                <span>${label}</span>
                <strong>${value}</strong>
              </div>
            `
          )
          .join("");
      }

      function generateCommand(showStatus = true) {
        const image =
          imageName?.value.trim() || "nginx:latest";

        const options: string[] = [];

        if (detachedMode?.checked) {
          options.push("--detach");
        }

        if (removeContainer?.checked) {
          options.push("--rm");
        }

        if (interactiveMode?.checked) {
          options.push("--interactive");
        }

        if (allocateTty?.checked) {
          options.push("--tty");
        }

        if (privilegedMode?.checked) {
          options.push("--privileged");
        }

        if (readOnlyMode?.checked) {
          options.push("--read-only");
        }

        if (containerName?.value.trim()) {
          options.push(
            `--name ${shellQuote(containerName.value)}`
          );
        }

        if (hostname?.value.trim()) {
          options.push(
            `--hostname ${shellQuote(hostname.value)}`
          );
        }

        if (restartPolicy?.value) {
          options.push(
            `--restart ${restartPolicy.value}`
          );
        }

        if (networkName?.value.trim()) {
          options.push(
            `--network ${shellQuote(networkName.value)}`
          );
        }

        if (workingDirectory?.value.trim()) {
          options.push(
            `--workdir ${shellQuote(workingDirectory.value)}`
          );
        }

        if (userName?.value.trim()) {
          options.push(
            `--user ${shellQuote(userName.value)}`
          );
        }

        options.push(...collectPortOptions());
        options.push(...collectVolumeOptions());
        options.push(...collectEnvironmentOptions());

        if (cpuLimit?.value.trim()) {
          options.push(
            `--cpus ${shellQuote(cpuLimit.value)}`
          );
        }

        if (memoryLimit?.value.trim()) {
          options.push(
            `--memory ${shellQuote(memoryLimit.value)}`
          );
        }

        if (memoryReservation?.value.trim()) {
          options.push(
            `--memory-reservation ${shellQuote(
              memoryReservation.value
            )}`
          );
        }

        if (sharedMemory?.value.trim()) {
          options.push(
            `--shm-size ${shellQuote(sharedMemory.value)}`
          );
        }

        if (dnsServer?.value.trim()) {
          options.push(
            `--dns ${shellQuote(dnsServer.value)}`
          );
        }

        if (entrypoint?.value.trim()) {
          options.push(
            `--entrypoint ${shellQuote(entrypoint.value)}`
          );
        }

        if (containerLabel?.value.trim()) {
          options.push(
            `--label ${shellQuote(containerLabel.value)}`
          );
        }

        if (platform?.value) {
          options.push(
            `--platform ${platform.value}`
          );
        }

        if (additionalOptions?.value.trim()) {
          options.push(additionalOptions.value.trim());
        }

        const imagePart = shellQuote(image);

        const commandPart =
          containerCommand?.value.trim()
            ? ` ${containerCommand.value.trim()}`
            : "";

        const singleLineCommand = [
          "docker run",
          ...options,
          imagePart,
        ]
          .filter(Boolean)
          .join(" ")
          .concat(commandPart);

        const multilineCommand =
          options.length > 0
            ? [
                "docker run \\",
                ...options.map(
                  (option) => `  ${option} \\`
                ),
                `  ${imagePart}${commandPart}`,
              ].join("\n")
            : `docker run ${imagePart}${commandPart}`;

        generatedCommand =
          multilineMode
            ? multilineCommand
            : singleLineCommand;

        if (commandOutput) {
          commandOutput.textContent = generatedCommand;
        }

        buildSummary(image, options.length);

        if (showStatus) {
          setStatus(
            "success",
            "Docker command generated",
            "Review the command before running it on your Docker host."
          );
        }
      }

      async function copyCommand() {
        try {
          await navigator.clipboard.writeText(
            generatedCommand
          );

          setStatus(
            "success",
            "Command copied",
            "The Docker run command has been copied to your clipboard."
          );
        } catch {
          const temporaryTextarea =
            document.createElement("textarea");

          temporaryTextarea.value = generatedCommand;
          temporaryTextarea.style.position = "fixed";
          temporaryTextarea.style.opacity = "0";

          document.body.appendChild(
            temporaryTextarea
          );

          temporaryTextarea.select();
          document.execCommand("copy");
          temporaryTextarea.remove();

          setStatus(
            "success",
            "Command copied",
            "The Docker run command has been copied to your clipboard."
          );
        }
      }

      function downloadScript() {
        const scriptContent =
          `#!/usr/bin/env bash\n\nset -e\n\n${generatedCommand}\n`;

        const blob = new Blob([scriptContent], {
          type: "text/x-shellscript;charset=utf-8",
        });

        const objectUrl =
          URL.createObjectURL(blob);

        const link =
          document.createElement("a");

        link.href = objectUrl;
        link.download = "docker-run.sh";

        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(objectUrl);

        setStatus(
          "success",
          "Script downloaded",
          "The Docker command has been saved as docker-run.sh."
        );
      }

      function resetForm() {
        document
          .querySelectorAll<
            HTMLInputElement | HTMLSelectElement
          >(
            ".generator-card input, .generator-card select"
          )
          .forEach((element) => {
            if (element instanceof HTMLInputElement) {
              if (element.type === "checkbox") {
                element.checked =
                  element.id === "detachedMode";
              } else {
                element.value = "";
              }
            } else {
              element.selectedIndex = 0;
            }
          });

        if (portRows) {
          portRows.innerHTML = "";
        }

        if (volumeRows) {
          volumeRows.innerHTML = "";
        }

        if (environmentRows) {
          environmentRows.innerHTML = "";
        }

        imageName!.value = "nginx:latest";

        createPortRow();
        createVolumeRow();
        createEnvironmentRow();

        multilineMode = true;

        if (singleLineButton) {
          singleLineButton.textContent =
            "Single-line view";
        }

        generateCommand(false);

        setStatus(
          "neutral",
          "Form reset",
          "Configure the Docker options and generate a new command."
        );
      }

      function loadSample() {
        if (
          !imageName ||
          !containerName ||
          !restartPolicy ||
          !networkName ||
          !memoryLimit ||
          !cpuLimit
        ) {
          return;
        }

        imageName.value = "nginx:latest";
        containerName.value = "gokuruvi-web";
        restartPolicy.value = "unless-stopped";
        networkName.value = "web-network";
        memoryLimit.value = "512m";
        cpuLimit.value = "1";

        if (detachedMode) {
          detachedMode.checked = true;
        }

        if (portRows) {
          portRows.innerHTML = "";
        }

        if (volumeRows) {
          volumeRows.innerHTML = "";
        }

        if (environmentRows) {
          environmentRows.innerHTML = "";
        }

        createPortRow("8080", "80", "tcp");

        createVolumeRow(
          "/opt/gokuruvi/html",
          "/usr/share/nginx/html",
          true
        );

        createEnvironmentRow(
          "NGINX_HOST",
          "www.gokuruvi.com"
        );

        createEnvironmentRow(
          "APP_ENV",
          "production"
        );

        generateCommand();

        setStatus(
          "success",
          "Sample configuration loaded",
          "The sample Nginx Docker command is ready."
        );
      }

      addPortButton?.addEventListener(
        "click",
        () => createPortRow()
      );

      addVolumeButton?.addEventListener(
        "click",
        () => createVolumeRow()
      );

      addEnvironmentButton?.addEventListener(
        "click",
        () => createEnvironmentRow()
      );

      generateButton?.addEventListener(
        "click",
        () => {
          if (!imageName?.value.trim()) {
            setStatus(
              "warning",
              "Docker image required",
              "Enter a Docker image such as nginx:latest."
            );

            imageName?.focus();
            return;
          }

          generateCommand();
        }
      );

      copyButton?.addEventListener(
        "click",
        copyCommand
      );

      downloadButton?.addEventListener(
        "click",
        downloadScript
      );

      resetButton?.addEventListener(
        "click",
        resetForm
      );

      loadSampleButton?.addEventListener(
        "click",
        loadSample
      );

      singleLineButton?.addEventListener(
        "click",
        () => {
          multilineMode = !multilineMode;

          singleLineButton.textContent =
            multilineMode
              ? "Single-line view"
              : "Multi-line view";

          generateCommand(false);
        }
      );

      document
        .querySelectorAll<
          HTMLInputElement | HTMLSelectElement
        >(
          ".generator-card input, .generator-card select"
        )
        .forEach((element) => {
          element.addEventListener("input", () => {
            generateCommand(false);
          });

          element.addEventListener("change", () => {
            generateCommand(false);
          });
        });

      menuButton?.addEventListener(
        "click",
        () => {
          if (
            !mainNavigation ||
            !menuButton
          ) {
            return;
          }

          const isOpen =
            mainNavigation.classList.toggle("open");

          menuButton.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

          menuButton.textContent =
            isOpen ? "✕" : "☰";
        }
      );

      if (imageName) {
        imageName.value = "nginx:latest";
      }

      createPortRow();
      createVolumeRow();
      createEnvironmentRow();
      generateCommand(false);
    </script>
  </body>
