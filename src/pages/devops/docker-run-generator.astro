---
const pageTitle = "Docker Run Command Generator | Gokuruvi Tools";

const pageDescription =
  "Generate Docker run commands with ports, volumes, environment variables, restart policies, networks, resource limits and other common Docker options.";

const canonicalUrl =
  "https://www.gokuruvi.com/devops/docker-run-generator";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={pageDescription}
    />

    <meta
      name="keywords"
      content="Docker run command generator, Docker command builder, Docker port mapping, Docker volume mapping, Docker environment variables, DevOps tools"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Docker Run Command Generator",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Any",
        url: canonicalUrl,
        description: pageDescription,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "AED",
        },
      })}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand">
          <span class="brand-mark">&lt;/&gt;</span>
          <span>Gokuruvi Tools</span>
        </a>

        <button
          id="menuButton"
          class="menu-button"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          ☰
        </button>

        <nav id="mainNavigation" class="main-navigation">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops" class="active">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a href="/cloud">Cloud</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero-section">
        <div class="hero-container">
          <div class="tool-badge">
            <span class="badge-dot"></span>
            Container Command Builder
          </div>

          <h1>Docker Run Generator</h1>

          <p>
            Build a complete Docker run command with port mappings,
            volumes, environment variables, networks and resource limits.
          </p>

          <div class="hero-features">
            <span>✓ Instant command generation</span>
            <span>✓ Multiple ports and volumes</span>
            <span>✓ Resource limits</span>
            <span>✓ Browser-based processing</span>
          </div>
        </div>
      </section>

      <section class="generator-section">
        <div class="page-container">
          <div class="generator-grid">
            <section class="generator-card">
              <div class="card-heading">
                <div>
                  <span class="section-label">Configuration</span>
                  <h2>Container settings</h2>
                </div>

                <button
                  id="loadSampleButton"
                  class="button button-secondary"
                  type="button"
                >
                  Load sample
                </button>
              </div>

              <div class="form-grid">
                <div class="form-group full-width">
                  <label for="imageName">
                    Docker image
                    <span>*</span>
                  </label>

                  <input
                    id="imageName"
                    type="text"
                    placeholder="Example: nginx:latest"
                    autocomplete="off"
                  />

                  <small>
                    Enter the image name and optional tag.
                  </small>
                </div>

                <div class="form-group">
                  <label for="containerName">
                    Container name
                  </label>

                  <input
                    id="containerName"
                    type="text"
                    placeholder="Example: web-server"
                    autocomplete="off"
                  />
                </div>

                <div class="form-group">
                  <label for="hostname">
                    Container hostname
                  </label>

                  <input
                    id="hostname"
                    type="text"
                    placeholder="Example: nginx-host"
                    autocomplete="off"
                  />
                </div>

                <div class="form-group">
                  <label for="restartPolicy">
                    Restart policy
                  </label>

                  <select id="restartPolicy">
                    <option value="">No restart policy</option>
                    <option value="no">no</option>
                    <option value="always">always</option>
                    <option value="unless-stopped">
                      unless-stopped
                    </option>
                    <option value="on-failure">
                      on-failure
                    </option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="networkName">
                    Docker network
                  </label>

                  <input
                    id="networkName"
                    type="text"
                    placeholder="Example: application-network"
                    autocomplete="off"
                  />
                </div>

                <div class="form-group">
                  <label for="workingDirectory">
                    Working directory
                  </label>

                  <input
                    id="workingDirectory"
                    type="text"
                    placeholder="Example: /app"
                    autocomplete="off"
                  />
                </div>

                <div class="form-group">
                  <label for="userName">
                    User or UID
                  </label>

                  <input
                    id="userName"
                    type="text"
                    placeholder="Example: 1000:1000"
                    autocomplete="off"
                  />
                </div>
              </div>

              <div class="option-grid">
                <label class="checkbox-card">
                  <input
                    id="detachedMode"
                    type="checkbox"
                    checked
                  />

                  <span>
                    <strong>Detached mode</strong>
                    <small>Run the container in the background.</small>
                  </span>
                </label>

                <label class="checkbox-card">
                  <input
                    id="removeContainer"
                    type="checkbox"
                  />

                  <span>
                    <strong>Auto remove</strong>
                    <small>Remove the container after it exits.</small>
                  </span>
                </label>

                <label class="checkbox-card">
                  <input
                    id="interactiveMode"
                    type="checkbox"
                  />

                  <span>
                    <strong>Interactive</strong>
                    <small>Keep standard input open.</small>
                  </span>
                </label>

                <label class="checkbox-card">
                  <input
                    id="allocateTty"
                    type="checkbox"
                  />

                  <span>
                    <strong>Allocate TTY</strong>
                    <small>Allocate a pseudo terminal.</small>
                  </span>
                </label>

                <label class="checkbox-card">
                  <input
                    id="privilegedMode"
                    type="checkbox"
                  />

                  <span>
                    <strong>Privileged mode</strong>
                    <small>Give extended permissions to the container.</small>
                  </span>
                </label>

                <label class="checkbox-card">
                  <input
                    id="readOnlyMode"
                    type="checkbox"
                  />

                  <span>
                    <strong>Read-only filesystem</strong>
                    <small>Mount the root filesystem as read-only.</small>
                  </span>
                </label>
              </div>

              <div class="dynamic-section">
                <div class="dynamic-heading">
                  <div>
                    <h3>Port mappings</h3>
                    <p>Map host ports to container ports.</p>
                  </div>

                  <button
                    id="addPortButton"
                    class="add-button"
                    type="button"
                  >
                    + Add port
                  </button>
                </div>

                <div id="portRows" class="dynamic-rows"></div>
              </div>

              <div class="dynamic-section">
                <div class="dynamic-heading">
                  <div>
                    <h3>Volume mappings</h3>
                    <p>
                      Mount host directories or named volumes.
                    </p>
                  </div>

                  <button
                    id="addVolumeButton"
                    class="add-button"
                    type="button"
                  >
                    + Add volume
                  </button>
                </div>

                <div id="volumeRows" class="dynamic-rows"></div>
              </div>

              <div class="dynamic-section">
                <div class="dynamic-heading">
                  <div>
                    <h3>Environment variables</h3>
                    <p>Add configuration values to the container.</p>
                  </div>

                  <button
                    id="addEnvironmentButton"
                    class="add-button"
                    type="button"
