                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="dry-run" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">Dry run</span>
                      <span class="checkbox-description">
                        Preview changes without copying files using
                        <code>--dry-run</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="delete-files" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Delete destination extras
                      </span>

                      <span class="checkbox-description">
                        Remove destination files not present in the source using
