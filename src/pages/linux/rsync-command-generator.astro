                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="recursive" type="checkbox" />

                    <span>
                      <span class="checkbox-title">Recursive</span>
                      <span class="checkbox-description">
                        Copy directories recursively using <code>-r</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="verbose" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">Verbose output</span>
                      <span class="checkbox-description">
                        Display transferred files using <code>-v</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="compress" type="checkbox" />

                    <span>
                      <span class="checkbox-title">Compress transfer</span>
                      <span class="checkbox-description">
                        Compress data during network transfer using
                        <code>-z</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="show-progress" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">Show progress</span>
                      <span class="checkbox-description">
                        Display transfer progress using
                        <code>--progress</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="human-readable" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">Human-readable sizes</span>
                      <span class="checkbox-description">
                        Display sizes using readable units with
