    </main>

    <Footer />

    <script is:inline>
      const fieldIds = [
        "source-path",
        "destination-path",
        "remote-host",
        "remote-user",
        "ssh-port",
        "identity-file",
        "jump-host",
        "jump-user",
        "exclude-patterns",
        "exclude-file",
        "include-pattern",
        "max-size",
        "min-size",
        "bandwidth-limit",
        "timeout",
        "backup-directory",
        "link-destination",
        "chmod-option",
        "chown-option",
        "extra-options",
      ];

      const checkboxIds = [
        "archive-mode",
        "recursive",
        "verbose",
        "compress",
        "show-progress",
        "human-readable",
        "dry-run",
        "delete-files",
        "partial",
        "checksum",
        "update-only",
        "ignore-existing",
        "remove-source",
        "one-filesystem",
        "use-sudo",
      ];

      const commandResult =
        document.getElementById("command-result");

      const chmodResult =
        document.getElementById("chmod-result");

      const warningBox =
        document.getElementById("warning-box");

      const copyStatus =
        document.getElementById("copy-status");

      const remoteSection =
        document.getElementById("remote-section");

      const deleteInput =
        document.getElementById("delete-files");

      const dryRunInput =
        document.getElementById("dry-run");

      const updateOnlyInput =
        document.getElementById("update-only");

      const ignoreExistingInput =
        document.getElementById("ignore-existing");

      function getValue(id) {
        return document.getElementById(id)?.value?.trim() ?? "";
      }

      function isChecked(id) {
        return Boolean(document.getElementById(id)?.checked);
      }

      function getTransferMode() {
        return (
          document.querySelector(
            'input[name="transfer-mode"]:checked'
          )?.value || "local"
        );
      }

      function shellQuote(value) {
        const text = value.trim();

        if (!text) {
          return "''";
        }

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function getRemoteTarget(path) {
        const host = getValue("remote-host") || "remote-host";
        const user = getValue("remote-user");
        const remoteAddress = user ? `${user}@${host}` : host;

        return `${remoteAddress}:${shellQuote(path)}`;
      }

      function buildSshCommand() {
        const options = ["ssh"];

        const sshPort = getValue("ssh-port");

        if (sshPort && sshPort !== "22") {
          options.push("-p", sshPort);
        }

        const identityFile = getValue("identity-file");

        if (identityFile) {
          options.push("-i", shellQuote(identityFile));
        }

        const jumpHost = getValue("jump-host");

        if (jumpHost) {
          const jumpUser = getValue("jump-user");

          const jumpTarget = jumpUser
            ? `${jumpUser}@${jumpHost}`
            : jumpHost;

          options.push("-J", jumpTarget);
        }

        return options;
      }

      function buildOptionFlags() {
        let shortFlags = "-";

        if (isChecked("archive-mode")) {
          shortFlags += "a";
        } else if (isChecked("recursive")) {
          shortFlags += "r";
        }

        if (isChecked("verbose")) {
          shortFlags += "v";
        }

        if (isChecked("compress")) {
          shortFlags += "z";
        }

        if (isChecked("human-readable")) {
          shortFlags += "h";
        }

        if (isChecked("checksum")) {
          shortFlags += "c";
        }

        if (isChecked("update-only")) {
          shortFlags += "u";
        }

        if (isChecked("one-filesystem")) {
          shortFlags += "x";
        }

        return shortFlags === "-" ? "" : shortFlags;
      }

      function getModeLabel(mode) {
        const labels = {
          local: "Local to local",
          push: "Push to remote",
          pull: "Pull from remote",
        };

        return labels[mode] || "Local to local";
      }

      function updateTransferModeUI() {
        const mode = getTransferMode();
        remoteSection.hidden = mode === "local";

        generateCommand();
      }

      function generateCommand() {
        const mode = getTransferMode();

        const sourcePath =
          getValue("source-path") || "/path/to/source/";

        const destinationPath =
          getValue("destination-path") || "/path/to/destination/";

        const parts = [];

        if (isChecked("use-sudo")) {
          parts.push("sudo");
        }

        parts.push("rsync");

        const shortFlags = buildOptionFlags();

        if (shortFlags) {
          parts.push(shortFlags);
        }

        if (mode !== "local") {
          const sshCommand = buildSshCommand();

          if (sshCommand.length > 1) {
            parts.push("-e", shellQuote(sshCommand.join(" ")));
          }
        }

        if (isChecked("show-progress")) {
          parts.push("--progress");
        }

        if (isChecked("dry-run")) {
          parts.push("--dry-run");
        }

        if (isChecked("delete-files")) {
          parts.push("--delete");
        }

        if (isChecked("partial")) {
          parts.push("--partial");
        }

        if (isChecked("ignore-existing")) {
          parts.push("--ignore-existing");
        }

        if (isChecked("remove-source")) {
          parts.push("--remove-source-files");
        }

        getValue("exclude-patterns")
          .split(/\r?\n/)
          .map((pattern) => pattern.trim())
          .filter(Boolean)
          .forEach((pattern) => {
            parts.push(`--exclude=${shellQuote(pattern)}`);
          });

        const excludeFile = getValue("exclude-file");

        if (excludeFile) {
          parts.push(`--exclude-from=${shellQuote(excludeFile)}`);
        }

        const includePattern = getValue("include-pattern");

        if (includePattern) {
          parts.push(`--include=${shellQuote(includePattern)}`);
        }

        const maxSize = getValue("max-size");

        if (maxSize) {
          parts.push(`--max-size=${maxSize}`);
        }

        const minSize = getValue("min-size");

        if (minSize) {
          parts.push(`--min-size=${minSize}`);
        }

        const bandwidthLimit = getValue("bandwidth-limit");

        if (bandwidthLimit) {
          parts.push(`--bwlimit=${bandwidthLimit}`);
        }

        const timeout = getValue("timeout");

        if (timeout) {
          parts.push(`--timeout=${timeout}`);
        }

        const backupDirectory = getValue("backup-directory");

        if (backupDirectory) {
          parts.push(
            "--backup",
            `--backup-dir=${shellQuote(backupDirectory)}`
          );
        }

        const linkDestination = getValue("link-destination");

        if (linkDestination) {
          parts.push(
            `--link-dest=${shellQuote(linkDestination)}`
          );
        }

        const chmodOption = getValue("chmod-option");

        if (chmodOption) {
          parts.push(`--chmod=${chmodOption}`);
        }

        const chownOption = getValue("chown-option");

        if (chownOption) {
          parts.push(`--chown=${chownOption}`);
        }

        getValue("extra-options")
          .split(/\r?\n/)
          .map((option) => option.trim())
          .filter(Boolean)
          .forEach((option) => {
            parts.push(option);
          });

        let source;
        let destination;

        if (mode === "push") {
          source = shellQuote(sourcePath);
          destination = getRemoteTarget(destinationPath);
        } else if (mode === "pull") {
          source = getRemoteTarget(sourcePath);
          destination = shellQuote(destinationPath);
        } else {
          source = shellQuote(sourcePath);
          destination = shellQuote(destinationPath);
        }

        parts.push(source, destination);

        commandResult.textContent = parts.join(" ");

        const identityFile = getValue("identity-file");

        chmodResult.textContent = identityFile
          ? `chmod 600 ${shellQuote(identityFile)}`
          : "chmod 600 ~/.ssh/id_rsa";

        document.getElementById(
          "summary-mode"
        ).textContent = getModeLabel(mode);

        document.getElementById(
          "summary-source"
        ).textContent =
          mode === "pull"
            ? `${getValue("remote-user") || "user"}@${
                getValue("remote-host") || "remote-host"
              }:${sourcePath}`
            : sourcePath;

        document.getElementById(
          "summary-destination"
        ).textContent =
          mode === "push"
            ? `${getValue("remote-user") || "user"}@${
                getValue("remote-host") || "remote-host"
              }:${destinationPath}`
            : destinationPath;

        document.getElementById(
          "summary-dry-run"
        ).textContent = isChecked("dry-run")
          ? "Enabled"
          : "Disabled";

        document.getElementById(
          "summary-delete"
        ).textContent = isChecked("delete-files")
          ? "Enabled"
          : "Disabled";

        if (
          isChecked("delete-files") &&
          !isChecked("dry-run")
        ) {
          warningBox.textContent =
            "Danger: --delete is enabled without --dry-run. Destination files not present in the source may be permanently removed.";

          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (
          isChecked("remove-source") &&
          !isChecked("dry-run")
        ) {
          warningBox.textContent =
            "Warning: successfully transferred source files will be removed. Confirm the source and destination paths.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else if (isChecked("dry-run")) {
          warningBox.textContent =
            "Dry-run mode is enabled. The command will preview changes without transferring or deleting files.";

          warningBox.style.borderColor = "#bbf7d0";
          warningBox.style.background = "#f0fdf4";
          warningBox.style.color = "#166534";
        } else {
          warningBox.textContent =
            "Review the source, destination and trailing slash carefully before running the command.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        }
      }

      function resetForm() {
        document.querySelector(
          'input[name="transfer-mode"][value="local"]'
        ).checked = true;

        const values = {
          "source-path": "/var/www/html/",
          "destination-path": "/backup/html/",
          "remote-host": "192.168.1.100",
          "remote-user": "linuxadmin",
          "ssh-port": "22",
          "identity-file": "",
          "jump-host": "",
          "jump-user": "",
          "exclude-patterns": "",
          "exclude-file": "",
          "include-pattern": "",
          "max-size": "",
          "min-size": "",
          "bandwidth-limit": "",
          timeout: "",
          "backup-directory": "",
          "link-destination": "",
          "chmod-option": "",
          "chown-option": "",
          "extra-options": "",
        };

        Object.entries(values).forEach(([id, value]) => {
          const element = document.getElementById(id);

          if (element) {
            element.value = value;
          }
        });

        document.getElementById("archive-mode").checked = true;
        document.getElementById("recursive").checked = false;
        document.getElementById("verbose").checked = true;
        document.getElementById("compress").checked = false;
        document.getElementById("show-progress").checked = true;
        document.getElementById("human-readable").checked = true;
        document.getElementById("dry-run").checked = true;
        document.getElementById("delete-files").checked = false;
        document.getElementById("partial").checked = false;
        document.getElementById("checksum").checked = false;
        document.getElementById("update-only").checked = false;
        document.getElementById("ignore-existing").checked = false;
        document.getElementById("remove-source").checked = false;
        document.getElementById("one-filesystem").checked = false;
        document.getElementById("use-sudo").checked = false;

        updateTransferModeUI();
      }

      function loadPreset(preset) {
        resetForm();

        if (preset === "local-backup") {
          document.getElementById("source-path").value =
            "/var/www/html/";

          document.getElementById("destination-path").value =
            "/backup/html/";
        }

        if (preset === "remote-push") {
          document.querySelector(
            'input[name="transfer-mode"][value="push"]'
          ).checked = true;

          document.getElementById("source-path").value =
            "/opt/application/";

          document.getElementById("destination-path").value =
            "/backup/application/";

          document.getElementById("compress").checked = true;
          document.getElementById("partial").checked = true;
        }

        if (preset === "remote-pull") {
          document.querySelector(
            'input[name="transfer-mode"][value="pull"]'
          ).checked = true;

          document.getElementById("source-path").value =
            "/var/log/application/";

          document.getElementById("destination-path").value =
            "/backup/remote-logs/";

          document.getElementById("compress").checked = true;
        }

        if (preset === "mirror") {
          document.getElementById("source-path").value =
            "/data/source/";

          document.getElementById("destination-path").value =
            "/data/mirror/";

          document.getElementById("delete-files").checked = true;
          document.getElementById("dry-run").checked = true;
        }

        if (preset === "incremental") {
          document.getElementById("source-path").value =
            "/data/";

          document.getElementById("destination-path").value =
            "/backup/2026-07-30/";

          document.getElementById("link-destination").value =
            "/backup/latest/";

          document.getElementById("dry-run").checked = true;
        }

        if (preset === "move-files") {
          document.getElementById("source-path").value =
            "/incoming/";

          document.getElementById("destination-path").value =
            "/processed/";

          document.getElementById("remove-source").checked = true;
          document.getElementById("dry-run").checked = true;
        }

        updateTransferModeUI();
      }

      async function copyText(text) {
        if (!text) {
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          copyStatus.textContent =
            "Command copied successfully.";
        } catch {
          copyStatus.textContent =
            "Copy failed. Please select and copy the command manually.";
        }

        window.setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      document
        .querySelectorAll('input[name="transfer-mode"]')
        .forEach((radio) => {
          radio.addEventListener(
            "change",
            updateTransferModeUI
          );
        });

      fieldIds.forEach((id) => {
        const element = document.getElementById(id);

        element?.addEventListener("input", generateCommand);
        element?.addEventListener("change", generateCommand);
      });

      checkboxIds.forEach((id) => {
        document
          .getElementById(id)
          ?.addEventListener("change", generateCommand);
      });

      updateOnlyInput.addEventListener("change", () => {
        if (updateOnlyInput.checked) {
          ignoreExistingInput.checked = false;
        }

        generateCommand();
      });

      ignoreExistingInput.addEventListener("change", () => {
        if (ignoreExistingInput.checked) {
          updateOnlyInput.checked = false;
        }

        generateCommand();
      });

      deleteInput.addEventListener("change", generateCommand);
      dryRunInput.addEventListener("change", generateCommand);

      document
        .querySelectorAll(".preset-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const preset = button.dataset.preset;

            if (preset) {
              loadPreset(preset);
            }
          });
        });

      document
        .getElementById("generate")
        ?.addEventListener("click", generateCommand);

      document
        .getElementById("reset")
        ?.addEventListener("click", resetForm);

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const targetId = button.dataset.copyTarget;

            const target = targetId
              ? document.getElementById(targetId)
              : null;

            copyText(target?.textContent?.trim() ?? "");
          });
        });

      updateTransferModeUI();
    </script>
  </body>
</html>