---
const linuxTools = [
  {
    title: "Linux chmod Calculator",
    description:
      "Convert Linux read, write, and execute permissions into numeric chmod values.",
    href: "/linux/chmod-calculator",
    icon: "🔐",
    category: "Permissions",
  },
  {
    title: "Cron Expression Generator",
    description:
      "Build Linux cron expressions for scheduled commands, scripts, and automated tasks.",
    href: "/linux/cron-generator",
    icon: "⏰",
    category: "Automation",
  },
  {
    title: "Systemd Service Generator",
    description:
      "Generate a systemd service unit file for Linux applications and background services.",
    href: "/linux/systemd-service-generator",
    icon: "⚙️",
    category: "Services",
  },
  {
    title: "Ownership Command Generator",
    description:
      "Generate chown and chgrp commands to change Linux file and directory ownership.",
    href: "/linux/ownership-command-generator",
    icon: "👤",
    category: "Permissions",
  },
  {
    title: "Permission Converter",
    description:
      "Convert symbolic Linux permissions such as rwxr-xr-x into numeric permission values.",
    href: "/linux/permission-converter",
    icon: "🔄",
    category: "Permissions",
  },
  {
    title: "File Finder Command",
    description:
      "Build Linux find commands to locate files by name, size, owner, permission, or date.",
    href: "/linux/file-finder-command",
    icon: "🔎",
    category: "Files",
  },
  {
    title: "Tar Command Generator",
    description:
      "Generate tar commands to create, extract, compress, and inspect Linux archive files.",
    href: "/linux/tar-command-generator",
    icon: "📦",
    category: "Files",
  },
  {
    title: "SSH Command Builder",
    description:
      "Create SSH commands using custom usernames, ports, keys, tunnels, and options.",
    href: "/linux/ssh-command-builder",
    icon: "🖥️",
    category: "Networking",
  },
  {
    title: "Rsync Command Generator",
    description:
      "Generate rsync commands for local and remote file synchronization and backups.",
    href: "/linux/rsync-command-generator",
    icon: "🔁",
    category: "Files",
  },
  {
    title: "Useradd Generator",
    description:
      "Build Linux useradd commands with home directory, shell, UID, groups, and expiry options.",
    href: "/linux/useradd-generator",
    icon: "➕",
    category: "Users",
  },
  {
    title: "Firewall-cmd Generator",
    description:
      "Generate firewalld commands for ports, services, zones, sources, and permanent rules.",
    href: "/linux/firewall-cmd-generator",
    icon: "🛡️",
    category: "Security",
  },
  {
    title: "Iptables Generator",
    description:
      "Build iptables rules for ports, protocols, source addresses, and traffic actions.",
    href: "/linux/iptables-generator",
    icon: "🔥",
    category: "Security",
  },
  {
    title: "OpenSSL Command Generator",
    description:
      "Generate OpenSSL commands for certificates, private keys, CSRs, and certificate checks.",
    href: "/linux/openssl-command-generator",
    icon: "🔏",
    category: "Security",
  },
  {
    title: "Sed Command Generator",
    description:
      "Build sed commands to search, replace, delete, insert, and transform Linux text files.",
    href: "/linux/sed-command-generator",
    icon: "📝",
    category: "Text Processing",
  },
];

const featuredTools = linuxTools.slice(0, 3);

const pageTitle = "Free Linux Tools and Command Generators | Gokuruvi Tools";

const pageDescription =
  "Free Linux tools for chmod permissions, cron expressions, systemd services, SSH, rsync, useradd, firewalld, iptables, OpenSSL, sed, tar, and file management.";
