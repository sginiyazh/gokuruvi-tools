    <script>
      const searchInput = document.querySelector("#toolSearch");
      const toolCards = document.querySelectorAll(".tool-card");
      const noResults = document.querySelector("#noResults");

      searchInput?.addEventListener("input", (event) => {
        const target = event.target;

        if (!(target instanceof HTMLInputElement)) {
          return;
        }

        const searchValue = target.value.toLowerCase().trim();
        let visibleTools = 0;

        toolCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) {
            return;
          }

          const toolContent = card.dataset.tool ?? "";
          const isVisible = toolContent.includes(searchValue);

          card.style.display = isVisible ? "flex" : "none";

          if (isVisible) {
            visibleTools++;
          }
        });

        if (noResults instanceof HTMLElement) {
          noResults.style.display = visibleTools === 0 ? "block" : "none";
        }
      });

      const mobileMenuButton = document.querySelector("#mobileMenuButton");
      const mainNav = document.querySelector("#mainNav");

      mobileMenuButton?.addEventListener("click", () => {
        if (!(mainNav instanceof HTMLElement)) {
          return;
        }

        const isOpen = mainNav.classList.toggle("open");

        mobileMenuButton.setAttribute(
          "aria-expanded",
          isOpen ? "true" : "false",
        );
      });
    </script>
