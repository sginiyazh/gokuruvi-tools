    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo footer-logo">
            <span class="logo-icon">G</span>

            <span class="logo-text">
              <strong>Gokuruvi</strong>
