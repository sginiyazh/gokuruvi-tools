        masquerade: document.getElementById("masquerade-section"),
        list: document.getElementById("list-section"),
        flush: document.getElementById("flush-section"),
      };

      const mainCommand =
        document.getElementById("main-command");

      const additionalCommand =
        document.getElementById("additional-command");

      const logCommand =
        document.getElementById("log-command");

      const verifyCommand =
        document.getElementById("verify-command");

      const saveRhelCommand =
        document.getElementById("save-rhel-command");

      const saveDebianCommand =
        document.getElementById("save-debian-command");

      const sysctlCommand =
        document.getElementById("sysctl-command");

      const additionalResultBlock =
        document.getElementById("additional-result-block");

      const logResultBlock =
        document.getElementById("log-result-block");

      const sysctlResultBlock =
        document.getElementById("sysctl-result-block");

      const saveResultBlock =
        document.getElementById("save-result-block");

      const saveDebianResultBlock =
        document.getElementById("save-debian-result-block");

      const positionField =
        document.getElementById("position-field");

      const logPrefixSection =
        document.getElementById("log-prefix-section");

      const warningBox =
        document.getElementById("warning-box");

      const copyStatus =
        document.getElementById("copy-status");

      function getValue(id) {
        return document.getElementById(id)?.value?.trim() ?? "";
      }

      function isChecked(id) {
        return Boolean(document.getElementById(id)?.checked);
      }

      function getRuleType() {
        return (
          document.querySelector(
            'input[name="rule-type"]:checked'
          )?.value || "port"
        );
      }

      function shellQuote(value) {
        const text = String(value).trim();

        if (!text) {
          return "''";
        }

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function binary() {
        return getValue("ip-version") === "ipv6"
          ? "ip6tables"
          : "iptables";
      }

      function prefix() {
        return isChecked("use-sudo")
          ? `sudo ${binary()}`
          : binary();
      }

      function getOperationFlag() {
        const operation = getValue("rule-operation");

        if (operation === "insert") {
          return "-I";
        }

        if (operation === "delete") {
          return "-D";
        }

        return "-A";
      }

      function buildRuleStart(
        tableOverride = "",
        chainOverride = ""
      ) {
        const table = tableOverride || getValue("table") || "filter";
        const chain = chainOverride || getValue("chain") || "INPUT";
        const operation = getOperationFlag();

        const parts = [
          prefix(),
          "-t",
          table,
          operation,
          chain,
        ];

        if (
          operation === "-I" &&
          getValue("rule-position")
        ) {
          parts.push(getValue("rule-position"));
        }

        return parts;
      }

      function addInterface(parts, chain) {
        const iface = getValue("interface");

        if (!iface) {
          return;
        }

        if (chain === "OUTPUT") {
          parts.push("-o", iface);
        } else {
          parts.push("-i", iface);
        }
      }

      function buildPortRule(targetOverride = "") {
        const chain = getValue("chain") || "INPUT";
        const protocol = getValue("protocol") || "tcp";
        const port = getValue("port") || "22";
        const direction = getValue("port-direction");
        const source = getValue("port-source");
        const target =
          targetOverride || getValue("target") || "ACCEPT";

        const parts = buildRuleStart();

        addInterface(parts, chain);

        if (source) {
          parts.push("-s", source);
        }

        parts.push("-p", protocol);

        parts.push(
          direction === "source" ? "--sport" : "--dport",
          port
        );

        parts.push("-j", target);

        return parts.join(" ");
      }

      function buildSourceRule(targetOverride = "") {
        const source =
          getValue("source-address") || "192.168.1.100";

        const protocol = getValue("source-protocol");
        const port = getValue("source-port");

        const target =
          targetOverride || getValue("target") || "ACCEPT";

        const parts = buildRuleStart();

        parts.push("-s", source);

        if (protocol) {
          parts.push("-p", protocol);
        }

        if (
          port &&
          ["tcp", "udp"].includes(protocol)
        ) {
          parts.push("--dport", port);
        }

        parts.push("-j", target);

        return parts.join(" ");
      }

      function buildEstablishedRule() {
        const parts = buildRuleStart();

        parts.push(
          "-m",
          "conntrack",
          "--ctstate",
          "ESTABLISHED,RELATED",
          "-j",
          getValue("target") || "ACCEPT"
        );

        return parts.join(" ");
      }

      function buildLoopbackRule() {
        const chain = getValue("chain") || "INPUT";
        const parts = buildRuleStart();

        parts.push(
          chain === "OUTPUT" ? "-o" : "-i",
          "lo",
          "-j",
          getValue("target") || "ACCEPT"
        );

        return parts.join(" ");
      }

      function buildIcmpRule(targetOverride = "") {
        const parts = buildRuleStart();
        const source = getValue("icmp-source");

        parts.push(
          "-p",
          getValue("ip-version") === "ipv6"
            ? "ipv6-icmp"
            : "icmp"
        );

        if (source) {
          parts.push("-s", source);
        }

        parts.push(
          getValue("ip-version") === "ipv6"
            ? "--icmpv6-type"
            : "--icmp-type",
          getValue("icmp-type") || "echo-request"
        );

        parts.push(
          "-j",
          targetOverride || getValue("target") || "ACCEPT"
        );

        return parts.join(" ");
      }

      function buildPortForwardCommands() {
        const protocol =
          getValue("forward-protocol") || "tcp";

        const inputInterface =
          getValue("incoming-interface");

        const incomingPort =
          getValue("listen-port") || "8080";

        const destinationIp =
          getValue("destination-ip") || "192.168.1.20";

        const destinationPort =
          getValue("destination-port") || "80";

        const source =
          getValue("forward-source");

        const dnatParts = [
          prefix(),
          "-t",
          "nat",
          "-A",
          "PREROUTING",
        ];

        if (inputInterface) {
          dnatParts.push("-i", inputInterface);
        }

        if (source) {
          dnatParts.push("-s", source);
        }

        dnatParts.push(
          "-p",
          protocol,
          "--dport",
          incomingPort,
          "-j",
          "DNAT",
          "--to-destination",
          `${destinationIp}:${destinationPort}`
        );

        const forwardParts = [
          prefix(),
          "-t",
          "filter",
          "-A",
          "FORWARD",
        ];

        if (source) {
          forwardParts.push("-s", source);
        }

        forwardParts.push(
          "-p",
          protocol,
          "-d",
          destinationIp,
          "--dport",
          destinationPort,
          "-m",
          "conntrack",
          "--ctstate",
          "NEW,ESTABLISHED,RELATED",
          "-j",
          "ACCEPT"
        );

        return {
          main: dnatParts.join(" "),
          additional: forwardParts.join(" "),
        };
      }

      function buildMasqueradeRule() {
        const parts = [
          prefix(),
          "-t",
          "nat",
          "-A",
          "POSTROUTING",
        ];

        const source =
          getValue("masquerade-source");

        const outputInterface =
          getValue("outgoing-interface");

        if (source) {
          parts.push("-s", source);
        }

        if (outputInterface) {
          parts.push("-o", outputInterface);
        }

        parts.push("-j", "MASQUERADE");

        return parts.join(" ");
      }

      function buildListCommand() {
        const parts = [
          prefix(),
          "-t",
          getValue("table") || "filter",
          "-L",
        ];

        const chain = getValue("chain");

        if (chain) {
          parts.push(chain);
        }

        if (isChecked("list-numeric")) {
          parts.push("-n");
        }

        if (isChecked("list-verbose")) {
          parts.push("-v");
        }

        if (isChecked("list-line-numbers")) {
          parts.push("--line-numbers");
        }

        return parts.join(" ");
      }

      function buildFlushCommand() {
        const parts = [
          prefix(),
          "-t",
          getValue("table") || "filter",
          "-F",
        ];

        const flushChain = getValue("flush-chain");

        if (flushChain) {
          parts.push(flushChain);
        }

        return parts.join(" ");
      }

      function buildLogRule(type) {
        let rule = "";

        if (type === "port") {
          rule = buildPortRule("LOG");
        }

        if (type === "source") {
          rule = buildSourceRule("LOG");
        }

        if (type === "icmp") {
          rule = buildIcmpRule("LOG");
        }

        if (!rule) {
          return "";
        }

        const prefixValue =
          getValue("log-prefix") || "IPTABLES-DROPPED: ";

        return `${rule} --log-prefix ${shellQuote(prefixValue)} --log-level 4`;
      }

      function getRuleTypeLabel(type) {
        const labels = {
          port: "Port rule",
          source: "Source IP rule",
          established: "Established traffic",
          loopback: "Loopback rule",
          icmp: "ICMP rule",
          "port-forward": "Port forwarding",
          masquerade: "NAT masquerade",
          list: "List rules",
          flush: "Flush rules",
        };

        return labels[type] || "Port rule";
      }

      function generateCommands() {
        const type = getRuleType();
        const table = getValue("table") || "filter";
        const chain = getValue("chain") || "INPUT";
        const target = getValue("target") || "ACCEPT";

        positionField.hidden =
          getValue("rule-operation") !== "insert";

        logPrefixSection.hidden =
          !isChecked("enable-log");

        logResultBlock.hidden = true;
        additionalResultBlock.hidden = true;
        sysctlResultBlock.hidden = true;

        if (type === "port") {
          mainCommand.textContent = buildPortRule();
        }

        if (type === "source") {
          mainCommand.textContent = buildSourceRule();
        }

        if (type === "established") {
          mainCommand.textContent =
            buildEstablishedRule();
        }

        if (type === "loopback") {
          mainCommand.textContent =
            buildLoopbackRule();
        }

        if (type === "icmp") {
          mainCommand.textContent =
            buildIcmpRule();
        }

        if (type === "port-forward") {
          const commands =
            buildPortForwardCommands();

          mainCommand.textContent = commands.main;

          additionalCommand.textContent =
            commands.additional;

          additionalResultBlock.hidden = false;
          sysctlResultBlock.hidden = false;
        }

        if (type === "masquerade") {
          mainCommand.textContent =
            buildMasqueradeRule();

          sysctlResultBlock.hidden = false;
        }

        if (type === "list") {
          mainCommand.textContent =
            buildListCommand();
        }

        if (type === "flush") {
          mainCommand.textContent =
            buildFlushCommand();
        }

        if (
          isChecked("enable-log") &&
          ["port", "source", "icmp"].includes(type) &&
          ["DROP", "REJECT"].includes(target)
        ) {
          const command = buildLogRule(type);

          if (command) {
            logCommand.textContent = command;
            logResultBlock.hidden = false;
          }
        }

        const saveEnabled =
          isChecked("generate-save") &&
          !["list"].includes(type);

        saveResultBlock.hidden = !saveEnabled;
        saveDebianResultBlock.hidden = !saveEnabled;

        const sudoPrefix =
          isChecked("use-sudo") ? "sudo " : "";

        const currentBinary = binary();

        saveRhelCommand.textContent =
          `${sudoPrefix}${currentBinary}-save | ${sudoPrefix}tee /etc/sysconfig/${currentBinary}`;

        saveDebianCommand.textContent =
          `${sudoPrefix}netfilter-persistent save`;

        sysctlCommand.textContent =
          `${sudoPrefix}sysctl -w net.ipv4.ip_forward=1`;

        verifyCommand.textContent =
          `${prefix()} -t ${
            type === "port-forward" ||
            type === "masquerade"
              ? "nat"
              : table
          } -L -n -v --line-numbers`;

        document.getElementById(
          "summary-type"
        ).textContent = getRuleTypeLabel(type);

        document.getElementById(
          "summary-table"
        ).textContent =
          type === "port-forward" ||
          type === "masquerade"
            ? "nat"
            : table;

        document.getElementById(
          "summary-chain"
        ).textContent =
          type === "port-forward"
            ? "PREROUTING / FORWARD"
            : type === "masquerade"
              ? "POSTROUTING"
              : type === "flush"
                ? getValue("flush-chain") || "All chains"
                : chain;

        document.getElementById(
          "summary-target"
        ).textContent =
          ["list", "flush"].includes(type)
            ? "Not applicable"
            : type === "port-forward"
              ? "DNAT / ACCEPT"
              : type === "masquerade"
                ? "MASQUERADE"
                : target;

        document.getElementById(
          "summary-ip-version"
        ).textContent =
          getValue("ip-version") === "ipv6"
            ? "IPv6"
            : "IPv4";

        updateWarning(type);
      }

      function updateWarning(type) {
        const target = getValue("target");
        const port = getValue("port");
        const operation = getValue("rule-operation");

        if (
          type === "flush"
        ) {
          warningBox.textContent =
            "Danger: flushing rules may remove remote access and expose services. Back up the current rules first.";

          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (
          type === "port" &&
          port === "22" &&
          (
            target === "DROP" ||
            target === "REJECT" ||
            operation === "delete"
          )
        ) {
          warningBox.textContent =
            "Danger: this SSH rule may disconnect your remote session. Keep another active session or console access available.";

          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (
          type === "port-forward" ||
          type === "masquerade"
        ) {
          warningBox.textContent =
            "IP forwarding must be enabled. Verify routing, interfaces and NAT requirements before applying these rules.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else if (type === "list") {
          warningBox.textContent =
            "This command only displays the current rules and does not modify the firewall.";

          warningBox.style.borderColor = "#bbf7d0";
          warningBox.style.background = "#f0fdf4";
          warningBox.style.color = "#166534";
        } else {
          warningBox.textContent =
            "Keep an active SSH session while changing remote firewall rules and save the configuration after validation.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        }
      }

      function updateRuleTypeUI() {
        const type = getRuleType();

        Object.entries(sections).forEach(
          ([name, section]) => {
            section.hidden = name !== type;
          }
        );

        const normalRule =
          !["list", "flush", "port-forward", "masquerade"].includes(type);

        document.getElementById(
          "rule-operation-field"
        ).hidden = !normalRule;

        document.getElementById(
          "target-field"
        ).hidden = !normalRule;

        document.getElementById(
          "chain-field"
        ).hidden =
          ["port-forward", "masquerade"].includes(type);

        document.getElementById(
          "log-option"
        ).hidden =
          !["port", "source", "icmp"].includes(type);

        generateCommands();
      }

      function resetForm() {
        document.querySelector(
          'input[name="rule-type"][value="port"]'
        ).checked = true;

        const values = {
          table: "filter",
          chain: "INPUT",
          "rule-operation": "append",
          "rule-position": "1",
          target: "ACCEPT",
          "ip-version": "ipv4",
          protocol: "tcp",
          "port-direction": "destination",
          port: "22",
          interface: "",
          "port-source": "",
          "source-address": "192.168.1.100",
          "source-protocol": "",
          "source-port": "",
          "icmp-type": "echo-request",
          "icmp-source": "",
          "forward-protocol": "tcp",
          "incoming-interface": "eth0",
          "listen-port": "8080",
          "destination-ip": "192.168.1.20",
          "destination-port": "80",
          "forward-source": "",
          "outgoing-interface": "eth0",
          "masquerade-source": "",
          "flush-chain": "",
          "log-prefix": "IPTABLES-DROPPED: ",
        };

        Object.entries(values).forEach(
          ([id, value]) => {
            const element =
              document.getElementById(id);

            if (element) {
              element.value = value;
            }
          }
        );

        document.getElementById(
          "use-sudo"
        ).checked = true;

        document.getElementById(
          "enable-log"
        ).checked = false;

        document.getElementById(
          "generate-save"
        ).checked = true;

        document.getElementById(
          "list-numeric"
        ).checked = true;

        document.getElementById(
          "list-line-numbers"
        ).checked = true;

        document.getElementById(
          "list-verbose"
        ).checked = true;

        updateRuleTypeUI();
      }

      function selectRuleType(type) {
        const radio = document.querySelector(
          `input[name="rule-type"][value="${type}"]`
        );

        if (radio) {
          radio.checked = true;
        }
      }

      function loadPreset(preset) {
        resetForm();

        if (preset === "ssh") {
          selectRuleType("port");
          document.getElementById("port").value = "22";
          document.getElementById("protocol").value = "tcp";
          document.getElementById("target").value = "ACCEPT";
        }

        if (preset === "http") {
          selectRuleType("port");
          document.getElementById("port").value = "80";
          document.getElementById("protocol").value = "tcp";
          document.getElementById("target").value = "ACCEPT";
        }

        if (preset === "https") {
          selectRuleType("port");
          document.getElementById("port").value = "443";
          document.getElementById("protocol").value = "tcp";
          document.getElementById("target").value = "ACCEPT";
        }

        if (preset === "block-ip") {
          selectRuleType("source");
          document.getElementById(
            "source-address"
          ).value = "192.168.1.100";

          document.getElementById(
            "target"
          ).value = "DROP";

          document.getElementById(
            "enable-log"
          ).checked = true;
        }

        if (preset === "established") {
          selectRuleType("established");
          document.getElementById("target").value = "ACCEPT";
        }

        if (preset === "loopback") {
          selectRuleType("loopback");
          document.getElementById("target").value = "ACCEPT";
        }

        if (preset === "ping") {
          selectRuleType("icmp");
          document.getElementById(
            "icmp-type"
          ).value = "echo-request";

          document.getElementById(
            "target"
          ).value = "ACCEPT";
        }

        if (preset === "list") {
          selectRuleType("list");
        }

        updateRuleTypeUI();
      }

      function getAllCommands() {
        const commands = [];

        if (!logResultBlock.hidden) {
          commands.push(
            logCommand.textContent.trim()
          );
        }

        commands.push(
          mainCommand.textContent.trim()
        );

        if (!additionalResultBlock.hidden) {
          commands.push(
            additionalCommand.textContent.trim()
          );
        }

        if (!sysctlResultBlock.hidden) {
          commands.push(
            sysctlCommand.textContent.trim()
          );
        }

        if (!saveResultBlock.hidden) {
          commands.push(
            saveRhelCommand.textContent.trim()
          );
        }

        commands.push(
          verifyCommand.textContent.trim()
        );

        return [
          ...new Set(commands.filter(Boolean)),
        ].join("\n");
      }

      async function copyText(text, message) {
        if (!text) {
          return;
        }

        try {
          await navigator.clipboard.writeText(text);

          copyStatus.textContent =
            message || "Command copied successfully.";
        } catch {
          copyStatus.textContent =
            "Copy failed. Please select and copy the command manually.";
        }

        window.setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      document
        .querySelectorAll('input[name="rule-type"]')
        .forEach((radio) => {
          radio.addEventListener(
            "change",
            updateRuleTypeUI
          );
        });

      fieldIds.forEach((id) => {
        const element =
          document.getElementById(id);

        element?.addEventListener(
          "input",
          generateCommands
        );

        element?.addEventListener(
          "change",
          generateCommands
        );
      });

      checkboxIds.forEach((id) => {
        document
          .getElementById(id)
          ?.addEventListener(
            "change",
            generateCommands
          );
      });

      document
        .querySelectorAll(".preset-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const preset = button.dataset.preset;

            if (preset) {
              loadPreset(preset);
            }
          });
        });

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const targetId =
              button.dataset.copyTarget;

            const target = targetId
              ? document.getElementById(targetId)
              : null;

            copyText(
              target?.textContent?.trim() ?? "",
              "Command copied successfully."
            );
          });
        });

      document
        .getElementById("copy-all")
        ?.addEventListener("click", () => {
          copyText(
            getAllCommands(),
            "All commands copied successfully."
          );
        });

      document
        .getElementById("generate")
        ?.addEventListener(
          "click",
          generateCommands
        );

      document
        .getElementById("reset")
        ?.addEventListener(
          "click",
          resetForm
        );

      updateRuleTypeUI();
    </script>
  </body>
</html>