---
const pageTitle = "Iptables Command Generator | Gokuruvi Tools";
const pageDescription =
  "Generate common Linux iptables commands for ports, IP addresses, protocols, NAT, port forwarding, INPUT, OUTPUT and FORWARD chains.";
const siteUrl =
  "https://www.gokuruvi.com/linux/iptables-generator";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />

    <meta
      name="keywords"
      content="iptables generator, iptables command generator, Linux firewall command, iptables port forwarding, iptables NAT"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta
      property="og:image"
      content="https://www.gokuruvi.com/og-image.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --secondary: #38bdf8;
        --dark: #0f172a;
        --text: #172033;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --maximum-width: 1180px;

        font-family: Inter, Arial, Helvetica, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      button,
      input,
      select {
        font: inherit;
      }

      a {
        color: inherit;
      }

      code,
      pre {
        font-family: Consolas, "Courier New", monospace;
      }

      [hidden] {
        display: none !important;
      }

      .container {
        width: min(100% - 40px, var(--maximum-width));
        margin-inline: auto;
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 9999;
        padding: 10px 16px;
        border-radius: 8px;
        background: #ffffff;
        color: var(--dark);
        font-weight: 800;
        text-decoration: none;
        transform: translateY(-160%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.4);
        outline-offset: 3px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.97);
        backdrop-filter: blur(12px);
      }

      .navbar {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 21px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
      }

      .logo-icon {
        display: grid;
        width: 39px;
        height: 39px;
        place-items: center;
        border-radius: 10px;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );
        color: #ffffff;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-links a {
        color: #e2e8f0;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: #ffffff;
      }

      .nav-button {
        padding: 10px 18px;
        border-radius: 9px;
        background: var(--primary);
        color: #ffffff !important;
      }

      .breadcrumb-section {
        border-bottom: 1px solid var(--border);
        background: #ffffff;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        padding: 15px 0;
        color: var(--muted);
        font-size: 14px;
      }

      .breadcrumb a {
        color: var(--primary);
        font-weight: 700;
        text-decoration: none;
      }

      .hero {
        padding: 72px 0 65px;
        background:
          radial-gradient(
            circle at 15% 15%,
            rgba(56, 189, 248, 0.18),
            transparent 31%
          ),
          radial-gradient(
            circle at 88% 35%,
            rgba(37, 99, 235, 0.17),
            transparent 34%
          ),
          linear-gradient(
            145deg,
            #f8fafc 0%,
            #eff6ff 50%,
            #f8fafc 100%
          );
      }

      .hero-content {
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
      }

      .hero-icon {
        display: grid;
        width: 72px;
        height: 72px;
        place-items: center;
        margin: 0 auto 20px;
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.9);
        font-size: 36px;
      }

      .hero h1 {
        margin: 0 0 18px;
        color: var(--dark);
        font-size: clamp(40px, 7vw, 62px);
        line-height: 1.08;
        letter-spacing: -2px;
      }

      .hero h1 span {
        background: linear-gradient(
          90deg,
          var(--primary),
          #0284c7
        );
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }

      .hero p {
        max-width: 780px;
        margin: 0 auto;
        color: #475569;
        font-size: 19px;
        line-height: 1.8;
      }

      .generator-section {
        padding: 75px 0;
      }

      .generator-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.85fr);
        gap: 28px;
        align-items: start;
      }

      .generator-card,
      .result-card,
      .info-card {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--card);
        box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
      }

      .generator-card {
        padding: 30px;
      }

      .generator-heading {
        margin-bottom: 28px;
      }

      .generator-heading h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 27px;
      }

      .generator-heading p {
        margin: 0;
        color: var(--muted);
      }

      .form-section {
        margin-bottom: 30px;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--border);
      }

      .form-section:last-of-type {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: 0;
      }

      .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: var(--dark);
        font-size: 19px;
      }

      .section-number {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 8px;
        background: #eff6ff;
        color: var(--primary-dark);
        font-size: 13px;
        font-weight: 800;
      }

      .action-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .action-card {
        position: relative;
        cursor: pointer;
      }

      .action-card input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .action-content {
        display: block;
        min-height: 116px;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #ffffff;
        text-align: center;
      }

      .action-card input:checked + .action-content {
        border-color: var(--primary);
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
      }

      .action-icon {
        display: block;
        margin-bottom: 8px;
        font-size: 25px;
      }

      .action-title {
        display: block;
        color: var(--dark);
        font-weight: 800;
      }

      .action-description {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 12px;
      }

      .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .form-field {
        min-width: 0;
      }

      .form-field.full-width {
        grid-column: 1 / -1;
      }

      .field-label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .field-input,
      .field-select {
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        background: #ffffff;
        color: var(--dark);
      }

      .field-input:focus,
      .field-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      }

      .field-help {
        display: block;
        margin-top: 7px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f8fafc;
      }

      .checkbox-item input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: var(--primary);
      }

      .checkbox-title {
        display: block;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .checkbox-description {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
      }

      .preset-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .preset-button {
        min-height: 41px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
      }

      .preset-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 28px;
      }

      .main-button {
        min-height: 46px;
        padding: 0 19px;
        border-radius: 10px;
        font-weight: 800;
        cursor: pointer;
      }

      .primary-button {
        border: 0;
        background: var(--primary);
        color: #ffffff;
      }

      .primary-button:hover {
        background: var(--primary-dark);
      }

      .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .secondary-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .results-column {
        position: sticky;
        top: 95px;
        display: grid;
        gap: 20px;
      }

      .result-card {
        padding: 26px;
      }

      .result-card h2 {
        margin: 0 0 20px;
        color: var(--dark);
        font-size: 23px;
      }

      .result-block + .result-block {
        margin-top: 20px;
      }

      .result-label {
        display: block;
        margin-bottom: 7px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .result-output {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        min-height: 82px;
        padding: 15px;
        border: 1px solid #334155;
        border-radius: 11px;
        background: #0b1220;
      }

      .result-value {
        overflow-wrap: anywhere;
        color: #dbeafe;
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 700;
        white-space: pre-wrap;
      }

      .copy-button {
        flex: 0 0 auto;
        padding: 7px 11px;
        border: 1px solid #475569;
        border-radius: 8px;
        background: #1e293b;
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
      }

      .copy-button:hover {
        background: #334155;
      }

      .copy-all-button {
        width: 100%;
        min-height: 45px;
        margin-top: 16px;
        border: 0;
        border-radius: 10px;
        background: var(--primary);
        color: #ffffff;
        font-weight: 800;
        cursor: pointer;
      }

      .warning-box {
        margin-top: 16px;
        padding: 14px;
        border: 1px solid #fde68a;
        border-radius: 11px;
        background: #fffbeb;
        color: #92400e;
        font-size: 14px;
      }

      .status-message {
        min-height: 22px;
        margin-top: 12px;
        color: var(--success);
        font-size: 14px;
        font-weight: 700;
      }

      .summary-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .summary-list li {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: var(--muted);
        font-size: 14px;
      }

      .summary-list strong {
        color: var(--dark);
        text-align: right;
      }

      .info-section {
        padding: 0 0 85px;
      }

      .section-heading {
        max-width: 760px;
        margin: 0 auto 45px;
        text-align: center;
      }

      .section-heading h2 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(30px, 4vw, 42px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 18px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .info-card {
        padding: 27px;
      }

      .info-card h3 {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 20px;
      }

      .info-card p,
      .info-card li {
        color: var(--muted);
        line-height: 1.75;
      }

      .info-card ul {
        margin: 12px 0 0;
        padding-left: 20px;
      }

      footer {
        background: var(--dark);
        color: #cbd5e1;
      }

      .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 28px 0;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      @media (max-width: 980px) {
        .generator-layout {
          grid-template-columns: 1fr;
        }

        .results-column {
          position: static;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .navbar {
          min-height: auto;
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .nav-links {
          width: 100%;
          flex-wrap: wrap;
          gap: 15px 20px;
        }
      }

      @media (max-width: 760px) {
        .action-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 680px) {
        .container {
          width: min(100% - 28px, var(--maximum-width));
        }

        .hero {
          padding: 58px 0 52px;
        }

        .hero h1 {
          font-size: 39px;
          letter-spacing: -1.3px;
        }

        .generator-card,
        .result-card {
          padding: 22px;
        }

        .field-grid,
        .checkbox-grid,
        .action-grid {
          grid-template-columns: 1fr;
        }

        .button-row {
          flex-direction: column;
        }

        .main-button {
          width: 100%;
        }

        .result-output {
          flex-direction: column;
        }

        .summary-list li {
          flex-direction: column;
          gap: 3px;
        }

        .summary-list strong {
          text-align: left;
        }

        .footer-content {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <header class="site-header">
      <div class="container">
        <nav class="navbar" aria-label="Main navigation">
          <a class="logo" href="/">
            <span class="logo-icon" aria-hidden="true">G</span>
            <span>Gokuruvi Tools</span>
          </a>

          <div class="nav-links">
            <a href="/">Home</a>
            <a class="active" href="/linux">Linux</a>
            <a href="/devops">DevOps</a>
            <a href="/kubernetes">Kubernetes</a>
            <a href="/network">Network</a>
            <a href="/cloud">Cloud</a>
            <a class="nav-button" href="/linux">Linux Tools</a>
          </div>
        </nav>
      </div>
    </header>

    <div class="breadcrumb-section">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/linux">Linux Tools</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Iptables Generator</span>
        </nav>
      </div>
    </div>

    <main id="main-content">
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-icon" aria-hidden="true">🧱</div>

            <h1>
              Iptables Command <span>Generator</span>
            </h1>

            <p>
              Generate common Linux <code>iptables</code> commands for ports,
              source addresses, firewall chains, NAT, masquerading and port
              forwarding.
            </p>
          </div>
        </div>
      </section>

      <section class="generator-section">
        <div class="container">
          <div class="generator-layout">
            <div class="generator-card">
              <div class="generator-heading">
                <h2>Configure your iptables rule</h2>

                <p>
                  Select a rule type, configure the traffic conditions and copy
                  the generated commands.
                </p>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">1</span>
                  Rule type
                </h3>

                <div class="action-grid">
                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="port"
                      checked
                    />

                    <span class="action-content">
                      <span class="action-icon">🔌</span>
                      <span class="action-title">Port rule</span>
                      <span class="action-description">
                        Allow or block a TCP or UDP port.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="source"
                    />

                    <span class="action-content">
                      <span class="action-icon">🌐</span>
                      <span class="action-title">Source IP</span>
                      <span class="action-description">
                        Allow or block an IP address or subnet.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="established"
                    />

                    <span class="action-content">
                      <span class="action-icon">🔗</span>
                      <span class="action-title">Established</span>
                      <span class="action-description">
                        Allow established and related traffic.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="loopback"
                    />

                    <span class="action-content">
                      <span class="action-icon">🔄</span>
                      <span class="action-title">Loopback</span>
                      <span class="action-description">
                        Allow localhost interface traffic.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="icmp"
                    />

                    <span class="action-content">
                      <span class="action-icon">📡</span>
                      <span class="action-title">ICMP ping</span>
                      <span class="action-description">
                        Allow or block incoming ping requests.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="port-forward"
                    />

                    <span class="action-content">
                      <span class="action-icon">➡️</span>
                      <span class="action-title">Port forward</span>
                      <span class="action-description">
                        Forward traffic to another IP and port.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="masquerade"
                    />

                    <span class="action-content">
                      <span class="action-icon">🔁</span>
                      <span class="action-title">Masquerade</span>
                      <span class="action-description">
                        Configure source NAT for outgoing traffic.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="list"
                    />

                    <span class="action-content">
                      <span class="action-icon">📋</span>
                      <span class="action-title">List rules</span>
                      <span class="action-description">
                        Display current iptables rules.
                      </span>
                    </span>
                  </label>

                  <label class="action-card">
                    <input
                      type="radio"
                      name="rule-type"
                      value="flush"
                    />

                    <span class="action-content">
                      <span class="action-icon">🗑️</span>
                      <span class="action-title">Flush rules</span>
                      <span class="action-description">
                        Remove rules from a selected table.
                      </span>
