    <script is:inline>
      const taskSections = {
        replace: document.getElementById("replace-section"),
        pattern: document.getElementById("pattern-section"),
        custom: document.getElementById("custom-section"),
      };

      const mainCommand =
        document.getElementById("main-command");

      const previewCommand =
        document.getElementById("preview-command");

      const previewBlock =
        document.getElementById("preview-block");

      const copyStatus =
        document.getElementById("copy-status");

      const warningBox =
        document.getElementById("warning-box");

      function getValue(id) {
        return document.getElementById(id)?.value?.trim() ?? "";
      }

      function isChecked(id) {
        return Boolean(document.getElementById(id)?.checked);
      }

      function getTask() {
        return (
          document.querySelector(
            'input[name="sed-task"]:checked'
          )?.value || "replace"
        );
      }

      function shellQuote(value) {
        const text = String(value);

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function escapeSedValue(value, delimiter) {
        return String(value)
          .replaceAll("\\", "\\\\")
          .replaceAll(delimiter, `\\${delimiter}`)
          .replaceAll("&", "\\&");
      }

      function escapeSedPattern(value, delimiter) {
        return String(value)
          .replaceAll("\\", "\\\\")
          .replaceAll(delimiter, `\\${delimiter}`);
      }

      function getAddressPrefix() {
        const scope = getValue("line-scope");

        if (scope === "line") {
          return getValue("line-number") || "1";
        }

        if (scope === "range") {
          const start = getValue("start-line") || "1";
          const end = getValue("end-line") || start;

          return `${start},${end}`;
        }

        if (scope === "matching") {
          const delimiter = getValue("delimiter") || "/";
          const pattern =
            escapeSedPattern(
              getValue("match-pattern") || "pattern",
              delimiter
            );

          return `${delimiter}${pattern}${delimiter}`;
        }

        return "";
      }

      function buildExpression() {
        const task = getTask();
        const delimiter = getValue("delimiter") || "/";
        const address = getAddressPrefix();

        if (task === "replace") {
          const search = escapeSedPattern(
            getValue("search-text") || "old_value",
            delimiter
          );

          const replacement = escapeSedValue(
            getValue("replacement-text") || "new_value",
            delimiter
          );

          let flags = "";

          if (isChecked("replace-global")) {
            flags += "g";
          }

          if (isChecked("ignore-case")) {
            flags += "I";
          }

          return `${address}s${delimiter}${search}${delimiter}${replacement}${delimiter}${flags}`;
        }

        if (task === "delete") {
          const pattern =
            getValue("match-pattern") || "pattern";

          if (getValue("line-scope") === "all") {
            return `${delimiter}${escapeSedPattern(
              pattern,
              delimiter
            )}${delimiter}d`;
          }

          return `${address}d`;
        }

        if (task === "print") {
          const pattern =
            getValue("match-pattern") || "pattern";

          if (getValue("line-scope") === "all") {
            return `${delimiter}${escapeSedPattern(
              pattern,
              delimiter
            )}${delimiter}p`;
          }

          return `${address}p`;
        }

        if (task === "insert-before") {
          const pattern =
            getValue("match-pattern") || "pattern";

          const text =
            getValue("insert-text") || "Inserted text";

          const target =
            address ||
            `${delimiter}${escapeSedPattern(
              pattern,
              delimiter
            )}${delimiter}`;

          return `${target}i\\${text}`;
        }

        if (task === "append-after") {
          const pattern =
            getValue("match-pattern") || "pattern";

          const text =
            getValue("insert-text") || "Appended text";

          const target =
            address ||
            `${delimiter}${escapeSedPattern(
              pattern,
              delimiter
            )}${delimiter}`;

          return `${target}a\\${text}`;
        }

        if (task === "replace-line") {
          const pattern =
            getValue("match-pattern") || "pattern";

          const text =
            getValue("insert-text") || "Replacement line";

          const target =
            address ||
            `${delimiter}${escapeSedPattern(
              pattern,
              delimiter
            )}${delimiter}`;

          return `${target}c\\${text}`;
        }

        if (task === "remove-blank") {
          return "/^[[:space:]]*$/d";
        }

        if (task === "remove-comments") {
          return "/^[[:space:]]*#/d";
        }

        if (task === "custom") {
          return getValue("custom-expression") || "s/old/new/g";
        }

        return "s/old/new/g";
      }

      function buildSedCommand(inPlaceMode) {
        const file =
          getValue("file-path") || "/etc/example.conf";

        const expression = buildExpression();

        const parts = [];

        if (isChecked("use-sudo") && inPlaceMode) {
          parts.push("sudo");
        }

        parts.push("sed");

        if (
          getTask() === "print" &&
          !inPlaceMode
        ) {
          parts.push("-n");
        }

        if (isChecked("extended-regex")) {
          parts.push("-E");
        }

        if (inPlaceMode) {
          if (isChecked("create-backup")) {
            const extension =
              getValue("backup-extension") || ".bak";

            parts.push(`-i${extension}`);
          } else {
            parts.push("-i");
          }
        }

        parts.push(shellQuote(expression));
        parts.push(shellQuote(file));

        return parts.join(" ");
      }

      function buildRecursiveCommand(inPlaceMode) {
        const directory =
          getValue("search-directory") || ".";

        const pattern =
          getValue("file-pattern") || "*.conf";

        const expression = buildExpression();

        const command = [];

        if (isChecked("use-sudo") && inPlaceMode) {
          command.push("sudo");
        }

        command.push(
          "find",
          shellQuote(directory),
          "-type",
          "f",
          "-name",
          shellQuote(pattern),
          "-exec",
          "sed"
        );

        if (
          getTask() === "print" &&
          !inPlaceMode
        ) {
          command.push("-n");
        }

        if (isChecked("extended-regex")) {
          command.push("-E");
        }

        if (inPlaceMode) {
          if (isChecked("create-backup")) {
            const extension =
              getValue("backup-extension") || ".bak";

            command.push(`-i${extension}`);
          } else {
            command.push("-i");
          }
        }

        command.push(shellQuote(expression), "{}", "+");

        return command.join(" ");
      }

      function generateCommands() {
        const inPlace = isChecked("in-place");
        const recursive = isChecked("recursive-mode");

        document.getElementById(
          "backup-section"
        ).hidden =
          !isChecked("create-backup");

        document.getElementById(
          "recursive-section"
        ).hidden = !recursive;

        const main = recursive
          ? buildRecursiveCommand(inPlace)
          : buildSedCommand(inPlace);

        const preview = recursive
          ? buildRecursiveCommand(false)
          : buildSedCommand(false);

        mainCommand.textContent = main;
        previewCommand.textContent = preview;

        previewBlock.hidden = !inPlace;

        updateSummary();
        updateWarning();
      }

      function updateTaskUI() {
        const task = getTask();

        taskSections.replace.hidden = task !== "replace";

        taskSections.pattern.hidden = ![
          "delete",
          "print",
          "insert-before",
          "append-after",
          "replace-line",
        ].includes(task);

        taskSections.custom.hidden = task !== "custom";

        document.getElementById(
          "insert-text-field"
        ).hidden = ![
          "insert-before",
          "append-after",
          "replace-line",
        ].includes(task);

        if (
          ["remove-blank", "remove-comments", "custom"].includes(task)
        ) {
          document.getElementById("line-scope").value = "all";
        }

        updateScopeUI();
        generateCommands();
      }

      function updateScopeUI() {
        const scope = getValue("line-scope");

        document.getElementById(
          "single-line-field"
        ).hidden = scope !== "line";

        document.getElementById(
          "start-line-field"
        ).hidden = scope !== "range";

        document.getElementById(
          "end-line-field"
        ).hidden = scope !== "range";

        generateCommands();
      }

      function updateSummary() {
        const labels = {
          replace: "Replace text",
          delete: "Delete lines",
          print: "Print lines",
          "insert-before": "Insert before",
          "append-after": "Append after",
          "replace-line": "Replace complete line",
          "remove-blank": "Remove blank lines",
          "remove-comments": "Remove comments",
          custom: "Custom expression",
        };

        document.getElementById(
          "summary-task"
        ).textContent =
          labels[getTask()] || "Replace text";

        document.getElementById(
          "summary-file"
        ).textContent =
          isChecked("recursive-mode")
            ? `${getValue("search-directory") || "."}/${
                getValue("file-pattern") || "*.conf"
              }`
            : getValue("file-path") || "/etc/example.conf";

        document.getElementById(
          "summary-in-place"
        ).textContent =
          isChecked("in-place")
            ? "Enabled"
            : "Disabled";

        document.getElementById(
          "summary-backup"
        ).textContent =
          isChecked("create-backup")
            ? getValue("backup-extension") || ".bak"
            : "Disabled";

        document.getElementById(
          "summary-recursive"
        ).textContent =
          isChecked("recursive-mode")
            ? "Enabled"
            : "Disabled";
      }

      function updateWarning() {
        if (
          isChecked("in-place") &&
          !isChecked("create-backup")
        ) {
          warningBox.textContent =
            "This command modifies the original file without creating a backup. Run the preview command first.";

          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (
          isChecked("in-place") &&
          isChecked("create-backup")
        ) {
          warningBox.textContent =
            "A backup file will be created. Verify the preview output before running the in-place command.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else if (isChecked("recursive-mode")) {
          warningBox.textContent =
            "This command may process multiple files. Verify the directory and filename pattern carefully.";

          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else {
          warningBox.textContent =
            "This command only prints the modified output and does not change the original file.";

          warningBox.style.borderColor = "#bbf7d0";
          warningBox.style.background = "#f0fdf4";
          warningBox.style.color = "#166534";
        }
      }

      function selectTask(task) {
        const radio = document.querySelector(
          `input[name="sed-task"][value="${task}"]`
        );

        if (radio) {
          radio.checked = true;
        }
      }

      function resetForm() {
        selectTask("replace");

        document.getElementById("file-path").value =
          "/etc/example.conf";

        document.getElementById("delimiter").value = "/";
        document.getElementById("line-scope").value = "all";
        document.getElementById("line-number").value = "5";
        document.getElementById("start-line").value = "5";
        document.getElementById("end-line").value = "10";

        document.getElementById("search-text").value =
          "old_value";

        document.getElementById("replacement-text").value =
          "new_value";

        document.getElementById("match-pattern").value =
          "ERROR";

        document.getElementById("insert-text").value =
          "Inserted text";

        document.getElementById(
          "custom-expression"
        ).value = "s/old/new/g";

        document.getElementById(
          "replace-global"
        ).checked = true;

        document.getElementById(
          "ignore-case"
        ).checked = false;

        document.getElementById(
          "in-place"
        ).checked = false;

        document.getElementById(
          "create-backup"
        ).checked = false;

        document.getElementById(
          "extended-regex"
        ).checked = false;

        document.getElementById(
          "use-sudo"
        ).checked = false;

        document.getElementById(
          "recursive-mode"
        ).checked = false;

        document.getElementById(
          "backup-extension"
        ).value = ".bak";

        document.getElementById(
          "search-directory"
        ).value = "/etc";

        document.getElementById(
          "file-pattern"
        ).value = "*.conf";

        updateTaskUI();
      }

      function loadPreset(preset) {
        resetForm();

        if (preset === "replace") {
          selectTask("replace");
        }

        if (preset === "replace-path") {
          selectTask("replace");

          document.getElementById("delimiter").value = "|";

          document.getElementById("search-text").value =
            "/opt/old/application";

          document.getElementById("replacement-text").value =
            "/opt/new/application";
        }

        if (preset === "delete-match") {
          selectTask("delete");

          document.getElementById("match-pattern").value =
            "deprecated";

          document.getElementById("line-scope").value =
            "all";
        }

        if (preset === "print-match") {
          selectTask("print");

          document.getElementById("match-pattern").value =
            "ERROR";
        }

        if (preset === "blank-lines") {
          selectTask("remove-blank");
        }

        if (preset === "comments") {
          selectTask("remove-comments");
        }

        if (preset === "recursive") {
          selectTask("replace");

          document.getElementById(
            "recursive-mode"
          ).checked = true;

          document.getElementById(
            "in-place"
          ).checked = true;

          document.getElementById(
            "create-backup"
          ).checked = true;

          document.getElementById(
            "search-directory"
          ).value = "/etc";

          document.getElementById(
            "file-pattern"
          ).value = "*.conf";
        }

        updateTaskUI();
      }

      async function copyText(text, message) {
        try {
          await navigator.clipboard.writeText(text);

          copyStatus.textContent =
            message || "Command copied successfully.";
        } catch {
          copyStatus.textContent =
            "Copy failed. Please select and copy the command manually.";
        }

        window.setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      function getAllCommands() {
        const commands = [];

        if (!previewBlock.hidden) {
          commands.push(
            `# Preview\n${previewCommand.textContent.trim()}`
          );
        }

        commands.push(
          `# Main command\n${mainCommand.textContent.trim()}`
        );

        return commands.join("\n\n");
      }

      document
        .querySelectorAll('input[name="sed-task"]')
        .forEach((radio) => {
          radio.addEventListener("change", updateTaskUI);
        });

      document
        .querySelectorAll("input, select, textarea")
        .forEach((element) => {
          if (element.name !== "sed-task") {
            element.addEventListener("input", generateCommands);
            element.addEventListener("change", generateCommands);
          }
        });

      document
        .getElementById("line-scope")
        ?.addEventListener("change", updateScopeUI);

      document
        .querySelectorAll(".preset-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const preset = button.dataset.preset;

            if (preset) {
              loadPreset(preset);
            }
          });
        });

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const targetId =
              button.dataset.copyTarget;

            const target = targetId
              ? document.getElementById(targetId)
              : null;

            copyText(
              target?.textContent?.trim() || "",
              "Command copied successfully."
            );
          });
        });

      document
        .getElementById("copy-all")
        ?.addEventListener("click", () => {
          copyText(
            getAllCommands(),
            "All commands copied successfully."
          );
        });

      document
        .getElementById("generate")
        ?.addEventListener("click", generateCommands);

      document
        .getElementById("reset")
        ?.addEventListener("click", resetForm);

      updateTaskUI();
    </script>
  </body>
</html>