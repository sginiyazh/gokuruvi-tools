                  </label>
                </div>

                <div
                  class="field-grid"
                  id="backup-section"
                  style="margin-top: 18px;"
                  hidden
                >
                  <div class="form-field">
                    <label class="field-label" for="backup-extension">
                      Backup extension
                    </label>

                    <input
                      class="field-input"
                      id="backup-extension"
                      type="text"
