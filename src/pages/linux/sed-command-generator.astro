                  role="status"
                  aria-live="polite"
                ></div>
              </div>

              <div class="result-card">
                <h2>Command summary</h2>

                <ul class="summary-list">
                  <li>
                    <span>Task</span>
                    <strong id="summary-task">Replace text</strong>
                  </li>

                  <li>
                    <span>File</span>
                    <strong id="summary-file">/etc/example.conf</strong>
                  </li>

                  <li>
                    <span>Edit in place</span>
                    <strong id="summary-in-place">Disabled</strong>
                  </li>

                  <li>
                    <span>Backup</span>
                    <strong id="summary-backup">Disabled</strong>
                  </li>

                  <li>
                    <span>Recursive</span>
                    <strong id="summary-recursive">Disabled</strong>
                  </li>
