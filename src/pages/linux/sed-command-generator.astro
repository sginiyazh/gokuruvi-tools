                <div
                  class="result-block"
                  id="preview-block"
                >
                  <span class="result-label">Safe preview command</span>

                  <div class="result-output">
                    <span class="result-value" id="preview-command">
                      sed 's/old_value/new_value/g' '/etc/example.conf'
                    </span>

                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target="preview-command"
                    >
                      Copy
                    </button>
