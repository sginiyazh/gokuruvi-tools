                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="create-backup" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Create backup
                      </span>

                      <span class="checkbox-description">
                        Create a backup before modifying the file.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="extended-regex" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Extended regular expressions
                      </span>

                      <span class="checkbox-description">
                        Add <code>-E</code> for extended regex syntax.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="use-sudo" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Include sudo
                      </span>

                      <span class="checkbox-description">
                        Prefix the command with <code>sudo</code>.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="recursive-mode" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Apply recursively
