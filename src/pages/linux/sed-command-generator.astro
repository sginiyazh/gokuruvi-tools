                    Replace text
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="replace-path"
                  >
                    Replace path
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="delete-match"
                  >
                    Delete matching lines
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="print-match"
                  >
                    Print matching lines
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="blank-lines"
                  >
                    Remove blank lines
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="comments"
                  >
                    Remove comments
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="recursive"
                  >
                    Recursive replace
                  </button>
                </div>
              </div>

              <div class="button-row">
                <button
                  class="main-button primary-button"
                  id="generate"
                  type="button"
                >
                  Generate Sed Command
                </button>

                <button
                  class="main-button secondary-button"
                  id="reset"
                  type="button"
                >
                  Reset
                </button>
              </div>
