            <aside class="results-column" aria-label="Generated command">
              <div class="result-card">
                <h2>Generated command</h2>

                <div class="result-block">
                  <span class="result-label">Sed command</span>

                  <div class="result-output">
                    <span class="result-value" id="main-command">
                      sed 's/old_value/new_value/g' '/etc/example.conf'
