    <Footer />

    <script is:inline>
      const sectionMap = {
        "private-key": document.getElementById("private-key-section"),
        csr: document.getElementById("csr-section"),
        "self-signed": document.getElementById("self-signed-section"),
        "view-certificate": document.getElementById("view-section"),
        "verify-match": document.getElementById("verify-section"),
        convert: document.getElementById("convert-section"),
        "tls-test": document.getElementById("tls-section"),
        "password-hash": document.getElementById("password-section"),
        random: document.getElementById("random-section"),
      };

      const mainCommand =
        document.getElementById("main-command");

      const secondaryCommand =
        document.getElementById("secondary-command");

      const thirdCommand =
        document.getElementById("third-command");

      const secondaryBlock =
        document.getElementById("secondary-block");

      const thirdBlock =
        document.getElementById("third-block");

      const warningBox =
        document.getElementById("warning-box");

      const copyStatus =
        document.getElementById("copy-status");

      const rsaSizeField =
        document.getElementById("rsa-size-field");

      const ecCurveField =
        document.getElementById("ec-curve-field");

      const convertKeyField =
        document.getElementById("convert-key-field");

      const chainFileField =
        document.getElementById("chain-file-field");

      function getValue(id) {
        return document.getElementById(id)?.value?.trim() ?? "";
      }

      function isChecked(id) {
        return Boolean(document.getElementById(id)?.checked);
      }

      function getTask() {
        return (
          document.querySelector(
            'input[name="task"]:checked'
          )?.value || "private-key"
        );
      }

      function shellQuote(value) {
        const text = String(value).trim();

        if (!text) {
          return "''";
        }

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function buildSubject() {
        const entries = [
          ["C", getValue("country")],
          ["ST", getValue("state")],
          ["L", getValue("locality")],
          ["O", getValue("organization")],
          ["OU", getValue("organizational-unit")],
          ["CN", getValue("common-name")],
          ["emailAddress", getValue("email")],
        ];

        return entries
          .filter(([, value]) => value)
          .map(([key, value]) => `/${key}=${value}`)
          .join("");
      }

      function buildSanExtension(value) {
        const entries = value
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean)
          .map((item) => {
            const isIp =
              /^(\d{1,3}\.){3}\d{1,3}$/.test(item) ||
              item.includes(":");

            return isIp ? `IP:${item}` : `DNS:${item}`;
          });

        return entries.length
          ? `subjectAltName=${entries.join(",")}`
          : "";
      }

      function setSummary(task, input, output) {
        document.getElementById(
          "summary-task"
        ).textContent = task;

        document.getElementById(
          "summary-input"
        ).textContent = input;

        document.getElementById(
          "summary-output"
        ).textContent = output;
      }

      function generatePrivateKey() {
        const keyType = getValue("key-type");
        const keyFile = getValue("key-file") || "server.key";

        if (keyType === "ec") {
          mainCommand.textContent =
            `openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:${
              getValue("ec-curve") || "prime256v1"
            } -out ${shellQuote(keyFile)}`;
        } else {
          const encryption = isChecked("encrypt-key")
            ? " -aes-256-cbc"
            : "";

          mainCommand.textContent =
            `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:${
              getValue("rsa-size") || "4096"
            }${encryption} -out ${shellQuote(keyFile)}`;
        }

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `chmod 600 ${shellQuote(keyFile)}`;

        thirdBlock.hidden = false;
        thirdCommand.textContent =
          `openssl pkey -in ${shellQuote(keyFile)} -check`;

        setSummary(
          "Generate private key",
          "Not required",
          keyFile
        );

        warningBox.textContent =
          "Store private keys securely and restrict access with chmod 600.";
      }

      function generateCsr() {
        const keyFile =
          getValue("csr-key-file") || "server.key";

        const csrFile =
          getValue("csr-file") || "server.csr";

        const subject =
          buildSubject() || "/CN=www.example.com";

        const san =
          buildSanExtension(getValue("san-list"));

        const extension = san
          ? ` -addext ${shellQuote(san)}`
          : "";

        mainCommand.textContent =
          `openssl req -new -key ${shellQuote(
            keyFile
          )} -out ${shellQuote(
            csrFile
          )} -subj ${shellQuote(subject)}${extension}`;

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `openssl req -in ${shellQuote(
            csrFile
          )} -text -noout`;

        thirdBlock.hidden = true;

        setSummary(
          "Generate CSR",
          keyFile,
          csrFile
        );

        warningBox.textContent =
          "Verify the common name and Subject Alternative Names before submitting the CSR to a certificate authority.";
      }

      function generateSelfSigned() {
        const keyFile =
          getValue("self-key-file") || "server.key";

        const certFile =
          getValue("self-cert-file") || "server.crt";

        const commonName =
          getValue("self-common-name") || "www.example.com";

        const days =
          getValue("self-days") || "365";

        const san =
          buildSanExtension(getValue("self-san-list"));

        const extension = san
          ? ` -addext ${shellQuote(san)}`
          : "";

        mainCommand.textContent =
          `openssl req -x509 -newkey rsa:4096 -sha256 -nodes -keyout ${shellQuote(
            keyFile
          )} -out ${shellQuote(
            certFile
          )} -days ${days} -subj ${shellQuote(
            `/CN=${commonName}`
          )}${extension}`;

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `chmod 600 ${shellQuote(keyFile)}`;

        thirdBlock.hidden = false;
        thirdCommand.textContent =
          `openssl x509 -in ${shellQuote(
            certFile
          )} -text -noout`;

        setSummary(
          "Self-signed certificate",
          "Generated private key",
          certFile
        );

        warningBox.textContent =
          "Self-signed certificates are not trusted automatically by browsers or external clients.";
      }

      function generateViewCertificate() {
        const file =
          getValue("view-file") || "server.crt";

        const format =
          getValue("view-format") === "der"
            ? " -inform DER"
            : "";

        mainCommand.textContent =
          `openssl x509${format} -in ${shellQuote(
            file
          )} -text -noout`;

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `openssl x509${format} -in ${shellQuote(
            file
          )} -dates -subject -issuer -serial -fingerprint -sha256 -noout`;

        thirdBlock.hidden = false;
        thirdCommand.textContent =
          `openssl x509${format} -in ${shellQuote(
            file
          )} -checkend 2592000 -noout`;

        setSummary(
          "View certificate",
          file,
          "Terminal output"
        );

        warningBox.textContent =
          "The checkend command returns a non-zero status when the certificate expires within 30 days.";
      }

      function generateVerifyMatch() {
        const cert =
          getValue("verify-cert") || "server.crt";

        const key =
          getValue("verify-key") || "server.key";

        const csr =
          getValue("verify-csr") || "server.csr";

        mainCommand.textContent =
          `openssl x509 -in ${shellQuote(
            cert
          )} -pubkey -noout | openssl sha256`;

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `openssl pkey -in ${shellQuote(
            key
          )} -pubout | openssl sha256`;

        thirdBlock.hidden = false;
        thirdCommand.textContent =
          `openssl req -in ${shellQuote(
            csr
          )} -pubkey -noout | openssl sha256`;

        setSummary(
          "Verify matching files",
          `${cert}, ${key}, ${csr}`,
          "SHA-256 values"
        );

        warningBox.textContent =
          "The SHA-256 output must be identical for the certificate, private key and CSR.";
      }

      function generateConversion() {
        const type = getValue("conversion-type");
        const input =
          getValue("input-file") || "server.crt";

        const output =
          getValue("output-file") || "server.der";

        const key =
          getValue("convert-key") || "server.key";

        const chain = getValue("chain-file");

        const commands = {
          "pem-to-der":
            `openssl x509 -in ${shellQuote(
              input
            )} -outform DER -out ${shellQuote(output)}`,

          "der-to-pem":
            `openssl x509 -inform DER -in ${shellQuote(
              input
            )} -outform PEM -out ${shellQuote(output)}`,

          "pfx-to-pem":
            `openssl pkcs12 -in ${shellQuote(
              input
            )} -out ${shellQuote(output)}`,

          "pfx-to-cert":
            `openssl pkcs12 -in ${shellQuote(
              input
            )} -clcerts -nokeys -out ${shellQuote(output)}`,

          "pfx-to-key":
            `openssl pkcs12 -in ${shellQuote(
              input
            )} -nocerts -nodes -out ${shellQuote(output)}`,

          "pem-to-pfx":
            `openssl pkcs12 -export -out ${shellQuote(
              output
            )} -inkey ${shellQuote(
              key
            )} -in ${shellQuote(input)}${
              chain
                ? ` -certfile ${shellQuote(chain)}`
                : ""
            }`,
        };

        mainCommand.textContent =
          commands[type] || commands["pem-to-der"];

        secondaryBlock.hidden =
          type !== "pfx-to-key";

        if (type === "pfx-to-key") {
          secondaryCommand.textContent =
            `chmod 600 ${shellQuote(output)}`;
        }

        thirdBlock.hidden = true;

        setSummary(
          "Convert certificate format",
          input,
          output
        );

        warningBox.textContent =
          type === "pfx-to-key"
            ? "The extracted private key is unencrypted. Restrict permissions immediately."
            : "Verify the converted file before replacing any production certificate.";
      }

      function generateTlsTest() {
        const host =
          getValue("tls-host") || "www.example.com";

        const port =
          getValue("tls-port") || "443";

        const serverName =
          getValue("tls-servername") || host;

        const version = getValue("tls-version");

        mainCommand.textContent =
          `openssl s_client -connect ${host}:${port} -servername ${serverName}${
            version ? ` ${version}` : ""
          } -showcerts`;

        secondaryBlock.hidden = false;
        secondaryCommand.textContent =
          `echo | openssl s_client -connect ${host}:${port} -servername ${serverName} 2>/dev/null | openssl x509 -dates -subject -issuer -noout`;

        thirdBlock.hidden = true;

        setSummary(
          "Test TLS connection",
          `${host}:${port}`,
          "TLS handshake details"
        );

        warningBox.textContent =
          "Check the verification return code, certificate chain, hostname and expiry dates.";
      }

      function generatePasswordHash() {
        const password = getValue("hash-password");

        mainCommand.textContent = password
          ? `openssl passwd -6 ${shellQuote(password)}`
          : "openssl passwd -6";

        secondaryBlock.hidden = true;
        thirdBlock.hidden = true;

        setSummary(
          "Generate password hash",
          password ? "Provided password" : "Interactive input",
          "SHA-512 crypt hash"
        );

        warningBox.textContent =
          password
            ? "The password will appear in shell history. Interactive input is safer."
            : "OpenSSL will request the password securely without displaying it.";
      }

      function generateRandom() {
        const format =
          getValue("random-format") || "hex";

        const bytes =
          getValue("random-bytes") || "32";

        mainCommand.textContent =
          `openssl rand -${format} ${bytes}`;

        secondaryBlock.hidden = true;
        thirdBlock.hidden = true;

        setSummary(
          "Generate random value",
          `${bytes} random bytes`,
          format.toUpperCase()
        );

        warningBox.textContent =
          "Use sufficiently long random values for passwords, secrets, tokens and encryption keys.";
      }

      function generateCommands() {
        secondaryBlock.hidden = true;
        thirdBlock.hidden = true;

        const task = getTask();

        if (task === "private-key") {
          generatePrivateKey();
        }

        if (task === "csr") {
          generateCsr();
        }

        if (task === "self-signed") {
          generateSelfSigned();
        }

        if (task === "view-certificate") {
          generateViewCertificate();
        }

        if (task === "verify-match") {
          generateVerifyMatch();
        }

        if (task === "convert") {
          generateConversion();
        }

        if (task === "tls-test") {
          generateTlsTest();
        }

        if (task === "password-hash") {
          generatePasswordHash();
        }

        if (task === "random") {
          generateRandom();
        }
      }

      function updateTaskUI() {
        const task = getTask();

        Object.entries(sectionMap).forEach(
          ([name, section]) => {
            section.hidden = name !== task;
          }
        );

        generateCommands();
      }

      function updateKeyType() {
        const keyType = getValue("key-type");

        rsaSizeField.hidden = keyType !== "rsa";
        ecCurveField.hidden = keyType !== "ec";

        generateCommands();
      }

      function updateConversionFields() {
        const type = getValue("conversion-type");

        convertKeyField.hidden =
          type !== "pem-to-pfx";

        chainFileField.hidden =
          type !== "pem-to-pfx";

        const outputSuggestions = {
          "pem-to-der": "server.der",
          "der-to-pem": "server.pem",
          "pfx-to-pem": "server.pem",
          "pfx-to-cert": "server.crt",
          "pfx-to-key": "server.key",
          "pem-to-pfx": "server.pfx",
        };

        document.getElementById(
          "output-file"
        ).value = outputSuggestions[type] || "output.pem";

        generateCommands();
      }

      function selectTask(task) {
        const radio = document.querySelector(
          `input[name="task"][value="${task}"]`
        );

        if (radio) {
          radio.checked = true;
        }
      }

      function resetForm() {
        selectTask("private-key");

        document.getElementById("key-type").value = "rsa";
        document.getElementById("rsa-size").value = "4096";
        document.getElementById("ec-curve").value = "prime256v1";
        document.getElementById("key-file").value = "server.key";
        document.getElementById("encrypt-key").checked = false;

        document.getElementById("csr-key-file").value = "server.key";
        document.getElementById("csr-file").value = "server.csr";
        document.getElementById("common-name").value = "www.example.com";
        document.getElementById("country").value = "AE";
        document.getElementById("state").value = "Dubai";
        document.getElementById("locality").value = "Dubai";
        document.getElementById("organization").value = "Gokuruvi";
        document.getElementById("organizational-unit").value = "IT";
        document.getElementById("email").value = "";
        document.getElementById("san-list").value =
          "www.example.com,example.com";

        updateKeyType();
        updateTaskUI();
      }

      function loadPreset(preset) {
        resetForm();

        if (preset === "rsa-key") {
          selectTask("private-key");
          document.getElementById("key-type").value = "rsa";
          document.getElementById("rsa-size").value = "4096";
        }

        if (preset === "csr") {
          selectTask("csr");
        }

        if (preset === "self-signed") {
          selectTask("self-signed");
        }

        if (preset === "expiry") {
          selectTask("view-certificate");
        }

        if (preset === "tls") {
          selectTask("tls-test");
        }

        if (preset === "random") {
          selectTask("random");
          document.getElementById("random-format").value = "base64";
          document.getElementById("random-bytes").value = "32";
        }

        updateTaskUI();
      }

      function getAllCommands() {
        const commands = [
          mainCommand.textContent.trim(),
        ];

        if (!secondaryBlock.hidden) {
          commands.push(
            secondaryCommand.textContent.trim()
          );
        }

        if (!thirdBlock.hidden) {
          commands.push(
            thirdCommand.textContent.trim()
          );
        }

        return commands.filter(Boolean).join("\n");
      }

      async function copyText(text, message) {
        try {
          await navigator.clipboard.writeText(text);
          copyStatus.textContent = message;
        } catch {
          copyStatus.textContent =
            "Copy failed. Please copy the command manually.";
        }

        setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      document
        .querySelectorAll('input[name="task"]')
        .forEach((radio) => {
          radio.addEventListener("change", updateTaskUI);
        });

      document
        .querySelectorAll("input, select, textarea")
        .forEach((element) => {
          if (element.name !== "task") {
            element.addEventListener("input", generateCommands);
            element.addEventListener("change", generateCommands);
          }
        });

      document
        .getElementById("key-type")
        ?.addEventListener("change", updateKeyType);

      document
        .getElementById("conversion-type")
        ?.addEventListener("change", updateConversionFields);

      document
        .querySelectorAll(".preset-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            loadPreset(button.dataset.preset);
          });
        });

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const target =
              document.getElementById(
                button.dataset.copyTarget
              );

            copyText(
              target?.textContent?.trim() || "",
              "Command copied successfully."
            );
          });
        });

      document
        .getElementById("copy-all")
        ?.addEventListener("click", () => {
          copyText(
            getAllCommands(),
            "All commands copied successfully."
          );
        });

      document
        .getElementById("generate")
        ?.addEventListener("click", generateCommands);

      document
        .getElementById("reset")
        ?.addEventListener("click", resetForm);

      updateKeyType();
      updateConversionFields();
      updateTaskUI();
    </script>
  </body>
</html>