---
import Header from "../../components/Header.astro";
const pageTitle = "Linux Ownership Command Generator | Gokuruvi Tools";
const pageDescription =
  "Generate Linux chown and chgrp commands for files and directories with recursive, symbolic-link and reference options.";
const siteUrl =
  "https://www.gokuruvi.com/linux/ownership-command-generator";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={pageDescription} />

    <meta
      name="keywords"
      content="Linux chown generator, ownership command generator, chgrp generator, Linux file ownership, recursive chown, Linux admin tools"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta
      property="og:image"
      content="https://www.gokuruvi.com/og-image.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <title>{pageTitle}</title>

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --secondary: #38bdf8;
        --dark: #0f172a;
        --text: #172033;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success: #16a34a;
        --danger: #dc2626;
        --warning: #d97706;
        --maximum-width: 1180px;

        font-family:
          Inter, Arial, Helvetica, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      a {
        color: inherit;
      }

      code,
      pre {
        font-family: Consolas, "Courier New", monospace;
      }

      .container {
        width: min(100% - 40px, var(--maximum-width));
        margin-inline: auto;
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 9999;
        padding: 10px 16px;
        border-radius: 8px;
        background: #ffffff;
        color: var(--dark);
        font-weight: 800;
        text-decoration: none;
        transform: translateY(-160%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.45);
        outline-offset: 3px;
      }

      /* Header */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.97);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .navbar {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 21px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
      }

      .logo-icon {
        display: grid;
        width: 39px;
        height: 39px;
        place-items: center;
        border-radius: 10px;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );
        color: #ffffff;
        box-shadow: 0 8px 22px rgba(37, 99, 235, 0.35);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-links a {
        color: #e2e8f0;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: #ffffff;
      }

      .nav-button {
        padding: 10px 18px;
        border-radius: 9px;
        background: var(--primary);
        color: #ffffff !important;
      }

      /* Breadcrumb */

      .breadcrumb-section {
        border-bottom: 1px solid var(--border);
        background: #ffffff;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        padding: 15px 0;
        color: var(--muted);
        font-size: 14px;
      }

      .breadcrumb a {
        color: var(--primary);
        font-weight: 700;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      /* Hero */

      .hero {
        padding: 75px 0 68px;
        background:
          radial-gradient(
            circle at 15% 15%,
            rgba(56, 189, 248, 0.18),
            transparent 31%
          ),
          radial-gradient(
            circle at 88% 35%,
            rgba(37, 99, 235, 0.17),
            transparent 34%
          ),
          linear-gradient(
            145deg,
            #f8fafc 0%,
            #eff6ff 50%,
            #f8fafc 100%
          );
      }

      .hero-content {
        max-width: 860px;
        margin: 0 auto;
        text-align: center;
      }

      .hero-icon {
        display: grid;
        width: 72px;
        height: 72px;
        place-items: center;
        margin: 0 auto 20px;
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.9);
        font-size: 36px;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.14);
      }

      .hero h1 {
        margin: 0 0 18px;
        color: var(--dark);
        font-size: clamp(40px, 7vw, 62px);
        line-height: 1.08;
        letter-spacing: -2px;
      }

      .hero h1 span {
        background: linear-gradient(
          90deg,
          var(--primary),
          #0284c7
        );
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }

      .hero p {
        max-width: 780px;
        margin: 0 auto;
        color: #475569;
        font-size: 19px;
        line-height: 1.8;
      }

      /* Generator */

      .generator-section {
        padding: 75px 0;
      }

      .generator-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.85fr);
        gap: 28px;
        align-items: start;
      }

      .generator-card,
      .result-card,
      .info-card {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--card);
        box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
      }

      .generator-card {
        padding: 30px;
      }

      .generator-heading {
        margin-bottom: 28px;
      }

      .generator-heading h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 27px;
      }

      .generator-heading p {
        margin: 0;
        color: var(--muted);
      }

      .form-section {
        margin-bottom: 30px;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--border);
      }

      .form-section:last-of-type {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: 0;
      }

      .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: var(--dark);
        font-size: 19px;
      }

      .section-number {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 8px;
        background: #eff6ff;
        color: var(--primary-dark);
        font-size: 13px;
        font-weight: 800;
      }

      .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .form-field {
        min-width: 0;
      }

      .form-field.full-width {
        grid-column: 1 / -1;
      }

      .field-label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .field-input,
      .field-select,
      .field-textarea {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        background: #ffffff;
        color: var(--dark);
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .field-input,
      .field-select {
        min-height: 48px;
        padding: 0 13px;
      }

      .field-textarea {
        min-height: 100px;
        padding: 12px 13px;
        resize: vertical;
      }

      .field-input:focus,
      .field-select:focus,
      .field-textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      }

      .field-help {
        display: block;
        margin-top: 7px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .mode-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .mode-card {
        position: relative;
        display: block;
        cursor: pointer;
      }

      .mode-card input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .mode-content {
        display: block;
        min-height: 120px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #ffffff;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease;
      }

      .mode-card input:checked + .mode-content {
        border-color: var(--primary);
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.09);
      }

      .mode-title {
        display: block;
        margin-bottom: 6px;
        color: var(--dark);
        font-weight: 800;
      }

      .mode-description {
        display: block;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.55;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f8fafc;
      }

      .checkbox-item input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: var(--primary);
      }

      .checkbox-title {
        display: block;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .checkbox-description {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
      }

      .action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 28px;
      }

      .action-button {
        min-height: 46px;
        padding: 0 19px;
        border-radius: 10px;
        font-weight: 800;
        cursor: pointer;
      }

      .action-primary {
        border: 0;
        background: var(--primary);
        color: #ffffff;
      }

      .action-primary:hover {
        background: var(--primary-dark);
      }

      .action-secondary {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .action-secondary:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      /* Results */

      .results-column {
        position: sticky;
        top: 95px;
        display: grid;
        gap: 20px;
      }

      .result-card {
        padding: 26px;
      }

      .result-card h2 {
        margin: 0 0 20px;
        color: var(--dark);
        font-size: 23px;
      }

      .result-group {
        margin-bottom: 18px;
      }

      .result-group:last-child {
        margin-bottom: 0;
      }

      .result-label {
        display: block;
        margin-bottom: 7px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .result-output {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        min-height: 58px;
        padding: 13px 14px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #f8fafc;
      }

      .result-value {
        overflow-wrap: anywhere;
        color: var(--dark);
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 800;
        white-space: pre-wrap;
      }

      .copy-button {
        flex: 0 0 auto;
        padding: 7px 11px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: var(--dark);
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
      }

      .copy-button:hover {
        border-color: var(--primary);
        color: var(--primary-dark);
      }

      .warning-box {
        padding: 14px;
        border: 1px solid #fde68a;
        border-radius: 11px;
        background: #fffbeb;
        color: #92400e;
        font-size: 14px;
        line-height: 1.6;
      }

      .status-message {
        min-height: 22px;
        margin-top: 12px;
        color: var(--success);
        font-size: 14px;
        font-weight: 700;
      }

      .summary-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .summary-list li {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: var(--muted);
        font-size: 14px;
      }

      .summary-list strong {
        color: var(--dark);
        text-align: right;
      }

      /* Information */

      .info-section {
        padding: 0 0 85px;
      }

      .section-heading {
        max-width: 760px;
        margin: 0 auto 45px;
        text-align: center;
      }

      .section-heading h2 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(30px, 4vw, 42px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 18px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .info-card {
        padding: 27px;
      }

      .info-card h3 {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 20px;
      }

      .info-card p,
      .info-card li {
        color: var(--muted);
        line-height: 1.75;
      }

      .info-card ul {
        margin: 12px 0 0;
        padding-left: 20px;
      }

      /* Footer */

      footer {
        background: var(--dark);
        color: #cbd5e1;
      }

      .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 28px 0;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      @media (max-width: 980px) {
        .generator-layout {
          grid-template-columns: 1fr;
        }

        .results-column {
          position: static;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .navbar {
          min-height: auto;
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .nav-links {
          width: 100%;
          flex-wrap: wrap;
          gap: 15px 20px;
        }
      }

      @media (max-width: 680px) {
        .container {
          width: min(100% - 28px, var(--maximum-width));
        }

        .hero {
          padding: 60px 0 55px;
        }

        .hero h1 {
          font-size: 40px;
          letter-spacing: -1.3px;
        }

        .generator-card,
        .result-card {
          padding: 22px;
        }

        .field-grid,
        .mode-grid,
        .checkbox-grid {
          grid-template-columns: 1fr;
        }

        .action-row {
          flex-direction: column;
        }

        .action-button {
          width: 100%;
        }

        .result-output {
          flex-direction: column;
        }

        .summary-list li {
          flex-direction: column;
          gap: 3px;
        }

        .summary-list strong {
          text-align: left;
        }

        .footer-content {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <Header />

    <div class="breadcrumb-section">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/linux">Linux Tools</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">
            Ownership Command Generator
          </span>
        </nav>
      </div>
    </div>

    <main id="main-content">
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-icon" aria-hidden="true">👤</div>

            <h1>
              Ownership Command <span>Generator</span>
            </h1>

            <p>
              Generate safe Linux <code>chown</code> and <code>chgrp</code>
              commands for files and directories. Configure owner, group,
              recursion, symbolic-link handling and reference-based ownership.
            </p>
          </div>
        </div>
      </section>

      <section class="generator-section">
        <div class="container">
          <div class="generator-layout">
            <div class="generator-card">
              <div class="generator-heading">
                <h2>Configure the ownership command</h2>

                <p>
                  Select the required operation and enter the ownership details.
                  The generated command updates automatically.
                </p>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">1</span>
                  Choose operation
                </h3>

                <div class="mode-grid">
                  <label class="mode-card">
                    <input
                      type="radio"
                      name="operation"
                      value="owner-group"
                      checked
                    />

                    <span class="mode-content">
                      <span class="mode-title">
                        Change owner and group
                      </span>

                      <span class="mode-description">
                        Generate a chown command using owner:group syntax.
                      </span>
                    </span>
                  </label>

                  <label class="mode-card">
                    <input
                      type="radio"
                      name="operation"
                      value="owner-only"
                    />

                    <span class="mode-content">
                      <span class="mode-title">
                        Change owner only
                      </span>

                      <span class="mode-description">
                        Change the user owner without changing the group.
                      </span>
                    </span>
                  </label>

                  <label class="mode-card">
                    <input
                      type="radio"
                      name="operation"
                      value="group-only"
                    />

                    <span class="mode-content">
                      <span class="mode-title">
                        Change group only
                      </span>

                      <span class="mode-description">
                        Generate a chgrp command for the selected group.
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">2</span>
                  Ownership details
                </h3>

                <div class="field-grid">
                  <div class="form-field" id="owner-field">
                    <label class="field-label" for="owner">
                      New owner
                    </label>

                    <input
                      class="field-input"
                      id="owner"
                      type="text"
                      value="appuser"
                      placeholder="appuser"
                      autocomplete="off"
                    />

                    <span class="field-help">
                      Enter a Linux username or numeric UID.
                    </span>
                  </div>

                  <div class="form-field" id="group-field">
                    <label class="field-label" for="group">
                      New group
                    </label>

                    <input
                      class="field-input"
                      id="group"
                      type="text"
                      value="appgroup"
                      placeholder="appgroup"
                      autocomplete="off"
                    />

                    <span class="field-help">
                      Enter a Linux group name or numeric GID.
                    </span>
                  </div>

                  <div class="form-field full-width">
                    <label class="field-label" for="target-path">
                      Target file or directory
                    </label>

                    <input
                      class="field-input"
                      id="target-path"
                      type="text"
                      value="/opt/my-application"
                      placeholder="/path/to/file-or-directory"
                    />

                    <span class="field-help">
                      Absolute paths are recommended for administrative commands.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">3</span>
                  Command options
                </h3>

                <div class="checkbox-grid">
                  <label class="checkbox-item">
                    <input
                      id="recursive"
                      type="checkbox"
                      checked
                    />

                    <span>
                      <span class="checkbox-title">
                        Recursive
                      </span>

                      <span class="checkbox-description">
                        Apply ownership changes to all files and subdirectories.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="verbose" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Verbose output
                      </span>

                      <span class="checkbox-description">
                        Display diagnostic information for every processed file.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="changes-only" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Report changes only
                      </span>

                      <span class="checkbox-description">
                        Report only files whose ownership is changed.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="no-dereference" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Do not dereference
                      </span>

                      <span class="checkbox-description">
                        Change symbolic links instead of their referenced files.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="preserve-root" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">
                        Preserve root
                      </span>

                      <span class="checkbox-description">
                        Refuse recursive operation directly on the root directory.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="use-sudo" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">
                        Include sudo
                      </span>

                      <span class="checkbox-description">
                        Prefix the generated command with sudo.
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">4</span>
                  Advanced options
                </h3>

                <div class="field-grid">
                  <div class="form-field">
                    <label class="field-label" for="symlink-traversal">
                      Symbolic-link traversal
                    </label>

                    <select class="field-select" id="symlink-traversal">
                      <option value="">Default behaviour</option>
                      <option value="-H">
                        -H: follow command-line symlinks
                      </option>
                      <option value="-L">
                        -L: follow all encountered symlinks
                      </option>
                      <option value="-P">
                        -P: never follow symlinks
                      </option>
                    </select>

                    <span class="field-help">
                      These options are mainly relevant with recursive mode.
                    </span>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="from-owner">
                      Change only from owner
                    </label>

                    <input
                      class="field-input"
                      id="from-owner"
                      type="text"
                      placeholder="olduser"
                    />

                    <span class="field-help">
                      Use --from to change only matching ownership.
                    </span>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="from-group">
                      Change only from group
                    </label>

                    <input
                      class="field-input"
                      id="from-group"
                      type="text"
                      placeholder="oldgroup"
                    />
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="reference-path">
                      Reference file
                    </label>

                    <input
                      class="field-input"
                      id="reference-path"
                      type="text"
                      placeholder="/path/to/reference-file"
                    />

                    <span class="field-help">
                      Copies ownership from another file using --reference.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">5</span>
                  Multiple targets
                </h3>

                <div class="form-field">
                  <label class="field-label" for="additional-paths">
                    Additional files or directories
                  </label>

                  <textarea
                    class="field-textarea"
                    id="additional-paths"
                    placeholder="/var/log/my-application&#10;/etc/my-application"
                  ></textarea>

                  <span class="field-help">
                    Enter one additional path per line.
                  </span>
                </div>
              </div>

              <div class="action-row">
                <button
                  class="action-button action-primary"
                  id="generate"
                  type="button"
                >
                  Generate Command
                </button>

                <button
                  class="action-button action-secondary"
                  id="load-example"
                  type="button"
                >
                  Load Web Directory Example
                </button>

                <button
                  class="action-button action-secondary"
                  id="reset"
                  type="button"
                >
                  Reset
                </button>
              </div>
            </div>

            <aside class="results-column" aria-label="Generated command">
              <div class="result-card">
                <h2>Generated ownership command</h2>

                <div class="result-group">
                  <span class="result-label">Command</span>

                  <div class="result-output">
                    <span
                      class="result-value"
                      id="command-result"
                    >
                      sudo chown -R --preserve-root appuser:appgroup '/opt/my-application'
                    </span>

                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target="command-result"
                    >
                      Copy
                    </button>
                  </div>
                </div>

                <div class="result-group">
                  <span class="result-label">Ownership syntax</span>

                  <div class="result-output">
                    <span
                      class="result-value"
                      id="ownership-result"
                    >
                      appuser:appgroup
                    </span>

                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target="ownership-result"
                    >
                      Copy
                    </button>
                  </div>
                </div>

                <div
                  class="warning-box"
                  id="warning-box"
                >
                  Review the target path carefully before running recursive
                  ownership commands.
                </div>

                <div
                  class="status-message"
                  id="copy-status"
                  role="status"
                  aria-live="polite"
                ></div>
              </div>

              <div class="result-card">
                <h2>Command summary</h2>

                <ul class="summary-list">
                  <li>
                    <span>Command type</span>
                    <strong id="summary-command">chown</strong>
                  </li>

                  <li>
                    <span>Owner</span>
                    <strong id="summary-owner">appuser</strong>
                  </li>

                  <li>
                    <span>Group</span>
                    <strong id="summary-group">appgroup</strong>
                  </li>

                  <li>
                    <span>Recursive</span>
                    <strong id="summary-recursive">Yes</strong>
                  </li>

                  <li>
                    <span>Targets</span>
                    <strong id="summary-targets">1</strong>
                  </li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <h2>Understanding Linux ownership commands</h2>

            <p>
              Linux uses owners and groups to control access to files and
              directories.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <h3>Using chown</h3>

              <p>
                The <code>chown</code> command changes the user owner and
                optionally the group owner.
              </p>

              <ul>
                <li>
                  <code>chown user file</code> changes the owner.
                </li>
                <li>
                  <code>chown user:group file</code> changes both.
                </li>
                <li>
                  <code>chown :group file</code> changes only the group.
                </li>
              </ul>
            </article>

            <article class="info-card">
              <h3>Using chgrp</h3>

              <p>
                The <code>chgrp</code> command changes only the group
                ownership.
              </p>

              <ul>
                <li>
                  <code>chgrp developers file.txt</code>
                </li>
                <li>
                  <code>chgrp -R webteam /var/www</code>
                </li>
                <li>
                  Root or the file owner normally performs the change.
                </li>
              </ul>
            </article>

            <article class="info-card">
              <h3>Safety recommendations</h3>

              <ul>
                <li>
                  Verify the target path before using <code>-R</code>.
                </li>
                <li>
                  Keep <code>--preserve-root</code> enabled for recursive tasks.
                </li>
                <li>
                  Avoid changing system directories without confirming the
                  correct ownership.
                </li>
                <li>
                  Use <code>ls -ld</code> or <code>stat</code> to validate the
                  result.
                </li>
              </ul>
            </article>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const ownerInput = document.getElementById("owner");
      const groupInput = document.getElementById("group");
      const targetPathInput = document.getElementById("target-path");
      const additionalPathsInput =
        document.getElementById("additional-paths");

      const recursiveInput = document.getElementById("recursive");
      const verboseInput = document.getElementById("verbose");
      const changesOnlyInput =
        document.getElementById("changes-only");
      const noDereferenceInput =
        document.getElementById("no-dereference");
      const preserveRootInput =
        document.getElementById("preserve-root");
      const useSudoInput = document.getElementById("use-sudo");

      const symlinkTraversalInput =
        document.getElementById("symlink-traversal");
      const fromOwnerInput = document.getElementById("from-owner");
      const fromGroupInput = document.getElementById("from-group");
      const referencePathInput =
        document.getElementById("reference-path");

      const ownerField = document.getElementById("owner-field");
      const groupField = document.getElementById("group-field");

      const commandResult =
        document.getElementById("command-result");
      const ownershipResult =
        document.getElementById("ownership-result");
      const warningBox = document.getElementById("warning-box");
      const copyStatus = document.getElementById("copy-status");

      const summaryCommand =
        document.getElementById("summary-command");
      const summaryOwner =
        document.getElementById("summary-owner");
      const summaryGroup =
        document.getElementById("summary-group");
      const summaryRecursive =
        document.getElementById("summary-recursive");
      const summaryTargets =
        document.getElementById("summary-targets");

      function getOperation() {
        return (
          document.querySelector(
            'input[name="operation"]:checked'
          )?.value || "owner-group"
        );
      }

      function shellQuote(value) {
        const text = value.trim();

        if (!text) {
          return "''";
        }

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function getTargets() {
        const targets = [];

        const primaryTarget = targetPathInput.value.trim();

        if (primaryTarget) {
          targets.push(primaryTarget);
        }

        additionalPathsInput.value
          .split(/\r?\n/)
          .map((path) => path.trim())
          .filter(Boolean)
          .forEach((path) => targets.push(path));

        return [...new Set(targets)];
      }

      function updateFieldVisibility() {
        const operation = getOperation();

        ownerField.hidden = operation === "group-only";
        groupField.hidden = operation === "owner-only";
      }

      function buildOwnershipSyntax(operation) {
        const owner = ownerInput.value.trim();
        const group = groupInput.value.trim();

        if (operation === "owner-only") {
          return owner || "username";
        }

        if (operation === "group-only") {
          return group || "groupname";
        }

        return `${owner || "username"}:${group || "groupname"}`;
      }

      function buildFromOption(operation) {
        const oldOwner = fromOwnerInput.value.trim();
        const oldGroup = fromGroupInput.value.trim();

        if (!oldOwner && !oldGroup) {
          return "";
        }

        if (operation === "group-only") {
          return "";
        }

        if (operation === "owner-only") {
          return `--from=${oldOwner || ""}`;
        }

        return `--from=${oldOwner || ""}:${oldGroup || ""}`;
      }

      function generateCommand() {
        const operation = getOperation();
        const targets = getTargets();

        const options = [];

        if (recursiveInput.checked) {
          options.push("-R");
        }

        if (verboseInput.checked) {
          options.push("-v");
        } else if (changesOnlyInput.checked) {
          options.push("-c");
        }

        if (noDereferenceInput.checked) {
          options.push("-h");
        }

        if (recursiveInput.checked && preserveRootInput.checked) {
          options.push("--preserve-root");
        }

        if (
          recursiveInput.checked &&
          symlinkTraversalInput.value
        ) {
          options.push(symlinkTraversalInput.value);
        }

        const referencePath = referencePathInput.value.trim();

        if (referencePath) {
          options.push(`--reference=${shellQuote(referencePath)}`);
        }

        const fromOption = buildFromOption(operation);

        if (fromOption) {
          options.push(fromOption);
        }

        const commandName =
          operation === "group-only" ? "chgrp" : "chown";

        const ownership = buildOwnershipSyntax(operation);
        const commandParts = [];

        if (useSudoInput.checked) {
          commandParts.push("sudo");
        }

        commandParts.push(commandName);

        if (options.length > 0) {
          commandParts.push(...options);
        }

        if (!referencePath) {
          commandParts.push(ownership);
        }

        if (targets.length > 0) {
          commandParts.push(...targets.map(shellQuote));
        } else {
          commandParts.push("'/path/to/file-or-directory'");
        }

        const command = commandParts.join(" ");

        commandResult.textContent = command;
        ownershipResult.textContent = referencePath
          ? `Ownership copied from ${referencePath}`
          : ownership;

        summaryCommand.textContent = commandName;
        summaryOwner.textContent =
          operation === "group-only"
            ? "Not changed"
            : ownerInput.value.trim() || "Not specified";

        summaryGroup.textContent =
          operation === "owner-only"
            ? "Not changed"
            : groupInput.value.trim() || "Not specified";

        summaryRecursive.textContent =
          recursiveInput.checked ? "Yes" : "No";

        summaryTargets.textContent = String(
          targets.length || 1
        );

        const rootTarget = targets.some(
          (target) => target === "/" || target === "/*"
        );

        if (recursiveInput.checked && rootTarget) {
          warningBox.textContent =
            "Danger: the selected target includes the root directory. Do not run this command without a complete review.";
          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (
          recursiveInput.checked &&
          !preserveRootInput.checked
        ) {
          warningBox.textContent =
            "Warning: recursive mode is enabled without --preserve-root.";
          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else {
          warningBox.textContent =
            "Review the target path carefully before running recursive ownership commands.";
          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        }
      }

      function loadExample() {
        document.querySelector(
          'input[name="operation"][value="owner-group"]'
        ).checked = true;

        ownerInput.value = "www-data";
        groupInput.value = "www-data";
        targetPathInput.value = "/var/www/html";
        additionalPathsInput.value = "";

        recursiveInput.checked = true;
        verboseInput.checked = false;
        changesOnlyInput.checked = false;
        noDereferenceInput.checked = false;
        preserveRootInput.checked = true;
        useSudoInput.checked = true;

        symlinkTraversalInput.value = "-P";
        fromOwnerInput.value = "";
        fromGroupInput.value = "";
        referencePathInput.value = "";

        updateFieldVisibility();
        generateCommand();
      }

      function resetForm() {
        document.querySelector(
          'input[name="operation"][value="owner-group"]'
        ).checked = true;

        ownerInput.value = "appuser";
        groupInput.value = "appgroup";
        targetPathInput.value = "/opt/my-application";
        additionalPathsInput.value = "";

        recursiveInput.checked = true;
        verboseInput.checked = false;
        changesOnlyInput.checked = false;
        noDereferenceInput.checked = false;
        preserveRootInput.checked = true;
        useSudoInput.checked = true;

        symlinkTraversalInput.value = "";
        fromOwnerInput.value = "";
        fromGroupInput.value = "";
        referencePathInput.value = "";

        updateFieldVisibility();
        generateCommand();
      }

      async function copyText(text) {
        if (!text) {
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          copyStatus.textContent = "Copied successfully.";
        } catch (error) {
          copyStatus.textContent =
            "Copy failed. Please select and copy the command manually.";
        }

        window.setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      document
        .querySelectorAll('input[name="operation"]')
        .forEach((radio) => {
          radio.addEventListener("change", () => {
            updateFieldVisibility();
            generateCommand();
          });
        });

      [
        ownerInput,
        groupInput,
        targetPathInput,
        additionalPathsInput,
        recursiveInput,
        verboseInput,
        changesOnlyInput,
        noDereferenceInput,
        preserveRootInput,
        useSudoInput,
        symlinkTraversalInput,
        fromOwnerInput,
        fromGroupInput,
        referencePathInput,
      ].forEach((element) => {
        element.addEventListener("input", generateCommand);
        element.addEventListener("change", generateCommand);
      });

      verboseInput.addEventListener("change", () => {
        if (verboseInput.checked) {
          changesOnlyInput.checked = false;
        }

        generateCommand();
      });

      changesOnlyInput.addEventListener("change", () => {
        if (changesOnlyInput.checked) {
          verboseInput.checked = false;
        }

        generateCommand();
      });

      document
        .getElementById("generate")
        ?.addEventListener("click", generateCommand);

      document
        .getElementById("load-example")
        ?.addEventListener("click", loadExample);

      document
        .getElementById("reset")
        ?.addEventListener("click", resetForm);

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const targetId = button.dataset.copyTarget;
            const target = targetId
              ? document.getElementById(targetId)
              : null;

            copyText(target?.textContent?.trim() ?? "");
          });
        });

      updateFieldVisibility();
      generateCommand();
    </script>
  </body>
</html>