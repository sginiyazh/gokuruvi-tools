---
const pageTitle = "Linux Ownership Command Generator";
const description =
  "Generate Linux chown and chgrp commands to change file and directory ownership.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle} | Gokuruvi Tools</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: #f5f7fb;
        color: #0f172a;
        font-family: Arial, Helvetica, sans-serif;
      }

      header {
        background: #0f172a;
        padding: 18px 24px;
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1100px;
        margin: auto;
      }

      nav a {
        color: white;
        text-decoration: none;
      }

      .brand {
        font-size: 20px;
        font-weight: 700;
      }

      .nav-links {
        display: flex;
        gap: 22px;
      }

      main {
        max-width: 1050px;
        margin: 50px auto;
        padding: 0 20px;
      }

      .intro {
        margin-bottom: 32px;
        text-align: center;
      }

      .intro h1 {
        margin-bottom: 12px;
        font-size: 38px;
      }

      .intro p {
        color: #475569;
        line-height: 1.7;
      }

      .generator {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
      }

      .panel {
        padding: 28px;
        border-radius: 14px;
        background: white;
        box-shadow: 0 10px 30px rgb(15 23 42 / 8%);
      }

      .panel h2 {
        margin-top: 0;
      }

      .form-group {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin-bottom: 7px;
        font-weight: 700;
      }

      input,
      select {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: white;
        color: #0f172a;
        font: inherit;
      }

      small {
        display: block;
        margin-top: 6px;
        color: #64748b;
        line-height: 1.5;
      }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
      }

      .checkbox-row input {
        width: 18px;
        height: 18px;
      }

      .checkbox-row label {
        margin: 0;
        cursor: pointer;
      }

      .output-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
      }

      .output-header h2 {
        margin: 0;
      }

      .command-box {
        min-height: 100px;
        padding: 20px;
        border-radius: 10px;
        background: #0f172a;
        color: #e2e8f0;
      }

      .command-box code {
        display: block;
        overflow-x: auto;
        font-family: Consolas, monospace;
        font-size: 17px;
        line-height: 1.7;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .explanation-box {
        margin-top: 18px;
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        line-height: 1.6;
      }

      .warning {
        margin-top: 18px;
        padding: 16px;
        border-left: 4px solid #f59e0b;
        border-radius: 6px;
        background: #fffbeb;
        color: #78350f;
        line-height: 1.6;
      }

      button {
        padding: 10px 16px;
        border: 0;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
      }

      .copy-button {
        background: #2563eb;
        color: white;
      }

      .reset-button {
        margin-top: 20px;
        background: #e2e8f0;
        color: #0f172a;
      }

      .information {
        margin-top: 35px;
        padding: 28px;
        border-radius: 14px;
        background: white;
        line-height: 1.7;
      }

      .information code {
        padding: 2px 6px;
        border-radius: 4px;
        background: #e2e8f0;
      }

      table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 12px;
        border: 1px solid #e2e8f0;
        text-align: left;
      }

      th {
        background: #f1f5f9;
      }

      footer {
        margin-top: 50px;
        padding: 24px;
        background: #0f172a;
        color: white;
        text-align: center;
      }

      @media (max-width: 800px) {
        .generator {
          grid-template-columns: 1fr;
        }

        .nav-links {
          display: none;
        }
      }

      @media (max-width: 520px) {
        .intro h1 {
          font-size: 30px;
        }

        .output-header {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <a class="brand" href="/">Gokuruvi Tools</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/linux">Linux</a>
          <a href="/devops">DevOps</a>
          <a href="/kubernetes">Kubernetes</a>
          <a href="/cloud">Cloud</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="intro">
        <h1>Linux Ownership Command Generator</h1>

        <p>
          Generate Linux <code>chown</code> and <code>chgrp</code> commands
          for files and directories.
        </p>
      </section>

      <section class="generator">
        <div class="panel">
          <h2>Ownership settings</h2>

          <div class="form-group">
            <label for="operation">Operation</label>

            <select id="operation">
              <option value="owner-group">
                Change owner and group
              </option>
              <option value="owner">Change owner only</option>
              <option value="group">Change group only</option>
            </select>
          </div>

          <div class="form-group" id="ownerGroup">
            <label for="owner">New owner</label>
            <input
              id="owner"
              type="text"
              value="appuser"
              placeholder="appuser"
            />
            <small>Example: root, apache, nginx or appuser</small>
          </div>

          <div class="form-group" id="groupGroup">
            <label for="group">New group</label>
            <input
              id="group"
              type="text"
              value="appgroup"
              placeholder="appgroup"
            />
            <small>Example: root, apache, nginx or appgroup</small>
          </div>

          <div class="form-group">
            <label for="targetPath">File or directory path</label>
            <input
              id="targetPath"
              type="text"
              value="/opt/myapp"
              placeholder="/opt/myapp"
            />
            <small>
              Use an absolute path and verify it before running the command.
            </small>
          </div>

          <div class="checkbox-row">
            <input id="recursive" type="checkbox" />
            <label for="recursive">
              Apply recursively to directories and their contents
            </label>
          </div>

          <div class="checkbox-row">
            <input id="sudo" type="checkbox" checked />
            <label for="sudo">Include sudo</label>
          </div>

          <div class="checkbox-row">
            <input id="verbose" type="checkbox" />
            <label for="verbose">
              Show changed files using verbose mode
            </label>
          </div>

          <div class="checkbox-row">
            <input id="preserveRoot" type="checkbox" checked />
            <label for="preserveRoot">
              Add --preserve-root for recursive changes
            </label>
          </div>

          <button id="resetButton" class="reset-button" type="button">
            Reset
          </button>
        </div>

        <div class="panel">
          <div class="output-header">
            <h2>Generated command</h2>

            <button id="copyButton" class="copy-button" type="button">
              Copy
            </button>
          </div>

          <div class="command-box">
            <code id="commandOutput"></code>
          </div>

          <div class="explanation-box">
            <strong>Command explanation</strong>
            <p id="commandExplanation"></p>
          </div>

          <div class="warning">
            <strong>Important:</strong>
            Recursive ownership changes can affect many files. Always verify
            the target path before executing the generated command.
          </div>
        </div>
      </section>

      <section class="information">
        <h2>Common ownership commands</h2>

        <table>
          <thead>
            <tr>
              <th>Command</th>
              <th>Purpose</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td><code>chown user file</code></td>
              <td>Change the owner of a file.</td>
            </tr>

            <tr>
              <td><code>chown user:group file</code></td>
              <td>Change both the owner and group.</td>
            </tr>

            <tr>
              <td><code>chgrp group file</code></td>
              <td>Change only the group ownership.</td>
            </tr>

            <tr>
              <td><code>chown -R user:group directory</code></td>
              <td>
                Change ownership recursively for a directory and its contents.
              </td>
            </tr>
          </tbody>
        </table>

        <h2>Examples</h2>

        <p>
          Change ownership of one directory:
        </p>

        <p>
          <code>sudo chown appuser:appgroup /opt/myapp</code>
        </p>

        <p>
          Change ownership recursively:
        </p>

        <p>
          <code>
            sudo chown -R --preserve-root appuser:appgroup /opt/myapp
          </code>
        </p>

        <p>
          Avoid running recursive ownership commands against paths such as
          <code>/</code>, <code>/etc</code>, <code>/usr</code>, or
          <code>/var</code> unless you fully understand the impact.
        </p>
      </section>
    </main>

    <footer>
      © 2026 Gokuruvi Tools. All rights reserved.
    </footer>

    <script>
      const operation = document.querySelector("#operation");
      const owner = document.querySelector("#owner");
      const group = document.querySelector("#group");
      const targetPath = document.querySelector("#targetPath");

      const ownerGroup = document.querySelector("#ownerGroup");
      const groupGroup = document.querySelector("#groupGroup");

      const recursive = document.querySelector("#recursive");
      const sudo = document.querySelector("#sudo");
      const verbose = document.querySelector("#verbose");
      const preserveRoot = document.querySelector("#preserveRoot");

      const commandOutput = document.querySelector("#commandOutput");
      const commandExplanation =
        document.querySelector("#commandExplanation");

      const copyButton = document.querySelector("#copyButton");
      const resetButton = document.querySelector("#resetButton");

      const fields = [
        operation,
        owner,
        group,
        targetPath,
        recursive,
        sudo,
        verbose,
        preserveRoot
      ];

      function shellQuote(value) {
        const trimmed = value.trim();

        if (!trimmed) {
          return "''";
        }

        if (/^[a-zA-Z0-9_./:@+-]+$/.test(trimmed)) {
          return trimmed;
        }

        return `'${trimmed.replaceAll("'", `'\\''`)}'`;
      }

      function updateVisibleFields() {
        ownerGroup.hidden = operation.value === "group";
        groupGroup.hidden = operation.value === "owner";
      }

      function generateCommand() {
        updateVisibleFields();

        const selectedOperation = operation.value;
        const prefix = sudo.checked ? "sudo " : "";
        const path = shellQuote(targetPath.value || "/path/to/file");

        const options = [];

        if (recursive.checked) {
          options.push("-R");

          if (preserveRoot.checked) {
            options.push("--preserve-root");
          }
        }

        if (verbose.checked) {
          options.push("-v");
        }

        const optionText =
          options.length > 0 ? `${options.join(" ")} ` : "";

        let command = "";
        let explanation = "";

        if (selectedOperation === "owner-group") {
          const ownership =
            `${owner.value.trim() || "user"}:` +
            `${group.value.trim() || "group"}`;

          command =
            `${prefix}chown ${optionText}${ownership} ${path}`;

          explanation =
            `Changes the owner to "${owner.value.trim() || "user"}" ` +
            `and the group to "${group.value.trim() || "group"}".`;
        }

        if (selectedOperation === "owner") {
          const newOwner = owner.value.trim() || "user";

          command =
            `${prefix}chown ${optionText}${newOwner} ${path}`;

          explanation =
            `Changes the owner to "${newOwner}" without intentionally ` +
            `changing the current group.`;
        }

        if (selectedOperation === "group") {
          const newGroup = group.value.trim() || "group";

          command =
            `${prefix}chgrp ${optionText}${newGroup} ${path}`;

          explanation =
            `Changes the group ownership to "${newGroup}".`;
        }

        if (recursive.checked) {
          explanation +=
            " The change applies recursively to the directory contents.";
        }

        if (verbose.checked) {
          explanation +=
            " Verbose output displays each processed file.";
        }

        commandOutput.textContent = command;
        commandExplanation.textContent = explanation;
      }

      fields.forEach((field) => {
        field?.addEventListener("input", generateCommand);
        field?.addEventListener("change", generateCommand);
      });

      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            commandOutput.textContent ?? ""
          );

          copyButton.textContent = "Copied";

          setTimeout(() => {
            copyButton.textContent = "Copy";
          }, 1500);
        } catch {
          copyButton.textContent = "Copy failed";
        }
      });

      resetButton?.addEventListener("click", () => {
        operation.value = "owner-group";
        owner.value = "appuser";
        group.value = "appgroup";
        targetPath.value = "/opt/myapp";
        recursive.checked = false;
        sudo.checked = true;
        verbose.checked = false;
        preserveRoot.checked = true;

        generateCommand();
      });

      generateCommand();
    </script>
  </body>
</html>