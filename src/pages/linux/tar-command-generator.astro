---
import Header from "../../components/Header.astro";
const pageTitle = "Tar Command Generator | Gokuruvi Tools";
const pageDescription =
  "Generate Linux tar commands to create, extract, list and verify archives with gzip, bzip2, xz and zstd compression.";
const siteUrl =
  "https://www.gokuruvi.com/linux/tar-command-generator";
import Footer from "../../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />

    <meta
      name="keywords"
      content="tar command generator, Linux tar generator, tar.gz command, extract tar file, create tar archive, gzip, bzip2, xz, zstd"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Gokuruvi Tools" />

    <meta
      property="og:image"
      content="https://www.gokuruvi.com/og-image.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --secondary: #38bdf8;
        --dark: #0f172a;
        --text: #172033;
        --muted: #64748b;
        --background: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --maximum-width: 1180px;

        font-family: Inter, Arial, Helvetica, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      a {
        color: inherit;
      }

      code,
      pre {
        font-family: Consolas, "Courier New", monospace;
      }

      .container {
        width: min(100% - 40px, var(--maximum-width));
        margin-inline: auto;
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 9999;
        padding: 10px 16px;
        border-radius: 8px;
        background: #ffffff;
        color: var(--dark);
        font-weight: 800;
        text-decoration: none;
        transform: translateY(-160%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.45);
        outline-offset: 3px;
      }

      /* Header */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.97);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .navbar {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 21px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
      }

      .logo-icon {
        display: grid;
        width: 39px;
        height: 39px;
        place-items: center;
        border-radius: 10px;
        background: linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );
        color: #ffffff;
        box-shadow: 0 8px 22px rgba(37, 99, 235, 0.35);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-links a {
        color: #e2e8f0;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: #ffffff;
      }

      .nav-button {
        padding: 10px 18px;
        border-radius: 9px;
        background: var(--primary);
        color: #ffffff !important;
      }

      /* Breadcrumb */

      .breadcrumb-section {
        border-bottom: 1px solid var(--border);
        background: #ffffff;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        padding: 15px 0;
        color: var(--muted);
        font-size: 14px;
      }

      .breadcrumb a {
        color: var(--primary);
        font-weight: 700;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      /* Hero */

      .hero {
        padding: 75px 0 68px;
        background:
          radial-gradient(
            circle at 15% 15%,
            rgba(56, 189, 248, 0.18),
            transparent 31%
          ),
          radial-gradient(
            circle at 88% 35%,
            rgba(37, 99, 235, 0.17),
            transparent 34%
          ),
          linear-gradient(
            145deg,
            #f8fafc 0%,
            #eff6ff 50%,
            #f8fafc 100%
          );
      }

      .hero-content {
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
      }

      .hero-icon {
        display: grid;
        width: 72px;
        height: 72px;
        place-items: center;
        margin: 0 auto 20px;
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        background: rgba(255, 255,255, 0.9);
        font-size: 36px;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.14);
      }

      .hero h1 {
        margin: 0 0 18px;
        color: var(--dark);
        font-size: clamp(40px, 7vw, 62px);
        line-height: 1.08;
        letter-spacing: -2px;
      }

      .hero h1 span {
        background: linear-gradient(
          90deg,
          var(--primary),
          #0284c7
        );
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }

      .hero p {
        max-width: 770px;
        margin: 0 auto;
        color: #475569;
        font-size: 19px;
        line-height: 1.8;
      }

      /* Generator */

      .generator-section {
        padding: 75px 0;
      }

      .generator-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.85fr);
        gap: 28px;
        align-items: start;
      }

      .generator-card,
      .result-card,
      .info-card {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--card);
        box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
      }

      .generator-card {
        padding: 30px;
      }

      .generator-heading {
        margin-bottom: 28px;
      }

      .generator-heading h2 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 27px;
      }

      .generator-heading p {
        margin: 0;
        color: var(--muted);
      }

      .operation-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 11px;
      }

      .operation-card {
        position: relative;
        cursor: pointer;
      }

      .operation-card input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .operation-content {
        display: block;
        min-height: 105px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #ffffff;
        text-align: center;
      }

      .operation-card input:checked + .operation-content {
        border-color: var(--primary);
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
      }

      .operation-icon {
        display: block;
        margin-bottom: 7px;
        font-size: 25px;
      }

      .operation-title {
        display: block;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .operation-description {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 11px;
      }

      .form-section {
        margin-bottom: 30px;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--border);
      }

      .form-section:last-of-type {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: 0;
      }

      .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: var(--dark);
        font-size: 19px;
      }

      .section-number {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 8px;
        background: #eff6ff;
        color: var(--primary-dark);
        font-size: 13px;
        font-weight: 800;
      }

      .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .form-field {
        min-width: 0;
      }

      .form-field.full-width {
        grid-column: 1 / -1;
      }

      .field-label {
        display: block;
        margin-bottom: 8px;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .field-input,
      .field-select,
      .field-textarea {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        background: #ffffff;
        color: var(--dark);
      }

      .field-input,
      .field-select {
        min-height: 48px;
        padding: 0 13px;
      }

      .field-textarea {
        min-height: 100px;
        padding: 12px 13px;
        resize: vertical;
      }

      .field-input:focus,
      .field-select:focus,
      .field-textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      }

      .field-help {
        display: block;
        margin-top: 7px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f8fafc;
      }

      .checkbox-item input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: var(--primary);
      }

      .checkbox-title {
        display: block;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
      }

      .checkbox-description {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
      }

      .preset-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      .preset-button {
        min-height: 41px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: var(--dark);
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
      }

      .preset-button:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      .action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 28px;
      }

      .action-button {
        min-height: 46px;
        padding: 0 19px;
        border-radius: 10px;
        font-weight: 800;
        cursor: pointer;
      }

      .action-primary {
        border: 0;
        background: var(--primary);
        color: #ffffff;
      }

      .action-primary:hover {
        background: var(--primary-dark);
      }

      .action-secondary {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: var(--dark);
      }

      .action-secondary:hover {
        border-color: var(--primary);
        background: #eff6ff;
      }

      /* Results */

      .results-column {
        position: sticky;
        top: 95px;
        display: grid;
        gap: 20px;
      }

      .result-card {
        padding: 26px;
      }

      .result-card h2 {
        margin: 0 0 20px;
        color: var(--dark);
        font-size: 23px;
      }

      .result-label {
        display: block;
        margin-bottom: 7px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .result-output {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        min-height: 90px;
        padding: 15px;
        border: 1px solid #334155;
        border-radius: 11px;
        background: #0b1220;
      }

      .result-value {
        overflow-wrap: anywhere;
        color: #dbeafe;
        font-family: Consolas, "Courier New", monospace;
        font-size: 15px;
        font-weight: 700;
        white-space: pre-wrap;
      }

      .copy-button {
        flex: 0 0 auto;
        padding: 7px 11px;
        border: 1px solid #475569;
        border-radius: 8px;
        background: #1e293b;
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
      }

      .copy-button:hover {
        background: #334155;
      }

      .warning-box {
        margin-top: 16px;
        padding: 14px;
        border: 1px solid #fde68a;
        border-radius: 11px;
        background: #fffbeb;
        color: #92400e;
        font-size: 14px;
      }

      .status-message {
        min-height: 22px;
        margin-top: 12px;
        color: var(--success);
        font-size: 14px;
        font-weight: 700;
      }

      .summary-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .summary-list li {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f8fafc;
        color: var(--muted);
        font-size: 14px;
      }

      .summary-list strong {
        color: var(--dark);
        text-align: right;
      }

      /* Information */

      .info-section {
        padding: 0 0 85px;
      }

      .section-heading {
        max-width: 760px;
        margin: 0 auto 45px;
        text-align: center;
      }

      .section-heading h2 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: clamp(30px, 4vw, 42px);
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 18px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .info-card {
        padding: 27px;
      }

      .info-card h3 {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 20px;
      }

      .info-card p,
      .info-card li {
        color: var(--muted);
        line-height: 1.75;
      }

      .info-card ul {
        margin: 12px 0 0;
        padding-left: 20px;
      }

      footer {
        background: var(--dark);
        color: #cbd5e1;
      }

      .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 28px 0;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      @media (max-width: 980px) {
        .generator-layout {
          grid-template-columns: 1fr;
        }

        .results-column {
          position: static;
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .navbar {
          min-height: auto;
          align-items: flex-start;
          flex-direction: column;
          padding: 17px 0;
        }

        .nav-links {
          width: 100%;
          flex-wrap: wrap;
          gap: 15px 20px;
        }
      }

      @media (max-width: 720px) {
        .operation-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 620px) {
        .container {
          width: min(100% - 28px, var(--maximum-width));
        }

        .hero {
          padding: 60px 0 55px;
        }

        .hero h1 {
          font-size: 40px;
          letter-spacing: -1.3px;
        }

        .generator-card,
        .result-card {
          padding: 22px;
        }

        .field-grid,
        .checkbox-grid,
        .operation-grid {
          grid-template-columns: 1fr;
        }

        .action-row {
          flex-direction: column;
        }

        .action-button {
          width: 100%;
        }

        .result-output {
          flex-direction: column;
        }

        .summary-list li {
          flex-direction: column;
          gap: 3px;
        }

        .summary-list strong {
          text-align: left;
        }

        .footer-content {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <Header />

    <div class="breadcrumb-section">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/linux">Linux Tools</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Tar Command Generator</span>
        </nav>
      </div>
    </div>

    <main id="main-content">
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-icon" aria-hidden="true">📦</div>

            <h1>
              Tar Command <span>Generator</span>
            </h1>

            <p>
              Generate Linux <code>tar</code> commands for creating,
              extracting, listing and verifying archive files. Configure
              compression, exclusions, destination directories and file
              ownership options.
            </p>
          </div>
        </div>
      </section>

      <section class="generator-section">
        <div class="container">
          <div class="generator-layout">
            <div class="generator-card">
              <div class="generator-heading">
                <h2>Configure your tar command</h2>

                <p>
                  Choose an operation and enter the archive details. The command
                  preview updates automatically.
                </p>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">1</span>
                  Select operation
                </h3>

                <div class="operation-grid">
                  <label class="operation-card">
                    <input
                      type="radio"
                      name="operation"
                      value="create"
                      checked
                    />

                    <span class="operation-content">
                      <span class="operation-icon">📦</span>
                      <span class="operation-title">Create</span>
                      <span class="operation-description">
                        Create a new archive
                      </span>
                    </span>
                  </label>

                  <label class="operation-card">
                    <input
                      type="radio"
                      name="operation"
                      value="extract"
                    />

                    <span class="operation-content">
                      <span class="operation-icon">📂</span>
                      <span class="operation-title">Extract</span>
                      <span class="operation-description">
                        Extract archive contents
                      </span>
                    </span>
                  </label>

                  <label class="operation-card">
                    <input
                      type="radio"
                      name="operation"
                      value="list"
                    />

                    <span class="operation-content">
                      <span class="operation-icon">📋</span>
                      <span class="operation-title">List</span>
                      <span class="operation-description">
                        Display archive contents
                      </span>
                    </span>
                  </label>

                  <label class="operation-card">
                    <input
                      type="radio"
                      name="operation"
                      value="append"
                    />

                    <span class="operation-content">
                      <span class="operation-icon">➕</span>
                      <span class="operation-title">Append</span>
                      <span class="operation-description">
                        Add files to an archive
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">2</span>
                  Archive settings
                </h3>

                <div class="field-grid">
                  <div class="form-field full-width">
                    <label class="field-label" for="archive-file">
                      Archive file
                    </label>

                    <input
                      class="field-input"
                      id="archive-file"
                      type="text"
                      value="/backup/application-backup.tar.gz"
                      placeholder="/path/to/archive.tar.gz"
                    />

                    <span class="field-help">
                      The extension is automatically updated when compression is
                      changed.
                    </span>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="compression">
                      Compression
                    </label>

                    <select class="field-select" id="compression">
                      <option value="none">No compression (.tar)</option>
                      <option value="gzip" selected>Gzip (.tar.gz)</option>
                      <option value="bzip2">Bzip2 (.tar.bz2)</option>
                      <option value="xz">XZ (.tar.xz)</option>
                      <option value="zstd">Zstandard (.tar.zst)</option>
                    </select>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="compression-level">
                      Compression level
                    </label>

                    <select class="field-select" id="compression-level">
                      <option value="">Default level</option>
                      <option value="1">1 — Fastest</option>
                      <option value="3">3 — Fast</option>
                      <option value="6">6 — Balanced</option>
                      <option value="9">9 — Maximum</option>
                    </select>

                    <span class="field-help">
                      Uses an external compression program when selected.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section" id="source-section">
                <h3 class="form-section-title">
                  <span class="section-number">3</span>
                  Source files and directories
                </h3>

                <div class="field-grid">
                  <div class="form-field">
                    <label class="field-label" for="base-directory">
                      Change to directory
                    </label>

                    <input
                      class="field-input"
                      id="base-directory"
                      type="text"
                      value="/opt"
                      placeholder="/opt"
                    />

                    <span class="field-help">
                      Adds <code>-C</code> before source paths.
                    </span>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="source-path">
                      Primary source
                    </label>

                    <input
                      class="field-input"
                      id="source-path"
                      type="text"
                      value="my-application"
                      placeholder="directory-or-file"
                    />
                  </div>

                  <div class="form-field full-width">
                    <label class="field-label" for="additional-sources">
                      Additional sources
                    </label>

                    <textarea
                      class="field-textarea"
                      id="additional-sources"
                      placeholder="config&#10;data&#10;README.md"
                    ></textarea>

                    <span class="field-help">
                      Enter one additional file or directory per line.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section" id="destination-section" hidden>
                <h3 class="form-section-title">
                  <span class="section-number">3</span>
                  Extraction settings
                </h3>

                <div class="field-grid">
                  <div class="form-field full-width">
                    <label class="field-label" for="destination">
                      Destination directory
                    </label>

                    <input
                      class="field-input"
                      id="destination"
                      type="text"
                      value="/restore"
                      placeholder="/path/to/destination"
                    />
                  </div>

                  <div class="form-field full-width">
                    <label class="field-label" for="extract-pattern">
                      Extract only matching path
                    </label>

                    <input
                      class="field-input"
                      id="extract-pattern"
                      type="text"
                      placeholder="path/inside/archive"
                    />

                    <span class="field-help">
                      Leave empty to extract the entire archive.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">4</span>
                  Exclusion filters
                </h3>

                <div class="field-grid">
                  <div class="form-field full-width">
                    <label class="field-label" for="exclude-patterns">
                      Exclude patterns
                    </label>

                    <textarea
                      class="field-textarea"
                      id="exclude-patterns"
                      placeholder="*.log&#10;cache/*&#10;node_modules"
                    ></textarea>

                    <span class="field-help">
                      Enter one exclusion pattern per line. Used mainly when
                      creating an archive.
                    </span>
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="exclude-file">
                      Exclude patterns file
                    </label>

                    <input
                      class="field-input"
                      id="exclude-file"
                      type="text"
                      placeholder="/path/to/exclude-list.txt"
                    />
                  </div>

                  <div class="form-field">
                    <label class="field-label" for="newer-than">
                      Include files newer than
                    </label>

                    <input
                      class="field-input"
                      id="newer-than"
                      type="text"
                      placeholder="2026-07-01"
                    />

                    <span class="field-help">
                      Generates the <code>--newer</code> option.
                    </span>
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">5</span>
                  Command options
                </h3>

                <div class="checkbox-grid">
                  <label class="checkbox-item">
                    <input id="verbose" type="checkbox" checked />

                    <span>
                      <span class="checkbox-title">Verbose output</span>
                      <span class="checkbox-description">
                        Display files while processing.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="preserve-permissions" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Preserve permissions
                      </span>
                      <span class="checkbox-description">
                        Preserve file permissions during extraction.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="same-owner" type="checkbox" />

                    <span>
                      <span class="checkbox-title">Preserve owner</span>
                      <span class="checkbox-description">
                        Attempt to preserve stored file ownership.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="numeric-owner" type="checkbox" />

                    <span>
                      <span class="checkbox-title">Numeric owner</span>
                      <span class="checkbox-description">
                        Store or display numeric UID and GID values.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="one-filesystem" type="checkbox" />

                    <span>
                      <span class="checkbox-title">One filesystem</span>
                      <span class="checkbox-description">
                        Do not cross filesystem boundaries.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="ignore-failed-read" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Ignore failed reads
                      </span>
                      <span class="checkbox-description">
                        Continue when some files cannot be read.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="overwrite" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Overwrite existing files
                      </span>
                      <span class="checkbox-description">
                        Overwrite files during extraction.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="keep-old-files" type="checkbox" />

                    <span>
                      <span class="checkbox-title">
                        Keep existing files
                      </span>
                      <span class="checkbox-description">
                        Refuse to replace existing files.
                      </span>
                    </span>
                  </label>

                  <label class="checkbox-item">
                    <input id="use-sudo" type="checkbox" />

                    <span>
                      <span class="checkbox-title">Include sudo</span>
                      <span class="checkbox-description">
                        Prefix the generated command with sudo.
                      </span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <h3 class="form-section-title">
                  <span class="section-number">6</span>
                  Common examples
                </h3>

                <div class="preset-list">
                  <button
                    class="preset-button"
                    type="button"
                    data-preset="create-gzip"
                  >
                    Create tar.gz
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="extract-gzip"
                  >
                    Extract tar.gz
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="list"
                  >
                    List archive
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="backup-etc"
                  >
                    Backup /etc
                  </button>

                  <button
                    class="preset-button"
                    type="button"
                    data-preset="exclude-logs"
                  >
                    Exclude logs
                  </button>
                </div>
              </div>

              <div class="action-row">
                <button
                  class="action-button action-primary"
                  id="generate"
                  type="button"
                >
                  Generate Tar Command
                </button>

                <button
                  class="action-button action-secondary"
                  id="reset"
                  type="button"
                >
                  Reset
                </button>
              </div>
            </div>

            <aside class="results-column" aria-label="Generated command">
              <div class="result-card">
                <h2>Generated tar command</h2>

                <span class="result-label">Command</span>

                <div class="result-output">
                  <span class="result-value" id="command-result">
                    tar -czvf '/backup/application-backup.tar.gz' -C '/opt' 'my-application'
                  </span>

                  <button
                    class="copy-button"
                    type="button"
                    data-copy-target="command-result"
                  >
                    Copy
                  </button>
                </div>

                <div class="warning-box" id="warning-box">
                  Verify the archive path and source directory before running
                  the command.
                </div>

                <div
                  class="status-message"
                  id="copy-status"
                  role="status"
                  aria-live="polite"
                ></div>
              </div>

              <div class="result-card">
                <h2>Command summary</h2>

                <ul class="summary-list">
                  <li>
                    <span>Operation</span>
                    <strong id="summary-operation">Create</strong>
                  </li>

                  <li>
                    <span>Compression</span>
                    <strong id="summary-compression">Gzip</strong>
                  </li>

                  <li>
                    <span>Archive</span>
                    <strong id="summary-archive">
                      /backup/application-backup.tar.gz
                    </strong>
                  </li>

                  <li>
                    <span>Sources</span>
                    <strong id="summary-sources">1</strong>
                  </li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="info-section">
        <div class="container">
          <div class="section-heading">
            <h2>Understanding Linux tar commands</h2>

            <p>
              The <code>tar</code> command combines files and directories into
              archive files and can optionally compress them.
            </p>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <h3>Common tar options</h3>

              <ul>
                <li><code>-c</code> creates a new archive.</li>
                <li><code>-x</code> extracts an archive.</li>
                <li><code>-t</code> lists archive contents.</li>
                <li><code>-f</code> specifies the archive file.</li>
                <li><code>-v</code> enables verbose output.</li>
              </ul>
            </article>

            <article class="info-card">
              <h3>Compression options</h3>

              <ul>
                <li><code>-z</code> uses gzip compression.</li>
                <li><code>-j</code> uses bzip2 compression.</li>
                <li><code>-J</code> uses xz compression.</li>
                <li>
                  <code>--zstd</code> uses Zstandard compression.
                </li>
              </ul>
            </article>

            <article class="info-card">
              <h3>Common examples</h3>

              <ul>
                <li>
                  <code>tar -czvf backup.tar.gz directory/</code>
                </li>
                <li>
                  <code>tar -xzvf backup.tar.gz</code>
                </li>
                <li>
                  <code>tar -tzvf backup.tar.gz</code>
                </li>
                <li>
                  <code>tar -czvf backup.tar.gz --exclude="*.log" app/</code>
                </li>
              </ul>
            </article>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      const fieldIds = [
        "archive-file",
        "compression",
        "compression-level",
        "base-directory",
        "source-path",
        "additional-sources",
        "destination",
        "extract-pattern",
        "exclude-patterns",
        "exclude-file",
        "newer-than",
      ];

      const checkboxIds = [
        "verbose",
        "preserve-permissions",
        "same-owner",
        "numeric-owner",
        "one-filesystem",
        "ignore-failed-read",
        "overwrite",
        "keep-old-files",
        "use-sudo",
      ];

      const commandResult =
        document.getElementById("command-result");

      const warningBox =
        document.getElementById("warning-box");

      const copyStatus =
        document.getElementById("copy-status");

      const sourceSection =
        document.getElementById("source-section");

      const destinationSection =
        document.getElementById("destination-section");

      const compressionInput =
        document.getElementById("compression");

      const compressionLevelInput =
        document.getElementById("compression-level");

      const archiveInput =
        document.getElementById("archive-file");

      const overwriteInput =
        document.getElementById("overwrite");

      const keepOldFilesInput =
        document.getElementById("keep-old-files");

      function getValue(id) {
        return document.getElementById(id)?.value?.trim() ?? "";
      }

      function isChecked(id) {
        return Boolean(document.getElementById(id)?.checked);
      }

      function getOperation() {
        return (
          document.querySelector(
            'input[name="operation"]:checked'
          )?.value || "create"
        );
      }

      function shellQuote(value) {
        const text = value.trim();

        if (!text) {
          return "''";
        }

        return `'${text.replaceAll("'", "'\\''")}'`;
      }

      function getSources() {
        const sources = [];
        const primarySource = getValue("source-path");

        if (primarySource) {
          sources.push(primarySource);
        }

        getValue("additional-sources")
          .split(/\r?\n/)
          .map((source) => source.trim())
          .filter(Boolean)
          .forEach((source) => sources.push(source));

        return [...new Set(sources)];
      }

      function getCompressionLabel(value) {
        const labels = {
          none: "None",
          gzip: "Gzip",
          bzip2: "Bzip2",
          xz: "XZ",
          zstd: "Zstandard",
        };

        return labels[value] || "None";
      }

      function getOperationLabel(value) {
        const labels = {
          create: "Create",
          extract: "Extract",
          list: "List",
          append: "Append",
        };

        return labels[value] || "Create";
      }

      function updateOperationUI() {
        const operation = getOperation();

        const showSources =
          operation === "create" || operation === "append";

        const showDestination = operation === "extract";

        sourceSection.hidden = !showSources;
        destinationSection.hidden = !showDestination;

        compressionInput.disabled = operation === "append";
        compressionLevelInput.disabled =
          operation === "append" ||
          compressionInput.value === "none";

        if (operation === "append") {
          compressionInput.value = "none";
        }

        generateCommand();
      }

      function updateArchiveExtension() {
        const compression = compressionInput.value;
        let archivePath = archiveInput.value.trim();

        const extensions = [
          ".tar.gz",
          ".tgz",
          ".tar.bz2",
          ".tbz2",
          ".tar.xz",
          ".txz",
          ".tar.zst",
          ".tar",
        ];

        for (const extension of extensions) {
          if (archivePath.toLowerCase().endsWith(extension)) {
            archivePath = archivePath.slice(0, -extension.length);
            break;
          }
        }

        const extensionMap = {
          none: ".tar",
          gzip: ".tar.gz",
          bzip2: ".tar.bz2",
          xz: ".tar.xz",
          zstd: ".tar.zst",
        };

        archiveInput.value =
          `${archivePath || "/backup/archive"}${extensionMap[compression]}`;

        compressionLevelInput.disabled = compression === "none";
      }

      function buildCompressionOptions(compression, level) {
        if (!level) {
          const simpleOptions = {
            none: [],
            gzip: ["-z"],
            bzip2: ["-j"],
            xz: ["-J"],
            zstd: ["--zstd"],
          };

          return simpleOptions[compression] || [];
        }

        const programOptions = {
          gzip: `gzip -${level}`,
          bzip2: `bzip2 -${level}`,
          xz: `xz -${level}`,
          zstd: `zstd -${level}`,
        };

        if (!programOptions[compression]) {
          return [];
        }

        return [
          `--use-compress-program=${shellQuote(
            programOptions[compression]
          )}`,
        ];
      }

      function generateCommand() {
        const operation = getOperation();
        const compression = getValue("compression") || "none";
        const compressionLevel = getValue("compression-level");
        const archiveFile =
          getValue("archive-file") || "/path/to/archive.tar";

        const parts = [];

        if (isChecked("use-sudo")) {
          parts.push("sudo");
        }

        parts.push("tar");

        const operationOptions = {
          create: "-c",
          extract: "-x",
          list: "-t",
          append: "-r",
        };

        parts.push(operationOptions[operation] || "-c");

        if (isChecked("verbose")) {
          parts.push("-v");
        }

        if (operation !== "append") {
          parts.push(
            ...buildCompressionOptions(
              compression,
              compressionLevel
            )
          );
        }

        if (isChecked("preserve-permissions")) {
          parts.push("-p");
        }

        if (isChecked("same-owner")) {
          parts.push("--same-owner");
        }

        if (isChecked("numeric-owner")) {
          parts.push("--numeric-owner");
        }

        if (isChecked("one-filesystem")) {
          parts.push("--one-file-system");
        }

        if (isChecked("ignore-failed-read")) {
          parts.push("--ignore-failed-read");
        }

        if (operation === "extract") {
          if (isChecked("overwrite")) {
            parts.push("--overwrite");
          }

          if (isChecked("keep-old-files")) {
            parts.push("--keep-old-files");
          }
        }

        if (operation === "create" || operation === "append") {
          getValue("exclude-patterns")
            .split(/\r?\n/)
            .map((pattern) => pattern.trim())
            .filter(Boolean)
            .forEach((pattern) => {
              parts.push(`--exclude=${shellQuote(pattern)}`);
            });

          const excludeFile = getValue("exclude-file");

          if (excludeFile) {
            parts.push(`--exclude-from=${shellQuote(excludeFile)}`);
          }

          const newerThan = getValue("newer-than");

          if (newerThan) {
            parts.push(`--newer=${shellQuote(newerThan)}`);
          }
        }

        parts.push("-f", shellQuote(archiveFile));

        if (operation === "create" || operation === "append") {
          const baseDirectory = getValue("base-directory");
          const sources = getSources();

          if (baseDirectory) {
            parts.push("-C", shellQuote(baseDirectory));
          }

          if (sources.length > 0) {
            parts.push(...sources.map(shellQuote));
          } else {
            parts.push(shellQuote("."));
          }
        }

        if (operation === "extract") {
          const destination = getValue("destination");

          if (destination) {
            parts.push("-C", shellQuote(destination));
          }

          const extractPattern = getValue("extract-pattern");

          if (extractPattern) {
            parts.push(shellQuote(extractPattern));
          }
        }

        const command = parts.join(" ");

        commandResult.textContent = command;

        document.getElementById(
          "summary-operation"
        ).textContent = getOperationLabel(operation);

        document.getElementById(
          "summary-compression"
        ).textContent =
          operation === "append"
            ? "None required"
            : getCompressionLabel(compression);

        document.getElementById(
          "summary-archive"
        ).textContent = archiveFile;

        document.getElementById(
          "summary-sources"
        ).textContent =
          operation === "create" || operation === "append"
            ? String(getSources().length || 1)
            : "Not applicable";

        if (
          operation === "extract" &&
          isChecked("overwrite")
        ) {
          warningBox.textContent =
            "Warning: existing files may be overwritten during extraction.";
          warningBox.style.borderColor = "#fecaca";
          warningBox.style.background = "#fef2f2";
          warningBox.style.color = "#991b1b";
        } else if (operation === "append") {
          warningBox.textContent =
            "Appending is supported only for uncompressed tar archives. Compressed archives cannot be updated directly.";
          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        } else {
          warningBox.textContent =
            "Verify the archive path and source or destination directory before running the command.";
          warningBox.style.borderColor = "#fde68a";
          warningBox.style.background = "#fffbeb";
          warningBox.style.color = "#92400e";
        }
      }

      function resetForm() {
        document.querySelector(
          'input[name="operation"][value="create"]'
        ).checked = true;

        const values = {
          "archive-file":
            "/backup/application-backup.tar.gz",
          compression: "gzip",
          "compression-level": "",
          "base-directory": "/opt",
          "source-path": "my-application",
          "additional-sources": "",
          destination: "/restore",
          "extract-pattern": "",
          "exclude-patterns": "",
          "exclude-file": "",
          "newer-than": "",
        };

        Object.entries(values).forEach(([id, value]) => {
          const element = document.getElementById(id);

          if (element) {
            element.value = value;
          }
        });

        document.getElementById("verbose").checked = true;
        document.getElementById(
          "preserve-permissions"
        ).checked = false;
        document.getElementById("same-owner").checked = false;
        document.getElementById("numeric-owner").checked = false;
        document.getElementById("one-filesystem").checked = false;
        document.getElementById(
          "ignore-failed-read"
        ).checked = false;
        document.getElementById("overwrite").checked = false;
        document.getElementById("keep-old-files").checked = false;
        document.getElementById("use-sudo").checked = false;

        updateOperationUI();
      }

      function loadPreset(preset) {
        resetForm();

        if (preset === "create-gzip") {
          document.getElementById(
            "archive-file"
          ).value = "/backup/project.tar.gz";

          document.getElementById(
            "compression"
          ).value = "gzip";

          document.getElementById(
            "base-directory"
          ).value = "/opt";

          document.getElementById(
            "source-path"
          ).value = "project";
        }

        if (preset === "extract-gzip") {
          document.querySelector(
            'input[name="operation"][value="extract"]'
          ).checked = true;

          document.getElementById(
            "archive-file"
          ).value = "/backup/project.tar.gz";

          document.getElementById(
            "compression"
          ).value = "gzip";

          document.getElementById(
            "destination"
          ).value = "/restore";
        }

        if (preset === "list") {
          document.querySelector(
            'input[name="operation"][value="list"]'
          ).checked = true;

          document.getElementById(
            "archive-file"
          ).value = "/backup/project.tar.gz";

          document.getElementById(
            "compression"
          ).value = "gzip";
        }

        if (preset === "backup-etc") {
          document.getElementById(
            "archive-file"
          ).value = "/backup/etc-backup.tar.gz";

          document.getElementById(
            "compression"
          ).value = "gzip";

          document.getElementById(
            "base-directory"
          ).value = "/";

          document.getElementById(
            "source-path"
          ).value = "etc";

          document.getElementById(
            "use-sudo"
          ).checked = true;
        }

        if (preset === "exclude-logs") {
          document.getElementById(
            "archive-file"
          ).value = "/backup/application.tar.gz";

          document.getElementById(
            "base-directory"
          ).value = "/opt";

          document.getElementById(
            "source-path"
          ).value = "my-application";

          document.getElementById(
            "exclude-patterns"
          ).value = "*.log\ncache/*\nnode_modules";
        }

        updateOperationUI();
      }

      async function copyText(text) {
        if (!text) {
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          copyStatus.textContent =
            "Tar command copied successfully.";
        } catch {
          copyStatus.textContent =
            "Copy failed. Please select and copy the command manually.";
        }

        window.setTimeout(() => {
          copyStatus.textContent = "";
        }, 2500);
      }

      document
        .querySelectorAll('input[name="operation"]')
        .forEach((radio) => {
          radio.addEventListener("change", updateOperationUI);
        });

      fieldIds.forEach((id) => {
        const element = document.getElementById(id);

        element?.addEventListener("input", generateCommand);

        element?.addEventListener("change", () => {
          if (id === "compression") {
            updateArchiveExtension();
          }

          generateCommand();
        });
      });

      checkboxIds.forEach((id) => {
        document
          .getElementById(id)
          ?.addEventListener("change", generateCommand);
      });

      overwriteInput.addEventListener("change", () => {
        if (overwriteInput.checked) {
          keepOldFilesInput.checked = false;
        }

        generateCommand();
      });

      keepOldFilesInput.addEventListener("change", () => {
        if (keepOldFilesInput.checked) {
          overwriteInput.checked = false;
        }

        generateCommand();
      });

      document
        .querySelectorAll(".preset-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const preset = button.dataset.preset;

            if (preset) {
              loadPreset(preset);
            }
          });
        });

      document
        .getElementById("generate")
        ?.addEventListener("click", generateCommand);

      document
        .getElementById("reset")
        ?.addEventListener("click", resetForm);

      document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const targetId = button.dataset.copyTarget;
            const target = targetId
              ? document.getElementById(targetId)
              : null;

            copyText(target?.textContent?.trim() ?? "");
          });
        });

      updateOperationUI();
    </script>
  </body>
</html>