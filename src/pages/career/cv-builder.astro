---
import ToolGuide from "../../components/ToolGuide.astro";
import { careerGuides } from "../../data/toolGuides";
import Layout from "../../layouts/Layout.astro";
import "../../styles/ai-tools.css";

// Target roles for the keyword check. Keep each list to the terms recruiters and ATS filters
// actually search for in that role, not every tool in the field.
const roles = [
  ["linux", "Linux / System Administrator"],
  ["devops", "DevOps Engineer"],
  ["cloud", "Cloud Engineer (AWS / Azure)"],
  ["kubernetes", "Kubernetes / Platform Engineer"],
  ["network", "Network Engineer"],
  ["windows", "Windows / Active Directory Administrator"],
  ["vmware", "VMware / Virtualization Engineer"],
  ["database", "Database Administrator"],
  ["security", "Security Engineer"],
  ["support", "IT Support / Service Desk"],
];
---
<Layout title="IT CV Builder & ATS Checker" description="Free IT CV builder and ATS checker for Linux, DevOps, cloud, network and security jobs. Build an ATS-friendly CV, check role keywords and save it as PDF. Runs in your browser.">
  <section class="ai-hero"><div class="ai-container"><span class="ai-badge">Career Tool</span><h1>IT CV Builder &amp; ATS Checker</h1><p>Build a clean, ATS-friendly CV for Linux, DevOps, cloud, network and security roles, then check it against the keywords recruiters search for. Everything stays in your browser.</p></div></section>
  <section class="ai-section"><div class="ai-container">
    <div class="ai-note"><strong>Privacy:</strong> your CV is never uploaded. The draft is saved only in this browser so you can come back to it. Use Clear all on a shared computer.</div>

    <div class="cvb-layout">
      <form class="ai-panel cvb-form" id="cvForm" autocomplete="off">
        <div class="cvb-toolbar">
          <button class="ai-button secondary" id="cvSample" type="button">Load example</button>
          <button class="ai-button secondary" id="cvClear" type="button">Clear all</button>
        </div>

        <fieldset>
          <legend>Target role</legend>
          <div class="ai-field full"><label for="cvRole">Role you are applying for</label>
            <select id="cvRole">{roles.map(([value, label]) => <option value={value}>{label}</option>)}</select>
            <span class="ai-muted">Used for the keyword check. Paste a job advert below for a closer match.</span>
          </div>
          <div class="ai-field full"><label for="cvJobAd">Job advert (optional)</label><textarea id="cvJobAd" rows="4" placeholder="Paste the job description to find skills it asks for that your CV doesn't mention."></textarea></div>
        </fieldset>

        <fieldset>
          <legend>Contact details</legend>
          <div class="ai-grid">
            <div class="ai-field"><label for="cvName">Full name</label><input id="cvName" type="text" /></div>
            <div class="ai-field"><label for="cvTitle">Professional title</label><input id="cvTitle" type="text" placeholder="e.g. Senior Linux Administrator" /></div>
            <div class="ai-field"><label for="cvLocation">Location</label><input id="cvLocation" type="text" placeholder="e.g. Dubai, UAE" /></div>
            <div class="ai-field"><label for="cvEmail">Email</label><input id="cvEmail" type="email" /></div>
            <div class="ai-field"><label for="cvPhone">Phone</label><input id="cvPhone" type="tel" placeholder="e.g. +971 50 000 0000" /></div>
            <div class="ai-field"><label for="cvLinkedin">LinkedIn or portfolio URL</label><input id="cvLinkedin" type="url" /></div>
            <div class="ai-field"><label for="cvVisa">Visa status (optional)</label><input id="cvVisa" type="text" placeholder="e.g. Employment visa, transferable" /></div>
            <div class="ai-field"><label for="cvNotice">Notice period (optional)</label><input id="cvNotice" type="text" placeholder="e.g. 30 days" /></div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Summary and skills</legend>
          <div class="ai-field full"><label for="cvSummary">Professional summary</label><textarea id="cvSummary" rows="4" placeholder="3–4 sentences: years of experience, main platforms, and the result you are best at."></textarea></div>
          <div class="ai-field full"><label for="cvSkills">Technical skills</label><textarea id="cvSkills" rows="3" placeholder="Comma-separated, e.g. RHEL, Ubuntu, Bash, Ansible, Nginx, Zabbix"></textarea></div>
        </fieldset>

        <fieldset>
          <legend>Work experience</legend>
          <div id="cvJobs"></div>
          <button class="ai-button secondary" id="cvAddJob" type="button">+ Add a job</button>
        </fieldset>

        <fieldset>
          <legend>Certifications and education</legend>
          <div class="ai-field full"><label for="cvCerts">Certifications (one per line)</label><textarea id="cvCerts" rows="3" placeholder="e.g. Red Hat Certified System Administrator (RHCSA), 2023"></textarea></div>
          <div class="ai-field full"><label for="cvEducation">Education (one per line)</label><textarea id="cvEducation" rows="2" placeholder="e.g. B.E. Computer Science, Anna University, 2014"></textarea></div>
        </fieldset>
      </form>

      <div class="cvb-side">
        <div class="ai-panel cvb-score-panel" aria-live="polite">
          <div class="cvb-score-head"><span>ATS check</span><strong id="cvScore">0%</strong></div>
          <div class="ai-meter"><span id="cvScoreBar" style="width:0%"></span></div>
          <ul class="cvb-checks" id="cvChecks"></ul>
          <div class="cvb-kw">
            <p><strong>Role keywords found</strong></p><div id="cvKwFound" class="cvb-chips"></div>
            <p><strong>Missing keywords to consider</strong> <span class="ai-muted">(only add skills you really have)</span></p><div id="cvKwMissing" class="cvb-chips"></div>
            <div id="cvAdBlock" hidden><p><strong>Asked for in the job advert but not in your CV</strong></p><div id="cvAdMissing" class="cvb-chips"></div></div>
          </div>
        </div>

        <div class="cvb-preview-head">
          <strong>CV preview</strong>
          <div class="cvb-preview-actions">
            <button class="ai-button" id="cvPrint" type="button">Save as PDF</button>
            <button class="ai-button secondary" id="cvCopy" type="button">Copy as text</button>
          </div>
        </div>
        <article class="cvb-preview" id="cvPreview"></article>
        <p class="ai-muted">Save as PDF opens your browser's print window. Choose "Save as PDF" as the printer.</p>
      </div>
    </div>

    <ToolGuide guide={careerGuides["cv-builder"]} />
  </div></section>
</Layout>

<style is:global>
  .cvb-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; align-items: start; margin-top: 22px; }
  .cvb-form fieldset { margin: 0 0 22px; padding: 0; border: 0; min-width: 0; }
  .cvb-form legend { margin-bottom: 10px; color: #0f172a; font-size: 1.05rem; font-weight: 800; }
  .cvb-form .ai-field { margin-bottom: 12px; }
  .cvb-form input, .cvb-form select, .cvb-form textarea { box-sizing: border-box; width: 100%; max-width: 100%; }
  .cvb-toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .cvb-job { position: relative; margin-bottom: 14px; padding: 16px; border: 1px solid #dbe4f0; border-radius: 12px; background: #f8fafc; }
  .cvb-job-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .cvb-remove { padding: 6px 10px; border: 1px solid #fecaca; border-radius: 8px; background: #fff; color: #b91c1c; font-weight: 700; cursor: pointer; }
  .cvb-side { position: sticky; top: 90px; display: grid; gap: 14px; min-width: 0; }
  .cvb-score-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; font-weight: 800; color: #0f172a; }
  .cvb-score-head strong { font-size: 1.8rem; }
  .cvb-checks { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 7px; font-size: .9rem; }
  .cvb-checks li { display: grid; grid-template-columns: 22px 1fr; gap: 6px; color: #334155; line-height: 1.45; }
  .cvb-checks li span:first-child { font-weight: 900; }
  .cvb-checks .ok span:first-child { color: #15803d; }
  .cvb-checks .warn span:first-child { color: #b45309; }
  .cvb-kw p { margin: 14px 0 6px; font-size: .9rem; color: #0f172a; }
  .cvb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .cvb-chip { padding: 3px 9px; border-radius: 999px; font-size: .78rem; font-weight: 700; }
  .cvb-chip.found { background: #dcfce7; color: #166534; }
  .cvb-chip.missing { background: #fef3c7; color: #92400e; }
  .cvb-preview-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .cvb-preview-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .cvb-preview { min-height: 320px; padding: 32px 34px; border: 1px solid #dbe4f0; border-radius: 6px; background: #fff; box-shadow: 0 10px 30px rgba(15, 23, 42, .07); color: #111827; font: 14px/1.5 Arial, Helvetica, sans-serif; overflow-wrap: anywhere; }
  .cvb-preview .cv-name { margin: 0; font-size: 24px; font-weight: 700; }
  .cvb-preview .cv-title { margin: 2px 0 6px; color: #1f2937; font-size: 15px; font-weight: 700; }
  .cvb-preview .cv-contact { margin: 0; color: #374151; font-size: 13px; }
  .cvb-preview .cv-section { margin: 18px 0 6px; padding-bottom: 3px; border-bottom: 1px solid #9ca3af; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .cvb-preview .cv-job-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin-top: 10px; font-weight: 700; }
  .cvb-preview .cv-job-sub { margin: 0; color: #374151; font-size: 13px; }
  .cvb-preview ul { margin: 4px 0 0; padding-left: 18px; }
  .cvb-preview p { margin: 0 0 4px; }
  .cvb-preview .cv-empty { color: #94a3b8; text-align: center; padding: 60px 10px; }
  @media (max-width: 980px) {
    .cvb-layout { grid-template-columns: 1fr; }
    .cvb-side { position: static; }
  }
  @media (max-width: 560px) {
    .cvb-preview { padding: 20px 16px; }
  }
  @media print {
    body * { visibility: hidden !important; }
    #cvPreview, #cvPreview * { visibility: visible !important; }
    #cvPreview { position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 0; border: 0; box-shadow: none; }
    @page { margin: 14mm; }
  }
</style>

<script is:inline>
(function () {
  var ROLE_KEYWORDS = {
    linux: ["Linux", "RHEL", "Ubuntu", "Bash", "shell scripting", "systemd", "SELinux", "LVM", "Ansible", "Nginx", "Apache", "patching", "backup", "monitoring", "Zabbix", "SSH", "firewall", "troubleshooting", "performance tuning", "cron"],
    devops: ["CI/CD", "Jenkins", "GitHub Actions", "GitLab", "Docker", "Kubernetes", "Terraform", "Ansible", "Git", "Linux", "Python", "Bash", "AWS", "Azure", "Prometheus", "Grafana", "Helm", "monitoring", "infrastructure as code", "automation"],
    cloud: ["AWS", "Azure", "GCP", "EC2", "S3", "VPC", "IAM", "Terraform", "CloudFormation", "Kubernetes", "Docker", "Linux", "networking", "security groups", "cost optimization", "high availability", "backup", "migration", "monitoring", "automation"],
    kubernetes: ["Kubernetes", "Docker", "Helm", "kubectl", "Ingress", "RBAC", "Prometheus", "Grafana", "CI/CD", "Terraform", "Linux", "EKS", "AKS", "GKE", "service mesh", "autoscaling", "GitOps", "Argo CD", "monitoring", "troubleshooting"],
    network: ["TCP/IP", "routing", "switching", "BGP", "OSPF", "VLAN", "firewall", "VPN", "Cisco", "Fortinet", "Palo Alto", "DNS", "DHCP", "load balancer", "Wireshark", "network security", "SD-WAN", "troubleshooting", "monitoring", "subnetting"],
    windows: ["Windows Server", "Active Directory", "Group Policy", "PowerShell", "DNS", "DHCP", "Exchange", "Microsoft 365", "Azure AD", "Entra ID", "Hyper-V", "IIS", "WSUS", "SCCM", "Intune", "backup", "patching", "troubleshooting", "file server", "security"],
    vmware: ["VMware", "vSphere", "ESXi", "vCenter", "vSAN", "NSX", "vMotion", "HA", "DRS", "PowerCLI", "storage", "SAN", "backup", "Veeam", "capacity planning", "Linux", "Windows Server", "patching", "troubleshooting", "disaster recovery"],
    database: ["SQL", "MySQL", "PostgreSQL", "SQL Server", "Oracle", "backup", "restore", "replication", "high availability", "performance tuning", "indexing", "query optimization", "monitoring", "security", "migration", "Linux", "scripting", "disaster recovery", "patching", "capacity planning"],
    security: ["SIEM", "SOC", "incident response", "vulnerability management", "firewall", "IAM", "ISO 27001", "NIST", "penetration testing", "endpoint security", "EDR", "threat hunting", "Splunk", "network security", "cloud security", "risk assessment", "compliance", "Linux", "scripting", "hardening"],
    support: ["help desk", "service desk", "ITIL", "ticketing", "ServiceNow", "Windows", "Microsoft 365", "Active Directory", "troubleshooting", "hardware", "networking", "printers", "remote support", "SLA", "customer service", "documentation", "onboarding", "VPN", "antivirus", "backup"],
  };
  var ACTION_VERBS = ["achieved", "administered", "automated", "built", "configured", "consolidated", "cut", "decreased", "delivered", "deployed", "designed", "developed", "diagnosed", "documented", "eliminated", "established", "hardened", "implemented", "improved", "increased", "installed", "integrated", "introduced", "led", "maintained", "managed", "mentored", "migrated", "modernized", "monitored", "optimized", "patched", "planned", "reduced", "resolved", "restored", "saved", "scaled", "secured", "streamlined", "supported", "trained", "troubleshot", "upgraded", "wrote"];
  var WEAK_STARTS = [/^responsible for\b/i, /^worked (on|in|with)\b/i, /^helped\b/i, /^involved in\b/i, /^assisted\b/i, /^duties (include|included)\b/i, /^handled\b/i, /^tasked with\b/i];
  var STORE_KEY = "gokuruvi-cv-builder-v1";
  var FIELDS = ["cvRole", "cvJobAd", "cvName", "cvTitle", "cvLocation", "cvEmail", "cvPhone", "cvLinkedin", "cvVisa", "cvNotice", "cvSummary", "cvSkills", "cvCerts", "cvEducation"];

  var $ = function (id) { return document.getElementById(id); };
  var jobsEl = $("cvJobs");
  var preview = $("cvPreview");

  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function lines(s) { return (s || "").split("\n").map(function (x) { return x.replace(/^[\s•\-*]+/, "").trim(); }).filter(Boolean); }
  function words(s) { return (s || "").trim().split(/\s+/).filter(Boolean).length; }
  function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
  function has(text, term) { return new RegExp("(^|[^a-z0-9])" + escapeRe(term.toLowerCase()) + "($|[^a-z0-9])").test(text); }

  // ---- jobs ----
  function addJob(job) {
    job = job || {};
    var box = el("div", "cvb-job");
    var head = el("div", "cvb-job-head");
    head.appendChild(el("strong", "", "Job"));
    var rm = el("button", "cvb-remove", "Remove");
    rm.type = "button";
    rm.addEventListener("click", function () { box.remove(); numberJobs(); update(); });
    head.appendChild(rm);
    box.appendChild(head);
    var grid = el("div", "ai-grid");
    [["title", "Job title", "e.g. Linux Administrator"], ["company", "Company", "e.g. Example Hosting LLC"], ["location", "Location", "e.g. Dubai, UAE"], ["dates", "Dates", "e.g. Mar 2021 – Present"]].forEach(function (f) {
      var wrap = el("div", "ai-field");
      var id = "job-" + f[0] + "-" + Math.random().toString(36).slice(2, 8);
      var lab = el("label", "", f[1]); lab.htmlFor = id;
      var inp = el("input"); inp.type = "text"; inp.id = id; inp.dataset.k = f[0]; inp.placeholder = f[2]; inp.value = job[f[0]] || "";
      wrap.appendChild(lab); wrap.appendChild(inp); grid.appendChild(wrap);
    });
    box.appendChild(grid);
    var bw = el("div", "ai-field full");
    var bid = "job-bullets-" + Math.random().toString(36).slice(2, 8);
    var bl = el("label", "", "Achievements (one per line)"); bl.htmlFor = bid;
    var ta = el("textarea"); ta.id = bid; ta.rows = 5; ta.dataset.k = "bullets"; ta.value = job.bullets || "";
    ta.placeholder = "Start with an action verb and add a number, e.g. Automated patching for 120 RHEL servers with Ansible, cutting maintenance time by 60%";
    bw.appendChild(bl); bw.appendChild(ta); box.appendChild(bw);
    jobsEl.appendChild(box);
    numberJobs();
  }
  function numberJobs() {
    [].forEach.call(jobsEl.querySelectorAll(".cvb-job"), function (box, i) { box.querySelector(".cvb-job-head strong").textContent = "Job " + (i + 1); });
  }

  // ---- read the form ----
  function collect() {
    var d = {};
    FIELDS.forEach(function (id) { d[id] = $(id).value; });
    d.jobs = [].map.call(jobsEl.querySelectorAll(".cvb-job"), function (box) {
      var j = {};
      [].forEach.call(box.querySelectorAll("[data-k]"), function (inp) { j[inp.dataset.k] = inp.value; });
      return j;
    });
    return d;
  }
  function fill(d) {
    FIELDS.forEach(function (id) { if (d[id] !== undefined) $(id).value = d[id]; });
    jobsEl.innerHTML = "";
    (d.jobs && d.jobs.length ? d.jobs : [{}]).forEach(addJob);
  }

  // ---- preview ----
  function render(d) {
    preview.innerHTML = "";
    var anything = d.cvName || d.cvSummary || d.cvSkills || d.jobs.some(function (j) { return j.title || j.bullets; });
    if (!anything) { preview.appendChild(el("p", "cv-empty", "Your CV preview appears here as you type. Click Load example to see a finished CV.")); return; }
    preview.appendChild(el("p", "cv-name", d.cvName || "Your Name"));
    if (d.cvTitle) preview.appendChild(el("p", "cv-title", d.cvTitle));
    var contact = [d.cvLocation, d.cvPhone, d.cvEmail, d.cvLinkedin].filter(Boolean).join("  |  ");
    if (contact) preview.appendChild(el("p", "cv-contact", contact));
    var extra = [d.cvVisa && "Visa: " + d.cvVisa, d.cvNotice && "Notice period: " + d.cvNotice].filter(Boolean).join("  |  ");
    if (extra) preview.appendChild(el("p", "cv-contact", extra));
    if (d.cvSummary.trim()) { preview.appendChild(el("p", "cv-section", "Professional Summary")); preview.appendChild(el("p", "", d.cvSummary.trim())); }
    var skills = d.cvSkills.split(",").map(function (s) { return s.trim(); }).filter(Boolean);
    if (skills.length) { preview.appendChild(el("p", "cv-section", "Technical Skills")); preview.appendChild(el("p", "", skills.join(" · "))); }
    var jobs = d.jobs.filter(function (j) { return j.title || j.company || j.bullets; });
    if (jobs.length) {
      preview.appendChild(el("p", "cv-section", "Work Experience"));
      jobs.forEach(function (j) {
        var line = el("div", "cv-job-line");
        line.appendChild(el("span", "", [j.title, j.company].filter(Boolean).join(", ")));
        line.appendChild(el("span", "", j.dates || ""));
        preview.appendChild(line);
        if (j.location) preview.appendChild(el("p", "cv-job-sub", j.location));
        var b = lines(j.bullets);
        if (b.length) { var ul = el("ul"); b.forEach(function (x) { ul.appendChild(el("li", "", x)); }); preview.appendChild(ul); }
      });
    }
    var certs = lines(d.cvCerts);
    if (certs.length) { preview.appendChild(el("p", "cv-section", "Certifications")); var cu = el("ul"); certs.forEach(function (x) { cu.appendChild(el("li", "", x)); }); preview.appendChild(cu); }
    var edu = lines(d.cvEducation);
    if (edu.length) { preview.appendChild(el("p", "cv-section", "Education")); edu.forEach(function (x) { preview.appendChild(el("p", "", x)); }); }
  }

  // ---- ATS checks ----
  function analyze(d) {
    var checks = [];
    var add = function (ok, text, weight) { checks.push({ ok: ok, text: text, w: weight }); };
    var bullets = [];
    d.jobs.forEach(function (j) { bullets = bullets.concat(lines(j.bullets)); });
    var all = [d.cvTitle, d.cvSummary, d.cvSkills, d.cvCerts, d.cvEducation].concat(d.jobs.map(function (j) { return [j.title, j.bullets].join(" "); })).join(" ").toLowerCase();
    var total = words([d.cvName, d.cvTitle, d.cvSummary, d.cvSkills, d.cvCerts, d.cvEducation].concat(d.jobs.map(function (j) { return [j.title, j.company, j.location, j.dates, j.bullets].join(" "); })).join(" "));

    add(!!(d.cvEmail && d.cvPhone), d.cvEmail && d.cvPhone ? "Email and phone are included." : "Add both an email address and a phone number.", 10);
    add(!!d.cvLinkedin, d.cvLinkedin ? "LinkedIn or portfolio link is included." : "Add a LinkedIn or portfolio link.", 5);
    var sw = words(d.cvSummary);
    add(sw >= 30 && sw <= 110, sw === 0 ? "Add a short professional summary (3–4 sentences)." : sw < 30 ? "Your summary is short (" + sw + " words). Aim for 30–110." : sw > 110 ? "Your summary is long (" + sw + " words). Keep it under about 110." : "Summary length is good (" + sw + " words).", 10);
    var sk = d.cvSkills.split(",").map(function (s) { return s.trim(); }).filter(Boolean).length;
    add(sk >= 8, sk >= 8 ? sk + " skills listed." : "List at least 8 relevant technical skills (you have " + sk + ").", 10);
    var jobsWithDates = d.jobs.filter(function (j) { return j.title || j.bullets; });
    var dated = jobsWithDates.every(function (j) { return (j.dates || "").trim(); });
    add(jobsWithDates.length > 0 && dated, jobsWithDates.length === 0 ? "Add at least one job." : dated ? "Every job has dates." : "Add dates to every job.", 10);
    if (bullets.length) {
      var weak = bullets.filter(function (b) { return WEAK_STARTS.some(function (r) { return r.test(b); }); });
      var verb = bullets.filter(function (b) { return ACTION_VERBS.indexOf(b.split(/\s+/)[0].toLowerCase().replace(/[^a-z]/g, "")) !== -1; });
      var nums = bullets.filter(function (b) { return /\d/.test(b); });
      var len = bullets.filter(function (b) { var n = words(b); return n < 6 || n > 35; });
      add(weak.length === 0, weak.length ? weak.length + " bullet(s) start with weak phrases like “Responsible for”. Start with what you did, e.g. “Automated…”." : "No weak bullet openings.", 10);
      add(verb.length / bullets.length >= 0.6, Math.round(verb.length / bullets.length * 100) + "% of bullets start with a strong action verb (aim for 60% or more).", 10);
      add(nums.length / bullets.length >= 0.4, Math.round(nums.length / bullets.length * 100) + "% of bullets include a number, such as servers, users, % or time saved (aim for 40% or more).", 15);
      add(len.length === 0, len.length ? len.length + " bullet(s) are very short or very long. Keep each to about 6–35 words." : "Bullet lengths are easy to scan.", 5);
    } else {
      add(false, "Add achievement bullets under each job.", 40);
    }
    var firstPerson = /(^|\s)(i|my|me)(\s|$)/i.test([d.cvSummary].concat(bullets).join(" "));
    add(!firstPerson, firstPerson ? "Avoid “I” and “my”. CVs are written without them." : "No first-person words.", 5);
    add(total >= 250 && total <= 1000, total < 250 ? "Your CV is short (" + total + " words). Most IT CVs are 400–900 words." : total > 1000 ? "Your CV is long (" + total + " words). Aim for 1–2 pages." : "Length looks like 1–2 pages (" + total + " words).", 5);

    var max = checks.reduce(function (s, c) { return s + c.w; }, 0);
    var got = checks.reduce(function (s, c) { return s + (c.ok ? c.w : 0); }, 0);
    var kws = ROLE_KEYWORDS[d.cvRole] || [];
    var found = kws.filter(function (k) { return has(all, k); });
    var missing = kws.filter(function (k) { return !has(all, k); });
    var kwScore = kws.length ? found.length / kws.length : 0;
    var score = Math.round((got / max) * 75 + kwScore * 25);

    var adMissing = [];
    if (d.cvJobAd.trim()) {
      var ad = d.cvJobAd.toLowerCase();
      var pool = [];
      Object.keys(ROLE_KEYWORDS).forEach(function (r) { ROLE_KEYWORDS[r].forEach(function (k) { if (pool.indexOf(k) === -1) pool.push(k); }); });
      adMissing = pool.filter(function (k) { return has(ad, k) && !has(all, k); });
    }
    return { checks: checks, score: score, found: found, missing: missing, adMissing: adMissing, hasAd: !!d.cvJobAd.trim() };
  }

  function chips(target, list, cls) {
    target.innerHTML = "";
    if (!list.length) { target.appendChild(el("span", "ai-muted", "None")); return; }
    list.forEach(function (k) { target.appendChild(el("span", "cvb-chip " + cls, k)); });
  }
  function showAnalysis(a) {
    $("cvScore").textContent = a.score + "%";
    $("cvScoreBar").style.width = a.score + "%";
    var ul = $("cvChecks");
    ul.innerHTML = "";
    a.checks.forEach(function (c) {
      var li = el("li", c.ok ? "ok" : "warn");
      li.appendChild(el("span", "", c.ok ? "✓" : "!"));
      li.appendChild(el("span", "", c.text));
      ul.appendChild(li);
    });
    chips($("cvKwFound"), a.found, "found");
    chips($("cvKwMissing"), a.missing, "missing");
    $("cvAdBlock").hidden = !a.hasAd;
    chips($("cvAdMissing"), a.adMissing, "missing");
  }

  // ---- save, update ----
  var saveTimer;
  function update() {
    var d = collect();
    render(d);
    showAnalysis(analyze(d));
    clearTimeout(saveTimer);
    // Keep a draft only while there is something in it, so Clear all leaves nothing behind.
    var empty = FIELDS.every(function (id) { return id === "cvRole" || !d[id].trim(); }) && d.jobs.every(function (j) { return !Object.keys(j).some(function (k) { return (j[k] || "").trim(); }); });
    saveTimer = setTimeout(function () { try { if (empty) localStorage.removeItem(STORE_KEY); else localStorage.setItem(STORE_KEY, JSON.stringify(d)); } catch (e) {} }, 400);
  }

  function plainText(d) {
    var out = [];
    out.push(d.cvName, d.cvTitle, [d.cvLocation, d.cvPhone, d.cvEmail, d.cvLinkedin].filter(Boolean).join(" | "));
    if (d.cvVisa || d.cvNotice) out.push([d.cvVisa && "Visa: " + d.cvVisa, d.cvNotice && "Notice period: " + d.cvNotice].filter(Boolean).join(" | "));
    if (d.cvSummary.trim()) out.push("", "PROFESSIONAL SUMMARY", d.cvSummary.trim());
    if (d.cvSkills.trim()) out.push("", "TECHNICAL SKILLS", d.cvSkills.split(",").map(function (s) { return s.trim(); }).filter(Boolean).join(", "));
    var jobs = d.jobs.filter(function (j) { return j.title || j.company || j.bullets; });
    if (jobs.length) {
      out.push("", "WORK EXPERIENCE");
      jobs.forEach(function (j) {
        out.push("", [j.title, j.company].filter(Boolean).join(", ") + (j.dates ? " (" + j.dates + ")" : ""));
        if (j.location) out.push(j.location);
        lines(j.bullets).forEach(function (b) { out.push("- " + b); });
      });
    }
    if (lines(d.cvCerts).length) { out.push("", "CERTIFICATIONS"); lines(d.cvCerts).forEach(function (c) { out.push("- " + c); }); }
    if (lines(d.cvEducation).length) { out.push("", "EDUCATION"); lines(d.cvEducation).forEach(function (e) { out.push(e); }); }
    return out.filter(function (x) { return x !== undefined; }).join("\n").replace(/\n{3,}/g, "\n\n").trim();
  }

  var SAMPLE = {
    cvRole: "linux", cvJobAd: "",
    cvName: "Example Candidate", cvTitle: "Senior Linux Administrator", cvLocation: "Dubai, UAE",
    cvEmail: "candidate@example.com", cvPhone: "+971 50 000 0000", cvLinkedin: "linkedin.com/in/example",
    cvVisa: "Employment visa, transferable", cvNotice: "30 days",
    cvSummary: "Linux administrator with 8 years of experience running RHEL and Ubuntu servers for hosting and enterprise environments. Automates patching, monitoring and backups with Ansible and Bash, and keeps production systems above 99.9% uptime. Comfortable leading incident response and mentoring junior engineers.",
    cvSkills: "RHEL, Ubuntu, Bash, shell scripting, Ansible, systemd, SELinux, LVM, Nginx, Apache, Zabbix, SSH, firewall, patching, backup, troubleshooting, VMware, Git",
    cvCerts: "Red Hat Certified System Administrator (RHCSA), 2022\nRed Hat Certified Engineer (RHCE), 2023",
    cvEducation: "B.E. Computer Science, 2015",
    jobs: [
      { title: "Senior Linux Administrator", company: "Example Hosting LLC", location: "Dubai, UAE", dates: "Mar 2021 – Present",
        bullets: "Automated monthly patching for 120 RHEL servers with Ansible, cutting the maintenance window from 6 hours to 2\nBuilt Zabbix monitoring and alerting for 300 hosts, reducing time to detect outages by 70%\nHardened SSH, sudo and firewalld across the estate, closing 40 audit findings in one quarter\nMentored 3 junior administrators and wrote 25 runbooks for common incidents" },
      { title: "Linux Administrator", company: "Example IT Services", location: "Chennai, India", dates: "Jun 2016 – Feb 2021",
        bullets: "Managed 80 Ubuntu and CentOS web servers running Nginx and Apache with 99.9% uptime\nMigrated 35 applications from physical servers to VMware, saving 40% in hardware costs\nWrote Bash scripts to automate backups and log rotation, saving about 5 hours a week" },
    ],
  };

  // ---- wire up ----
  $("cvAddJob").addEventListener("click", function () { addJob(); update(); });
  $("cvForm").addEventListener("input", update);
  $("cvForm").addEventListener("change", update);
  $("cvForm").addEventListener("submit", function (e) { e.preventDefault(); });
  $("cvSample").addEventListener("click", function () { fill(SAMPLE); update(); });
  $("cvClear").addEventListener("click", function () {
    if (!confirm("Clear the whole CV and the saved draft in this browser?")) return;
    try { localStorage.removeItem(STORE_KEY); } catch (e) {}
    fill({ cvRole: "linux", jobs: [] });
    FIELDS.forEach(function (id) { if (id !== "cvRole") $(id).value = ""; });
    update();
  });
  $("cvPrint").addEventListener("click", function () { window.print(); });
  $("cvCopy").addEventListener("click", function () {
    var btn = this, text = plainText(collect());
    var done = function (ok) { btn.textContent = ok ? "Copied" : "Copy failed"; setTimeout(function () { btn.textContent = "Copy as text"; }, 1600); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
    else done(false);
  });

  var saved = null;
  try { saved = JSON.parse(localStorage.getItem(STORE_KEY) || "null"); } catch (e) {}
  fill(saved || { cvRole: "linux", jobs: [] });
  update();
})();
</script>
