---
import ToolGuide from "../../components/ToolGuide.astro";
import { careerGuides } from "../../data/toolGuides";
import Layout from "../../layouts/Layout.astro";
import "../../styles/ai-tools.css";

import { cvRoleGroups, cvRoles, cvCommonSuggestions } from "../../data/cvRoles";

// Role data for the in-page script: keywords for the ATS check, templates for suggested bullets.
const roleKeywords = Object.fromEntries(cvRoles.map((r) => [r.id, r.keywords]));
const roleSuggestions = Object.fromEntries(cvRoles.map((r) => [r.id, r.suggestions]));
const commonSuggestions = cvCommonSuggestions;
---
<Layout title="Free CV Builder & ATS Checker" description="Free CV builder and ATS checker for IT, engineering, construction, finance, sales, HR, healthcare, teaching and more. Import your CV, fix weak bullets, check role keywords and save a professional PDF. Runs in your browser.">
  <section class="ai-hero"><div class="ai-container"><span class="ai-badge">Career Tool</span><h1>CV Builder &amp; ATS Checker</h1><p>Build a clean, ATS-friendly CV for IT, engineering, construction, finance, sales, HR, healthcare, teaching and more, then check it against the keywords recruiters search for. Everything stays in your browser.</p></div></section>
  <section class="ai-section"><div class="ai-container">
    <div class="ai-note"><strong>Privacy:</strong> your CV is never uploaded. The draft is saved only in this browser so you can come back to it. Use Clear all on a shared computer.</div>

    <div class="cvb-layout">
      <form class="ai-panel cvb-form" id="cvForm" autocomplete="off">
        <div class="cvb-toolbar">
          <button class="ai-button secondary" id="cvSample" type="button">Load example</button>
          <button class="ai-button secondary" id="cvClear" type="button">Clear all</button>
        </div>

        <fieldset class="cvb-import">
          <legend>Start from your existing CV (optional)</legend>
          <p class="ai-muted">Upload a PDF, Word (.docx) or text file and the form fills itself in. The file is read in your browser and never uploaded. CV layouts vary, so check every field afterwards.</p>
          <label class="cvb-file-label" for="cvFile">Choose your CV file</label>
          <input id="cvFile" class="cvb-file" type="file" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" />
          <button class="ai-button cvb-load" id="cvLoadFile" type="button" disabled>Load CV into the form</button>
          <details class="cvb-paste">
            <summary>Or paste your CV text instead</summary>
            <textarea id="cvPasteText" rows="6" placeholder="Copy all the text from your CV and paste it here."></textarea>
            <button class="ai-button secondary" id="cvPasteRead" type="button">Fill the form from this text</button>
          </details>
          <p id="cvImportStatus" class="cvb-import-status" role="status" aria-live="polite"></p>
          <details class="cvb-readtext" id="cvReadTextBox" hidden>
            <summary>See the text read from your file</summary>
            <p class="ai-muted">If something landed in the wrong field, copy it from here. This text stays in your browser.</p>
            <pre id="cvReadText"></pre>
          </details>
        </fieldset>

        <fieldset>
          <legend>Target role</legend>
          <div class="ai-field full"><label for="cvRole">Role you are applying for</label>
            <select id="cvRole">{cvRoleGroups.map((group) => (<optgroup label={group.label}>{group.roles.map((r) => <option value={r.id}>{r.label}</option>)}</optgroup>))}</select>
            <span class="ai-muted">Used for the keyword check. Paste a job advert below for a closer match.</span>
          </div>
          <div class="ai-field full"><label for="cvJobAd">Job advert (optional)</label><textarea id="cvJobAd" rows="4" placeholder="Paste the job description to find skills it asks for that your CV doesn't mention."></textarea></div>
        </fieldset>

        <fieldset>
          <legend>Contact details</legend>
          <div class="ai-grid">
            <div class="ai-field"><label for="cvName">Full name</label><input id="cvName" type="text" /></div>
            <div class="ai-field"><label for="cvTitle">Professional title</label><input id="cvTitle" type="text" placeholder="e.g. Senior Linux Administrator" /></div>
            <div class="ai-field"><label for="cvLocation">Location</label><input id="cvLocation" type="text" placeholder="e.g. Dubai, UAE" /></div>
            <div class="ai-field"><label for="cvEmail">Email</label><input id="cvEmail" type="email" /></div>
            <div class="ai-field"><label for="cvPhone">Phone</label><input id="cvPhone" type="tel" placeholder="e.g. +971 50 000 0000" /></div>
            <div class="ai-field"><label for="cvLinkedin">LinkedIn or portfolio URL</label><input id="cvLinkedin" type="url" /></div>
            <div class="ai-field"><label for="cvVisa">Visa status (optional)</label><input id="cvVisa" type="text" placeholder="e.g. Employment visa, transferable" /></div>
            <div class="ai-field"><label for="cvNotice">Notice period (optional)</label><input id="cvNotice" type="text" placeholder="e.g. 30 days" /></div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Summary and skills</legend>
          <div class="ai-field full"><label for="cvSummary">Professional summary</label><textarea id="cvSummary" rows="4" placeholder="3–4 sentences: years of experience, main platforms, and the result you are best at."></textarea></div>
          <div class="ai-field full"><label for="cvSkills">Technical skills</label><textarea id="cvSkills" rows="3" placeholder="Comma-separated, e.g. RHEL, Ubuntu, Bash, Ansible, Nginx, Zabbix"></textarea></div>
        </fieldset>

        <fieldset>
          <legend>Work experience</legend>
          <div id="cvJobs"></div>
          <button class="ai-button secondary" id="cvAddJob" type="button">+ Add a job</button>
        </fieldset>

        <fieldset>
          <legend>Certifications and education</legend>
          <div class="ai-field full"><label for="cvCerts">Certifications (one per line)</label><textarea id="cvCerts" rows="3" placeholder="e.g. Red Hat Certified System Administrator (RHCSA), 2023"></textarea></div>
          <div class="ai-field full"><label for="cvEducation">Education (one per line)</label><textarea id="cvEducation" rows="2" placeholder="e.g. B.E. Computer Science, Anna University, 2014"></textarea></div>
        </fieldset>
      </form>

      <div class="cvb-side">
        <div class="ai-panel cvb-score-panel" aria-live="polite">
          <div class="cvb-score-head"><span>ATS check</span><strong id="cvScore">0%</strong></div>
          <div class="ai-meter"><span id="cvScoreBar" style="width:0%"></span></div>
          <div class="cvb-fix">
            <button class="ai-button" id="cvAutoFix" type="button">Fix common issues automatically</button>
            <button class="ai-button secondary" id="cvUndoFix" type="button" hidden>Undo</button>
          </div>
          <p class="cvb-fix-result" id="cvFixResult" role="status" aria-live="polite"></p>
          <ul class="cvb-checks" id="cvChecks"></ul>
          <div class="cvb-kw">
            <p><strong>Role keywords found</strong></p><div id="cvKwFound" class="cvb-chips"></div>
            <p><strong>Missing keywords to consider</strong> <span class="ai-muted">(click to add, but only skills you really have)</span></p><div id="cvKwMissing" class="cvb-chips"></div>
            <div id="cvAdBlock" hidden><p><strong>Asked for in the job advert but not in your CV</strong></p><div id="cvAdMissing" class="cvb-chips"></div></div>
          </div>
          <details class="cvb-suggest" id="cvSuggestBox">
            <summary>Suggested achievement bullets for this role</summary>
            <p class="ai-muted">Pick one that matches work you have really done, add it, then replace every [placeholder] with your own facts and numbers.</p>
            <label class="cvb-suggest-label" for="cvSuggestJob">Add to</label>
            <select id="cvSuggestJob"></select>
            <ul class="cvb-suggest-list" id="cvSuggestList"></ul>
          </details>
        </div>

        <div class="cvb-preview-head">
          <strong>CV preview</strong>
          <div class="cvb-preview-actions">
            <button class="ai-button" id="cvPrint" type="button">Save as PDF</button>
            <button class="ai-button secondary" id="cvCopy" type="button">Copy as text</button>
          </div>
        </div>
        <div class="cvb-design" role="group" aria-label="CV design">
          <label for="cvTemplate">Design</label>
          <select id="cvTemplate">
            <option value="modern">Modern</option>
            <option value="classic">Classic</option>
            <option value="executive">Executive</option>
          </select>
          <div class="cvb-swatches" role="group" aria-label="Accent colour">
            {[["#1f3a5f", "Navy"], ["#1d4ed8", "Blue"], ["#0f766e", "Teal"], ["#15803d", "Green"], ["#9f1239", "Maroon"], ["#374151", "Charcoal"]].map(([hex, name]) => (
              <button class="cvb-swatch" type="button" data-accent={hex} aria-label={name} title={name} aria-pressed="false" style={`background:${hex}`}></button>
            ))}
          </div>
        </div>
        <div class="cvb-paper-wrap" id="cvPaperWrap"><article class="cvb-preview tpl-modern" id="cvPreview"></article></div>
        <p class="ai-muted cvb-paper-note">This is your CV on an A4 page, exactly as it will print. Dashed lines show roughly where pages break. Save as PDF opens your browser's print window; choose "Save as PDF" as the printer.</p>
      </div>
    </div>

    <ToolGuide guide={careerGuides["cv-builder"]} />
  </div></section>
</Layout>

<style is:global>
  .cvb-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; align-items: start; margin-top: 22px; }
  .cvb-form fieldset { margin: 0 0 22px; padding: 0; border: 0; min-width: 0; }
  .cvb-form legend { margin-bottom: 10px; color: #0f172a; font-size: 1.05rem; font-weight: 800; }
  .cvb-form .ai-field { margin-bottom: 12px; }
  .cvb-form input, .cvb-form select, .cvb-form textarea { box-sizing: border-box; width: 100%; max-width: 100%; }
  .cvb-toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
  .cvb-import { padding: 16px !important; border: 1px dashed #93c5fd !important; border-radius: 12px; background: #f8fbff; }
  .cvb-import legend { padding: 0 6px; }
  .cvb-import > p.ai-muted { margin: 0 0 12px; }
  .cvb-file-label { display: block; margin-bottom: 6px; color: #0f172a; font-weight: 700; }
  .cvb-file { width: 100%; max-width: 100%; color: #334155; }
  .cvb-file::file-selector-button { margin-right: 12px; padding: 10px 16px; border: 0; border-radius: 10px; background: #2563eb; color: #fff; font-weight: 800; cursor: pointer; }
  .cvb-file:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; border-radius: 10px; }
  .cvb-load { display: block; width: 100%; margin-top: 12px; }
  .cvb-load:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; transform: none; }
  .cvb-readtext { margin-top: 12px; }
  .cvb-readtext summary { color: #1d4ed8; font-weight: 700; cursor: pointer; }
  .cvb-readtext pre { max-height: 260px; margin: 8px 0 0; padding: 12px; overflow: auto; border: 1px solid #dbe4f0; border-radius: 10px; background: #fff; color: #334155; font: 12.5px/1.5 ui-monospace, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  .cvb-paste { margin-top: 12px; }
  .cvb-paste summary { color: #1d4ed8; font-weight: 700; cursor: pointer; }
  .cvb-paste textarea { margin: 10px 0; }
  .cvb-import-status { margin: 12px 0 0; font-size: .9rem; line-height: 1.5; }
  .cvb-import-status:empty { display: none; }
  .cvb-import-status[data-kind="ok"] { padding: 10px 12px; border-radius: 10px; background: #dcfce7; color: #166534; }
  .cvb-import-status[data-kind="warn"] { padding: 10px 12px; border-radius: 10px; background: #fef3c7; color: #92400e; }
  .cvb-job { position: relative; margin-bottom: 14px; padding: 16px; border: 1px solid #dbe4f0; border-radius: 12px; background: #f8fafc; }
  .cvb-job-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .cvb-remove { padding: 6px 10px; border: 1px solid #fecaca; border-radius: 8px; background: #fff; color: #b91c1c; font-weight: 700; cursor: pointer; }
  .cvb-side { position: sticky; top: 90px; display: grid; gap: 14px; min-width: 0; }
  .cvb-score-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; font-weight: 800; color: #0f172a; }
  .cvb-score-head strong { font-size: 1.8rem; }
  .cvb-checks { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 7px; font-size: .9rem; }
  .cvb-checks li { display: grid; grid-template-columns: 22px 1fr; gap: 6px; color: #334155; line-height: 1.45; }
  .cvb-checks li span:first-child { font-weight: 900; }
  .cvb-checks .ok span:first-child { color: #15803d; }
  .cvb-checks .warn span:first-child { color: #b45309; }
  .cvb-kw p { margin: 14px 0 6px; font-size: .9rem; color: #0f172a; }
  .cvb-fix { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .cvb-fix .ai-button { flex: 1 1 auto; }
  .cvb-fix-result { margin: 10px 0 0; font-size: .88rem; line-height: 1.5; }
  .cvb-fix-result:empty { display: none; }
  .cvb-fix-result[data-kind="ok"] { padding: 10px 12px; border-radius: 10px; background: #dcfce7; color: #166534; }
  .cvb-fix-result[data-kind="none"] { padding: 10px 12px; border-radius: 10px; background: #f1f5f9; color: #334155; }
  button.cvb-chip { border: 0; cursor: pointer; font-family: inherit; }
  button.cvb-chip.missing:hover, button.cvb-chip.missing:focus-visible { background: #fde68a; outline: 2px solid #f59e0b; outline-offset: 1px; }
  .cvb-suggest { margin-top: 16px; padding-top: 12px; border-top: 1px solid #e2e8f0; }
  .cvb-suggest summary { color: #1d4ed8; font-weight: 800; cursor: pointer; }
  .cvb-suggest > p { margin: 8px 0; font-size: .85rem; }
  .cvb-suggest-label { display: block; margin: 6px 0 4px; font-size: .85rem; font-weight: 700; color: #0f172a; }
  .cvb-suggest select { width: 100%; max-width: 100%; box-sizing: border-box; }
  .cvb-suggest-list { margin: 10px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .cvb-suggest-list li { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; padding: 9px 10px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: .86rem; line-height: 1.45; color: #334155; }
  .cvb-suggest-list button { padding: 6px 12px; border: 1px solid #93c5fd; border-radius: 8px; background: #eff6ff; color: #1d4ed8; font-weight: 800; cursor: pointer; }
  .cvb-suggest-list button:disabled { border-color: #bbf7d0; background: #dcfce7; color: #166534; cursor: default; }
  .cvb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .cvb-chip { padding: 3px 9px; border-radius: 999px; font-size: .78rem; font-weight: 700; }
  .cvb-chip.found { background: #dcfce7; color: #166534; }
  .cvb-chip.missing { background: #fef3c7; color: #92400e; }
  .cvb-preview-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .cvb-preview-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  /* Design picker */
  .cvb-design { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; }
  .cvb-design label { color: #0f172a; font-size: .9rem; font-weight: 800; }
  .cvb-design select { width: auto; min-width: 130px; }
  .cvb-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .cvb-swatch { width: 26px; height: 26px; padding: 0; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px #cbd5e1; cursor: pointer; }
  .cvb-swatch[aria-pressed="true"] { box-shadow: 0 0 0 2px #0f172a; }
  .cvb-swatch:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; }

  /* CV fonts, served from this site and loaded only when a design uses them (embedded in the PDF). */
  @font-face { font-family: "CV Inter"; src: url("/fonts/cv/inter.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: "CV Lato"; src: url("/fonts/cv/lato-400.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "CV Lato"; src: url("/fonts/cv/lato-700.woff2") format("woff2"); font-weight: 700; font-display: swap; }
  @font-face { font-family: "CV Garamond"; src: url("/fonts/cv/eb-garamond.woff2") format("woff2"); font-weight: 400 800; font-display: swap; }
  @font-face { font-family: "CV Garamond"; src: url("/fonts/cv/eb-garamond-italic.woff2") format("woff2"); font-weight: 400; font-style: italic; font-display: swap; }

  /* The preview is a real A4 page (794 x 1123 CSS px = 210 x 297 mm) scaled to fit, so it matches the PDF. */
  .cvb-paper-wrap { position: relative; overflow: hidden; border-radius: 4px; background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, .08), 0 18px 40px rgba(15, 23, 42, .12); }
  .cvb-paper-wrap .cvb-preview { width: 794px; min-height: 1123px; transform-origin: top left; }
  .cvb-page-break { position: absolute; left: 0; right: 0; height: 0; border-top: 1px dashed #94a3b8; pointer-events: none; }
  .cvb-page-break span { position: absolute; right: 6px; top: -9px; padding: 0 6px; border-radius: 999px; background: #e2e8f0; color: #475569; font: 600 10px/16px system-ui, sans-serif; }
  .cvb-paper-note { margin: 0; }

  /* CV designs: single column and real text, so ATS software reads every word.
     Letter-spacing stays at .06em or less; wider spacing makes PDF text read as "S U M M A R Y". */
  .cvb-preview { --cv-accent: #1f3a5f; --cv-ink: #111827; --cv-muted: #4b5563; box-sizing: border-box; padding: 53px 60px; background: #fff; color: var(--cv-ink); overflow-wrap: anywhere; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cvb-preview p { margin: 0 0 4px; }
  .cvb-preview .cv-empty { padding: 120px 20px; color: #94a3b8; font: 16px/1.6 system-ui, sans-serif; text-align: center; }
  .cvb-preview .cv-name { margin: 0; line-height: 1.12; }
  .cvb-preview .cv-contact { margin: 0; color: var(--cv-muted); }
  .cvb-preview .cv-sep { color: #9ca3af; }
  .cvb-preview .cv-job { margin-top: 13px; }
  .cvb-preview .cv-job-line { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 14px; }
  .cvb-preview .cv-job-title { font-weight: 700; }
  .cvb-preview .cv-dates { color: var(--cv-muted); white-space: nowrap; }
  .cvb-preview .cv-job-sub { margin: 1px 0 0; color: var(--cv-accent); }
  .cvb-preview ul { margin: 5px 0 0; padding-left: 17px; }
  .cvb-preview li { margin: 3px 0; padding-left: 2px; }
  .cvb-preview li::marker { color: var(--cv-accent); }

  /* Modern: Inter, tinted header band, accent markers and skill tags */
  .cvb-preview.tpl-modern { font-family: "CV Inter", "Segoe UI", Roboto, Arial, sans-serif; font-size: 13px; line-height: 1.55; }
  .tpl-modern .cv-header { margin: -53px -60px 6px; padding: 42px 60px 22px; border-bottom: 3px solid var(--cv-accent); background: color-mix(in srgb, var(--cv-accent) 7%, #fff); }
  .tpl-modern .cv-name { color: var(--cv-accent); font-size: 31px; font-weight: 800; letter-spacing: -.02em; }
  .tpl-modern .cv-title { margin: 5px 0 8px; font-size: 15px; font-weight: 600; }
  .tpl-modern .cv-contact { font-size: 12.5px; }
  .tpl-modern .cv-section { display: flex; align-items: center; gap: 10px; margin: 22px 0 9px; color: var(--cv-accent); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .tpl-modern .cv-section::before { content: ""; width: 14px; height: 3px; border-radius: 2px; background: var(--cv-accent); }
  .tpl-modern .cv-section::after { content: ""; flex: 1; height: 1px; background: color-mix(in srgb, var(--cv-accent) 25%, #fff); }
  .tpl-modern .cv-skills { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
  /* Separators stay in the PDF text ("A · B") but are invisible between the tags. */
  .tpl-modern .cv-skills .cv-sep { margin: 0 -3px; color: rgba(255, 255, 255, .01); font-size: 1px; }
  .tpl-modern .cv-skill { padding: 2px 10px; border: 1px solid color-mix(in srgb, var(--cv-accent) 18%, #fff); border-radius: 999px; background: color-mix(in srgb, var(--cv-accent) 7%, #fff); color: color-mix(in srgb, var(--cv-accent) 85%, #000); font-size: 12px; font-weight: 500; }
  .tpl-modern .cv-job-title { font-size: 14px; }
  .tpl-modern .cv-dates { font-size: 12px; font-weight: 600; }
  .tpl-modern .cv-job-sub { font-size: 12.5px; font-weight: 600; }

  /* Classic: Lato, accent rules, compact and traditional */
  .cvb-preview.tpl-classic { font-family: "CV Lato", Calibri, Carlito, Arial, sans-serif; font-size: 13.5px; line-height: 1.5; }
  .tpl-classic .cv-header { margin-bottom: 4px; }
  .tpl-classic .cv-name { font-size: 29px; font-weight: 700; letter-spacing: -.01em; }
  .tpl-classic .cv-title { margin: 4px 0 6px; color: var(--cv-accent); font-size: 13.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .tpl-classic .cv-contact { font-size: 12.5px; }
  .tpl-classic .cv-section { margin: 20px 0 8px; padding-bottom: 4px; border-bottom: 1.5px solid var(--cv-accent); color: var(--cv-accent); font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .tpl-classic .cv-job-title { font-size: 14px; }
  .tpl-classic .cv-dates { font-size: 12.5px; }
  .tpl-classic .cv-job-sub { font-size: 13px; font-weight: 700; }

  /* Executive: EB Garamond, centred header with a double rule */
  .cvb-preview.tpl-executive { font-family: "CV Garamond", Georgia, "Times New Roman", serif; font-size: 14.5px; line-height: 1.5; }
  .tpl-executive .cv-header { margin-bottom: 6px; padding-bottom: 12px; border-bottom: 3px double var(--cv-accent); text-align: center; }
  .tpl-executive .cv-name { font-size: 32px; font-weight: 500; letter-spacing: .03em; text-transform: uppercase; }
  .tpl-executive .cv-title { margin: 4px 0 6px; color: var(--cv-accent); font-size: 16px; font-style: italic; }
  .tpl-executive .cv-contact { font-size: 13.5px; }
  .tpl-executive .cv-section { margin: 20px 0 8px; padding-bottom: 3px; border-bottom: 1px solid var(--cv-accent); color: var(--cv-accent); font-size: 14px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .tpl-executive .cv-job-title { font-size: 15.5px; font-weight: 700; }
  .tpl-executive .cv-dates { font-style: italic; }
  .tpl-executive .cv-job-sub { font-style: italic; }
  @media (max-width: 980px) {
    .cvb-layout { grid-template-columns: 1fr; }
    .cvb-side { position: static; }
  }
  /* A copy of the CV made just before printing (see preparePrint), so only the CV is printed. */
