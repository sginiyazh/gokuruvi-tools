      b.type = "button";
      b.dataset.bullet = s;
      li.appendChild(b);
      list.appendChild(li);
    });
  }

  // ---- A4 preview: scale the 794px page to the column and mark roughly where pages break ----
  var PAGE_W = 794, PAGE_H = 1123, PAD_Y = 53; // 210 x 297 mm, 14 mm top and bottom padding, as printed
  var paperWrap = $("cvPaperWrap");
  function fitPaper() {
    var scale = Math.min(1, paperWrap.clientWidth / PAGE_W);
    preview.style.transform = "scale(" + scale + ")";
    var height = preview.offsetHeight;
    paperWrap.style.height = Math.ceil(height * scale) + "px";
    [].forEach.call(paperWrap.querySelectorAll(".cvb-page-break"), function (m) { m.remove(); });
    // Each printed page holds PAGE_H - 2 * PAD_Y of content; breaks fall at those intervals.
    var per = PAGE_H - 2 * PAD_Y;
    for (var y = PAD_Y + per, n = 2; y < height - PAD_Y; y += per, n++) {
      var mark = el("div", "cvb-page-break");
      mark.style.top = Math.round(y * scale) + "px";
      mark.appendChild(el("span", "", "Page " + n));
      paperWrap.appendChild(mark);
    }
  }
  if (window.ResizeObserver) new ResizeObserver(fitPaper).observe(paperWrap);
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(fitPaper);
    document.fonts.addEventListener("loadingdone", fitPaper); // a design switch loads its font later
  }

  // ---- save, update ----
  var saveTimer;
  function update() {
    var d = collect();
    render(d);
    fitPaper();
    showAnalysis(analyze(d));
    renderSuggestions(d);
    clearTimeout(saveTimer);
    // Keep a draft only while there is something in it, so Clear all leaves nothing behind.
    var empty = FIELDS.every(function (id) { return id === "cvRole" || !d[id].trim(); }) && d.jobs.every(function (j) { return !Object.keys(j).some(function (k) { return (j[k] || "").trim(); }); });
    saveTimer = setTimeout(function () { try { if (empty) localStorage.removeItem(STORE_KEY); else localStorage.setItem(STORE_KEY, JSON.stringify(d)); } catch (e) {} }, 400);
  }

  function plainText(d) {
    var out = [];
    out.push(d.cvName, d.cvTitle, [d.cvLocation, d.cvPhone, d.cvEmail, d.cvLinkedin].filter(Boolean).join(" | "));
    if (d.cvVisa || d.cvNotice) out.push([d.cvVisa && "Visa: " + d.cvVisa, d.cvNotice && "Notice period: " + d.cvNotice].filter(Boolean).join(" | "));
    if (d.cvSummary.trim()) out.push("", "PROFESSIONAL SUMMARY", d.cvSummary.trim());
    if (d.cvSkills.trim()) out.push("", "TECHNICAL SKILLS", d.cvSkills.split(",").map(function (s) { return s.trim(); }).filter(Boolean).join(", "));
    var jobs = d.jobs.filter(function (j) { return j.title || j.company || j.bullets; });
    if (jobs.length) {
      out.push("", "WORK EXPERIENCE");
      jobs.forEach(function (j) {
        out.push("", [j.title, j.company].filter(Boolean).join(", ") + (j.dates ? " (" + j.dates + ")" : ""));
        if (j.location) out.push(j.location);
        lines(j.bullets).forEach(function (b) { out.push("- " + b); });
      });
    }
    if (lines(d.cvCerts).length) { out.push("", "CERTIFICATIONS"); lines(d.cvCerts).forEach(function (c) { out.push("- " + c); }); }
    if (lines(d.cvEducation).length) { out.push("", "EDUCATION"); lines(d.cvEducation).forEach(function (e) { out.push(e); }); }
    return out.filter(function (x) { return x !== undefined; }).join("\n").replace(/\n{3,}/g, "\n\n").trim();
  }

  var SAMPLE = {
    cvRole: "linux", cvJobAd: "",
    cvName: "Example Candidate", cvTitle: "Senior Linux Administrator", cvLocation: "Dubai, UAE",
    cvEmail: "candidate@example.com", cvPhone: "+971 50 000 0000", cvLinkedin: "linkedin.com/in/example",
    cvVisa: "Employment visa, transferable", cvNotice: "30 days",
    cvSummary: "Linux administrator with 8 years of experience running RHEL and Ubuntu servers for hosting and enterprise environments. Automates patching, monitoring and backups with Ansible and Bash, and keeps production systems above 99.9% uptime. Comfortable leading incident response and mentoring junior engineers.",
    cvSkills: "RHEL, Ubuntu, Bash, shell scripting, Ansible, systemd, SELinux, LVM, Nginx, Apache, Zabbix, SSH, firewall, patching, backup, troubleshooting, VMware, Git",
    cvCerts: "Red Hat Certified System Administrator (RHCSA), 2022\nRed Hat Certified Engineer (RHCE), 2023",
    cvEducation: "B.E. Computer Science, 2015",
    jobs: [
      { title: "Senior Linux Administrator", company: "Example Hosting LLC", location: "Dubai, UAE", dates: "Mar 2021 – Present",
        bullets: "Automated monthly patching for 120 RHEL servers with Ansible, cutting the maintenance window from 6 hours to 2\nBuilt Zabbix monitoring and alerting for 300 hosts, reducing time to detect outages by 70%\nHardened SSH, sudo and firewalld across the estate, closing 40 audit findings in one quarter\nMentored 3 junior administrators and wrote 25 runbooks for common incidents" },
      { title: "Linux Administrator", company: "Example IT Services", location: "Chennai, India", dates: "Jun 2016 – Feb 2021",
        bullets: "Managed 80 Ubuntu and CentOS web servers running Nginx and Apache with 99.9% uptime\nMigrated 35 applications from physical servers to VMware, saving 40% in hardware costs\nWrote Bash scripts to automate backups and log rotation, saving about 5 hours a week" },
    ],
  };

  // ---- wire up ----
  $("cvAddJob").addEventListener("click", function () { addJob(); update(); });
  // CV design: template and accent colour, remembered in this browser separately from the CV.
  var DESIGN_KEY = "gokuruvi-cv-design-v1";
  var TEMPLATES = ["modern", "classic", "executive"];
  var design = { template: "modern", accent: "#1f3a5f" };
  try {
    var savedDesign = JSON.parse(localStorage.getItem(DESIGN_KEY) || "{}");
    if (TEMPLATES.indexOf(savedDesign.template) !== -1) design.template = savedDesign.template;
    if (/^#[0-9a-f]{6}$/i.test(savedDesign.accent || "")) design.accent = savedDesign.accent;
  } catch (e) {}
  function applyDesign() {
    TEMPLATES.forEach(function (t) { preview.classList.toggle("tpl-" + t, t === design.template); });
    preview.style.setProperty("--cv-accent", design.accent);
    $("cvTemplate").value = design.template;
    [].forEach.call(document.querySelectorAll(".cvb-swatch"), function (s) { s.setAttribute("aria-pressed", String(s.dataset.accent === design.accent)); });
    try { localStorage.setItem(DESIGN_KEY, JSON.stringify(design)); } catch (e) {}
    fitPaper();
  }
  $("cvTemplate").addEventListener("change", function () { design.template = this.value; applyDesign(); });
  [].forEach.call(document.querySelectorAll(".cvb-swatch"), function (s) {
    s.addEventListener("click", function () { design.accent = s.dataset.accent; applyDesign(); });
  });
  applyDesign();

  // Fix common issues, with a one-step undo.
  var beforeFix = null;
  $("cvAutoFix").addEventListener("click", function () {
    var snapshot = collect();
    var result = autoFix();
    var msg = fixMessage(result.stats);
    var out = $("cvFixResult");
    out.textContent = msg.text;
    out.dataset.kind = msg.changed ? "ok" : "none";
    if (!msg.changed) return;
    beforeFix = snapshot;
    fill(result.d);
    update();
    $("cvUndoFix").hidden = false;
  });
  $("cvUndoFix").addEventListener("click", function () {
    if (!beforeFix) return;
    fill(beforeFix);
    beforeFix = null;
    update();
    this.hidden = true;
    $("cvFixResult").textContent = "Changes undone.";
    $("cvFixResult").dataset.kind = "none";
  });
  // Typing after a fix makes undo unsafe (it would throw away the new edits), so hide it.
  $("cvForm").addEventListener("input", function () { beforeFix = null; $("cvUndoFix").hidden = true; });

  // Click a missing keyword to add it to the skills.
  document.addEventListener("click", function (e) {
    var chip = e.target.closest && e.target.closest(".cvb-add");
    if (!chip) return;
    var skills = $("cvSkills");
    var current = skills.value.replace(/[,\s]+$/, "");
    skills.value = current ? current + ", " + chip.dataset.kw : chip.dataset.kw;
    update();
  });

  // Add a suggested bullet to the chosen job.
  $("cvSuggestList").addEventListener("click", function (e) {
    var b = e.target.closest && e.target.closest("button[data-bullet]");
    if (!b) return;
    var boxes = jobsEl.querySelectorAll(".cvb-job");
    var box = boxes[Number($("cvSuggestJob").value) || 0] || boxes[0];
    var ta = box.querySelector('[data-k="bullets"]');
    ta.value = ta.value.replace(/\s+$/, "") ? ta.value.replace(/\s+$/, "") + "\n" + b.dataset.bullet : b.dataset.bullet;
    update();
    b.textContent = "Added";
    b.disabled = true;
    setTimeout(function () { b.textContent = "Add"; b.disabled = false; }, 1500);
  });

  $("cvForm").addEventListener("input", update);
  $("cvForm").addEventListener("change", update);
  $("cvForm").addEventListener("submit", function (e) { e.preventDefault(); });
  function resetFix() { beforeFix = null; $("cvUndoFix").hidden = true; $("cvFixResult").textContent = ""; }
  $("cvSample").addEventListener("click", function () { fill(SAMPLE); update(); resetFix(); });
  $("cvClear").addEventListener("click", function () {
    if (!confirm("Clear the whole CV and the saved draft in this browser?")) return;
    try { localStorage.removeItem(STORE_KEY); } catch (e) {}
    fill({ cvRole: "linux", jobs: [] });
    FIELDS.forEach(function (id) { if (id !== "cvRole") $(id).value = ""; });
    update();
    resetFix();
    document.dispatchEvent(new CustomEvent("cvb:cleared")); // the import script resets the chosen file
  });
  // Print only a copy of the CV, and name the PDF after the person instead of this page.
  var pageTitle = null;
  function preparePrint() {
    var old = document.getElementById("cvPrintArea");
    if (old) old.remove();
    var area = preview.cloneNode(true);
    area.id = "cvPrintArea";
    document.body.appendChild(area);
    if (pageTitle === null) pageTitle = document.title;
    var name = $("cvName").value.trim();
    document.title = name ? name + " CV" : "CV";
  }
  function finishPrint() {
    var area = document.getElementById("cvPrintArea");
    if (area) area.remove();
    if (pageTitle !== null) { document.title = pageTitle; pageTitle = null; }
  }
  window.addEventListener("beforeprint", preparePrint); // also covers Ctrl+P
  window.addEventListener("afterprint", finishPrint);
  $("cvPrint").addEventListener("click", function () { preparePrint(); window.print(); });
  $("cvCopy").addEventListener("click", function () {
    var btn = this, text = plainText(collect());
    var done = function (ok) { btn.textContent = ok ? "Copied" : "Copy failed"; setTimeout(function () { btn.textContent = "Copy as text"; }, 1600); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
    else done(false);
  });

  // Used by the import script below: replace the form with details read from a CV file.
  window.cvbHasContent = function () {
    var d = collect();
    return FIELDS.some(function (id) { return id !== "cvRole" && id !== "cvJobAd" && d[id].trim(); }) || d.jobs.some(function (j) { return (j.title || j.bullets || "").trim(); });
  };
  window.cvbImport = function (parsed) {
    var current = collect();
    var merged = { cvRole: parsed.cvRole || current.cvRole, cvJobAd: current.cvJobAd, jobs: parsed.jobs };
    FIELDS.forEach(function (id) { if (id !== "cvRole" && id !== "cvJobAd") merged[id] = parsed[id] || ""; });
    fill(merged);
    update();
    resetFix();
  };

  var saved = null;
  try { saved = JSON.parse(localStorage.getItem(STORE_KEY) || "null"); } catch (e) {}
  fill(saved || { cvRole: "linux", jobs: [] });
  update();
})();
</script>

<script>
  // Reads an uploaded CV in the browser and fills the form. The PDF and Word readers
  // are loaded only when someone actually imports a file.
  import { parseCv, type ParsedCv } from "../../lib/cvParse";

  declare global {
    interface Window {
      cvbImport?: (parsed: ParsedCv) => void;
      cvbHasContent?: () => boolean;
    }
  }

  const MAX_BYTES = 5 * 1024 * 1024;
  const fileInput = document.getElementById("cvFile") as HTMLInputElement;
  const pasteBox = document.getElementById("cvPasteText") as HTMLTextAreaElement;
  const status = document.getElementById("cvImportStatus") as HTMLElement;

  function say(message: string, kind: "ok" | "warn" | "" = "") {
    status.textContent = message;
    status.dataset.kind = kind;
  }

  async function pdfText(data: ArrayBuffer): Promise<string> {
    const pdfjs = await import("pdfjs-dist");
    const { default: workerUrl } = await import("pdfjs-dist/build/pdf.worker.min.mjs?url");
    pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;
    const doc = await pdfjs.getDocument({ data }).promise;
    const lines: string[] = [];
    for (let n = 1; n <= doc.numPages; n++) {
      const content = await (await doc.getPage(n)).getTextContent();
      let line = "";
      let lastY: number | null = null;
      for (const item of content.items) {
        if (!("str" in item)) continue;
        const y = item.transform[5];
        // A change in vertical position means a new line on the page.
        if (lastY !== null && Math.abs(y - lastY) > 3 && line.trim()) {
          lines.push(line);
          line = "";
        }
        line += item.str;
        lastY = y;
        if (item.hasEOL) {
          lines.push(line);
          line = "";
          lastY = null;
        }
      }
      if (line.trim()) lines.push(line);
      lines.push("");
    }
    return lines.join("\n");
  }

  async function docxText(data: ArrayBuffer): Promise<string> {
    // @ts-expect-error mammoth's browser build ships without type declarations
    const mod = await import("mammoth/mammoth.browser.js");
    const mammoth = mod.default ?? mod;
    const { value } = await mammoth.convertToHtml({ arrayBuffer: data });
    const html = new DOMParser().parseFromString(value, "text/html");
    const lines: string[] = [];
    html.body.querySelectorAll("p, li, h1, h2, h3, h4, h5, h6").forEach((el) => {
      if (el.tagName === "P" && el.closest("li")) return;
      el.querySelectorAll("br").forEach((br) => br.replaceWith("\n"));
      const text = (el.textContent || "").trim();
      if (text) lines.push(el.tagName === "LI" ? `• ${text}` : text);
    });
    return lines.join("\n");
  }

  function importText(text: string, source: string) {
    if (text.replace(/\s/g, "").length < 80) {
      say("No readable text was found. This usually means a scanned or image-only PDF. Upload the Word version, or copy the text into the paste box.", "warn");
      return;
    }
    const parsed = parseCv(text);
    window.cvbImport?.(parsed);
    const filled = Object.entries(parsed).filter(([key, value]) => key !== "jobs" && key !== "cvRole" && typeof value === "string" && value.trim()).length;
    const jobs = parsed.jobs.length;
    say(`Read ${source}: filled ${filled} fields and ${jobs} ${jobs === 1 ? "job" : "jobs"}. Please check every field, because CV layouts vary and some details may be missing or in the wrong place.`, "ok");
  }

  const okToReplace = () => !window.cvbHasContent?.() || confirm("Replace the CV in the form with the details from your file?");
  const loadButton = document.getElementById("cvLoadFile") as HTMLButtonElement;
  const readBox = document.getElementById("cvReadTextBox") as HTMLDetailsElement;
  const readText = document.getElementById("cvReadText") as HTMLElement;

  function showReadText(text: string) {
    readText.textContent = text.trim();
    readBox.hidden = !text.trim();
  }

  // Step 1: choosing a file only checks it. Step 2: the Load button reads it into the form.
  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    loadButton.disabled = true;
    if (!file) return say("");
    const name = file.name.toLowerCase();
    if (file.size > MAX_BYTES) return say("That file is larger than 5 MB. Please upload a smaller PDF or Word file.", "warn");
    if (name.endsWith(".doc")) return say("Old Word .doc files can't be read here. In Word, choose File → Save As → Word Document (.docx), then upload that file.", "warn");
    if (!/\.(pdf|docx|txt)$/.test(name)) return say("Please upload a PDF, Word (.docx) or .txt file.", "warn");
    loadButton.disabled = false;
    say(`Ready: ${file.name}. Click "Load CV into the form" to fill in the details.`);
  });

  loadButton.addEventListener("click", async () => {
    const file = fileInput.files?.[0];
    if (!file || !okToReplace()) return;
    const name = file.name.toLowerCase();
    loadButton.disabled = true;
    say(`Reading ${file.name}…`);
    try {
      const text = name.endsWith(".pdf")
        ? await pdfText(await file.arrayBuffer())
        : name.endsWith(".docx")
          ? await docxText(await file.arrayBuffer())
          : await file.text();
      showReadText(text);
      importText(text, file.name);
    } catch {
      showReadText("");
      say("That file couldn't be read. If it is password-protected or damaged, save it again as PDF or .docx, or paste the text below.", "warn");
    } finally {
      loadButton.disabled = false;
    }
  });

  // Load example replaces the form, so the last import message no longer applies.
  document.getElementById("cvSample")?.addEventListener("click", () => { say(""); showReadText(""); });

  // Clear all (once confirmed) also forgets the chosen file and any pasted text.
  document.addEventListener("cvb:cleared", () => {
    fileInput.value = "";
    loadButton.disabled = true;
    pasteBox.value = "";
    say("");
    showReadText("");
  });

  document.getElementById("cvPasteRead")?.addEventListener("click", () => {
    if (!pasteBox.value.trim()) return say("Paste your CV text into the box first.", "warn");
    if (!okToReplace()) return;
    showReadText("");
    importText(pasteBox.value, "the pasted text");
  });
</script>
