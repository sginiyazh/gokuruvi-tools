---
import WindowsToolShell from "../../components/WindowsToolShell.astro";
---
<WindowsToolShell title="Robocopy Generator" description="Create reliable Robocopy commands for migrations, mirroring, retries, logging and NTFS permissions." slug="robocopy-generator" icon="📁">

<h2 class="tool-title">Robocopy command builder</h2><p class="tool-subtitle">Create a copy command with common production options.</p><div class="form-grid"><div class="field"><label for="src">Source</label><input id="src" value="C:\\Source" /></div><div class="field"><label for="dst">Destination</label><input id="dst" value="D:\\Backup" /></div><div class="field"><label for="mode">Copy mode</label><select id="mode"><option value="E">Copy all subfolders</option><option value="MIR">Mirror source</option></select></div><div class="field"><label for="threads">Threads</label><input id="threads" type="number" min="1" max="128" value="16" /></div><div class="field"><label for="retries">Retries</label><input id="retries" type="number" min="0" value="2" /></div><div class="field"><label for="wait">Retry wait (seconds)</label><input id="wait" type="number" min="0" value="3" /></div><div class="field full"><label for="log">Optional log file</label><input id="log" value="C:\\Temp\\robocopy.log" /></div><div class="field full"><div class="checks"><label class="check"><input id="sec" type="checkbox" checked /> Copy security</label><label class="check"><input id="restart" type="checkbox" checked /> Restartable mode</label><label class="check"><input id="xo" type="checkbox" /> Exclude older files</label></div></div></div><div class="actions"><button class="btn btn-primary" id="generate">Generate Robocopy</button></div><div class="output-wrap"><div class="output-head"><strong>Command</strong><button class="copy-btn" id="copy">Copy</button></div><pre class="output" id="output">Configure the copy above.</pre></div><p class="hint"><strong>/MIR warning:</strong> files at the destination that do not exist in the source can be deleted.</p>
<script>

const q=(id:string)=>(document.querySelector<HTMLInputElement>('#'+id)!),sel=(id:string)=>(document.querySelector<HTMLSelectElement>('#'+id)!),o=document.querySelector<HTMLElement>('#output')!;document.querySelector('#generate')?.addEventListener('click',()=>{const clean=(x:string)=>x.replace(/"/g,'');const opts=[`/${sel('mode').value}`,`/R:${Math.max(0,Number(q('retries').value)||0)}`,`/W:${Math.max(0,Number(q('wait').value)||0)}`,`/MT:${Math.min(128,Math.max(1,Number(q('threads').value)||8))}`];if(q('sec').checked)opts.push('/COPY:DATSOU');if(q('restart').checked)opts.push('/Z');if(q('xo').checked)opts.push('/XO');if(q('log').value.trim())opts.push(`/LOG+:"${clean(q('log').value.trim())}"`);o.textContent=`robocopy "${clean(q('src').value)}" "${clean(q('dst').value)}" *.* ${opts.join(' ')}`});
const copyBtn=document.querySelector<HTMLButtonElement>("#copy");
copyBtn?.addEventListener("click",async()=>{const out=document.querySelector<HTMLElement>("#output")?.textContent||""; if(out){await navigator.clipboard.writeText(out); copyBtn.textContent="Copied!"; setTimeout(()=>copyBtn.textContent="Copy",1200)}});
</script>
</WindowsToolShell>
