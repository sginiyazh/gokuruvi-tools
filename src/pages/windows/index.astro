---
import Header from "../../components/Header.astro";

const pageTitle = "Windows Tools";

const description =
  "Free Windows, PowerShell and Windows Server command generators, administration utilities and troubleshooting tools.";

const tools = [
  {
    icon: "💻",
    name: "PowerShell Command Generator",
    category: "PowerShell",
    description:
      "Generate practical PowerShell commands for Windows administration, automation and troubleshooting.",
    link: "/windows/powershell-generator",
  },
  {
    icon: "⌨️",
    name: "Windows Command Generator",
    category: "Command Prompt",
    description:
      "Build common CMD commands for files, folders, networking, services and system management.",
    link: "/windows/command-generator",
  },
  {
    icon: "⚙️",
    name: "Windows Service Generator",
    category: "Services",
    description:
      "Generate commands to start, stop, restart, configure and inspect Windows services.",
    link: "/windows/service-command-generator",
  },
  {
    icon: "🛡️",
    name: "Windows Firewall Rule Generator",
    category: "Security",
    description:
      "Create inbound and outbound Windows Defender Firewall rules using PowerShell.",
    link: "/windows/firewall-rule-generator",
  },
  {
    icon: "👤",
    name: "Windows User Management",
    category: "Users",
    description:
      "Generate commands to create, modify, disable and remove local Windows users and groups.",
    link: "/windows/user-management-generator",
  },
  {
    icon: "🔐",
    name: "NTFS Permission Generator",
    category: "Permissions",
    description:
      "Generate ICACLS commands to assign, modify, inherit and remove NTFS permissions.",
    link: "/windows/file-permission-generator",
  },
  {
    icon: "🔌",
    name: "Windows Port Checker",
    category: "Networking",
    description:
      "Test TCP port connectivity to remote Windows servers using PowerShell.",
    link: "/windows/port-checker",
  },
  {
    icon: "🌐",
    name: "Windows Network Troubleshooter",
    category: "Networking",
    description:
      "Generate commands for IP configuration, routing, adapters and connectivity troubleshooting.",
    link: "/windows/network-troubleshooter",
  },
  {
    icon: "🔎",
    name: "Windows Server Troubleshooter",
    category: "Server",
    description:
      "Troubleshoot Server resolution, clear Server cache and query common Server records.",
    link: "/windows/dns-troubleshooter",
  },
  {
    icon: "📋",
    name: "Windows Event Log Commands",
    category: "Diagnostics",
    description:
      "Generate commands to query, filter, export and clear Windows Event Logs.",
    link: "/windows/event-log-commands",
  },
  {
    icon: "🧩",
    name: "Registry Command Generator",
    category: "Registry",
    description:
      "Generate commands to read, create, update, export and delete Windows Registry values.",
    link: "/windows/registry-command-generator",
  },
  {
    icon: "🕒",
    name: "Scheduled Task Generator",
    category: "Automation",
    description:
      "Create Windows scheduled tasks using PowerShell and SCHTASKS commands.",
    link: "/windows/scheduled-task-generator",
  },
  {
    icon: "💾",
    name: "Disk Management Commands",
    category: "Storage",
    description:
      "Generate PowerShell and DiskPart commands for disks, partitions and volumes.",
    link: "/windows/disk-management-commands",
  },
  {
    icon: "🖥️",
    name: "Windows System Information",
    category: "Inventory",
    description:
      "Get commands to view Windows OS, CPU, memory, BIOS, hardware and disk details.",
    link: "/windows/system-information",
  },
  {
    icon: "🔄",
    name: "Windows Update Troubleshooter",
    category: "Updates",
    description:
      "Generate commands to diagnose and repair common Windows Update problems.",
    link: "/windows/windows-update-troubleshooter",
  },
  {
    icon: "📊",
    name: "Windows Process Generator",
    category: "Processes",
    description:
      "Generate commands to list, inspect, start and terminate Windows processes.",
    link: "/windows/process-command-generator",
  },
  {
    icon: "🖱️",
    name: "RDP Troubleshooter",
    category: "Remote Access",
    description:
      "Troubleshoot Remote Desktop services, ports, firewall rules and connectivity.",
    link: "/windows/rdp-troubleshooter",
  },
  {
    icon: "🛡️",
    name: "Windows Defender Generator",
    category: "Security",
    description:
      "Generate Microsoft Defender commands for scans, updates, status and exclusions.",
    link: "/windows/defender-command-generator",
  },
  {
    icon: "🏢",
    name: "Active Directory User Generator",
    category: "Active Directory",
    description:
      "Generate PowerShell commands to create and manage Active Directory users.",
    link: "/windows/active-directory-user-generator",
  },
  {
    icon: "✅",
    name: "Windows Server Health Check",
    category: "Health Check",
    description:
      "Review CPU, memory, disk, services, uptime and critical event log checks.",
    link: "/windows/server-health-checklist",
  },
  {
    icon: "📡",
    name: "Ping Command Generator",
    category: "Networking",
    description:
      "Generate Windows ping commands with count, timeout, packet size and continuous testing options.",
    link: "/windows/ping-command-generator",
  },
  {
    icon: "🔎",
    name: "NSLookup Generator",
    category: "DNS",
    description:
      "Generate nslookup commands for A, AAAA, MX, TXT, NS, PTR and custom DNS server queries.",
    link: "/windows/nslookup-generator",
  },
  {
    icon: "🛣️",
    name: "Tracert Generator",
    category: "Networking",
    description:
      "Build Windows tracert commands to diagnose routing paths, latency and connectivity issues.",
    link: "/windows/tracert-generator",
  },
  {
    icon: "📁",
    name: "Robocopy Generator",
    category: "File Management",
    description:
      "Generate robust Robocopy commands for copying, mirroring, retry control, logging and permissions.",
    link: "/windows/robocopy-generator",
  },
  {
    icon: "📂",
    name: "XCOPY Generator",
    category: "File Management",
    description:
      "Create XCOPY commands for recursive file and folder copying with overwrite and verification options.",
    link: "/windows/xcopy-generator",
  },
  {
    icon: "🔐",
    name: "ICACLS Generator",
    category: "Permissions",
    description:
      "Generate ICACLS commands to grant, remove, reset, inherit and audit NTFS permissions.",
    link: "/windows/icacls-generator",
  },
  {
    icon: "🔄",
    name: "GPUpdate Generator",
    category: "Group Policy",
    description:
      "Generate GPUpdate commands to refresh computer and user Group Policy settings.",
    link: "/windows/gpupdate-generator",
  },
  {
    icon: "📋",
    name: "GPResult Generator",
    category: "Group Policy",
    description:
      "Generate GPResult commands and HTML reports for applied user and computer policies.",
    link: "/windows/gpresult-generator",
  },
  {
    icon: "🧰",
    name: "SFC and DISM Generator",
    category: "System Repair",
    description:
      "Generate SFC and DISM repair commands for Windows image and system file corruption.",
    link: "/windows/sfc-dism-generator",
  },
  {
    icon: "🔑",
    name: "Windows License Checker",
    category: "Licensing",
    description:
      "Generate commands to check Windows activation, product key details and licensing status.",
    link: "/windows/windows-license-checker",
  },
  {
    icon: "🖥️",
    name: "Hostname Generator",
    category: "System",
    description:
      "Generate commands to view or change a Windows computer name using CMD and PowerShell.",
    link: "/windows/hostname-generator",
  },
  {
    icon: "🌱",
    name: "Environment Variable Generator",
    category: "System",
    description:
      "Create commands to view, add, update and remove Windows environment variables.",
    link: "/windows/environment-variable-generator",
  },
  {
    icon: "🌐",
    name: "IIS Command Generator",
    category: "Enterprise Server",
    description:
      "Generate IIS PowerShell and AppCmd commands for sites, pools, bindings and service management.",
    link: "/windows/iis-command-generator",
  },
  {
    icon: "🧱",
    name: "Hyper-V Command Generator",
    category: "Enterprise Server",
    description:
      "Generate Hyper-V commands for virtual machines, switches, checkpoints, disks and networking.",
    link: "/windows/hyperv-command-generator",
  },
  {
    icon: "💽",
    name: "Storage Spaces Generator",
    category: "Enterprise Server",
    description:
      "Generate PowerShell commands for storage pools, virtual disks and Windows Storage Spaces.",
    link: "/windows/storage-space-generator",
  },
  {
    icon: "🧩",
    name: "Windows Feature Installer",
    category: "Enterprise Server",
    description:
      "Generate PowerShell and DISM commands to install, remove and inspect Windows features.",
    link: "/windows/windows-feature-installer",
  },
  {
    icon: "🔒",
    name: "BitLocker Command Generator",
    category: "Enterprise Security",
    description:
      "Generate BitLocker commands for encryption, recovery keys, status and protector management.",
    link: "/windows/bitlocker-command-generator",
  },
  {
    icon: "📜",
    name: "Certificate Command Generator",
    category: "Enterprise Security",
    description:
      "Generate Windows certificate store, import, export and inspection commands.",
    link: "/windows/certificate-command-generator",
  },
  {
    icon: "🔐",
    name: "SSH Server Generator",
    category: "Remote Access",
    description:
      "Generate commands to install, configure and manage OpenSSH Server on Windows.",
    link: "/windows/ssh-server-generator",
  },
  {
    icon: "📡",
    name: "WinRM Generator",
    category: "Remote Management",
    description:
      "Generate commands to configure, test and troubleshoot Windows Remote Management.",
    link: "/windows/winsrm-generator",
  },
  {
    icon: "☁️",
    name: "Azure AD User Generator",
    category: "Microsoft 365 / Azure",
    description:
      "Generate PowerShell commands to create and manage Azure AD users and groups.",
    link: "/windows/azure-ad-user-generator",
  },
  {
    icon: "🪪",
    name: "Entra ID Command Generator",
    category: "Microsoft 365 / Azure",
    description:
      "Generate Microsoft Entra ID commands for users, groups, roles and directory operations.",
    link: "/windows/entra-id-command-generator",
  },
  {
    icon: "📧",
    name: "Exchange PowerShell Generator",
    category: "Microsoft 365 / Azure",
    description:
      "Generate Exchange Online PowerShell commands for mailboxes, permissions and mail flow.",
    link: "/windows/exchange-powershell-generator",
  },
  {
    icon: "💬",
    name: "Teams PowerShell Generator",
    category: "Microsoft 365 / Azure",
    description:
      "Generate Microsoft Teams PowerShell commands for users, policies, teams and settings.",
    link: "/windows/teams-powershell-generator",
  },
  {
    icon: "🧠",
    name: "Memory Diagnostic Guide",
    category: "Diagnostics",
    description:
      "Review Windows memory diagnostic commands, checks and troubleshooting steps.",
    link: "/windows/memory-diagnostic-guide",
  },
  {
    icon: "⚡",
    name: "CPU Performance Checker",
    category: "Diagnostics",
    description:
      "Generate commands to inspect CPU usage, processes, performance counters and processor details.",
    link: "/windows/cpu-performance-checker",
  },
  {
    icon: "💿",
    name: "Disk Health Checker",
    category: "Diagnostics",
    description:
      "Generate commands to check disk health, SMART data, free space and file system status.",
    link: "/windows/disk-health-checker",
  },
  {
    icon: "🔗",
    name: "Service Dependency Checker",
    category: "Diagnostics",
    description:
      "Generate commands to inspect Windows service dependencies and dependent services.",
    link: "/windows/service-dependency-checker",
  },
  {
    icon: "🔌",
    name: "TCP Port Tester",
    category: "Diagnostics",
    description:
      "Generate PowerShell commands to test TCP ports, resolve hosts and validate remote connectivity.",
    link: "/windows/tcp-port-tester",
  },
];

const benefits = [
  {
    icon: "⚡",
    title: "Faster administration",
    description:
      "Generate Windows and PowerShell commands instantly for common operational tasks.",
  },
  {
    icon: "🧰",
    title: "Troubleshooting support",
    description:
      "Use practical utilities for services, networking, events, updates and remote access.",
  },
  {
    icon: "🔒",
    title: "Privacy friendly",
    description:
      "Most values are processed locally in your browser without requiring registration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="Windows tools, PowerShell tools, Windows Server tools, CMD generator, IIS tools, Hyper-V tools, Microsoft 365 tools, Azure tools, Windows diagnostics, Active Directory tools"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:title" content="Windows Tools | Gokuruvi Tools" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <meta
      property="og:url"
      content="https://www.gokuruvi.com/windows/"
    />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/windows/"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle} | Gokuruvi Tools</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-badge">
              <span class="badge-dot" aria-hidden="true"></span>
              Free tools for Windows professionals
            </div>

            <h1>
              Practical <span>Windows Tools</span>
            </h1>

            <p class="hero-description">
              Generate PowerShell and CMD commands, manage Windows Server, IIS and Hyper-V,
              troubleshoot networking and diagnostics, and simplify Microsoft 365
              and Entra ID administration using browser-based tools.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#windows-tools">
                Explore Windows Tools
                <span aria-hidden="true">→</span>
              </a>

              <a class="button button-secondary" href="/#tool-categories">
                Browse All Categories
              </a>
            </div>

            <div class="hero-statistics">
              <div class="hero-stat">
                <strong>{tools.length}</strong>
                <span>Windows utilities</span>
              </div>

              <div class="hero-stat">
                <strong>PowerShell</strong>
                <span>Command automation</span>
              </div>

              <div class="hero-stat">
                <strong>Server</strong>
                <span>Administration tools</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="windows-tools">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Available Utilities</span>

            <h2>Windows tools for administration and troubleshooting</h2>

            <p>
              Select a utility to calculate IP information, generate network
              commands, create Server records, validate VLANs or check SSL details.
            </p>
          </div>

          <div class="tools-grid">
            {
              tools.map((tool) => (
                <a
                  class="tool-card"
                  href={tool.link}
                  aria-label={`Open ${tool.name}`}
                >
                  <div class="tool-header">
                    <div class="tool-icon" aria-hidden="true">{tool.icon}</div>
                    <span class="tool-category">{tool.category}</span>
                  </div>

                  <h3>{tool.name}</h3>
                  <p>{tool.description}</p>

                  <span class="open-tool">
                    Open tool
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Why Gokuruvi</span>

            <h2>Built for Windows administrators and engineers</h2>

            <p>
              Use practical utilities for Windows administration, automation, enterprise
              server management, Microsoft cloud services and troubleshooting.
            </p>
          </div>

          <div class="benefits-grid">
            {
              benefits.map((benefit) => (
                <article class="benefit-card">
                  <div class="benefit-icon" aria-hidden="true">
                    {benefit.icon}
                  </div>

                  <h3>{benefit.title}</h3>
                  <p>{benefit.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container">
          <div class="cta-box">
            <h2>Start simplifying your Windows tasks</h2>

            <p>
              Calculate subnet details, generate Server commands and troubleshoot
              connectivity using free online networking tools.
            </p>

            <a
              class="button cta-button"
              href="/windows/powershell-generator"
            >
              Open PowerShell Generator
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="footer-logo" href="/">
              <span class="footer-logo-icon" aria-hidden="true">G</span>
              <span>Gokuruvi Tools</span>
            </a>

            <p>
              Free Linux, DevOps, Kubernetes, network, cloud, Windows and security
              utilities for administrators, engineers and IT professionals.
            </p>
          </div>

          <div>
            <h3 class="footer-title">Windows Tools</h3>

            <div class="footer-links">
              <a href="/windows/powershell-generator">PowerShell Generator</a>
              <a href="/windows/command-generator">Command Generator</a>
              <a href="/windows/service-command-generator">Service Generator</a>
              <a href="/windows/port-checker">Port Checker</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Administration</h3>

            <div class="footer-links">
              <a href="/windows/firewall-rule-generator">Firewall Generator</a>
              <a href="/windows/user-management-generator">User Management</a>
              <a href="/windows/event-log-commands">Event Log Commands</a>
              <a href="/windows/rdp-troubleshooter">RDP Troubleshooter</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Categories</h3>

            <div class="footer-links">
              <a href="/linux/">Linux Tools</a>
              <a href="/devops/">DevOps Tools</a>
              <a href="/kubernetes/">Kubernetes Tools</a>
              <a href="/network/">Network Tools</a>
              <a href="/cloud/">Cloud Tools</a>
              <a href="/windows/">Windows Tools</a>
              <a href="/about/">About</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
          </span>

          <div class="footer-bottom-links">
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/disclaimer/">Disclaimer</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #172033;
    font-family:
      Inter, Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 105px 0 92px;
    background:
      radial-gradient(circle at 15% 15%, rgba(56, 189, 248, 0.2), transparent 32%),
      radial-gradient(circle at 88% 25%, rgba(37, 99, 235, 0.2), transparent 34%),
      linear-gradient(145deg, #f8fafc 0%, #eff6ff 52%, #f8fafc 100%);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 24px;
    padding: 8px 16px;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.12);
  }

  .hero h1 {
    margin: 0 auto 22px;
    color: #0f172a;
    font-size: clamp(43px, 7vw, 72px);
    line-height: 1.06;
    letter-spacing: -2.5px;
  }

  .hero h1 span {
    background: linear-gradient(90deg, #2563eb, #0284c7);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 790px;
    margin: 0 auto;
    color: #475569;
    font-size: clamp(18px, 2.5vw, 21px);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.26);
  }

  .button-primary:hover {
    background: #1d4ed8;
    box-shadow: 0 16px 38px rgba(37, 99, 235, 0.32);
  }

  .button-secondary {
    border-color: #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
  }

  .hero-statistics {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    margin-top: 42px;
  }

  .hero-stat {
    min-width: 135px;
  }

  .hero-stat strong {
    display: block;
    color: #0f172a;
    font-size: 25px;
  }

  .hero-stat span {
    color: #64748b;
    font-size: 14px;
    font-weight: 650;
  }

  .section {
    padding: 92px 0;
  }

  .section-white {
    background: #ffffff;
  }

  .section-heading {
    max-width: 770px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(31px, 4vw, 44px);
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 18px;
    line-height: 1.75;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .tool-card {
