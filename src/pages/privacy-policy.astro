---
const pageTitle = "Privacy Policy";
const description = "Privacy policy for the Gokuruvi Tools website.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <main>
      <h1>Privacy Policy</h1>

      <p>Last updated: July 27, 2026</p>

      <h2>Information We Collect</h2>
      <p>
        Gokuruvi Tools may collect limited technical information such as
        browser type, device type, referring pages, and general usage data.
      </p>

      <h2>Cookies</h2>
      <p>
        We may use cookies for website functionality, analytics, security,
        and advertising purposes.
      </p>

      <h2>Third-Party Services</h2>
      <p>
        We may use third-party services such as analytics providers,
        advertising networks, and hosting platforms. These providers may
        process information according to their own privacy policies.
      </p>

      <h2>Data Entered into Tools</h2>
      <p>
        Where possible, tools operate directly in your browser. Do not enter
        passwords, private keys, personal information, or confidential data
        into any tool.
      </p>

      <h2>Contact</h2>
      <p>
        For privacy-related questions, contact
        <a href="mailto:contact@gokuruvi.com">contact@gokuruvi.com</a>.
      </p>

      <p><a href="/">Return to homepage</a></p>
    </main>
  </body>
</html>