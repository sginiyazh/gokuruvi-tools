---
import Layout from "../../layouts/Layout.astro";
const title = "VMware Tools";
const description = "Free VMware vSphere, ESXi and vCenter utilities: VM sizing and cluster capacity calculator, datastore capacity calculator, PowerCLI command generator, snapshot command generator and a port reference.";
---
<Layout title={title} description={description}>
<section class="hero"><div class="container"><span class="badge">Virtualization</span><h1>VMware Tools</h1><p>Free utilities for vSphere, ESXi and vCenter administrators — capacity planning, PowerCLI command generation and quick references for the tasks you handle every day.</p><div class="stats"><div class="stat"><strong>5</strong><span>Essential utilities</span></div><div class="stat"><strong>Free</strong><span>Browser-based tools</span></div><div class="stat"><strong>Practical</strong><span>Built for IT operations</span></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="label">Essential Utilities</span><h2>Choose a tool</h2><p>Focused utilities for day-to-day vSphere administration, capacity planning and troubleshooting.</p></div><div class="grid">
<a class="card" href="/vmware/vm-sizing-calculator/"><div class="icon" aria-hidden="true">🧮</div><span class="tag">Capacity Planning</span><h3>VM Sizing &amp; Cluster Capacity Calculator</h3><p>Estimate how many VMs a cluster can support based on host specs, overcommit ratios and HA reserve.</p><span class="arrow">Open tool →</span></a>
<a class="card" href="/vmware/datastore-capacity-calculator/"><div class="icon" aria-hidden="true">💽</div><span class="tag">Storage</span><h3>Datastore Capacity Calculator</h3><p>Calculate usable free space, thin-provisioning overcommit and how many more VMs will fit safely.</p><span class="arrow">Open tool →</span></a>
<a class="card" href="/vmware/powercli-command-generator/"><div class="icon" aria-hidden="true">💻</div><span class="tag">Automation</span><h3>PowerCLI Command Generator</h3><p>Generate PowerCLI commands for power operations, vMotion, resizing and resource queries.</p><span class="arrow">Open tool →</span></a>
<a class="card" href="/vmware/snapshot-command-generator/"><div class="icon" aria-hidden="true">📸</div><span class="tag">Snapshots</span><h3>Snapshot Command Generator</h3><p>Generate commands to create, list, remove, revert and consolidate VM snapshots safely.</p><span class="arrow">Open tool →</span></a>
<a class="card" href="/vmware/port-reference/"><div class="icon" aria-hidden="true">📚</div><span class="tag">Reference</span><h3>VMware Port Reference</h3><p>Quick reference for vCenter, ESXi, vMotion, Fault Tolerance and vSAN network ports.</p><span class="arrow">Open tool →</span></a>
</div><div class="note"><strong>Privacy:</strong> All calculations run locally in your browser. Generated PowerCLI commands are text output only — nothing connects to your vCenter or ESXi environment from this site.</div></div></section>

<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#f8fafc;color:#172033;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}
  .container{width:min(calc(100% - 32px),1180px);margin:auto}.hero{padding:82px 0 66px;background:radial-gradient(circle at 12% 18%,rgba(56,189,248,.2),transparent 30%),radial-gradient(circle at 88% 20%,rgba(37,99,235,.16),transparent 32%),linear-gradient(145deg,#f8fafc,#eff6ff);text-align:center}
  .badge{display:inline-flex;padding:7px 14px;border:1px solid #bfdbfe;border-radius:999px;background:#fff;color:#1d4ed8;font-size:13px;font-weight:800}.hero h1{margin:18px 0 12px;color:#0f172a;font-size:clamp(38px,6vw,58px);line-height:1.08}.hero p{max-width:760px;margin:auto;color:#475569;font-size:18px}.stats{display:flex;justify-content:center;gap:36px;flex-wrap:wrap;margin-top:30px}.stat strong{display:block;color:#0f172a;font-size:24px}.stat span{color:#64748b;font-size:13px}
  .section{padding:72px 0}.section-head{max-width:740px;margin:0 auto 34px;text-align:center}.label{color:#2563eb;font-size:13px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.section-head h2{margin:9px 0;color:#0f172a;font-size:clamp(28px,4vw,40px)}.section-head p{margin:0;color:#64748b}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{display:block;padding:24px;border:1px solid #e2e8f0;border-radius:18px;background:#fff;color:inherit;text-decoration:none;box-shadow:0 10px 28px rgba(15,23,42,.05);transition:.2s ease}.card:hover{transform:translateY(-4px);border-color:#93c5fd;box-shadow:0 18px 38px rgba(15,23,42,.09)}.icon{display:grid;width:48px;height:48px;place-items:center;border-radius:13px;background:#eff6ff;font-size:25px}.tag{display:inline-block;margin-top:18px;color:#2563eb;font-size:12px;font-weight:800;text-transform:uppercase}.card h3{margin:7px 0 8px;color:#0f172a;font-size:20px}.card p{margin:0;color:#64748b;font-size:14px}.arrow{display:inline-block;margin-top:16px;color:#2563eb;font-weight:800}.note{margin-top:30px;padding:18px 20px;border:1px solid #dbeafe;border-radius:14px;background:#f8fbff;color:#475569}
  @media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.grid{grid-template-columns:1fr}.hero{padding:60px 0 48px}}
</style>
</Layout>
