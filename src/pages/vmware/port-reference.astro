---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="VMware Port Reference" description="Quick reference for commonly used vCenter, ESXi, vMotion, vSAN and VMware Tools network ports.">
  <section class="tool-hero"><span class="eyebrow">VMware Tool</span><h1>VMware Port Reference</h1><p>Quick reference for the network ports vCenter, ESXi hosts, vMotion, Fault Tolerance and vSAN rely on.</p></section>
  <div class="wrap">
    <a class="back" href="/vmware/">← Back to VMware Tools</a>
    <section class="card">
      <h2>Common VMware ports</h2>
      <div class="field"><label for="portFilter">Filter</label><input id="portFilter" placeholder="vCenter, 902, vMotion, vSAN..." /></div>
      <div class="result">
        <div class="checklist" id="portList"></div>
        <p class="small">Default ports are conventions, not guarantees — some can be changed during installation. Confirm the actual configuration in your environment and restrict these ports with firewall rules and network segmentation, especially vMotion and vSAN traffic, which should never be exposed outside a dedicated VLAN.</p>
      </div>
    </section>
  </div>
  <script>
    const rows: Array<[string, string, string]> = [
      ["vCenter Server HTTPS (Web Client / API)", "443/TCP", "vCenter"],
      ["vCenter Server HTTP (redirects to HTTPS)", "80/TCP", "vCenter"],
      ["vCenter Server Appliance Management Interface (VAMI)", "5480/TCP", "vCenter"],
      ["vCenter Single Sign-On (LDAP)", "389/TCP", "vCenter"],
      ["vCenter Single Sign-On (LDAPS)", "636/TCP", "vCenter"],
      ["ESXi Host Client / vSphere Client", "443/TCP", "ESXi Host"],
      ["ESXi Host management agent (hostd)", "902/TCP", "ESXi Host"],
      ["ESXi SSH", "22/TCP", "ESXi Host"],
      ["ESXi Direct Console UI (DCUI)", "N/A (local console)", "ESXi Host"],
      ["vMotion", "8000/TCP", "Migration"],
      ["Storage vMotion", "443/TCP (via management)", "Migration"],
      ["Fault Tolerance logging", "8100/TCP, 8200/TCP (UDP for some versions)", "Availability"],
      ["High Availability (FDM) agent", "8182/TCP+UDP", "Availability"],
      ["vSAN clustering service", "12345/UDP, 23451/UDP", "vSAN"],
      ["vSAN VASA vendor provider", "8080/TCP", "vSAN"],
      ["vSAN Transport (unicast)", "2233/TCP", "vSAN"],
      ["iSCSI software adapter", "3260/TCP", "Storage"],
      ["NFS datastore", "2049/TCP", "Storage"],
      ["Network File Copy (NFC) — used for clone/migrate", "902/TCP", "Storage"],
      ["Auto Deploy", "6501/TCP, 6502/TCP", "Provisioning"],
      ["Update Manager / vSphere Lifecycle Manager", "9084/TCP, 9087/TCP", "Patching"],
      ["Syslog forwarding", "514/UDP, 514/TCP, 1514/TCP (TLS)", "Logging"],
      ["SNMP", "161/UDP", "Monitoring"],
      ["NTP", "123/UDP", "Time Sync"],
    ];

    const filterInput = document.querySelector<HTMLInputElement>("#portFilter");
    const listEl = document.querySelector<HTMLElement>("#portList");

    function draw() {
      const query = (filterInput?.value ?? "").toLowerCase();
      const filtered = rows.filter((row) => row.join(" ").toLowerCase().includes(query));
      if (listEl) {
        listEl.innerHTML = filtered
          .map((row) => `<div class="item"><span class="tag">${row[2]}</span><strong>${row[0]}</strong> — ${row[1]}</div>`)
          .join("");
      }
    }

    filterInput?.addEventListener("input", draw);
    draw();
  </script>
<style>
.tool-hero{padding:62px 20px 42px;background:linear-gradient(135deg,#eff6ff,#f8fafc);text-align:center}.eyebrow{display:inline-flex;padding:6px 11px;border-radius:999px;background:#dbeafe;color:#1d4ed8;font-size:13px;font-weight:800}.tool-hero h1{margin:14px 0 10px;color:#0f172a;font-size:clamp(34px,5vw,52px);line-height:1.1}.tool-hero p{max-width:760px;margin:0 auto;color:#64748b;font-size:17px}.wrap{width:min(calc(100% - 32px),960px);margin:38px auto 72px}.back{display:inline-block;margin-bottom:18px;color:#2563eb;font-weight:750;text-decoration:none}.card{padding:28px;border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.07)}h2{margin:0 0 8px;color:#0f172a}.field{margin-top:16px}label{display:block;margin-bottom:7px;color:#0f172a;font-weight:750}input{width:100%;min-height:48px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;background:#fff;color:#0f172a}input:focus{outline:3px solid rgba(37,99,235,.14);border-color:#2563eb}.result{margin-top:20px}.checklist{display:grid;gap:9px}.item{padding:10px 12px;border-radius:10px;background:#f8fafc;border:1px solid #e2e8f0}.tag{display:inline-block;margin-right:9px;padding:2px 8px;border-radius:999px;background:#eaf2ff;color:#1d4ed8;font-size:.68rem;font-weight:800;vertical-align:middle}.small{margin-top:12px;font-size:13px;color:#64748b}@media(max-width:700px){.card{padding:20px}}
</style>
</Layout>
