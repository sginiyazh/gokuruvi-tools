---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="VMware Snapshot Command Generator" description="Generate PowerCLI and esxcli-safe commands for creating, listing, removing and consolidating VMware VM snapshots.">
  <section class="tool-hero"><span class="eyebrow">VMware Tool</span><h1>Snapshot Command Generator</h1><p>Generate the right command for the snapshot operation you need — creating, listing, removing, or consolidating — with the safer flags already in place.</p></section>
  <div class="wrap">
    <a class="back" href="/vmware/">← Back to VMware Tools</a>
    <section class="card">
      <h2>Build a snapshot command</h2>
      <div class="grid">
        <div class="field"><label for="snapAction">Operation</label>
          <select id="snapAction">
            <option value="create">Create snapshot</option>
            <option value="list">List snapshots</option>
            <option value="removeone">Remove one snapshot</option>
            <option value="removeall">Remove all snapshots</option>
            <option value="revert">Revert to snapshot</option>
            <option value="consolidate">Consolidate disks</option>
          </select>
        </div>
        <div class="field"><label for="snapVm">VM name</label><input id="snapVm" value="app-server-01" /></div>
        <div class="field"><label for="snapName">Snapshot name</label><input id="snapName" value="pre-patch-2026-08" /></div>
        <div class="field checkbox-field"><label><input id="snapMemory" type="checkbox" /> Include memory state</label></div>
        <div class="field checkbox-field"><label><input id="snapQuiesce" type="checkbox" checked /> Quiesce filesystem (needs VMware Tools)</label></div>
      </div>
      <div class="actions"><button id="snapGenerate">Generate Command</button><button class="secondary" id="snapCopy" type="button">Copy</button></div>
      <div class="result"><pre id="snapOut">—</pre><p class="small">Snapshots are not backups. A snapshot left in place for days can grow large and degrade performance, and consolidating a long-running snapshot chain can itself cause a brief I/O pause — plan a maintenance window for consolidation on busy VMs.</p></div>
    </section>
  </div>
  <script>
    const snapActionSelect = document.querySelector<HTMLSelectElement>("#snapAction");
    const snapOut = document.querySelector<HTMLElement>("#snapOut");
    const snapGenerateBtn = document.querySelector<HTMLButtonElement>("#snapGenerate");
    const snapCopyBtn = document.querySelector<HTMLButtonElement>("#snapCopy");

    function snapVal(id: string): string {
      return document.querySelector<HTMLInputElement>("#" + id)?.value.trim() ?? "";
    }
    function snapChecked(id: string): boolean {
      return document.querySelector<HTMLInputElement>("#" + id)?.checked ?? false;
    }

    function buildSnapshotCommand(): string {
      const action = snapActionSelect?.value ?? "create";
      const vm = snapVal("snapVm") || "app-server-01";
      const name = snapVal("snapName") || "snapshot-01";
      const memory = snapChecked("snapMemory") ? "$true" : "$false";
      const quiesce = snapChecked("snapQuiesce") ? "$true" : "$false";

      switch (action) {
        case "create":
          return `New-Snapshot -VM "${vm}" -Name "${name}" -Description "Created via snapshot tool" -Memory:${memory} -Quiesce:${quiesce}`;
        case "list":
          return `Get-Snapshot -VM "${vm}" | Select-Object Name, Created, SizeGB, PowerState, Description | Sort-Object Created`;
        case "removeone":
          return `Get-Snapshot -VM "${vm}" -Name "${name}" | Remove-Snapshot -Confirm:$false`;
        case "removeall":
          return `Get-Snapshot -VM "${vm}" | Remove-Snapshot -RemoveChildren -Confirm:$false`;
        case "revert":
          return `Set-VM -VM "${vm}" -Snapshot (Get-Snapshot -VM "${vm}" -Name "${name}") -Confirm:$false`;
        case "consolidate":
          return `Get-VM -Name "${vm}" | Get-View | Where-Object { $_.Runtime.ConsolidationNeeded } | ForEach-Object { $_.ConsolidateVMDisks() }`;
        default:
          return `Get-Snapshot -VM "${vm}"`;
      }
    }

    snapGenerateBtn?.addEventListener("click", () => {
      if (snapOut) snapOut.textContent = buildSnapshotCommand();
    });

    snapCopyBtn?.addEventListener("click", async () => {
      const value = snapOut?.textContent ?? "";
      if (!value || value === "—") return;
      const original = snapCopyBtn.textContent;
      try {
        await navigator.clipboard.writeText(value);
        snapCopyBtn.textContent = "Copied!";
      } catch {
        snapCopyBtn.textContent = "Copy failed";
      }
      setTimeout(() => { snapCopyBtn.textContent = original; }, 1500);
    });

    if (snapOut) snapOut.textContent = buildSnapshotCommand();
  </script>
<style>
.tool-hero{padding:62px 20px 42px;background:linear-gradient(135deg,#eff6ff,#f8fafc);text-align:center}.eyebrow{display:inline-flex;padding:6px 11px;border-radius:999px;background:#dbeafe;color:#1d4ed8;font-size:13px;font-weight:800}.tool-hero h1{margin:14px 0 10px;color:#0f172a;font-size:clamp(34px,5vw,52px);line-height:1.1}.tool-hero p{max-width:760px;margin:0 auto;color:#64748b;font-size:17px}.wrap{width:min(calc(100% - 32px),960px);margin:38px auto 72px}.back{display:inline-block;margin-bottom:18px;color:#2563eb;font-weight:750;text-decoration:none}.card{padding:28px;border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.07)}h2{margin:0 0 8px;color:#0f172a}.muted{color:#64748b}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field{margin-top:16px}.checkbox-field{display:flex;align-items:center}.checkbox-field label{display:flex;align-items:center;gap:9px;margin-bottom:0;font-weight:600}label{display:block;margin-bottom:7px;color:#0f172a;font-weight:750}input:not([type="checkbox"]),select{width:100%;min-height:48px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;background:#fff;color:#0f172a}input[type="checkbox"]{width:19px;height:19px;flex-shrink:0;accent-color:#2563eb;cursor:pointer}input:focus,select:focus{outline:3px solid rgba(37,99,235,.14);border-color:#2563eb}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}button{min-height:46px;padding:10px 17px;border:0;border-radius:10px;background:#2563eb;color:#fff;font-weight:800;cursor:pointer}.secondary{background:#e2e8f0;color:#0f172a}.result{margin-top:20px;padding:17px;border:1px solid #dbeafe;border-radius:12px;background:#f8fbff;overflow-wrap:anywhere}.result pre{margin:0;white-space:pre-wrap;word-break:break-word;font:600 .88rem/1.6 ui-monospace,Consolas,monospace;color:#0f172a}.small{margin-top:12px;font-size:13px;color:#64748b}@media(max-width:700px){.grid{grid-template-columns:1fr}.card{padding:20px}}
</style>
</Layout>
