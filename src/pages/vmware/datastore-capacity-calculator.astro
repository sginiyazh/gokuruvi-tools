---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Datastore Capacity Calculator" description="Calculate usable datastore free space, thin-provisioning overcommit and how many more VMs will fit before hitting VMware's recommended usage threshold.">
  <section class="tool-hero"><span class="eyebrow">VMware Tool</span><h1>Datastore Capacity Calculator</h1><p>Work out real usable free space, thin-provisioning overcommit ratio, and how many more VMs will fit before the datastore crosses a safe usage threshold.</p></section>
  <div class="wrap">
    <a class="back" href="/vmware/">← Back to VMware Tools</a>
    <section class="card">
      <h2>Datastore usage</h2>
      <div class="grid">
        <div class="field"><label for="dsTotal">Total datastore capacity (GB)</label><input id="dsTotal" type="number" min="1" value="8000" /></div>
        <div class="field"><label for="dsUsed">Currently used (GB)</label><input id="dsUsed" type="number" min="0" value="5200" /></div>
        <div class="field"><label for="dsProvisioned">Total provisioned (thin) space (GB)</label><input id="dsProvisioned" type="number" min="0" value="9600" /></div>
        <div class="field"><label for="dsThreshold">Safe usage threshold (%)</label><input id="dsThreshold" type="number" min="1" max="99" value="80" /></div>
      </div>
      <h2 class="section-gap">Planned VMs</h2>
      <div class="grid">
        <div class="field"><label for="dsVmSize">Average VM disk size (GB)</label><input id="dsVmSize" type="number" min="1" value="100" /></div>
      </div>
      <div class="actions"><button id="vmwareDatastoreCalc">Calculate</button></div>
      <div class="result" id="vmwareDatastoreResult" hidden>
        <div class="checklist" id="vmwareDatastoreList"></div>
        <p class="small">Thin-provisioned overcommit lets provisioned space exceed physical capacity, but every VM can still write up to its full provisioned size — monitor actual growth, not just the allocation.</p>
      </div>
    </section>
  </div>
  <script>
    const datastoreButton = document.querySelector<HTMLButtonElement>("#vmwareDatastoreCalc");
    const datastoreResult = document.querySelector<HTMLElement>("#vmwareDatastoreResult");
    const datastoreList = document.querySelector<HTMLElement>("#vmwareDatastoreList");

    function dsNumVal(id: string, fallback: number): number {
      const el = document.querySelector<HTMLInputElement>("#" + id);
      const value = Number(el?.value);
      return Number.isFinite(value) && value >= 0 ? value : fallback;
    }

    function dsRow(label: string, value: string, cls = ""): string {
      return `<div class="item ${cls}"><strong>${label}:</strong> ${value}</div>`;
    }

    datastoreButton?.addEventListener("click", () => {
      const total = dsNumVal("dsTotal", 8000) || 1;
      const used = dsNumVal("dsUsed", 5200);
      const provisioned = dsNumVal("dsProvisioned", 9600);
      const threshold = dsNumVal("dsThreshold", 80);
      const vmSize = dsNumVal("dsVmSize", 100) || 1;

      const freeSpace = Math.max(0, total - used);
      const usedPercent = (used / total) * 100;
      const thresholdSpace = total * (threshold / 100);
      const spaceUntilThreshold = Math.max(0, thresholdSpace - used);
      const overcommitRatio = provisioned / total;
      const vmsUntilThreshold = Math.floor(spaceUntilThreshold / vmSize);

      const statusClass = usedPercent >= threshold ? "bad" : usedPercent >= threshold - 10 ? "warn" : "good";
      const statusText = usedPercent >= threshold
        ? "Over threshold — free up space or expand before provisioning more VMs"
        : usedPercent >= threshold - 10
        ? "Approaching threshold — plan expansion soon"
        : "Healthy";

      if (datastoreList) {
        datastoreList.innerHTML = [
          dsRow("Free space now", `${freeSpace.toLocaleString()} GB`),
          dsRow("Current usage", `${usedPercent.toFixed(1)}%`, statusClass),
          dsRow("Status", statusText, statusClass),
          dsRow("Space available before hitting threshold", `${spaceUntilThreshold.toLocaleString()} GB`),
          dsRow("Approx. VMs that still fit before threshold", `${vmsUntilThreshold.toLocaleString()} VMs`),
          dsRow("Thin-provisioning overcommit ratio", `${overcommitRatio.toFixed(2)}x provisioned vs. physical`),
        ].join("");
      }
      if (datastoreResult) datastoreResult.hidden = false;
    });
  </script>
<style>
.tool-hero{padding:62px 20px 42px;background:linear-gradient(135deg,#eff6ff,#f8fafc);text-align:center}.eyebrow{display:inline-flex;padding:6px 11px;border-radius:999px;background:#dbeafe;color:#1d4ed8;font-size:13px;font-weight:800}.tool-hero h1{margin:14px 0 10px;color:#0f172a;font-size:clamp(34px,5vw,52px);line-height:1.1}.tool-hero p{max-width:760px;margin:0 auto;color:#64748b;font-size:17px}.wrap{width:min(calc(100% - 32px),960px);margin:38px auto 72px}.back{display:inline-block;margin-bottom:18px;color:#2563eb;font-weight:750;text-decoration:none}.card{padding:28px;border:1px solid #e2e8f0;border-radius:18px;background:#fff;box-shadow:0 14px 34px rgba(15,23,42,.07)}h2{margin:0 0 8px;color:#0f172a}.section-gap{margin-top:28px}.muted{color:#64748b}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field{margin-top:16px}label{display:block;margin-bottom:7px;color:#0f172a;font-weight:750}input,select,textarea{width:100%;min-height:48px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;background:#fff;color:#0f172a}input:focus,select:focus{outline:3px solid rgba(37,99,235,.14);border-color:#2563eb}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}button{min-height:46px;padding:10px 17px;border:0;border-radius:10px;background:#2563eb;color:#fff;font-weight:800;cursor:pointer}.result{margin-top:20px;padding:17px;border:1px solid #dbeafe;border-radius:12px;background:#f8fbff;overflow-wrap:anywhere}.checklist{display:grid;gap:9px}.item{padding:10px 12px;border-radius:10px;background:#f8fafc;border:1px solid #e2e8f0}.item.good{border-color:#bbf7d0;background:#f0fdf4;color:#15803d}.item.warn{border-color:#fde68a;background:#fffbeb;color:#b45309}.item.bad{border-color:#fecaca;background:#fef2f2;color:#b91c1c}.small{margin-top:12px;font-size:13px;color:#64748b}@media(max-width:700px){.grid{grid-template-columns:1fr}.card{padding:20px}}
</style>
</Layout>
