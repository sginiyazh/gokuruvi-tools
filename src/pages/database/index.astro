---
import Header from "../../components/Header.astro";

const pageTitle = "Database Tools";

const description =
  "Free SQL, MySQL, PostgreSQL, Microsoft SQL Server, Oracle, MongoDB, Redis and database administration tools.";

const tools = [
  {
    icon: "🧹",
    name: "SQL Query Formatter",
    category: "SQL Tools",
    description:
      "Format SQL queries with clean indentation, spacing and readable structure.",
    link: "/database/sql-query-formatter",
  },
  {
    icon: "🗜️",
    name: "SQL Minifier",
    category: "SQL Tools",
    description:
      "Minify SQL by removing unnecessary spaces, comments and line breaks.",
    link: "/database/sql-minifier",
  },
  {
    icon: "✨",
    name: "SQL Beautifier",
    category: "SQL Tools",
    description:
      "Beautify complex SQL statements for easier reading and review.",
