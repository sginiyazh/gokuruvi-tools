  {
    icon: "⚡",
    title: "Faster database work",
    description:
      "Generate SQL, backup, restore and administration commands directly in your browser.",
  },
  {
    icon: "🧭",
    title: "Multi-database support",
    description:
      "Use practical tools for MySQL, PostgreSQL, SQL Server, Oracle, MongoDB and Redis.",
  },
  {
    icon: "🔒",
    title: "Privacy friendly",
    description:
      "Most database values are processed locally without requiring registration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="database tools, SQL formatter, SQL validator, MySQL tools, PostgreSQL tools, SQL Server tools, Oracle tools, MongoDB tools, Redis tools, database monitoring"
    />

    <meta name="author" content="Gokuruvi Tools" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:title" content="Database Tools | Gokuruvi Tools" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <meta
      property="og:url"
      content="https://www.gokuruvi.com/database/"
    />

    <link
      rel="canonical"
      href="https://www.gokuruvi.com/database/"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle} | Gokuruvi Tools</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-content">
            <div class="hero-badge">
              <span class="badge-dot" aria-hidden="true"></span>
              Free tools for database professionals
            </div>

            <h1>
              Practical <span>Database Tools</span>
            </h1>

            <p class="hero-description">
              Format and validate SQL, generate database commands, create backup and
              restore scripts, monitor database health and simplify administration
              across popular database platforms.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#database-tools">
                Explore Database Tools
                <span aria-hidden="true">→</span>
              </a>

              <a class="button button-secondary" href="/#tool-categories">
                Browse All Categories
              </a>
            </div>

            <div class="hero-statistics">
              <div class="hero-stat">
                <strong>{tools.length}</strong>
                <span>Database utilities</span>
              </div>

              <div class="hero-stat">
                <strong>SQL</strong>
                <span>Query and schema tools</span>
              </div>

              <div class="hero-stat">
                <strong>Multi-DB</strong>
                <span>Six database platforms</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="database-tools">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Available Utilities</span>

            <h2>Database tools for development and administration</h2>

            <p>
              Select a utility to calculate IP information, generate network
              commands, create Multi-DB records, validate VLANs or check SSL details.
            </p>
          </div>

          <div class="tools-grid">
            {
              tools.map((tool) => (
                <a
                  class="tool-card"
                  href={tool.link}
                  aria-label={`Open ${tool.name}`}
                >
                  <div class="tool-header">
                    <div class="tool-icon" aria-hidden="true">{tool.icon}</div>
                    <span class="tool-category">{tool.category}</span>
                  </div>

                  <h3>{tool.name}</h3>
                  <p>{tool.description}</p>

                  <span class="open-tool">
                    Open tool
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-white">
        <div class="container">
          <div class="section-heading">
            <span class="section-label">Why Gokuruvi</span>

            <h2>Built for database administrators and developers</h2>

            <p>
              Use practical utilities for SQL development, database administration,
              backup, recovery, performance and monitoring.
            </p>
          </div>

          <div class="benefits-grid">
            {
              benefits.map((benefit) => (
                <article class="benefit-card">
                  <div class="benefit-icon" aria-hidden="true">
                    {benefit.icon}
                  </div>

                  <h3>{benefit.title}</h3>
                  <p>{benefit.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container">
          <div class="cta-box">
            <h2>Start simplifying your database tasks</h2>

            <p>
              Calculate subnet details, generate Multi-DB commands and troubleshoot
              connectivity using free online networking tools.
            </p>

            <a
              class="button cta-button"
              href="/database/sql-query-formatter"
            >
              Open SQL Query Formatter
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="footer-logo" href="/">
              <span class="footer-logo-icon" aria-hidden="true">G</span>
              <span>Gokuruvi Tools</span>
            </a>

            <p>
              Free Linux, DevOps, Kubernetes, network, cloud, database and security
              utilities for administrators, engineers and IT professionals.
            </p>
          </div>

          <div>
            <h3 class="footer-title">Database Tools</h3>

            <div class="footer-links">
              <a href="/database/sql-query-formatter">SQL Formatter</a>
              <a href="/database/sql-validator">SQL Validator</a>
              <a href="/database/sql-query-builder">SQL Query Builder</a>
              <a href="/database/database-port-checker">Port Checker</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Database Platforms</h3>

            <div class="footer-links">
              <a href="/database/mysql-health-check">MySQL Tools</a>
              <a href="/database/postgres-health-check">PostgreSQL Tools</a>
              <a href="/database/mssql-health-check">SQL Server Tools</a>
              <a href="/database/oracle-health-check">Oracle Tools</a>
            </div>
          </div>

          <div>
            <h3 class="footer-title">Categories</h3>

            <div class="footer-links">
              <a href="/linux/">Linux Tools</a>
              <a href="/devops/">DevOps Tools</a>
              <a href="/kubernetes/">Kubernetes Tools</a>
              <a href="/network/">Network Tools</a>
              <a href="/cloud/">Cloud Tools</a>
              <a href="/database/">Database Tools</a>
              <a href="/about/">About</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()} Gokuruvi Tools. All rights reserved.
          </span>

          <div class="footer-bottom-links">
            <a href="/privacy-policy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/disclaimer/">Disclaimer</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #172033;
    font-family:
      Inter, Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 105px 0 92px;
    background:
      radial-gradient(circle at 15% 15%, rgba(56, 189, 248, 0.2), transparent 32%),
      radial-gradient(circle at 88% 25%, rgba(37, 99, 235, 0.2), transparent 34%),
      linear-gradient(145deg, #f8fafc 0%, #eff6ff 52%, #f8fafc 100%);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 24px;
    padding: 8px 16px;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 800;
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.12);
