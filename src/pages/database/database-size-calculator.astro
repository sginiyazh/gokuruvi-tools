---
import Header from "../../components/Header.astro";

const pageTitle = "Database Size Calculator";
const description = "Free Database Size Calculator utility for Database administrators and IT professionals.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://www.gokuruvi.com/database/database-size-calculator/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle} | Gokuruvi Tools</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="container">
          <span class="badge">Database Tool</span>
          <h1>{pageTitle}</h1>
          <p>{description}</p>
        </div>
      </section>
      <section class="content">
        <div class="container">
          <article class="tool-panel">
            <div class="tool-icon" aria-hidden="true">🛠️</div>
            <h2>Tool page created successfully</h2>
            <p>
              This route is now active and ready for the interactive generator,
              calculator or checker functionality to be added.
            </p>
            <div class="notice">
              <strong>Development status:</strong> Interface and tool logic are being prepared.
            </div>
            <a class="button" href="/database/">← Back to Database Tools</a>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f8fafc; color: #172033; font-family: Inter, Arial, sans-serif; line-height: 1.6; }
  .container { width: min(100% - 40px, 1080px); margin-inline: auto; }
  .hero { padding: 90px 0 70px; text-align: center; background: radial-gradient(circle at 15% 15%, rgba(56,189,248,.2), transparent 32%), linear-gradient(145deg,#f8fafc,#eff6ff); }
  .badge { display: inline-block; padding: 7px 14px; border: 1px solid #bfdbfe; border-radius: 999px; background: #fff; color: #1d4ed8; font-size: 13px; font-weight: 800; }
  h1 { margin: 20px 0 14px; color: #0f172a; font-size: clamp(38px,6vw,62px); line-height: 1.1; }
  .hero p { max-width: 720px; margin: auto; color: #475569; font-size: 19px; }
  .content { padding: 75px 0 95px; }
  .tool-panel { max-width: 760px; margin: auto; padding: 42px; border: 1px solid #e2e8f0; border-radius: 22px; background: #fff; text-align: center; box-shadow: 0 18px 50px rgba(15,23,42,.08); }
  .tool-icon { font-size: 45px; }
  .tool-panel h2 { margin: 15px 0 10px; color: #0f172a; font-size: 30px; }
  .tool-panel p { color: #64748b; }
  .notice { margin: 26px 0; padding: 16px; border: 1px solid #fde68a; border-radius: 12px; background: #fffbeb; color: #92400e; }
  .button { display: inline-flex; min-height: 48px; align-items: center; padding: 0 22px; border-radius: 10px; background: #2563eb; color: #fff; font-weight: 800; text-decoration: none; }
  @media(max-width:560px) { .container { width:min(100% - 28px,1080px); } .tool-panel { padding:28px 22px; } }
</style>
