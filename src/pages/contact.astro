---
const pageTitle = "Contact Gokuruvi Tools";
const description =
  "Contact Gokuruvi Tools for questions, feedback, corrections, and business enquiries.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <main>
      <h1>Contact Us</h1>

      <p>
        For questions, feedback, corrections, or business enquiries,
        contact us using the email address below.
      </p>

      <p>
        Email:
        <a href="mailto:contact@gokuruvi.com">
          contact@gokuruvi.com
        </a>
      </p>

      <p>
        We will try to respond as soon as possible.
      </p>

      <p><a href="/">Return to homepage</a></p>
    </main>
  </body>
</html>