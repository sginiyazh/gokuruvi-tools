---
import Layout from "../../layouts/Layout.astro";

const tools = [
  { title: "AI Prompt Library", description: "40+ copy-paste prompts for the AI-assisted tasks you actually do daily: debugging, code review, studying, interview prep, and technical writing.", href: "/ai/prompt-library/", icon: "📋" },
  { title: "AI & LLM Glossary", description: "Plain-English definitions of the AI and LLM terms you'll run into — tokens, context window, RAG, fine-tuning, AI agents, and more.", href: "/ai/glossary/", icon: "📖" },
  { title: "Claude Certification Study Guide", description: "What CCAO-F, CCDV-F, CCAR-F, and CCAR-P actually test — exam domains, format, pricing, and how to pick the right one.", href: "/ai/claude-certifications/", icon: "🎓" },
  { title: "AI Token Counter & Cost Estimator", description: "Estimate token counts and API costs for GPT, Claude and Gemini before you run a prompt.", href: "/ai/token-counter/", icon: "🔢" },
  { title: "Model Context Window Calculator", description: "Check how much text, code or conversation history fits inside a model's context window.", href: "/ai/context-window-calculator/", icon: "📏" },
  { title: "AI Model Comparison", description: "Compare context windows, standard API pricing and practical strengths of current GPT, Claude and Gemini models.", href: "/ai/model-comparison/", icon: "⚖️" },
  { title: "Command Explainer", description: "Paste a shell, kubectl, Docker, git or systemd command to get a plain-English breakdown of what it does.", href: "/ai/command-explainer/", icon: "🧭" },
];
---
<Layout title="AI Tools" description="Free AI tools for students, developers and IT professionals: prompt library, AI glossary, token cost estimator, context window calculator, model comparison and command explainer.">
  <section class="hero"><div class="container"><span class="badge">AI Tools</span><h1>AI Tools for Students, Developers & IT Professionals</h1><p>A ready-to-use prompt library, a plain-English AI glossary, and fast, privacy-friendly browser utilities for estimating LLM costs, planning context windows, comparing models and understanding technical commands.</p></div></section>
  <section class="content"><div class="container"><div class="intro"><span>Free & practical</span><h2>Seven useful AI tools for daily work</h2><p>No registration required. Text entered into these tools is processed in your browser and is not intentionally sent to an AI provider.</p></div><div class="grid">{tools.map(tool => <a class="card" href={tool.href}><span class="icon" aria-hidden="true">{tool.icon}</span><div><h3>{tool.title}</h3><p>{tool.description}</p><span class="link">Open tool →</span></div></a>)}</div><aside class="note"><strong>Pricing note:</strong> AI provider pricing and model limits change frequently. The comparison and estimator include a visible data-updated date; verify provider documentation before production budgeting.</aside></div></section>
</Layout>
<style>
.container{width:min(calc(100% - 32px),1180px);margin-inline:auto}.hero{padding:72px 0 62px;text-align:center;background:radial-gradient(circle at 18% 10%,rgba(56,189,248,.18),transparent 35%),linear-gradient(145deg,#f8fafc,#eff6ff)}.badge{display:inline-flex;padding:7px 13px;border:1px solid #bfdbfe;border-radius:999px;background:#fff;color:#1d4ed8;font-size:13px;font-weight:800}.hero h1{margin:16px 0 12px;color:#0f172a;font-size:clamp(42px,6vw,64px);line-height:1.05}.hero p{max-width:800px;margin:0 auto;color:#475569;font-size:18px}.content{padding:58px 0 84px}.intro{max-width:820px;margin-bottom:30px}.intro>span{color:#2563eb;font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.intro h2{margin:8px 0 10px;color:#0f172a;font-size:clamp(28px,4vw,38px)}.intro p{margin:0;color:#64748b}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.card{display:flex;gap:16px;padding:24px;border:1px solid #e2e8f0;border-radius:18px;background:#fff;color:inherit;text-decoration:none;box-shadow:0 12px 32px rgba(15,23,42,.05);transition:transform .2s,border-color .2s,box-shadow .2s}.card:hover{transform:translateY(-3px);border-color:#93c5fd;box-shadow:0 18px 42px rgba(15,23,42,.09)}.icon{display:grid;width:48px;height:48px;flex:0 0 48px;place-items:center;border-radius:12px;background:#eff6ff;font-size:22px}.card h3{margin:0 0 7px;color:#0f172a;font-size:19px}.card p{margin:0;color:#64748b;font-size:14px}.link{display:inline-block;margin-top:12px;color:#2563eb;font-size:14px;font-weight:800}.note{margin-top:28px;padding:17px 19px;border:1px solid #fde68a;border-radius:14px;background:#fffbeb;color:#92400e}@media(max-width:760px){.grid{grid-template-columns:1fr}.hero{padding:56px 0 48px}}
</style>
