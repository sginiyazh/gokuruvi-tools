---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
interface Props { title:string; description:string; slug:string; icon?:string; }
const { title, description, slug, icon = "🪟" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0f172a" />
  <link rel="canonical" href={`https://www.gokuruvi.com/windows/${slug}/`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | Gokuruvi Tools</title>
</head>
<body>
  <Header />
  <main>
    <section class="wt-hero">
      <div class="wt-container wt-hero-inner">
        <span class="wt-badge">Windows Tool</span>
        <div class="wt-icon" aria-hidden="true">{icon}</div>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
    </section>
    <section class="wt-content">
      <div class="wt-container">
        <div class="wt-layout">
          <article class="wt-panel">
            <slot />
          </article>
          <aside class="wt-aside">
            <h2>Windows admin tips</h2>
            <p>Review generated commands before running them in production. Use an elevated PowerShell or Command Prompt when the operation requires administrator rights.</p>
            <div class="wt-note"><strong>Safety:</strong> Test destructive or permission-changing commands on a non-production path first.</div>
            <a class="wt-back" href="/windows/">← Back to Windows Tools</a>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#f8fafc;color:#172033;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.55}
.wt-container{width:min(calc(100% - 36px),1180px);margin-inline:auto}.wt-hero{padding:64px 0 56px;background:radial-gradient(circle at 15% 15%,rgba(56,189,248,.19),transparent 34%),radial-gradient(circle at 88% 20%,rgba(37,99,235,.13),transparent 32%),linear-gradient(145deg,#f8fafc,#eff6ff)}.wt-hero-inner{text-align:center}.wt-badge{display:inline-flex;padding:7px 13px;border:1px solid #bfdbfe;border-radius:999px;background:#fff;color:#1d4ed8;font-size:13px;font-weight:800}.wt-icon{margin-top:15px;font-size:34px}.wt-hero h1{margin:8px 0 12px;color:#0f172a;font-size:clamp(38px,5vw,58px);line-height:1.05}.wt-hero p{max-width:790px;margin:auto;color:#475569;font-size:18px}.wt-content{padding:54px 0 82px}.wt-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:24px;align-items:start}.wt-panel,.wt-aside{border:1px solid #e2e8f0;border-radius:20px;background:#fff;box-shadow:0 14px 42px rgba(15,23,42,.06)}.wt-panel{padding:30px}.wt-aside{padding:24px;position:sticky;top:92px}.wt-aside h2{margin:0 0 10px;font-size:20px;color:#0f172a}.wt-aside p{margin:0;color:#64748b;font-size:14px}.wt-note{margin:18px 0;padding:13px;border:1px solid #fde68a;border-radius:12px;background:#fffbeb;color:#92400e;font-size:13px}.wt-back{display:inline-flex;align-items:center;min-height:42px;padding:0 15px;border-radius:9px;background:#eff6ff;color:#1d4ed8;font-weight:800;text-decoration:none}
:global(.tool-title){margin:0 0 6px;color:#0f172a;font-size:26px}:global(.tool-subtitle){margin:0 0 24px;color:#64748b}:global(.form-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}:global(.field){display:flex;flex-direction:column;gap:7px}:global(.field.full){grid-column:1/-1}:global(.field label){color:#334155;font-size:13px;font-weight:800}:global(.field input),:global(.field select),:global(.field textarea){width:100%;min-height:44px;border:1px solid #cbd5e1;border-radius:10px;background:#fff;padding:10px 12px;color:#0f172a;font:inherit;outline:none}:global(.field textarea){min-height:92px;resize:vertical}:global(.field input:focus),:global(.field select:focus),:global(.field textarea:focus){border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.12)}:global(.checks){display:flex;flex-wrap:wrap;gap:12px 18px;margin-top:5px}:global(.check){display:inline-flex;align-items:center;gap:7px;color:#475569;font-size:14px}:global(.check input){width:16px;height:16px}:global(.actions){display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}:global(.btn){min-height:44px;border:0;border-radius:10px;padding:0 17px;font:inherit;font-weight:800;cursor:pointer}:global(.btn-primary){background:#2563eb;color:#fff}:global(.btn-secondary){background:#e2e8f0;color:#0f172a}:global(.output-wrap){margin-top:24px}:global(.output-head){display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}:global(.output-head strong){color:#0f172a}:global(.copy-btn){border:0;background:#eff6ff;color:#1d4ed8;border-radius:8px;padding:7px 11px;font-weight:800;cursor:pointer}:global(.output){margin:0;min-height:92px;overflow:auto;white-space:pre-wrap;word-break:break-word;border:1px solid #1e293b;border-radius:12px;background:#0f172a;padding:16px;color:#dbeafe;font:13px/1.7 Consolas,"Courier New",monospace}:global(.hint){margin-top:12px;color:#64748b;font-size:13px}:global(.mini-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:16px}:global(.mini-card){padding:12px;border:1px solid #e2e8f0;border-radius:11px;background:#f8fafc;color:#475569;font-size:13px}
@media(max-width:900px){.wt-layout{grid-template-columns:1fr}.wt-aside{position:static}}@media(max-width:640px){.wt-container{width:min(calc(100% - 24px),1180px)}.wt-panel{padding:22px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.wt-hero{padding:48px 0 42px}.wt-hero p{font-size:16px}.mini-grid{grid-template-columns:1fr}}
</style>
