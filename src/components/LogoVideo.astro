---
// Pre-rendered 3D logo: builds once, then the last 8 seconds loop seamlessly.
// The file is fetched whole and played from memory, because jumping back to the
// loop point needs seeking, which needs Range support the server may not give.
// Visitors who prefer reduced motion, or whose browser cannot play it, see a still.
---

<video class="lv" id="logo-video" muted playsinline width="840" height="840" aria-hidden="true"></video>
<script is:inline>
  (function () {
    const v = document.getElementById("logo-video");
    const LOOP_START = 6; // seconds; a keyframe sits here so the jump back is clean
    const still = () => {
      v.pause();
      v.removeAttribute("src");
      v.poster = "/brand/logo-reveal.jpg";
      v.load();
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) { still(); return; }
    v.defaultMuted = true;
    v.addEventListener("ended", () => { v.currentTime = LOOP_START; v.play().catch(() => {}); });
    let inView = true;
    // No need to keep decoding while the hero is scrolled away.
    new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
      if (!v.src) return;
      if (inView) v.play().catch(() => {});
      else v.pause();
    }).observe(v);
    fetch("/brand/logo-reveal.mp4", { priority: "low" })
      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.blob(); })
      .then((blob) => {
        v.src = URL.createObjectURL(blob);
        return inView ? v.play() : undefined;
      })
      .catch(still);
  })();
</script>

<style>
  .lv {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
  }
</style>
